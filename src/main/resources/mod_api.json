			"description": "Creates a new ResourceLocation.",
			"return_type": {
				"name": "ResourceLocation"
			},
			"parameters": [
				{
					"name": "resource_location_string",
					"type": {
						"name": "string"
					}
				}
			]
		},
		"vec3": {
			"description": "Creates a new Vec3.",
			"return_type": {
				"name": "Vec3"
			},
			"parameters": [
				{
					"name": "x",
					"type": {
						"name": "number"
					}
				},
				{
					"name": "y",
					"type": {
						"name": "number"
					}
				},
				{
					"name": "z",
					"type": {
						"name": "number"
					}
				}
			]
		},
		"vec3_zero": {
			"description": "Creates a new Vec3, initialized with all zeros.",
			"return_type": {
				"name": "Vec3"
			}
		}
