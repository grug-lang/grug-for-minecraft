{
	"entities": {
		"Block": {
			"description": "A block."
		},
		"BlockEntity": {
			"description": "A block entity.",
			"export_functions": [
				{
					"name": "tick",
					"description": "Called every game tick, so every 0.05 seconds."
				}
			]
		}
	},
	"classes": {
		"BlockPos": {
			"description": "A position in the world.",
			"methods": {
				"above_n": {
					"description": "Gets the BlockPosition N blocks up.",
					"return_type": {
						"name": "BlockPos"
					},
					"parameters": [
						{
							"name": "n",
							"type": {
								"name": "number"
							}
						}
					]
				},
				"center": {
					"description": "Gets the center of a BlockPosition.",
					"return_type": {
						"name": "Vec3"
					}
				}
			}
		},
		"Vec3": {
			"description": "A 3D vector.",
			"methods": {
				"x": {
					"description": "Gets the X coordinate of a Vec3.",
					"return_type": {
						"name": "number"
					}
				},
				"y": {
					"description": "Gets the Y coordinate of a Vec3.",
					"return_type": {
						"name": "number"
					}
				},
				"z": {
					"description": "Gets the Z coordinate of a Vec3.",
					"return_type": {
						"name": "number"
					}
				}
			}
		},
		"ItemEntity": {
			"description": "An item entity.",
			"methods": {
				"entity": {
					"description": "Takes an ItemEntity, and returns it as an Entity.",
					"return_type": {
						"name": "Entity"
					}
				}
			}
		},
		"Entity": {
			"description": "A generic entity.",
			"methods": {
				"set_delta_movement": {
					"description": "Sets an Entity's delta movement.",
					"parameters": [
						{
							"name": "vec3",
							"type": {
								"name": "Vec3"
							}
						}
					]
				},
				"spawn": {
					"description": "Spawns a new entity. Spawning the same entity twice is an error.",
					"parameters": [
						{
							"name": "level",
							"type": {
								"name": "Level"
							}
						}
					]
				}
			}
		}
	},
	"host_functions": {
		"get_block_entity_level": {
			"description": "Gets the Level (dimension) a BlockEntity is in.",
			"return_type": {
				"name": "Level"
			},
			"parameters": [
				{
					"name": "block_entity",
					"type": {
						"name": "BlockEntity"
					}
				}
			]
		},
		"get_block_pos_of_block_entity": {
			"description": "Gets the world position of a BlockEntity.",
			"return_type": {
				"name": "BlockPos"
			},
			"parameters": [
				{
					"name": "block_entity",
					"type": {
						"name": "BlockEntity"
					}
				}
			]
		},
		"item": {
			"description": "Creates a new item.",
			"return_type": {
				"name": "Item"
			},
			"parameters": [
				{
					"name": "resource_location",
					"type": {
						"name": "ResourceLocation"
					}
				}
			]
		},
		"item_entity": {
			"description": "Creates a new ItemEntity.",
			"return_type": {
				"name": "ItemEntity"
			},
			"parameters": [
				{
					"name": "level",
					"type": {
						"name": "Level"
					}
				},
				{
					"name": "x",
					"type": {
						"name": "number"
					}
				},
				{
					"name": "y",
					"type": {
						"name": "number"
					}
				},
				{
					"name": "z",
					"type": {
						"name": "number"
					}
				},
				{
					"name": "item_stack",
					"type": {
						"name": "ItemStack"
					}
				}
			]
		},
		"item_stack": {
			"description": "Creates a new ItemStack. Keep in mind that when two ItemStacks get close enough to each other, they merge, turning the original ItemStacks and entities into 'Air'. So if you call spawn_entity() to spawn an ItemStack, make sure that the ItemStack isn't reused later on to spawn more entities.",
			"return_type": {
				"name": "ItemStack"
			},
			"parameters": [
				{
					"name": "item",
					"type": {
						"name": "Item"
					}
				}
			]
		},
