# The firework rocket is the host's own rocket on a loader that glides: used in the air it launches,
# and used while gliding it attaches to the player and boosts them. A loader that cannot glide yet
# keeps a plain item, which about.json records as a deviation against #915.
export init(ctx: ItemInitContext) {
    if ctx.supports_gliding() {
        ctx.set_firework_rocket()
    }
}
