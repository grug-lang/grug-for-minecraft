# The elytra is a glider with the reference's 432 damage points. On a loader that glides, the host
# does the rest the way the reference does: the chest slot, the glide, one point of damage every
# twentieth glide tick, the pose and the wings. A loader that cannot glide yet keeps a plain item,
# which about.json records as a deviation against #915.
export init(ctx: ItemInitContext) {
    if ctx.supports_gliding() {
        ctx.set_glider(432)
    }
}
