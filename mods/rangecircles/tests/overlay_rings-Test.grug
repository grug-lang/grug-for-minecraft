# Covers the range circles overlay: J saves the position and draws the three rings, and the golden
# holds them. The rings are centered on the player's position at the press, which is the room's
# middle. The room's walls would hide a ring outside them, so the test builds a room of radius 30,
# whose walls stand outside the 24 ring, and the capture shows that ring ahead of the camera. A second press hides the rings and
# forgets the position, and the test ends with that press, because a
# ring left on would sit in every later test's captures. On a loader with no world overlay hooks the
# test returns before it presses anything.
started: bool = false
pressed: bool = false
settled_ticks: number = 0
waited: number = 0

export tick(ctx: TestTickContext) {
    if not started {
        started = true
        if not me.world_overlay_supported() {
            return
        }
        ctx.set_box_radius(30)
        ctx.not_done()
        return
    }

    waited = waited + 1
    ctx.assert(waited < 1500, "The range circles test should finish.")

    if not ctx.world_settled() {
        settled_ticks = 0
        ctx.not_done()
        return
    }
    if settled_ticks < 5 {
        settled_ticks = settled_ticks + 1
        ctx.not_done()
        return
    }

    if not pressed {
        pressed = true
        ctx.press_world_key(74, false)
        ctx.not_done()
        return
    }

    if not ctx.world_overlay_drawn() {
        ctx.not_done()
        return
    }
    ctx.screenshot().equals(r"screenshots/overlay_rings", 0, 0, 1280, 720)

    # J hides the rings again: the overlay is one entity for the whole run.
    ctx.press_world_key(74, false)
}
