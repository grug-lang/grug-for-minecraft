# Covers the range circles overlay: J saves the position and shows the rings, and a second press
# hides them. The first golden holds the rings and the second the same view without them, so the
# second press is checked by what is drawn. The lines are depth tested against the world, so the
# test lays a flat stone floor under the view, from behind the player out past the 32 ring, and the
# crop is a band over the floor where the red 24 ring and the yellow 32 ring cross it, right of the
# coverage overlay's L text and left of its cross. The 128 ring is drawn as well but lies past the
# far plane of a run's smallest view (#1422), so no capture here shows it. The rings are centered on
# the player's position at the press, which is the room's middle. On a loader with no world overlay
# hooks the test returns before it presses anything.
floor_rows: number = 48
started: bool = false
row: number = 0
shown: bool = false
hidden: bool = false
settled_ticks: number = 0
waited: number = 0
hidden_wait: number = 0

export tick(ctx: TestTickContext) {
    if not started {
        started = true
        if not me.world_overlay_supported() {
            return
        }
        ctx.set_box_radius(25)
        ctx.not_done()
        return
    }

    waited = waited + 1
    ctx.assert(waited < 1500, "The range circles test should finish.")

    if row < floor_rows {
        _lay_row(ctx)
        ctx.not_done()
        return
    }

    if not ctx.world_settled() {
        settled_ticks = 0
        ctx.not_done()
        return
    }
    if settled_ticks < 5 {
        settled_ticks = settled_ticks + 1
        ctx.not_done()
        return
    }

    if not shown {
        shown = true
        ctx.press_world_key(74, false)
        ctx.not_done()
        return
    }

    if not hidden and not ctx.world_overlay_drawn() {
        ctx.not_done()
        return
    }

    if not hidden {
        hidden = true
        ctx.screenshot().equals(r"screenshots/overlay_rings", 260, 360, 560, 420)
        # The second press hides the rings, which also leaves none of them in a later test's capture.
        ctx.press_world_key(74, false)
        hidden_wait = 0
        ctx.not_done()
        return
    }

    # A hidden overlay draws nothing, so no frame announces it: the frame that follows the press is
    # waited for by ticks, which pass up to 10 to a frame, so 40 are at least four frames.
    hidden_wait = hidden_wait + 1
    if hidden_wait < 40 {
        ctx.not_done()
        return
    }

    ctx.screenshot().equals(r"screenshots/overlay_hidden", 260, 360, 560, 420)
}

# Lays one row of the floor, 97 blocks wide, one block per tick row from behind the player to 45
# blocks ahead of it, on the layer under the player's feet. One row a tick keeps a tick short.
local _lay_row(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    origin: Vec3 = ctx.get_origin()
    px: number = Math.floor(origin.x())
    py: number = Math.floor(origin.y() - 4.12)
    pz: number = Math.floor(origin.z())
    x: number = px - 48
    while x <= px + 48 {
        level.place_block(x, py - 1, pz - 2 + row, "minecraft:stone")
        x = x + 1
    }
    row = row + 1
}
