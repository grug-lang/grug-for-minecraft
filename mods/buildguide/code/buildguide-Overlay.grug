p7a: Option[Widget] = Option.new()
p7b: Option[Widget] = Option.new()
p7c: Option[Widget] = Option.new()
p7d: Option[Widget] = Option.new()
p7e: Option[Widget] = Option.new()
p7f: Option[Widget] = Option.new()
p7g: Option[Widget] = Option.new()
p7h: Option[Widget] = Option.new()

# The world facts of the last world frame: a screen's initCheck needs the level and the player's feet,
# and a close saves the state under the world and dimension the player is in. render_world runs every
# frame, with or without a screen, so these are current whenever a screen opens.
world_level: Option[Level] = Option.new()
world_name: string = ""
world_dimension: string = ""
world_x: number = 0
world_y: number = 0
world_z: number = 0

# BaseScreen.render's two block counts, from the last world frame: a shape is generated while it is
# drawn or counted, so a frame with a screen open counts every set with the draw suppressed, and the
# current shape's count is its set's whether or not the set is visible, as the reference's is.
block_shape: number = 0
block_total: number = 0
cell_count: number = 0
cell_counting: bool = false
# The most positions one shape's cell loop may scan in the frame that generates it. The reference
# generates on a cached thread and lets a huge shape stall there, while this port generates in
# render_world, where a grug call over 100 ms is a runtime error, so a box past this draws no cells
# and about.json records the deviation. The number is about a quarter of that budget for the loop's
# arithmetic: a circle of radius 249 scans 499 by 499, and a sphere of radius 30 scans 61 cubed.
max_shape_positions: number = 250000

# Draws every shape set the way AbstractRenderHandler.render and AbstractLegacyRenderHandler do:
# only while the mod is enabled, there is a set, and the current set has an origin; then each set
# whose own state allows it, with its origin cube.
# A world frame is also where a queued key press is applied, because the state has to be loaded
# first and a binding handler has no feet to read, and where the screen's block counts are taken.

export render_world(ctx: OverlayWorldContext) {
    level: Level = ctx.get_level()
    name: string = level.name()
    dimension: string = level.dimension()
    key: string = _state_key(name, dimension)
    x: number = ctx.player_x()
    y: number = ctx.player_y()
    z: number = ctx.player_z()
    world_level.set(level)
    world_name = name
    world_dimension = dimension
    world_x = x
    world_y = y
    world_z = z
    if not config_loaded or not state_loaded or state_key != key {
        files: File = File.open(r"files")
        _ensure_config(files)
        _ensure_state(files, level, name, dimension, key, x, y, z)
    }
    _apply_pending(x, y, z)
    if active_screen != "" {
        _count_all(ctx)
    }
    if not _state_enabled() {
        return
    }
    if _state_set_count() == 0 {
        return
    }
    if not _set_has_origin(_state_current_set()) {
        return
    }
    _draw_all(ctx)
}

# The four declared bindings, which the player rebinds in the Controls menu under the reference's
# own names. The reference leaves the three state keys unbound by default, so this port declares
# them with no default_key too and the Controls screen lists them for the player to bind; the open
# key is B in both. A binding fires once per press, so a count of presses is a count of
# applications; applying the same count again in one frame is what a player who pressed twice
# before a frame would get from the reference too.
# The open key creates the screen of the tab State.currentScreen names and shows it, as
# AbstractInputHandler.onKeyInput does.

export world_binding(ctx: OverlayWorldBindingContext) {
    if ctx.id() == "toggle_enable" {
        pending_toggle = pending_toggle + 1
        return
    }
    if ctx.id() == "set_origin" {
        pending_origin = pending_origin + 1
        return
    }
    if ctx.id() == "set_global_origin" {
        pending_global_origin = pending_global_origin + 1
        return
    }
    if ctx.id() == "open_screen" {
        _open_tab(tab_screen)
    }
}

# The four screens of #1752's second stage. Every one of them starts with BaseScreen's chrome and
# State.initCheck, which the reference runs from the screen's own constructor as well as from the
# toggle key. The Shape and Shape list dropdowns are lists inside their screens, because the host's
# Screen holds one screen at a time (#1760's gap 2).

export screen_init(ctx: ScreenInitContext) {
    width: number = ctx.screen_width()
    if state_loaded and world_level.has() {
        _state_check(world_x, world_y, world_z)
    }
    if active_screen == "configuration" {
        _configuration_init(width)
        return
    }
    if active_screen == "visualisation" {
        _visualisation_init(width)
        return
    }
    if active_screen == "shapelist" {
        _shapelist_init(width, ctx.screen_height())
        return
    }
    _shape_init(width, ctx.screen_height())
}

export screen_render(ctx: OverlayRenderContext) {
    width: number = ctx.screen_width()
    if active_screen == "configuration" {
        _configuration_render(ctx, width)
        return
    }
    if active_screen == "visualisation" {
        _visualisation_render(ctx, width)
        return
    }
    if active_screen == "shapelist" {
        _shapelist_render(ctx, width)
        return
    }
    _shape_render(ctx, width)
}

# The reference has no screen-level click or wheel handling: every press goes to the widget under the
# mouse, and a list takes its own row click and its own wheel. Nothing here takes either, so the
# widget under it keeps it.

export screen_click(ctx: OverlayClickContext) {
    return
}

# The reference's Escape is the host screen's own close, which reaches BaseScreen.onScreenClosed
# through Screen.keyPressed and saves. Taking it and closing runs the same path. A text field that
# has focus does not swallow it: the game closes the screen on Escape wherever focus is, so the host
# asks this export for Escape too, and a close that skipped the save would lose it.

export screen_key(ctx: OverlayKeyContext) {
    key: number = ctx.key()
    if key == 256 {
        ctx.take()
        _close_active()
    }
}

export screen_scroll(ctx: OverlayScrollContext) {
    return
}

# One export for every widget the open screen declared, because a changed widget holds the value its
# use left. A value the mod writes itself is silent, so an init or a state refresh cannot re-enter.

export screen_widget_changed(ctx: ScreenWidgetContext) {
    widget: Widget = ctx.widget()
    if active_screen == "configuration" {
        _configuration_changed(widget)
        return
    }
    if active_screen == "visualisation" {
        _visualisation_changed(widget)
        return
    }
    if active_screen == "shapelist" {
        _shapelist_changed(widget)
        return
    }
    _shape_changed(widget)
}

# What each row of the shape list shows: the set's shape name, struck through while the set is
# invisible and red while the shape is in error. Every visible row is asked once per frame, so the
# text follows the state without the port touching the list after a change.

export screen_list_row(ctx: ListRowResponse) {
    if dropdown_open {
        if active_screen == "shape" {
            _dropdown_row(ctx, q_list.unwrap())
            return
        }
        if active_screen == "shapelist" {
            _dropdown_row(ctx, n_list.unwrap())
        }
        return
    }
    if active_screen == "shapelist" {
        _shapelist_row(ctx)
    }
}

# BaseScreen.onScreenClosed saves the whole state when persistence is on and something changed since
# the last save, and then clears its shouldUpdatePersistence flag. The port has no flag: the state
# text is the whole of what is saved, so a text equal to the one last written is a close with nothing
# to save. A refused save leaves that text and its flag alone, so the next close retries it, as the
# reference's flag stays set. The one difference is a rewrite of identical bytes, which the reference
# makes when its flag was set by a mutation that is not persisted, such as adding a shape's
# properties; no byte of the file moves either way.
# Escape reaches this through a mod screen's close, and so does a tab press, because opening a screen
# over an open one asks the open one to close first.

export screen_closed() {
    _state_save()
    # A screen the game removed, or one the player closed, is no longer the screen whose counts
    # render_world takes, so the next frame must stop counting; a tab switch's close already named
    # the new tab and is left alone.
    if switching_tab {
        return
    }
    active_screen = ""
    dropdown_open = false
}

# Every shape set line of the state, in the order the file listed them.

local _draw_all(ctx: OverlayWorldContext) {
    lines: number = _split_count(state, _newline())
    i: number = 0
    while i < lines {
        line: string = _line_at(state, i)
        if _has_prefix(line, "shapeSet=") {
            _draw_set(ctx, String.substring(line, 9, String.length(line)))
        }
        i = i + 1
    }
}

# One set, as Shape.doUpdate fills its buffer: the cells of the shape its index names, then the origin
# cube, both in the set's own colours and cube sizes. ShapeSet.getShape creates the index's shape at
# its defaults when the set holds none, and the reference draws that, so a set whose file named
# another class still shows both; here the default is drawn without being written into the set, and
# only a property change or the Shape tab's dropdown writes one.
# A saved value the class refuses is regenerated from its default at load, which is what
# State.loadPersistence's updateShape() does, so the set's row is white and it draws. Only a live
# generation error sets `error` at runtime, as the catenary's non-converging solve does, and that
# still keeps the set from being drawn, as the reference's `ready && !error` check does.

local _draw_set(ctx: OverlayWorldContext, set: string) {
    if _set_field_value(set, "visible") != "true" {
        return
    }
    id: number = _set_int(set, "index", 0)
    if id < 0 or id >= _shape_count() {
        return
    }
    if _set_shape_error(set, id) {
        return
    }
    values: string = _set_shape_values(set, id)
    if String.length(values) == 0 {
        values = _shape_defaults(id)
    }
    ox: number = _origin_piece(set, 0)
    oy: number = _origin_piece(set, 1)
    oz: number = _origin_piece(set, 2)
    size: number = _cube_size(set, "shapeCubeSize", 0.6)
    origin_size: number = _cube_size(set, "originCubeSize", 0.2)
    _emit_shape(ctx, id, values, ox, oy, oz, size, _colour(_set_field_value(set, "shapeColour")))
    offset: Vec3 = _origin_offset(id, values)
    _cube(ctx, ox + 0.5 - origin_size / 2 + offset.x(), oy + 0.5 - origin_size / 2 + offset.y(), oz + 0.5 - origin_size / 2 + offset.z(), origin_size, _colour(_set_field_value(set, "originColour")))
}

# ShapeRegistry's fifteen classes, in the order the state file's shape index space uses. The values
# text is the set's, already canonical from the load, so each emitter reads its own properties by
# their declaration index.

local _emit_shape(ctx: OverlayWorldContext, id: number, v: string, ox: number, oy: number, oz: number, size: number, colour: Color) {
    if id == 0 {
        _emit_catenary(ctx, v, ox, oy, oz, size, colour)
    } else if id == 1 {
        _emit_circle(ctx, v, ox, oy, oz, size, colour)
    } else if id == 2 {
        _emit_cone(ctx, v, ox, oy, oz, size, colour)
    } else if id == 3 {
        _emit_cuboid(ctx, v, ox, oy, oz, size, colour)
    } else if id == 4 {
        _emit_ellipse(ctx, v, ox, oy, oz, size, colour)
    } else if id == 5 {
        _emit_ellipsoid(ctx, v, ox, oy, oz, size, colour)
    } else if id == 6 {
        _emit_grid(ctx, v, ox, oy, oz, size, colour)
    } else if id == 7 {
        _emit_helix(ctx, v, ox, oy, oz, size, colour)
    } else if id == 8 {
        _emit_line(ctx, v, ox, oy, oz, size, colour)
    } else if id == 9 {
        _emit_parabola(ctx, v, ox, oy, oz, size, colour)
    } else if id == 10 {
        _emit_paraboloid(ctx, v, ox, oy, oz, size, colour)
    } else if id == 11 {
        _emit_polygon(ctx, v, ox, oy, oz, size, colour)
    } else if id == 12 {
        _emit_pyramid(ctx, v, ox, oy, oz, size, colour)
    } else if id == 13 {
        _emit_sphere(ctx, v, ox, oy, oz, size, colour)
    } else {
        _emit_torus(ctx, v, ox, oy, oz, size, colour)
    }
}

# ShapeCatenary: the rope between the origin and (dx, dy, dz), add_length longer than the straight
# distance, or a vertical rope when the two ends are less than a block apart.
# The reference solves for the catenary parameter with Newton's method and has no iteration bound: a
# solve whose values leave the finite range makes its Double.isFinite check throw, and a solve whose
# step changes nothing repeats that step forever. grug cannot raise an error to the player and must
# not hang, so a step that is not finite, or that changes nothing, ends the solve and the shape draws
# no cells at once. The cell loops keep the reference's own bounds (0 to d, and h to the height)
# rather than a cube cap of this port's own. about.json records this deviation.

local _emit_catenary(ctx: OverlayWorldContext, v: string, ox: number, oy: number, oz: number, size: number, colour: Color) {
    dx: number = _value_int(v, 0)
    dy: number = _value_int(v, 1)
    dz: number = _value_int(v, 2)
    add_length: number = _value_float(v, 4)
    invert: bool = _value_bool(v, 5)
    dr: number = Math.sqrt(dx * dx + dz * dz)
    if dr >= 1 {
        s: number = Math.sqrt(dr * dr + dy * dy) + add_length
        a: number = 1
        chi: number = 2 * a * Math.sinh(dr / 2 / a) - Math.sqrt(s * s - dy * dy)
        solved: bool = _finite(chi)
        while solved and Math.abs(chi) > 0.001 {
            dchi: number = 2 * Math.sinh(dr / 2 / a) - dr / a * Math.cosh(dr / 2 / a)
            next: number = Math.max(a - chi / dchi, a / 2)
            if not _finite(dchi) or not _finite(next) or next == a {
                solved = false
            } else {
                a = next
                chi = 2 * a * Math.sinh(dr / 2 / a) - Math.sqrt(s * s - dy * dy)
                if not _finite(chi) {
                    solved = false
                }
            }
        }
        rl: number = 0
        if solved {
            chi = a * Math.cosh(rl / a) + dy - a * Math.cosh((rl + dr) / a)
            solved = _finite(chi)
        }
        while solved and Math.abs(chi) > 0.001 {
            dchi: number = Math.sinh(rl / a) - Math.sinh((rl + dr) / a)
            next: number = rl - chi / dchi
            if not _finite(dchi) or not _finite(next) or next == rl {
                solved = false
            } else {
                rl = next
                chi = a * Math.cosh(rl / a) + dy - a * Math.cosh((rl + dr) / a)
                if not _finite(chi) {
                    solved = false
                }
            }
        }
        if not solved {
            return
        }
        d: number = _trunc(Math.max(Math.abs(dx), Math.abs(dz)))
        unit_x: number = dx / d
        unit_z: number = dz / d
        fac: number = Math.sqrt(unit_x * unit_x + unit_z * unit_z)
        base: number = a * Math.cosh(rl / a)
        if not _finite(base) {
            return
        }
        h: number = _trunc(Math.min(0, dy) - base)
        i: number = 0
        while i <= d {
            j: number = h
            while j <= Math.max(0, dy) {
                # Dirty hacks so the ends are actually at (0,0,0) and (dx,dy,dz), as the reference's
                # own comment says.
                if not (i == 0 and j > 0) and not (i == d and j > dy) {
                    down: number = a * Math.cosh((i * fac + rl) / a) - base
                    left: number = a * Math.cosh(((i - 0.5) * fac + rl) / a) - base
                    right: number = a * Math.cosh(((i + 0.5) * fac + rl) / a) - base
                    if (down >= j - 0.5 and down < j + 0.5) or (left >= j and right < j) or (right >= j and left < j) {
                        if invert {
                            _shape_cube(ctx, ox, oy, oz, _trunc(unit_x * (d - i) + Math.signum(dx) * 0.5), dy - j, _trunc(unit_z * (d - i) + Math.signum(dz) * 0.5), size, colour)
                        } else {
                            _shape_cube(ctx, ox, oy, oz, _trunc(unit_x * i + Math.signum(dx) * 0.5), j, _trunc(unit_z * i + Math.signum(dz) * 0.5), size, colour)
                        }
                    }
                }
                j = j + 1
            }
            i = i + 1
        }
    } else {
        # No valid catenary solution: a thin rope would go only vertically and double up on itself
        # below the lower starting point.
        start: number = -add_length / 2 - 0.5
        end: number = 0
        if dy < 0 {
            start = start + dy
        } else {
            end = dy
        }
        i: number = _trunc(start)
        while i <= end {
            _shape_cube(ctx, ox, oy, oz, 0, i, 0, size, colour)
            i = i + 1
        }
    }
}

# ShapeCircle: a ring of cells depth deep, opening along direction.

local _emit_circle(ctx: OverlayWorldContext, v: string, ox: number, oy: number, oz: number, size: number, colour: Color) {
    direction: number = _value_enum(v, 0, "X,Y,Z")
    radius: number = _value_float(v, 1)
    depth: number = _value_int(v, 2)
    offset: number = 0
    if _value_bool(v, 3) {
        offset = 0.5
    }
    lower: number = Math.floor(-radius + offset)
    upper: number = Math.ceil(radius + offset)
    z_start: number = 0
    z_end: number = depth
    if depth <= 0 {
        z_start = depth + 1
        z_end = 1
    }
    if not _box_fits(upper - lower + 1, upper - lower + 1, z_end - z_start) {
        return
    }
    x: number = lower
    while x <= upper {
        y: number = lower
        while y <= upper {
            r2: number = (x - offset) * (x - offset) + (y - offset) * (y - offset)
            if r2 >= (radius - 0.5) * (radius - 0.5) and r2 <= (radius + 0.5) * (radius + 0.5) {
                z: number = z_start
                while z < z_end {
                    if direction == 0 {
                        _shape_cube(ctx, ox, oy, oz, z, x, y, size, colour)
                    } else if direction == 1 {
                        _shape_cube(ctx, ox, oy, oz, x, z, y, size, colour)
                    } else {
                        _shape_cube(ctx, ox, oy, oz, x, y, z, size, colour)
                    }
                    z = z + 1
                }
            }
            previous_y: number = y
            y = y + 1
            # A radius the double cannot step past (1e20, or an infinity from a hand-edited file)
            # would loop forever here; the reference casts to int, so its loop ends on an int
            # overflow after a stall of its own. This stops at once instead (#1846).
            if y == previous_y {
                break
            }
        }
        previous_x: number = x
        x = x + 1
        if x == previous_x {
            break
        }
    }
}

# ShapeCone: a cone from the origin to height along direction, radius wide at its base.

local _emit_cone(ctx: OverlayWorldContext, v: string, ox: number, oy: number, oz: number, size: number, colour: Color) {
    direction: number = _value_enum(v, 0, "X,Y,Z")
    radius: number = _value_float(v, 1)
    height: number = _value_float(v, 2)
    offset: number = 0
    if _value_bool(v, 3) {
        offset = 0.5
    }
    lower: number = Math.floor(-radius + offset)
    upper: number = Math.ceil(radius + offset)
    z_start: number = 0
    z_end: number = 0
    if height < 0 {
        z_start = Math.floor(height)
    }
    if height > 0 {
        z_end = Math.ceil(height)
    }
    x: number = lower
    while x <= upper {
        y: number = lower
        while y <= upper {
            z: number = z_start
            while z <= z_end {
                r: number = Math.sqrt((x - offset) * (x - offset) + (y - offset) * (y - offset))
                edge: number = Math.abs(height) * (1 - r / radius)
                edge_in: number = Math.abs(height) * (1 - (r - 0.5) / radius)
                edge_out: number = Math.abs(height) * (1 - (r + 0.5) / radius)
                if r <= radius + 0.5 and ((edge >= Math.abs(z) - 0.5 and edge < Math.abs(z) + 0.5) or (edge_in >= Math.abs(z) and edge_out < Math.abs(z))) {
                    if direction == 0 {
                        _shape_cube(ctx, ox, oy, oz, z, x, y, size, colour)
                    } else if direction == 1 {
                        _shape_cube(ctx, ox, oy, oz, x, z, y, size, colour)
                    } else {
                        _shape_cube(ctx, ox, oy, oz, x, y, z, size, colour)
                    }
                }
                z = z + 1
            }
            y = y + 1
        }
        x = x + 1
    }
}

# ShapeCuboid: the wireframe of the box from the origin to (dx, dy, dz), plus the faces walls names.
# The walls enum ordinals are ALL, X, Y, Z, XY, XZ, YZ, NONE, which is the order the state file
# writes, not the display names the reference's screen shows (XYZ, X, Y, Z, XY, XZ, YZ, -).

local _emit_cuboid(ctx: OverlayWorldContext, v: string, ox: number, oy: number, oz: number, size: number, colour: Color) {
    dx: number = _value_int(v, 0)
    dy: number = _value_int(v, 1)
    dz: number = _value_int(v, 2)
    walls: number = _value_enum(v, 3, "ALL,X,Y,Z,XY,XZ,YZ,NONE")
    centred: bool = _value_bool(v, 4)
    lower_x: number = 0
    lower_y: number = 0
    lower_z: number = 0
    upper_x: number = 0
    upper_y: number = 0
    upper_z: number = 0
    if centred {
        lower_x = -Math.abs(dx) + 1
        lower_y = -Math.abs(dy) + 1
        lower_z = -Math.abs(dz) + 1
        upper_x = Math.abs(dx)
        upper_y = Math.abs(dy)
        upper_z = Math.abs(dz)
    } else {
        if dx > 0 {
            lower_x = 0
            upper_x = dx
        } else {
            lower_x = dx + 1
            upper_x = 1
        }
        if dy > 0 {
            lower_y = 0
            upper_y = dy
        } else {
            lower_y = dy + 1
            upper_y = 1
        }
        if dz > 0 {
            lower_z = 0
            upper_z = dz
        } else {
            lower_z = dz + 1
            upper_z = 1
        }
    }
    x: number = lower_x
    while x < upper_x {
        _shape_cube(ctx, ox, oy, oz, x, lower_y, lower_z, size, colour)
        if upper_y - lower_y > 1 {
            _shape_cube(ctx, ox, oy, oz, x, upper_y - 1, lower_z, size, colour)
        }
        if upper_z - lower_z > 1 {
            _shape_cube(ctx, ox, oy, oz, x, lower_y, upper_z - 1, size, colour)
        }
        if upper_y - lower_y > 1 and upper_z - lower_z > 1 {
            _shape_cube(ctx, ox, oy, oz, x, upper_y - 1, upper_z - 1, size, colour)
        }
        x = x + 1
    }
    y: number = lower_y + 1
    while y < upper_y - 1 {
        _shape_cube(ctx, ox, oy, oz, lower_x, y, lower_z, size, colour)
        if upper_x - lower_x > 1 {
            _shape_cube(ctx, ox, oy, oz, upper_x - 1, y, lower_z, size, colour)
        }
        if upper_z - lower_z > 1 {
            _shape_cube(ctx, ox, oy, oz, lower_x, y, upper_z - 1, size, colour)
        }
        if upper_x - lower_x > 1 and upper_z - lower_z > 1 {
            _shape_cube(ctx, ox, oy, oz, upper_x - 1, y, upper_z - 1, size, colour)
        }
        y = y + 1
    }
    z: number = lower_z + 1
    while z < upper_z - 1 {
        _shape_cube(ctx, ox, oy, oz, lower_x, lower_y, z, size, colour)
        if upper_x - lower_x > 1 {
            _shape_cube(ctx, ox, oy, oz, upper_x - 1, lower_y, z, size, colour)
        }
        if upper_y - lower_y > 1 {
            _shape_cube(ctx, ox, oy, oz, lower_x, upper_y - 1, z, size, colour)
        }
        if upper_x - lower_x > 1 and upper_y - lower_y > 1 {
            _shape_cube(ctx, ox, oy, oz, upper_x - 1, upper_y - 1, z, size, colour)
        }
        z = z + 1
    }
    # X wall
    if walls == 0 or walls == 1 or walls == 4 or walls == 5 {
        y = lower_y + 1
        while y < upper_y - 1 {
            z = lower_z + 1
            while z < upper_z - 1 {
                _shape_cube(ctx, ox, oy, oz, lower_x, y, z, size, colour)
                if upper_x - lower_x > 1 {
                    _shape_cube(ctx, ox, oy, oz, upper_x - 1, y, z, size, colour)
                }
                z = z + 1
            }
            y = y + 1
        }
    }
    # Y wall
    if walls == 0 or walls == 2 or walls == 4 or walls == 6 {
        x = lower_x + 1
        while x < upper_x - 1 {
            z = lower_z + 1
            while z < upper_z - 1 {
                _shape_cube(ctx, ox, oy, oz, x, lower_y, z, size, colour)
                if upper_y - lower_y > 1 {
                    _shape_cube(ctx, ox, oy, oz, x, upper_y - 1, z, size, colour)
                }
                z = z + 1
            }
            x = x + 1
        }
    }
    # Z wall
    if walls == 0 or walls == 3 or walls == 5 or walls == 6 {
        x = lower_x + 1
        while x < upper_x - 1 {
            y = lower_y + 1
            while y < upper_y - 1 {
                _shape_cube(ctx, ox, oy, oz, x, y, lower_z, size, colour)
                if upper_z - lower_z > 1 {
                    _shape_cube(ctx, ox, oy, oz, x, y, upper_z - 1, size, colour)
                }
                y = y + 1
            }
            x = x + 1
        }
    }
}

# ShapeEllipse: a ring of an ellipse with semi-axes semi_y and semi_z, depth deep. The reference's
# edge cases read `b` rather than `b - offset` in one atan2 and one squared term, which is its own
# behaviour and is reproduced here.

local _emit_ellipse(ctx: OverlayWorldContext, v: string, ox: number, oy: number, oz: number, size: number, colour: Color) {
    direction: number = _value_enum(v, 0, "X,Y,Z")
    semi_y: number = _value_float(v, 1)
    semi_z: number = _value_float(v, 2)
    depth: number = _value_int(v, 3)
    offset: number = 0
    if _value_bool(v, 4) {
        offset = 0.5
    }
    a_lower: number = Math.floor(-semi_y + offset)
    a_upper: number = Math.ceil(semi_y + offset)
    b_lower: number = Math.floor(-semi_z + offset)
    b_upper: number = Math.ceil(semi_z + offset)
    s_start: number = 0
    s_end: number = depth
    if depth <= 0 {
        s_start = depth + 1
        s_end = 1
    }
    if not _box_fits(a_upper - a_lower + 1, b_upper - b_lower + 1, s_end - s_start) {
        return
    }
    a: number = a_lower
    while a <= a_upper {
        b: number = b_lower
        while b <= b_upper {
            theta: number = Math.atan2(semi_y / semi_z * (b - offset), a - offset)
            corr: number = Math.sqrt(1 + (semi_y * semi_y / semi_z / semi_z - 1) * Math.sin(theta) * Math.sin(theta))
            dra: number = 0.5 * Math.cos(theta) / corr
            drb: number = 0.5 * Math.sin(theta) * semi_y / semi_z / corr
            r2_inner: number = (a - offset - dra) * (a - offset - dra) / semi_y / semi_y + (b - offset - drb) * (b - offset - drb) / semi_z / semi_z
            r2_outer: number = (a - offset + dra) * (a - offset + dra) / semi_y / semi_y + (b - offset + drb) * (b - offset + drb) / semi_z / semi_z
            skip: bool = false
            # a != 0 and b != 0 for the edge cases, as the reference's comment says
            if not (r2_outer >= 1 and r2_inner <= 1) and a - offset != 0 and b - offset != 0 {
                skip = true
            }
            if a - offset == 0 and Math.abs(b - offset) != semi_z {
                theta2: number = Math.atan2(semi_y / semi_z * b - offset, 1)
                corr2: number = Math.sqrt(1 + (semi_y * semi_y / semi_z / semi_z - 1) * Math.sin(theta2) * Math.sin(theta2))
                dra2: number = 0.5 * Math.cos(theta2) / corr2
                drb2: number = 0.5 * Math.sin(theta2) * semi_y / semi_z / corr2
                r2_inner2: number = (1 - dra2) * (1 - dra2) / semi_y / semi_y + (b - offset - drb2) * (b - offset - drb2) / semi_z / semi_z
                r2_outer2: number = (1 + dra2) * (1 + dra2) / semi_y / semi_y + (b - offset + drb2) * (b - offset + drb2) / semi_z / semi_z
                if (r2_outer2 >= 1 and r2_inner2 <= 1) or 1 / semi_y / semi_y + (b - offset) * (b - offset) / semi_z / semi_z < 1 {
                    skip = true
                }
            }
            if b - offset == 0 and Math.abs(a - offset) != semi_y {
                theta2: number = Math.atan2(semi_y / semi_z, a - offset)
                corr2: number = Math.sqrt(1 + (semi_y * semi_y / semi_z / semi_z - 1) * Math.sin(theta2) * Math.sin(theta2))
                dra2: number = 0.5 * Math.cos(theta2) / corr2
                drb2: number = 0.5 * Math.sin(theta2) * semi_y / semi_z / corr2
                r2_inner2: number = (a - offset - dra2) * (a - offset - dra2) / semi_y / semi_y + (1 - drb2) * (1 - drb2) / semi_z / semi_z
                r2_outer2: number = (a - offset + dra2) * (a - offset + dra2) / semi_y / semi_y + (1 + drb2) * (1 + drb2) / semi_z / semi_z
                if (r2_outer2 >= 1 and r2_inner2 <= 1) or (a - offset) * (a - offset) / semi_y / semi_y + 1 / semi_z / semi_z < 1 {
                    skip = true
                }
            }
            if not skip {
                s: number = s_start
                while s < s_end {
                    if direction == 0 {
                        _shape_cube(ctx, ox, oy, oz, s, a, b, size, colour)
                    } else if direction == 1 {
                        _shape_cube(ctx, ox, oy, oz, a, s, b, size, colour)
                    } else {
                        _shape_cube(ctx, ox, oy, oz, a, b, s, size, colour)
                    }
                    s = s + 1
                }
            }
            previous_b: number = b
            b = b + 1
            # See the circle's guard: a bound the double cannot step past stops here (#1846).
            if b == previous_b {
                break
            }
        }
        previous_a: number = a
        a = a + 1
        if a == previous_a {
            break
        }
    }
}

# ShapeEllipsoid: an ellipsoid with semi-axes semi_x, semi_y and semi_z, optionally a dome. The dome
# ordinal is NO, POSITIVE_X, POSITIVE_Y, POSITIVE_Z, NEGATIVE_X, NEGATIVE_Y, NEGATIVE_Z.

local _emit_ellipsoid(ctx: OverlayWorldContext, v: string, ox: number, oy: number, oz: number, size: number, colour: Color) {
    semi_x: number = _value_float(v, 0)
    semi_y: number = _value_float(v, 1)
    semi_z: number = _value_float(v, 2)
    dome: number = _value_enum(v, 3, "NO,POSITIVE_X,POSITIVE_Y,POSITIVE_Z,NEGATIVE_X,NEGATIVE_Y,NEGATIVE_Z")
    offset: number = 0
    if _value_bool(v, 4) {
        offset = 0.5
    }
    x_start: number = 0
    x_end: number = 0
    if dome == 1 {
        x_start = 0.5 + offset
    } else {
        x_start = -semi_x + offset
    }
    if dome == 4 {
        x_end = -0.5 + offset
    } else {
        x_end = semi_x + offset
    }
    y_start: number = 0
    y_end: number = 0
    if dome == 2 {
        y_start = 0.5 + offset
    } else {
        y_start = -semi_y + offset
    }
    if dome == 5 {
        y_end = -0.5 + offset
    } else {
        y_end = semi_y + offset
    }
    z_start: number = 0
    z_end: number = 0
    if dome == 3 {
        z_start = 0.5 + offset
    } else {
        z_start = -semi_z + offset
    }
    if dome == 6 {
        z_end = -0.5 + offset
    } else {
        z_end = semi_z + offset
    }
    x_lower: number = Math.floor(x_start)
    x_upper: number = Math.ceil(x_end)
    y_lower: number = Math.floor(y_start)
    y_upper: number = Math.ceil(y_end)
    z_lower: number = Math.floor(z_start)
    z_upper: number = Math.ceil(z_end)
    x: number = x_lower
    while x <= x_upper {
        y: number = y_lower
        while y <= y_upper {
            z: number = z_lower
            while z <= z_upper {
                phi: number = Math.atan2(semi_x / semi_y * (y - offset), x - offset)
                theta: number = Math.atan2(Math.sqrt((x - offset) * (x - offset) + semi_x * semi_x / semi_y / semi_y * (y - offset) * (y - offset)), semi_x / semi_z * (z - offset))
                corr: number = Math.sqrt(1 + (semi_x * semi_x / semi_y / semi_y - 1) * Math.sin(phi) * Math.sin(phi) * Math.sin(theta) * Math.sin(theta) + (semi_x * semi_x / semi_z / semi_z - 1) * Math.cos(theta) * Math.cos(theta))
                drx: number = 0.5 * Math.cos(phi) * Math.sin(theta) / corr
                dry: number = 0.5 * Math.sin(phi) * Math.sin(theta) * semi_x / semi_y / corr
                drz: number = 0.5 * Math.cos(theta) * semi_x / semi_z / corr
                r2_inner: number = (x - offset - drx) * (x - offset - drx) / semi_x / semi_x + (y - offset - dry) * (y - offset - dry) / semi_y / semi_y + (z - offset - drz) * (z - offset - drz) / semi_z / semi_z
                r2_outer: number = (x - offset + drx) * (x - offset + drx) / semi_x / semi_x + (y - offset + dry) * (y - offset + dry) / semi_y / semi_y + (z - offset + drz) * (z - offset + drz) / semi_z / semi_z
                if r2_outer >= 1 and r2_inner <= 1 {
                    _shape_cube(ctx, ox, oy, oz, x, y, z, size, colour)
                }
                z = z + 1
            }
            y = y + 1
        }
        x = x + 1
    }
}

# ShapeGrid: steps_x by steps_y by steps_z cells, every offset apart on each axis.

local _emit_grid(ctx: OverlayWorldContext, v: string, ox: number, oy: number, oz: number, size: number, colour: Color) {
    steps_x: number = _value_int(v, 0)
    steps_y: number = _value_int(v, 1)
    steps_z: number = _value_int(v, 2)
    offset_x: number = _value_int(v, 3)
    offset_y: number = _value_int(v, 4)
    offset_z: number = _value_int(v, 5)
    x: number = 0
    while x < steps_x {
        y: number = 0
        while y < steps_y {
            z: number = 0
            while z < steps_z {
                _shape_cube(ctx, ox, oy, oz, x * offset_x, y * offset_y, z * offset_z, size, colour)
                z = z + 1
            }
            y = y + 1
        }
        x = x + 1
    }
}

# ShapeHelix: a helix wound around the direction axis, from inner_radius to outer_radius. The
# reference's float32 arithmetic is widened to double here, which is the port's precision rule.

local _emit_helix(ctx: OverlayWorldContext, v: string, ox: number, oy: number, oz: number, size: number, colour: Color) {
    direction: number = _value_enum(v, 0, "X,Y,Z")
    outer_radius: number = _value_float(v, 1)
    inner_radius: number = _value_float(v, 2)
    height: number = _value_int(v, 3)
    degrees: number = _value_float(v, 4)
    degrees_offset: number = _value_float(v, 5)
    invert: bool = _value_bool(v, 6)
    offset: number = 0
    if _value_bool(v, 7) {
        offset = 0.5
    }
    turns: number = _trunc(Math.ceil(degrees / 360))
    height_per_turn: number = 360 * (height + 1) / degrees
    if height > 0 {
        height_per_turn = 360 * (height - 1) / degrees
    }
    inv: bool = invert
    if height > 0 {
        inv = not inv
    }
    lower: number = Math.floor(-outer_radius + offset)
    upper: number = Math.ceil(outer_radius + offset)
    z_start: number = 0
    z_end: number = 1
    if height > 0 {
        z_end = height
    } else {
        z_start = height + 1
    }
    x: number = lower
    while x <= upper {
        y: number = lower
        while y <= upper {
            r2: number = (x - offset) * (x - offset) + (y - offset) * (y - offset)
            if not (r2 < (inner_radius - 0.5) * (inner_radius - 0.5)) and not (r2 > (outer_radius - 0.5) * (outer_radius - 0.5)) {
                sign: number = 1
                if inv {
                    sign = -1
                }
                theta: number = sign * (Math.toDegrees(Math.atan2(y - offset, x - offset)) - degrees_offset)
                dtheta: number = Math.toDegrees(0.5 / Math.sqrt(r2))
                gradient: number = Math.abs(height_per_turn / (2 * Math.pi() * Math.sqrt(r2)))
                z: number = z_start
                while z < z_end {
                    i: number = -1
                    while i <= turns {
                        hit: bool = false
                        if gradient <= 1 {
                            helix_height: number = (theta / 360 + i) * height_per_turn
                            if helix_height >= z - 0.5 and helix_height < z + 0.5 {
                                angle: number = theta + i * 360
                                if not (angle < Math.min(0, degrees)) and not (angle > Math.max(0, degrees)) {
                                    hit = true
                                }
                            }
                        } else {
                            left: number = ((theta - dtheta) / 360 + i) * height_per_turn
                            right: number = ((theta + dtheta) / 360 + i) * height_per_turn
                            if Math.min(left, right) < z + 0.5 and Math.max(left, right) >= z - 0.5 {
                                angle: number = theta + i * 360
                                if not (angle < Math.min(0, degrees) - dtheta) and not (angle > Math.max(0, degrees) + dtheta) {
                                    hit = true
                                }
                            }
                        }
                        if hit {
                            if direction == 0 {
                                _shape_cube(ctx, ox, oy, oz, z, x, y, size, colour)
                            } else if direction == 1 {
                                _shape_cube(ctx, ox, oy, oz, x, z, y, size, colour)
                            } else {
                                _shape_cube(ctx, ox, oy, oz, x, y, z, size, colour)
                            }
                            i = turns + 1
                        } else {
                            i = i + 1
                        }
                    }
                    z = z + 1
                }
            }
            y = y + 1
        }
        x = x + 1
    }
}

# ShapeLine: a line of cells from the origin to (dx, dy, dz). A line with no delta divides 0 by 0,
# and the reference's (int) cast of that NaN is 0, so it emits the one cell at the origin.

local _emit_line(ctx: OverlayWorldContext, v: string, ox: number, oy: number, oz: number, size: number, colour: Color) {
    dx: number = _value_int(v, 0)
    dy: number = _value_int(v, 1)
    dz: number = _value_int(v, 2)
    d: number = _trunc(Math.max(Math.max(Math.abs(dx), Math.abs(dy)), Math.abs(dz)))
    unit_x: number = dx / d
    unit_y: number = dy / d
    unit_z: number = dz / d
    i: number = 0
    while i <= d {
        _shape_cube(ctx, ox, oy, oz, _trunc(unit_x * i + 0.5 * Math.signum(dx)), _trunc(unit_y * i + 0.5 * Math.signum(dy)), _trunc(unit_z * i + 0.5 * Math.signum(dz)), size, colour)
        i = i + 1
    }
}

# ShapeParabola: the parabolic arc a side of halfwidth wide and height tall, depth deep. The
# rotation ordinal is ROT0, ROT90, ROT180, ROT270 and selects its own row of the reference's
# rotXX, rotXY and rotYX arrays.

local _emit_parabola(ctx: OverlayWorldContext, v: string, ox: number, oy: number, oz: number, size: number, colour: Color) {
    direction: number = _value_enum(v, 0, "X,Y,Z")
    rotation: number = _value_enum(v, 1, "ROT0,ROT90,ROT180,ROT270")
    halfwidth: number = _value_float(v, 2)
    height: number = _value_float(v, 3)
    depth: number = _value_int(v, 4)
    offset: number = 0
    if _value_bool(v, 5) {
        offset = 0.5
    }
    fac: number = height / halfwidth / halfwidth
    lower: number = Math.floor(-halfwidth + offset)
    upper: number = Math.ceil(halfwidth + offset)
    s_start: number = 0
    s_end: number = depth
    if depth <= 0 {
        s_start = depth + 1
        s_end = 1
    }
    a: number = lower
    while a <= upper {
        b: number = 0
        while b < height {
            term: number = fac * (a - offset) * (a - offset)
            inner: number = fac * (a - offset - Math.signum(a - offset)) * (a - offset - Math.signum(a - offset))
            if term >= b and (inner < b or term < b + 1) {
                s: number = s_start
                while s < s_end {
                    sideways: number = b * _rot_xx(rotation) + a * _rot_yx(rotation)
                    across: number = a * _rot_xx(rotation) + b * _rot_xy(rotation)
                    if direction == 0 {
                        _shape_cube(ctx, ox, oy, oz, s, sideways, across, size, colour)
                    } else if direction == 1 {
                        _shape_cube(ctx, ox, oy, oz, sideways, s, across, size, colour)
                    } else {
                        _shape_cube(ctx, ox, oy, oz, across, sideways, s, size, colour)
                    }
                    s = s + 1
                }
            }
            b = b + 1
        }
        a = a + 1
    }
}

# ShapeParaboloid: the paraboloid a halfwidth_y by halfwidth_z bowl, height tall.

local _emit_paraboloid(ctx: OverlayWorldContext, v: string, ox: number, oy: number, oz: number, size: number, colour: Color) {
    direction: number = _value_enum(v, 0, "X,Y,Z")
    halfwidth_y: number = _value_float(v, 1)
    halfwidth_z: number = _value_float(v, 2)
    height: number = _value_int(v, 3)
    offset: number = 0
    if _value_bool(v, 4) {
        offset = 0.5
    }
    fac_y: number = Math.abs(height) / halfwidth_y / halfwidth_y
    fac_z: number = Math.abs(height) / halfwidth_z / halfwidth_z
    a_lower: number = Math.floor(-halfwidth_y + offset)
    a_upper: number = Math.ceil(halfwidth_y + offset)
    b_lower: number = Math.floor(-halfwidth_z + offset)
    b_upper: number = Math.ceil(halfwidth_z + offset)
    a: number = a_lower
    while a <= a_upper {
        b: number = b_lower
        while b <= b_upper {
            c: number = 0
            while c < Math.abs(height) {
                term: number = fac_y * (a - offset) * (a - offset) + fac_z * (b - offset) * (b - offset)
                along_a: number = fac_y * (a - offset - Math.signum(a - offset)) * (a - offset - Math.signum(a - offset)) + fac_z * (b - offset) * (b - offset)
                along_b: number = fac_y * (a - offset) * (a - offset) + fac_z * (b - offset - Math.signum(b - offset)) * (b - offset - Math.signum(b - offset))
                if term >= c and (along_a < c or along_b < c or term < c + 1) {
                    height_cell: number = _trunc(c * Math.signum(height))
                    if direction == 0 {
                        _shape_cube(ctx, ox, oy, oz, height_cell, a, b, size, colour)
                    } else if direction == 1 {
                        _shape_cube(ctx, ox, oy, oz, a, height_cell, b, size, colour)
                    } else {
                        _shape_cube(ctx, ox, oy, oz, a, b, height_cell, size, colour)
                    }
                }
                c = c + 1
            }
            b = b + 1
        }
        a = a + 1
    }
}

# ShapePolygon: the outline of a regular polygon of sides sides, radius out. The reference's epsilon
# makes a whole or half number sit on its edge instead of just beside it.

local _emit_polygon(ctx: OverlayWorldContext, v: string, ox: number, oy: number, oz: number, size: number, colour: Color) {
    sides: number = _value_int(v, 0)
    radius: number = _value_float(v, 1)
    direction: number = _value_enum(v, 2, "X,Y,Z")
    rotation: number = _value_enum(v, 3, "ROT0,ROT90,ROT180,ROT270")
    depth: number = _value_int(v, 4)
    offset: number = 0
    if _value_bool(v, 5) {
        offset = 0.5
    }
    max_r: number = _trunc(Math.ceil((radius + offset) / Math.cos(Math.pi() / sides)))
    h_start: number = 0
    h_end: number = depth
    if depth <= 0 {
        h_start = depth + 1
        h_end = 1
    }
    a: number = -max_r
    while a <= max_r {
        b: number = -max_r
        while b <= max_r {
            theta: number = Math.atan2(b - offset, a - offset) + Math.pi()
            if theta < 0 {
                theta = theta + 2 * Math.pi()
            }
            i: number = _trunc(sides * theta / 2 / Math.pi() + 0.5)
            edge: number = (a - offset) * Math.cos(2 * i * Math.pi() / sides - Math.pi()) + (b - offset) * Math.sin(2 * i * Math.pi() / sides - Math.pi()) - radius + 0.0000000001
            if edge >= -0.5 and edge < 0.5 {
                h: number = h_start
                while h < h_end {
                    sideways: number = a * _rot_xx(rotation) + b * _rot_yx(rotation)
                    across: number = b * _rot_xx(rotation) + a * _rot_xy(rotation)
                    if direction == 0 {
                        _shape_cube(ctx, ox, oy, oz, h, sideways, across, size, colour)
                    } else if direction == 1 {
                        _shape_cube(ctx, ox, oy, oz, sideways, h, across, size, colour)
                    } else {
                        _shape_cube(ctx, ox, oy, oz, across, sideways, h, size, colour)
                    }
                    h = h + 1
                }
            }
            b = b + 1
        }
        a = a + 1
    }
}

# ShapePolygonalPyramid: a pyramid of sides sides, radius wide at its base and height tall.

local _emit_pyramid(ctx: OverlayWorldContext, v: string, ox: number, oy: number, oz: number, size: number, colour: Color) {
    sides: number = _value_int(v, 0)
    radius: number = _value_float(v, 1)
    direction: number = _value_enum(v, 2, "X,Y,Z")
    rotation: number = _value_enum(v, 3, "ROT0,ROT90,ROT180,ROT270")
    height: number = _value_float(v, 4)
    offset: number = 0
    if _value_bool(v, 5) {
        offset = 0.5
    }
    h_start: number = 0
    h_end: number = 1
    if height > 0 {
        h_end = Math.ceil(height)
    } else {
        h_start = Math.floor(height + 1)
    }
    absolute_height: number = Math.abs(height)
    h: number = h_start
    while h < h_end {
        r: number = (radius + 1) * Math.max(absolute_height - Math.abs(h), 0) / absolute_height - 1
        r_next: number = (radius + 1) * Math.max(absolute_height - Math.abs(h) - 1, 0) / absolute_height - 1
        max_r: number = _trunc(Math.ceil((r + offset) / Math.cos(Math.pi() / sides)))
        a: number = -max_r
        while a <= max_r {
            b: number = -max_r
            while b <= max_r {
                theta: number = Math.atan2(b - offset, a - offset) + Math.pi()
                if theta < 0 {
                    theta = theta + 2 * Math.pi()
                }
                i: number = _trunc(sides * theta / 2 / Math.pi() + 0.5)
                inner: number = (a - offset) * Math.cos(2 * i * Math.pi() / sides - Math.pi()) + (b - offset) * Math.sin(2 * i * Math.pi() / sides - Math.pi()) + 0.0000000001
                on_edge: bool = false
                if (inner - r_next >= 0.5 and absolute_height <= radius + 1) or (inner - r >= -0.5 and absolute_height >= radius + 1) {
                    if inner - r < 0.5 and theta >= (2 * i - 1) * Math.pi() / sides and theta < (2 * i + 1) * Math.pi() / sides {
                        on_edge = true
                    }
                }
                if on_edge {
                    sideways: number = a * _rot_xx(rotation) + b * _rot_yx(rotation)
                    across: number = b * _rot_xx(rotation) + a * _rot_xy(rotation)
                    if direction == 0 {
                        _shape_cube(ctx, ox, oy, oz, h, sideways, across, size, colour)
                    } else if direction == 1 {
                        _shape_cube(ctx, ox, oy, oz, sideways, h, across, size, colour)
                    } else {
                        _shape_cube(ctx, ox, oy, oz, across, sideways, h, size, colour)
                    }
                }
                b = b + 1
            }
            a = a + 1
        }
        h = h + 1
    }
}

# ShapeSphere: a shell of cells radius out, optionally a dome.

local _emit_sphere(ctx: OverlayWorldContext, v: string, ox: number, oy: number, oz: number, size: number, colour: Color) {
    radius: number = _value_float(v, 0)
    dome: number = _value_enum(v, 1, "NO,POSITIVE_X,POSITIVE_Y,POSITIVE_Z,NEGATIVE_X,NEGATIVE_Y,NEGATIVE_Z")
    offset: number = 0
    if _value_bool(v, 2) {
        offset = 0.5
    }
    x_start: number = 0
    x_end: number = 0
    if dome == 1 {
        x_start = 0.5 + offset
    } else {
        x_start = -radius + offset
    }
    if dome == 4 {
        x_end = -0.5 + offset
    } else {
        x_end = radius + offset
    }
    y_start: number = 0
    y_end: number = 0
    if dome == 2 {
        y_start = 0.5 + offset
    } else {
        y_start = -radius + offset
    }
    if dome == 5 {
        y_end = -0.5 + offset
    } else {
        y_end = radius + offset
    }
    z_start: number = 0
    z_end: number = 0
    if dome == 3 {
        z_start = 0.5 + offset
    } else {
        z_start = -radius + offset
    }
    if dome == 6 {
        z_end = -0.5 + offset
    } else {
        z_end = radius + offset
    }
    x_lower: number = Math.floor(x_start)
    x_upper: number = Math.ceil(x_end)
    y_lower: number = Math.floor(y_start)
    y_upper: number = Math.ceil(y_end)
    z_lower: number = Math.floor(z_start)
    z_upper: number = Math.ceil(z_end)
    if not _box_fits(x_upper - x_lower + 1, y_upper - y_lower + 1, z_upper - z_lower + 1) {
        return
    }
    x: number = x_lower
    while x <= x_upper {
        y: number = y_lower
        while y <= y_upper {
            z: number = z_lower
            while z <= z_upper {
                r2: number = (x - offset) * (x - offset) + (y - offset) * (y - offset) + (z - offset) * (z - offset)
                if r2 >= (radius - 0.5) * (radius - 0.5) and r2 <= (radius + 0.5) * (radius + 0.5) {
                    _shape_cube(ctx, ox, oy, oz, x, y, z, size, colour)
                }
                z = z + 1
            }
            y = y + 1
        }
        x = x + 1
    }
}

# ShapeTorus: a torus of outer_radius around the direction axis, the tube inner_radius thick.

local _emit_torus(ctx: OverlayWorldContext, v: string, ox: number, oy: number, oz: number, size: number, colour: Color) {
    direction: number = _value_enum(v, 0, "X,Y,Z")
    outer_radius: number = _value_float(v, 1)
    inner_radius: number = _value_float(v, 2)
    outer_offset: number = 0
    if _value_bool(v, 3) {
        outer_offset = 0.5
    }
    inner_offset: number = 0
    if _value_bool(v, 4) {
        inner_offset = 0.5
    }
    a_lower: number = Math.floor(-outer_radius - inner_radius - outer_offset)
    a_upper: number = Math.ceil(outer_radius + inner_radius + 1 + outer_offset)
    c_lower: number = Math.floor(-inner_radius + inner_offset)
    c_upper: number = Math.ceil(inner_radius + 1 + inner_offset)
    if not _box_fits(a_upper - a_lower, a_upper - a_lower, c_upper - c_lower) {
        return
    }
    a: number = a_lower
    while a < a_upper {
        b: number = a_lower
        while b < a_upper {
            theta: number = Math.atan2(b - outer_offset, a - outer_offset)
            ring_a: number = outer_radius * Math.cos(theta) + outer_offset
            ring_b: number = outer_radius * Math.sin(theta) + outer_offset
            c: number = c_lower
            while c < c_upper {
                r2: number = (a - ring_a) * (a - ring_a) + (b - ring_b) * (b - ring_b) + (c - inner_offset) * (c - inner_offset)
                if r2 >= (inner_radius - 0.5) * (inner_radius - 0.5) and r2 < (inner_radius + 0.5) * (inner_radius + 0.5) {
                    if direction == 0 {
                        _shape_cube(ctx, ox, oy, oz, c, b, a, size, colour)
                    } else if direction == 1 {
                        _shape_cube(ctx, ox, oy, oz, a, c, b, size, colour)
                    } else {
                        _shape_cube(ctx, ox, oy, oz, b, a, c, size, colour)
                    }
                }
                c = c + 1
            }
            b = b + 1
        }
        a = a + 1
    }
}

# One cell of a shape, at the set's origin: Shape.addShapeCube centres a cube of the set's size on the
# block the cell names. A frame that counts instead of drawing increments the count here, which is
# Shape.addShapeCube's ++nBlocks, and draws nothing.

local _shape_cube(ctx: OverlayWorldContext, ox: number, oy: number, oz: number, x: number, y: number, z: number, size: number, colour: Color) {
    if cell_counting {
        cell_count = cell_count + 1
        return
    }
    half: number = 0.5 - size / 2
    _cube(ctx, ox + x + half, oy + y + half, oz + z + half, size, colour)
}

# Shape.addCube: six quads in the reference's own vertex order and winding, as twelve triangles
# because a world pass draws triangles. A quad's two triangles are its first three corners and its
# first, third and fourth, which is how the game's own quad builder splits one.
# The cube's corners are the minimum corner and the size, in world coordinates.

local _cube(ctx: OverlayWorldContext, x: number, y: number, z: number, s: number, colour: Color) {
    # -X
    _quad(ctx, x, y, z, x, y, z + s, x, y + s, z + s, x, y + s, z, colour)
    # -Y
    _quad(ctx, x, y, z, x + s, y, z, x + s, y, z + s, x, y, z + s, colour)
    # -Z
    _quad(ctx, x, y, z, x, y + s, z, x + s, y + s, z, x + s, y, z, colour)
    # +X
    _quad(ctx, x + s, y, z, x + s, y + s, z, x + s, y + s, z + s, x + s, y, z + s, colour)
    # +Y
    _quad(ctx, x, y + s, z, x, y + s, z + s, x + s, y + s, z + s, x + s, y + s, z, colour)
    # +Z
    _quad(ctx, x, y, z + s, x + s, y, z + s, x + s, y + s, z + s, x, y + s, z + s, colour)
}

local _quad(ctx: OverlayWorldContext, x1: number, y1: number, z1: number, x2: number, y2: number, z2: number, x3: number, y3: number, z3: number, x4: number, y4: number, z4: number, colour: Color) {
    ctx.draw_triangle(x1, y1, z1, x2, y2, z2, x3, y3, z3, colour)
    ctx.draw_triangle(x1, y1, z1, x3, y3, z3, x4, y4, z4, colour)
}

# Shape.setOriginOffset, per class: the even-mode offset moves the origin cube into the block the
# shape's cells are centred in, and the direction, rotation and torus even modes choose which axes
# move. Every class the reference leaves at (0,0,0) is listed, because the offset is a property of
# the class and not of the set.

local _origin_offset(id: number, v: string) Vec3 {
    if id == 1 or id == 2 {
        return _origin_dir(_value_enum(v, 0, "X,Y,Z"), _value_bool(v, 3))
    }
    if id == 4 {
        return _origin_dir(_value_enum(v, 0, "X,Y,Z"), _value_bool(v, 4))
    }
    if id == 7 {
        return _origin_dir(_value_enum(v, 0, "X,Y,Z"), _value_bool(v, 7))
    }
    if id == 10 {
        return _origin_dir(_value_enum(v, 0, "X,Y,Z"), _value_bool(v, 4))
    }
    if id == 11 or id == 12 {
        return _origin_dir(_value_enum(v, 2, "X,Y,Z"), _value_bool(v, 5))
    }
    if id == 5 {
        offset: number = 0
        if _value_bool(v, 4) {
            offset = 0.5
        }
        return Vec3.new(offset, offset, offset)
    }
    if id == 13 {
        offset: number = 0
        if _value_bool(v, 2) {
            offset = 0.5
        }
        return Vec3.new(offset, offset, offset)
    }
    if id == 9 {
        offset: number = 0
        if _value_bool(v, 5) {
            offset = 0.5
        }
        rotation: number = _value_enum(v, 1, "ROT0,ROT90,ROT180,ROT270")
        direction: number = _value_enum(v, 0, "X,Y,Z")
        if direction == 0 {
            return Vec3.new(0, offset * _rot_yx(rotation), offset * _rot_xx(rotation))
        }
        if direction == 1 {
            return Vec3.new(offset * _rot_yx(rotation), 0, offset * _rot_xx(rotation))
        }
        return Vec3.new(offset * _rot_xx(rotation), offset * _rot_yx(rotation), 0)
    }
    if id == 14 {
        outer: number = 0
        if _value_bool(v, 3) {
            outer = 0.5
        }
        inner: number = 0
        if _value_bool(v, 4) {
            inner = 0.5
        }
        direction: number = _value_enum(v, 0, "X,Y,Z")
        if direction == 0 {
            return Vec3.new(inner, outer, outer)
        }
        if direction == 1 {
            return Vec3.new(outer, inner, outer)
        }
        return Vec3.new(outer, outer, inner)
    }
    return Vec3.new(0, 0, 0)
}

local _origin_dir(direction: number, even_mode: bool) Vec3 {
    offset: number = 0
    if even_mode {
        offset = 0.5
    }
    if direction == 0 {
        return Vec3.new(0, offset, offset)
    }
    if direction == 1 {
        return Vec3.new(offset, 0, offset)
    }
    return Vec3.new(offset, offset, 0)
}

# Java's (int) cast: it truncates towards zero, and NaN becomes 0, which a line with no delta needs
# because it divides 0 by 0.

local _trunc(value: number) number {
    if not (value == value) {
        return 0
    }
    rounded: number = Math.floor(value)
    if value < 0 {
        rounded = Math.ceil(value)
    }
    if rounded > 2147483647 {
        return 2147483647
    }
    if rounded < -2147483648 {
        return -2147483648
    }
    if rounded < 1 and rounded > -1 {
        return 0
    }
    return rounded
}

# x - x is 0 for every finite value and NaN for an infinity or a NaN, which is the isFinite test the
# reference applies to its catenary solve.

local _finite(value: number) bool {
    return Math.abs(value) - Math.abs(value) == 0
}

# Whether a cell loop of the given three spans scans at most max_shape_positions positions. A span
# that is not finite (an infinity from a hand-edited file, or a subtraction of two infinities) or
# not positive draws nothing, which is where about.json records the deviation.
local _box_fits(x_span: number, y_span: number, z_span: number) bool {
    if not _finite(x_span) or not _finite(y_span) or not _finite(z_span) {
        return false
    }
    if not (x_span > 0) or not (y_span > 0) or not (z_span > 0) {
        return false
    }
    # Each factor is compared before it is multiplied, so no product can reach an infinity.
    return x_span <= max_shape_positions and y_span <= max_shape_positions / x_span and z_span <= max_shape_positions / x_span / y_span
}

local _rot_xx(rotation: number) number {
    if rotation == 0 {
        return 1
    }
    if rotation == 2 {
        return -1
    }
    return 0
}

local _rot_xy(rotation: number) number {
    if rotation == 1 {
        return -1
    }
    if rotation == 3 {
        return 1
    }
    return 0
}

local _rot_yx(rotation: number) number {
    if rotation == 1 {
        return 1
    }
    if rotation == 3 {
        return -1
    }
    return 0
}

# --- the property text -------------------------------------------------------

# One property value by its declaration index. A loaded set's text is canonical, because the codec
# below reprints every value the way the reference does, and a set with no entry is drawn from the
# registry's default text, so these readers see a value the reference's own parser accepted.

local _value_int(v: string, index: number) number {
    parsed: Option[number] = String.to_integer(_piece(v, ",", index))
    if parsed.has() {
        return parsed.unwrap()
    }
    return 0
}

local _value_float(v: string, index: number) number {
    parsed: Option[number] = String.to_float(_piece(v, ",", index))
    if parsed.has() {
        return parsed.unwrap()
    }
    return 0
}

local _value_bool(v: string, index: number) bool {
    return _piece(v, ",", index) == "true"
}

# An enum's declaration ordinal, which is the index of its name in the class's own constant list.

local _value_enum(v: string, index: number, names: string) number {
    piece: string = _piece(v, ",", index)
    count: number = _split_count(names, ",")
    i: number = 0
    while i < count {
        if _piece(names, ",", i) == piece {
            return i
        }
        i = i + 1
    }
    return 0
}

# A set's colour, as Shape.doUpdate hands it to the buffer: (int) (255 * component), which truncates
# and turns NaN into 0, and then the byte write of a COLOR/UBYTE vertex element, which keeps the low
# eight bits. So a component outside 0..1 wraps modulo 256 as it does in the reference's own
# BufferVertexConsumer, and a hand-edited file with 2.5 draws channel 125, not 255.

local _colour(text: string) Color {
    return Color.rgba(_colour_channel(text, 0), _colour_channel(text, 1), _colour_channel(text, 2), _colour_channel(text, 3))
}

local _colour_channel(text: string, index: number) number {
    whole: number = _trunc(255 * _value_float(text, index))
    wrapped: number = Math.remainder(whole, 256)
    if wrapped < 0 {
        wrapped = wrapped + 256
    }
    return wrapped
}

# A set's cube size, as ShapeSet.getShapeCubeSize and getOriginCubeSize answer it: the file's value,
# with Math.min's cap for a finite value. Math.min leaves NaN as it is, and an infinite or NaN size
# makes every vertex of the cube non-finite, so the reference's GPU draws nothing for that set's
# cubes. draw_triangle refuses a non-finite coordinate with a host error on every frame, so a
# non-finite size answers 0.0 instead: the same nothing, as a cube with no volume, without the host
# error. The cell still counts, as it does in the reference.

local _cube_size(set: string, key: string, fallback: number) number {
    parsed: Option[number] = String.to_number(_set_field_value(set, key))
    size: number = fallback
    if parsed.has() {
        size = parsed.unwrap()
    }
    if not _finite(size) {
        return 0.0
    }
    if not (size <= 1.0 - 0.001) {
        return 1.0 - 0.001
    }
    return size
}

# ==== the state and config text model ====
# The state is one string in the reference's own file format, so a guide saved by the reference is
# the same guide here: `enabled`, `depthTest`, one `shapeSet=` per set, `iShapeSet`, `iShapeNew`,
# each on its own line with a line feed after it, including the last. A set is its own fields and its
# shapes joined by a `|` bar that never reaches either file, and a `!` after the class name marks a
# shape whose properties did not parse. Saving drops the marker and keeps the shape, which is stage
# 2's work: this file loads a state and never writes one.
# The file paths are inside the root File.open(r"files") answers (#1757): the state at
# `buildguide/<world>@<dimension>.dat` and the config at `config/buildguide.cfg`, where the reference
# writes under the game directory. The formats themselves are the reference's, byte for byte.
# A number the reference reads with Integer.parseInt, Float.parseFloat or Double.parseDouble throws
# when the text is not a number, and nothing in State.loadPersistence or ShapeSet.restorePersistence
# catches it: the load stops where the throwing entry is, keeping what it already applied, and the
# clamps after the loop never run. grug turns no error into an exception, so the same stop is a flag,
# and the entries before the bad one are applied while the ones after it and the later lines are not
# (#1816).
# A shape's property values are re-read and re-printed on every load, because the reference's
# setValueFromString parses each piece and getStringValue prints it: a float is Float.toString of the
# float32 it parsed, a double is Double.toString, an int is Integer.toString, and a boolean and an
# enum are canonicalised. So a file with odd spellings loads in the reference's own text.
# Float.parseFloat is String.to_float and not String.to_number narrowed, and the printing is
# String.from_float and String.from_double, which is Java 19 and later's own text on every JDK.

# Reads the config once and keeps its three values as "async,random,persistence".
# Config's constructor loads the file, writing the default one when there is none and rewriting it
# whole when a key is missing, and Config.load catches the IOException a refused write raises, prints
# it and keeps the values it parsed. write_text's host error is the print here: it ends the call that
# made it, so the values are assigned and the flag is set before the write, and a refused file leaves
# them in use for the next frame, as the reference's catch does.

local _ensure_config(files: File) {
    if config_loaded {
        return
    }
    text: Option[string] = files.read_text("config/buildguide.cfg")
    config_values = _config_default_values()
    if text.has() {
        config_values = _config_parse(text.unwrap(), config_values)
    }
    config_loaded = true
    if not text.has() or _config_missing(text.unwrap()) {
        # Config.load writes the defaults it is missing, and Config.write catches the IOException and
        # prints it, keeping the values it has. The host reports a refused write the same way, by
        # printing it and ending this call, and the defaults are already in use.
        files.write_text("config/buildguide.cfg", _config_text(config_values))
    }
}

# Creates, and loads when persistence is on, the state of the world and dimension this frame is in.
# The reference's AbstractStateManager keeps one State per key in a HashMap for the session, so an
# edit no screen close saved yet is still there on return to a key; `state_store` keeps every
# visited key's state, its initialised flag and its written flag, and a switch back restores them
# without reading the file again.

local _ensure_state(files: File, level: Level, name: string, dimension: string, key: string, x: number, y: number, z: number) {
    if state_loaded and state_key == key {
        return
    }
    if state_loaded {
        # The stored written flag answers whether the file matched the state when the key was left,
        # not merely whether a save ever happened: an edit no close saved has to write on the next
        # close after the key is restored.
        matched: bool = persistence_written and _state_file_text(state) == persistence_text
        _store_put(state_key, state, state_initialised, matched)
    }
    state_key = key
    state_loaded = true
    persistence_text = ""
    if _store_present(key) {
        # The same State object comes back, so its initialised flag and whatever it had in memory
        # are the reference's; the written text is the state's own text exactly when the file was
        # last left matching it, which is what the stored written flag records.
        state = _store_state(key)
        state_initialised = _store_flag(key, 1)
        persistence_written = _store_flag(key, 2)
        if persistence_written {
            persistence_text = _state_file_text(state)
        }
    } else {
        state = _state_open(files, name, dimension, _config_persistence(config_values), x, y, z)
        state_initialised = false
        # A new key is a new State in the reference, and its load leaves persistence to be written
        # once, so the next close writes this world's text even when it matches nothing saved.
        persistence_written = false
    }
    # A press counted before this key change belongs to the state that was showing, not to this
    # one, and the reference has no way to carry it across a world or dimension switch (#1846).
    pending_toggle = 0
    pending_origin = 0
    pending_global_origin = 0
}

# The state as the persistence file holds it: without the `!` after a refused shape's class name,
# which is this text's own marker, and without the `|` between a set's own fields and its shapes,
# which is this text's separator. A close saves this text.

local _state_file_text(text: string) string {
    return _replace_all(_replace_all(text, "!", ""), "|", "")
}

# One visited key's record in `state_store`, which is a run of records and nothing else: the key,
# then the length of the state text, then the state exactly as it is, then the initialised flag and
# the written flag, each on its own line. The state has line feeds of its own, so its length goes
# before it and no line of it can be mistaken for a field after it; a key never holds a line feed,
# because the host refuses a path with a control character in it (#1757). The written flag is the
# file's match with the state, so a restored key recomputes its saved text only when there is
# nothing to save.

local _store_put(key: string, text: string, initialised: bool, written: bool) {
    out: string = ""
    pos: number = 0
    total: number = String.length(state_store)
    while pos < total {
        next: number = _store_next(pos)
        if _store_key_at(pos) != key {
            out = String.concat(out, String.substring(state_store, pos, next))
        }
        if next <= pos {
            pos = total
        } else {
            pos = next
        }
    }
    out = String.concat(out, _line(key))
    out = String.concat(out, _line(String.from_number(String.length(text))))
    out = String.concat(out, text)
    out = String.concat(out, _line(_bool_text(initialised)))
    out = String.concat(out, _line(_bool_text(written)))
    state_store = out
}

local _store_present(key: string) bool {
    return _store_at(key) >= 0
}

local _store_at(key: string) number {
    pos: number = 0
    total: number = String.length(state_store)
    while pos < total {
        if _store_key_at(pos) == key {
            return pos
        }
        next: number = _store_next(pos)
        if next <= pos {
            return -1
        }
        pos = next
    }
    return -1
}

local _store_key_at(pos: number) string {
    key_end: number = _index_from(state_store, _newline(), pos)
    if key_end < 0 {
        return ""
    }
    return String.substring(state_store, pos, key_end)
}

# Where the record at this position ends: past its two flag lines.
local _store_next(pos: number) number {
    key_end: number = _index_from(state_store, _newline(), pos)
    if key_end < 0 {
        return String.length(state_store)
    }
    length_end: number = _index_from(state_store, _newline(), key_end + 1)
    if length_end < 0 {
        return String.length(state_store)
    }
    width: number = _int_or(String.substring(state_store, key_end + 1, length_end), 0)
    init_end: number = _index_from(state_store, _newline(), length_end + 1 + width)
    if init_end < 0 {
        return String.length(state_store)
    }
    written_end: number = _index_from(state_store, _newline(), init_end + 1)
    if written_end < 0 {
        return String.length(state_store)
    }
    return written_end + 1
}

local _store_state(key: string) string {
    at: number = _store_at(key)
    if at < 0 {
        return ""
    }
    start: number = _store_state_start(at)
    if start < 0 {
        return ""
    }
    return String.substring(state_store, start, start + _store_state_width(at))
}

# Field 1 is the initialised flag and 2 the written flag, as the record stores them.
local _store_flag(key: string, field: number) bool {
    at: number = _store_at(key)
    if at < 0 {
        return false
    }
    start: number = _store_state_start(at)
    if start < 0 {
        return false
    }
    after: number = start + _store_state_width(at)
    init_end: number = _index_from(state_store, _newline(), after)
    if init_end < 0 {
        return false
    }
    if field == 1 {
        return String.substring(state_store, after, init_end) == "true"
    }
    written_end: number = _index_from(state_store, _newline(), init_end + 1)
    if written_end < 0 {
        return false
    }
    return String.substring(state_store, init_end + 1, written_end) == "true"
}

local _store_state_start(at: number) number {
    key_end: number = _index_from(state_store, _newline(), at)
    if key_end < 0 {
        return -1
    }
    length_end: number = _index_from(state_store, _newline(), key_end + 1)
    if length_end < 0 {
        return -1
    }
    return length_end + 1
}

local _store_state_width(at: number) number {
    key_end: number = _index_from(state_store, _newline(), at)
    if key_end < 0 {
        return 0
    }
    length_end: number = _index_from(state_store, _newline(), key_end + 1)
    if length_end < 0 {
        return 0
    }
    return _int_or(String.substring(state_store, key_end + 1, length_end), 0)
}

# The state for a world: loaded from its file on the first access when persistence is enabled. The
# set a fresh state gets, and the origin a set without one gets, wait for initCheck, which the toggle
# key runs, so nothing here takes the player's position except the load's own defaults for a set the
# file left an origin out of.

local _state_open(files: File, name: string, dimension: string, persistence: bool, x: number, y: number, z: number) string {
    loaded: string = _state_new()
    if persistence {
        text: Option[string] = files.read_text(_state_path(name, dimension))
        if text.has() {
            loaded = _state_load(text.unwrap(), x, y, z)
        }
    }
    return loaded
}

# The clamps after State.loadPersistence's loop live in _state_load, where the reference has them,
# and run only when the whole file was read: a load that stopped keeps the values it applied, as
# #1816 records.

# State.loadPersistence: one line per entry, the five known keys, and a hard stop where a number is
# not one. The clamps after the loop run only when the whole file was read, as they do in the
# reference; the partial state is returned instead of raising, which is #1816's deviation.

local _state_load(text: string, x: number, y: number, z: number) string {
    load_failed = false
    enabled: string = "false"
    depth: string = "true"
    sets: string = ""
    count: number = 0
    i_set: string = "0"
    i_new: string = "1"
    lines: number = _split_count(text, _newline())
    i: number = 0
    while i < lines and not load_failed {
        line: string = _line_at(text, i)
        at: number = String.index_of(line, "=")
        if at > 0 {
            key: string = String.substring(line, 0, at)
            value: string = String.substring(line, at + 1, String.length(line))
            if key == "enabled" {
                enabled = _boolean_text(value)
            } else if key == "depthTest" {
                depth = _boolean_text(value)
            } else if key == "shapeSet" {
                new_index: Option[number] = String.to_integer(i_new)
                if not new_index.has() or new_index.unwrap() < 0 or new_index.unwrap() >= _shape_count() {
                    # new ShapeSet(iShapeNew) throws on the array, before the set is pushed.
                    load_failed = true
                } else {
                    set: string = _set_restore(_set_new(new_index.unwrap(), x, y, z), value)
                    sets = String.concat(sets, _line(String.concat("shapeSet=", set)))
                    count = count + 1
                }
            } else if key == "iShapeSet" {
                i_set = _state_parse_int(value, i_set)
            } else if key == "iShapeNew" {
                i_new = _state_parse_int(value, i_new)
            }
        }
        i = i + 1
    }
    if not load_failed {
        i_set = String.from_number(_state_clamp_set(_int_or(i_set, 0), count))
        i_new = String.from_number(_clamp(_int_or(i_new, 1), 0, _shape_count() - 1))
        # State.loadPersistence calls updateShape() right after restorePersistence, and every
        # Shape.update clears `error` inside its task and regenerates from the property values in
        # place, which are the defaults for a refused piece. So a refused saved value is not a
        # permanent error: the shape draws from its default (#1888). The marker survives only in a
        # stopped load's partial state, which #1816 records as a deviation.
        sets = _replace_all(sets, "!", "")
    }
    return _state_text(enabled, depth, sets, i_set, i_new)
}

# An empty state: no file behind it, so no set, disabled, with the depth test on, and a circle as the
# shape the next set starts with.

local _state_new() string {
    return _state_text("false", "true", "", "0", "1")
}

# A whole number the file holds, or the value to keep and the hard stop, which is what a
# NumberFormatException does here.

local _state_parse_int(value: string, keep: string) string {
    parsed: Option[number] = String.to_integer(value)
    if not parsed.has() {
        load_failed = true
        return keep
    }
    return String.from_number(parsed.unwrap())
}

# The state text in the reference's own line order, with a line feed after every line, including the
# last, which is what State.savePersistence writes.

local _state_text(enabled: string, depth: string, sets: string, i_set: string, i_new: string) string {
    out: string = _line(String.concat("enabled=", enabled))
    out = String.concat(out, _line(String.concat("depthTest=", depth)))
    out = String.concat(out, sets)
    out = String.concat(out, _line(String.concat("iShapeSet=", i_set)))
    out = String.concat(out, _line(String.concat("iShapeNew=", i_new)))
    return out
}

# Math.max(0, Math.min(count - 1, value)), where an empty list answers 0 through the outer max.

local _state_clamp_set(value: number, count: number) number {
    if count < 1 {
        return 0
    }
    return _clamp(value, 0, count - 1)
}

local _state_enabled() bool {
    return _state_field(state, "enabled", "false") == "true"
}

local _state_set_count() number {
    lines: number = _split_count(state, _newline())
    count: number = 0
    i: number = 0
    while i < lines {
        if _has_prefix(_line_at(state, i), "shapeSet=") {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

# State.getCurrentShapeSet: the set iShapeSet names, whose index a whole load clamps into range. A
# partial load can leave it past the last set, so it is clamped again here.

local _state_current_set() string {
    wanted: number = _clamp(_int_or(_state_field(state, "iShapeSet", ""), 0), 0, _state_set_count() - 1)
    return _state_set_at(state, wanted)
}

# A scalar line's value, or the fallback when the line is not there.

local _state_field(text: string, key: string, fallback: string) string {
    prefix: string = String.concat(key, "=")
    lines: number = _split_count(text, _newline())
    i: number = 0
    while i < lines {
        line: string = _line_at(text, i)
        if _has_prefix(line, prefix) {
            return String.substring(line, String.length(prefix), String.length(line))
        }
        i = i + 1
    }
    return fallback
}

# The shapeSet line a given sequence number holds, or an empty text when there are fewer sets.

local _state_set_at(text: string, wanted: number) string {
    lines: number = _split_count(text, _newline())
    found: number = 0
    i: number = 0
    while i < lines {
        line: string = _line_at(text, i)
        if _has_prefix(line, "shapeSet=") {
            if found == wanted {
                return String.substring(line, 9, String.length(line))
            }
            found = found + 1
        }
        i = i + 1
    }
    return ""
}

# The state with one scalar line replaced, or appended in the reference's order when it is not there.

# The file a state for this world lives at, inside the writable root (#1757).

local _state_path(name: string, dimension: string) string {
    return String.concat("buildguide/", _state_filename(name, dimension))
}

# The key the state is kept in memory under: the raw world and dimension, as the reference's
# stateStore is keyed, so two names that sanitise alike keep two states here (#1846). They still
# share one file, as they do in the reference.

local _state_key(name: string, dimension: string) string {
    return String.concat(String.concat(_state_host(name), "@"), _dimension_text(dimension))
}

# AbstractStateManager.getPersistenceFile: the world and the dimension joined by an at sign, every
# character a Windows file name refuses replaced by a dot, then ".dat".

local _state_filename(name: string, dimension: string) string {
    return String.concat(_sanitise(_state_key(name, dimension)), ".dat")
}

# The reference falls back to the server's address and then to "unknown"; Level.name answers the
# address already and never an empty text, so only the last fallback is kept.

local _state_host(name: string) string {
    if String.length(name) == 0 {
        return "unknown"
    }
    return name
}

# Level.dimension's path segment back to the resource location the reference's
# location().toString() writes: dimension_<namespace>~<path with + for />.

local _dimension_text(dimension: string) string {
    if dimension == "overworld" {
        return "minecraft:overworld"
    }
    if dimension == "the_nether" {
        return "minecraft:the_nether"
    }
    if dimension == "the_end" {
        return "minecraft:the_end"
    }
    if _has_prefix(dimension, "dimension_") {
        key: string = String.substring(dimension, 10, String.length(dimension))
        tilde: number = String.index_of(key, "~")
        if tilde > 0 {
            namespace: string = String.substring(key, 0, tilde)
            path: string = String.substring(key, tilde + 1, String.length(key))
            return String.concat(String.concat(namespace, ":"), _replace_all(path, "+", "/"))
        }
    }
    return dimension
}

# AbstractStateManager's sanitiser: each of / < > : " \ | ? * becomes a dot. The order cannot matter,
# because the characters are distinct.

local _sanitise(text: string) string {
    out: string = text
    out = _replace_all(out, "/", ".")
    out = _replace_all(out, "<", ".")
    out = _replace_all(out, ">", ".")
    out = _replace_all(out, ":", ".")
    out = _replace_all(out, "\"", ".")
    out = _replace_all(out, "\\", ".")
    out = _replace_all(out, "|", ".")
    out = _replace_all(out, "?", ".")
    out = _replace_all(out, "*", ".")
    return out
}

# ---------------------------------------------------------------- the config

# The three values in file order: async shape generation, random colours for a new set, persistence.

local _config_default_values() string {
    return "true,false,false"
}

# Config.write: a "# " comment line, then "key = value", for each of the three in order. The comment
# is the en_us sentence, where the reference writes the client's language through Translatable, which
# is #1817's deviation.

local _config_text(values: string) string {
    async: string = _piece(values, ",", 0)
    random: string = _piece(values, ",", 1)
    persistence: string = _piece(values, ",", 2)
    return String.concat(_line("# Enable asynchronous (multithreaded) shape generation."), String.concat(_line(String.concat("asyncEnabled = ", async)), String.concat(_line("# Enable random colors for new shapes added to the shape list by default."), String.concat(_line(String.concat("shapeListRandomColorsDefaultEnabled = ", random)), String.concat(_line("# Allow shapes to be saved to a file so they can be restored after restarting the client."), _line(String.concat("persistenceEnabled = ", persistence)))))))
}

# Whether any of the three keys is absent, which makes Config.write rewrite the whole file.

local _config_missing(text: string) bool {
    return not _config_has_key(text, "asyncEnabled") or not _config_has_key(text, "shapeListRandomColorsDefaultEnabled") or not _config_has_key(text, "persistenceEnabled")
}

local _config_has_key(text: string, wanted: string) bool {
    lines: number = _split_count(text, _newline())
    i: number = 0
    while i < lines {
        line: string = String.trim(_line_at(text, i))
        if String.length(line) > 0 and not _has_prefix(line, "#") {
            at: number = String.index_of(line, " = ")
            if at >= 0 and String.substring(line, 0, at) == wanted {
                return true
            }
        }
        i = i + 1
    }
    return false
}

# Config.load: trim, skip an empty line and a comment, split at the first " = " with a limit of 2, and
# read each known key as Boolean.parseBoolean. A line without the separator is skipped, as the
# reference reports it and carries on.

local _config_parse(text: string, current: string) string {
    async: string = _piece(current, ",", 0)
    random: string = _piece(current, ",", 1)
    persistence: string = _piece(current, ",", 2)
    lines: number = _split_count(text, _newline())
    i: number = 0
    while i < lines {
        line: string = String.trim(_line_at(text, i))
        if String.length(line) > 0 and not _has_prefix(line, "#") {
            at: number = String.index_of(line, " = ")
            if at >= 0 {
                key: string = String.substring(line, 0, at)
                value: string = String.substring(line, at + 3, String.length(line))
                if key == "asyncEnabled" {
                    async = _boolean_text(value)
                } else if key == "shapeListRandomColorsDefaultEnabled" {
                    random = _boolean_text(value)
                } else if key == "persistenceEnabled" {
                    persistence = _boolean_text(value)
                }
            }
        }
        i = i + 1
    }
    return String.concat(String.concat(async, ","), String.concat(random, String.concat(",", persistence)))
}

# The persistence switch, which the third value holds.

local _config_persistence(values: string) bool {
    return _piece(values, ",", 2) == "true"
}

# ---------------------------------------------------------------- a shape set

# A new set, as ShapeSet's constructor and resetOrigin leave it: the index it starts at, the player's
# position as its origin, the reference's default colours and cube sizes, and one shape of the class
# the index names, at that class's own defaults.

local _set_new(index: number, x: number, y: number, z: number) string {
    fields: string = String.concat("index=", String.from_number(index))
    fields = String.concat(fields, ";origin=")
    fields = String.concat(fields, _origin_text(x, y, z))
    fields = String.concat(fields, ";visible=true;shapeColour=1.0,1.0,1.0,0.5;originColour=1.0,0.0,0.0,0.5;shapeCubeSize=0.6;originCubeSize=0.2;")
    shapes: string = String.concat(String.concat(_shape_class(index), "="), String.concat(_shape_defaults(index), ";"))
    return String.concat(fields, String.concat("|", shapes))
}

# ShapeSet.restorePersistence: one entry per ";", the seven own fields and then a class name per
# shape. A number the reference would throw on sets the hard stop. The index is clamped to the
# registry at the end, unless the stop happened first.

local _set_restore(set: string, data: string) string {
    entries: number = _split_count(data, ";")
    i: number = 0
    while i < entries and not load_failed {
        entry: string = _piece(data, ";", i)
        at: number = String.index_of(entry, "=")
        if at > 0 {
            key: string = String.substring(entry, 0, at)
            value: string = String.substring(entry, at + 1, String.length(entry))
            if key == "index" {
                set = _set_restore_int(set, "index", value)
            } else if key == "visible" {
                set = _set_with_field(set, "visible", _boolean_text(value))
            } else if key == "origin" {
                set = _set_restore_pieces(set, "origin", value, 3)
            } else if key == "shapeColour" {
                set = _set_restore_pieces(set, "shapeColour", value, 4)
            } else if key == "originColour" {
                set = _set_restore_pieces(set, "originColour", value, 4)
            } else if key == "shapeCubeSize" {
                set = _set_restore_double(set, "shapeCubeSize", value)
            } else if key == "originCubeSize" {
                set = _set_restore_double(set, "originCubeSize", value)
            } else {
                set = _set_restore_shape(set, key, value)
            }
        }
        i = i + 1
    }
    if not load_failed {
        set = _set_with_field(set, "index", String.from_number(_clamp(_set_int(set, "index", 0), 0, _shape_count() - 1)))
    }
    return set
}

local _set_field_value(set: string, key: string) string {
    fields: string = _set_fields(set)
    count: number = _split_count(fields, ";")
    i: number = 0
    while i < count {
        entry: string = _piece(fields, ";", i)
        at: number = String.index_of(entry, "=")
        if at >= 0 and String.substring(entry, 0, at) == key {
            return String.substring(entry, at + 1, String.length(entry))
        }
        i = i + 1
    }
    return ""
}

# The set with one own field replaced. Every field _set_new writes is present, so a field is replaced
# in place and never appended, which keeps the reference's own order.

local _set_with_field(set: string, key: string, value: string) string {
    fields: string = _set_fields(set)
    shapes: string = _set_shapes(set)
    count: number = _split_count(fields, ";")
    out: string = ""
    i: number = 0
    while i < count {
        entry: string = _piece(fields, ";", i)
        at: number = String.index_of(entry, "=")
        if at >= 0 and String.substring(entry, 0, at) == key {
            out = String.concat(out, String.concat(String.concat(key, "="), String.concat(value, ";")))
        } else {
            out = String.concat(out, String.concat(entry, ";"))
        }
        i = i + 1
    }
    return String.concat(out, String.concat("|", shapes))
}

# A set's own fields and its shapes, split at the internal bar. The bar keeps the two sections apart
# so a field can be replaced without touching the shapes, which are a list grug has no type for.

local _set_fields(set: string) string {
    bar: number = String.index_of(set, "|")
    if bar < 0 {
        return set
    }
    return String.substring(set, 0, bar)
}

local _set_shapes(set: string) string {
    bar: number = String.index_of(set, "|")
    if bar < 0 {
        return ""
    }
    return String.substring(set, bar + 1, String.length(set))
}

local _set_has_origin(set: string) bool {
    return String.length(_set_field_value(set, "origin")) > 0
}

local _set_int(set: string, key: string, fallback: number) number {
    return _int_or(_set_field_value(set, key), fallback)
}

# A set's origin as three whole blocks. A file the load stopped in can hold a non-number, which draws
# at the block the reference would have kept, so a refused piece answers 0.

local _origin_piece(set: string, index: number) number {
    return _int_or(_piece(_set_field_value(set, "origin"), ",", index), 0)
}

local _set_restore_int(set: string, key: string, value: string) string {
    parsed: Option[number] = String.to_integer(value)
    if not parsed.has() {
        load_failed = true
        return set
    }
    return _set_with_field(set, key, String.from_number(parsed.unwrap()))
}

# A field of three or four comma pieces, each an int or a float, applied one at a time: the reference
# assigns the pieces in order, so the ones before a bad one are kept when it throws.

local _set_restore_pieces(set: string, key: string, value: string, required: number) string {
    if _split_count(value, ",") != required {
        return set
    }
    current: string = _set_field_value(set, key)
    i: number = 0
    while i < required {
        piece: string = _piece(value, ",", i)
        canonical: string = ""
        if key == "origin" {
            parsed: Option[number] = String.to_integer(piece)
            if parsed.has() {
                canonical = String.from_number(parsed.unwrap())
            }
        } else {
            parsed_float: Option[number] = String.to_float(piece)
            if parsed_float.has() {
                canonical = String.from_float(parsed_float.unwrap())
            }
        }
        if String.length(canonical) == 0 {
            set = _set_with_field(set, key, current)
            load_failed = true
            return set
        }
        current = _value_replace(current, i, canonical)
        i = i + 1
    }
    return _set_with_field(set, key, current)
}

# A cube size, which Double.parseDouble reads and Double.toString writes.

local _set_restore_double(set: string, key: string, value: string) string {
    parsed: Option[number] = String.to_number(value)
    if not parsed.has() {
        load_failed = true
        return set
    }
    return _set_with_field(set, key, String.from_double(parsed.unwrap()))
}

# A shape the file names: a fresh shape at its defaults, every piece the file holds applied and its
# refusals noted, then stored at the class's own place. An unregistered class name is ignored, and so
# is a repeated one's earlier entry, because the reference assigns a new shape over it.

local _set_restore_shape(set: string, key: string, value: string) string {
    id: number = _shape_id(_shape_key(key))
    if id < 0 {
        return set
    }
    kinds: string = _shape_kinds(id)
    refused: bool = _values_refused(kinds, value)
    values: string = _values_apply(kinds, _shape_defaults(id), value)
    return _set_put_shape(set, id, values, refused)
}

# The set with one shape at the registry place its id names, in the order ShapeSet.toPersistence
# walks its array, and without the earlier entry for the same class.

local _set_put_shape(set: string, id: number, values: string, refused: bool) string {
    shapes: string = _set_shapes(set)
    key: string = _shape_class(id)
    if refused {
        key = String.concat(key, "!")
    }
    entry: string = String.concat(String.concat(key, "="), String.concat(values, ";"))
    out: string = ""
    i: number = 0
    while i < _shape_count() {
        if i == id {
            out = String.concat(out, entry)
        } else {
            existing: string = _shape_entry(shapes, i)
            if String.length(existing) > 0 {
                out = String.concat(out, String.concat(existing, ";"))
            }
        }
        i = i + 1
    }
    return String.concat(_set_fields(set), String.concat("|", out))
}

# Whether the shape of this id is in error. A refused saved value's marker is dropped by a load that
# read the whole file, so this is true only for a shape left in error by a stopped load (#1816) or a
# live generation error. The shape is still there, because the reference keeps it.

local _set_shape_error(set: string, id: number) bool {
    entry: string = _shape_entry(_set_shapes(set), id)
    if String.length(entry) == 0 {
        return false
    }
    return _shape_errored(entry)
}

# The shape's values as the file would write them.

local _set_shape_values(set: string, id: number) string {
    entry: string = _shape_entry(_set_shapes(set), id)
    if String.length(entry) == 0 {
        return ""
    }
    return _shape_values(entry)
}

# The player's position as ShapeHandler.getPlayerPosition answers it, floored to whole blocks.

local _origin_text(x: number, y: number, z: number) string {
    return String.concat(String.concat(String.from_number(Math.floor(x)), ","), String.concat(String.concat(String.from_number(Math.floor(y)), ","), String.from_number(Math.floor(z))))
}

# The entry of one shape id, without its ";" and "" when the set has none.

local _shape_entry(shapes: string, id: number) string {
    count: number = _split_count(shapes, ";")
    i: number = 0
    while i < count {
        entry: string = _piece(shapes, ";", i)
        at: number = String.index_of(entry, "=")
        if at > 0 and _shape_id(_entry_key(entry)) == id {
            return entry
        }
        i = i + 1
    }
    return ""
}

local _shape_values(entry: string) string {
    at: number = String.index_of(entry, "=")
    if at < 0 {
        return ""
    }
    return String.substring(entry, at + 1, String.length(entry))
}

# The class name of a shape entry, before its equals sign and without a "!" error marker.

local _entry_key(entry: string) string {
    at: number = String.index_of(entry, "=")
    if at < 0 {
        return ""
    }
    return _shape_key(String.substring(entry, 0, at))
}

local _shape_errored(entry: string) bool {
    at: number = String.index_of(entry, "=")
    if at < 1 {
        return false
    }
    return String.substring(entry, at - 1, at) == "!"
}

# The class name of a shape entry without the "!" that marks an error.

local _shape_key(key: string) string {
    length: number = String.length(key)
    if length > 0 and String.substring(key, length - 1, length) == "!" {
        return String.substring(key, 0, length - 1)
    }
    return key
}

# ---------------------------------------------------------------- shape properties

# Shape.restorePersistence: the pieces the file holds, up to the class's property count, every one
# applied whether or not an earlier one failed, and the shape in error when any failed. That error is
# cleared by the load's own updateShape() when the whole file was read, so it marks only a stopped
# load's partial state (#1888).

local _values_apply(kinds: string, values: string, raw: string) string {
    pieces: number = _split_count(raw, ",")
    count: number = _split_count(kinds, ";")
    if pieces > count {
        pieces = count
    }
    out: string = values
    i: number = 0
    while i < pieces {
        value: string = _kind_value(_piece(kinds, ";", i), _piece(raw, ",", i))
        if String.length(value) > 0 {
            out = _value_replace(out, i, value)
        }
        i = i + 1
    }
    return out
}

local _values_refused(kinds: string, raw: string) bool {
    pieces: number = _split_count(raw, ",")
    count: number = _split_count(kinds, ";")
    if pieces > count {
        pieces = count
    }
    i: number = 0
    while i < pieces {
        if String.length(_kind_value(_piece(kinds, ";", i), _piece(raw, ",", i))) == 0 {
            return true
        }
        i = i + 1
    }
    return false
}

# One property's canonical text, or "" where the reference's setValueFromString refuses the piece and
# keeps the value it had. The kinds are the property classes in one letter: i an Integer.parseInt,
# I a PositiveInt (above 1), N a NonzeroInt, M a MinimumInt above 3, f a Float.parseFloat, p a
# PositiveFloat (above 0), m a MinimumFloat above 2, l a MinimumFloat above 1, n a NonzeroFloat,
# b a Boolean that must spell true or false, r the set-endpoint button that always prints Runnable,
# and e:NAMES an Enum whose constant name has to match exactly.

local _kind_value(kind: string, raw: string) string {
    if kind == "i" or kind == "I" or kind == "N" or kind == "M" {
        parsed: Option[number] = String.to_integer(raw)
        if not parsed.has() {
            return ""
        }
        value: number = parsed.unwrap()
        if kind == "I" and not (value > 1) {
            return ""
        }
        if kind == "M" and not (value > 3) {
            return ""
        }
        if kind == "N" and value == 0 {
            return ""
        }
        return String.from_number(value)
    }
    if kind == "f" or kind == "p" or kind == "m" or kind == "l" or kind == "n" {
        parsed: Option[number] = String.to_float(raw)
        if not parsed.has() {
            return ""
        }
        value: number = parsed.unwrap()
        if kind == "p" and not (value > 0) {
            return ""
        }
        if kind == "m" and not (value > 2) {
            return ""
        }
        if kind == "l" and not (value > 1) {
            return ""
        }
        if kind == "n" and value == 0 {
            return ""
        }
        return String.from_float(value)
    }
    if kind == "b" {
        if String.equals_ignore_case(raw, "true") {
            return "true"
        }
        if String.equals_ignore_case(raw, "false") {
            return "false"
        }
        return ""
    }
    if kind == "r" {
        return "Runnable"
    }
    if _has_prefix(kind, "e:") {
        names: string = String.substring(kind, 2, String.length(kind))
        count: number = _split_count(names, ",")
        i: number = 0
        while i < count {
            name: string = _piece(names, ",", i)
            if name == raw {
                return name
            }
            i = i + 1
        }
        return ""
    }
    return ""
}

# The values with one piece replaced, which is how a parsed property is put back in its place.

local _value_replace(values: string, at: number, replacement: string) string {
    count: number = _split_count(values, ",")
    out: string = ""
    i: number = 0
    while i < count {
        if i > 0 {
            out = String.concat(out, ",")
        }
        if i == at {
            out = String.concat(out, replacement)
        } else {
            out = String.concat(out, _piece(values, ",", i))
        }
        i = i + 1
    }
    return out
}

# ---------------------------------------------------------------- the registry table

local _shape_count() number {
    return 15
}

local _shape_class(id: number) string {
    return _piece(_shape_row(id), "@", 0)
}

local _shape_kinds(id: number) string {
    return _piece(_shape_row(id), "@", 1)
}

local _shape_defaults(id: number) string {
    return _piece(_shape_row(id), "@", 2)
}

# The registry, in ShapeRegistry's declaration order: the class name ShapeSet.toPersistence writes,
# the property kinds in declaration order, and the default value text of each.
# ShapeRegistry registers ShapeCatenary, ShapeCircle, ShapeCone, ShapeCuboid, ShapeEllipse,
# ShapeEllipsoid, ShapeGrid, ShapeHelix, ShapeLine, ShapeParabola, ShapeParaboloid, ShapePolygon,
# ShapePolygonalPyramid, ShapeSphere and ShapeTorus, in that order, and the state file's shape index
# space is that order. Two defaults a saved file can name are refused by their own class: the grid's
# stepsY of 1 fails a strict "above 1" and the polygon's sides of 3 fails a strict "above 3". The
# reference's load regenerates from the value in place, so the default is kept and the default Grid
# or Polygon draws rather than staying in error (#1888).

local _shape_row(id: number) string {
    if id == 0 {
        return "brentmaas.buildguide.common.shape.ShapeCatenary@i;i;i;r;p;b@3,0,0,Runnable,1.0,false"
    }
    if id == 1 {
        return "brentmaas.buildguide.common.shape.ShapeCircle@e:X,Y,Z;p;N;b@X,3.0,1,false"
    }
    if id == 2 {
        return "brentmaas.buildguide.common.shape.ShapeCone@e:X,Y,Z;p;f;b@X,3.0,3.0,false"
    }
    if id == 3 {
        return "brentmaas.buildguide.common.shape.ShapeCuboid@N;N;N;e:ALL,X,Y,Z,XY,XZ,YZ,NONE;b@3,3,3,ALL,false"
    }
    if id == 4 {
        return "brentmaas.buildguide.common.shape.ShapeEllipse@e:X,Y,Z;p;p;N;b@X,3.0,3.0,1,false"
    }
    if id == 5 {
        return "brentmaas.buildguide.common.shape.ShapeEllipsoid@p;p;p;e:NO,POSITIVE_X,POSITIVE_Y,POSITIVE_Z,NEGATIVE_X,NEGATIVE_Y,NEGATIVE_Z;b@3.0,3.0,3.0,NO,false"
    }
    if id == 6 {
        return "brentmaas.buildguide.common.shape.ShapeGrid@I;I;I;N;N;N@3,1,3,3,3,3"
    }
    if id == 7 {
        return "brentmaas.buildguide.common.shape.ShapeHelix@e:X,Y,Z;m;l;N;p;f;b;b@Y,5.0,3.0,5,360.0,0.0,false,false"
    }
    if id == 8 {
        return "brentmaas.buildguide.common.shape.ShapeLine@i;i;i;r@3,0,0,Runnable"
    }
    if id == 9 {
        return "brentmaas.buildguide.common.shape.ShapeParabola@e:X,Y,Z;e:ROT0,ROT90,ROT180,ROT270;p;p;N;b@X,ROT0,3.0,3.0,1,false"
    }
    if id == 10 {
        return "brentmaas.buildguide.common.shape.ShapeParaboloid@e:X,Y,Z;p;p;N;b@X,3.0,3.0,3,false"
    }
    if id == 11 {
        return "brentmaas.buildguide.common.shape.ShapePolygon@M;p;e:X,Y,Z;e:ROT0,ROT90,ROT180,ROT270;N;b@3,3.0,X,ROT0,1,false"
    }
    if id == 12 {
        return "brentmaas.buildguide.common.shape.ShapePolygonalPyramid@M;p;e:X,Y,Z;e:ROT0,ROT90,ROT180,ROT270;n;b@4,3.0,Y,ROT0,4.0,false"
    }
    if id == 13 {
        return "brentmaas.buildguide.common.shape.ShapeSphere@p;e:NO,POSITIVE_X,POSITIVE_Y,POSITIVE_Z,NEGATIVE_X,NEGATIVE_Y,NEGATIVE_Z;b@3.0,NO,false"
    }
    if id == 14 {
        return "brentmaas.buildguide.common.shape.ShapeTorus@e:X,Y,Z;p;p;b;b@X,5.0,3.0,false,false"
    }
    return _shape_row(0)
}

# ShapeRegistry.getShapeId: the id of a class name, or -1 when the registry does not hold it.

local _shape_id(key: string) number {
    i: number = 0
    while i < _shape_count() {
        if _shape_class(i) == key {
            return i
        }
        i = i + 1
    }
    return -1
}

# ---------------------------------------------------------------- text

# Boolean.parseBoolean: true only for every case of the word true.

local _boolean_text(text: string) string {
    if String.equals_ignore_case(text, "true") {
        return "true"
    }
    return "false"
}

local _clamp(value: number, low: number, high: number) number {
    if value < low {
        return low
    }
    if value > high {
        return high
    }
    return value
}

# A whole number the text holds, or the fallback, which is Integer.parseInt behind a has() probe.

local _int_or(text: string, fallback: number) number {
    parsed: Option[number] = String.to_integer(text)
    if parsed.has() {
        return parsed.unwrap()
    }
    return fallback
}

local _line(text: string) string {
    return String.concat(text, _newline())
}

# The line at this index, without a carriage return, as Scanner.nextLine would read a CRLF file.

local _line_at(text: string, index: number) string {
    line: string = _piece(text, _newline(), index)
    length: number = String.length(line)
    if length > 0 and String.substring(line, length - 1, length) == String.from_character(13) {
        return String.substring(line, 0, length - 1)
    }
    return line
}

local _replace_all(text: string, needle: string, replacement: string) string {
    out: string = ""
    start: number = 0
    length: number = String.length(text)
    width: number = String.length(needle)
    done: bool = false
    while not done {
        at: number = _index_from(text, needle, start)
        if at < 0 {
            out = String.concat(out, String.substring(text, start, length))
            done = true
        } else {
            out = String.concat(out, String.substring(text, start, at))
            out = String.concat(out, replacement)
            start = at + width
        }
    }
    return out
}

# Java's String.split(separator) with a limit of 0: how many pieces it answers, with the trailing
# empty ones dropped. An empty text is one empty piece; a text of only separators is none.

local _split_count(text: string, separator: string) number {
    if String.length(text) == 0 {
        return 1
    }
    length: number = String.length(text)
    width: number = String.length(separator)
    count: number = 0
    last: number = -1
    start: number = 0
    while start <= length {
        at: number = _index_from(text, separator, start)
        if at < 0 {
            if length - start > 0 {
                last = count
            }
            return last + 1
        }
        if at > start {
            last = count
        }
        count = count + 1
        start = at + width
    }
    return last + 1
}

# The piece at this index, which has to be below _split_count.

local _piece(text: string, separator: string, index: number) string {
    length: number = String.length(text)
    width: number = String.length(separator)
    start: number = 0
    i: number = 0
    while i < index {
        found: number = _index_from(text, separator, start)
        if found < 0 {
            return ""
        }
        start = found + width
        i = i + 1
    }
    found: number = _index_from(text, separator, start)
    if found < 0 {
        return String.substring(text, start, length)
    }
    return String.substring(text, start, found)
}

# A line feed, built rather than written as an escape: grug-tests does not accept a newline escape in
# a string, and every text above is a file's own lines.

local _newline() string {
    return String.from_character(10)
}

local _has_prefix(text: string, prefix: string) bool {
    if String.length(prefix) > String.length(text) {
        return false
    }
    return String.substring(text, 0, String.length(prefix)) == prefix
}

# String.indexOf from an offset, for the scans above: -1 when the needle is not there at or after it.

local _index_from(text: string, needle: string, from: number) number {
    length: number = String.length(text)
    if from > length {
        return -1
    }
    at: number = String.index_of(String.substring(text, from, length), needle)
    if at < 0 {
        return -1
    }
    return from + at
}

# ---------------------------------------------------------------- the three keys

# The presses a binding counted, applied where the reference's own input handler runs. A toggle
# press runs initCheck and then flips enabled once, so an even count leaves the flag as it was; a
# set-origin press puts the current set's origin on the player's feet; a set-global-origin press
# moves every set by the player's movement since the current set's origin.
# A press that repeats while its key is held is the reference's own `isDown` poll, which repeats
# every client tick; a binding handler fires once per press, so a held key toggles once here. The
# reference's three keys are unbound by default and this port declares them unbound too, so the
# player binds them in Controls (#1752).

local _apply_pending(x: number, y: number, z: number) {
    if pending_toggle > 0 {
        flips: number = pending_toggle
        pending_toggle = 0
        # ShapeSet.updateAllShapes runs after pushNewShapeSet, but a set is generated inside the
        # frame here, so the first draw already sees the new set's shapes.
        _state_check(x, y, z)
        flip: bool = false
        while flips > 0 {
            flip = not flip
            flips = flips - 1
        }
        if flip and _state_enabled() {
            state = _state_with_field(state, "enabled", "false")
        } else if flip {
            state = _state_with_field(state, "enabled", "true")
        }
    }
    if pending_origin > 0 {
        pending_origin = 0
        if _state_set_count() > 0 {
            set: string = _state_current_set()
            set = _set_with_field(set, "origin", _origin_text(x, y, z))
            index: number = _clamp(_int_or(_state_field(state, "iShapeSet", ""), 0), 0, _state_set_count() - 1)
            state = _state_with_set(state, index, set)
        }
    }
    if pending_global_origin > 0 {
        pending_global_origin = 0
        if _state_set_count() > 0 {
            set: string = _state_current_set()
            dx: number = Math.floor(x) - _origin_piece(set, 0)
            dy: number = Math.floor(y) - _origin_piece(set, 1)
            dz: number = Math.floor(z) - _origin_piece(set, 2)
            state = _state_shift_origins(state, dx, dy, dz)
        }
    }
}

# State.initCheck: one set when there is none, and an origin for a set that has none. The reference
# runs it once per State, from the toggle key and from a screen's own init. A new set goes through
# pushNewShapeSet, which starts at
# iShapeNew, takes its origin from the player and gets random colours when the config asks for them;
# the reference's own `new Random()` is the stream here too, so a draw moves no sequence the world's
# own behaviour depends on. The text form always carries an origin, as the reference's loaded
# ShapeSet does, so the second rule is the same safety net here that it is there.

local _state_check(x: number, y: number, z: number) {
    if state_initialised {
        return
    }
    if _state_set_count() == 0 {
        _state_push_set(x, y, z)
    }
    count: number = _state_set_count()
    i: number = 0
    while i < count {
        set: string = _state_set_at(state, i)
        if not _set_has_origin(set) {
            state = _state_with_set(state, i, _set_with_field(set, "origin", _origin_text(x, y, z)))
        }
        i = i + 1
    }
    state_initialised = true
}

# State.pushNewShapeSet: the shape iShapeNew names, the player's feet as its origin, and the random
# colours the config asks for.

local _state_push_set(x: number, y: number, z: number) {
    index: number = _clamp(_int_or(_state_field(state, "iShapeNew", "1"), 1), 0, _shape_count() - 1)
    set: string = _set_new(index, x, y, z)
    if _config_random(config_values) {
        random: Random = Random.new()
        set = _set_with_field(set, "shapeColour", _random_colour(random, "0.5"))
        set = _set_with_field(set, "originColour", _random_colour(random, "0.5"))
    }
    state = _state_append_set(state, set)
}

# The state text with one shapeSet line added after the set lines it has, which is where the
# reference's list puts it.

local _state_append_set(text: string, set: string) string {
    out: string = ""
    inserted: bool = false
    lines: number = _split_count(text, _newline())
    i: number = 0
    while i < lines {
        line: string = _line_at(text, i)
        if not inserted and _has_prefix(line, "iShapeSet=") {
            out = String.concat(out, _line(String.concat("shapeSet=", set)))
            inserted = true
        }
        out = String.concat(out, _line(line))
        i = i + 1
    }
    return out
}

# The random-colour switch, which the second value holds.

local _config_random(values: string) bool {
    return _piece(values, ",", 1) == "true"
}

# A new set's colour from the stream the set was made with, three draws and the alpha the set already
# has, in the text Float.toString gives a float, which is String.from_float.

local _random_colour(random: Random, alpha: string) string {
    return String.concat(String.concat(String.from_float(random.next_float()), ","), String.concat(String.concat(String.from_float(random.next_float()), ","), String.concat(String.from_float(random.next_float()), String.concat(",", alpha))))
}

local _state_with_field(text: string, key: string, value: string) string {
    prefix: string = String.concat(key, "=")
    replacement: string = String.concat(String.concat(key, "="), value)
    out: string = ""
    lines: number = _split_count(text, _newline())
    i: number = 0
    while i < lines {
        line: string = _line_at(text, i)
        if _has_prefix(line, prefix) {
            out = String.concat(out, _line(replacement))
        } else {
            out = String.concat(out, _line(line))
        }
        i = i + 1
    }
    return out
}

local _state_with_set(text: string, wanted: number, set: string) string {
    out: string = ""
    found: number = 0
    lines: number = _split_count(text, _newline())
    i: number = 0
    while i < lines {
        line: string = _line_at(text, i)
        if _has_prefix(line, "shapeSet=") {
            if found == wanted {
                out = String.concat(out, _line(String.concat("shapeSet=", set)))
            } else {
                out = String.concat(out, _line(line))
            }
            found = found + 1
        } else {
            out = String.concat(out, _line(line))
        }
        i = i + 1
    }
    return out
}

local _state_shift_origins(text: string, dx: number, dy: number, dz: number) string {
    out: string = ""
    lines: number = _split_count(text, _newline())
    i: number = 0
    while i < lines {
        line: string = _line_at(text, i)
        if _has_prefix(line, "shapeSet=") {
            set: string = String.substring(line, 9, String.length(line))
            shifted: string = String.concat(String.from_number(_origin_piece(set, 0) + dx), String.concat(String.concat(",", String.from_number(_origin_piece(set, 1) + dy)), String.concat(",", String.from_number(_origin_piece(set, 2) + dz))))
            out = String.concat(out, _line(String.concat("shapeSet=", _set_with_field(set, "origin", shifted))))
        } else {
            out = String.concat(out, _line(line))
        }
        i = i + 1
    }
    return out
}

# ---------------------------------------------------------------- the screen helpers
# A local function is defined after the first call to it, so this section runs outwards from the
# exports above. The properties and lists of the other tabs join it as they are ported.

# ConfigurationScreen's six widgets: a checkbox writes its config value and the file at once, which
# is Config.write, and a Default button puts its option back to the default and writes again, which
# is the reference's setChecked (whose change fires the checkbox's own handler) plus write. A box
# this port ticks is silent, so the value and the file are written here by hand.

local _configuration_changed(widget: Widget) {
    if _chrome_changed(widget) {
        return
    }
    async_box: Widget = c_async.unwrap()
    if equals(widget, async_box) {
        config_values = _config_with(config_values, 0, _bool_text(widget.checked()))
        _config_write()
        return
    }
    async_default: Widget = c_async_default.unwrap()
    if equals(widget, async_default) {
        _config_set_default(0, async_box)
        return
    }
    random_box: Widget = c_random.unwrap()
    if equals(widget, random_box) {
        config_values = _config_with(config_values, 1, _bool_text(widget.checked()))
        _config_write()
        return
    }
    random_default: Widget = c_random_default.unwrap()
    if equals(widget, random_default) {
        _config_set_default(1, random_box)
        return
    }
    persistence_box: Widget = c_persistence.unwrap()
    if equals(widget, persistence_box) {
        config_values = _config_with(config_values, 2, _bool_text(widget.checked()))
        _config_write()
        return
    }
    persistence_default: Widget = c_persistence_default.unwrap()
    if equals(widget, persistence_default) {
        _config_set_default(2, persistence_box)
    }
}

# BaseScreen's six shared widgets, in the reference's own add order. The enable checkbox writes the
# state's enabled flag, which setEnabled marks for persistence, and a tab press opens that tab's
# screen, which closes this one first.

local _chrome_changed(widget: Widget) bool {
    enabled: Widget = w_enabled.unwrap()
    if equals(widget, enabled) {
        state = _state_with_field(state, "enabled", _bool_text(widget.checked()))
        return true
    }
    close_button: Widget = w_close.unwrap()
    if equals(widget, close_button) {
        _close_active()
        return true
    }
    tab_shape: Widget = w_tab_shape.unwrap()
    if equals(widget, tab_shape) {
        _open_tab("shape")
        return true
    }
    tab_visualisation: Widget = w_tab_visualisation.unwrap()
    if equals(widget, tab_visualisation) {
        _open_tab("visualisation")
        return true
    }
    tab_shapelist: Widget = w_tab_shapelist.unwrap()
    if equals(widget, tab_shapelist) {
        _open_tab("shapelist")
        return true
    }
    tab_configuration: Widget = w_tab_configuration.unwrap()
    if equals(widget, tab_configuration) {
        _open_tab("configuration")
        return true
    }
    return false
}

# BaseScreen.onScreenClosed, reached by the close button, Escape, and a tab press that opens a screen
# over this one. The Shape and Shape list dropdowns are part of their own screen, so closing one
# closes the screen and not a tab.

local _close_active() {
    if active_screen == "visualisation" {
        active_screen = ""
        visualisation_screen.close()
        return
    }
    if active_screen == "shapelist" {
        active_screen = ""
        shapelist_screen.close()
        return
    }
    if active_screen == "configuration" {
        active_screen = ""
        configuration_screen.close()
        return
    }
    active_screen = ""
    shape_screen.close()
}

# State.createNewScreen and AbstractScreenHandler.showScreen: the tab becomes the current one and its
# screen opens. Opening over the open screen asks that one to close first, whose save is the tab
# switch's save. A tab the state has no set for still opens; its widgets are the chrome's alone.

local _open_tab(name: string) {
    tab_screen = name
    switching_tab = true
    active_screen = name
    dropdown_open = false
    if name == "visualisation" {
        visualisation_screen.open()
        switching_tab = false
        return
    }
    if name == "shapelist" {
        shapelist_screen.open()
        switching_tab = false
        return
    }
    if name == "configuration" {
        configuration_screen.open()
        switching_tab = false
        return
    }
    shape_screen.open()
    switching_tab = false
}

# ConfigurationScreen.init after super.init: the three checkboxes at x 255 and their 50-wide Default
# buttons at x 280, on y 60, 110 and 160, in Config's own order. The reference declares two more
# widgets for the debug timings setting, under a misspelled field it never assigns; addWidget ignores
# the null, so no widget exists for it here either.

local _configuration_init(width: number) {
    _chrome_init(configuration_screen, width, "configuration", _state_enabled())
    async_box: Widget = configuration_screen.add_checkbox("async", "", _config_on(config_values, 0), 255, 60, 20, 20)
    c_async.set(async_box)
    async_default: Widget = configuration_screen.add_button("async_default", "Default", 280, 60, 50, 20)
    c_async_default.set(async_default)
    random_box: Widget = configuration_screen.add_checkbox("random", "", _config_on(config_values, 1), 255, 110, 20, 20)
    c_random.set(random_box)
    random_default: Widget = configuration_screen.add_button("random_default", "Default", 280, 110, 50, 20)
    c_random_default.set(random_default)
    persistence_box: Widget = configuration_screen.add_checkbox("persistence", "", _config_on(config_values, 2), 255, 160, 20, 20)
    c_persistence.set(persistence_box)
    persistence_default: Widget = configuration_screen.add_button("persistence_default", "Default", 280, 160, 50, 20)
    c_persistence_default.set(persistence_default)
}

# BaseScreen.init: the enable checkbox at (5, 5), the close button at (width - 25, 5) labelled X, and
# the four tabs at y 30, each 120 wide from x 5, 130, 255 and 380. The screen's own tab is inactive,
# which is the reference's `currentScreen != ActiveScreen.X` argument. The checkbox keeps the game's
# own size whatever it is asked for.

local _chrome_init(screen: Screen, width: number, current: string, enabled: bool) {
    box: Widget = screen.add_checkbox("enabled", "", enabled, 5, 5, 20, 20)
    w_enabled.set(box)
    close_button: Widget = screen.add_button("close", "X", width - 25, 5, 20, 20)
    w_close.set(close_button)
    tab_shape: Widget = screen.add_button("tab_shape", "Shape", 5, 30, 120, 20)
    tab_shape.set_active(current != "shape")
    w_tab_shape.set(tab_shape)
    tab_visualisation: Widget = screen.add_button("tab_visualisation", "Visualization", 130, 30, 120, 20)
    tab_visualisation.set_active(current != "visualisation")
    w_tab_visualisation.set(tab_visualisation)
    tab_shapelist: Widget = screen.add_button("tab_shapelist", "Shape list", 255, 30, 120, 20)
    tab_shapelist.set_active(current != "shapelist")
    w_tab_shapelist.set(tab_shapelist)
    tab_configuration: Widget = screen.add_button("tab_configuration", "Configuration", 380, 30, 120, 20)
    tab_configuration.set_active(current != "configuration")
    w_tab_configuration.set(tab_configuration)
}

# ConfigurationScreen.render after super.render: each option's title underlined at x 10 and its
# comment below it, at the reference's own rows (65/84, 115/135, 165/185).

local _configuration_render(ctx: OverlayRenderContext, width: number) {
    _chrome_render(ctx, width)
    white: Color = Color.rgb(255, 255, 255)
    ctx.draw_text("§nAsynchronous shape generation", 10, 65, white)
    ctx.draw_text("Enable asynchronous (multithreaded) shape generation.", 10, 84, white)
    ctx.draw_text("§nShape list random colors", 10, 115, white)
    ctx.draw_text("Enable random colors for new shapes added to the shape list by default.", 10, 135, white)
    ctx.draw_text("§nShape persistence", 10, 165, white)
    ctx.draw_text("Allow shapes to be saved to a file so they can be restored after restarting the client.", 10, 185, white)
}

# BaseScreen.render's six texts: the title centred at the window's middle, Enable at x 30, and the two
# block headers and their counts centred left and right of the title. The reference computes each
# centre with Java's integer division, so every half is floored before it is subtracted.

local _chrome_render(ctx: OverlayRenderContext, width: number) {
    white: Color = Color.rgb(255, 255, 255)
    mid: number = Math.floor(width / 2)
    title: string = "Build Guide"
    title_width: number = ctx.text_width(title)
    ctx.draw_text(title, mid - Math.floor(title_width / 2), 10, white)
    ctx.draw_text("Enable", 30, 10, white)
    shape_title: string = "Number of blocks (shape)"
    total_title: string = "Number of blocks (total)"
    shape_width: number = ctx.text_width(shape_title)
    total_width: number = ctx.text_width(total_title)
    titles: number = shape_width
    if total_width > titles {
        titles = total_width
    }
    left: number = mid - Math.floor(title_width / 2) - Math.floor(titles / 2) - 20
    right: number = mid + Math.floor(title_width / 2) + Math.floor(titles / 2) + 20
    shape_count: string = _count_text(block_shape)
    total_count: string = _count_text(block_total)
    ctx.draw_text(shape_title, left - Math.floor(shape_width / 2), 5, white)
    ctx.draw_text(shape_count, left - Math.floor(ctx.text_width(shape_count) / 2), 20, white)
    ctx.draw_text(total_title, right - Math.floor(total_width / 2), 5, white)
    ctx.draw_text(total_count, right - Math.floor(ctx.text_width(total_count) / 2), 20, white)
}
# VisualisationScreen's nineteen widgets. A slider only moves its own handle and label, which is the
# reference's empty applyValue; every colour and cube size changes when a Set button reads the
# sliders, and the depth-test checkbox writes its state flag at once. With no set, the eight colour
# sliders and the six colour buttons are inactive, but the two cube sliders and their two buttons
# stay usable although their callbacks do nothing, which is the reference's own disable block.

local _visualisation_changed(widget: Widget) {
    if _chrome_changed(widget) {
        return
    }
    depth: Widget = v_depth.unwrap()
    if equals(widget, depth) {
        state = _state_with_field(state, "depthTest", _bool_text(widget.checked()))
        return
    }
    set_shape: Widget = v_set_shape.unwrap()
    if equals(widget, set_shape) {
        _visual_set_shape_colour()
        return
    }
    random_shape: Widget = v_random_shape.unwrap()
    if equals(widget, random_shape) {
        _visual_random_shape()
        return
    }
    default_shape: Widget = v_default_shape.unwrap()
    if equals(widget, default_shape) {
        _visual_default_shape()
        return
    }
    set_origin: Widget = v_set_origin.unwrap()
    if equals(widget, set_origin) {
        _visual_set_origin_colour()
        return
    }
    random_origin: Widget = v_random_origin.unwrap()
    if equals(widget, random_origin) {
        _visual_random_origin()
        return
    }
    default_origin: Widget = v_default_origin.unwrap()
    if equals(widget, default_origin) {
        _visual_default_origin()
        return
    }
    set_cube: Widget = v_set_cube.unwrap()
    if equals(widget, set_cube) {
        _visual_set_cube_size()
        return
    }
    default_cube: Widget = v_default_cube.unwrap()
    if equals(widget, default_cube) {
        _visual_default_cube_size()
        return
    }
    _visual_slider_text(widget)
}

# VisualisationScreen.init after super.init, in the reference's add order: the shape colour sliders and
# buttons at x 5, the origin ones at x 140, the depth-test checkbox under them, and the cube size
# sliders and buttons at x 140 from y 235. Each slider's initial value is the current set's, capped
# the way getShapeCubeSize caps it, or the ShapeSet default when there is no set. The disable block
# runs before the widgets are added in the reference, and after here, which is the same state.

local _visualisation_init(width: number) {
    _chrome_init(visualisation_screen, width, "visualisation", _state_enabled())
    available: bool = _state_set_count() > 0
    shape_r: number = _visual_channel("shapeColour", 0, 1.0)
    shape_g: number = _visual_channel("shapeColour", 1, 1.0)
    shape_b: number = _visual_channel("shapeColour", 2, 1.0)
    shape_a: number = _visual_channel("shapeColour", 3, 0.5)
    origin_r: number = _visual_channel("originColour", 0, 1.0)
    origin_g: number = _visual_channel("originColour", 1, 0.0)
    origin_b: number = _visual_channel("originColour", 2, 0.0)
    origin_a: number = _visual_channel("originColour", 3, 0.5)
    shape_cube: number = _visual_cube("shapeCubeSize", 0.6)
    origin_cube: number = _visual_cube("originCubeSize", 0.2)
    s1: Widget = visualisation_screen.add_slider("shape_r", _visual_label("R", shape_r), 0.0, 1.0, shape_r, 5, 70, 120, 20)
    v_shape_r.set(s1)
    s2: Widget = visualisation_screen.add_slider("shape_g", _visual_label("G", shape_g), 0.0, 1.0, shape_g, 5, 90, 120, 20)
    v_shape_g.set(s2)
    s3: Widget = visualisation_screen.add_slider("shape_b", _visual_label("B", shape_b), 0.0, 1.0, shape_b, 5, 110, 120, 20)
    v_shape_b.set(s3)
    s4: Widget = visualisation_screen.add_slider("shape_a", _visual_label("A", shape_a), 0.0, 1.0, shape_a, 5, 130, 120, 20)
    v_shape_a.set(s4)
    b1: Widget = visualisation_screen.add_button("set_shape", "Set", 5, 150, 120, 20)
    v_set_shape.set(b1)
    b2: Widget = visualisation_screen.add_button("set_shape_random", "Set random", 5, 170, 120, 20)
    v_random_shape.set(b2)
    b3: Widget = visualisation_screen.add_button("default_shape", "Default", 5, 190, 120, 20)
    v_default_shape.set(b3)
    s5: Widget = visualisation_screen.add_slider("origin_r", _visual_label("R", origin_r), 0.0, 1.0, origin_r, 140, 70, 120, 20)
    v_origin_r.set(s5)
    s6: Widget = visualisation_screen.add_slider("origin_g", _visual_label("G", origin_g), 0.0, 1.0, origin_g, 140, 90, 120, 20)
    v_origin_g.set(s6)
    s7: Widget = visualisation_screen.add_slider("origin_b", _visual_label("B", origin_b), 0.0, 1.0, origin_b, 140, 110, 120, 20)
    v_origin_b.set(s7)
    s8: Widget = visualisation_screen.add_slider("origin_a", _visual_label("A", origin_a), 0.0, 1.0, origin_a, 140, 130, 120, 20)
    v_origin_a.set(s8)
    b4: Widget = visualisation_screen.add_button("set_origin", "Set", 140, 150, 120, 20)
    v_set_origin.set(b4)
    b5: Widget = visualisation_screen.add_button("set_origin_random", "Set random", 140, 170, 120, 20)
    v_random_origin.set(b5)
    b6: Widget = visualisation_screen.add_button("default_origin", "Default", 140, 190, 120, 20)
    v_default_origin.set(b6)
    depth: Widget = visualisation_screen.add_checkbox("depth_test", "", _visual_depth(), 5, 235, 20, 20)
    v_depth.set(depth)
    s9: Widget = visualisation_screen.add_slider("shape_cube", _visual_label("Shape", shape_cube), 0.0, 1.0, shape_cube, 140, 235, 120, 20)
    v_shape_cube.set(s9)
    s10: Widget = visualisation_screen.add_slider("origin_cube", _visual_label("Origin", origin_cube), 0.0, 1.0, origin_cube, 140, 255, 120, 20)
    v_origin_cube.set(s10)
    b7: Widget = visualisation_screen.add_button("set_cube", "Set", 140, 275, 120, 20)
    v_set_cube.set(b7)
    b8: Widget = visualisation_screen.add_button("default_cube", "Default", 140, 295, 120, 20)
    v_default_cube.set(b8)
    if not available {
        s1.set_active(false)
        s2.set_active(false)
        s3.set_active(false)
        s4.set_active(false)
        s5.set_active(false)
        s6.set_active(false)
        s7.set_active(false)
        s8.set_active(false)
        b1.set_active(false)
        b2.set_active(false)
        b3.set_active(false)
        b4.set_active(false)
        b5.set_active(false)
        b6.set_active(false)
    }
}

# VisualisationScreen.render after super.render: two underlined headings over the colour columns, the
# Rendering heading over the depth-test box, the box's label to its right, and the Cube size heading.

local _visualisation_render(ctx: OverlayRenderContext, width: number) {
    _chrome_render(ctx, width)
    white: Color = Color.rgb(255, 255, 255)
    _draw_centred(ctx, "§nShape color", 65, 55, white)
    _draw_centred(ctx, "§nOrigin color", 200, 55, white)
    _draw_centred(ctx, "§nRendering", 65, 220, white)
    ctx.draw_text("Depth test", 30, 240, white)
    _draw_centred(ctx, "§nCube size", 200, 220, white)
}

# A slider's label follows its handle: the reference's updateMessage is `name + ": " + round(10v)/10`,
# which a drag reaches through widget_changed. Every slider's own name is remembered here because the
# host keeps the text, not the format.

local _visual_slider_text(widget: Widget) {
    if equals(widget, v_shape_r.unwrap()) {
        _visual_put_slider(widget, "R", widget.value())
    } else if equals(widget, v_shape_g.unwrap()) {
        _visual_put_slider(widget, "G", widget.value())
    } else if equals(widget, v_shape_b.unwrap()) {
        _visual_put_slider(widget, "B", widget.value())
    } else if equals(widget, v_shape_a.unwrap()) {
        _visual_put_slider(widget, "A", widget.value())
    } else if equals(widget, v_origin_r.unwrap()) {
        _visual_put_slider(widget, "R", widget.value())
    } else if equals(widget, v_origin_g.unwrap()) {
        _visual_put_slider(widget, "G", widget.value())
    } else if equals(widget, v_origin_b.unwrap()) {
        _visual_put_slider(widget, "B", widget.value())
    } else if equals(widget, v_origin_a.unwrap()) {
        _visual_put_slider(widget, "A", widget.value())
    } else if equals(widget, v_shape_cube.unwrap()) {
        _visual_put_slider(widget, "Shape", widget.value())
    } else {
        _visual_put_slider(widget, "Origin", widget.value())
    }
}

# ShapeSet.setShapeColour on the current set, and the other three setters the same way. A set the
# state does not have is what isShapeAvailable refuses, so nothing is written then.

local _visual_set_shape_colour() {
    if _state_set_count() == 0 {
        return
    }
    _visual_write("shapeColour", _visual_colour_text(v_shape_r.unwrap().value(), v_shape_g.unwrap().value(), v_shape_b.unwrap().value(), v_shape_a.unwrap().value()))
}

# setShapeColour with three fresh draws and the slider's own alpha. The reference makes a new Random
# for the press and sets each slider to random.nextDouble(), so the port draws the same double; a
# grug number is a double, and the color is not narrowed to a float the way the reference's cast is.

local _visual_random_shape() {
    if _state_set_count() == 0 {
        return
    }
    random: Random = Random.new()
    r: number = random.next_double()
    g: number = random.next_double()
    b: number = random.next_double()
    _visual_put_slider(v_shape_r.unwrap(), "R", r)
    _visual_put_slider(v_shape_g.unwrap(), "G", g)
    _visual_put_slider(v_shape_b.unwrap(), "B", b)
    _visual_write("shapeColour", _visual_colour_text(r, g, b, v_shape_a.unwrap().value()))
}

# The Default button moves the four sliders whether or not a set is there, and writes the colour only
# when one is, which is the reference's guard after the sliders.

local _visual_default_shape() {
    _visual_put_slider(v_shape_r.unwrap(), "R", 1.0)
    _visual_put_slider(v_shape_g.unwrap(), "G", 1.0)
    _visual_put_slider(v_shape_b.unwrap(), "B", 1.0)
    _visual_put_slider(v_shape_a.unwrap(), "A", 0.5)
    if _state_set_count() == 0 {
        return
    }
    _visual_write("shapeColour", "1.0,1.0,1.0,0.5")
}

local _visual_set_origin_colour() {
    if _state_set_count() == 0 {
        return
    }
    _visual_write("originColour", _visual_colour_text(v_origin_r.unwrap().value(), v_origin_g.unwrap().value(), v_origin_b.unwrap().value(), v_origin_a.unwrap().value()))
}

local _visual_random_origin() {
    if _state_set_count() == 0 {
        return
    }
    random: Random = Random.new()
    r: number = random.next_double()
    g: number = random.next_double()
    b: number = random.next_double()
    _visual_put_slider(v_origin_r.unwrap(), "R", r)
    _visual_put_slider(v_origin_g.unwrap(), "G", g)
    _visual_put_slider(v_origin_b.unwrap(), "B", b)
    _visual_write("originColour", _visual_colour_text(r, g, b, v_origin_a.unwrap().value()))
}

local _visual_default_origin() {
    _visual_put_slider(v_origin_r.unwrap(), "R", 1.0)
    _visual_put_slider(v_origin_g.unwrap(), "G", 0.0)
    _visual_put_slider(v_origin_b.unwrap(), "B", 0.0)
    _visual_put_slider(v_origin_a.unwrap(), "A", 0.5)
    if _state_set_count() == 0 {
        return
    }
    _visual_write("originColour", "1.0,0.0,0.0,0.5")
}

# setCubeSize writes both sizes at once, from the two sliders, with no cap: the cap is getCubeSize's,
# and an uncapped 1.0 still draws at the capped size.

local _visual_set_cube_size() {
    if _state_set_count() == 0 {
        return
    }
    _visual_write("shapeCubeSize", String.from_double(v_shape_cube.unwrap().value()))
    _visual_write("originCubeSize", String.from_double(v_origin_cube.unwrap().value()))
}

local _visual_default_cube_size() {
    _visual_put_slider(v_shape_cube.unwrap(), "Shape", 0.6)
    _visual_put_slider(v_origin_cube.unwrap(), "Origin", 0.2)
    if _state_set_count() == 0 {
        return
    }
    _visual_write("shapeCubeSize", "0.6")
    _visual_write("originCubeSize", "0.2")
}

# One field of the current set, replaced in the state. The setters above all end here, so a set the
# state does not have is the only case left out.

local _visual_write(key: string, value: string) {
    count: number = _state_set_count()
    if count == 0 {
        return
    }
    index: number = _clamp(_int_or(_state_field(state, "iShapeSet", ""), 0), 0, count - 1)
    set: string = _state_set_at(state, index)
    set = _set_with_field(set, key, value)
    state = _state_with_set(state, index, set)
}

# Four slider values as ShapeSet stores them: each narrowed to a float, then Float.toString.

local _visual_colour_text(r: number, g: number, b: number, a: number) string {
    return String.concat(String.concat(String.from_float(r), ","), String.concat(String.concat(String.from_float(g), ","), String.concat(String.concat(String.from_float(b), ","), String.from_float(a))))
}

# A slider's handle and label together, which is what the reference's setSliderValue plus updateText
# do in that order.

local _visual_put_slider(slider: Widget, name: string, value: number) {
    slider.set_value(value)
    slider.set_text(_visual_label(name, value))
}

# `name + ": " + Math.round(10.0 * value) / 10.0`, the message SliderImpl builds. Math.round of NaN
# is 0, and of an infinity is the long's end, which is why the scaled value is clamped there.

local _visual_label(name: string, value: number) string {
    return String.concat(String.concat(name, ": "), _tenth(value))
}

local _tenth(value: number) string {
    scaled: number = 0.0
    if value == value {
        scaled = Math.floor(value * 10.0 + 0.5)
        if scaled > 9223372036854775807.0 {
            scaled = 9223372036854775807.0
        } else if scaled < -9223372036854775808.0 {
            scaled = -9223372036854775808.0
        }
    }
    return String.from_double(scaled / 10.0)
}

# One channel of the current set's colour, or the ShapeSet default when the state has no set. The
# sliders ask this on every init, so a reopened screen shows the set's colours again.

local _visual_channel(key: string, index: number, fallback: number) number {
    if _state_set_count() == 0 {
        return fallback
    }
    return _value_float(_set_field_value(_state_current_set(), key), index)
}

# A cube-size slider's initial value, capped the way ShapeSet.getShapeCubeSize caps it.

local _visual_cube(key: string, fallback: number) number {
    if _state_set_count() == 0 {
        return fallback
    }
    return _cube_size(_state_current_set(), key, fallback)
}

local _visual_depth() bool {
    return _state_field(state, "depthTest", "true") == "true"
}

# drawShadowCentred: the text's top-left is half its width left of the centre, floored as Java's
# integer division floors it.

local _draw_centred(ctx: OverlayRenderContext, text: string, x: number, y: number, colour: Color) {
    ctx.draw_text(text, x - Math.floor(ctx.text_width(text) / 2), y, colour)
}
# The count as the reference prints it: the number, then how many whole stacks of 64 it is and what
# is left over, which is Java's `n + " (" + (n / 64) + " x 64 + " + (n % 64) + ")"` for an int.

local _count_text(n: number) string {
    stacks: number = Math.floor(n / 64)
    rest: number = n - stacks * 64
    return String.concat(String.from_number(n), String.concat(" (", String.concat(String.from_number(stacks), String.concat(" x 64 + ", String.concat(String.from_number(rest), ")")))))
}

# The config text with one of its three values replaced, in "async,random,persistence" order.

local _config_with(values: string, index: number, value: string) string {
    first: string = _piece(values, ",", 0)
    second: string = _piece(values, ",", 1)
    third: string = _piece(values, ",", 2)
    if index == 0 {
        return String.concat(String.concat(value, ","), String.concat(second, String.concat(",", third)))
    }
    if index == 1 {
        return String.concat(String.concat(first, ","), String.concat(value, String.concat(",", third)))
    }
    return String.concat(String.concat(first, ","), String.concat(second, String.concat(",", value)))
}

# One of the three checkboxes' tick, from the config text.

local _config_on(values: string, index: number) bool {
    return _piece(values, ",", index) == "true"
}

# A bool as the persistence and config text writes it.

local _bool_text(value: bool) string {
    if value {
        return "true"
    }
    return "false"
}

# Config.write: the whole file, comments and values, at the path Config's constructor reads. A refused
# write is the host's error here, which prints it as Config.write's catch does, and the values were
# set before it.

local _config_write() {
    files: File = File.open(r"files")
    files.write_text("config/buildguide.cfg", _config_text(config_values))
}

# A Default button's value: Config declares asynchronous generation on and the other two off, and
# getDefault answers the value the option was constructed with.

local _config_set_default(index: number, box: Widget) {
    value: bool = _config_default_on(index)
    box.set_checked(value)
    config_values = _config_with(config_values, index, _bool_text(value))
    _config_write()
}

local _config_default_on(index: number) bool {
    return index == 0
}

# BaseScreen.render's two counts, taken on the world frame that draws under a screen. The reference
# generates a shape whether or not it is drawn, and sums only the visible sets for the total, so this
# pass generates every set with the draw suppressed: a shape under a screen is generated once for the
# count and once for the draw. The current shape's count is its set's whether or not the set is
# visible. An errored shape is skipped, as it is when drawn, where the reference would show the cells
# it managed to emit before its exception.

local _count_all(ctx: OverlayWorldContext) {
    block_shape = 0
    block_total = 0
    count: number = _state_set_count()
    current: number = 0
    if count > 0 {
        current = _clamp(_int_or(_state_field(state, "iShapeSet", ""), 0), 0, count - 1)
    }
    cell_counting = true
    found: number = 0
    lines: number = _split_count(state, _newline())
    i: number = 0
    while i < lines {
        line: string = _line_at(state, i)
        if _has_prefix(line, "shapeSet=") {
            set: string = String.substring(line, 9, String.length(line))
            before: number = cell_count
            _count_set(ctx, set)
            cells: number = cell_count - before
            if _set_field_value(set, "visible") == "true" {
                block_total = block_total + cells
            }
            if found == current {
                block_shape = block_shape + cells
            }
            found = found + 1
        }
        i = i + 1
    }
    cell_counting = false
}

# One set's cells, generated with the same defaults ShapeSet.getShape would, and counted by
# _shape_cube. The origin cube is not a cell, so it is not drawn here.

local _count_set(ctx: OverlayWorldContext, set: string) {
    id: number = _set_int(set, "index", 0)
    if id < 0 or id >= _shape_count() {
        return
    }
    if _set_shape_error(set, id) {
        return
    }
    values: string = _set_shape_values(set, id)
    if String.length(values) == 0 {
        values = _shape_defaults(id)
    }
    _emit_shape(ctx, id, values, 0, 0, 0, 1, _colour("1.0,1.0,1.0,1.0"))
}

# State.savePersistence, written on every screen close while persistence is on and the state has
# loaded. The persistence text has no `!` after a refused shape's class name, which is this text's own
# marker for it, so every `!` is dropped. The `|` between a set's own fields and its shapes is this
# text's separator and not the reference's, whose restore splits every entry on `;` alone, so it is
# dropped too: with it, the first shape's key is `|ShapeCircle`, which no class matches, and every
# saved shape value is lost on the next load.

local _state_save() {
    if not state_loaded {
        return
    }
    if not _config_persistence(config_values) {
        return
    }
    text: string = _state_file_text(state)
    if persistence_written and text == persistence_text {
        return
    }
    files: File = File.open(r"files")
    # State.savePersistence throws on a refused write and BaseScreen.onScreenClosed catches it and
    # leaves shouldUpdatePersistence set, so the next close tries again. The written text and flag
    # move only when the write landed, which makes this close's save retry the next one.
    if files.try_write_text(_state_path(world_name, world_dimension), text) {
        persistence_text = text
        persistence_written = true
    }
}

# ShapelistScreen's seventeen widgets and the list of sets beside them. The three origin fields show
# the current set's origin, refreshed with the visible box whenever a row is selected, which is what
# the reference's list update closure does; a change the player makes to one field is left alone by
# the shift buttons that touch another. The twelve buttons that act on a set are inactive while the
# state holds none, which is checkActive, and Add re-checks it so the first set enables them.

local _shapelist_init(width: number, height: number) {
    _chrome_init(shapelist_screen, width, "shapelist", _state_enabled())
    open_dropdown: Widget = shapelist_screen.add_button("new_dropdown_open", "V", 145, 70, 20, 20)
    n_open.set(open_dropdown)
    add: Widget = shapelist_screen.add_button("add", "Add", 5, 90, 160, 20)
    s_add.set(add)
    visible: Widget = shapelist_screen.add_checkbox("visible", "", true, 5, 135, 20, 20)
    s_visible.set(visible)
    delete: Widget = shapelist_screen.add_button("delete", "Delete", 5, 155, 160, 20)
    s_delete.set(delete)
    global_origin: Widget = shapelist_screen.add_button("global_origin", "Set global origin", 5, 200, 160, 20)
    s_global.set(global_origin)
    x_dec: Widget = shapelist_screen.add_button("x_dec", "-", 25, 220, 20, 20)
    s_x_dec.set(x_dec)
    x_field: Widget = shapelist_screen.add_text_field("x_field", "", 45, 220, 70, 20)
    s_x_field.set(x_field)
    x_set: Widget = shapelist_screen.add_button("x_set", "Set", 115, 220, 30, 20)
    s_x_set.set(x_set)
    x_inc: Widget = shapelist_screen.add_button("x_inc", "+", 145, 220, 20, 20)
    s_x_inc.set(x_inc)
    y_dec: Widget = shapelist_screen.add_button("y_dec", "-", 25, 240, 20, 20)
    s_y_dec.set(y_dec)
    y_field: Widget = shapelist_screen.add_text_field("y_field", "", 45, 240, 70, 20)
    s_y_field.set(y_field)
    y_set: Widget = shapelist_screen.add_button("y_set", "Set", 115, 240, 30, 20)
    s_y_set.set(y_set)
    y_inc: Widget = shapelist_screen.add_button("y_inc", "+", 145, 240, 20, 20)
    s_y_inc.set(y_inc)
    z_dec: Widget = shapelist_screen.add_button("z_dec", "-", 25, 260, 20, 20)
    s_z_dec.set(z_dec)
    z_field: Widget = shapelist_screen.add_text_field("z_field", "", 45, 260, 70, 20)
    s_z_field.set(z_field)
    z_set: Widget = shapelist_screen.add_button("z_set", "Set", 115, 260, 30, 20)
    s_z_set.set(z_set)
    z_inc: Widget = shapelist_screen.add_button("z_inc", "+", 145, 260, 20, 20)
    s_z_inc.set(z_inc)
    list: Widget = shapelist_screen.add_list("shapes", 180, 70, 145, height - 70, 20)
    s_list.set(list)
    close_dropdown: Widget = shapelist_screen.add_button("new_dropdown_close", "X", 145, 70, 20, 20)
    n_close.set(close_dropdown)
    options: Widget = shapelist_screen.add_list("new_options", 5, 90, 160, height - 90, 20)
    n_list.set(options)
    _shapelist_active()
    _shapelist_rows()
    _shapelist_fields()
    n_open.unwrap().set_visible(not dropdown_open)
    n_close.unwrap().set_visible(dropdown_open)
    n_list.unwrap().set_visible(dropdown_open)
    if dropdown_open {
        _shapelist_dropdown_visible()
    }
}

# ShapelistScreen.render after super.render: the two add-shape texts over the dropdown's place, the
# selected-shape heading with the visible label, the global-origin heading with its three axis
# labels, and the shapes heading over the list. A label is dark grey while the state has no set.

local _shapelist_render(ctx: OverlayRenderContext, width: number) {
    _chrome_render(ctx, width)
    white: Color = Color.rgb(255, 255, 255)
    if dropdown_open {
        _draw_centred(ctx, _shape_name(_new_shape_index()), 85, 75, white)
        return
    }
    dim: Color = Color.rgb(68, 68, 68)
    active: bool = _state_set_count() > 0
    _draw_centred(ctx, "§nAdd new shape", 85, 55, white)
    _draw_centred(ctx, _shape_name(_new_shape_index()), 85, 75, white)
    _draw_centred(ctx, "§nSelected shape", 85, 120, white)
    label: Color = dim
    if active {
        label = white
    }
    ctx.draw_text("Visible", 30, 140, label)
    _draw_centred(ctx, "§nGlobal origin", 85, 185, white)
    ctx.draw_text("X", 10, 225, label)
    ctx.draw_text("Y", 10, 245, label)
    ctx.draw_text("Z", 10, 265, label)
    _draw_centred(ctx, "§nShapes", 250, 55, white)
}

# Every widget of the tab. A row click moves the state's current set, refreshes the fields and
# corrects the visible box from that set, which is the reference's setSelected; Add appends a set,
# selects it and enables the buttons; Delete removes the selected set and selects the row below it,
# else the one above; the shift buttons move every set and rewrite the field they moved; a Set button
# parses its field and turns it red when it cannot.

local _shapelist_changed(widget: Widget) {
    if _chrome_changed(widget) {
        return
    }
    if equals(widget, n_open.unwrap()) {
        _dropdown_open()
        return
    }
    if equals(widget, n_close.unwrap()) {
        _dropdown_close()
        return
    }
    if equals(widget, n_list.unwrap()) {
        _dropdown_pick(widget.selected())
        return
    }
    list: Widget = s_list.unwrap()
    if equals(widget, list) {
        index: number = widget.selected()
        if index >= 0 {
            state = _state_with_field(state, "iShapeSet", String.from_number(index))
            _shapelist_fields()
        }
        return
    }
    if equals(widget, s_add.unwrap()) {
        _shapelist_add()
        return
    }
    if equals(widget, s_visible.unwrap()) {
        _shapelist_set_visible(widget.checked())
        return
    }
    if equals(widget, s_delete.unwrap()) {
        _shapelist_delete()
        return
    }
    if equals(widget, s_global.unwrap()) {
        _shapelist_global()
        return
    }
    if equals(widget, s_x_dec.unwrap()) {
        _shapelist_shift(-1, 0, 0)
        return
    }
    if equals(widget, s_x_inc.unwrap()) {
        _shapelist_shift(1, 0, 0)
        return
    }
    if equals(widget, s_y_dec.unwrap()) {
        _shapelist_shift(0, -1, 0)
        return
    }
    if equals(widget, s_y_inc.unwrap()) {
        _shapelist_shift(0, 1, 0)
        return
    }
    if equals(widget, s_z_dec.unwrap()) {
        _shapelist_shift(0, 0, -1)
        return
    }
    if equals(widget, s_z_inc.unwrap()) {
        _shapelist_shift(0, 0, 1)
        return
    }
    if equals(widget, s_x_set.unwrap()) {
        _shapelist_set_axis(0, s_x_field.unwrap())
        return
    }
    if equals(widget, s_y_set.unwrap()) {
        _shapelist_set_axis(1, s_y_field.unwrap())
        return
    }
    if equals(widget, s_z_set.unwrap()) {
        _shapelist_set_axis(2, s_z_field.unwrap())
    }
}

# One row of the shape list: the set at the row's place, drawn with its shape's name and colour.

local _shapelist_row(ctx: ListRowResponse) {
    list: Widget = s_list.unwrap()
    if not equals(ctx.widget(), list) {
        return
    }
    set: string = _state_set_at(state, ctx.index())
    ctx.set_text(_shape_row_text(set))
    ctx.set_text_colour(_shape_row_colour(set))
}

# ShapelistScreen's Add: pushNewShapeSet builds the new set at iShapeNew with the player's feet as its
# origin, and addEntry appends its row and selects it, which makes it the current set.

local _shapelist_add() {
    if not world_level.has() {
        return
    }
    count: number = _state_set_count()
    _state_push_set(world_x, world_y, world_z)
    state = _state_with_field(state, "iShapeSet", String.from_number(count))
    list: Widget = s_list.unwrap()
    list.set_rows(count + 1)
    list.select(count)
    _shapelist_active()
    _shapelist_fields()
}

# ShapelistScreen's Delete: remove the current set and the selected row, then select the row that was
# below it, or the one above when it was last, which is removeEntry's own choice. With no set left
# the selection is dropped and iShapeSet keeps the value the reference leaves it at.

local _shapelist_delete() {
    count: number = _state_set_count()
    if count == 0 {
        return
    }
    index: number = _state_index()
    state = _state_remove_set(state, index)
    remaining: number = count - 1
    list: Widget = s_list.unwrap()
    list.set_rows(remaining)
    if remaining > 0 {
        next: number = index
        if next >= remaining {
            next = remaining - 1
        }
        list.select(next)
        state = _state_with_field(state, "iShapeSet", String.from_number(next))
    }
    _shapelist_active()
    _shapelist_fields()
}

# ShapeSet.shiftOrigin of every set, then the field of each axis that moved written from the current
# set's new origin. The other fields keep whatever the player typed, as the reference leaves them.

local _shapelist_shift(dx: number, dy: number, dz: number) {
    if _state_set_count() == 0 {
        return
    }
    state = _state_shift_origins(state, dx, dy, dz)
    set: string = _state_current_set()
    if dx != 0 {
        _shapelist_put(s_x_field.unwrap(), String.from_number(_origin_piece(set, 0)))
    }
    if dy != 0 {
        _shapelist_put(s_y_field.unwrap(), String.from_number(_origin_piece(set, 1)))
    }
    if dz != 0 {
        _shapelist_put(s_z_field.unwrap(), String.from_number(_origin_piece(set, 2)))
    }
}

# A Set button: Integer.parseInt on its field, then the difference to the current set's origin shifted
# across every set. A field that does not parse turns red and the origins stay, which is the
# reference's catch.

local _shapelist_set_axis(axis: number, field: Widget) {
    if _state_set_count() == 0 {
        return
    }
    parsed: Option[number] = String.to_integer(field.text())
    if not parsed.has() {
        field.set_text_colour(Color.rgb(255, 0, 0))
        return
    }
    current: string = _state_current_set()
    delta: number = parsed.unwrap() - _origin_piece(current, axis)
    if axis == 0 {
        state = _state_shift_origins(state, delta, 0, 0)
    } else if axis == 1 {
        state = _state_shift_origins(state, 0, delta, 0)
    } else {
        state = _state_shift_origins(state, 0, 0, delta)
    }
    field.set_text_colour(Color.rgb(255, 255, 255))
}

# Set global origin: move every set by the distance from the current set's origin to the player's
# feet. The reference asks only while a set exists, which is also when the button is active.

local _shapelist_global() {
    if _state_set_count() == 0 {
        return
    }
    set: string = _state_current_set()
    # The feet are fractional, and the origin is whole blocks the load parses with Integer.parseInt,
    # so the distance is taken from the floor, as _apply_pending's global origin and _origin_text do.
    state = _state_shift_origins(state, Math.floor(world_x) - _origin_piece(set, 0), Math.floor(world_y) - _origin_piece(set, 1), Math.floor(world_z) - _origin_piece(set, 2))
    _shapelist_fields()
}

# The visible box writes the current set's flag, and nothing else, which is setShapeVisibility.

local _shapelist_set_visible(checked: bool) {
    if _state_set_count() == 0 {
        return
    }
    set: string = _state_current_set()
    state = _state_with_set(state, _state_index(), _set_with_field(set, "visible", _bool_text(checked)))
}

# The three fields, in white, from the current set's origin, and the visible box from its flag. With
# no set the fields hold "-". This is the reference's list update closure: the shape list selects the
# current row as it is built, which runs the closure, so the box is read from the state on open too
# and not only when the player later selects a row.

local _shapelist_fields() {
    set: string = _state_current_set()
    if String.length(set) == 0 {
        _shapelist_put(s_x_field.unwrap(), "-")
        _shapelist_put(s_y_field.unwrap(), "-")
        _shapelist_put(s_z_field.unwrap(), "-")
        return
    }
    _shapelist_put(s_x_field.unwrap(), String.from_number(_origin_piece(set, 0)))
    _shapelist_put(s_y_field.unwrap(), String.from_number(_origin_piece(set, 1)))
    _shapelist_put(s_z_field.unwrap(), String.from_number(_origin_piece(set, 2)))
    s_visible.unwrap().set_checked(_set_field_value(set, "visible") == "true")
}

# One text field's text and its normal colour, together, because every write of an origin is white.

local _shapelist_put(field: Widget, text: string) {
    field.set_text(text)
    field.set_text_colour(Color.rgb(255, 255, 255))
}

# checkActive: with no set, the visible box, Delete, the global origin and the nine +/-/Set buttons
# are inactive; with one, all are active. Add is never gated, which is what lets an empty state get
# its first set.

local _shapelist_active() {
    active: bool = _state_set_count() > 0
    s_visible.unwrap().set_active(active)
    s_delete.unwrap().set_active(active)
    s_global.unwrap().set_active(active)
    s_x_dec.unwrap().set_active(active)
    s_x_set.unwrap().set_active(active)
    s_x_inc.unwrap().set_active(active)
    s_y_dec.unwrap().set_active(active)
    s_y_set.unwrap().set_active(active)
    s_y_inc.unwrap().set_active(active)
    s_z_dec.unwrap().set_active(active)
    s_z_set.unwrap().set_active(active)
    s_z_inc.unwrap().set_active(active)
}

# The list's row count is the state's set count, and its selection is the state's current set, which
# a fresh init puts back after a close.

local _shapelist_rows() {
    count: number = _state_set_count()
    list: Widget = s_list.unwrap()
    list.set_rows(count)
    if count > 0 {
        list.select(_state_index())
    }
}

# State.getShapeSetIndex as a usable index: iShapeSet, clamped into the sets that are there. An empty
# state has no set to name, and every caller checks its count before reading this.

local _state_index() number {
    count: number = _state_set_count()
    if count == 0 {
        return 0
    }
    return _clamp(_int_or(_state_field(state, "iShapeSet", "0"), 0), 0, count - 1)
}

# The state text without the shapeSet line at the given sequence number.

local _state_remove_set(text: string, wanted: number) string {
    out: string = ""
    found: number = 0
    lines: number = _split_count(text, _newline())
    i: number = 0
    while i < lines {
        line: string = _line_at(text, i)
        if _has_prefix(line, "shapeSet=") {
            if found != wanted {
                out = String.concat(out, _line(line))
            }
            found = found + 1
        } else {
            out = String.concat(out, _line(line))
        }
        i = i + 1
    }
    return out
}

# State.getIShapeNew, clamped into the registry, which is the name the add-shape text shows.

local _new_shape_index() number {
    return _clamp(_int_or(_state_field(state, "iShapeNew", "1"), 1), 0, _shape_count() - 1)
}

# The English name of a registry entry, as ShapeRegistry's translation key resolves it. An index past
# the registry answers the no-shape name, which the reference draws for a set that has no shape.

local _shape_name(id: number) string {
    if id == 0 {
        return "Catenary"
    }
    if id == 1 {
        return "Circle"
    }
    if id == 2 {
        return "Cone"
    }
    if id == 3 {
        return "Cuboid"
    }
    if id == 4 {
        return "Ellipse"
    }
    if id == 5 {
        return "Ellipsoid"
    }
    if id == 6 {
        return "Grid"
    }
    if id == 7 {
        return "Helix"
    }
    if id == 8 {
        return "Line"
    }
    if id == 9 {
        return "Parabola"
    }
    if id == 10 {
        return "Paraboloid"
    }
    if id == 11 {
        return "Polygon"
    }
    if id == 12 {
        return "Polygonal pyramid"
    }
    if id == 13 {
        return "Sphere"
    }
    if id == 14 {
        return "Torus"
    }
    return "None"
}

# getFormattedShapeName: a set's shape name, struck through while the set is invisible. Not visible
# is read from the field because the state is the only copy of the set the list has.

local _shape_row_text(set: string) string {
    if String.length(set) == 0 {
        return "None"
    }
    id: number = _set_int(set, "index", 0)
    if id < 0 or id >= _shape_count() {
        return "None"
    }
    name: string = _shape_name(id)
    if _set_field_value(set, "visible") != "true" {
        return String.concat("§m", name)
    }
    return name
}

# getShapeProgressColour: red for a shape that failed, else its completed colour. A setted shape is
# generated on the frame that draws it, so it is always complete on this port and white; the green to
# white second after a generation and the spinner while it runs are the reference's asynchronous
# generation, which about.json records.
local _shape_row_colour(set: string) Color {
    id: number = _set_int(set, "index", 0)
    if String.length(set) > 0 and id >= 0 and id < _shape_count() and _set_shape_error(set, id) {
        return Color.rgb(255, 0, 0)
    }
    return Color.rgb(255, 255, 255)
}

# ---------------------------------------------------------------- ShapeScreen

# ShapeScreen.init after super.init: the dropdown's V at (145, 70) and its list at (5, 90) with the
# X, which only the dropdown shows, Set origin at (5, 115), the three origin rows at y 135, 155 and
# 175 with their decrease button at 25, their 70-wide field at 45, their Set at 115 and their
# increase button at 145, then the property panel's eight-row pool. The eleven buttons that act on
# the set are inactive while the state has none, and the three fields then hold "-".

local _shape_init(width: number, height: number) {
    _chrome_init(shape_screen, width, "shape", _state_enabled())
    open_dropdown: Widget = shape_screen.add_button("shape_dropdown_open", "V", 145, 70, 20, 20)
    q_open.set(open_dropdown)
    set_origin: Widget = shape_screen.add_button("set_origin", "Set origin", 5, 115, 160, 20)
    o_set.set(set_origin)
    x_dec: Widget = shape_screen.add_button("x_dec", "-", 25, 135, 20, 20)
    o_x_dec.set(x_dec)
    x_field: Widget = shape_screen.add_text_field("x_field", "", 45, 135, 70, 20)
    o_x_field.set(x_field)
    x_set: Widget = shape_screen.add_button("x_set", "Set", 115, 135, 30, 20)
    o_x_set.set(x_set)
    x_inc: Widget = shape_screen.add_button("x_inc", "+", 145, 135, 20, 20)
    o_x_inc.set(x_inc)
    y_dec: Widget = shape_screen.add_button("y_dec", "-", 25, 155, 20, 20)
    o_y_dec.set(y_dec)
    y_field: Widget = shape_screen.add_text_field("y_field", "", 45, 155, 70, 20)
    o_y_field.set(y_field)
    y_set: Widget = shape_screen.add_button("y_set", "Set", 115, 155, 30, 20)
    o_y_set.set(y_set)
    y_inc: Widget = shape_screen.add_button("y_inc", "+", 145, 155, 20, 20)
    o_y_inc.set(y_inc)
    z_dec: Widget = shape_screen.add_button("z_dec", "-", 25, 175, 20, 20)
    o_z_dec.set(z_dec)
    z_field: Widget = shape_screen.add_text_field("z_field", "", 45, 175, 70, 20)
    o_z_field.set(z_field)
    z_set: Widget = shape_screen.add_button("z_set", "Set", 115, 175, 30, 20)
    o_z_set.set(z_set)
    z_inc: Widget = shape_screen.add_button("z_inc", "+", 145, 175, 20, 20)
    o_z_inc.set(z_inc)
    row: number = 0
    while row < 8 {
        _shape_pool_build(row)
        row = row + 1
    }
    close_dropdown: Widget = shape_screen.add_button("shape_dropdown_close", "X", 145, 70, 20, 20)
    q_close.set(close_dropdown)
    options: Widget = shape_screen.add_list("shape_options", 5, 90, 160, height - 90, 20)
    q_list.set(options)
    _shape_active(_shape_available())
    _shape_fields()
    _shape_relayout()
    q_open.unwrap().set_visible(not dropdown_open)
    q_close.unwrap().set_visible(dropdown_open)
    q_list.unwrap().set_visible(dropdown_open)
    if dropdown_open {
        _shape_dropdown_visible()
    }
}

# ShapeScreen.render after super.render: the shape and origin headings on the left, the current
# shape's name under the heading in its progress colour, the three axis labels greyed while the
# state has no set, the properties heading on the right, then every property row's label at x + 5
# and, for an enum, its value centred in the gap between the arrows. A runnable property draws no
# label, because its wide button carries its name.

local _shape_render(ctx: OverlayRenderContext, width: number) {
    _chrome_render(ctx, width)
    white: Color = Color.rgb(255, 255, 255)
    if dropdown_open {
        id: number = _shape_current_id()
        if id >= 0 {
            _draw_centred(ctx, _shape_name(id), 85, 75, white)
        }
        return
    }
    set: string = _state_current_set()
    _draw_centred(ctx, "§nShape", 85, 55, white)
    _draw_centred(ctx, _shape_row_text(set), 85, 75, _shape_row_colour(set))
    _draw_centred(ctx, "§nOrigin", 85, 100, white)
    label: Color = Color.rgb(68, 68, 68)
    if _shape_available() {
        label = white
    }
    ctx.draw_text("X", 10, 140, label)
    ctx.draw_text("Y", 10, 160, label)
    ctx.draw_text("Z", 10, 180, label)
    _draw_centred(ctx, "§nShape properties", 285, 55, white)
    id: number = _shape_current_id()
    if id < 0 {
        return
    }
    kinds: string = _shape_kinds(id)
    values: string = _shape_values_now()
    labels: string = _shape_labels(id)
    count: number = _split_count(kinds, ";")
    row: number = 0
    while row < count {
        kind: string = _piece(kinds, ";", row)
        letter: string = String.substring(kind, 0, 1)
        if letter != "r" {
            ctx.draw_text(_piece(labels, "|", row), 185, 75 + row * 20, white)
        }
        if letter == "e" {
            _draw_centred(ctx, _enum_display(kind, _enum_index(kind, _piece(values, ",", row))), 330, 75 + row * 20, white)
        }
        row = row + 1
    }
}

# Every widget of the tab. Set origin puts every origin back on the player's feet and the shift
# buttons move the current set by one block, both rewriting the fields they moved; a Set button
# parses its field and turns it red when it cannot, keeping the origin; the property pool's buttons
# step, set, toggle or step the property under them, and its text field waits for its Set button,
# as the reference's five property classes do.

local _shape_changed(widget: Widget) {
    if _chrome_changed(widget) {
        return
    }
    if equals(widget, q_open.unwrap()) {
        _dropdown_open()
        return
    }
    if equals(widget, q_close.unwrap()) {
        _dropdown_close()
        return
    }
    if equals(widget, q_list.unwrap()) {
        _dropdown_pick(widget.selected())
        return
    }
    if equals(widget, o_set.unwrap()) {
        _shape_set_origin()
        return
    }
    if equals(widget, o_x_dec.unwrap()) {
        _shape_shift(-1, 0, 0)
        return
    }
    if equals(widget, o_x_inc.unwrap()) {
        _shape_shift(1, 0, 0)
        return
    }
    if equals(widget, o_y_dec.unwrap()) {
        _shape_shift(0, -1, 0)
        return
    }
    if equals(widget, o_y_inc.unwrap()) {
        _shape_shift(0, 1, 0)
        return
    }
    if equals(widget, o_z_dec.unwrap()) {
        _shape_shift(0, 0, -1)
        return
    }
    if equals(widget, o_z_inc.unwrap()) {
        _shape_shift(0, 0, 1)
        return
    }
    if equals(widget, o_x_set.unwrap()) {
        _shape_set_axis(0, o_x_field.unwrap())
        return
    }
    if equals(widget, o_y_set.unwrap()) {
        _shape_set_axis(1, o_y_field.unwrap())
        return
    }
    if equals(widget, o_z_set.unwrap()) {
        _shape_set_axis(2, o_z_field.unwrap())
        return
    }
    _shape_prop_changed(widget)
}

# ShapeScreen.init's property widgets, one pool row at a time, at the positions its five property
# classes use and at the sizes they ask for. A widget the current shape does not need stays hidden
# until a relayout shows it, so a shape change never needs a new screen.

local _shape_pool_build(row: number) {
    if row == 0 {
        base: string = "prop0"
        dec: Widget = shape_screen.add_button(String.concat(base, "_dec"), "-", 0, 0, 20, 20)
        p0a.set(dec)
        field: Widget = shape_screen.add_text_field(String.concat(base, "_field"), "", 0, 0, 50, 20)
        p0b.set(field)
        set: Widget = shape_screen.add_button(String.concat(base, "_set"), "Set", 0, 0, 30, 20)
        p0c.set(set)
        inc: Widget = shape_screen.add_button(String.concat(base, "_inc"), "+", 0, 0, 20, 20)
        p0d.set(inc)
        box: Widget = shape_screen.add_checkbox(String.concat(base, "_box"), "", false, 0, 0, 20, 20)
        p0e.set(box)
        left: Widget = shape_screen.add_button(String.concat(base, "_left"), "<-", 0, 0, 20, 20)
        p0f.set(left)
        right: Widget = shape_screen.add_button(String.concat(base, "_right"), "->", 0, 0, 20, 20)
        p0g.set(right)
        run: Widget = shape_screen.add_button(String.concat(base, "_run"), "", 0, 0, 210, 20)
        p0h.set(run)
        return
    }
    if row == 1 {
        base: string = "prop1"
        dec: Widget = shape_screen.add_button(String.concat(base, "_dec"), "-", 0, 0, 20, 20)
        p1a.set(dec)
        field: Widget = shape_screen.add_text_field(String.concat(base, "_field"), "", 0, 0, 50, 20)
        p1b.set(field)
        set: Widget = shape_screen.add_button(String.concat(base, "_set"), "Set", 0, 0, 30, 20)
        p1c.set(set)
        inc: Widget = shape_screen.add_button(String.concat(base, "_inc"), "+", 0, 0, 20, 20)
        p1d.set(inc)
        box: Widget = shape_screen.add_checkbox(String.concat(base, "_box"), "", false, 0, 0, 20, 20)
        p1e.set(box)
        left: Widget = shape_screen.add_button(String.concat(base, "_left"), "<-", 0, 0, 20, 20)
        p1f.set(left)
        right: Widget = shape_screen.add_button(String.concat(base, "_right"), "->", 0, 0, 20, 20)
        p1g.set(right)
        run: Widget = shape_screen.add_button(String.concat(base, "_run"), "", 0, 0, 210, 20)
        p1h.set(run)
        return
    }
    if row == 2 {
        base: string = "prop2"
