# Build Guide 0.4.9's behaviour for 1.20.6-forge, the loader the reference itself ships: the fifteen
# shape generators, the per-world state file, the three config options, the world drawing of every
# visible set with its origin cube, and the four screens with their widgets (#1752).
# The reference is one client-side shape projector: a set is an origin, a shape class with its own
# properties, a colour for the shape and one for the origin, and two cube sizes. There is no build
# capture, no schematic and no server side, and the only persisted data is the set list and the
# config, so nothing here reads or writes a world.
# A screen is one of the reference's four, opened by its B key or a tab button and laid out again on
# every open and resize, and its close saves the whole state when persistence is on. Its graphics
# captures are the last stage (#1752), and so is the reference job's comparison.
# Everything lives in this file because a grug local function is visible only inside the file that
# defines it, and the host cannot call one: the generators, the state text codec and the drawing are
# one chain, and a second file could not reach the first.
# A shape is generated on the frame it is drawn, from the property text the set holds, and the
# reference's own loop runs once per share, emitting a cube as it goes. The reference walks its
# loops three times (once to count, once to emit, and the render handler reads the cached buffer),
# and stage 1's shape test walked them once per cell, which is O(n^2) over a shape; this file keeps
# the reference's iteration order and its duplicates in one pass, so a shape costs what the
# reference's own generation costs and no more.
# The reference generates asynchronously: Shape.update sets ready to false and closes the buffer
# until the new one is ready, so the guide disappears for a few frames while a shape changes. This
# port generates inside the frame that draws it, so that frame stalls and the finished shape appears
# at once. about.json records that as a deviation.

# The state of the world this client is in, as one string in the reference's own file format, plus a
# `!` after the class name of a shape whose properties did not parse, which is how the reference's
# Shape.error survives in a text with no objects. The reference keeps one State per world and
# dimension for the whole session, so each visited key's state stays in `state_store` and is
# restored on return. See "the state as a whole" below.
state: string = ""
state_key: string = ""
state_loaded: bool = false
state_store: string = ""

# What the last close wrote and whether it wrote at all, so a close that changed nothing writes
# nothing. This is BaseScreen.shouldUpdatePersistence, which the reference sets on every mutation and
# clears after a save: the saved text is the whole of what a mutation can change, so comparing it
# answers the same question without a flag at each of the reference's mutation sites.
persistence_text: string = ""
persistence_written: bool = false

# State.initialised: whether initCheck has run for the state in `state`. It runs on the toggle key,
# not on the load, so a fresh world has no set until the player first presses G, and that set starts
# at the player's feet at that moment. A rebuilt state is a new State in the reference, so this is
# cleared wherever `state` is replaced by a build from the world's key.
state_initialised: bool = false

# The three config values in file order, as "async,random,persistence". Read once per session from
# the file the reference keeps, and never through the host Config entity, because that one writes
# <gameDir>/config/grug/<mod>.yml and the reference's other mods and players read
# <gameDir>/config/buildguide.cfg.
config_values: string = ""
config_loaded: bool = false

# Presses of the three keys that arrived since the last world frame. A binding handler has no level
# and no player position, so the press is counted there and applied at the next frame, where the
# reference's own input handler runs.
pending_toggle: number = 0
pending_origin: number = 0
pending_global_origin: number = 0

# The load's hard stop, set where the reference's uncaught NumberFormatException leaves
# loadPersistence and read by every loop that would otherwise carry on after it.
load_failed: bool = false

# The reference's BaseScreen and its four tabs. A screen is created at member scope, opened with
# `open`, and asked to declare its widgets in `screen_init` on every open and after every resize;
# the host asks the `screen_*` exports only while one of them is open.
shape_screen: Screen = Screen.new()
visualisation_screen: Screen = Screen.new()
shapelist_screen: Screen = Screen.new()
configuration_screen: Screen = Screen.new()

# State.currentScreen: the tab a screen shows and the B key opens. `active_screen` is the screen
# that is open, and empty while none is, which is what tells the world frame whether to count the
# shapes a screen will show. `dropdown_open` is the Shape or Shape list dropdown, which the host's
# API cannot show over its parent, so it is a list inside the parent that hides the parent's own
# widgets while it is up; every later open of a screen starts with it closed.
tab_screen: string = "shape"
active_screen: string = ""
dropdown_open: bool = false
# True while _open_tab is replacing one screen with another. The new screen's open closes the old
# one, and the old one's screen_closed runs inside that close, after active_screen already names the
# new tab; this keeps that close from clearing it.
switching_tab: bool = false

# The chrome's six widgets, which every screen declares for itself in _chrome_init. Only the open
# screen's widgets exist, so one handle per widget serves all four screens.
w_enabled: Option[Widget] = Option.new()
w_close: Option[Widget] = Option.new()
w_tab_shape: Option[Widget] = Option.new()
w_tab_visualisation: Option[Widget] = Option.new()
w_tab_shapelist: Option[Widget] = Option.new()
w_tab_configuration: Option[Widget] = Option.new()

# ConfigurationScreen's six widgets: three checkboxes and their Default buttons.
c_async: Option[Widget] = Option.new()
c_async_default: Option[Widget] = Option.new()
c_random: Option[Widget] = Option.new()
c_random_default: Option[Widget] = Option.new()
c_persistence: Option[Widget] = Option.new()
c_persistence_default: Option[Widget] = Option.new()

# VisualisationScreen's nineteen widgets: ten sliders that only a Set button reads, the six colour
# buttons, the depth-test checkbox, and the two cube-size buttons beside their sliders.
v_shape_r: Option[Widget] = Option.new()
v_shape_g: Option[Widget] = Option.new()
v_shape_b: Option[Widget] = Option.new()
v_shape_a: Option[Widget] = Option.new()
v_set_shape: Option[Widget] = Option.new()
v_random_shape: Option[Widget] = Option.new()
v_default_shape: Option[Widget] = Option.new()
v_origin_r: Option[Widget] = Option.new()
v_origin_g: Option[Widget] = Option.new()
v_origin_b: Option[Widget] = Option.new()
v_origin_a: Option[Widget] = Option.new()
v_set_origin: Option[Widget] = Option.new()
v_random_origin: Option[Widget] = Option.new()
v_default_origin: Option[Widget] = Option.new()
v_depth: Option[Widget] = Option.new()
v_shape_cube: Option[Widget] = Option.new()
v_origin_cube: Option[Widget] = Option.new()
v_set_cube: Option[Widget] = Option.new()
v_default_cube: Option[Widget] = Option.new()

# ShapelistScreen's seventeen widgets: Add, the visible checkbox, Delete, the global-origin button,
# the three origin rows of a decrease button, a text field, a Set button and an increase button, and
# the shape list. The list's rows are the state's sets, in file order.
s_add: Option[Widget] = Option.new()
s_visible: Option[Widget] = Option.new()
s_delete: Option[Widget] = Option.new()
s_global: Option[Widget] = Option.new()
s_x_dec: Option[Widget] = Option.new()
s_x_field: Option[Widget] = Option.new()
s_x_set: Option[Widget] = Option.new()
s_x_inc: Option[Widget] = Option.new()
s_y_dec: Option[Widget] = Option.new()
s_y_field: Option[Widget] = Option.new()
s_y_set: Option[Widget] = Option.new()
s_y_inc: Option[Widget] = Option.new()
s_z_dec: Option[Widget] = Option.new()
s_z_field: Option[Widget] = Option.new()
s_z_set: Option[Widget] = Option.new()
s_z_inc: Option[Widget] = Option.new()
s_list: Option[Widget] = Option.new()

# The two dropdowns: ShapeScreen's V button, its X and its list of the fifteen shape names, and
# ShapelistScreen's own three, which choose the new set's shape instead. Each screen declares its
# own names, so one handle per role holds whichever screen is open.
q_open: Option[Widget] = Option.new()
q_close: Option[Widget] = Option.new()
q_list: Option[Widget] = Option.new()
n_open: Option[Widget] = Option.new()
n_close: Option[Widget] = Option.new()
n_list: Option[Widget] = Option.new()

# ShapeScreen's thirteen origin widgets: Set origin and one row of a decrease button, an origin text
# field, a Set button and an increase button per axis, at the reference's own positions.
o_set: Option[Widget] = Option.new()
o_x_dec: Option[Widget] = Option.new()
o_x_field: Option[Widget] = Option.new()
o_x_set: Option[Widget] = Option.new()
o_x_inc: Option[Widget] = Option.new()
o_y_dec: Option[Widget] = Option.new()
o_y_field: Option[Widget] = Option.new()
o_y_set: Option[Widget] = Option.new()
o_y_inc: Option[Widget] = Option.new()
o_z_dec: Option[Widget] = Option.new()
o_z_field: Option[Widget] = Option.new()
o_z_set: Option[Widget] = Option.new()
o_z_inc: Option[Widget] = Option.new()

# ShapeScreen's property rows: eight slots each, one per widget a property class can add. A
# number property shows its decrease button, text field, Set button and increase button; a
# boolean its checkbox; an enum its two arrows; a runnable its one wide button. The slots are
# declared for every row in screen_init and shown, hidden and moved as the shape changes, which
# is what Widget.set_position and set_visible exist for: add_* is legal only while init runs.
# Eight rows is the longest property list in the registry, which is the helix's.
p0a: Option[Widget] = Option.new()
p0b: Option[Widget] = Option.new()
p0c: Option[Widget] = Option.new()
p0d: Option[Widget] = Option.new()
p0e: Option[Widget] = Option.new()
