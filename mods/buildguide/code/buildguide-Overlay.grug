        p7h.set(run)
        return
    }
}

# checkActive: Set origin and the six shift buttons and three Set buttons are inactive while the
# state has no set, and the three fields are typeable either way, as the reference leaves them.

local _shape_active(available: bool) {
    q_open.unwrap().set_active(available)
    o_set.unwrap().set_active(available)
    o_x_dec.unwrap().set_active(available)
    o_x_set.unwrap().set_active(available)
    o_x_inc.unwrap().set_active(available)
    o_y_dec.unwrap().set_active(available)
    o_y_set.unwrap().set_active(available)
    o_y_inc.unwrap().set_active(available)
    o_z_dec.unwrap().set_active(available)
    o_z_set.unwrap().set_active(available)
    o_z_inc.unwrap().set_active(available)
}

# The three origin fields from the current set's origin, or "-" with no set, in white.

local _shape_fields() {
    if not _shape_available() {
        _shape_put(o_x_field.unwrap(), "-")
        _shape_put(o_y_field.unwrap(), "-")
        _shape_put(o_z_field.unwrap(), "-")
        return
    }
    set: string = _state_current_set()
    _shape_put(o_x_field.unwrap(), String.from_number(_origin_piece(set, 0)))
    _shape_put(o_y_field.unwrap(), String.from_number(_origin_piece(set, 1)))
    _shape_put(o_z_field.unwrap(), String.from_number(_origin_piece(set, 2)))
}

# One field's text and its normal colour, together, because every write of an origin is white.

local _shape_put(field: Widget, text: string) {
    field.set_text(text)
    field.set_text_colour(Color.rgb(255, 255, 255))
}

# Shape.onSelectedInGUI and onDeselectedInGUI without a reopen: every pool row is hidden, then the
# current shape's rows are shown at basePropertiesY + i*20 and filled from the values the set holds,
# or from the class's defaults when the set has no entry for it yet.

local _shape_relayout() {
    row: number = 0
    while row < 8 {
        _shape_row_hide(row)
        row = row + 1
    }
    id: number = _shape_current_id()
    if id < 0 {
        return
    }
    kinds: string = _shape_kinds(id)
    values: string = _shape_values_now()
    count: number = _split_count(kinds, ";")
    row = 0
    while row < count {
        _shape_row_show(row, id, _piece(kinds, ";", row), values)
        row = row + 1
    }
}

local _shape_row_hide(row: number) {
    slot: number = 0
    while slot < 8 {
        _prop_widget(row, slot).set_visible(false)
        slot = slot + 1
    }
}

# One row of the panel at the position its property class uses: a number's four widgets at x + 90,
# + 110, + 160 and + 190, a boolean's checkbox at x + 140, an enum's arrows at x + 90 and + 190, or
# a runnable's 210-wide button at x. The value goes into the field, the box or the button.

local _shape_row_show(row: number, id: number, kind: string, values: string) {
    y: number = 70 + row * 20
    letter: string = String.substring(kind, 0, 1)
    if letter == "b" {
        box: Widget = _prop_widget(row, 4)
        box.set_position(320, y)
        box.set_checked(String.equals_ignore_case(_piece(values, ",", row), "true"))
        box.set_visible(true)
        return
    }
    if letter == "e" {
        left: Widget = _prop_widget(row, 5)
        left.set_position(270, y)
        left.set_visible(true)
        right: Widget = _prop_widget(row, 6)
        right.set_position(370, y)
        right.set_visible(true)
        return
    }
    if letter == "r" {
        run: Widget = _prop_widget(row, 7)
        run.set_position(180, y)
        run.set_text(_piece(_shape_labels(id), "|", row))
        run.set_visible(true)
        return
    }
    dec: Widget = _prop_widget(row, 0)
    dec.set_position(270, y)
    dec.set_visible(true)
    field: Widget = _prop_widget(row, 1)
    field.set_position(290, y)
    field.set_text(_piece(values, ",", row))
    field.set_text_colour(Color.rgb(255, 255, 255))
    field.set_visible(true)
    set: Widget = _prop_widget(row, 2)
    set.set_position(340, y)
    set.set_visible(true)
    inc: Widget = _prop_widget(row, 3)
    inc.set_position(370, y)
    inc.set_visible(true)
}

# ShapeScreen.setOrigin: State.resetOrigin puts the current set's origin on the player's feet, then
# the three fields are written from it.

local _shape_set_origin() {
    if not _shape_available() {
        return
    }
    set: string = _state_current_set()
    state = _state_with_set(state, _state_index(), _set_with_field(set, "origin", _origin_text(world_x, world_y, world_z)))
    _shape_fields()
}

# ShapeScreen.shiftOrigin: State.shiftOrigin moves the current set only, and each moved axis's field
# is rewritten from the new origin.

local _shape_shift(dx: number, dy: number, dz: number) {
    if not _shape_available() {
        return
    }
    set: string = _state_current_set()
    x: number = _origin_piece(set, 0) + dx
    y: number = _origin_piece(set, 1) + dy
    z: number = _origin_piece(set, 2) + dz
    state = _state_with_set(state, _state_index(), _set_with_field(set, "origin", _origin_text(x, y, z)))
    if dx != 0 {
        _shape_put(o_x_field.unwrap(), String.from_number(x))
    }
    if dy != 0 {
        _shape_put(o_y_field.unwrap(), String.from_number(y))
    }
    if dz != 0 {
        _shape_put(o_z_field.unwrap(), String.from_number(z))
    }
}

# A Set button beside an origin field: Integer.parseInt on the field, then State.setOriginX/Y/Z,
# which writes the current set's own axis. A field that does not parse turns red and the origin
# stays, which is the reference's catch; the field keeps the text the player typed.

local _shape_set_axis(axis: number, field: Widget) {
    if not _shape_available() {
        return
    }
    parsed: Option[number] = String.to_integer(field.text())
    if not parsed.has() {
        field.set_text_colour(Color.rgb(255, 0, 0))
        return
    }
    set: string = _state_current_set()
    x: number = _origin_piece(set, 0)
    y: number = _origin_piece(set, 1)
    z: number = _origin_piece(set, 2)
    if axis == 0 {
        x = parsed.unwrap()
    } else if axis == 1 {
        y = parsed.unwrap()
    } else {
        z = parsed.unwrap()
    }
    state = _state_with_set(state, _state_index(), _set_with_field(set, "origin", _origin_text(x, y, z)))
    field.set_text_colour(Color.rgb(255, 255, 255))
}

# The property pool's own routing: the first row and slot the pressed widget belongs to is applied.
# A hidden widget is never pressed, so only the current shape's rows can answer.

local _shape_prop_changed(widget: Widget) {
    row: number = 0
    while row < 8 {
        slot: number = 0
        while slot < 8 {
            if equals(widget, _prop_widget(row, slot)) {
                _prop_apply(row, slot)
                return
            }
            slot = slot + 1
        }
        row = row + 1
    }
}

# One slot's press: the decrease and increase buttons step, Set parses its field, the checkbox
# writes what it now shows, the arrows step the enum, and the wide button runs its runnable. A text
# field's own edit does nothing, because every property class reads the field only when Set is
# pressed.

local _prop_apply(row: number, slot: number) {
    if slot == 0 {
        _prop_dec(row)
        return
    }
    if slot == 1 {
        return
    }
    if slot == 2 {
        _prop_set(row)
        return
    }
    if slot == 3 {
        _prop_inc(row)
        return
    }
    if slot == 4 {
        _prop_bool(row, _prop_widget(row, 4).checked())
        return
    }
    if slot == 5 {
        _prop_enum(row, -1)
        return
    }
    if slot == 6 {
        _prop_enum(row, 1)
        return
    }
    _prop_run()
}

# PropertyInt, NonzeroInt, MinimumInt, PositiveInt, Float, NonzeroFloat, MinimumFloat and
# PositiveFloat minus one: a step the class refuses leaves the value and the field untouched.

local _prop_dec(row: number) {
    stepped: string = _prop_stepped(_prop_kind(row), _prop_text(row), -1)
    if String.length(stepped) == 0 {
        return
    }
    _prop_store(row, stepped)
    _prop_show_text(row, stepped)
}

local _prop_inc(row: number) {
    stepped: string = _prop_stepped(_prop_kind(row), _prop_text(row), 1)
    if String.length(stepped) == 0 {
        return
    }
    _prop_store(row, stepped)
    _prop_show_text(row, stepped)
}

# One step of a property's value, or "" where the class refuses it. The step is refused when the value
# it would land on is one the class's setValueFromString refuses, so a player cannot step a shape to
# a value a reload would replace with the default: a MinimumInt of 4 keeps its 4 rather than stepping
# to the 3 that a reload refuses, and a MinimumFloat of 3.0 keeps its 3.0 rather than stepping to 2.0.
# The zero skip a nonzero value has stays, because the reference's own buttons step past zero.

local _prop_stepped(kind: string, text: string, delta: number) string {
    letter: string = String.substring(kind, 0, 1)
    if letter == "i" or letter == "I" or letter == "N" or letter == "M" {
        parsed: Option[number] = String.to_integer(text)
        if not parsed.has() {
            return ""
        }
        value: number = parsed.unwrap() + delta
        if letter == "N" and value == 0 {
            if delta < 0 {
                value = -1
            } else {
                value = 1
            }
        }
        return _kind_value(kind, String.from_number(value))
    }
    parsed_float: Option[number] = String.to_float(text)
    if not parsed_float.has() {
        return ""
    }
    value_float: number = parsed_float.unwrap() + delta
    if letter == "n" and value_float == 0 {
        if delta < 0 {
            value_float = -1.0
        } else {
            value_float = 1.0
        }
    }
    return _kind_value(kind, String.from_float(value_float))
}

# A property's Set button: the class's own acceptance rule from _kind_value, its red field on a
# refusal, and the zero skip a nonzero value has, where the field is rewritten with the value it kept.
# The rule is the loader's, so a typed boundary the class's setValueFromString refuses turns the field
# red instead of storing a value the next load would replace with the defaults.

local _prop_set(row: number) {
    kind: string = _prop_kind(row)
    field: Widget = _prop_widget(row, 1)
    accepted: string = _prop_accepted(kind, field.text())
    if String.length(accepted) == 0 {
        field.set_text_colour(Color.rgb(255, 0, 0))
        return
    }
    if _prop_zero_typed(kind, field.text()) {
        field.set_text(accepted)
    }
    _prop_store(row, accepted)
    field.set_text_colour(Color.rgb(255, 255, 255))
}

# The class's own text for a typed value, or "" where it refuses it. A nonzero class's Set button
# writes 1 for a typed zero rather than refusing it, which is what the reference's button does.

local _prop_accepted(kind: string, raw: string) string {
    canonical: string = _kind_value(kind, raw)
    if String.length(canonical) > 0 {
        return canonical
    }
    if _prop_zero_typed(kind, raw) {
        if String.substring(kind, 0, 1) == "N" {
            return "1"
        }
        return "1.0"
    }
    return ""
}

# Whether the text is a zero typed into a nonzero class's field, which its Set button rewrites to 1.

local _prop_zero_typed(kind: string, raw: string) bool {
    letter: string = String.substring(kind, 0, 1)
    if letter == "N" {
        parsed: Option[number] = String.to_integer(raw)
        if parsed.has() {
            return parsed.unwrap() == 0
        }
        return false
    }
    if letter == "n" {
        parsed_float: Option[number] = String.to_float(raw)
        if parsed_float.has() {
            return parsed_float.unwrap() == 0
        }
    }
    return false
}

local _prop_bool(row: number, checked: bool) {
    _prop_store(row, _bool_text(checked))
}

# PropertyEnum's two arrows: Math.floorMod around the enum's constants, and the value the state
# holds is the constant's name, so the file keeps the reference's own words.

local _prop_enum(row: number, delta: number) {
    kind: string = _prop_kind(row)
    names: string = String.substring(kind, 2, String.length(kind))
    count: number = _split_count(names, ",")
    index: number = _enum_index(kind, _prop_text(row))
    next: number = index + delta
    if next < 0 {
        next = count - 1
    }
    if next >= count {
        next = 0
    }
    _prop_store(row, _piece(names, ",", next))
}

# Set endpoint, the one runnable property the registry has: the deltas become the player's feet
# minus the current set's origin, and the three fields above the button are rewritten.

local _prop_run() {
    id: number = _shape_current_id()
    if id != 0 and id != 8 {
        return
    }
    set: string = _state_current_set()
    ox: number = _origin_piece(set, 0)
    oy: number = _origin_piece(set, 1)
    oz: number = _origin_piece(set, 2)
    values: string = _shape_values_now()
    values = _value_replace(values, 0, String.from_number(Math.floor(world_x) - ox))
    values = _value_replace(values, 1, String.from_number(Math.floor(world_y) - oy))
    values = _value_replace(values, 2, String.from_number(Math.floor(world_z) - oz))
    _prop_store_all(values)
    _prop_show_text(0, _piece(values, ",", 0))
    _prop_show_text(1, _piece(values, ",", 1))
    _prop_show_text(2, _piece(values, ",", 2))
}

# One property of the current shape: its kind, as a values piece, and the piece itself.

local _prop_kind(row: number) string {
    id: number = _shape_current_id()
    if id < 0 {
        return ""
    }
    return _piece(_shape_kinds(id), ";", row)
}

local _prop_text(row: number) string {
    return _piece(_shape_values_now(), ",", row)
}

# One property's new text, written into the current set's entry for the current shape. Writing a
# property regenerates the shape on the next frame, which is why no update call is needed and why
# the entry's error marker is cleared: the reference's update runs on every setValue too.

local _prop_store(row: number, text: string) {
    id: number = _shape_current_id()
    if id < 0 {
        return
    }
    set: string = _state_current_set()
    values: string = _shape_values_now()
    state = _state_with_set(state, _state_index(), _set_put_shape(set, id, _value_replace(values, row, text), false))
}

local _prop_store_all(values: string) {
    id: number = _shape_current_id()
    if id < 0 {
        return
    }
    set: string = _state_current_set()
    state = _state_with_set(state, _state_index(), _set_put_shape(set, id, values, false))
}

local _prop_show_text(row: number, text: string) {
    field: Widget = _prop_widget(row, 1)
    field.set_text(text)
    field.set_text_colour(Color.rgb(255, 255, 255))
}

# The registry index of the current set's shape, or -1 with no set to hold one. A set's index is
# clamped into the registry at load, so a value outside it is a stopped load (#1816) and is refused
# here as well.

local _shape_current_id() number {
    if _state_set_count() == 0 {
        return -1
    }
    set: string = _state_current_set()
    if String.length(set) == 0 {
        return -1
    }
    id: number = _set_int(set, "index", 0)
    if id < 0 or id >= _shape_count() {
        return -1
    }
    return id
}

# The current shape's values as the file would hold them. ShapeSet.getShape creates a shape at its
# defaults when the set has none, so an absent entry answers the class's defaults without being
# written; a property change writes an entry.

local _shape_values_now() string {
    id: number = _shape_current_id()
    if id < 0 {
        return ""
    }
    set: string = _state_current_set()
    values: string = _set_shape_values(set, id)
    if String.length(values) == 0 {
        values = _shape_defaults(id)
    }
    return values
}

# State.isShapeAvailable as this screen needs it: a set exists and its shape is one the registry
# has, which is when the origin rows and the property panel are usable.

local _shape_available() bool {
    return _shape_current_id() >= 0
}

# The property names of each shape, in the class's own row order. The translatable keys of the
# reference resolve to these en_us sentences, with the delta, axis, step, offset, semi-axis and
# half-width ones filled with their axis letter.

local _shape_labels(id: number) string {
    if id == 0 {
        return "Delta X|Delta Y|Delta Z|Set endpoint|Additional length|Invert"
    }
    if id == 1 {
        return "Direction|Radius|Depth|Even mode"
    }
    if id == 2 {
        return "Direction|Radius|Height|Even mode"
    }
    if id == 3 {
        return "X|Y|Z|Walls|Centered origin"
    }
    if id == 4 {
        return "Direction|Y semi-axis|Z semi-axis|Depth|Even mode"
    }
    if id == 5 {
        return "X semi-axis|Y semi-axis|Z semi-axis|Dome|Even mode"
    }
    if id == 6 {
        return "X steps|Y steps|Z steps|X offset|Y offset|Z offset"
    }
    if id == 7 {
        return "Direction|Outer radius|Inner radius|Height|Degrees|Degrees offset|Invert|Even mode"
    }
    if id == 8 {
        return "Delta X|Delta Y|Delta Z|Set endpoint"
    }
    if id == 9 {
        return "Direction|Rotation|Half-width|Height|Depth|Even mode"
    }
    if id == 10 {
        return "Direction|Y half-width|Z half-width|Height|Even mode"
    }
    if id == 11 {
        return "Sides|Radius|Direction|Rotation|Depth|Even mode"
    }
    if id == 12 {
        return "Sides|Radius|Direction|Rotation|Height|Even mode"
    }
    if id == 13 {
        return "Radius|Dome|Even mode"
    }
    return "Direction|Outer radius|Inner radius|Outer even mode|Inner even mode"
}

# The ordinal a stored enum constant has among its kind's names, which is its Java ordinal.

local _enum_index(kind: string, text: string) number {
    names: string = String.substring(kind, 2, String.length(kind))
    count: number = _split_count(names, ",")
    i: number = 0
    while i < count {
        if _piece(names, ",", i) == text {
            return i
        }
        i = i + 1
    }
    return 0
}

# PropertyEnum.render's value text: the reference's own hardcoded labels for the four enums, by
# ordinal. The direction labels are the axis names, the walls labels spell the shape's name, the
# dome's are signed axes, and the rotation's are degrees.

local _enum_display(kind: string, ordinal: number) string {
    labels: string = "X;Y;Z"
    if _has_prefix(kind, "e:ALL") {
        labels = "XYZ;X;Y;Z;XY;XZ;YZ;-"
    } else if _has_prefix(kind, "e:NO") {
        labels = "-;+X;+Y;+Z;-X;-Y;-Z"
    } else if _has_prefix(kind, "e:ROT") {
        labels = "0°;90°;180°;270°"
    }
    return _piece(labels, ";", ordinal)
}

# One property row's widget by slot: a decrease button, text field, Set button, increase button, a
# checkbox, an enum's left and right arrows, and a runnable's wide button.

local _prop_widget(row: number, slot: number) Widget {
    if row == 0 {
        if slot == 0 {
            return p0a.unwrap()
        }
        if slot == 1 {
            return p0b.unwrap()
        }
        if slot == 2 {
            return p0c.unwrap()
        }
        if slot == 3 {
            return p0d.unwrap()
        }
        if slot == 4 {
            return p0e.unwrap()
        }
        if slot == 5 {
            return p0f.unwrap()
        }
        if slot == 6 {
            return p0g.unwrap()
        }
        if slot == 7 {
            return p0h.unwrap()
        }
        return p0h.unwrap()
    }
    if row == 1 {
        if slot == 0 {
            return p1a.unwrap()
        }
        if slot == 1 {
            return p1b.unwrap()
        }
        if slot == 2 {
            return p1c.unwrap()
        }
        if slot == 3 {
            return p1d.unwrap()
        }
        if slot == 4 {
            return p1e.unwrap()
        }
        if slot == 5 {
            return p1f.unwrap()
        }
        if slot == 6 {
            return p1g.unwrap()
        }
        if slot == 7 {
            return p1h.unwrap()
        }
        return p1h.unwrap()
    }
    if row == 2 {
        if slot == 0 {
            return p2a.unwrap()
        }
        if slot == 1 {
            return p2b.unwrap()
        }
        if slot == 2 {
            return p2c.unwrap()
        }
        if slot == 3 {
            return p2d.unwrap()
        }
        if slot == 4 {
            return p2e.unwrap()
        }
        if slot == 5 {
            return p2f.unwrap()
        }
        if slot == 6 {
            return p2g.unwrap()
        }
        if slot == 7 {
            return p2h.unwrap()
        }
        return p2h.unwrap()
    }
    if row == 3 {
        if slot == 0 {
            return p3a.unwrap()
        }
        if slot == 1 {
            return p3b.unwrap()
        }
        if slot == 2 {
            return p3c.unwrap()
        }
        if slot == 3 {
            return p3d.unwrap()
        }
        if slot == 4 {
            return p3e.unwrap()
        }
        if slot == 5 {
            return p3f.unwrap()
        }
        if slot == 6 {
            return p3g.unwrap()
        }
        if slot == 7 {
            return p3h.unwrap()
        }
        return p3h.unwrap()
    }
    if row == 4 {
        if slot == 0 {
            return p4a.unwrap()
        }
        if slot == 1 {
            return p4b.unwrap()
        }
        if slot == 2 {
            return p4c.unwrap()
        }
        if slot == 3 {
            return p4d.unwrap()
        }
        if slot == 4 {
            return p4e.unwrap()
        }
        if slot == 5 {
            return p4f.unwrap()
        }
        if slot == 6 {
            return p4g.unwrap()
        }
        if slot == 7 {
            return p4h.unwrap()
        }
        return p4h.unwrap()
    }
    if row == 5 {
        if slot == 0 {
            return p5a.unwrap()
        }
        if slot == 1 {
            return p5b.unwrap()
        }
        if slot == 2 {
            return p5c.unwrap()
        }
        if slot == 3 {
            return p5d.unwrap()
        }
        if slot == 4 {
            return p5e.unwrap()
        }
        if slot == 5 {
            return p5f.unwrap()
        }
        if slot == 6 {
            return p5g.unwrap()
        }
        if slot == 7 {
            return p5h.unwrap()
        }
        return p5h.unwrap()
    }
    if row == 6 {
        if slot == 0 {
            return p6a.unwrap()
        }
        if slot == 1 {
            return p6b.unwrap()
        }
        if slot == 2 {
            return p6c.unwrap()
        }
        if slot == 3 {
            return p6d.unwrap()
        }
        if slot == 4 {
            return p6e.unwrap()
        }
        if slot == 5 {
            return p6f.unwrap()
        }
        if slot == 6 {
            return p6g.unwrap()
        }
        if slot == 7 {
            return p6h.unwrap()
        }
        return p6h.unwrap()
    }
    if row == 7 {
        if slot == 0 {
            return p7a.unwrap()
        }
        if slot == 1 {
            return p7b.unwrap()
        }
        if slot == 2 {
            return p7c.unwrap()
        }
        if slot == 3 {
            return p7d.unwrap()
        }
        if slot == 4 {
            return p7e.unwrap()
        }
        if slot == 5 {
            return p7f.unwrap()
        }
        if slot == 6 {
            return p7g.unwrap()
        }
        if slot == 7 {
            return p7h.unwrap()
        }
        return p7h.unwrap()
    }
    return p7h.unwrap()
}

# ---------------------------------------------------------------- the two dropdowns

# DropdownOverlayScreen is a screen shown over its parent, with its own chrome, close button and tab
# states, and the host's Screen cannot hold a second one, so the fallback #1760 leaves is the same
# list inside the parent: the V hides itself, the X and the list take its place, and the parent's own
# widgets and texts go away while it is up. A row or the X puts them back.

local _dropdown_open() {
    dropdown_open = true
    _dropdown_visible()
}

local _dropdown_close() {
    dropdown_open = false
    _dropdown_visible()
}

# The parent's callback: setShape on the Shape tab, which starts a shape it has not built yet at its
# defaults and leaves one it has at the values it holds, and setIShapeNew on the Shape list tab,
# which changes the shape the Add button will push.

local _dropdown_pick(index: number) {
    if index < 0 {
        return
    }
    if active_screen == "shape" {
        _shape_choose(index)
        return
    }
    state = _state_with_field(state, "iShapeNew", String.from_number(index))
    _dropdown_close()
}

local _shape_choose(id: number) {
    if _state_set_count() > 0 {
        set: string = _state_current_set()
        values: string = _set_shape_values(set, id)
        if String.length(values) == 0 {
            values = _shape_defaults(id)
        }
        set = _set_put_shape(set, id, values, false)
        set = _set_with_field(set, "index", String.from_number(id))
        state = _state_with_set(state, _state_index(), set)
    }
    _dropdown_close()
}

local _dropdown_visible() {
    if active_screen == "shapelist" {
        _shapelist_dropdown_visible()
        return
    }
    _shape_dropdown_visible()
}

local _shape_dropdown_visible() {
    q_open.unwrap().set_visible(not dropdown_open)
    q_close.unwrap().set_visible(dropdown_open)
    q_list.unwrap().set_visible(dropdown_open)
    _shape_active(_shape_available())
    if dropdown_open {
        _shape_parent_visible(false)
        _shape_hide_rows()
        _dropdown_rows()
        return
    }
    _shape_parent_visible(true)
    _shape_relayout()
    _shape_fields()
}

local _shapelist_dropdown_visible() {
    n_open.unwrap().set_visible(not dropdown_open)
    n_close.unwrap().set_visible(dropdown_open)
    n_list.unwrap().set_visible(dropdown_open)
    _shapelist_active()
    if dropdown_open {
        _shapelist_parent_visible(false)
        _dropdown_rows()
        return
    }
    _shapelist_parent_visible(true)
    _shapelist_rows()
    _shapelist_fields()
}

# The list's fifteen rows are the registry's shape names in registration order, and it starts on
# the shape the parent would draw at (85, 75): the current set's on the Shape tab, the new set's on
# the Shape list tab.

local _dropdown_rows() {
    if active_screen == "shapelist" {
        list: Widget = n_list.unwrap()
        current: number = _new_shape_index()
        list.set_rows(_shape_count())
        if current >= 0 {
            list.select(current)
        }
        return
    }
    list: Widget = q_list.unwrap()
    current: number = _shape_current_id()
    list.set_rows(_shape_count())
    if current >= 0 {
        list.select(current)
    }
}

local _dropdown_row(ctx: ListRowResponse, list: Widget) {
    if not equals(ctx.widget(), list) {
        return
    }
    ctx.set_text(_shape_name(ctx.index()))
}

# The rows of the property panel are already the relayout's to show, so the dropdown hides them all
# and the relayout brings back the current shape's. Everything else is the parent's own.

local _shape_hide_rows() {
    row: number = 0
    while row < 8 {
        _shape_row_hide(row)
        row = row + 1
    }
}

local _shape_parent_visible(visible: bool) {
    o_set.unwrap().set_visible(visible)
    o_x_dec.unwrap().set_visible(visible)
    o_x_field.unwrap().set_visible(visible)
    o_x_set.unwrap().set_visible(visible)
    o_x_inc.unwrap().set_visible(visible)
    o_y_dec.unwrap().set_visible(visible)
    o_y_field.unwrap().set_visible(visible)
    o_y_set.unwrap().set_visible(visible)
    o_y_inc.unwrap().set_visible(visible)
    o_z_dec.unwrap().set_visible(visible)
    o_z_field.unwrap().set_visible(visible)
    o_z_set.unwrap().set_visible(visible)
    o_z_inc.unwrap().set_visible(visible)
}

local _shapelist_parent_visible(visible: bool) {
    s_add.unwrap().set_visible(visible)
    s_visible.unwrap().set_visible(visible)
    s_delete.unwrap().set_visible(visible)
    s_global.unwrap().set_visible(visible)
    s_x_dec.unwrap().set_visible(visible)
    s_x_field.unwrap().set_visible(visible)
    s_x_set.unwrap().set_visible(visible)
    s_x_inc.unwrap().set_visible(visible)
    s_y_dec.unwrap().set_visible(visible)
    s_y_field.unwrap().set_visible(visible)
    s_y_set.unwrap().set_visible(visible)
    s_y_inc.unwrap().set_visible(visible)
    s_z_dec.unwrap().set_visible(visible)
    s_z_field.unwrap().set_visible(visible)
    s_z_set.unwrap().set_visible(visible)
    s_z_inc.unwrap().set_visible(visible)
    s_list.unwrap().set_visible(visible)
}
