p0h: Option[Widget] = Option.new()
p1a: Option[Widget] = Option.new()
p1b: Option[Widget] = Option.new()
p1c: Option[Widget] = Option.new()
p1d: Option[Widget] = Option.new()
p1e: Option[Widget] = Option.new()
p1f: Option[Widget] = Option.new()
p1g: Option[Widget] = Option.new()
p1h: Option[Widget] = Option.new()
p2a: Option[Widget] = Option.new()
p2b: Option[Widget] = Option.new()
p2c: Option[Widget] = Option.new()
p2d: Option[Widget] = Option.new()
p2e: Option[Widget] = Option.new()
p2f: Option[Widget] = Option.new()
p2g: Option[Widget] = Option.new()
p2h: Option[Widget] = Option.new()
p3a: Option[Widget] = Option.new()
p3b: Option[Widget] = Option.new()
p3c: Option[Widget] = Option.new()
p3d: Option[Widget] = Option.new()
p3e: Option[Widget] = Option.new()
p3f: Option[Widget] = Option.new()
p3g: Option[Widget] = Option.new()
p3h: Option[Widget] = Option.new()
p4a: Option[Widget] = Option.new()
p4b: Option[Widget] = Option.new()
p4c: Option[Widget] = Option.new()
p4d: Option[Widget] = Option.new()
p4e: Option[Widget] = Option.new()
p4f: Option[Widget] = Option.new()
p4g: Option[Widget] = Option.new()
p4h: Option[Widget] = Option.new()
p5a: Option[Widget] = Option.new()
p5b: Option[Widget] = Option.new()
p5c: Option[Widget] = Option.new()
p5d: Option[Widget] = Option.new()
p5e: Option[Widget] = Option.new()
