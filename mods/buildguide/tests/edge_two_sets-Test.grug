# Two Circle sets with their own origins and colours, captured in the world: the first is the
# reset's fresh Circle twelve blocks ahead, coloured red, and the second was appended by the Shape
# list's Add six blocks right of the first and also twelve blocks ahead, coloured green. The wider
# crop is what lets both fit. A guide that draws only the current set, or one colour for every set,
# fails here, which no single-set capture can show.
step: number = 0
waited: number = 0
shifts: number = 0
ox: number = 0
oy: number = 0
oz: number = 0

export init(ctx: TestInitContext) {
    # The reset's sixteen deletes and the capture's own steps add more one-click ticks than the
    # default 200 allows on the game's slower legs; every wait is condition-bounded.
    ctx.set_max_ticks(400)
}

export tick(ctx: TestTickContext) {
    if step == 0 {
        # W1: a world capture runs at GUI scale 1, where every widget sits at its stated GUI
        # coordinate and the shape list's fifteen dropdown rows all fit the 720-pixel window. The
        # runner snapped the player to the block centre, so floor() of the feet is the block the
        # player stands in, which is the row a fresh set's origin lands on.
        if not me.owned_screens_supported() or not me.world_overlay_supported() or me.on_dedicated_server() {
            return
        }
        ctx.set_gui_scale(1)
        ctx.set_box_radius(13)
        if not ctx.world_settled() {
            waited = waited + 1
            ctx.assert(waited < 200, "The world should settle before the capture builds its set.")
            ctx.not_done()
            return
        }
        waited = 0
        feet: Vec3 = ctx.get_player().position()
        ox = Math.floor(feet.x())
        oy = Math.floor(feet.y())
        oz = Math.floor(feet.z())
        step = 1
        ctx.not_done()
        return
    }

    if step == 1 {
        # W2: the port's about.json declares its open on B, so its run presses the world key,
        # while the reference's opener is a Forge KeyMapping that only the game's own key handling
        # reaches.
        _open(ctx)
        step = 2
        ctx.not_done()
        return
    }

    if step == 2 {
        # W3: the screen has to be open and drawn before its tabs can be clicked.
        if not ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "The B binding should open Build Guide's screen.")
            ctx.not_done()
            return
        }
        if not ctx.overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "The screen should draw a frame.")
            ctx.not_done()
            return
        }
        waited = 0
        ctx.assert(ctx.screen_width() == 1280, "GUI scale 1 should give a 1280-pixel window.")
        step = 3
        ctx.not_done()
        return
    }

    if step == 3 {
        # W4: the reset happens on the Shape list tab, which holds the dropdown, Delete and Add.
        ctx.click_screen(315, 40, 0)
        step = 4
        ctx.not_done()
        return
    }

    if step == 4 {
        if not ctx.overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "The Shape list tab should draw a frame.")
            ctx.not_done()
            return
        }
        waited = 0
        step = 5
        ctx.not_done()
        return
    }

    if step == 5 {
        # The dropdown's V is at (145, 70), 20 by 20. The list is the child screen
        # Screen.open_over draws over this one: it starts at (5, 90), is 160 wide, and its
        # 20-pixel rows are clicked at 100 + 20*i. The pick writes iShapeNew, so Add appends that
        # shape at its registry defaults.
        ctx.click_screen(155, 80, 0)
        step = 6
        ctx.not_done()
        return
    }

    if step == 6 {
        # Dropdown row 1.
        ctx.click_screen(85, 120, 0)
        step = 7
        ctx.not_done()
        return
    }

    if step == 7 {
        # Delete at (5, 155), 160 wide, removes the current set; sixteen clicks leave no set even
        # if the run arrived with several, and a click past the last set does nothing.
        ctx.click_screen(85, 165, 0)
        shifts = shifts + 1
        if shifts < 16 {
            ctx.not_done()
            return
        }
        shifts = 0
        step = 8
        ctx.not_done()
        return
    }

    if step == 8 {
        # Add at (5, 90), 160 wide and 20 high, appends iShapeNew at the player's feet and selects
        # it.
        ctx.click_screen(85, 100, 0)
        step = 9
        ctx.not_done()
        return
    }

    if step == 9 {
        # W5: the Shape tab is where the set's origin row and its property panel are.
        ctx.click_screen(65, 40, 0)
        step = 10
        ctx.not_done()
        return
    }

    if step == 10 {
        if not ctx.overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "The Shape tab should draw a frame.")
            ctx.not_done()
            return
        }
        waited = 0
        step = 11
        ctx.not_done()
        return
    }

    if step == 11 {
        # W6: the origin Z row's + at (145, 175), 20 by 20, shifts the set one block ahead; 12
        # clicks put the origin at oz + 12, the block the player's yaw 0 faces.
        ctx.click_screen(155, 185, 0)
        shifts = shifts + 1
        if shifts < 12 {
            ctx.not_done()
            return
        }
        shifts = 0
        step = 12
        ctx.not_done()
        return
    }

    if step == 12 {
        # W7: the Visualization tab, where the first set's shape colour loses its green and its
        # blue, leaving it red.
        ctx.click_screen(190, 40, 0)
        step = 13
        ctx.not_done()
        return
    }

    if step == 13 {
        # The shape G slider is the 120-wide track at (5, 90), and (9, 100) is its left end, 0.0.
        ctx.click_screen(9, 100, 0)
        step = 14
        ctx.not_done()
        return
    }

    if step == 14 {
        # The shape B slider is the track at (5, 110), and (9, 120) is its left end.
        ctx.click_screen(9, 120, 0)
        step = 15
        ctx.not_done()
        return
    }

    if step == 15 {
        # Set shape colour at (5, 150), 120 wide, writes the sliders onto the current set.
        ctx.click_screen(65, 160, 0)
        step = 16
        ctx.not_done()
        return
    }

    if step == 16 {
        # A second Circle is appended on the Shape list tab, whose Add puts it at the player's
        # feet and selects it.
        ctx.click_screen(315, 40, 0)
        step = 17
        ctx.not_done()
        return
    }

    if step == 17 {
        # Add at (5, 90), 160 wide.
        ctx.click_screen(85, 100, 0)
        step = 18
        ctx.not_done()
        return
    }

    if step == 18 {
        # The Shape tab edits only the current set, which is the one Add just appended.
        ctx.click_screen(65, 40, 0)
        step = 19
        ctx.not_done()
        return
    }

    if step == 19 {
        # The X row's + at (145, 135), 20 by 20, six times, so the second set is six blocks right
        # of the first.
        ctx.click_screen(155, 145, 0)
        shifts = shifts + 1
        if shifts < 6 {
            ctx.not_done()
            return
        }
        shifts = 0
        step = 20
        ctx.not_done()
        return
    }

    if step == 20 {
        # The Z row's + at (145, 175) twelve times, so the second set is also at oz + 12, level
        # with the first one's shifted origin.
        ctx.click_screen(155, 185, 0)
        shifts = shifts + 1
        if shifts < 12 {
            ctx.not_done()
            return
        }
        shifts = 0
        step = 21
        ctx.not_done()
        return
    }

    if step == 21 {
        # The second set's colour is green, so the two sets cannot be told apart by one colour.
        ctx.click_screen(190, 40, 0)
        step = 22
        ctx.not_done()
        return
    }

    if step == 22 {
        # The shape R slider at (5, 70) is clicked at its left end, and so is the shape B slider
        # at (5, 110), which leaves the second set green.
        ctx.click_screen(9, 80, 0)
        step = 23
        ctx.not_done()
        return
    }

    if step == 23 {
        # The shape B slider's left end.
        ctx.click_screen(9, 120, 0)
        step = 24
        ctx.not_done()
        return
    }

    if step == 24 {
        # Set shape colour writes the second set's green.
        ctx.click_screen(65, 160, 0)
        step = 25
        ctx.not_done()
        return
    }

    if step == 25 {
        # W8: the enable box at (5, 5), 20 by 20, is off at the start of every test, so one click
        # turns the guide on for the capture.
        ctx.click_screen(15, 15, 0)
        step = 26
        ctx.not_done()
        return
    }

    if step == 26 {
        ctx.press_screen_key(256, false, false, true)
        step = 27
        ctx.not_done()
        return
    }

    if step == 27 {
        # The reference fades a completed set from green to white for one second, so the stall
        # waits that duration out rather than pinning a colour that depends on timing. The port
        # generates in the drawing frame, so for it the stall only costs time.
        ctx.stall(1200)
        step = 28
        ctx.not_done()
        return
    }

    if step == 28 {
        # The close lands on a later tick than the press.
        if ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "Escape should close the screen with the capture's set.")
            ctx.not_done()
            return
        }
        waited = 0
        step = 29
        ctx.not_done()
        return
    }

    if step == 29 {
        if not ctx.world_settled() {
            waited = waited + 1
            ctx.assert(waited < 200, "The world should settle with the screen closed.")
            ctx.not_done()
            return
        }
        waited = 0
        step = 30
        ctx.not_done()
        return
    }

    if step == 30 {
        if not ctx.world_overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "The world should draw the enabled guide in a frame.")
            ctx.not_done()
            return
        }
        waited = 0
        step = 31
        ctx.not_done()
        return
    }

    if step == 31 {
        # W9: a 600 by 480 crop (340, 120, 940, 600) around the crosshair, wider than the default.
        ctx.screenshot().equals(r"screenshots/edge_two_sets", 340, 120, 940, 600)
        step = 32
        ctx.not_done()
        return
    }

    if step == 32 {
        # W10: put the run back the way it was found, with the guide off.
        _open(ctx)
        step = 33
        ctx.not_done()
        return
    }

    if step == 33 {
        if not ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "The binding should reopen the screen to turn the guide off.")
            ctx.not_done()
            return
        }
        if not ctx.overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "The reopened screen should draw a frame.")
            ctx.not_done()
            return
        }
        waited = 0
        step = 34
        ctx.not_done()
        return
    }

    if step == 34 {
        ctx.click_screen(15, 15, 0)
        step = 35
        ctx.not_done()
        return
    }

    if step == 35 {
        ctx.press_screen_key(256, false, false, true)
        step = 36
        ctx.not_done()
        return
    }

    if step == 36 {
        if ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "Escape should close the screen after the capture.")
            ctx.not_done()
            return
        }
    }
}

# Opens the screen: the port's open is on B, so its run presses the world key, while the
# reference's opener is a Forge KeyMapping that only the game's own key handling reaches.

local _open(ctx: TestTickContext) {
    if me.is_reference() {
        ctx.press_game_key(66)
        return
    }
    ctx.press_world_key(66, false)
}
