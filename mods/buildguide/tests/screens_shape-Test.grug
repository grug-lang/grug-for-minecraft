            ctx.assert(presses < 8, "Escape should close the Shape screen after the huge torus.")
            ctx.press_screen_key(256, false, false, true)
            ctx.not_done()
            return
        }
        presses = 0
        state: string = _saved_state(ctx)
        ctx.assert(_reloaded_shape_values(_set_line(state, _current_index(state)), "brentmaas.buildguide.common.shape.ShapeTorus") == "X,10000.0,3.0,false,false", "A Torus outer radius of 10000 should be kept, and the set should still load with it.")
        step = 116
        ctx.press_world_key(72, false)
        ctx.not_done()
