# The Shape tab of #1752's screens: the shape row adds a set so the tab starts from a known shape,
# then its origin row shifts that set and its Set button takes the field beside it, and its property
# panel steps a float, wraps an enum, toggles a checkbox and refuses a field it cannot parse, and
# its Radius field takes a typed 1e20 and the screen's next frame still draws, because the shape's
# box is too large to generate and draws no cells rather than stalling the frame. Next, the M and I
# boundaries are typed and stepped into, and the saved line proves neither was stored where a load
# would refuse it. Last, the overlay is turned on and each shape takes an oversize value in turn
# (a Circle and a Torus of radius 10000, a Sphere and an Ellipsoid of 1e20, and a Circle of
# Infinity); the world mark after each proves the frame drew the stalled set's origin cube, and the
# saved line proves the value survives a reload and that the set's transient generation state never
# reaches the file. A Catenary whose first solve leaves the finite range then takes the reference's
# error arm: the screen and the frame keep running, both the stalled and the errored set answer their
# shape list row without breaking a row rule, and the value is saved. The 0 counts and the indicator
# glyph while generating, the red error colour and the green to white fade are drawn pixels that no
# test entry reads, so the capture suite is their only proof and this test claims none of them.
# Every proof is read back from the saved state, because the widgets and their positions are the
# host's and no test entry reads their pixels; a click a hidden or missing widget ignored therefore
# shows up as a value the state did not take.
# The added set is the state's new-set shape, a circle, whose panel rows are Direction, Radius,
# Depth and Even mode at y 70, 90, 110 and 130.
# Persistence is turned on for the saves and put back as the run found it, so a later test sees the
# config it would have seen.
step: number = 0
waited: number = 0
presses: number = 0
was_persistent: bool = false
start_origin_x: number = 0
start_count: number = 0
rows_before: number = 0

export init(ctx: TestInitContext) {
    # The tab switch and the four oversize shapes add enough one-click ticks that the default 200 is
    # a tight bound on the game's slower legs; the waits themselves are condition-bounded.
    ctx.set_max_ticks(400)
}

export tick(ctx: TestTickContext) {
    if step == 0 {
        if not me.owned_screens_supported() or not me.world_overlay_supported() or me.on_dedicated_server() {
            return
        }
        if not ctx.world_settled() {
            ctx.not_done()
            return
        }
        step = 1
        ctx.press_world_key(66, false)
        ctx.not_done()
        return
    }

    if step == 1 {
        if not ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "The B binding should open Build Guide's screen.")
            ctx.not_done()
            return
        }
        if not ctx.overlay_drawn() {
            ctx.not_done()
            return
        }
        waited = 0
        # The mod writes its config in its first world frame. The game runs that frame before this
        # test's first tick, and the smoketest runs it after the tick that pressed the key, so the
        # file is read at the first screen frame, when both have written it.
        files: File = File.open(r"files")
        config: Option[string] = files.read_text("config/buildguide.cfg")
        ctx.assert(config.has(), "The mod should have written its config file by the first screen frame.")
        was_persistent = String.index_of(config.unwrap(), "persistenceEnabled = true") >= 0
        # The Configuration tab is the fourth chrome button; the window is narrow enough at the CI
        # client's scale that its last pixels are cut off, so its visible part is clicked.
        width: number = ctx.screen_width()
        tab_x: number = 416
        if width - 10 < tab_x {
            tab_x = width - 10
        }
        ctx.click_screen(tab_x, 40, 0)
        step = 2
        ctx.not_done()
        return
    }

    if step == 2 {
        if not ctx.overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "The Configuration tab should draw a frame.")
            ctx.not_done()
            return
        }
        waited = 0
        if was_persistent {
            step = 4
            ctx.not_done()
            return
        }
        # The persistence checkbox is ConfigurationScreen's third box, at (255, 160).
        ctx.click_screen(262, 168, 0)
        step = 3
        ctx.not_done()
        return
    }

    if step == 3 {
        files: File = File.open(r"files")
        config: Option[string] = files.read_text("config/buildguide.cfg")
        ctx.assert(config.has(), "Ticking persistence should leave the config file readable.")
        ctx.assert(String.index_of(config.unwrap(), "persistenceEnabled = true") >= 0, "Ticking persistence should write its value.")
        step = 4
        ctx.not_done()
        return
    }

    if step == 4 {
        ctx.press_screen_key(256, false, false, true)
        step = 5
        ctx.not_done()
        return
    }

    if step == 5 {
        if ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "Escape should close the screen.")
            ctx.not_done()
            return
        }
        waited = 0
        step = 6
        ctx.press_world_key(66, false)
        ctx.not_done()
        return
    }

    if step == 6 {
        if not ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "The binding should reopen the screen.")
            ctx.not_done()
            return
        }
        if not ctx.overlay_drawn() {
            ctx.not_done()
            return
        }
        waited = 0
        # The Shape list tab is the third chrome button, at x 255 to 375 and y 30 to 50.
        ctx.click_screen(265, 40, 0)
        step = 7
        ctx.not_done()
        return
    }

    if step == 7 {
        if not ctx.overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "The Shape list tab should draw a frame.")
            ctx.not_done()
            return
        }
        waited = 0
        # The state remembers the shape the new-set dropdown last chose, and the state is one file
        # per world, so a test that ran before this one can leave it on another shape. The
        # dropdown's V is at (145, 70), and row 1 of its list is the circle this test drives below.
        ctx.click_screen(155, 80, 0)
        step = 8
        ctx.not_done()
        return
    }

    if step == 8 {
        # A dropdown list starts at (5, 90) and has 20-pixel rows, so row 1 is clicked at y 120.
        ctx.click_screen(85, 120, 0)
        step = 9
        ctx.not_done()
        return
    }

    if step == 9 {
        # The pick put the parent's Add back at (5, 90), 160 wide and 20 high, so (85, 100) is
        # inside it. It appends the circle and selects it, which is what makes the rest of the test
        # independent of the sets an earlier test left behind.
        ctx.click_screen(85, 100, 0)
        step = 11
        ctx.not_done()
        return
    }

    if step == 11 {
        ctx.press_screen_key(256, false, false, true)
        step = 12
        ctx.not_done()
        return
    }

    if step == 12 {
        if ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "Escape should close the screen after Add.")
            ctx.not_done()
            return
        }
        waited = 0
        state: string = _saved_state(ctx)
        ctx.assert(_current_index(state) >= 0, "Add should leave the appended set current.")
        ctx.assert(_shape_values(state, "ShapeCircle") == "X,3.0,1,false", "The appended set should hold the new-set circle at its defaults.")
        ctx.assert(_reloaded_shape_values(_set_line(state, _current_index(state)), "brentmaas.buildguide.common.shape.ShapeCircle") == "X,3.0,1,false", "The saved circle should read back the way the loader splits the line.")
        start_origin_x = _origin_x(state)
        step = 13
        ctx.press_world_key(66, false)
        ctx.not_done()
        return
    }

    if step == 13 {
        if not ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "The binding should reopen the screen after Add.")
            ctx.not_done()
            return
        }
        if not ctx.overlay_drawn() {
            ctx.not_done()
            return
        }
        waited = 0
        # The Shape tab is the first chrome button, at x 5 to 125 and y 30 to 50.
        ctx.click_screen(65, 40, 0)
        step = 14
        ctx.not_done()
        return
    }

    if step == 14 {
        if not ctx.overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "The Shape tab should draw a frame.")
            ctx.not_done()
            return
        }
        waited = 0
        # Direction is row 0, and its right arrow is at (370, 70), 20 by 20: X becomes Y.
        ctx.click_screen(380, 80, 0)
        step = 15
        ctx.not_done()
        return
    }

    if step == 15 {
        # Radius is row 1, and its "+" is at (370, 90), 20 by 20: 3.0 becomes 4.0.
        ctx.click_screen(380, 100, 0)
        step = 16
        ctx.not_done()
        return
    }

    if step == 16 {
        # Even mode is row 3, and its checkbox is at (320, 130), 20 by 20: false becomes true.
        ctx.click_screen(330, 140, 0)
        step = 17
        ctx.not_done()
        return
    }

    if step == 17 {
        # The origin X row's "+" is at (145, 135), 20 by 20.
        ctx.click_screen(155, 145, 0)
        step = 18
        ctx.not_done()
        return
    }

    if step == 18 {
        # The origin X field is at (45, 135), 70 wide. A click near its right edge puts the caret
        # after the text the shift wrote, so typing a zero appends to it.
        ctx.click_screen(110, 145, 0)
        step = 19
        ctx.not_done()
        return
    }

    if step == 19 {
        ctx.press_screen_key(48, false, false, true)
        step = 20
        ctx.not_done()
        return
    }

    if step == 20 {
        # The X row's Set button is at (115, 135), 30 wide, and writes the parsed field's value.
        ctx.click_screen(130, 145, 0)
        step = 21
        ctx.not_done()
        return
    }

    if step == 21 {
        # The Set press moved the focus off the text field, so this Escape reaches the screen; a
        # press that the field keeps is tried again rather than failing the test on it.
        if ctx.screen_open() {
            presses = presses + 1
            ctx.assert(presses < 5, "Escape should close the Shape screen after the Set press.")
            ctx.press_screen_key(256, false, false, true)
            ctx.not_done()
            return
        }
        presses = 0
        state: string = _saved_state(ctx)
        ctx.assert(_shape_values(state, "ShapeCircle") == "Y,4.0,1,true", "The panel should write the enum, the float step and the checkbox it was driven with.")
        ctx.assert(_reloaded_shape_values(_set_line(state, _current_index(state)), "brentmaas.buildguide.common.shape.ShapeCircle") == "Y,4.0,1,true", "The driven circle should read back the way the loader splits the line.")
        ctx.assert(_origin_x(state) == (start_origin_x + 1) * 10, "The origin row's + should shift the set and its Set should take the typed field.")
        # The huge radius runs while persistence is still on, so the closings it does write the
        # state it reads; the restore to the run's own persistence comes after it, at step 48.
        step = 32
        ctx.not_done()
        return
    }

    if step == 32 {
        step = 33
        ctx.press_world_key(66, false)
        ctx.not_done()
        return
    }

    if step == 33 {
        if not ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "The binding should reopen the screen for the huge radius.")
            ctx.not_done()
            return
        }
        if not ctx.overlay_drawn() {
            ctx.not_done()
            return
        }
        waited = 0
        ctx.click_screen(65, 40, 0)
        step = 34
        ctx.not_done()
        return
    }

    if step == 34 {
        if not ctx.overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "The Shape tab should draw for the huge radius.")
            ctx.not_done()
            return
        }
        waited = 0
        # Radius is row 1; its field is at (290, 90), 50 wide and 20 high.
        ctx.click_screen(315, 100, 0)
        step = 35
        ctx.not_done()
        return
    }

    if step == 35 {
        # Home puts the caret before the field's "4.0", and three Deletes remove it so the typed
        # value is the whole text, as a player clearing the field would write it.
        ctx.press_screen_key(268, false, false, true)
        step = 36
        ctx.not_done()
        return
    }

    if step == 36 {
        ctx.press_screen_key(261, false, false, true)
        step = 37
        ctx.not_done()
        return
    }

    if step == 37 {
        ctx.press_screen_key(261, false, false, true)
        step = 38
        ctx.not_done()
        return
    }

    if step == 38 {
        ctx.press_screen_key(261, false, false, true)
        step = 39
        ctx.not_done()
        return
    }

    if step == 39 {
        ctx.press_screen_key(49, false, false, true)
        step = 40
        ctx.not_done()
        return
    }

    if step == 40 {
        ctx.press_screen_key(69, false, false, true)
        step = 41
        ctx.not_done()
        return
    }

    if step == 41 {
        ctx.press_screen_key(50, false, false, true)
        step = 42
        ctx.not_done()
        return
    }

    if step == 42 {
        ctx.press_screen_key(48, false, false, true)
        step = 43
        ctx.not_done()
        return
    }

    if step == 43 {
        # The radius row's Set button is at (340, 90), 30 wide and 20 high.
        ctx.click_screen(355, 100, 0)
        step = 44
        ctx.not_done()
        return
    }

    if step == 44 {
        ctx.press_screen_key(256, false, false, true)
        step = 45
        ctx.not_done()
        return
    }

    if step == 45 {
        # A press the field keeps is tried again rather than failing the test on it, as step 21 does.
        if ctx.screen_open() {
            presses = presses + 1
            ctx.assert(presses < 8, "Escape should close the Shape screen after the huge radius.")
            ctx.press_screen_key(256, false, false, true)
            ctx.not_done()
            return
        }
        presses = 0
        state: string = _saved_state(ctx)
        ctx.assert(_shape_values(state, "ShapeCircle") == "Y,1.0E20,1,true", "The Radius field should take 1e20 and the set should keep it.")
        step = 46
        ctx.press_world_key(66, false)
        ctx.not_done()
        return
    }

    if step == 46 {
        # Opening the screen clears the drawn mark, and this screen's world frame counts every set's
        # cells before it draws, so a frame that walked a 1e20 box would time out or stall before the
        # mark was set. Reaching step 47 is the proof that the box guard skipped the cells and the
        # frame finished.
        if not ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "The binding should reopen the screen that holds the huge radius.")
            ctx.not_done()
            return
        }
        if not ctx.overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "A frame with a 1e20 radius should still draw.")
            ctx.not_done()
            return
        }
        waited = 0
        ctx.press_screen_key(256, false, false, true)
        step = 47
        ctx.not_done()
        return
    }

    if step == 47 {
        if ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "Escape should close the screen after the huge frame.")
            ctx.not_done()
            return
        }
        waited = 0
        # The two property bounds: Polygon's M refuses 3 and Grid's I refuses 1, so a typed or
        # decremented boundary is not stored where the loader would refuse it on the next load.
        step = 60
        ctx.press_world_key(66, false)
        ctx.not_done()
        return
    }

    if step == 60 {
        if not ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "The binding should reopen the screen for the property bounds.")
            ctx.not_done()
            return
        }
        if not ctx.overlay_drawn() {
            ctx.not_done()
            return
        }
        waited = 0
        ctx.click_screen(65, 40, 0)
        step = 61
        ctx.not_done()
        return
    }

    if step == 61 {
        if not ctx.overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "The Shape tab should draw for the property bounds.")
            ctx.not_done()
            return
        }
        waited = 0
        # The shape row's V is at (145, 70), 20 by 20.
        ctx.click_screen(155, 80, 0)
        step = 62
        ctx.not_done()
        return
    }

    if step == 62 {
        # The list holds the fifteen shapes and is 150 high at this scale, so scrolling to its end
        # shows row 11, Polygon, at y 160 to 180; a click in its middle is (85, 170).
        ctx.scroll_screen(85, 100, -8)
        step = 63
        ctx.not_done()
        return
    }

    if step == 63 {
        ctx.click_screen(85, 170, 0)
        step = 64
        ctx.not_done()
        return
    }

    if step == 64 {
        # Polygon's M is row 0, and its default 3 is already refused by the class: the + writes the
        # 4 the rest of this case holds, and the - below must not step it back to 3.
        ctx.click_screen(380, 80, 0)
        step = 65
        ctx.not_done()
        return
    }

    if step == 65 {
        ctx.click_screen(280, 80, 0)
        step = 66
        ctx.not_done()
        return
    }

    if step == 66 {
        # The M field is at (290, 70), 50 wide: Home and one Delete clear the 4 the + wrote, and a
        # typed 3 is refused, so the field keeps 3 but the set keeps 4.
        ctx.click_screen(315, 80, 0)
        step = 67
        ctx.not_done()
        return
    }

    if step == 67 {
        ctx.press_screen_key(268, false, false, true)
        step = 68
        ctx.not_done()
        return
    }

    if step == 68 {
        ctx.press_screen_key(261, false, false, true)
        step = 69
        ctx.not_done()
        return
    }

    if step == 69 {
        ctx.press_screen_key(51, false, false, true)
        step = 70
        ctx.not_done()
        return
    }

    if step == 70 {
        # The M row's Set button is at (340, 70), 30 wide.
        ctx.click_screen(355, 80, 0)
        step = 71
        ctx.not_done()
        return
    }

    if step == 71 {
        ctx.press_screen_key(256, false, false, true)
        step = 72
        ctx.not_done()
        return
    }

    if step == 72 {
        if ctx.screen_open() {
            presses = presses + 1
            ctx.assert(presses < 8, "Escape should close the Shape screen after the Polygon bound.")
            ctx.press_screen_key(256, false, false, true)
            ctx.not_done()
            return
        }
        presses = 0
        state: string = _saved_state(ctx)
        ctx.assert(_reloaded_shape_values(_set_line(state, _current_index(state)), "brentmaas.buildguide.common.shape.ShapePolygon") == "4,3.0,X,ROT0,1,false", "The M - and the typed 3 should both be refused, leaving the 4 the set was stepped to.")
        step = 73
        ctx.press_world_key(66, false)
        ctx.not_done()
        return
    }

    if step == 73 {
        if not ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "The binding should reopen the screen for the Grid bound.")
            ctx.not_done()
            return
        }
        if not ctx.overlay_drawn() {
            ctx.not_done()
            return
        }
        waited = 0
        ctx.click_screen(65, 40, 0)
        step = 74
        ctx.not_done()
        return
    }

    if step == 74 {
        if not ctx.overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "The Shape tab should draw for the Grid bound.")
            ctx.not_done()
            return
        }
        waited = 0
        ctx.click_screen(155, 80, 0)
        step = 75
        ctx.not_done()
        return
    }

    if step == 75 {
        # The list scrolls back to the top, where row 6, Grid, is visible at y 210 to 230.
        ctx.scroll_screen(85, 100, 8)
        step = 76
        ctx.not_done()
        return
    }

    if step == 76 {
        ctx.click_screen(85, 220, 0)
        step = 77
        ctx.not_done()
        return
    }

    if step == 77 {
        # Grid's X steps is row 0, an I whose default 3 is valid: the - steps it to 2, a second -
        # would land on 1 and is refused, and a typed 1 is refused too.
        ctx.click_screen(280, 80, 0)
        step = 78
        ctx.not_done()
        return
    }

    if step == 78 {
        ctx.click_screen(280, 80, 0)
        step = 79
        ctx.not_done()
        return
    }

    if step == 79 {
        ctx.click_screen(315, 80, 0)
        step = 80
        ctx.not_done()
        return
    }

    if step == 80 {
        ctx.press_screen_key(268, false, false, true)
        step = 81
        ctx.not_done()
        return
    }

    if step == 81 {
        ctx.press_screen_key(261, false, false, true)
        step = 82
        ctx.not_done()
        return
    }

    if step == 82 {
        ctx.press_screen_key(49, false, false, true)
        step = 83
        ctx.not_done()
        return
    }

    if step == 83 {
        ctx.click_screen(355, 80, 0)
        step = 84
        ctx.not_done()
        return
    }

    if step == 84 {
        # Grid's Y steps is row 1, an I whose default 1 is refused: a typed 2 makes the whole saved
        # Grid a shape the loader accepts, so the saved shapes are not in error.
        ctx.click_screen(315, 100, 0)
        step = 85
        ctx.not_done()
        return
    }

    if step == 85 {
        ctx.press_screen_key(268, false, false, true)
        step = 86
        ctx.not_done()
        return
    }

    if step == 86 {
        ctx.press_screen_key(261, false, false, true)
        step = 87
        ctx.not_done()
        return
    }

    if step == 87 {
        ctx.press_screen_key(50, false, false, true)
        step = 88
        ctx.not_done()
        return
    }

    if step == 88 {
        ctx.click_screen(355, 100, 0)
        step = 89
        ctx.not_done()
        return
    }

    if step == 89 {
        ctx.press_screen_key(256, false, false, true)
        step = 90
        ctx.not_done()
        return
    }

    if step == 90 {
        if ctx.screen_open() {
            presses = presses + 1
            ctx.assert(presses < 8, "Escape should close the Shape screen after the Grid bound.")
            ctx.press_screen_key(256, false, false, true)
            ctx.not_done()
            return
        }
        presses = 0
        state: string = _saved_state(ctx)
        ctx.assert(_reloaded_shape_values(_set_line(state, _current_index(state)), "brentmaas.buildguide.common.shape.ShapeGrid") == "2,2,3,3,3,3", "The second I - and the typed 1 should both be refused, leaving the 2 the first - stepped to.")
        # A tab press opens the new tab's screen, and core asks the outgoing screen's close export
        # from inside that open, after the mod already named the tab it is switching to. The close
        # must save and leave the new tab alone: a close that cleared the active screen would route
        # the new tab's widgets to the Shape tab's handler, so its Add would append nothing.
        start_count = _set_count(state)
        step = 91
        ctx.press_world_key(66, false)
        ctx.not_done()
        return
    }

    if step == 91 {
        if not ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "The binding should reopen the screen for the tab switch.")
            ctx.not_done()
            return
        }
        if not ctx.overlay_drawn() {
            ctx.not_done()
            return
        }
        waited = 0
        # The Shape list tab is the third chrome button, at x 255 to 375 and y 30 to 50.
        ctx.click_screen(265, 40, 0)
        step = 92
        ctx.not_done()
        return
    }

    if step == 92 {
        if not ctx.overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "The Shape list tab should draw after the switch.")
            ctx.not_done()
            return
        }
        waited = 0
        # Add is at (5, 90), 160 wide and 20 high.
        ctx.click_screen(85, 100, 0)
        step = 93
        ctx.not_done()
        return
    }

    if step == 93 {
        ctx.press_screen_key(256, false, false, true)
        step = 94
        ctx.not_done()
        return
    }

    if step == 94 {
        if ctx.screen_open() {
            presses = presses + 1
            ctx.assert(presses < 8, "Escape should close the Shape list screen after the tab switch.")
            ctx.press_screen_key(256, false, false, true)
            ctx.not_done()
            return
        }
        presses = 0
        saved: string = _saved_state(ctx)
        ctx.assert(_set_count(saved) == start_count + 1, "The Shape list tab should take Add after a tab switch, appending one set.")
        # A shape whose cell box cannot be walked in one call fails its own frame before anything
        # is drawn, so it must draw no cells rather than stall; a non-finite bound must emit no cell
        # at all where the old ring test let one through. Each case puts one such value on the set
        # and then waits for a world frame: the set's origin cube is drawn after its shape, so a
        # frame that reaches the end sets the world mark, while a loop that cannot finish stops the
        # export before it and leaves the mark clear. toggle_enable is unbound, as the reference
        # leaves it, so the test presses it by the id its about.json names.
        step = 95
        ctx.press_world_key_id("toggle_enable")
        ctx.not_done()
        return
    }

    if step == 95 {
        # The overlay is turned on for this group, so every check below can wait for the world mark
        # that a frame reaching its end sets. This frame already counts and draws the 1e20 Circle an
        # earlier step left in its set, so it is the first proof that the guard lets a frame finish.
        if not ctx.world_overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "A frame with the 1e20 Circle should draw after the overlay is enabled.")
            ctx.not_done()
            return
        }
        waited = 0
        step = 96
        ctx.press_world_key(66, false)
        ctx.not_done()
        return
    }

    if step == 96 {
        if not ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "The binding should reopen the screen for the huge circle.")
            ctx.not_done()
            return
        }
        if not ctx.overlay_drawn() {
            ctx.not_done()
            return
        }
        waited = 0
        ctx.click_screen(65, 40, 0)
        step = 97
        ctx.not_done()
        return
    }

    if step == 97 {
        if not ctx.overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "The Shape tab should draw for the huge circle.")
            ctx.not_done()
            return
        }
        waited = 0
        ctx.click_screen(155, 80, 0)
        ctx.scroll_screen(85, 100, 8)
        step = 98
        ctx.not_done()
        return
    }

    if step == 98 {
        # Row 1, Circle, at the list's (5, 90) and 20-pixel rows.
        ctx.click_screen(85, 120, 0)
        step = 99
        ctx.not_done()
        return
    }

    if step == 99 {
        # A Circle radius of 10000 scans 20001 by 20001 positions, which is more than one frame's
        # budget and under no cannot-advance guard.
        _type_property(ctx, 1, "10000")
        step = 100
        ctx.not_done()
        return
    }

    if step == 100 {
        ctx.press_screen_key(256, false, false, true)
        step = 101
        ctx.not_done()
        return
