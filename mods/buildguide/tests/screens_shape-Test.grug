        _type_property(ctx, 0, "1e20")
        step = 107
        ctx.not_done()
        return
    }

    if step == 107 {
        ctx.press_screen_key(256, false, false, true)
        step = 108
        ctx.not_done()
        return
    }

    if step == 108 {
        if ctx.screen_open() {
