    if step == 101 {
        if ctx.screen_open() {
            presses = presses + 1
            ctx.assert(presses < 8, "Escape should close the Shape screen after the 10000 radius.")
            ctx.press_screen_key(256, false, false, true)
            ctx.not_done()
            return
        }
        presses = 0
        state: string = _saved_state(ctx)
        ctx.assert(_reloaded_shape_values(_set_line(state, _current_index(state)), "brentmaas.buildguide.common.shape.ShapeCircle") == "X,10000.0,1,false", "A Circle radius of 10000 should be kept, and the set should still load with it.")
        # H is one of the mod's state keys here, so it clears the world mark; the frame after it
        # draws the set's origin cube after its shape.
        step = 102
        ctx.press_world_key(72, false)
        ctx.not_done()
