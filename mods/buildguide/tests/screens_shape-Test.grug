        }
        presses = 0
        state: string = _saved_state(ctx)
        ctx.assert(_reloaded_shape_values(_set_line(state, _current_index(state)), "brentmaas.buildguide.common.shape.ShapeSphere") == "1.0E20,NO,false", "A Sphere radius of 1e20 should be kept, and the set should still load with it.")
        step = 109
        ctx.press_world_key(72, false)
