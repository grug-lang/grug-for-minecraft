    }

    if step == 116 {
        if not ctx.world_overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "A frame with a Torus radius of 10000 should still draw.")
            ctx.not_done()
            return
        }
        waited = 0
        step = 117
        ctx.press_world_key(66, false)
        ctx.not_done()
        return
    }

    if step == 117 {
        if not ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "The binding should reopen the screen for the infinite circle.")
            ctx.not_done()
            return
        }
        if not ctx.overlay_drawn() {
            ctx.not_done()
            return
        }
        waited = 0
        ctx.click_screen(65, 40, 0)
        step = 118
        ctx.not_done()
        return
    }

    if step == 118 {
        if not ctx.overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "The Shape tab should draw for the infinite circle.")
            ctx.not_done()
            return
        }
        waited = 0
        ctx.click_screen(155, 80, 0)
        ctx.scroll_screen(85, 100, 8)
        step = 119
        ctx.not_done()
        return
    }

    if step == 119 {
        ctx.click_screen(85, 120, 0)
        step = 120
        ctx.not_done()
        return
    }

    if step == 120 {
        # An infinite radius passes PositiveFloat's "above 0" check and the ring test's bounds are
        # infinite too, so the old loop emitted one cell at -Infinity before the cannot-advance
        # break; the drawn triangle was refused and the frame recorded a host function error.
        _type_property(ctx, 1, "Infinity")
        step = 121
        ctx.not_done()
        return
    }

    if step == 121 {
        ctx.press_screen_key(256, false, false, true)
        step = 122
        ctx.not_done()
        return
    }

    if step == 122 {
        if ctx.screen_open() {
            presses = presses + 1
            ctx.assert(presses < 8, "Escape should close the Shape screen after the infinite radius.")
            ctx.press_screen_key(256, false, false, true)
            ctx.not_done()
            return
        }
        presses = 0
        state: string = _saved_state(ctx)
        ctx.assert(_reloaded_shape_values(_set_line(state, _current_index(state)), "brentmaas.buildguide.common.shape.ShapeCircle") == "X,Infinity,1,false", "An infinite Circle radius should be kept, and the set should still load with it.")
        ctx.assert(String.index_of(state, "gen=") < 0, "A stalled set's generation state should never reach the saved file.")
        step = 123
        ctx.press_world_key(72, false)
        ctx.not_done()
        return
    }

    if step == 123 {
        if not ctx.world_overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "A frame with an infinite Circle radius should draw its origin and no cell.")
            ctx.not_done()
            return
        }
        waited = 0
        step = 142
        ctx.not_done()
        return
    }

    if step == 142 {
        # An Ellipsoid's box is not guarded before this change, so this set is the state the branch
        # adds: on the old code the frame walks 2e20 cubed positions and never returns, while here it
        # draws the origin cube and leaves the shape generating with no cells.
        ctx.press_world_key(66, false)
        step = 143
        ctx.not_done()
        return
    }

    if step == 143 {
        if not ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "The binding should reopen the screen for the huge ellipsoid.")
            ctx.not_done()
            return
        }
        if not ctx.overlay_drawn() {
            ctx.not_done()
            return
        }
        waited = 0
        ctx.click_screen(155, 80, 0)
        step = 144
        ctx.not_done()
        return
    }

    if step == 144 {
        # The shape dropdown opens at its top, and row 5, Ellipsoid, is at y 190 to 210.
        ctx.scroll_screen(85, 100, 8)
        step = 145
        ctx.not_done()
        return
    }

    if step == 145 {
        ctx.click_screen(85, 200, 0)
        step = 146
        ctx.not_done()
        return
    }

    if step == 146 {
        # Ellipsoid's X radius is row 0, and 1e20 makes its box 2e20+1 positions on every axis.
        _type_property(ctx, 0, "1e20")
        step = 147
        ctx.not_done()
        return
    }

    if step == 147 {
        ctx.press_screen_key(256, false, false, true)
        step = 148
        ctx.not_done()
        return
    }

    if step == 148 {
        if ctx.screen_open() {
            presses = presses + 1
            ctx.assert(presses < 8, "Escape should close the Shape screen after the huge ellipsoid.")
            ctx.press_screen_key(256, false, false, true)
            ctx.not_done()
            return
        }
        presses = 0
        state: string = _saved_state(ctx)
        ctx.assert(_reloaded_shape_values(_set_line(state, _current_index(state)), "brentmaas.buildguide.common.shape.ShapeEllipsoid") == "1.0E20,3.0,3.0,NO,false", "An Ellipsoid radius of 1e20 should be kept, and the set should still load with it.")
        ctx.assert(String.index_of(state, "gen=") < 0, "A stalled set's generation state should never reach the saved file.")
        step = 149
        ctx.press_world_key(72, false)
        ctx.not_done()
        return
    }

    if step == 149 {
        if not ctx.world_overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "A frame with an Ellipsoid radius of 1e20 should still draw.")
            ctx.not_done()
            return
        }
        waited = 0
        step = 125
        ctx.not_done()
        return
    }

    if step == 125 {
        # A live Catenary whose first solve leaves the finite range is the reference's error arm. The
        # shape is ready with no cells and its row is red, and both are pixels no test entry reads, so
        # the capture suite is their proof. This proves the frame and the screen keep running, that
        # the row export of the stalled and then the errored set answers a frame without breaking its
        # rules, that the value is saved, and that no transient generation state reaches the file.
        ctx.press_world_key(66, false)
        step = 126
        ctx.not_done()
        return
    }

    if step == 126 {
        if not ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "The binding should reopen the screen for the catenary.")
            ctx.not_done()
            return
        }
        if not ctx.overlay_drawn() {
            ctx.not_done()
            return
        }
        waited = 0
        # The Shape list tab is the third chrome button, at x 255 to 375 and y 30 to 50. The Shape
        # tab with its dropdown closed asks no row, so the count read here can only grow from the
        # list tab's rows, and the step after the click proves a row was asked rather than only that
        # no answer was wrong.
        rows_before = ctx.rows_asked()
        ctx.click_screen(265, 40, 0)
        step = 137
        ctx.not_done()
        return
    }

    if step == 137 {
        # The set still holds the Ellipsoid of 1e20 from the step before, so its row is the stalled
        # state: the export must answer its text and colour once, as the reference's row does, and a
        # row that returned without answering or answered twice is the first err reported here.
        if not ctx.overlay_drawn() or not (ctx.rows_asked() > rows_before) {
            waited = waited + 1
            ctx.assert(waited < 200, "The Shape list tab should ask the stalled set's row and draw it.")
            ctx.not_done()
            return
        }
        waited = 0
        ctx.assert(String.length(ctx.list_row_error()) == 0, "The stalled set's row should answer without breaking a row rule.")
        ctx.click_screen(65, 40, 0)
        step = 138
        ctx.not_done()
        return
    }

    if step == 138 {
        if not ctx.overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "The Shape tab should draw for the catenary.")
            ctx.not_done()
            return
        }
        waited = 0
        ctx.click_screen(155, 80, 0)
        step = 139
        ctx.not_done()
        return
    }

    if step == 139 {
        # The dropdown opens at its top, and row 0, Catenary, is at the list's (5, 90) with 20-pixel
        # rows, so (85, 100) is inside it.
        ctx.scroll_screen(85, 100, 8)
        step = 128
        ctx.not_done()
        return
    }

    if step == 128 {
        ctx.click_screen(85, 100, 0)
        step = 129
        ctx.not_done()
        return
    }

    if step == 129 {
        # dx 1419 with the class's own dy 0, dz 0 and added length 1 makes the first solve's step
        # leave the finite range, which throws in the reference and is the port's error arm.
        _type_property(ctx, 0, "1419")
        step = 130
        ctx.not_done()
        return
    }

    if step == 130 {
        ctx.press_screen_key(256, false, false, true)
        step = 131
        ctx.not_done()
        return
    }

    if step == 131 {
        if ctx.screen_open() {
            presses = presses + 1
            ctx.assert(presses < 8, "Escape should close the Shape screen after the catenary.")
            ctx.press_screen_key(256, false, false, true)
            ctx.not_done()
            return
        }
        presses = 0
        state: string = _saved_state(ctx)
        set: string = _set_line(state, _current_index(state))
        ctx.assert(_reloaded_shape_values(set, "brentmaas.buildguide.common.shape.ShapeCatenary") == "1419,0,0,Runnable,1.0,false", "A Catenary dx of 1419 should be kept, and the set should still load with it.")
        ctx.assert(String.index_of(state, "gen=") < 0, "An errored set's generation state should never reach the saved file.")
        ctx.assert(String.index_of(set, "|") < 0, "The set should save without the port's shape separator.")
        step = 132
        ctx.press_world_key(66, false)
        ctx.not_done()
        return
    }

    if step == 132 {
        if not ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "The binding should reopen the screen after the errored catenary.")
            ctx.not_done()
            return
        }
        if not ctx.overlay_drawn() {
            ctx.not_done()
            return
        }
        waited = 0
        # The Shape tab with its dropdown closed asks no row, so the count can only grow from the
        # Shape list tab's rows, as in the stalled set's step above.
        rows_before = ctx.rows_asked()
        ctx.click_screen(265, 40, 0)
        step = 133
        ctx.not_done()
        return
    }

    if step == 133 {
        # The errored set's row is the reference's red one, and the colour is a pixel the capture
        # suite pins; what a test can read is that the export was asked its row and still answered
        # within the rules.
        if not ctx.overlay_drawn() or not (ctx.rows_asked() > rows_before) {
            waited = waited + 1
            ctx.assert(waited < 200, "The Shape list tab should ask the errored set's row and draw it.")
            ctx.not_done()
            return
        }
        waited = 0
        ctx.assert(String.length(ctx.list_row_error()) == 0, "The errored set's row should answer without breaking a row rule.")
        ctx.click_screen(65, 40, 0)
        step = 140
        ctx.not_done()
        return
    }

    if step == 140 {
        if not ctx.overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "The Shape tab should draw after the errored catenary.")
            ctx.not_done()
            return
        }
        waited = 0
        ctx.click_screen(155, 80, 0)
        step = 141
        ctx.not_done()
        return
    }

    if step == 141 {
        ctx.scroll_screen(85, 100, 8)
        step = 134
        ctx.not_done()
        return
    }

    if step == 134 {
        # Row 1, Circle, at its own defaults: the errored Catenary entry stays in the set but the
        # set's current shape is a Circle the reference drew, so a later test does not start from an
        # error.
        ctx.click_screen(85, 120, 0)
        step = 135
        ctx.not_done()
        return
    }

    if step == 135 {
        ctx.press_screen_key(256, false, false, true)
        step = 136
        ctx.not_done()
        return
    }

    if step == 136 {
        if ctx.screen_open() {
            presses = presses + 1
            ctx.assert(presses < 8, "Escape should close the Shape screen after the errored catenary.")
            ctx.press_screen_key(256, false, false, true)
            ctx.not_done()
            return
        }
        presses = 0
        step = 124
        # toggle_enable is unbound, as the reference leaves it, so the toggle back off is a press
        # by the id its about.json names.
        ctx.press_world_key_id("toggle_enable")
        ctx.not_done()
        return
    }

    if step == 124 {
        # The overlay was on only for this group, so the state goes back to the way the test found
        # it and a test that runs after this one sees the overlay off.
        if was_persistent {
            return
        }
        step = 48
        ctx.not_done()
        return
    }

    if step == 48 {
        # The run found persistence off, so the Configuration tab's box is ticked back off.
        step = 49
        ctx.press_world_key(66, false)
        ctx.not_done()
        return
    }

    if step == 49 {
        if not ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "The binding should reopen the screen to put persistence back.")
            ctx.not_done()
            return
        }
        if not ctx.overlay_drawn() {
            ctx.not_done()
            return
        }
        waited = 0
        width: number = ctx.screen_width()
        tab_x: number = 416
        if width - 10 < tab_x {
            tab_x = width - 10
        }
        ctx.click_screen(tab_x, 40, 0)
        step = 50
        ctx.not_done()
        return
    }

    if step == 50 {
        if not ctx.overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "The Configuration tab should draw for the restore.")
            ctx.not_done()
            return
        }
        waited = 0
        ctx.click_screen(262, 168, 0)
        step = 51
        ctx.not_done()
        return
    }

    if step == 51 {
        files: File = File.open(r"files")
        config: Option[string] = files.read_text("config/buildguide.cfg")
        ctx.assert(config.has(), "Unticking persistence should leave the config file readable.")
        ctx.assert(String.index_of(config.unwrap(), "persistenceEnabled = false") >= 0, "Unticking persistence should put the run's value back.")
        ctx.press_screen_key(256, false, false, true)
        step = 52
        ctx.not_done()
        return
    }

    if step == 52 {
        if ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "Escape should close the Configuration screen.")
            ctx.not_done()
            return
        }
    }
}

# The state text the mod saved for this world, which is the one file under buildguide that holds a
# set. A test that runs before the first save gets an empty directory and fails the assertion.

local _saved_state(ctx: TestTickContext) string {
    files: File = File.open(r"files")
    count: number = files.entry_count("buildguide")
    i: number = 0
    while i < count {
        name: string = files.entry_name("buildguide", i)
        text: Option[string] = files.read_text(String.concat("buildguide/", name))
        if text.has() {
            state: string = text.unwrap()
            if String.index_of(state, "shapeSet=") >= 0 {
                return state
            }
        }
        i = i + 1
    }
    ctx.assert(false, "The close should have saved a state with a set.")
    return ""
}

# The current set's origin X, from its origin=x,y,z; field, which the load writes on every set.

local _origin_x(state: string) number {
    return _origin_piece(_set_line(state, _current_index(state)), 0)
}

# The iShapeSet line's number, or -1 when the state has none.

local _current_index(state: string) number {
    at: number = String.index_of(state, "iShapeSet=")
    if at < 0 {
        return -1
    }
    rest: string = String.substring(state, at + 10, String.length(state))
    end: number = String.index_of(rest, String.from_character(10))
    if end >= 0 {
        rest = String.substring(rest, 0, end)
    }
    parsed: Option[number] = String.to_integer(rest)
    if parsed.has() {
        return parsed.unwrap()
    }
    return -1
}

# One comma-separated piece of a set's origin field, or 0 when the field is not there.

local _origin_piece(set: string, index: number) number {
    at: number = String.index_of(set, "origin=")
    if at < 0 {
        return 0
    }
    rest: string = String.substring(set, at + 7, String.length(set))
    end: number = String.index_of(rest, ";")
    if end < 0 {
        return 0
    }
    origin: string = String.substring(rest, 0, end)
    piece: string = origin
    i: number = 0
    while i < index {
        comma: number = String.index_of(piece, ",")
        if comma < 0 {
            return 0
        }
        piece = String.substring(piece, comma + 1, String.length(piece))
        i = i + 1
    }
    comma: number = String.index_of(piece, ",")
    if comma >= 0 {
        piece = String.substring(piece, 0, comma)
    }
    parsed: Option[number] = String.to_integer(piece)
    if parsed.has() {
        return parsed.unwrap()
    }
    return 0
}

# The value text of the current set's entry for one shape class, which is the part between its "="
# and the following ";". A class the set holds no entry for answers an empty text. The saved line has
# no separator between the set's own fields and its shapes, so the whole line is searched.

local _shape_values(state: string, class_name: string) string {
    set: string = _set_line(state, _current_index(state))
    needle: string = String.concat(class_name, "=")
    at: number = String.index_of(set, needle)
    if at < 0 {
        return ""
    }
    rest: string = String.substring(set, at + String.length(needle), String.length(set))
    end: number = String.index_of(rest, ";")
    if end < 0 {
        return rest
    }
    return String.substring(rest, 0, end)
}

# The value text the loader reads back for one shape class from a shapeSet line, which is what a
# reload gives the shape: ShapeSet.restorePersistence splits the line's value on ";" and matches an
# entry's whole key against the class name. The writer drops this port's "|" separator before saving,
# so the first entry's key is the class itself; only this parse proves the value survives a load,
# where _shape_values finds the class inside any key. The key is the reference's fully qualified
# class name, which ShapeSet.toPersistence writes and restorePersistence matches.

local _reloaded_shape_values(set: string, class_name: string) string {
    at: number = String.index_of(set, "shapeSet=")
    if at < 0 {
        return ""
    }
    rest: string = String.substring(set, at + 9, String.length(set))
    piece: string = rest
    while String.length(piece) > 0 {
        semi: number = String.index_of(piece, ";")
        entry: string = piece
        if semi >= 0 {
            entry = String.substring(piece, 0, semi)
            piece = String.substring(piece, semi + 1, String.length(piece))
        } else {
            piece = ""
        }
        eq: number = String.index_of(entry, "=")
        if eq > 0 and String.substring(entry, 0, eq) == class_name {
            return String.substring(entry, eq + 1, String.length(entry))
        }
    }
    return ""
}

# How many shapeSet lines the state holds, which is how many sets it saves.

local _set_count(state: string) number {
    count: number = 0
    while String.length(_set_line(state, count)) > 0 {
        count = count + 1
    }
    return count
}

# Clears a property row's field and types a value into it, then presses that row's Set. Home and
# twenty Deletes empty the field whatever it held, because a Delete at the end of the text does
# nothing; the field is at (290, 70 + row * 20), 50 wide, and its Set button at (340, 70 + row * 20).

local _type_property(ctx: TestTickContext, row: number, text: string) {
    ctx.click_screen(315, 80 + row * 20, 0)
    ctx.press_screen_key(268, false, false, true)
    pressed: number = 0
    while pressed < 20 {
        ctx.press_screen_key(261, false, false, true)
        pressed = pressed + 1
    }
    _type_keys(ctx, text)
    ctx.click_screen(355, 80 + row * 20, 0)
}

# Types a text one key at a time, the way a player at the keyboard does: a letter is its key with
# shift for a capital, and a digit or a lower-case letter is the key that types it.

local _type_keys(ctx: TestTickContext, text: string) {
    i: number = 0
    while i < String.length(text) {
        character: string = String.substring(text, i, i + 1)
        upper: number = String.index_of("ABCDEFGHIJKLMNOPQRSTUVWXYZ", character)
        if upper >= 0 {
            ctx.press_screen_key(65 + upper, false, true, true)
        } else {
            ctx.press_screen_key(_key_code(character), false, false, true)
        }
        i = i + 1
    }
}

# The key code of a typed character: a digit is its ASCII code, and a lower-case letter is the code
# of its capital.

local _key_code(character: string) number {
    digit: number = String.index_of("0123456789", character)
    if digit >= 0 {
        return 48 + digit
    }
    lower: number = String.index_of("abcdefghijklmnopqrstuvwxyz", character)
    if lower >= 0 {
        return 65 + lower
    }
    return 0
}

# The shapeSet line at a sequence number, or an empty text when there are fewer sets.

local _set_line(state: string, wanted: number) string {
    if wanted < 0 {
        return ""
    }
    rest: string = state
    found: number = 0
    at: number = String.index_of(rest, "shapeSet=")
    while at >= 0 {
        line_rest: string = String.substring(rest, at, String.length(rest))
        end: number = String.index_of(line_rest, String.from_character(10))
        if found == wanted {
            if end < 0 {
                return line_rest
            }
            return String.substring(line_rest, 0, end)
        }
        if end < 0 {
            return ""
        }
        found = found + 1
        rest = String.substring(line_rest, end + 1, String.length(line_rest))
        at = String.index_of(rest, "shapeSet=")
    }
    return ""
}
