# The Shape tab with no set at all: the reset removes every set and adds none, so the panel shows no
# shape, the origin fields show a dash and their labels are grey. A no-set panel that draws white
# labels, or one that keeps a set from an earlier test, fails here. The whole window is captured at
# GUI scale 2, so the shared chrome and the blurred background are pinned with the panel.
step: number = 0
waited: number = 0
shifts: number = 0

export tick(ctx: TestTickContext) {
    if step == 0 {
        # S1: a screen capture runs at GUI scale 2, where the whole panel fits the 640-pixel GUI
        # area and the window is 1280 by 720 pixels.
        if not me.owned_screens_supported() or not me.world_overlay_supported() or me.on_dedicated_server() {
            return
        }
        ctx.set_gui_scale(2)
        if not ctx.world_settled() {
            waited = waited + 1
            ctx.assert(waited < 200, "The world should settle before the screen opens.")
            ctx.not_done()
            return
        }
        waited = 0
        step = 1
        ctx.not_done()
        return
    }

    if step == 1 {
        # S1: the port's about.json declares its open on B, so its run presses the world key,
        # while the reference's opener is a Forge KeyMapping that only the game's own key handling
        # reaches.
        if me.is_reference() {
            ctx.press_game_key(66)
        } else {
            ctx.press_world_key(66, false)
        }
        step = 2
        ctx.not_done()
        return
    }

    if step == 2 {
        # S1: open, drawn and at the scale the captures were planned at.
        if not ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "The B binding should open Build Guide's screen.")
            ctx.not_done()
            return
        }
        if not ctx.overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "The screen should draw a frame.")
            ctx.not_done()
            return
        }
        waited = 0
        ctx.assert(ctx.screen_width() == 640, "GUI scale 2 should give a 640-pixel GUI area.")
        step = 3
        ctx.not_done()
        return
    }

    if step == 3 {
        # S2: the Shape list tab holds the reset's dropdown, Delete and Add, so the run starts
        # from one fresh set whatever the run before it left.
        ctx.click_screen(315, 40, 0)
        step = 4
        ctx.not_done()
        return
    }

    if step == 4 {
        if not ctx.overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "The Shape list tab should draw a frame.")
            ctx.not_done()
            return
        }
        waited = 0
        step = 5
        ctx.not_done()
        return
    }

    if step == 5 {
        # S2 for the empty panel: Delete at (5, 155) sixteen times removes every set, and no Add
        # follows, because the capture is the screen with no set at all.
        ctx.click_screen(85, 165, 0)
        shifts = shifts + 1
        if shifts < 16 {
            ctx.not_done()
            return
        }
        shifts = 0
        step = 6
        ctx.not_done()
        return
    }

    if step == 6 {
        # S3: the capture's own tab.
        ctx.click_screen(65, 40, 0)
        step = 7
        ctx.not_done()
        return
    }

    if step == 7 {
        if not ctx.overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "The capture's tab should draw a frame.")
            ctx.not_done()
            return
        }
        waited = 0
        step = 8
        ctx.not_done()
        return
    }

    if step == 8 {
        # S5: the last change has to be drawn before the capture reads the window.
        if not ctx.overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "The capture's screen should draw a frame.")
            ctx.not_done()
            return
        }
        waited = 0
        step = 9
        ctx.not_done()
        return
    }

    if step == 9 {
        # The whole window, so the golden pins the shared chrome and the blurred background too.
        ctx.screenshot().equals(r"screenshots/screen_shape_empty", 0, 0, 1280, 720)
        step = 10
        ctx.not_done()
        return
    }

    if step == 10 {
        # S6: Escape closes the screen, so the next test's press reaches the world.
        ctx.press_screen_key(256, false, false, true)
        step = 11
        ctx.not_done()
        return
    }

    if step == 11 {
        if ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "Escape should close the screen after the capture.")
            ctx.not_done()
            return
        }
    }
}
