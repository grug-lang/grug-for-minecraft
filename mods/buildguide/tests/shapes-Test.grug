local _assert_known_cells(ctx: TestTickContext) {
    circle_px: number = 0
    circle_nx: number = 0
    circle_pz: number = 0
    circle_nz: number = 0
    circle_index: number = 0
    circle_cell: Option[Vec3] = _cell_circle(1, 4, 1, false, circle_index)
    while circle_cell.has() {
        cc: Vec3 = circle_cell.unwrap()
        if cc.x() == 4 and cc.y() == 0 and cc.z() == 0 {
            circle_px = circle_px + 1
        }
        if cc.x() == -4 and cc.y() == 0 and cc.z() == 0 {
            circle_nx = circle_nx + 1
        }
        if cc.x() == 0 and cc.y() == 0 and cc.z() == 4 {
            circle_pz = circle_pz + 1
        }
        if cc.x() == 0 and cc.y() == 0 and cc.z() == -4 {
            circle_nz = circle_nz + 1
        }
        circle_index = circle_index + 1
        circle_cell = _cell_circle(1, 4, 1, false, circle_index)
    }
    ctx.assert(circle_px == 1, "circle_y_r4 should contain (4,0,0) once.")
    ctx.assert(circle_nx == 1, "circle_y_r4 should contain (-4,0,0) once.")
    ctx.assert(circle_pz == 1, "circle_y_r4 should contain (0,0,4) once.")
    ctx.assert(circle_nz == 1, "circle_y_r4 should contain (0,0,-4) once.")

    sphere_px: number = 0
    sphere_nx: number = 0
    sphere_py: number = 0
    sphere_ny: number = 0
    sphere_pz: number = 0
    sphere_nz: number = 0
    sphere_index: number = 0
    sphere_cell: Option[Vec3] = _cell_sphere(1, 0, false, sphere_index)
    while sphere_cell.has() {
        sc: Vec3 = sphere_cell.unwrap()
        if sc.x() == 1 and sc.y() == 0 and sc.z() == 0 {
            sphere_px = sphere_px + 1
        }
        if sc.x() == -1 and sc.y() == 0 and sc.z() == 0 {
            sphere_nx = sphere_nx + 1
        }
        if sc.x() == 0 and sc.y() == 1 and sc.z() == 0 {
            sphere_py = sphere_py + 1
        }
        if sc.x() == 0 and sc.y() == -1 and sc.z() == 0 {
            sphere_ny = sphere_ny + 1
        }
        if sc.x() == 0 and sc.y() == 0 and sc.z() == 1 {
            sphere_pz = sphere_pz + 1
        }
        if sc.x() == 0 and sc.y() == 0 and sc.z() == -1 {
            sphere_nz = sphere_nz + 1
        }
        sphere_index = sphere_index + 1
        sphere_cell = _cell_sphere(1, 0, false, sphere_index)
    }
    ctx.assert(sphere_px == 1, "sphere_r1 should contain (1,0,0) once.")
    ctx.assert(sphere_nx == 1, "sphere_r1 should contain (-1,0,0) once.")
    ctx.assert(sphere_py == 1, "sphere_r1 should contain (0,1,0) once.")
    ctx.assert(sphere_ny == 1, "sphere_r1 should contain (0,-1,0) once.")
    ctx.assert(sphere_pz == 1, "sphere_r1 should contain (0,0,1) once.")
    ctx.assert(sphere_nz == 1, "sphere_r1 should contain (0,0,-1) once.")

    torus_outer: number = 0
    torus_inner: number = 0
    torus_side_pos: number = 0
    torus_side_neg: number = 0
    torus_index: number = 0
    torus_cell: Option[Vec3] = _cell_torus(0, 2, 1, false, false, torus_index)
    while torus_cell.has() {
        tc: Vec3 = torus_cell.unwrap()
        if tc.x() == 0 and tc.y() == 0 and tc.z() == 3 {
            torus_outer = torus_outer + 1
        }
        if tc.x() == 0 and tc.y() == 0 and tc.z() == 1 {
            torus_inner = torus_inner + 1
        }
        if tc.x() == 1 and tc.y() == 0 and tc.z() == 2 {
            torus_side_pos = torus_side_pos + 1
        }
        if tc.x() == -1 and tc.y() == 0 and tc.z() == 2 {
            torus_side_neg = torus_side_neg + 1
        }
        torus_index = torus_index + 1
        torus_cell = _cell_torus(0, 2, 1, false, false, torus_index)
    }
    ctx.assert(torus_outer == 1, "torus_x_2_1 should contain (0,0,3) once.")
    ctx.assert(torus_inner == 1, "torus_x_2_1 should contain (0,0,1) once.")
    ctx.assert(torus_side_pos == 1, "torus_x_2_1 should contain (1,0,2) once.")
    ctx.assert(torus_side_neg == 1, "torus_x_2_1 should contain (-1,0,2) once.")
}

local _cell_catenary(dx: number, dy: number, dz: number, add_length: number, invert: bool, index: number) Option[Vec3] {
    result: Option[Vec3] = Option.new()
    found: number = 0
    dr: number = Math.sqrt(dx * dx + dz * dz)
    if dr >= 1 {
        s: number = Math.sqrt(dr * dr + dy * dy) + add_length
        # The reference solves for the catenary parameter with Newton's method and has no iteration
        # bound: a solve whose values leave the finite range makes its Double.isFinite check throw,
        # and a solve whose step changes nothing repeats that step forever. grug cannot raise an
        # error to the player and must not hang, so a step that is not finite, or that changes
        # nothing, ends the solve and the shape answers no cells at once. The cell loops below keep
        # the reference's own bounds (0 to d, and h to the height) rather than a cube cap of this
        # port's own.
        a: number = 1
        chi: number = 2 * a * Math.sinh(dr / 2 / a) - Math.sqrt(s * s - dy * dy)
        solved: bool = _finite(chi)
        while solved and Math.abs(chi) > 0.001 {
            dchi: number = 2 * Math.sinh(dr / 2 / a) - dr / a * Math.cosh(dr / 2 / a)
            next: number = Math.max(a - chi / dchi, a / 2)
            if not _finite(dchi) or not _finite(next) or next == a {
                solved = false
            } else {
                a = next
                chi = 2 * a * Math.sinh(dr / 2 / a) - Math.sqrt(s * s - dy * dy)
                if not _finite(chi) {
                    solved = false
                }
            }
        }
        rl: number = 0
        if solved {
            chi = a * Math.cosh(rl / a) + dy - a * Math.cosh((rl + dr) / a)
            solved = _finite(chi)
        }
        while solved and Math.abs(chi) > 0.001 {
            dchi: number = Math.sinh(rl / a) - Math.sinh((rl + dr) / a)
            next: number = rl - chi / dchi
            if not _finite(dchi) or not _finite(next) or next == rl {
                solved = false
            } else {
                rl = next
                chi = a * Math.cosh(rl / a) + dy - a * Math.cosh((rl + dr) / a)
                if not _finite(chi) {
                    solved = false
                }
            }
        }
        if not solved {
            return result
        }
        d: number = _trunc(Math.max(Math.abs(dx), Math.abs(dz)))
        unit_x: number = dx / d
        unit_z: number = dz / d
        fac: number = Math.sqrt(unit_x * unit_x + unit_z * unit_z)
        base: number = a * Math.cosh(rl / a)
        if not _finite(base) {
            return result
        }
        h: number = _trunc(Math.min(0, dy) - base)
        i: number = 0
        while i <= d {
            j: number = h
            while j <= Math.max(0, dy) {
                if not (i == 0 and j > 0) and not (i == d and j > dy) {
                    down: number = a * Math.cosh((i * fac + rl) / a) - base
                    left: number = a * Math.cosh(((i - 0.5) * fac + rl) / a) - base
                    right: number = a * Math.cosh(((i + 0.5) * fac + rl) / a) - base
                    if (down >= j - 0.5 and down < j + 0.5) or (left >= j and right < j) or (right >= j and left < j) {
                        if found == index {
                            if invert {
                                result.set(Vec3.new(_trunc(unit_x * (d - i) + Math.signum(dx) * 0.5), dy - j, _trunc(unit_z * (d - i) + Math.signum(dz) * 0.5)))
                            } else {
                                result.set(Vec3.new(_trunc(unit_x * i + Math.signum(dx) * 0.5), j, _trunc(unit_z * i + Math.signum(dz) * 0.5)))
                            }
                            return result
                        }
                        found = found + 1
                    }
                }
                j = j + 1
            }
            i = i + 1
        }
    } else {
        start: number = -add_length / 2 - 0.5
        end: number = 0
        if dy < 0 {
            start = start + dy
        } else {
            end = dy
        }
        i: number = _trunc(start)
        while i <= end {
            if found == index {
                result.set(Vec3.new(0, i, 0))
                return result
            }
            found = found + 1
            i = i + 1
        }
    }
    return result
}

# ShapeCircle: a ring of cells depth deep, opening along direction.
local _cell_circle(direction: number, radius: number, depth: number, even_mode: bool, index: number) Option[Vec3] {
    result: Option[Vec3] = Option.new()
    offset: number = 0
    if even_mode {
        offset = 0.5
    }
    lower: number = Math.floor(-radius + offset)
    upper: number = Math.ceil(radius + offset)
    z_start: number = 0
    z_end: number = depth
    if depth <= 0 {
        z_start = depth + 1
        z_end = 1
    }
    found: number = 0
    x: number = lower
    while x <= upper {
        y: number = lower
        while y <= upper {
            r2: number = (x - offset) * (x - offset) + (y - offset) * (y - offset)
            if r2 >= (radius - 0.5) * (radius - 0.5) and r2 <= (radius + 0.5) * (radius + 0.5) {
                z: number = z_start
                while z < z_end {
                    if found == index {
                        if direction == 0 {
                            result.set(Vec3.new(z, x, y))
                        } else if direction == 1 {
                            result.set(Vec3.new(x, z, y))
                        } else {
                            result.set(Vec3.new(x, y, z))
                        }
                        return result
                    }
                    found = found + 1
                    z = z + 1
                }
            }
            y = y + 1
        }
        x = x + 1
    }
    return result
}

# ShapeCone: a cone from the origin to height along direction, radius wide at its base.
local _cell_cone(direction: number, radius: number, height: number, even_mode: bool, index: number) Option[Vec3] {
    result: Option[Vec3] = Option.new()
    offset: number = 0
    if even_mode {
        offset = 0.5
    }
    lower: number = Math.floor(-radius + offset)
    upper: number = Math.ceil(radius + offset)
    z_start: number = 0
    z_end: number = 0
    if height < 0 {
        z_start = Math.floor(height)
    }
    if height > 0 {
        z_end = Math.ceil(height)
    }
    found: number = 0
    x: number = lower
    while x <= upper {
        y: number = lower
        while y <= upper {
            z: number = z_start
            while z <= z_end {
                r: number = Math.sqrt((x - offset) * (x - offset) + (y - offset) * (y - offset))
                edge: number = Math.abs(height) * (1 - r / radius)
                edge_in: number = Math.abs(height) * (1 - (r - 0.5) / radius)
                edge_out: number = Math.abs(height) * (1 - (r + 0.5) / radius)
                if r <= radius + 0.5 and ((edge >= Math.abs(z) - 0.5 and edge < Math.abs(z) + 0.5) or (edge_in >= Math.abs(z) and edge_out < Math.abs(z))) {
                    if found == index {
                        if direction == 0 {
                            result.set(Vec3.new(z, x, y))
                        } else if direction == 1 {
                            result.set(Vec3.new(x, z, y))
                        } else {
                            result.set(Vec3.new(x, y, z))
                        }
                        return result
                    }
                    found = found + 1
                }
                z = z + 1
            }
            y = y + 1
        }
        x = x + 1
    }
    return result
}

# ShapeCuboid: the faces walls names of the box from the origin to (dx, dy, dz).
local _cell_cuboid(dx: number, dy: number, dz: number, walls: number, centred_origin: bool, index: number) Option[Vec3] {
    result: Option[Vec3] = Option.new()
    lower_x: number = 0
    lower_y: number = 0
    lower_z: number = 0
    upper_x: number = 0
    upper_y: number = 0
    upper_z: number = 0
    if centred_origin {
        lower_x = -Math.abs(dx) + 1
        lower_y = -Math.abs(dy) + 1
        lower_z = -Math.abs(dz) + 1
        upper_x = Math.abs(dx)
        upper_y = Math.abs(dy)
        upper_z = Math.abs(dz)
    } else {
        if dx > 0 {
            lower_x = 0
            upper_x = dx
        } else {
            lower_x = dx + 1
            upper_x = 1
        }
        if dy > 0 {
            lower_y = 0
            upper_y = dy
        } else {
            lower_y = dy + 1
            upper_y = 1
        }
        if dz > 0 {
            lower_z = 0
            upper_z = dz
        } else {
            lower_z = dz + 1
            upper_z = 1
        }
    }
    found: number = 0
    x: number = lower_x
    while x < upper_x {
        if found == index {
            result.set(Vec3.new(x, lower_y, lower_z))
            return result
        }
        found = found + 1
        if upper_y - lower_y > 1 {
            if found == index {
                result.set(Vec3.new(x, upper_y - 1, lower_z))
                return result
            }
            found = found + 1
        }
        if upper_z - lower_z > 1 {
            if found == index {
                result.set(Vec3.new(x, lower_y, upper_z - 1))
                return result
            }
            found = found + 1
        }
        if upper_y - lower_y > 1 and upper_z - lower_z > 1 {
            if found == index {
                result.set(Vec3.new(x, upper_y - 1, upper_z - 1))
                return result
            }
            found = found + 1
        }
        x = x + 1
    }
    y: number = lower_y + 1
    while y < upper_y - 1 {
        if found == index {
            result.set(Vec3.new(lower_x, y, lower_z))
            return result
        }
        found = found + 1
        if upper_x - lower_x > 1 {
            if found == index {
                result.set(Vec3.new(upper_x - 1, y, lower_z))
                return result
            }
            found = found + 1
        }
        if upper_z - lower_z > 1 {
            if found == index {
                result.set(Vec3.new(lower_x, y, upper_z - 1))
                return result
            }
            found = found + 1
        }
        if upper_x - lower_x > 1 and upper_z - lower_z > 1 {
            if found == index {
                result.set(Vec3.new(upper_x - 1, y, upper_z - 1))
                return result
            }
            found = found + 1
        }
        y = y + 1
    }
    z: number = lower_z + 1
    while z < upper_z - 1 {
        if found == index {
            result.set(Vec3.new(lower_x, lower_y, z))
            return result
        }
        found = found + 1
        if upper_x - lower_x > 1 {
            if found == index {
                result.set(Vec3.new(upper_x - 1, lower_y, z))
                return result
            }
            found = found + 1
        }
        if upper_y - lower_y > 1 {
            if found == index {
                result.set(Vec3.new(lower_x, upper_y - 1, z))
                return result
            }
            found = found + 1
        }
        if upper_x - lower_x > 1 and upper_y - lower_y > 1 {
            if found == index {
                result.set(Vec3.new(upper_x - 1, upper_y - 1, z))
                return result
            }
            found = found + 1
        }
        z = z + 1
    }
    if walls == 0 or walls == 1 or walls == 4 or walls == 5 {
        y = lower_y + 1
        while y < upper_y - 1 {
            z = lower_z + 1
            while z < upper_z - 1 {
                if found == index {
                    result.set(Vec3.new(lower_x, y, z))
                    return result
                }
                found = found + 1
                if upper_x - lower_x > 1 {
                    if found == index {
                        result.set(Vec3.new(upper_x - 1, y, z))
                        return result
                    }
                    found = found + 1
                }
                z = z + 1
            }
            y = y + 1
        }
    }
    if walls == 0 or walls == 2 or walls == 4 or walls == 6 {
        x = lower_x + 1
        while x < upper_x - 1 {
            z = lower_z + 1
            while z < upper_z - 1 {
                if found == index {
                    result.set(Vec3.new(x, lower_y, z))
                    return result
                }
                found = found + 1
                if upper_y - lower_y > 1 {
                    if found == index {
                        result.set(Vec3.new(x, upper_y - 1, z))
                        return result
                    }
                    found = found + 1
                }
                z = z + 1
            }
            x = x + 1
        }
    }
    if walls == 0 or walls == 3 or walls == 5 or walls == 6 {
        x = lower_x + 1
        while x < upper_x - 1 {
            y = lower_y + 1
            while y < upper_y - 1 {
                if found == index {
                    result.set(Vec3.new(x, y, lower_z))
                    return result
                }
                found = found + 1
                if upper_z - lower_z > 1 {
                    if found == index {
                        result.set(Vec3.new(x, y, upper_z - 1))
                        return result
                    }
                    found = found + 1
                }
                y = y + 1
            }
            x = x + 1
        }
    }
    return result
}

# ShapeEllipse: a ring of an ellipse with semi-axes semi_y and semi_z, depth deep.
local _cell_ellipse(direction: number, semi_y: number, semi_z: number, depth: number, even_mode: bool, index: number) Option[Vec3] {
    result: Option[Vec3] = Option.new()
    offset: number = 0
    if even_mode {
        offset = 0.5
    }
    a_lower: number = Math.floor(-semi_y + offset)
    a_upper: number = Math.ceil(semi_y + offset)
    b_lower: number = Math.floor(-semi_z + offset)
    b_upper: number = Math.ceil(semi_z + offset)
    s_start: number = 0
    s_end: number = depth
    if depth <= 0 {
        s_start = depth + 1
        s_end = 1
    }
    found: number = 0
    a: number = a_lower
    while a <= a_upper {
        b: number = b_lower
        while b <= b_upper {
            theta: number = Math.atan2(semi_y / semi_z * (b - offset), a - offset)
            corr: number = Math.sqrt(1 + (semi_y * semi_y / semi_z / semi_z - 1) * Math.sin(theta) * Math.sin(theta))
            dra: number = 0.5 * Math.cos(theta) / corr
            drb: number = 0.5 * Math.sin(theta) * semi_y / semi_z / corr
            r2_inner: number = (a - offset - dra) * (a - offset - dra) / semi_y / semi_y + (b - offset - drb) * (b - offset - drb) / semi_z / semi_z
            r2_outer: number = (a - offset + dra) * (a - offset + dra) / semi_y / semi_y + (b - offset + drb) * (b - offset + drb) / semi_z / semi_z
            skip: bool = false
            if not (r2_outer >= 1 and r2_inner <= 1) and a - offset != 0 and b - offset != 0 {
                skip = true
            }
            if a - offset == 0 and Math.abs(b - offset) != semi_z {
                theta2: number = Math.atan2(semi_y / semi_z * b - offset, 1)
                corr2: number = Math.sqrt(1 + (semi_y * semi_y / semi_z / semi_z - 1) * Math.sin(theta2) * Math.sin(theta2))
                dra2: number = 0.5 * Math.cos(theta2) / corr2
                drb2: number = 0.5 * Math.sin(theta2) * semi_y / semi_z / corr2
                r2_inner2: number = (1 - dra2) * (1 - dra2) / semi_y / semi_y + (b - offset - drb2) * (b - offset - drb2) / semi_z / semi_z
                r2_outer2: number = (1 + dra2) * (1 + dra2) / semi_y / semi_y + (b - offset + drb2) * (b - offset + drb2) / semi_z / semi_z
                if (r2_outer2 >= 1 and r2_inner2 <= 1) or 1 / semi_y / semi_y + (b - offset) * (b - offset) / semi_z / semi_z < 1 {
                    skip = true
                }
            }
            if b - offset == 0 and Math.abs(a - offset) != semi_y {
                theta2: number = Math.atan2(semi_y / semi_z, a - offset)
                corr2: number = Math.sqrt(1 + (semi_y * semi_y / semi_z / semi_z - 1) * Math.sin(theta2) * Math.sin(theta2))
                dra2: number = 0.5 * Math.cos(theta2) / corr2
                drb2: number = 0.5 * Math.sin(theta2) * semi_y / semi_z / corr2
                r2_inner2: number = (a - offset - dra2) * (a - offset - dra2) / semi_y / semi_y + (1 - drb2) * (1 - drb2) / semi_z / semi_z
                r2_outer2: number = (a - offset + dra2) * (a - offset + dra2) / semi_y / semi_y + (1 + drb2) * (1 + drb2) / semi_z / semi_z
                if (r2_outer2 >= 1 and r2_inner2 <= 1) or (a - offset) * (a - offset) / semi_y / semi_y + 1 / semi_z / semi_z < 1 {
                    skip = true
                }
            }
            if not skip {
                s: number = s_start
                while s < s_end {
                    if found == index {
                        if direction == 0 {
                            result.set(Vec3.new(s, a, b))
                        } else if direction == 1 {
                            result.set(Vec3.new(a, s, b))
                        } else {
                            result.set(Vec3.new(a, b, s))
                        }
                        return result
                    }
                    found = found + 1
                    s = s + 1
                }
            }
            b = b + 1
        }
        a = a + 1
    }
    return result
}

# ShapeEllipsoid: an ellipsoid with semi-axes semi_x, semi_y and semi_z, optionally a dome.
local _cell_ellipsoid(semi_x: number, semi_y: number, semi_z: number, dome: number, even_mode: bool, index: number) Option[Vec3] {
    result: Option[Vec3] = Option.new()
    offset: number = 0
    if even_mode {
        offset = 0.5
    }
    x_start: number = 0
    x_end: number = 0
    if dome == 1 {
        x_start = 0.5 + offset
    } else {
        x_start = -semi_x + offset
    }
    if dome == 4 {
        x_end = -0.5 + offset
    } else {
        x_end = semi_x + offset
    }
    y_start: number = 0
    y_end: number = 0
    if dome == 2 {
        y_start = 0.5 + offset
    } else {
        y_start = -semi_y + offset
    }
    if dome == 5 {
        y_end = -0.5 + offset
    } else {
        y_end = semi_y + offset
    }
    z_start: number = 0
    z_end: number = 0
    if dome == 3 {
        z_start = 0.5 + offset
    } else {
        z_start = -semi_z + offset
    }
    if dome == 6 {
        z_end = -0.5 + offset
    } else {
        z_end = semi_z + offset
    }
    x_lower: number = Math.floor(x_start)
    x_upper: number = Math.ceil(x_end)
    y_lower: number = Math.floor(y_start)
    y_upper: number = Math.ceil(y_end)
    z_lower: number = Math.floor(z_start)
    z_upper: number = Math.ceil(z_end)
    found: number = 0
    x: number = x_lower
    while x <= x_upper {
        y: number = y_lower
        while y <= y_upper {
            z: number = z_lower
            while z <= z_upper {
                phi: number = Math.atan2(semi_x / semi_y * (y - offset), x - offset)
                theta: number = Math.atan2(Math.sqrt((x - offset) * (x - offset) + semi_x * semi_x / semi_y / semi_y * (y - offset) * (y - offset)), semi_x / semi_z * (z - offset))
                corr: number = Math.sqrt(1 + (semi_x * semi_x / semi_y / semi_y - 1) * Math.sin(phi) * Math.sin(phi) * Math.sin(theta) * Math.sin(theta) + (semi_x * semi_x / semi_z / semi_z - 1) * Math.cos(theta) * Math.cos(theta))
                drx: number = 0.5 * Math.cos(phi) * Math.sin(theta) / corr
                dry: number = 0.5 * Math.sin(phi) * Math.sin(theta) * semi_x / semi_y / corr
                drz: number = 0.5 * Math.cos(theta) * semi_x / semi_z / corr
                r2_inner: number = (x - offset - drx) * (x - offset - drx) / semi_x / semi_x + (y - offset - dry) * (y - offset - dry) / semi_y / semi_y + (z - offset - drz) * (z - offset - drz) / semi_z / semi_z
                r2_outer: number = (x - offset + drx) * (x - offset + drx) / semi_x / semi_x + (y - offset + dry) * (y - offset + dry) / semi_y / semi_y + (z - offset + drz) * (z - offset + drz) / semi_z / semi_z
                if r2_outer >= 1 and r2_inner <= 1 {
                    if found == index {
                        result.set(Vec3.new(x, y, z))
                        return result
                    }
                    found = found + 1
                }
                z = z + 1
            }
            y = y + 1
        }
        x = x + 1
    }
    return result
}

# ShapeGrid: steps_x by steps_y by steps_z cells, every offset apart on each axis.
local _cell_grid(steps_x: number, steps_y: number, steps_z: number, offset_x: number, offset_y: number, offset_z: number, index: number) Option[Vec3] {
    result: Option[Vec3] = Option.new()
    found: number = 0
    x: number = 0
    while x < steps_x {
        y: number = 0
        while y < steps_y {
            z: number = 0
            while z < steps_z {
                if found == index {
                    result.set(Vec3.new(x * offset_x, y * offset_y, z * offset_z))
                    return result
                }
                found = found + 1
                z = z + 1
            }
            y = y + 1
        }
        x = x + 1
    }
    return result
}

# ShapeHelix: a helix wound around the direction axis, from inner_radius to outer_radius.
local _cell_helix(direction: number, outer_radius: number, inner_radius: number, height: number, degrees: number, degrees_offset: number, invert: bool, even_mode: bool, index: number) Option[Vec3] {
    result: Option[Vec3] = Option.new()
    turns: number = _trunc(Math.ceil(degrees / 360))
    height_per_turn: number = 360 * (height + 1) / degrees
    if height > 0 {
        height_per_turn = 360 * (height - 1) / degrees
    }
    inv: bool = invert
    if height > 0 {
        inv = not inv
    }
    offset: number = 0
    if even_mode {
        offset = 0.5
    }
    lower: number = Math.floor(-outer_radius + offset)
    upper: number = Math.ceil(outer_radius + offset)
    z_start: number = 0
    z_end: number = 1
    if height > 0 {
        z_end = height
    } else {
        z_start = height + 1
    }
    found: number = 0
    x: number = lower
    while x <= upper {
        y: number = lower
        while y <= upper {
            r2: number = (x - offset) * (x - offset) + (y - offset) * (y - offset)
            if not (r2 < (inner_radius - 0.5) * (inner_radius - 0.5)) and not (r2 > (outer_radius - 0.5) * (outer_radius - 0.5)) {
                sign: number = 1
                if inv {
                    sign = -1
                }
                theta: number = sign * (Math.toDegrees(Math.atan2(y - offset, x - offset)) - degrees_offset)
                dtheta: number = Math.toDegrees(0.5 / Math.sqrt(r2))
                gradient: number = Math.abs(height_per_turn / (2 * Math.pi() * Math.sqrt(r2)))
                z: number = z_start
                while z < z_end {
                    i: number = -1
                    while i <= turns {
                        hit: bool = false
                        if gradient <= 1 {
                            helix_height: number = (theta / 360 + i) * height_per_turn
                            if helix_height >= z - 0.5 and helix_height < z + 0.5 {
                                angle: number = theta + i * 360
                                if not (angle < Math.min(0, degrees)) and not (angle > Math.max(0, degrees)) {
                                    hit = true
                                }
                            }
                        } else {
                            left: number = ((theta - dtheta) / 360 + i) * height_per_turn
                            right: number = ((theta + dtheta) / 360 + i) * height_per_turn
                            if Math.min(left, right) < z + 0.5 and Math.max(left, right) >= z - 0.5 {
                                angle: number = theta + i * 360
                                if not (angle < Math.min(0, degrees) - dtheta) and not (angle > Math.max(0, degrees) + dtheta) {
                                    hit = true
                                }
                            }
                        }
                        if hit {
                            if found == index {
                                if direction == 0 {
                                    result.set(Vec3.new(z, x, y))
                                } else if direction == 1 {
                                    result.set(Vec3.new(x, z, y))
                                } else {
                                    result.set(Vec3.new(x, y, z))
                                }
                                return result
                            }
                            found = found + 1
                            break
                        }
                        i = i + 1
                    }
                    z = z + 1
                }
            }
            y = y + 1
        }
        x = x + 1
    }
    return result
}

# ShapeLine: a line of cells from the origin to (dx, dy, dz).
local _cell_line(dx: number, dy: number, dz: number, index: number) Option[Vec3] {
    result: Option[Vec3] = Option.new()
    d: number = _trunc(Math.max(Math.max(Math.abs(dx), Math.abs(dy)), Math.abs(dz)))
    unit_x: number = dx / d
    unit_y: number = dy / d
    unit_z: number = dz / d
    found: number = 0
    i: number = 0
    while i <= d {
        if found == index {
            result.set(Vec3.new(_trunc(unit_x * i + 0.5 * Math.signum(dx)), _trunc(unit_y * i + 0.5 * Math.signum(dy)), _trunc(unit_z * i + 0.5 * Math.signum(dz))))
            return result
        }
        found = found + 1
        i = i + 1
    }
    return result
}

# ShapeParabola: the parabolic arc a side of halfwidth wide and height tall, depth deep.
local _cell_parabola(direction: number, rotation: number, halfwidth: number, height: number, depth: number, even_mode: bool, index: number) Option[Vec3] {
    result: Option[Vec3] = Option.new()
    offset: number = 0
    if even_mode {
        offset = 0.5
    }
    fac: number = height / halfwidth / halfwidth
    lower: number = Math.floor(-halfwidth + offset)
    upper: number = Math.ceil(halfwidth + offset)
    s_start: number = 0
    s_end: number = depth
    if depth <= 0 {
        s_start = depth + 1
        s_end = 1
    }
    found: number = 0
    a: number = lower
    while a <= upper {
        b: number = 0
        while b < height {
            term: number = fac * (a - offset) * (a - offset)
            inner: number = fac * (a - offset - Math.signum(a - offset)) * (a - offset - Math.signum(a - offset))
            if term >= b and (inner < b or term < b + 1) {
                s: number = s_start
                while s < s_end {
                    if found == index {
                        sideways: number = b * _rot_xx(rotation) + a * _rot_yx(rotation)
                        across: number = a * _rot_xx(rotation) + b * _rot_xy(rotation)
                        if direction == 0 {
                            result.set(Vec3.new(s, sideways, across))
                        } else if direction == 1 {
                            result.set(Vec3.new(sideways, s, across))
                        } else {
                            result.set(Vec3.new(across, sideways, s))
                        }
                        return result
                    }
                    found = found + 1
                    s = s + 1
                }
            }
            b = b + 1
        }
        a = a + 1
    }
    return result
}

# ShapeParaboloid: the paraboloid a halfwidth_y by halfwidth_z bowl, height tall.
local _cell_paraboloid(direction: number, halfwidth_y: number, halfwidth_z: number, height: number, even_mode: bool, index: number) Option[Vec3] {
    result: Option[Vec3] = Option.new()
    offset: number = 0
    if even_mode {
        offset = 0.5
    }
    fac_y: number = Math.abs(height) / halfwidth_y / halfwidth_y
    fac_z: number = Math.abs(height) / halfwidth_z / halfwidth_z
    a_lower: number = Math.floor(-halfwidth_y + offset)
    a_upper: number = Math.ceil(halfwidth_y + offset)
    b_lower: number = Math.floor(-halfwidth_z + offset)
    b_upper: number = Math.ceil(halfwidth_z + offset)
    found: number = 0
    a: number = a_lower
    while a <= a_upper {
        b: number = b_lower
        while b <= b_upper {
            c: number = 0
            while c < Math.abs(height) {
                term: number = fac_y * (a - offset) * (a - offset) + fac_z * (b - offset) * (b - offset)
                along_a: number = fac_y * (a - offset - Math.signum(a - offset)) * (a - offset - Math.signum(a - offset)) + fac_z * (b - offset) * (b - offset)
                along_b: number = fac_y * (a - offset) * (a - offset) + fac_z * (b - offset - Math.signum(b - offset)) * (b - offset - Math.signum(b - offset))
                if term >= c and (along_a < c or along_b < c or term < c + 1) {
                    if found == index {
                        height_cell: number = _trunc(c * Math.signum(height))
                        if direction == 0 {
                            result.set(Vec3.new(height_cell, a, b))
                        } else if direction == 1 {
                            result.set(Vec3.new(a, height_cell, b))
                        } else {
                            result.set(Vec3.new(a, b, height_cell))
                        }
                        return result
                    }
                    found = found + 1
                }
                c = c + 1
            }
            b = b + 1
        }
        a = a + 1
    }
    return result
}

# ShapePolygon: the outline of a regular polygon of sides sides, radius out.
local _cell_polygon(sides: number, radius: number, direction: number, rotation: number, depth: number, even_mode: bool, index: number) Option[Vec3] {
    result: Option[Vec3] = Option.new()
    offset: number = 0
    if even_mode {
        offset = 0.5
    }
    max_r: number = _trunc(Math.ceil((radius + offset) / Math.cos(Math.pi() / sides)))
    h_start: number = 0
    h_end: number = depth
    if depth <= 0 {
        h_start = depth + 1
        h_end = 1
    }
    found: number = 0
    a: number = -max_r
    while a <= max_r {
        b: number = -max_r
        while b <= max_r {
            theta: number = Math.atan2(b - offset, a - offset) + Math.pi()
            if theta < 0 {
                theta = theta + 2 * Math.pi()
            }
            i: number = _trunc(sides * theta / 2 / Math.pi() + 0.5)
            edge: number = (a - offset) * Math.cos(2 * i * Math.pi() / sides - Math.pi()) + (b - offset) * Math.sin(2 * i * Math.pi() / sides - Math.pi()) - radius + 0.0000000001
            if edge >= -0.5 and edge < 0.5 {
                h: number = h_start
                while h < h_end {
                    if found == index {
                        sideways: number = a * _rot_xx(rotation) + b * _rot_yx(rotation)
                        across: number = b * _rot_xx(rotation) + a * _rot_xy(rotation)
                        if direction == 0 {
                            result.set(Vec3.new(h, sideways, across))
                        } else if direction == 1 {
                            result.set(Vec3.new(sideways, h, across))
                        } else {
                            result.set(Vec3.new(across, sideways, h))
                        }
                        return result
                    }
                    found = found + 1
                    h = h + 1
                }
            }
            b = b + 1
        }
        a = a + 1
    }
    return result
}

# ShapePolygonalPyramid: a pyramid of sides sides, radius wide at its base and height tall.
local _cell_pyramid(sides: number, radius: number, direction: number, rotation: number, height: number, even_mode: bool, index: number) Option[Vec3] {
    result: Option[Vec3] = Option.new()
    offset: number = 0
    if even_mode {
        offset = 0.5
    }
    h_start: number = 0
    h_end: number = 1
    if height > 0 {
        h_end = Math.ceil(height)
    } else {
        h_start = Math.floor(height + 1)
    }
    absolute_height: number = Math.abs(height)
    found: number = 0
    h: number = h_start
    while h < h_end {
        r: number = (radius + 1) * Math.max(absolute_height - Math.abs(h), 0) / absolute_height - 1
        r_next: number = (radius + 1) * Math.max(absolute_height - Math.abs(h) - 1, 0) / absolute_height - 1
        max_r: number = _trunc(Math.ceil((r + offset) / Math.cos(Math.pi() / sides)))
        a: number = -max_r
        while a <= max_r {
            b: number = -max_r
            while b <= max_r {
                theta: number = Math.atan2(b - offset, a - offset) + Math.pi()
                if theta < 0 {
                    theta = theta + 2 * Math.pi()
                }
                i: number = _trunc(sides * theta / 2 / Math.pi() + 0.5)
                inner: number = (a - offset) * Math.cos(2 * i * Math.pi() / sides - Math.pi()) + (b - offset) * Math.sin(2 * i * Math.pi() / sides - Math.pi()) + 0.0000000001
                on_edge: bool = false
                if (inner - r_next >= 0.5 and absolute_height <= radius + 1) or (inner - r >= -0.5 and absolute_height >= radius + 1) {
                    if inner - r < 0.5 and theta >= (2 * i - 1) * Math.pi() / sides and theta < (2 * i + 1) * Math.pi() / sides {
                        on_edge = true
                    }
                }
                if on_edge {
                    if found == index {
                        sideways: number = a * _rot_xx(rotation) + b * _rot_yx(rotation)
                        across: number = b * _rot_xx(rotation) + a * _rot_xy(rotation)
                        if direction == 0 {
                            result.set(Vec3.new(h, sideways, across))
                        } else if direction == 1 {
                            result.set(Vec3.new(sideways, h, across))
                        } else {
                            result.set(Vec3.new(across, sideways, h))
                        }
                        return result
                    }
                    found = found + 1
                }
                b = b + 1
            }
            a = a + 1
        }
        h = h + 1
    }
    return result
}

# ShapeSphere: a shell of cells radius out, optionally a dome.
local _cell_sphere(radius: number, dome: number, even_mode: bool, index: number) Option[Vec3] {
    result: Option[Vec3] = Option.new()
    offset: number = 0
    if even_mode {
        offset = 0.5
    }
    x_start: number = 0
    x_end: number = 0
    if dome == 1 {
        x_start = 0.5 + offset
    } else {
        x_start = -radius + offset
    }
    if dome == 4 {
        x_end = -0.5 + offset
    } else {
        x_end = radius + offset
    }
    y_start: number = 0
    y_end: number = 0
    if dome == 2 {
        y_start = 0.5 + offset
    } else {
        y_start = -radius + offset
    }
    if dome == 5 {
        y_end = -0.5 + offset
    } else {
        y_end = radius + offset
    }
    z_start: number = 0
    z_end: number = 0
    if dome == 3 {
        z_start = 0.5 + offset
    } else {
        z_start = -radius + offset
    }
    if dome == 6 {
        z_end = -0.5 + offset
    } else {
        z_end = radius + offset
    }
    x_lower: number = Math.floor(x_start)
    x_upper: number = Math.ceil(x_end)
    y_lower: number = Math.floor(y_start)
    y_upper: number = Math.ceil(y_end)
    z_lower: number = Math.floor(z_start)
    z_upper: number = Math.ceil(z_end)
    found: number = 0
    x: number = x_lower
    while x <= x_upper {
        y: number = y_lower
        while y <= y_upper {
            z: number = z_lower
            while z <= z_upper {
                r2: number = (x - offset) * (x - offset) + (y - offset) * (y - offset) + (z - offset) * (z - offset)
                if r2 >= (radius - 0.5) * (radius - 0.5) and r2 <= (radius + 0.5) * (radius + 0.5) {
                    if found == index {
                        result.set(Vec3.new(x, y, z))
                        return result
                    }
                    found = found + 1
                }
                z = z + 1
            }
            y = y + 1
        }
        x = x + 1
    }
    return result
}

# ShapeTorus: a torus of outer_radius around the direction axis, the tube inner_radius thick.
local _cell_torus(direction: number, outer_radius: number, inner_radius: number, outer_even_mode: bool, inner_even_mode: bool, index: number) Option[Vec3] {
    result: Option[Vec3] = Option.new()
    outer_offset: number = 0
    if outer_even_mode {
        outer_offset = 0.5
    }
    inner_offset: number = 0
    if inner_even_mode {
        inner_offset = 0.5
    }
    a_lower: number = Math.floor(-outer_radius - inner_radius - outer_offset)
    a_upper: number = Math.ceil(outer_radius + inner_radius + 1 + outer_offset)
    c_lower: number = Math.floor(-inner_radius + inner_offset)
    c_upper: number = Math.ceil(inner_radius + 1 + inner_offset)
    found: number = 0
    a: number = a_lower
    while a < a_upper {
        b: number = a_lower
        while b < a_upper {
            theta: number = Math.atan2(b - outer_offset, a - outer_offset)
            ring_a: number = outer_radius * Math.cos(theta) + outer_offset
            ring_b: number = outer_radius * Math.sin(theta) + outer_offset
            c: number = c_lower
            while c < c_upper {
                r2: number = (a - ring_a) * (a - ring_a) + (b - ring_b) * (b - ring_b) + (c - inner_offset) * (c - inner_offset)
                if r2 >= (inner_radius - 0.5) * (inner_radius - 0.5) and r2 < (inner_radius + 0.5) * (inner_radius + 0.5) {
                    if found == index {
                        if direction == 0 {
                            result.set(Vec3.new(c, b, a))
                        } else if direction == 1 {
                            result.set(Vec3.new(a, c, b))
                        } else {
                            result.set(Vec3.new(b, a, c))
                        }
                        return result
                    }
                    found = found + 1
                }
                c = c + 1
            }
            b = b + 1
        }
        a = a + 1
    }
    return result
}

local _origin_catenary() Vec3 {
    return Vec3.new(0, 0, 0)
}

local _origin_circle(direction: number, even_mode: bool) Vec3 {
    return _origin_dir(direction, even_mode)
}

local _origin_cone(direction: number, even_mode: bool) Vec3 {
    return _origin_dir(direction, even_mode)
}

local _origin_cuboid() Vec3 {
    return Vec3.new(0, 0, 0)
}

local _origin_ellipse(direction: number, even_mode: bool) Vec3 {
    return _origin_dir(direction, even_mode)
}

local _origin_ellipsoid(even_mode: bool) Vec3 {
    offset: number = 0
    if even_mode {
        offset = 0.5
    }
    return Vec3.new(offset, offset, offset)
}

local _origin_grid() Vec3 {
    return Vec3.new(0, 0, 0)
}

local _origin_helix(direction: number, even_mode: bool) Vec3 {
    return _origin_dir(direction, even_mode)
}

local _origin_line() Vec3 {
    return Vec3.new(0, 0, 0)
}

local _origin_parabola(direction: number, rotation: number, even_mode: bool) Vec3 {
    offset: number = 0
    if even_mode {
        offset = 0.5
    }
    if direction == 0 {
        return Vec3.new(0, offset * _rot_yx(rotation), offset * _rot_xx(rotation))
    }
    if direction == 1 {
        return Vec3.new(offset * _rot_yx(rotation), 0, offset * _rot_xx(rotation))
    }
    return Vec3.new(offset * _rot_xx(rotation), offset * _rot_yx(rotation), 0)
}

local _origin_paraboloid(direction: number, even_mode: bool) Vec3 {
    return _origin_dir(direction, even_mode)
}

local _origin_polygon(direction: number, even_mode: bool) Vec3 {
    return _origin_dir(direction, even_mode)
}

local _origin_pyramid(direction: number, even_mode: bool) Vec3 {
    return _origin_dir(direction, even_mode)
}

local _origin_sphere(even_mode: bool) Vec3 {
    offset: number = 0
    if even_mode {
        offset = 0.5
    }
    return Vec3.new(offset, offset, offset)
}

local _origin_torus(direction: number, outer_even_mode: bool, inner_even_mode: bool) Vec3 {
    outer: number = 0
    if outer_even_mode {
        outer = 0.5
    }
    inner: number = 0
    if inner_even_mode {
        inner = 0.5
    }
    if direction == 0 {
        return Vec3.new(inner, outer, outer)
    }
    if direction == 1 {
        return Vec3.new(outer, inner, outer)
    }
    return Vec3.new(outer, outer, inner)
}

# Java's (int) cast: it truncates towards zero, and NaN becomes 0, which a line with no delta needs
# because it divides 0 by 0.
local _trunc(value: number) number {
    if not (value == value) {
        return 0
    }
    rounded: number = Math.floor(value)
    if value < 0 {
        rounded = Math.ceil(value)
    }
    # A Java (int) cast saturates at the int range, so a derived height or cell coordinate that
    # leaves that range stays at the edge the reference would use.
    if rounded > 2147483647 {
        return 2147483647
    }
    if rounded < -2147483648 {
        return -2147483648
    }
    if rounded < 1 and rounded > -1 {
        return 0
    }
    return rounded
}

# x - x is 0 for every finite value and NaN for an infinity or a NaN, which is the isFinite test
# the reference applies to its catenary solve.
local _finite(value: number) bool {
    return Math.abs(value) - Math.abs(value) == 0
}

local _origin_dir(direction: number, even_mode: bool) Vec3 {
    offset: number = 0
    if even_mode {
        offset = 0.5
    }
    if direction == 0 {
        return Vec3.new(0, offset, offset)
    }
    if direction == 1 {
        return Vec3.new(offset, 0, offset)
    }
    return Vec3.new(offset, offset, 0)
}

local _rot_xx(rotation: number) number {
    if rotation == 0 {
        return 1
    }
    if rotation == 2 {
        return -1
    }
    return 0
}

local _rot_xy(rotation: number) number {
    if rotation == 1 {
        return -1
    }
    if rotation == 3 {
        return 1
    }
    return 0
}

local _rot_yx(rotation: number) number {
    if rotation == 1 {
        return 1
    }
    if rotation == 3 {
        return -1
    }
    return 0
}
