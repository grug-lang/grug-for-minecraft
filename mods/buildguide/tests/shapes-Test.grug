    ctx.assert(Math.abs(cell_5.unwrap().z() - 0) == 0, "grid_2_3_1 cell 5 z should be 0.")
}

# grid_empty
# A grid's step counts are a PropertyPositiveInt with a minimum of 1, so a grid always emits at
# least one cell and no empty case exists to test. The smallest reachable grid is one cell.
local _assert_grid_one_cell(ctx: TestTickContext) {
    ctx.assert(not _cell_grid(1, 1, 1, 1, 1, 1, 1).has(), "grid_one_cell should have 1 cell.")
    cell_0: Option[Vec3] = _cell_grid(1, 1, 1, 1, 1, 1, 0)
    ctx.assert(Math.abs(cell_0.unwrap().x() - 0) == 0, "grid_one_cell cell 0 x should be 0.")
    ctx.assert(Math.abs(cell_0.unwrap().y() - 0) == 0, "grid_one_cell cell 0 y should be 0.")
    ctx.assert(Math.abs(cell_0.unwrap().z() - 0) == 0, "grid_one_cell cell 0 z should be 0.")
}

# helix_default
local _assert_helix_default(ctx: TestTickContext) {
    ctx.assert(not _cell_helix(1, 5, 3, 5, 360, 0, false, false, 50).has(), "helix_default should have 50 cells.")
    cell_0: Option[Vec3] = _cell_helix(1, 5, 3, 5, 360, 0, false, false, 0)
    ctx.assert(Math.abs(cell_0.unwrap().x() - -4) == 0, "helix_default cell 0 x should be -4.")
    ctx.assert(Math.abs(cell_0.unwrap().y() - 2) == 0, "helix_default cell 0 y should be 2.")
    ctx.assert(Math.abs(cell_0.unwrap().z() - -2) == 0, "helix_default cell 0 z should be -2.")
    cell_1: Option[Vec3] = _cell_helix(1, 5, 3, 5, 360, 0, false, false, 1)
    ctx.assert(Math.abs(cell_1.unwrap().x() - -4) == 0, "helix_default cell 1 x should be -4.")
    ctx.assert(Math.abs(cell_1.unwrap().y() - 2) == 0, "helix_default cell 1 y should be 2.")
    ctx.assert(Math.abs(cell_1.unwrap().z() - -1) == 0, "helix_default cell 1 z should be -1.")
    cell_25: Option[Vec3] = _cell_helix(1, 5, 3, 5, 360, 0, false, false, 25)
    ctx.assert(Math.abs(cell_25.unwrap().x() - 0) == 0, "helix_default cell 25 x should be 0.")
    ctx.assert(Math.abs(cell_25.unwrap().y() - 3) == 0, "helix_default cell 25 y should be 3.")
    ctx.assert(Math.abs(cell_25.unwrap().z() - 4) == 0, "helix_default cell 25 z should be 4.")
    cell_48: Option[Vec3] = _cell_helix(1, 5, 3, 5, 360, 0, false, false, 48)
    ctx.assert(Math.abs(cell_48.unwrap().x() - 4) == 0, "helix_default cell 48 x should be 4.")
    ctx.assert(Math.abs(cell_48.unwrap().y() - 4) == 0, "helix_default cell 48 y should be 4.")
    ctx.assert(Math.abs(cell_48.unwrap().z() - 1) == 0, "helix_default cell 48 z should be 1.")
    cell_49: Option[Vec3] = _cell_helix(1, 5, 3, 5, 360, 0, false, false, 49)
    ctx.assert(Math.abs(cell_49.unwrap().x() - 4) == 0, "helix_default cell 49 x should be 4.")
    ctx.assert(Math.abs(cell_49.unwrap().y() - 4) == 0, "helix_default cell 49 y should be 4.")
    ctx.assert(Math.abs(cell_49.unwrap().z() - 2) == 0, "helix_default cell 49 z should be 2.")
}

