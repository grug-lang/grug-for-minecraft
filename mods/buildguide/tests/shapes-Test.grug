    cell_0: Option[Vec3] = _cell_cuboid(1, 1, 1, 0, false, 0)
    ctx.assert(Math.abs(cell_0.unwrap().x() - 0) == 0, "cuboid_one_cell cell 0 x should be 0.")
    ctx.assert(Math.abs(cell_0.unwrap().y() - 0) == 0, "cuboid_one_cell cell 0 y should be 0.")
    ctx.assert(Math.abs(cell_0.unwrap().z() - 0) == 0, "cuboid_one_cell cell 0 z should be 0.")
}

# ellipse_x_3_3
local _assert_ellipse_x_3_3(ctx: TestTickContext) {
    ctx.assert(not _cell_ellipse(0, 3, 3, 1, false, 16).has(), "ellipse_x_3_3 should have 16 cells.")
    cell_0: Option[Vec3] = _cell_ellipse(0, 3, 3, 1, false, 0)
    ctx.assert(Math.abs(cell_0.unwrap().x() - 0) == 0, "ellipse_x_3_3 cell 0 x should be 0.")
    ctx.assert(Math.abs(cell_0.unwrap().y() - -3) == 0, "ellipse_x_3_3 cell 0 y should be -3.")
    ctx.assert(Math.abs(cell_0.unwrap().z() - -1) == 0, "ellipse_x_3_3 cell 0 z should be -1.")
    cell_1: Option[Vec3] = _cell_ellipse(0, 3, 3, 1, false, 1)
    ctx.assert(Math.abs(cell_1.unwrap().x() - 0) == 0, "ellipse_x_3_3 cell 1 x should be 0.")
    ctx.assert(Math.abs(cell_1.unwrap().y() - -3) == 0, "ellipse_x_3_3 cell 1 y should be -3.")
    ctx.assert(Math.abs(cell_1.unwrap().z() - 0) == 0, "ellipse_x_3_3 cell 1 z should be 0.")
    cell_8: Option[Vec3] = _cell_ellipse(0, 3, 3, 1, false, 8)
    ctx.assert(Math.abs(cell_8.unwrap().x() - 0) == 0, "ellipse_x_3_3 cell 8 x should be 0.")
    ctx.assert(Math.abs(cell_8.unwrap().y() - 0) == 0, "ellipse_x_3_3 cell 8 y should be 0.")
    ctx.assert(Math.abs(cell_8.unwrap().z() - 3) == 0, "ellipse_x_3_3 cell 8 z should be 3.")
    cell_14: Option[Vec3] = _cell_ellipse(0, 3, 3, 1, false, 14)
    ctx.assert(Math.abs(cell_14.unwrap().x() - 0) == 0, "ellipse_x_3_3 cell 14 x should be 0.")
    ctx.assert(Math.abs(cell_14.unwrap().y() - 3) == 0, "ellipse_x_3_3 cell 14 y should be 3.")
    ctx.assert(Math.abs(cell_14.unwrap().z() - 0) == 0, "ellipse_x_3_3 cell 14 z should be 0.")
    cell_15: Option[Vec3] = _cell_ellipse(0, 3, 3, 1, false, 15)
    ctx.assert(Math.abs(cell_15.unwrap().x() - 0) == 0, "ellipse_x_3_3 cell 15 x should be 0.")
    ctx.assert(Math.abs(cell_15.unwrap().y() - 3) == 0, "ellipse_x_3_3 cell 15 y should be 3.")
    ctx.assert(Math.abs(cell_15.unwrap().z() - 1) == 0, "ellipse_x_3_3 cell 15 z should be 1.")
}

