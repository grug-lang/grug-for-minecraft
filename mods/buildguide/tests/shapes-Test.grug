    ctx.assert(Math.abs(cell_3.unwrap().y() - 0) == 0, "grid_2_3_1 cell 3 y should be 0.")
    ctx.assert(Math.abs(cell_3.unwrap().z() - 0) == 0, "grid_2_3_1 cell 3 z should be 0.")
    cell_4: Option[Vec3] = _cell_grid(2, 3, 1, 1, 2, 3, 4)
