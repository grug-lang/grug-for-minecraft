# Build Guide 0.4.9's fifteen shape generators, ported to grug for 1.20.6-forge (#1752 stage 1).
# The shapes are a pure function of their properties, so they are tested here, in the one file a
# grug test can call helpers from: a grug local function is visible only inside the file that
# defines it and the host cannot call it, so a generator under code/ could not be reached by any
# test. Stage 3 moves this library into the overlay that draws it, where captures take over.
# Every generator follows the reference's own loop and emits its cells in the reference's iteration
# order with duplicates kept, because both the state file and the drawing follow that order. A
# caller walks a shape by asking for index 0, 1, 2 and so on and stopping at the first `none`, which
# costs O(n^2) over a whole shape; that is a known stage 3 gap for large shapes.
# The goldens are the cells the reference's own loops emit, replayed by a throwaway Java driver that
# stayed outside the tree, with the reference's float properties widened to double. A golden read off
# the loop can only show a generator agrees with itself, so cells are also derived by hand from each
# shape's definition (a circle's axis points, a sphere's six neighbours, a torus's inner and outer
# ring at the same angle), and those tell a faithful shape apart from a consistently wrong one.
# Properties are passed in the reference class's declaration order, which is also the persisted
# comma order, with an enum as its ordinal in that enum's declaration order: direction X, Y, Z =
# 0, 1, 2; walls ALL, X, Y, Z, XY, XZ, YZ, NONE = 0..7; dome NO, POSITIVE_X, POSITIVE_Y, POSITIVE_Z,
# NEGATIVE_X, NEGATIVE_Y, NEGATIVE_Z = 0..6; rotation ROT0, ROT90, ROT180, ROT270 = 0..3. Catenary's
# and line's setEndpoint button carries no number (the state file keeps its "Runnable" text in stage
# 2), so it is not a parameter here. The reference's float properties become grug numbers, which
# are 64-bit doubles: no float32 rounding is emulated, so a value the reference derives through a
# float is derived here from the exact double, which is the port's documented one exception.
# The defaults, which the tests below pin, are the reference's, in declaration order:
#   catenary 3, 0, 0, 1, false            circle X, 3, 1, false
#   cone X, 3, 3, false                   cuboid 3, 3, 3, ALL, false
#   ellipse X, 3, 3, 1, false             ellipsoid 3, 3, 3, NO, false
#   grid 3, 1, 3, 3, 3, 3                 helix Y, 5, 3, 5, 360, 0, false, false
#   line 3, 0, 0                          parabola X, ROT0, 3, 3, 1, false
#   paraboloid X, 3, 3, 3, false          polygon 3, 3, X, ROT0, 1, false
#   pyramid 4, 3, Y, ROT0, 4, false       sphere 3, NO, false
#   torus X, 5, 3, false, false
# The origin functions answer where the reference draws the origin cube inside the block at the set
# origin: a shape whose cells sit half a block off the block corner moves its origin cube by half.

# Which case's assertions the next tick runs. The watcher's time limit is per grug call, not per
# test: on a loaded runner this file's fifteen shapes took 195 ms inside one tick and tripped the
# 100 ms limit (1.20.6-forge on a dedicated server, run 45547022140, job 138979658079), so each
# tick runs one case's assertions and asks to be called again for the next, in this order.
shape: number = 0

export tick(ctx: TestTickContext) {
    if shape == 0 {
        _assert_origins(ctx)
    } else if shape == 1 {
        _assert_catenary_default(ctx)
    } else if shape == 2 {
        _assert_catenary_dy2dz3(ctx)
    } else if shape == 3 {
        _assert_catenary_invert(ctx)
    } else if shape == 4 {
        _assert_catenary_vertical(ctx)
    } else if shape == 5 {
        _assert_catenary_non_finite(ctx)
    } else if shape == 6 {
        _assert_catenary_no_progress(ctx)
    } else if shape == 7 {
        _assert_circle_x_r3_d1(ctx)
    } else if shape == 8 {
        _assert_circle_x_r3_d2_even(ctx)
    } else if shape == 9 {
        _assert_circle_y_r4(ctx)
    } else if shape == 10 {
        _assert_circle_one_cell(ctx)
    } else if shape == 11 {
        _assert_cone_x_r3_h3(ctx)
    } else if shape == 12 {
        _assert_cone_x_r3_hm3(ctx)
    } else if shape == 13 {
        _assert_cone_z_r2_h4_even(ctx)
    } else if shape == 14 {
        _assert_cuboid_solid(ctx)
    } else if shape == 15 {
        _assert_cuboid_hollow(ctx)
    } else if shape == 16 {
        _assert_cuboid_neg_xy_centred(ctx)
    } else if shape == 17 {
        _assert_cuboid_one_cell(ctx)
    } else if shape == 18 {
        _assert_ellipse_x_3_3(ctx)
    } else if shape == 19 {
        _assert_ellipse_z_4_2_d2_even(ctx)
    } else if shape == 20 {
        _assert_ellipsoid_3_3_3(ctx)
    } else if shape == 21 {
        _assert_ellipsoid_4_2_3_domeY_even(ctx)
    } else if shape == 22 {
        _assert_grid(ctx)
    } else if shape == 23 {
        _assert_grid_2_3_1(ctx)
    } else if shape == 24 {
        _assert_grid_one_cell(ctx)
    } else if shape == 25 {
        _assert_helix_default(ctx)
    } else if shape == 26 {
        _assert_helix_neg_even(ctx)
    } else if shape == 27 {
        _assert_helix_x_720(ctx)
    } else if shape == 28 {
        _assert_line_x3(ctx)
    } else if shape == 29 {
        _assert_line_neg(ctx)
    } else if shape == 30 {
        _assert_line_1_1_1(ctx)
    } else if shape == 31 {
        _assert_parabola_x_r0(ctx)
    } else if shape == 32 {
        _assert_parabola_z_rot1_even(ctx)
    } else if shape == 33 {
        _assert_parabola_y_rot2(ctx)
    } else if shape == 34 {
        _assert_paraboloid_x(ctx)
    } else if shape == 35 {
        _assert_paraboloid_y_neg_even(ctx)
    } else if shape == 36 {
        _assert_polygon_3(ctx)
    } else if shape == 37 {
        _assert_polygon_5_z_rot1_even(ctx)
    } else if shape == 38 {
        _assert_pyramid_4(ctx)
    } else if shape == 39 {
        _assert_pyramid_3_x_rot2_even(ctx)
    } else if shape == 40 {
        _assert_sphere_r3(ctx)
    } else if shape == 41 {
        _assert_sphere_r3_domeY_even(ctx)
    } else if shape == 42 {
        _assert_sphere_one_cell(ctx)
    } else if shape == 43 {
        _assert_torus_x_count(ctx)
    } else if shape == 44 {
        _assert_torus_x_cells_0_1(ctx)
    } else if shape == 45 {
        _assert_torus_x_cell_274(ctx)
    } else if shape == 46 {
        _assert_torus_x_cell_505(ctx)
    } else if shape == 47 {
        _assert_torus_x_cell_546(ctx)
    } else if shape == 48 {
        _assert_torus_x_cell_547(ctx)
    } else if shape == 49 {
        _assert_torus_z_even_count(ctx)
    } else if shape == 50 {
        _assert_torus_z_even_cells_0_1_5(ctx)
    } else if shape == 51 {
        _assert_torus_z_even_cell_284(ctx)
    } else if shape == 52 {
        _assert_torus_z_even_cell_528(ctx)
    } else if shape == 53 {
        _assert_torus_z_even_cell_539(ctx)
    } else if shape == 54 {
        _assert_torus_z_even_cell_566(ctx)
    } else if shape == 55 {
        _assert_torus_z_even_cell_567(ctx)
    } else if shape == 56 {
        _assert_known_cells(ctx)
    }
    shape = shape + 1
    if shape < 57 {
        ctx.not_done()
    }
}

# The origin cube's local offset for a shape that only depends on which axis the shape opens along.
local _assert_origins(ctx: TestTickContext) {
    ctx.assert(_origin_catenary().x() == 0, "catenary origin x should be 0.")
    ctx.assert(_origin_catenary().y() == 0, "catenary origin y should be 0.")
    ctx.assert(_origin_catenary().z() == 0, "catenary origin z should be 0.")
    ctx.assert(_origin_circle(0, false).y() == 0, "circle X origin y should be 0.")
    ctx.assert(_origin_circle(0, true).y() == 0.5, "circle X even origin y should be 0.5.")
    ctx.assert(_origin_circle(1, true).y() == 0, "circle Y even origin y should be 0.")
    ctx.assert(_origin_cone(2, true).z() == 0, "cone Z even origin z should be 0.")
    ctx.assert(_origin_cone(2, true).x() == 0.5, "cone Z even origin x should be 0.5.")
    ctx.assert(_origin_cuboid().x() == 0, "cuboid origin x should be 0.")
    ctx.assert(_origin_ellipse(1, true).x() == 0.5, "ellipse Y even origin x should be 0.5.")
    ctx.assert(_origin_ellipse(1, true).y() == 0, "ellipse Y even origin y should be 0.")
    ctx.assert(_origin_ellipsoid(true).x() == 0.5, "ellipsoid even origin x should be 0.5.")
    ctx.assert(_origin_ellipsoid(false).z() == 0, "ellipsoid origin z should be 0.")
    ctx.assert(_origin_grid().y() == 0, "grid origin y should be 0.")
    ctx.assert(_origin_helix(0, true).x() == 0, "helix X even origin x should be 0.")
    ctx.assert(_origin_helix(0, true).z() == 0.5, "helix X even origin z should be 0.5.")
    ctx.assert(_origin_line().z() == 0, "line origin z should be 0.")
    ctx.assert(_origin_parabola(0, 0, true).y() == 0, "parabola X ROT0 even origin y should be 0.")
    ctx.assert(_origin_parabola(0, 0, true).z() == 0.5, "parabola X ROT0 even origin z should be 0.5.")
    ctx.assert(_origin_parabola(2, 1, true).x() == 0, "parabola Z ROT90 even origin x should be 0.")
    ctx.assert(_origin_parabola(2, 1, true).y() == 0.5, "parabola Z ROT90 even origin y should be 0.5.")
    ctx.assert(_origin_paraboloid(1, true).y() == 0, "paraboloid Y even origin y should be 0.")
    ctx.assert(_origin_polygon(0, true).x() == 0, "polygon X even origin x should be 0.")
    ctx.assert(_origin_polygon(0, true).y() == 0.5, "polygon X even origin y should be 0.5.")
    ctx.assert(_origin_pyramid(1, true).y() == 0, "pyramid Y even origin y should be 0.")
    ctx.assert(_origin_pyramid(1, true).z() == 0.5, "pyramid Y even origin z should be 0.5.")
    ctx.assert(_origin_sphere(true).z() == 0.5, "sphere even origin z should be 0.5.")
    ctx.assert(_origin_sphere(false).x() == 0, "sphere origin x should be 0.")
    ctx.assert(_origin_torus(0, false, false).x() == 0, "torus X origin x should be 0.")
    ctx.assert(_origin_torus(0, false, true).x() == 0.5, "torus X inner even origin x should be 0.5.")
    ctx.assert(_origin_torus(2, true, false).x() == 0.5, "torus Z outer even origin x should be 0.5.")
}

# catenary_default
local _assert_catenary_default(ctx: TestTickContext) {
    ctx.assert(not _cell_catenary(3, 0, 0, 1, false, 4).has(), "catenary_default should have 4 cells.")
    cell_0: Option[Vec3] = _cell_catenary(3, 0, 0, 1, false, 0)
    ctx.assert(Math.abs(cell_0.unwrap().x() - 0) == 0, "catenary_default cell 0 x should be 0.")
    ctx.assert(Math.abs(cell_0.unwrap().y() - 0) == 0, "catenary_default cell 0 y should be 0.")
    ctx.assert(Math.abs(cell_0.unwrap().z() - 0) == 0, "catenary_default cell 0 z should be 0.")
    cell_1: Option[Vec3] = _cell_catenary(3, 0, 0, 1, false, 1)
    ctx.assert(Math.abs(cell_1.unwrap().x() - 1) == 0, "catenary_default cell 1 x should be 1.")
    ctx.assert(Math.abs(cell_1.unwrap().y() - -1) == 0, "catenary_default cell 1 y should be -1.")
    ctx.assert(Math.abs(cell_1.unwrap().z() - 0) == 0, "catenary_default cell 1 z should be 0.")
    cell_2: Option[Vec3] = _cell_catenary(3, 0, 0, 1, false, 2)
    ctx.assert(Math.abs(cell_2.unwrap().x() - 2) == 0, "catenary_default cell 2 x should be 2.")
    ctx.assert(Math.abs(cell_2.unwrap().y() - -1) == 0, "catenary_default cell 2 y should be -1.")
    ctx.assert(Math.abs(cell_2.unwrap().z() - 0) == 0, "catenary_default cell 2 z should be 0.")
    cell_3: Option[Vec3] = _cell_catenary(3, 0, 0, 1, false, 3)
    ctx.assert(Math.abs(cell_3.unwrap().x() - 3) == 0, "catenary_default cell 3 x should be 3.")
    ctx.assert(Math.abs(cell_3.unwrap().y() - 0) == 0, "catenary_default cell 3 y should be 0.")
    ctx.assert(Math.abs(cell_3.unwrap().z() - 0) == 0, "catenary_default cell 3 z should be 0.")
}

# catenary_dy2dz3
local _assert_catenary_dy2dz3(ctx: TestTickContext) {
    ctx.assert(not _cell_catenary(0, 2, 3, 1, false, 5).has(), "catenary_dy2dz3 should have 5 cells.")
    cell_0: Option[Vec3] = _cell_catenary(0, 2, 3, 1, false, 0)
    ctx.assert(Math.abs(cell_0.unwrap().x() - 0) == 0, "catenary_dy2dz3 cell 0 x should be 0.")
    ctx.assert(Math.abs(cell_0.unwrap().y() - 0) == 0, "catenary_dy2dz3 cell 0 y should be 0.")
    ctx.assert(Math.abs(cell_0.unwrap().z() - 0) == 0, "catenary_dy2dz3 cell 0 z should be 0.")
    cell_1: Option[Vec3] = _cell_catenary(0, 2, 3, 1, false, 1)
    ctx.assert(Math.abs(cell_1.unwrap().x() - 0) == 0, "catenary_dy2dz3 cell 1 x should be 0.")
    ctx.assert(Math.abs(cell_1.unwrap().y() - -1) == 0, "catenary_dy2dz3 cell 1 y should be -1.")
    ctx.assert(Math.abs(cell_1.unwrap().z() - 1) == 0, "catenary_dy2dz3 cell 1 z should be 1.")
    cell_2: Option[Vec3] = _cell_catenary(0, 2, 3, 1, false, 2)
    ctx.assert(Math.abs(cell_2.unwrap().x() - 0) == 0, "catenary_dy2dz3 cell 2 x should be 0.")
    ctx.assert(Math.abs(cell_2.unwrap().y() - 0) == 0, "catenary_dy2dz3 cell 2 y should be 0.")
    ctx.assert(Math.abs(cell_2.unwrap().z() - 2) == 0, "catenary_dy2dz3 cell 2 z should be 2.")
    cell_3: Option[Vec3] = _cell_catenary(0, 2, 3, 1, false, 3)
    ctx.assert(Math.abs(cell_3.unwrap().x() - 0) == 0, "catenary_dy2dz3 cell 3 x should be 0.")
    ctx.assert(Math.abs(cell_3.unwrap().y() - 1) == 0, "catenary_dy2dz3 cell 3 y should be 1.")
    ctx.assert(Math.abs(cell_3.unwrap().z() - 3) == 0, "catenary_dy2dz3 cell 3 z should be 3.")
    cell_4: Option[Vec3] = _cell_catenary(0, 2, 3, 1, false, 4)
    ctx.assert(Math.abs(cell_4.unwrap().x() - 0) == 0, "catenary_dy2dz3 cell 4 x should be 0.")
    ctx.assert(Math.abs(cell_4.unwrap().y() - 2) == 0, "catenary_dy2dz3 cell 4 y should be 2.")
    ctx.assert(Math.abs(cell_4.unwrap().z() - 3) == 0, "catenary_dy2dz3 cell 4 z should be 3.")
}

# catenary_invert
local _assert_catenary_invert(ctx: TestTickContext) {
    ctx.assert(not _cell_catenary(3, 0, 0, 1, true, 4).has(), "catenary_invert should have 4 cells.")
    cell_0: Option[Vec3] = _cell_catenary(3, 0, 0, 1, true, 0)
    ctx.assert(Math.abs(cell_0.unwrap().x() - 3) == 0, "catenary_invert cell 0 x should be 3.")
    ctx.assert(Math.abs(cell_0.unwrap().y() - 0) == 0, "catenary_invert cell 0 y should be 0.")
    ctx.assert(Math.abs(cell_0.unwrap().z() - 0) == 0, "catenary_invert cell 0 z should be 0.")
    cell_1: Option[Vec3] = _cell_catenary(3, 0, 0, 1, true, 1)
    ctx.assert(Math.abs(cell_1.unwrap().x() - 2) == 0, "catenary_invert cell 1 x should be 2.")
    ctx.assert(Math.abs(cell_1.unwrap().y() - 1) == 0, "catenary_invert cell 1 y should be 1.")
    ctx.assert(Math.abs(cell_1.unwrap().z() - 0) == 0, "catenary_invert cell 1 z should be 0.")
    cell_2: Option[Vec3] = _cell_catenary(3, 0, 0, 1, true, 2)
    ctx.assert(Math.abs(cell_2.unwrap().x() - 1) == 0, "catenary_invert cell 2 x should be 1.")
    ctx.assert(Math.abs(cell_2.unwrap().y() - 1) == 0, "catenary_invert cell 2 y should be 1.")
    ctx.assert(Math.abs(cell_2.unwrap().z() - 0) == 0, "catenary_invert cell 2 z should be 0.")
    cell_3: Option[Vec3] = _cell_catenary(3, 0, 0, 1, true, 3)
    ctx.assert(Math.abs(cell_3.unwrap().x() - 0) == 0, "catenary_invert cell 3 x should be 0.")
    ctx.assert(Math.abs(cell_3.unwrap().y() - 0) == 0, "catenary_invert cell 3 y should be 0.")
    ctx.assert(Math.abs(cell_3.unwrap().z() - 0) == 0, "catenary_invert cell 3 z should be 0.")
}

# catenary_vertical
local _assert_catenary_vertical(ctx: TestTickContext) {
    ctx.assert(not _cell_catenary(0, 0, 0, 1, false, 2).has(), "catenary_vertical should have 2 cells.")
    cell_0: Option[Vec3] = _cell_catenary(0, 0, 0, 1, false, 0)
    ctx.assert(Math.abs(cell_0.unwrap().x() - 0) == 0, "catenary_vertical cell 0 x should be 0.")
    ctx.assert(Math.abs(cell_0.unwrap().y() - -1) == 0, "catenary_vertical cell 0 y should be -1.")
    ctx.assert(Math.abs(cell_0.unwrap().z() - 0) == 0, "catenary_vertical cell 0 z should be 0.")
    cell_1: Option[Vec3] = _cell_catenary(0, 0, 0, 1, false, 1)
    ctx.assert(Math.abs(cell_1.unwrap().x() - 0) == 0, "catenary_vertical cell 1 x should be 0.")
    ctx.assert(Math.abs(cell_1.unwrap().y() - 0) == 0, "catenary_vertical cell 1 y should be 0.")
    ctx.assert(Math.abs(cell_1.unwrap().z() - 0) == 0, "catenary_vertical cell 1 z should be 0.")
}

# The first arm of a non-convergent solve: the values leave the finite range, so the reference's
# Double.isFinite check throws and its height cast of NaN turns into 0. That 0 would make the cell
# loops walk 4,004,001 cells that all fail their check before answering nothing, which is a freeze,
# so the port answers no cell the moment a step is not finite.
local _assert_catenary_non_finite(ctx: TestTickContext) {
    ctx.assert(not _cell_catenary(2000, 2000, 0, 1, false, 0).has(), "catenary_non_finite should have no cells.")
}

# The second arm: dx 1419 with no height leaves a at 1, because the Newton step divides by an
# infinite derivative and lands back on 1, so the reference repeats that step forever (the shape
# hangs until it is cancelled). A step that changes nothing is the same non-convergence, and the
# port answers no cell instead of repeating it.
local _assert_catenary_no_progress(ctx: TestTickContext) {
    ctx.assert(not _cell_catenary(1419, 0, 0, 1, false, 0).has(), "catenary_no_progress should have no cells.")
}

# circle_x_r3_d1
local _assert_circle_x_r3_d1(ctx: TestTickContext) {
    ctx.assert(not _cell_circle(0, 3, 1, false, 16).has(), "circle_x_r3_d1 should have 16 cells.")
    cell_0: Option[Vec3] = _cell_circle(0, 3, 1, false, 0)
    ctx.assert(Math.abs(cell_0.unwrap().x() - 0) == 0, "circle_x_r3_d1 cell 0 x should be 0.")
    ctx.assert(Math.abs(cell_0.unwrap().y() - -3) == 0, "circle_x_r3_d1 cell 0 y should be -3.")
    ctx.assert(Math.abs(cell_0.unwrap().z() - -1) == 0, "circle_x_r3_d1 cell 0 z should be -1.")
    cell_1: Option[Vec3] = _cell_circle(0, 3, 1, false, 1)
    ctx.assert(Math.abs(cell_1.unwrap().x() - 0) == 0, "circle_x_r3_d1 cell 1 x should be 0.")
    ctx.assert(Math.abs(cell_1.unwrap().y() - -3) == 0, "circle_x_r3_d1 cell 1 y should be -3.")
    ctx.assert(Math.abs(cell_1.unwrap().z() - 0) == 0, "circle_x_r3_d1 cell 1 z should be 0.")
    cell_8: Option[Vec3] = _cell_circle(0, 3, 1, false, 8)
    ctx.assert(Math.abs(cell_8.unwrap().x() - 0) == 0, "circle_x_r3_d1 cell 8 x should be 0.")
    ctx.assert(Math.abs(cell_8.unwrap().y() - 0) == 0, "circle_x_r3_d1 cell 8 y should be 0.")
    ctx.assert(Math.abs(cell_8.unwrap().z() - 3) == 0, "circle_x_r3_d1 cell 8 z should be 3.")
    cell_14: Option[Vec3] = _cell_circle(0, 3, 1, false, 14)
    ctx.assert(Math.abs(cell_14.unwrap().x() - 0) == 0, "circle_x_r3_d1 cell 14 x should be 0.")
    ctx.assert(Math.abs(cell_14.unwrap().y() - 3) == 0, "circle_x_r3_d1 cell 14 y should be 3.")
    ctx.assert(Math.abs(cell_14.unwrap().z() - 0) == 0, "circle_x_r3_d1 cell 14 z should be 0.")
    cell_15: Option[Vec3] = _cell_circle(0, 3, 1, false, 15)
    ctx.assert(Math.abs(cell_15.unwrap().x() - 0) == 0, "circle_x_r3_d1 cell 15 x should be 0.")
    ctx.assert(Math.abs(cell_15.unwrap().y() - 3) == 0, "circle_x_r3_d1 cell 15 y should be 3.")
    ctx.assert(Math.abs(cell_15.unwrap().z() - 1) == 0, "circle_x_r3_d1 cell 15 z should be 1.")
}

# circle_x_r3_d2_even
local _assert_circle_x_r3_d2_even(ctx: TestTickContext) {
    ctx.assert(not _cell_circle(0, 3, 2, true, 32).has(), "circle_x_r3_d2_even should have 32 cells.")
    cell_0: Option[Vec3] = _cell_circle(0, 3, 2, true, 0)
    ctx.assert(Math.abs(cell_0.unwrap().x() - 0) == 0, "circle_x_r3_d2_even cell 0 x should be 0.")
    ctx.assert(Math.abs(cell_0.unwrap().y() - -2) == 0, "circle_x_r3_d2_even cell 0 y should be -2.")
    ctx.assert(Math.abs(cell_0.unwrap().z() - -1) == 0, "circle_x_r3_d2_even cell 0 z should be -1.")
    cell_1: Option[Vec3] = _cell_circle(0, 3, 2, true, 1)
    ctx.assert(Math.abs(cell_1.unwrap().x() - 1) == 0, "circle_x_r3_d2_even cell 1 x should be 1.")
    ctx.assert(Math.abs(cell_1.unwrap().y() - -2) == 0, "circle_x_r3_d2_even cell 1 y should be -2.")
    ctx.assert(Math.abs(cell_1.unwrap().z() - -1) == 0, "circle_x_r3_d2_even cell 1 z should be -1.")
    cell_6: Option[Vec3] = _cell_circle(0, 3, 2, true, 6)
    ctx.assert(Math.abs(cell_6.unwrap().x() - 0) == 0, "circle_x_r3_d2_even cell 6 x should be 0.")
    ctx.assert(Math.abs(cell_6.unwrap().y() - -2) == 0, "circle_x_r3_d2_even cell 6 y should be -2.")
    ctx.assert(Math.abs(cell_6.unwrap().z() - 2) == 0, "circle_x_r3_d2_even cell 6 z should be 2.")
    cell_16: Option[Vec3] = _cell_circle(0, 3, 2, true, 16)
    ctx.assert(Math.abs(cell_16.unwrap().x() - 0) == 0, "circle_x_r3_d2_even cell 16 x should be 0.")
    ctx.assert(Math.abs(cell_16.unwrap().y() - 1) == 0, "circle_x_r3_d2_even cell 16 y should be 1.")
    ctx.assert(Math.abs(cell_16.unwrap().z() - -2) == 0, "circle_x_r3_d2_even cell 16 z should be -2.")
    cell_20: Option[Vec3] = _cell_circle(0, 3, 2, true, 20)
