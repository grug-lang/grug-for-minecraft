    ctx.assert(Math.abs(cell_51.unwrap().x() - 3) == 0, "sphere_r3_domeY_even cell 51 x should be 3.")
    ctx.assert(Math.abs(cell_51.unwrap().y() - 2) == 0, "sphere_r3_domeY_even cell 51 y should be 2.")
    ctx.assert(Math.abs(cell_51.unwrap().z() - 2) == 0, "sphere_r3_domeY_even cell 51 z should be 2.")
}

