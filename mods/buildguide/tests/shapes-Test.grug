# grid
local _assert_grid(ctx: TestTickContext) {
    ctx.assert(not _cell_grid(3, 1, 3, 3, 3, 3, 9).has(), "grid should have 9 cells.")
    cell_0: Option[Vec3] = _cell_grid(3, 1, 3, 3, 3, 3, 0)
    ctx.assert(Math.abs(cell_0.unwrap().x() - 0) == 0, "grid cell 0 x should be 0.")
    ctx.assert(Math.abs(cell_0.unwrap().y() - 0) == 0, "grid cell 0 y should be 0.")
    ctx.assert(Math.abs(cell_0.unwrap().z() - 0) == 0, "grid cell 0 z should be 0.")
    cell_1: Option[Vec3] = _cell_grid(3, 1, 3, 3, 3, 3, 1)
    ctx.assert(Math.abs(cell_1.unwrap().x() - 0) == 0, "grid cell 1 x should be 0.")
    ctx.assert(Math.abs(cell_1.unwrap().y() - 0) == 0, "grid cell 1 y should be 0.")
    ctx.assert(Math.abs(cell_1.unwrap().z() - 3) == 0, "grid cell 1 z should be 3.")
    cell_2: Option[Vec3] = _cell_grid(3, 1, 3, 3, 3, 3, 2)
    ctx.assert(Math.abs(cell_2.unwrap().x() - 0) == 0, "grid cell 2 x should be 0.")
    ctx.assert(Math.abs(cell_2.unwrap().y() - 0) == 0, "grid cell 2 y should be 0.")
    ctx.assert(Math.abs(cell_2.unwrap().z() - 6) == 0, "grid cell 2 z should be 6.")
    cell_3: Option[Vec3] = _cell_grid(3, 1, 3, 3, 3, 3, 3)
    ctx.assert(Math.abs(cell_3.unwrap().x() - 3) == 0, "grid cell 3 x should be 3.")
    ctx.assert(Math.abs(cell_3.unwrap().y() - 0) == 0, "grid cell 3 y should be 0.")
    ctx.assert(Math.abs(cell_3.unwrap().z() - 0) == 0, "grid cell 3 z should be 0.")
    cell_4: Option[Vec3] = _cell_grid(3, 1, 3, 3, 3, 3, 4)
    ctx.assert(Math.abs(cell_4.unwrap().x() - 3) == 0, "grid cell 4 x should be 3.")
    ctx.assert(Math.abs(cell_4.unwrap().y() - 0) == 0, "grid cell 4 y should be 0.")
    ctx.assert(Math.abs(cell_4.unwrap().z() - 3) == 0, "grid cell 4 z should be 3.")
    cell_5: Option[Vec3] = _cell_grid(3, 1, 3, 3, 3, 3, 5)
    ctx.assert(Math.abs(cell_5.unwrap().x() - 3) == 0, "grid cell 5 x should be 3.")
    ctx.assert(Math.abs(cell_5.unwrap().y() - 0) == 0, "grid cell 5 y should be 0.")
    ctx.assert(Math.abs(cell_5.unwrap().z() - 6) == 0, "grid cell 5 z should be 6.")
    cell_6: Option[Vec3] = _cell_grid(3, 1, 3, 3, 3, 3, 6)
    ctx.assert(Math.abs(cell_6.unwrap().x() - 6) == 0, "grid cell 6 x should be 6.")
    ctx.assert(Math.abs(cell_6.unwrap().y() - 0) == 0, "grid cell 6 y should be 0.")
    ctx.assert(Math.abs(cell_6.unwrap().z() - 0) == 0, "grid cell 6 z should be 0.")
    cell_7: Option[Vec3] = _cell_grid(3, 1, 3, 3, 3, 3, 7)
    ctx.assert(Math.abs(cell_7.unwrap().x() - 6) == 0, "grid cell 7 x should be 6.")
    ctx.assert(Math.abs(cell_7.unwrap().y() - 0) == 0, "grid cell 7 y should be 0.")
    ctx.assert(Math.abs(cell_7.unwrap().z() - 3) == 0, "grid cell 7 z should be 3.")
    cell_8: Option[Vec3] = _cell_grid(3, 1, 3, 3, 3, 3, 8)
    ctx.assert(Math.abs(cell_8.unwrap().x() - 6) == 0, "grid cell 8 x should be 6.")
    ctx.assert(Math.abs(cell_8.unwrap().y() - 0) == 0, "grid cell 8 y should be 0.")
    ctx.assert(Math.abs(cell_8.unwrap().z() - 6) == 0, "grid cell 8 z should be 6.")
}

