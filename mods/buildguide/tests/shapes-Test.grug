    ctx.assert(Math.abs(cell_5.unwrap().y() - 1) == 0, "sphere_one_cell cell 5 y should be 1.")
    ctx.assert(Math.abs(cell_5.unwrap().z() - 0) == 0, "sphere_one_cell cell 5 z should be 0.")
