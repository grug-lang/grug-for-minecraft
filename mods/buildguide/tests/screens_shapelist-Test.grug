# The Shape list tab of #1752's screens: Add appends a set and selects it, a row click makes the set
# under it current, the shift buttons move every set, and Delete removes the current one and selects
# the row below it. Every proof is read back from the saved state, because the list, the fields and
# the checkbox are the host's widgets and no test entry reads their pixels. A typed origin field
# cannot be driven headlessly either, so this test proves the shift buttons, which write the same
# origins the Set buttons write.
# Persistence is turned on for the saves and put back as the run found it, so a later test sees the
# config it would have seen.
step: number = 0
waited: number = 0
was_persistent: bool = false
start_count: number = 0
start_origin_x: number = 0

export tick(ctx: TestTickContext) {
    if step == 0 {
        if not me.world_overlay_supported() or me.on_dedicated_server() {
            return
        }
        if not ctx.world_settled() {
            ctx.not_done()
            return
        }
        files: File = File.open(r"files")
        config: Option[string] = files.read_text("config/buildguide.cfg")
        ctx.assert(config.has(), "The mod should have written its config file before the first test tick.")
        was_persistent = String.index_of(config.unwrap(), "persistenceEnabled = true") >= 0
        step = 1
        ctx.press_world_key(66, false)
        ctx.not_done()
        return
    }

    if step == 1 {
        if not ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "The B binding should open Build Guide's screen.")
            ctx.not_done()
            return
        }
        if not ctx.overlay_drawn() {
            ctx.not_done()
            return
        }
        waited = 0
        # The Configuration tab is the fourth chrome button; the window is narrow enough at the CI
        # client's scale that its last pixels are cut off, so its visible part is clicked.
        width: number = ctx.screen_width()
        tab_x: number = 416
        if width - 10 < tab_x {
            tab_x = width - 10
        }
        ctx.click_screen(tab_x, 40, 0)
        step = 2
        ctx.not_done()
        return
    }

    if step == 2 {
        if not ctx.overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "The Configuration tab should draw a frame.")
            ctx.not_done()
            return
        }
        waited = 0
        if was_persistent {
            step = 4
            ctx.not_done()
            return
        }
        # The persistence checkbox is ConfigurationScreen's third box, at (255, 160).
        ctx.click_screen(262, 168, 0)
        step = 3
        ctx.not_done()
        return
    }

    if step == 3 {
        files: File = File.open(r"files")
        config: Option[string] = files.read_text("config/buildguide.cfg")
        ctx.assert(config.has(), "Ticking persistence should leave the config file readable.")
        ctx.assert(String.index_of(config.unwrap(), "persistenceEnabled = true") >= 0, "Ticking persistence should write its value.")
        step = 4
        ctx.not_done()
        return
    }

    if step == 4 {
        ctx.press_screen_key(256, false, false, true)
        step = 5
        ctx.not_done()
        return
    }

    if step == 5 {
        if ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "Escape should close the screen.")
            ctx.not_done()
            return
        }
        waited = 0
        # The close saved the state, which is where every later count and origin is read from.
        state: string = _saved_state(ctx)
        start_count = _set_count(state)
        ctx.assert(start_count > 0, "A first screen open creates the state's first set.")
        start_origin_x = _origin_x(state)
        step = 6
        ctx.press_world_key(66, false)
        ctx.not_done()
        return
    }

    if step == 6 {
        if not ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "The binding should reopen the screen.")
            ctx.not_done()
            return
        }
        if not ctx.overlay_drawn() {
            ctx.not_done()
            return
        }
        waited = 0
        # The Shape list tab is the third chrome button, at x 255 to 375 and y 30 to 50.
        ctx.click_screen(265, 40, 0)
        step = 7
        ctx.not_done()
        return
    }

    if step == 7 {
        if not ctx.overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "The Shape list tab should draw a frame.")
            ctx.not_done()
            return
        }
        waited = 0
        # Add is at (5, 90), 160 wide and 20 high, so (85, 100) is inside it.
        ctx.click_screen(85, 100, 0)
        step = 8
        ctx.not_done()
        return
    }

    if step == 8 {
        ctx.press_screen_key(256, false, false, true)
        step = 9
        ctx.not_done()
        return
    }

    if step == 9 {
        if ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "Escape should close the screen after Add.")
            ctx.not_done()
            return
        }
        waited = 0
        state: string = _saved_state(ctx)
        ctx.assert(_set_count(state) == start_count + 1, "Add should append one shape set.")
        ctx.assert(_field(state, "iShapeSet") == String.from_number(start_count), "Add should select the set it appended.")
        step = 10
        ctx.press_world_key(66, false)
        ctx.not_done()
        return
    }

    if step == 10 {
        if not ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "The binding should reopen the screen after Add.")
            ctx.not_done()
            return
        }
        if not ctx.overlay_drawn() {
            ctx.not_done()
            return
        }
        waited = 0
        ctx.click_screen(265, 40, 0)
        step = 11
        ctx.not_done()
        return
    }

    if step == 11 {
        if not ctx.overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "The Shape list tab should draw again.")
            ctx.not_done()
            return
        }
        waited = 0
        # The list starts at (180, 70) and its first row is drawn from y 74, 20 pixels tall, so
        # (250, 84) is inside row 0, which the click selects.
        ctx.click_screen(250, 84, 0)
        step = 12
        ctx.not_done()
        return
    }

    if step == 12 {
        ctx.press_screen_key(256, false, false, true)
        step = 13
        ctx.not_done()
        return
    }

    if step == 13 {
        if ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "Escape should close the screen after the row click.")
            ctx.not_done()
            return
        }
        waited = 0
        state: string = _saved_state(ctx)
        ctx.assert(_field(state, "iShapeSet") == "0", "A click on the first row should make its set the current one.")
        step = 14
        ctx.press_world_key(66, false)
        ctx.not_done()
        return
    }

    if step == 14 {
        if not ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "The binding should reopen the screen for the shift.")
            ctx.not_done()
            return
        }
        if not ctx.overlay_drawn() {
            ctx.not_done()
            return
        }
        waited = 0
        ctx.click_screen(265, 40, 0)
        step = 15
        ctx.not_done()
        return
    }

    if step == 15 {
        if not ctx.overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "The Shape list tab should draw for the shift.")
            ctx.not_done()
            return
        }
        waited = 0
        # The X row's "+" button is at (145, 220), 20 by 20, and shifts every set by one block.
        ctx.click_screen(155, 230, 0)
        step = 16
        ctx.not_done()
        return
    }

    if step == 16 {
        ctx.press_screen_key(256, false, false, true)
        step = 17
        ctx.not_done()
        return
    }

    if step == 17 {
        if ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "Escape should close the screen after the shift.")
            ctx.not_done()
            return
        }
        waited = 0
        state: string = _saved_state(ctx)
        ctx.assert(_origin_x(state) == start_origin_x + 1, "The X row's + should move the current set one block along X.")
        ctx.assert(_every_origin_x(state, start_origin_x + 1), "The shift should move every set by the same block, not only the current one.")
        step = 18
        ctx.press_world_key(66, false)
        ctx.not_done()
        return
    }

    if step == 18 {
        if not ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "The binding should reopen the screen for Delete.")
            ctx.not_done()
            return
        }
        if not ctx.overlay_drawn() {
            ctx.not_done()
            return
        }
        waited = 0
        ctx.click_screen(265, 40, 0)
        step = 19
        ctx.not_done()
        return
    }

    if step == 19 {
        if not ctx.overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "The Shape list tab should draw for Delete.")
            ctx.not_done()
            return
        }
        waited = 0
        # Delete is at (5, 155), 160 wide and 20 high, and removes the current set, which is row 0.
        ctx.click_screen(85, 165, 0)
        step = 20
        ctx.not_done()
        return
    }

    if step == 20 {
        ctx.press_screen_key(256, false, false, true)
        step = 21
        ctx.not_done()
        return
    }

    if step == 21 {
        if ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "Escape should close the screen after Delete.")
            ctx.not_done()
            return
        }
        waited = 0
        state: string = _saved_state(ctx)
        ctx.assert(_set_count(state) == start_count, "Delete should remove the current set and leave the rest.")
        ctx.assert(_field(state, "iShapeSet") == "0", "After removing row 0 of two, the row that moved up should be current.")
        if was_persistent {
            return
        }
        step = 22
        ctx.press_world_key(66, false)
        ctx.not_done()
        return
    }

    if step == 22 {
        # The run found persistence off, so the Configuration tab's box is ticked back off.
        if not ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "The binding should reopen the screen to put persistence back.")
            ctx.not_done()
            return
        }
        if not ctx.overlay_drawn() {
            ctx.not_done()
            return
        }
        waited = 0
        width: number = ctx.screen_width()
        tab_x: number = 416
        if width - 10 < tab_x {
            tab_x = width - 10
        }
        ctx.click_screen(tab_x, 40, 0)
        step = 23
        ctx.not_done()
        return
    }

    if step == 23 {
        if not ctx.overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "The Configuration tab should draw for the restore.")
            ctx.not_done()
            return
        }
        waited = 0
        ctx.click_screen(262, 168, 0)
        step = 24
        ctx.not_done()
        return
    }

    if step == 24 {
        files: File = File.open(r"files")
        config: Option[string] = files.read_text("config/buildguide.cfg")
        ctx.assert(config.has(), "Unticking persistence should leave the config file readable.")
        ctx.assert(String.index_of(config.unwrap(), "persistenceEnabled = false") >= 0, "Unticking persistence should put the run's value back.")
        ctx.press_screen_key(256, false, false, true)
        step = 25
        ctx.not_done()
        return
    }

    if step == 25 {
        if ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "Escape should close the Configuration screen.")
            ctx.not_done()
            return
        }
    }
}

# The state text the mod saved for this world, which is the one file under buildguide that holds a
# set. A test that runs before the first save gets an empty directory and fails the assertion.

local _saved_state(ctx: TestTickContext) string {
    files: File = File.open(r"files")
    count: number = files.entry_count("buildguide")
    i: number = 0
    while i < count {
        name: string = files.entry_name("buildguide", i)
        text: Option[string] = files.read_text(String.concat("buildguide/", name))
        if text.has() {
            state: string = text.unwrap()
            if String.index_of(state, "shapeSet=") >= 0 {
                return state
            }
        }
        i = i + 1
    }
    ctx.assert(false, "The close should have saved a state with a set.")
    return ""
}

# How many shapeSet lines the state holds.

local _set_count(state: string) number {
    rest: string = state
    count: number = 0
    at: number = String.index_of(rest, "shapeSet=")
    while at >= 0 {
        count = count + 1
        rest = String.substring(rest, at + 9, String.length(rest))
        at = String.index_of(rest, "shapeSet=")
    }
    return count
}

# A scalar line's value, such as iShapeSet's, or an empty text when the line is not there. The newline
# in the needle keeps a shorter key from matching a longer line's tail.

local _field(state: string, key: string) string {
    needle: string = String.concat(String.from_character(10), String.concat(key, "="))
    at: number = String.index_of(state, needle)
    if at < 0 {
        return ""
    }
    rest: string = String.substring(state, at + String.length(needle), String.length(state))
    end: number = String.index_of(rest, String.from_character(10))
    if end < 0 {
        return rest
    }
    return String.substring(rest, 0, end)
}

# The first set's origin X, from its origin=x,y,z; field, which the load writes on every set.

local _origin_x(state: string) number {
    return _origin_piece(_set_line(state, 0), 0)
}

# Whether every set's origin X is the value given, which proves the shift reached all of them.

local _every_origin_x(state: string, wanted: number) bool {
    count: number = _set_count(state)
    if count == 0 {
        return false
    }
    i: number = 0
    while i < count {
        if _origin_piece(_set_line(state, i), 0) != wanted {
            return false
        }
        i = i + 1
    }
    return true
}

# The shapeSet line at a sequence number, or an empty text when there are fewer sets.

local _set_line(state: string, wanted: number) string {
    rest: string = state
    found: number = 0
    at: number = String.index_of(rest, "shapeSet=")
    while at >= 0 {
        line_rest: string = String.substring(rest, at, String.length(rest))
        end: number = String.index_of(line_rest, String.from_character(10))
        if found == wanted {
            if end < 0 {
                return line_rest
            }
            return String.substring(line_rest, 0, end)
        }
        if end < 0 {
            return ""
        }
        found = found + 1
        rest = String.substring(line_rest, end + 1, String.length(line_rest))
        at = String.index_of(rest, "shapeSet=")
    }
    return ""
}

# One comma-separated piece of a set's origin field, or 0 when the field is not there.

local _origin_piece(set: string, index: number) number {
    at: number = String.index_of(set, "origin=")
    if at < 0 {
        return 0
    }
    rest: string = String.substring(set, at + 7, String.length(set))
    end: number = String.index_of(rest, ";")
    if end < 0 {
        return 0
    }
    origin: string = String.substring(rest, 0, end)
    piece: string = origin
    i: number = 0
    while i < index {
        comma: number = String.index_of(piece, ",")
        if comma < 0 {
            return 0
        }
        piece = String.substring(piece, comma + 1, String.length(piece))
        i = i + 1
    }
    comma: number = String.index_of(piece, ",")
    if comma >= 0 {
        piece = String.substring(piece, 0, comma)
    }
    parsed: Option[number] = String.to_integer(piece)
    if parsed.has() {
        return parsed.unwrap()
    }
    return 0
}
