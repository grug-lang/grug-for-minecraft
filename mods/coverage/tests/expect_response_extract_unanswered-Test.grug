# An extract_item export that returns without answering is an err raised by the host that asked, because silence is not a refusal.
export run(ctx: TestRunContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_response_block")
    be: BlockEntity = level.get_block_entity(x, y, z).unwrap()
    diamond: Item = item(resource_location("minecraft:diamond"))
    be.set_saved_number("extract_mode", 5)

    ctx.expect_error("returned without answering")
    be.ask_extract_item(0)
}
