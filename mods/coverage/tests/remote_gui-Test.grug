# A GUI a server opens for the player the test runs as, which is the server/client split's GUI half
# (#168). The test right-clicks coverage_gui in the world it reads: on a dedicated server that click
# is the test player's own, in the server's world, and the block's use export builds the layout and
# calls GUI.open, which reaches ForgeAdapter.openGui with a ServerPlayer. It opens the menu with
# ServerPlayer.openMenu, which sends the joined client the open-screen packet its screen is built
# from, so the GUI crosses a real connection rather than an integrated server's function call.
# Test.screen_open answers about the side the test runs on: a client answers whether its own screen
# is open, and a dedicated server that answers (only 1.20.6-forge so far) whether the player it runs
# as has a container open, which is the menu that client's screen is built from. That answer can be
# true before the open-screen packet reaches the client, so it says the menu exists, not that the
# client has drawn it. So the same file proves both halves of the split, and a
# regression that opens the GUI on a client instead, or does not open it at all, leaves the menu
# closed and ends the test at the runner's tick budget instead of reaching the assertions below.
# Test.screen_open is forwarded to the client's own screen now (#1094). The four loaders whose
# server refuses GUI.open still list this test as unsupported on their dedicated server, because
# the menu this test waits for never opens there until #1098 gives them a server-side container.
# No frame is waited for: on 1.20.6 a placed block may reach the client after the menu does, and
# GrugMenu builds itself on a placeholder container when its block entity has not arrived (#425).
export tick_any_side(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y()
    z: number = origin.z()

    if ctx.current_tick() == 0 {
        level.place_block(x, y, z, "grug:coverage_gui")
        Test.use_block(level, x, y, z)
        ctx.not_done()
    } else if not Test.screen_open() {
        # On a client the screen appears on the frame after the menu, so that is what is waited for.
        ctx.not_done()
    } else {
        # Reaching here is the assertion that the menu the click opened exists for this player.
        Test.close_screen()
        ctx.assert(not Test.screen_open(), "Test.close_screen should leave no screen or menu open.")
    }
}
