# A GUI a server opens for the player the test runs as, which is the server/client split's GUI half
# (#168). The test right-clicks coverage_gui in the world it reads: on a dedicated server that click
# is the test player's own, in the server's world, and the block's use export builds the layout and
# calls GUI.open. On 1.20.6 that reaches ForgeAdapter.openGui with a ServerPlayer and opens the
# server's menu; on 1.2.5 it reaches the server adapter, which builds the block entity's container
# and has the joined client show it (#1098). Either way the GUI crosses a real connection rather
# than an integrated server's function call.
# Test.screen_open answers about the client's own screen (#1094): a client answers whether its own
# screen is open, and a dedicated server asks the joined client's screen. It used to answer from
# this server's container menu, which turned true before the open-screen packet reached the client,
# so that answer said the menu existed, not that the client had drawn it. So the same file proves
# both halves of the split, and a regression that opens the GUI on a client instead, or does not
# open it at all, leaves the screen closed and ends the test at the runner's tick budget instead of
# reaching the assertions below. The three servers that refuse GUI.open still list this test as
# unsupported on their dedicated server, because the menu this test waits for never opens there.
# No frame is waited for: on a server a placed block may reach the client after the menu does, and
# the menu is built on a placeholder container when its block entity has not arrived (#425).
export tick_any_side(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y()
    z: number = origin.z()

    if ctx.current_tick() == 0 {
        level.place_block(x, y, z, "grug:coverage_gui")
        Test.use_block(level, x, y, z)
        ctx.not_done()
    } else if not Test.screen_open() {
        # On a client the screen appears on the frame after the menu, so that is what is waited for.
        ctx.not_done()
    } else {
        # Reaching here is the assertion that the menu the click opened exists for this player.
        Test.close_screen()
        ctx.assert(not Test.screen_open(), "Test.close_screen should leave no screen or menu open.")
    }
}
