# Saved text lives in a grug block entity's NBT, so a vanilla chest has nowhere to keep it: asking it
# for text or setting text on it must report an error rather than answer for text that its chunk
# would drop.
export tick(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    origin: Vec3 = ctx.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "minecraft:chest")
    chest_opt: Option[BlockEntity] = level.get_block_entity(x, y, z)
    ctx.assert(chest_opt.has(), "The chest should have a block entity.")
    chest: BlockEntity = chest_opt.unwrap()

    ctx.expect_error("Only a grug block entity saves text")
    text: Option[string] = chest.get_saved_string("liquid")

    ctx.expect_error("Only a grug block entity saves text")
    chest.set_saved_string("liquid", "minecraft:water")
}
