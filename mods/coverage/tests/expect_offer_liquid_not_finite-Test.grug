# An amount has to be a finite number. Both comparisons a tank makes against zero are false for
# NaN, so a NaN offer would reach set_saved_number and a full tank's room would stay NaN, and an
# infinity would cap no offer at the capacity. The host refuses it before the export is asked, as it
# refuses a name that is no liquid.
export tick(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    origin: Vec3 = ctx.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_response_block")
    be: BlockEntity = level.get_block_entity(x, y, z).unwrap()

    nan: number = Math.sqrt(-1)
    ctx.expect_error("BlockEntity.offer_liquid: The amount has to be a finite number")
    taken: number = be.offer_liquid("minecraft:water", nan, 0, true)

    infinity: number = Math.cosh(1000)
    ctx.expect_error("BlockEntity.offer_liquid: The amount has to be a finite number")
    taken_again: number = be.offer_liquid("minecraft:water", infinity, 0, true)
}
