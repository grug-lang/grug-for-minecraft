# Math.remainder is Java's % on doubles, which is what BuildCraft's world time checks read. The
# negative cases are the ones a floor-based modulo gets wrong, and they matter because the quarry
# compares the parity of coordinates that can be negative.
export run() {
    if me.tick() == 0 {
        Test.assert(Math.remainder(7, 3) == 1, "Math.remainder(7, 3) should be 1.")
        Test.assert(Math.remainder(6, 3) == 0, "Math.remainder(6, 3) should be 0.")
        Test.assert(Math.remainder(0, 20) == 0, "Math.remainder(0, 20) should be 0.")
        Test.assert(Math.remainder(15, 20) == 15, "Math.remainder(15, 20) should be 15, not the IEEE -5.")
        Test.assert(Math.remainder(-7, 3) == -1, "Math.remainder(-7, 3) should be -1, the sign of the first number.")
        Test.assert(Math.remainder(7, -3) == 1, "Math.remainder(7, -3) should be 1.")
        Test.assert(Math.remainder(-3, 2) == -1, "Math.remainder(-3, 2) should be -1.")
        Test.assert(Math.remainder(7.5, 2) == 1.5, "Math.remainder(7.5, 2) should be 1.5.")
    }
}
