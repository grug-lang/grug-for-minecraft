# get_energy_stored asks a receiver, so a block entity that declared nothing must report an error rather than answer 0.
export run() {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    pos: BlockPos = BlockPos.new(x, y, z)
    level.place_block(pos, "grug:coverage_block")
    be: BlockEntity = level.get_block_entity(pos).unwrap()
    me.expect_error("is not an energy receiver")
    be.get_energy_stored()
}
