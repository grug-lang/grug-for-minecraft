# A request is a count of energy, so a fractional one is reported rather than rounded.
export tick(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    origin: Vec3 = ctx.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_power_block")
    be: BlockEntity = level.get_block_entity(x, y, z).unwrap()
    ctx.expect_error("of energy has to be a whole number from 0 to 2147483647")
    be.request_energy_on(0, 1.5)
}
