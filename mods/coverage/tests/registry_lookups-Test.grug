# Covers the registry lookup's declared grug item and block matches, the multi-word vanilla
# reflection fallback, and the unknown-name null return.
export run() {
    if me.tick() == 0 {
        declared_item: Item = item(resource_location("grug:coverage_item"))
        Test.assert(equals(declared_item, declared_item), "a declared grug item resolves.")

        declared_block: Item = item(resource_location("grug:coverage_block"))
        Test.assert(equals(declared_block, declared_block), "a declared grug block resolves.")

        vanilla_item: Item = item(resource_location("minecraft:diamond_sword"))
        Test.assert(equals(vanilla_item, vanilla_item), "a multi-word vanilla item resolves.")

        unknown_item: Item = item(resource_location("grug:does_not_exist"))

        # A vanilla name that is neither an item nor a block: the item registry has nothing and the
        # block fallback has nothing either, which is a branch the other loaders take too.
        unknown_vanilla_item: Item = item(resource_location("minecraft:does_not_exist"))

        level: Level = Test.get_client_level()
        origin: Vec3 = Test.get_origin()
        x: number = origin.x() + 7
        y: number = origin.y()
        z: number = origin.z()

        # A missing name resolves to an item handle that holds no game item. A saved-list record
        # reads a null item back as an empty Option, so a lookup that wrongly returned an item would
        # read back and fail here.
        level.place_block(x, y, z, "grug:coverage_init_block")
        be_opt: Option[BlockEntity] = level.get_block_entity(x, y, z)
        Test.assert(be_opt.has(), "the coverage init block should have a block entity.")
        be: BlockEntity = be_opt.unwrap()

        unknown_record: number = be.append_saved_list_record("lookup")
        be.set_saved_list_item("lookup", unknown_record, unknown_item)
        Test.assert(not be.get_saved_list_item("lookup", unknown_record).has(), "an unknown item resolves to null.")

        unknown_vanilla_record: number = be.append_saved_list_record("lookup")
        be.set_saved_list_item("lookup", unknown_vanilla_record, unknown_vanilla_item)
        Test.assert(not be.get_saved_list_item("lookup", unknown_vanilla_record).has(), "an unknown vanilla item resolves to null.")

        level.place_block(x, y, z, "minecraft:crafting_table")
        Test.assert(true, "a multi-word vanilla block places.")
    }
}
