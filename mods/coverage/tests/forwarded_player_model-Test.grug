# Another player's model, as the starter's own screen draws it (#1298). The 1.20.6 multiplayer leg
# has a second real client (#1027), and the dedicated server stands that player three blocks in
# front of the starter while this test runs (GrugServerRun). The golden pins what the loader's own
# entity renderer drew for it: the default skin, since the offline server sends no textures, with
# its name tag. The capture is first person, so the only model in view is the other player's.
# A model that never arrives leaves the crop as the empty room it was at the first tick, and the
# wait ends at its bound with the assertion that says so; a model drawn from the wrong eye sits
# elsewhere in the frame and the golden does not match.
# The crop is the head, the name tag and the body between the arms, not the whole model: vanilla
# sways a player model's arms with its age, so consecutive frames of the arms never agree, while the
# head, the tag and the torso did in every frame measured (#1298).
# Nothing here waits a number of ticks. The test waits until the crop has changed from the empty
# room and then held still for fifteen captures in a row: the client's light brightens the crop for
# a few dozen ticks after the model arrives (its mean colour went from #372b20 to #413326), so a
# shorter run of equal frames is a plateau and not the settled one. The tick bound only ends a wait
# that cannot succeed.
# Only 1.20.6-forge's multiplayer leg has a second client, so the other loaders return at once, and
# the runner runs a forwarded_ test on a dedicated server alone.

# The crop at the first tick, before the second player is in view.
empty: Option[Screenshot] = Option.new()

# The last frame the wait took.
previous: Option[Screenshot] = Option.new()

# How many captures in a row matched the one before them, with the model in the frame.
steady: number = 0

export init(ctx: TestInitContext) {
    ctx.set_max_ticks(500)
}

export tick(ctx: TestTickContext) {
    if Test.loader_name() != "1.20.6-forge" {
        return
    }
    if ctx.current_tick() == 0 {
        # The room has no floor at the starter's level but the block they stand on, so the other
        # player gets a block of their own three blocks ahead, or they would fall to the torch floor.
        # The server stands them on it when this tick ends, so the capture below is the room alone.
        origin: Vec3 = Test.get_origin()
        Test.get_client_level().place_block(Math.floor(origin.x()), Math.floor(origin.y() - 4.12) - 1, Math.floor(origin.z()) + 3, "minecraft:stone")
        _wait_for_the_room(ctx)
        empty.set(Test.screenshot().capture(624, 236, 656, 488))
        ctx.not_done()
        return
    }
    now: Screenshot = Test.screenshot().capture(624, 236, 656, 488)
    if now.change_from(empty.unwrap()) > 5.0 and previous.has() and now.change_from(previous.unwrap()) < 0.05 {
        steady = steady + 1
    } else {
        steady = 0
    }
    previous.set(now)
    if steady < 15 {
        ctx.assert(ctx.current_tick() < 400, "The other player's model should have been drawn in the starter's view and then held still, but the frame never settled.")
        ctx.not_done()
        return
    }
    Test.screenshot().equals(r"screenshots/player_model", 624, 236, 656, 488)
}

# Asks the joined client whether it has drawn the room, as forwarded_capture_pinned_eye does.
local _wait_for_the_room(ctx: TestTickContext) {
    settled: bool = Test.world_settled()
    asks: number = 1
    while not settled and asks < 60 {
        settled = Test.world_settled()
        asks = asks + 1
    }
    ctx.assert(settled, "The client should have drawn the room before the baseline is taken.")
}
