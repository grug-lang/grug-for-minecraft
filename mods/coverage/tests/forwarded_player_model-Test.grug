# Another player's model, as the starter's own screen draws it (#1298). The 1.20.6 multiplayer leg
# has a second real client (#1027); the dedicated server stands that player three blocks in front of
# the starter for as long as this test runs (GrugServerRun), the test captures the starter's frame,
# and the golden pins what the loader's own entity renderer drew: the player's default skin in its
# idle pose with its name tag, where it stands in the frame. The capture is first person, so the
# only player model in view is the other player's.
# Two things fail it. A model that never arrives leaves the crop as the empty room it was at the
# first tick, and the wait below ends at its bound with the assertion that says so; a model drawn
# from the wrong eye sits elsewhere in the frame and the golden does not match. Both would pass a
# test that only read the camera, which second_player-Test.grug already does.
# The skin is the default one on purpose: the dedicated server runs offline and sends no textures,
# so the client draws the default for that player's UUID, and no test may depend on a skin fetch.
# Nothing here waits a number of ticks. The model arrives after the server's teleport reaches the
# client and its entity is added, and the entity then eases into its place over a few frames, so the
# test waits until the crop has changed from the empty room and then stopped changing for fifteen
# captures in a row: the crop brightens for a few dozen ticks while the client's light settles, so a
# shorter run of equal frames is a plateau and not the settled frame.
# The tick bound only ends a wait that cannot succeed.
# Only 1.20.6-forge's multiplayer leg has a second client, so the other loaders return at once, and
# the runner runs a forwarded_ test on a dedicated server alone.

# The head's part of the crop at the first tick, before the second player is in view.
empty_head: Option[Screenshot] = Option.new()

# The last frame the wait took, to tell a model still easing into place from one that has arrived.
previous: Option[Screenshot] = Option.new()

# How many captures in a row matched the one before them, with the model in the frame.
steady: number = 0

export init(ctx: TestInitContext) {
    ctx.set_max_ticks(500)
}

export tick(ctx: TestTickContext) {
    if Test.loader_name() != "1.20.6-forge" {
        return
    }
    if ctx.current_tick() == 0 {
        # The room has no floor at the starter's level but the block they stand on, so the other
        # player gets a block of their own three blocks ahead, or they would fall to the torch floor.
        # The server stands them on it when this tick ends, so the capture below is the room alone.
        origin: Vec3 = Test.get_origin()
        Test.get_client_level().place_block(Math.floor(origin.x()), Math.floor(origin.y() - 4.12) - 1, Math.floor(origin.z()) + 3, "minecraft:stone")
        _wait_for_the_room(ctx)
        empty_head.set(Test.screenshot().capture(610, 322, 670, 372))
        ctx.not_done()
        return
    }
    # The head is black against a brown wall, so the first change in this part of the crop is the
    # model and not the light, which also moves the whole crop's brightness while it settles.
    head: Screenshot = Test.screenshot().capture(610, 322, 670, 372)
    now: Screenshot = Test.screenshot().capture(520, 260, 760, 648)
    arrived: bool = head.change_from(empty_head.unwrap()) > 5.0
    if arrived and previous.has() and now.change_from(previous.unwrap()) < 0.3 {
        steady = steady + 1
    } else {
        steady = 0
    }
    if ctx.current_tick() > 150 {
        d: number = now.change_from(previous.unwrap())
        h: number = head.change_from(empty_head.unwrap())
        if d >= 0.3 {
            if d >= 3.0 {
                ctx.assert(false, "DIAG consecutive change at or above 3 percent")
            }
            ctx.assert(false, "DIAG consecutive change between 0.3 and 3 percent")
        }
        if h <= 5.0 {
            ctx.assert(false, "DIAG head change at most 5")
        }
        ctx.assert(false, "DIAG consecutive change under 0.3 and head over 5, so steady counted")
    }
    previous.set(now)
    if steady < 15 {
        ctx.assert(ctx.current_tick() < 400, "The other player's model should have been drawn in the starter's view, drawn and still, but the frame never settled.")
        ctx.not_done()
        return
    }
    Test.screenshot().equals(r"screenshots/player_model", 520, 260, 760, 648)
}

# Asks the joined client whether it has drawn the room, as forwarded_capture_pinned_eye does.
local _wait_for_the_room(ctx: TestTickContext) {
    settled: bool = Test.world_settled()
    asks: number = 1
    while not settled and asks < 60 {
        settled = Test.world_settled()
        asks = asks + 1
    }
    ctx.assert(settled, "The client should have drawn the room before the baseline is taken.")
}
