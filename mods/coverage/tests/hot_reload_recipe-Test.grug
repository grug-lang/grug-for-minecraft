# Removes the trailing newline from a recipe, so the loaders' recipe hot-reload path runs, then
# restores it. Removing a newline keeps the JSON valid, unlike the invalid state used for code files.
# It disturbs the shapeless fixture rather than the shaped one because StationAPI's hot-reload path
# reads the changed file's type and re-registers under that id, so this drives the recipe type the
# shapeless backport is about. The shaped fixture stays covered by the removal test deleting it.
change_baseline: number = -1
path: string = "coverage/data/grug/recipes/crafting/shapeless_recipe.json"

export run() {
    if Test.tick() == 0 {
        Test.not_done()
    } else if Test.tick() == 1 {
        change_baseline = Test.hot_reload_count(path)
        Test.set_mod_file_state(path, "no_trailing_newline")
        Test.not_done()
    } else if Test.hot_reload_count(path) <= change_baseline {
        Test.not_done()
    } else {
        Test.set_mod_file_state(path, "normal")
    }
}
