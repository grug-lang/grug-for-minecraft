# Removes the trailing newline from a recipe, so the loaders' recipe hot-reload path runs, then
# restores it. Removing a newline keeps the JSON valid, unlike the invalid state used for code files.
change_baseline: number = -1
path: string = "coverage/data/grug/recipes/crafting/result_item.json"

export run() {
    if Test.tick() == 0 {
        Test.not_done()
    } else if Test.tick() == 1 {
        change_baseline = Test.hot_reload_count(path)
        Test.set_mod_file_state(path, "no_trailing_newline")
        Test.not_done()
    } else if Test.hot_reload_count(path) <= change_baseline {
        Test.not_done()
    } else {
        Test.set_mod_file_state(path, "normal")
    }
}
