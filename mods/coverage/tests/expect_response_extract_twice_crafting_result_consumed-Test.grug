# Every answering method is wired to the answered-once rule, including give_crafting_result_consumed.
export tick(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_consumed")
    be: BlockEntity = level.get_block_entity(x, y, z).unwrap()
    wheat: Item = item(resource_location("minecraft:wheat"))
    slot: number = 0
    while slot < 3 {
        be.set_item_in_slot(slot, wheat, 1)
        slot = slot + 1
    }
    be.update_recipe_output(0)
    ctx.assert(be.get_crafting_result_item().has(), "Three wheat in a row should craft a bread for the export to hand over.")
    offered: number = be.ask_extract_item(0)
    ctx.assert(offered != -1, "The block entity should have run its extract_item export.")
    ctx.assert(offered != 0, "The export should not have refused a bread that exists.")
    ctx.assert(offered == 1, "The export should have offered the one bread.")
    be.set_saved_number("extract_mode", 1)
    ctx.assert(be.get_saved_number("extract_mode") == 1, "The mode should have been saved.")
    ctx.expect_error("has already been answered")
    be.ask_extract_item(0)
}
