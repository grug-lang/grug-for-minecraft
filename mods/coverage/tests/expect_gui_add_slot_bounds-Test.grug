# GUI.open must reject a GUI.add_slot slot that falls outside the block entity's inventory, the way it
# rejects a crafting grid that does: the slot is the block entity's own, so a menu listing one the
# inventory does not have is one the server cannot answer.
export tick(ctx: TestTickContext) {
    if ctx.current_tick() == 0 {
        level: Level = ctx.get_client_level()
        origin: Vec3 = ctx.get_origin()
        x: number = origin.x()
        y: number = origin.y()
        z: number = origin.z()

        level.place_block(x, y, z, "grug:coverage_block")
        block_entity: BlockEntity = level.get_block_entity(x, y, z).unwrap()

        # coverage_block has a 9-slot inventory, so slot 9 is one past the end.
        layout: GUI = gui(r"assets/grug/textures/gui/crafting.png")
        layout.add_slot(9, 0, 0)

        ctx.expect_error("GUI.open: The GUI uses slot 9")
        layout.open(ctx.get_player(), block_entity)
    }
}
