# A whole index can still name no record, when the list is shorter than it, so reading it must be
# reported rather than answered with a fresh record's defaults.
export run(ctx: TestRunContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_init_block")
    be: BlockEntity = level.get_block_entity(x, y, z).unwrap()

    ctx.expect_error("There is no record at index 0")
    be.remove_saved_list_record("things", 0)
}
