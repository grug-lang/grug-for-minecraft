# Covers #1825: light a test queues after its room build settled has to leave the field the blocks
# define, and the frame has to be baked from that field.
# The a1 client's frame hook drains the light queue a test's writes fill. Draining applies the
# queued updates in the order the queue holds them, and every cell the cascade reaches is written
# through the quiet setter, which marks no section: those sections keep the mesh they were baked
# with. The hook now settles the box the room build recorded and marks its sections again whenever
# the queue had work, so "the light has no work left" also means the frame is the settled field's.
# The test takes every torch out of the sealed room, which darkens the whole room while only the
# floor around the removed torches is marked for compiling again. A frame that read the meshes the
# drain left therefore still shows the room lit, while marking the whole room again and drawing it
# from the same field shows it dark. With the frame hook settling and marking the recorded box the
# first capture already reads that field, so the two captures agree; without it they differ by
# however much of the room the drain lit and no section was marked for. Two captures of one session
# are compared rather than one against a reference, so this holds without a golden.
# The frame hook this covers is the a1 client's, so the test runs there and nowhere else: every
# other loader settles a test's writes in its own way. See #1580 and #1814 for the room's settle.

# The room's radius. Wider than the default room, so the build a test asks for is a real rebuild
# that records the box the frame hook settles again.
radius: number = 6

# How far the test has got: 0 takes the torches out, 1 captures the room the drain left, 2 marks the
# room again and compares the second capture.
step: number = 0

# Whether the room has been asked for, which only the first tick does.
asked: bool = false

# How many ticks this step has waited for the world to settle.
waited: number = 0

# The room's centre block, read once from the origin, so the writes stay anchored to it.
px: number = 0
py: number = 0
pz: number = 0

# The weighted sum of the room's block light before and after the torches were taken out, which has
# to have fallen, or the test never made a change worth capturing.
before: number = 0
after: number = 0

# The room as the drain left it, captured before the room is marked again.
drained: Option[Screenshot] = Option.new()

export init(ctx: TestInitContext) {
    # Two settles and two captures, beside the build.
    ctx.set_max_ticks(400)
}

export tick(ctx: TestTickContext) {
    if me.loader_name() != "a1.1.2_01-ornithe" or me.on_dedicated_server() {
        return
    }
    if not asked {
        asked = true
        ctx.set_box_radius(radius)
        ctx.not_done()
        return
    }

    waited = waited + 1
    ctx.assert(waited < 300, "The room should settle after its build, after the torches are taken out, and after the room is marked again.")
    if not ctx.world_settled() {
        ctx.not_done()
        return
    }
    if step == 0 {
        origin: Vec3 = ctx.get_origin()
        px = Math.floor(origin.x())
        # The origin is the camera lifted three blocks, and this version's player y is the eye, so
        # the feet are 4.62 below the origin and the room is anchored at the block below them.
        py = Math.floor(origin.y() - 4.62)
        pz = Math.floor(origin.z())
        before = _light_sum(ctx.get_client_level(), px, py, pz)
        _write_torches(ctx, px, py, pz, "minecraft:stone")
        step = 1
        ctx.not_done()
        return
    }
    if step == 1 {
        after = _light_sum(ctx.get_client_level(), px, py, pz)
        ctx.assert(after < before, "Taking every torch out of the sealed room has to darken it, or the frame below is not a change worth comparing.")
        drained.set(ctx.screenshot().capture(0, 0, 1280, 720))
        _mark_room(ctx, px, py, pz)
        step = 2
        ctx.not_done()
        return
    }
    rebaked: Screenshot = ctx.screenshot().capture(0, 0, 1280, 720)
    different: number = drained.unwrap().change_from(rebaked)
    print3("share of the frame that changed when the room was marked again", different, waited)
    ctx.assert(different < 1, "Marking the room again may only recompile the meshes that were already there, so the frame may not change. A larger share means the first capture read meshes no section was marked for, because the frame hook drained the test's light without settling the room's box and marking its sections again. See #1825.")
}

# Writes stone into every floor tile's torch cell, which takes that tile's torch out, skipping the
# player's own column that the build leaves clear.
local _write_torches(ctx: TestTickContext, cx: number, cy: number, cz: number, block: string) {
    level: Level = ctx.get_client_level()
    x: number = cx - radius
    while x <= cx + radius {
        z: number = cz - radius
        while z <= cz + radius {
            if x != cx or z != cz {
                # The torch floor is four blocks below the feet and the torch sits on it.
                level.place_block(x, cy - 3, z, block)
            }
            z = z + 1
        }
        x = x + 1
    }
}

# Marks every section of the room's air for compiling again without changing a block: an air block
# placed onto air returns before it queues any light, and the game still tells the renderer the
# position changed, which is what marks its section. The player's own column is marked from their
# feet up, so the block they stand on stays in place.
local _mark_room(ctx: TestTickContext, cx: number, cy: number, cz: number) {
    level: Level = ctx.get_client_level()
    x: number = cx - radius
    while x <= cx + radius {
        z: number = cz - radius
        while z <= cz + radius {
            y: number = cy - 2
            if x == cx and z == cz {
                y = cy
            }
            while y <= cy + 2 * radius {
                level.place_block(x, y, z, "minecraft:air")
                y = y + 1
            }
            z = z + 1
        }
        x = x + 1
    }
}

# The room's block light, weighted by the cell so that a level moved from one cell to another is a
# different sum rather than a cancelled one.
local _light_sum(level: Level, cx: number, cy: number, cz: number) number {
    total: number = 0
    x: number = cx - radius + 1
    while x <= cx + radius - 1 {
        z: number = cz - radius + 1
        while z <= cz + radius - 1 {
            y: number = cy - 2
            while y <= cy + 2 * radius {
                weight: number = (x - cx) * 3 + (y - cy) * 5 + (z - cz) * 7 + 100
                total = total + level.get_block_light(x, y, z) * weight
                y = y + 1
            }
            z = z + 1
        }
        x = x + 1
    }
    return total
}
