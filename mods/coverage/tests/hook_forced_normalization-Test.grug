# The runner turns GL_NORMALIZE on at tick 100 of a test whose file name ends with
# _forced_normalization (GrugForcedNormalization). The capture that says the overlay's item draw
# pins that state off is jei/tests/item_list_forced_normalization-Test.grug, but another mod's test
# run is not counted by the coverage gate, so this test reaches the same loader hook on a test the
# gate does count. It opens the inventory first, so the hook lands with the overlay's own drawing
# live, the way the capture test has it. See #1137.
started: bool = false
opened: bool = false
tick_of_the_hook: number = 100

export tick_any_side(ctx: TestTickContext) {
    if not started {
        started = true
        if not Test.overlay_supported() {
            # This loader draws no overlays; the deviation is in about.json.
            return
        }
        Test.close_screen()
        ctx.not_done()
        return
    }

    # A world frame has to be drawn before a screen that shows the player opens, as in
    # item_list_forced_normalization-Test.grug.
    if not opened {
        if not Test.world_settled() {
            ctx.not_done()
            return
        }
        Test.open_inventory(Test.get_player())
        opened = true
        ctx.not_done()
        return
    }

    if ctx.current_tick() < tick_of_the_hook + 1 {
        ctx.not_done()
        return
    }
    ctx.assert(Test.screen_open(), "The inventory should stay open across the normalization hook.")
    Test.close_screen()
}
