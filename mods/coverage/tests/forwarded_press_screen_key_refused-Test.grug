# A dedicated server has no client, so Test.press_screen_key must refuse with a host function error
# naming the function instead of reaching for the client's own game class, which a server refuses to
# load (#1064). The key is valid, so the refusal is about the missing client and not the argument.
# See forwarded_screen_width_refused-Test for why this is a forwarded_ test.
export tick(ctx: TestTickContext) {
    ctx.expect_error("Test.press_screen_key: This needs a client")
    Test.press_screen_key(0, false, false)
}
