# Energy handed into a block entity's inbox is kept with the world time it arrived at, and a take
# reads only what arrived before the time it runs at: that is the difference between the reference's
# PipeTransportPower.receiveEnergy and a store, and it is what stops a pipe's answer depending on
# whether the game ticked it before or after its neighbour. Each side is its own inbox, the amount is
# not rounded, and a take empties what it read.
export tick(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    origin: Vec3 = ctx.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()
    original: number = level.get_time()

    level.place_block(x, y, z, "grug:coverage_power_block")
    be: BlockEntity = level.get_block_entity(x, y, z).unwrap()

    level.set_time(original + 100)
    ctx.assert(be.take_received_energy(0) == 0, "An empty inbox gives nothing.")

    # Two fractions on one side add up, and the other sides are not touched by them.
    be.receive_energy_on(0, 2.5)
    be.receive_energy_on(0, 0.25)
    be.receive_energy_on(1, 7)
    be.receive_energy_on(0, 0)
    ctx.assert(be.take_received_energy(0) == 0, "Energy handed in during this world time stays for a later take.")
    ctx.assert(be.take_received_energy(1) == 0, "Side 1 stays for a later take too.")
    ctx.assert(be.take_received_energy(2) == 0, "A side nothing arrived on gives nothing.")

    # A later world time is after every delivery, so they are all taken then.
    level.set_time(original + 101)
    ctx.assert(be.take_received_energy(0) == 2.75, "Side 0 should hold both fractions once the time moves on.")
    ctx.assert(be.take_received_energy(1) == 7, "Side 1 keeps its own energy apart from side 0.")
    ctx.assert(be.take_received_energy(0) == 0, "A take empties the entries it read.")
    ctx.assert(be.take_received_energy(1) == 0, "And the same on the other side.")

    # A clock that moved backwards is not after the delivery, so the delivery waits for a clock that
    # passes it, which is the same rule read the other way round.
    level.set_time(original + 200)
    be.receive_energy_on(3, 1.5)
    level.set_time(original + 100)
    ctx.assert(be.take_received_energy(3) == 0, "A delivery stamped later than the clock is not taken before it.")
    level.set_time(original + 201)
    ctx.assert(be.take_received_energy(3) == 1.5, "It is taken once the clock has passed its stamp.")

    # Taking an inbox does not add to the receiver's own store: the receiver decides that itself.
    ctx.assert(be.get_energy_stored() == 0, "The store should be untouched by the inbox.")
    level.set_time(original)
}
