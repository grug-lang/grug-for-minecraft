# Covers using a block in the same tick it was placed, which is what every GUI test does and what a mod does
# when it places a block and opens it for the player straight away. On 1.20.6 the server sends the packet that
# opens the screen before the block update that places the block, so the client can be asked to open a menu
# for a block it has not got yet, and the GUI never opens. See #425.
# The race is not forced, so it is hit by repetition: each of the 20 uses is at a position the client has never
# seen a block at, and the screen is closed between them so that each wait is for a screen that is new. The
# positions are a 5 by 4 grid around the origin, which stays inside the player's reach. coverage_block is used
# because its menu has a result slot, which is the part of the menu that needs the block to exist.
# The last screen is closed too, since a screen left open would be taken for the first one opening by the next
# repeat's first GUI test.
# Which position the next use is at, and whether the current one is waiting for its screen.
col: number = 0
row: number = 0
waiting: bool = false
waited: number = 0

export run() {
    if not waiting {
        _use()
        waiting = true
        waited = 0
        Test.not_done()
        return
    }

    if not Test.screen_open() {
        waited = waited + 1
        Test.assert(waited < 100, "The GUI did not open after a block was placed and used in the same tick.")
        Test.not_done()
        return
    }

    waiting = false
    Test.close_screen()
    col = col + 1
    if col == 5 {
        col = 0
        row = row + 1
    }
    if row < 4 {
        Test.not_done()
    }
}

local _use() {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x() + col - 2
    y: number = origin.y()
    z: number = origin.z() + row - 2

    level.place_block(x, y, z, "grug:coverage_block")
    Test.use_block(level, x, y, z)
}
