# Covers the mob cap reads on the level an overlay's HUD pass hands out (#1252): the client's own
# copy of the world, read on the render thread, where the test's own level is the server's. The key I
# turns on a HUD line that is only written once the overlay has read a count and a cap from that level,
# so the overlay being drawn with its text is the proof that both reads came back. The reads exist on
# 1.20.6 so far among the loaders whose level differs between the client and the server, so every
# other loader returns before it presses anything.
started: bool = false
pressed: bool = false
settled_ticks: number = 0
waited: number = 0

export tick(ctx: TestTickContext) {
    if not started {
        started = true
        if me.loader_name() != "1.20.6-forge" or not me.world_overlay_supported() {
            return
        }
        ctx.set_box_radius(6)
        ctx.not_done()
        return
    }

    waited = waited + 1
    ctx.assert(waited < 1500, "The mob cap read test should finish.")

    if not ctx.world_settled() {
        settled_ticks = 0
        ctx.not_done()
        return
    }
    if settled_ticks < 5 {
        settled_ticks = settled_ticks + 1
        ctx.not_done()
        return
    }

    if not pressed {
        pressed = true
        ctx.press_world_key(73, false)
        ctx.not_done()
        return
    }

    if not ctx.world_overlay_drawn() {
        ctx.not_done()
        return
    }

    # The overlay is one entity for the whole run: I turns the line off again, or it would sit in
    # every later test's captures.
    ctx.press_world_key(73, false)
}
