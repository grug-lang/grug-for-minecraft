# A player moved with set_player_position stays at the feet the test named while the client ticks
# on (#1688). The a1 dedicated server's teleport carried the eye as the feet plus the decimal 1.62,
# which put the client's box 4.768e-9 under the feet, inside the stone it stood on, so the client
# fell through it for the ticks until the server's hold corrected it and the camera read 0.2336 low
# (the flake of camera_pose-Test, seen whenever a crowd pushed the server's copy and the hold
# teleported). Each move is repeated, and the eye is read on every tick of the window that follows
# it: the server's hold puts a fallen client back at the start of every server tick, so a single
# read at the window's end can land after a correction and see a position the hold had to put back
# rather than one it held. A read on each tick sees the fall wherever in the window it happens.
# The eye is read against an absolute reference rather than the camera the test started with: the
# stone's top this test lays, which the move names, so the eye is that top plus the game's own eye
# height. A feet derived from the camera cannot catch a coordinate a correction already moved, and
# the pre-fix teleport's own decimal 1.62 addition would cancel the camera it read and land the box
# on the top, so nothing would fall. The 4.768e-9 adapter difference is corrected before any read,
# so this is the strongest assertion the camera supports (#1730).
started: bool = false
laid: bool = false
moved: number = 0
waited: number = 0
stone_x: number = 0.0
feet_y: number = 0.0
stone_z: number = 0.0
start_x: number = 0.0
start_z: number = 0.0
# The game's own eye height, its float 1.62 widened to a double: (double) 1.62F. The client adds
# this and not the decimal 1.62, and the two differ by 4.768e-9, which is what sank the pre-fix
# teleport. The stone's top plus this is therefore the absolute eye every read below requires.
eye_height: number = 1.6200000047683716

export tick(ctx: TestTickContext) {
    if not started {
        started = true
        ctx.not_done()
        return
    }
    if not ctx.world_settled() {
        ctx.not_done()
        return
    }
    if not laid {
        start: Vec3 = ctx.camera()
        start_x = start.x()
        start_z = start.z()
        stone_x = Math.floor(start.x() + 1.0)
        feet_y = Math.floor(start.y() - eye_height + 0.5)
        stone_z = Math.floor(start.z())
        ctx.get_client_level().place_block(stone_x, feet_y - 1.0, stone_z, "minecraft:stone")
        laid = true
        ctx.not_done()
        return
    }
    if ctx.get_client_level().is_air(stone_x, feet_y - 1.0, stone_z) {
        ctx.not_done()
        return
    }
    if waited == 0 {
        # The move names the stone's top, the feet the stone was laid for, one block along x: the
        # eye is that absolute top plus the game's own eye height, and every read below requires it.
        ctx.set_player_position(start_x + 1.0, feet_y, start_z)
        waited = 1
        ctx.not_done()
        return
    }
    camera: Vec3 = ctx.camera()
    ctx.assert(_same_eye(camera.y(), feet_y + eye_height), "The eye should be the stone's top plus the game's own eye height.")
    if waited < 6 {
        waited = waited + 1
        ctx.not_done()
        return
    }
    # The window is over, so the move has had every tick it could need to reach the client: the
    # player is at the feet the move named, one block along x at the same height and depth.
    ctx.assert(_near(camera.x(), start_x + 1.0), "The player should be at the x the move named.")
    ctx.assert(_near(camera.z(), start_z), "A move should leave the axis it did not name alone.")
    moved = moved + 1
    waited = 0
    if moved < 6 {
        ctx.not_done()
    }
}

# A block in 1024, the tolerance camera-Test uses and the neighbouring set_player_position test uses
# for the same move: the older loaders carry the position as a float, so a coordinate near 70
# expands when it is read back as a double.
local _near(a: number, b: number) bool {
    return a > b - 0.0009765625 and a < b + 0.0009765625
}

# The eye is the stone's top plus the game's own eye height, (double) 1.62F, and the client adds
# that exact widening rather than the decimal 1.62, which is 4.768e-9 lower. The thousandth above
# would swallow that gap, so this is 1e-12: four thousand times below the gap between the two eye
# heights, and a fall tick of 0.0784 is eleven orders of magnitude above it.
local _same_eye(a: number, b: number) bool {
    return a > b - 0.000000000001 and a < b + 0.000000000001
}
