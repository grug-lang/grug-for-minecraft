# Deletes a recipe file, so the StationAPI loader's recipe-removal path runs, then restores it. A
# deletion reaches the loaders as the file on the event-based watcher and as its parent directory on
# the polling one, so the test waits for either to be reported.
file_path: string = "coverage/data/grug/recipes/crafting/result_item.json"
dir_path: string = "coverage/data/grug/recipes/crafting"
file_baseline: number = -1
dir_baseline: number = -1

export run() {
    if Test.tick() == 0 {
        Test.not_done()
    } else if Test.tick() == 1 {
        file_baseline = Test.hot_reload_count(file_path)
        dir_baseline = Test.hot_reload_count(dir_path)
        Test.set_mod_file_state(file_path, "deleted")
        Test.not_done()
    } else if Test.hot_reload_count(file_path) <= file_baseline and Test.hot_reload_count(dir_path) <= dir_baseline {
        Test.not_done()
    } else {
        Test.set_mod_file_state(file_path, "normal")
    }
}
