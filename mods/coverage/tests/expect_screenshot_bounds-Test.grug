# An out-of-bounds crop coordinate must be reported before any capture is attempted. Setting a valid
# tolerance first is what keeps Screenshot.tolerance's accepted path covered in a game; the invalid
# values have their own expect_ tests, and the crop still errors before any comparison runs.
export tick(ctx: TestTickContext) {
    if ctx.current_tick() == 0 {
        ctx.expect_error("is -1, which is outside")
        Test.screenshot().tolerance(1).equals(r"screenshots/dummy", -1, 0, 10, 10)
    }
}
