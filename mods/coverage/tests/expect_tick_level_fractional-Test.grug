# Test.tick_level advances a whole number of ticks, so a fraction must report an error rather than
# be rounded: a test asking for 2.5 ticks has a bug that rounding would hide.
export tick(ctx: TestTickContext) {
    level: Level = Test.get_client_level()

    ctx.expect_error("whole number from 0 to")
    Test.tick_level(level, 2.5)
}
