# A receiver declares the delivery it takes as well as what it holds, which is how a sender knows a
# quarry wants 25 energy at a time rather than one: the coverage power block declares a store of 10
# that takes a delivery of 2 to 4, and both numbers are read back here.
export tick(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    origin: Vec3 = ctx.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_power_block")
    be: BlockEntity = level.get_block_entity(x, y, z).unwrap()
    ctx.assert(be.is_power_receiver(), "The coverage power block should be a receiver.")
    ctx.assert(be.get_min_received_energy() == 2, "The least it takes in one delivery should be 2.")
    ctx.assert(be.get_max_received_energy() == 4, "The most it takes in one delivery should be 4.")
}
