# String.from_number turns a number into text: a whole number with no decimal point or exponent
# however large or negative, and a fraction as Java's shortest text, which is what the mob cap
# overlay (#1252) draws its counts with.
export tick(ctx: TestTickContext) {
    if ctx.current_tick() == 0 {
        ctx.assert(String.from_number(0) == "0", "String.from_number(0) should be 0.")
        ctx.assert(String.from_number(41) == "41", "String.from_number(41) should be 41.")
        ctx.assert(String.from_number(-7) == "-7", "String.from_number(-7) should be -7.")
        ctx.assert(String.from_number(2.5) == "2.5", "String.from_number(2.5) should be 2.5.")
        ctx.assert(String.from_number(-0.25) == "-0.25", "String.from_number(-0.25) should be -0.25.")
        ctx.assert(String.from_number(10000000000 * 10000000000) == "100000000000000000000", "String.from_number(1e20) should have no exponent.")
    }
}
