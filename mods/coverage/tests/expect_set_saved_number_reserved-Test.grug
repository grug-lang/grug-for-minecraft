# Names starting with grug: are the game's, so a script saving a number under one is reported rather than editing the game's own state.
export run() {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_power_block")
    be: BlockEntity = level.get_block_entity(x, y, z).unwrap()
    Test.expect_error("are reserved")
    set_saved_number(be, "grug:energy_stored", 5)
}
