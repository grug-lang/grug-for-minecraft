# The tile a block with no entity file leaves draws for the chunk-mesh block placed on it (#1101).
# A client joined to a server is told only that a block changed, and this version keeps the tile of
# the block that was there. A grug block that names no entity file initializes that tile with
# nothing, and the chunk-mesh block placed on the same cell has to be inited from its own entity
# file rather than keeping that attempt: without that, its render pass never runs and the block
# draws nothing at all.
# This places a block that names no entity file and then the chunk-mesh block on its cell, and
# requires the chunk-mesh block's plate to draw. The number is saved as 0 and then as 1, so the
# assertion is the change the plate itself adds rather than the block merely appearing, which a
# block whose render never ran cannot make either. The pedestal is looked for against the empty room
# only to know when the block reached the client, because the room stays as empty as it was when the
# render pass did not run.
# The wall and the two agreeing captures of the empty room are coverage_mesh_saved_number's, for the
# same reason: without a wall behind the block, drifting clouds would be a change of their own, and
# a room that is still moving would be where the plate is looked for.
# It defines tick_any_side, so a dedicated server runs it too: the settle wait is forwarded to the
# joined client, and the captures are the client's (#1086).
mesh_block: Option[BlockEntity] = Option.new()
empty: Option[Screenshot] = Option.new()
empty_prev: Option[Screenshot] = Option.new()
pedestal: Option[Screenshot] = Option.new()

# Whether the no-entity-file block is in place, and whether the chunk-mesh block is.
plain_placed: bool = false
mesh_placed: bool = false

# The runner tick the no-entity-file block went in on, and the one its follower went in on.
plain_tick: number = 0
mesh_tick: number = 0

# Whether the number has been saved as 1, and the runner tick it was saved on.
saved_plate: bool = false
saved_tick: number = 0

# How many captures have already shown the frame from before the change being waited for.
attempts: number = 0

# The runner tick the last empty capture was taken on. Up to 10 ticks run for one frame, so a
# capture on the very next tick can be of the same frame and show no change that has been drawn.
room_tick: number = 0

export init(ctx: TestInitContext) {
    # The setup's empty room, the pedestal and the plate each capture up to eight times, and a
    # capture waits about 60 ticks for the client to draw the frame it is about.
    ctx.set_max_ticks(2000)
}

export tick_any_side(ctx: TestTickContext) {
    if ctx.current_tick() == 0 {
        _wall(ctx)
        ctx.not_done()
    } else if not Test.world_settled() {
        ctx.not_done()
    } else if not empty.has() {
        _settle_empty(ctx)
        ctx.not_done()
    } else if not plain_placed {
        _place_plain(ctx)
        plain_placed = true
        plain_tick = ctx.current_tick()
        ctx.not_done()
    } else if ctx.current_tick() < plain_tick + 10 {
        # The joined client has the block, and this gives its kept tile a tick to be inited from
        # the block that names no entity file before the chunk-mesh block goes on top of it.
        ctx.not_done()
    } else if not mesh_placed {
        _place_mesh(ctx)
        mesh_placed = true
        mesh_tick = ctx.current_tick()
        attempts = 0
        ctx.not_done()
    } else if not pedestal.has() {
        _capture_pedestal(ctx)
        ctx.not_done()
    } else if not saved_plate {
        _save(1)
        saved_plate = true
        saved_tick = ctx.current_tick()
        attempts = 0
        ctx.not_done()
    } else if ctx.current_tick() < saved_tick + 30 {
        # Nothing marks the world unsettled for a saved-number change or a redraw: the capture
        # below decides whether the rebuilt mesh arrived, and this wait only keeps it from
        # spinning.
        ctx.not_done()
    } else {
        plate: Screenshot = Test.screenshot().capture(500, 60, 780, 440)
        if plate.change_from(pedestal.unwrap()) < 1 {
            attempts = attempts + 1
            ctx.assert(attempts < 8, "The chunk-mesh block's plate never drew on the tile a block with no entity file left.")
            saved_tick = ctx.current_tick()
            ctx.not_done()
        } else {
            ctx.assert(mesh_block.unwrap().get_saved_number("mesh_marker") == 1, "The number should be saved as 1.")
        }
    }
}

local _wall(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    Test.set_box_radius(6)
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y()
    z: number = origin.z()

    # The wall coverage_mesh_saved_number puts behind the block's spot, thirteen across and
    # thirteen high, which covers the whole crop.
    wy: number = y - 9
    while wy < y + 4 {
        wx: number = x - 6
        while wx < x + 7 {
            level.place_block(wx, wy, z + 6, "minecraft:stone")
            wx = wx + 1
        }
        wy = wy + 1
    }
}

# Waits until two captures of the room without a block agree before anything goes in. A wall whose
# mesh arrives late, or a cloud, is not what the plate is then compared against.
local _settle_empty(ctx: TestTickContext) {
    if ctx.current_tick() >= room_tick + 10 {
        shot: Screenshot = Test.screenshot().capture(500, 60, 780, 440)
        room_tick = ctx.current_tick()
        if empty_prev.has() and shot.change_from(empty_prev.unwrap()) < 1 {
            empty.set(shot)
            attempts = 0
        } else {
            attempts = attempts + 1
            ctx.assert(attempts < 8, "The room never stopped changing before the block went in.")
            empty_prev.set(shot)
        }
    }
}

# Puts a grug block that names no entity file on the cell the chunk-mesh block will take.
local _place_plain(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    level.place_block(origin.x(), origin.y() - 1.88, origin.z() + 4, "grug:coverage_model_cube")
}

# Puts the chunk-mesh block on that same cell, which is the block the kept tile has to be inited
# for, and saves its number as 0 so the pedestal is what the first capture is of.
local _place_mesh(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y()
    z: number = origin.z()
    level.place_block(x, y - 1.88, z + 4, "grug:coverage_mesh_saved")

    be_opt: Option[BlockEntity] = level.get_block_entity(x, y - 1.88, z + 4)
    ctx.assert(be_opt.has(), "The chunk-mesh block should have a block entity.")
    mesh_block.set(be_opt.unwrap())
    _save(0)
}

# Waits until the chunk-mesh block's pedestal is in the frame, which is what a tile that was inited
# from it draws, and keeps that frame as the one the plate is compared against.
local _capture_pedestal(ctx: TestTickContext) {
    if ctx.current_tick() >= mesh_tick + 30 {
        shot: Screenshot = Test.screenshot().capture(500, 60, 780, 440)
        if shot.change_from(empty.unwrap()) < 1 {
            attempts = attempts + 1
            ctx.assert(attempts < 8, "The chunk-mesh block never drew on the tile a block with no entity file left.")
            mesh_tick = ctx.current_tick()
        } else {
            pedestal.set(shot)
            attempts = 0
        }
    }
}

local _save(value: number) {
    block: BlockEntity = mesh_block.unwrap()
    block.set_saved_number("mesh_marker", value)
    block.redraw()
}
