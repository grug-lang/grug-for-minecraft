# A listing asks about a directory inside the mod's own files (#1757): a parent segment is refused by
# entry_count too, so neither call can be used to list another mod's files or the game's.
export tick(ctx: TestTickContext) {
    files: File = File.open(r"files")
    ctx.expect_error("no path may climb out of files")
    files.entry_count("../escape")
}
