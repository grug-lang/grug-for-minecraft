# vec3 gives a spawned entity a velocity, and a NaN coordinate would make the entity's motion
# meaningless, so it is reported rather than spawned.
# Squaring 10000000000.0 five times overflows a double to infinity, and infinity minus infinity is NaN.
export run(ctx: TestRunContext) {
    infinity: number = 10000000000.0
    infinity = infinity * infinity
    infinity = infinity * infinity
    infinity = infinity * infinity
    infinity = infinity * infinity
    infinity = infinity * infinity
    nan: number = infinity - infinity

    ctx.expect_error("vec3: x must be finite")
    velocity: Vec3 = vec3(nan, 0, 0)
}
