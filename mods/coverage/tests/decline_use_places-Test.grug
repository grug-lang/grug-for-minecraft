# Covers what a declined click does in the game: the click is left to the held item, which places a block
# against the face that was clicked, while a block whose use export does not decline keeps the click and
# nothing is placed. The player holds one cobblestone. The block that handles the click is used first, so the
# cobblestone is still in hand for the block that declines, whose click places it on top of that block.
# That the handling block places nothing has no condition to wait for, so it is checked once the declined
# click's cobblestone has appeared, which came after it. On 1.20.6 the clicks reach the blocks by packets, so
# the cobblestone is waited for.
waited: number = 0

export tick(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y()
    z: number = origin.z()

    if ctx.current_tick() == 0 {
        level.place_block(x, y, z, "grug:coverage_decline_use")
        level.place_block(x + 4, y, z, "grug:coverage_use")
        Test.set_held_item(Test.get_player(), item(resource_location("minecraft:cobblestone")))
        Test.use_block(level, x + 4, y, z)
        Test.use_block(level, x, y, z)
        ctx.not_done()
    } else if not _is_cobblestone(level, x, y + 1, z) {
        waited = waited + 1
        ctx.assert(waited < 100, "The declined click should have placed the held cobblestone on top of the block.")
        ctx.not_done()
    } else {
        ctx.assert(not _is_cobblestone(level, x + 4, y + 1, z), "A click the block handled should not place the held block.")
        Test.clear_held_item(Test.get_player())
    }
}

local _is_cobblestone(level: Level, x: number, y: number, z: number) bool {
    return level.get_block(x, y, z) == "minecraft:cobblestone"
}
