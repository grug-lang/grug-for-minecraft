# Covers what a declined click does in the game: the click is left to the held item, which places a block
# against the face that was clicked, while a block whose use export does not decline keeps the click and
# nothing is placed. The player holds one cobblestone. The block that handles the click is used first, so the
# cobblestone is still in hand for the block that declines, whose click places it below that block: the
# fixture stands above the test player's eye, which is the block's bottom face (#1106).
# That the handling block places nothing has no condition to wait for, so it is checked once the declined
# click's cobblestone has appeared, which came after it. The handling block stands four beside the eye, in the
# room's wall column, so the eye sees its west face and a placement by it would land at x + 3, inside the room,
# which is where the assertion looks. On 1.20.6 the clicks reach the blocks by packets, so the cobblestone is
# waited for, with no count of ticks of its own: a tick is not a unit of time there (#688), and the runner's
# budget ends a click that never arrives.

export tick(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    origin: Vec3 = ctx.get_origin()
    x: number = origin.x()
    y: number = origin.y()
    z: number = origin.z()

    if ctx.current_tick() == 0 {
        level.place_block(x, y, z, "grug:coverage_decline_use")
        level.place_block(x + 4, y, z, "grug:coverage_use")
        ctx.set_held_item(ctx.get_player(), item(resource_location("minecraft:cobblestone")))
        ctx.use_block(level, x + 4, y, z)
        ctx.use_block(level, x, y, z)
        ctx.not_done()
    } else if not _is_cobblestone(level, x, y - 1, z) {
        ctx.not_done()
    } else {
        ctx.assert(not _is_cobblestone(level, x + 3, y, z), "A click the block handled should not place the held block.")
        ctx.clear_held_item(ctx.get_player())
    }
}

local _is_cobblestone(level: Level, x: number, y: number, z: number) bool {
    return level.get_block(x, y, z) == "minecraft:cobblestone"
}
