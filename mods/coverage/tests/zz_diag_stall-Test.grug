# Diagnostic copy for #717, not for a pull request: blocks the server thread before its room is built,
# which is when the lockstep is not running yet, then reports the distance between this test's ticks
# and the world's clock at every one of its first ticks.
stall: number = 1500
start: number = -1

export init(ctx: TestInitContext) {
    Test.stall(stall)
}

export tick(ctx: TestTickContext) {
    now: number = Test.get_client_level().get_time()
    if start < 0 {
        start = now
    }
    if ctx.current_tick() < 60 {
        print3("DIAG stall ticks so far, world ticks since the first:", ctx.current_tick(), now - start)
        ctx.not_done()
    }
}
