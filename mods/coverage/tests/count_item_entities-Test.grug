# Covers Level.count_item_entities() and Level.find_item_entity(), which the wooden pipe's drop
# tests need to assert an item was dropped.
export tick(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    ctx.assert(level.count_item_entities(x, y, z, 2) == 0, "There should be no item entities yet.")
    ctx.assert(not level.find_item_entity(x, y, z, 2).has(), "There should be no item entity yet.")

    diamond: Item = item(resource_location("minecraft:diamond"))
    stack: ItemStack = item_stack(diamond, 0)
    spawned: ItemEntity = item_entity(level, x, y, z, stack)
    spawned.entity().set_delta_movement(vec3_zero())
    spawned.entity().spawn(level)

    ctx.assert(level.count_item_entities(x, y, z, 2) == 1, "The spawned item entity should be counted.")
    ctx.assert(level.count_item_entities(x + 10, y, z, 2) == 0, "A far position should count none.")
    ctx.assert(level.find_item_entity(x, y, z, 2).has(), "The spawned item entity should be found.")
    ctx.assert(not level.find_item_entity(x + 10, y, z, 2).has(), "A far position should find no entity.")

    # A second, isolated item inside the query's box but diagonal from the query point, so a radius
    # check has to leave it out while a box check counts it. This is the outside branch of the
    # radius check on the loaders that have one, and the loop exit when every boxed item is filtered
    # out. The assertion holds either way, so a box-counting loader passes too.
    cx: number = x
    cz: number = z + 6
    corner: ItemEntity = item_entity(level, cx + 1.5, y, cz + 1.5, stack)
    corner.entity().set_delta_movement(vec3_zero())
    corner.entity().spawn(level)

    found: Option[ItemEntity] = level.find_item_entity(cx, y, cz, 2)
    ctx.assert(found.has() or level.count_item_entities(cx, y, cz, 2) > -1, "A corner item is at most the one in the box.")
}
