# A vanilla block name has to mean the same block on every loader, and get_block has to answer
# with the name a mod wrote rather than with the loader's own spelling of it.
# This places every block whose name changed between Minecraft versions and reads each one back,
# so it runs the same on all five loaders: a name that resolved to a different block, or came
# back under another name, fails here. Those are the blocks two or more loaders spell differently
# from the canonical name, which is the whole of what the table in core pins down. Each one is
# read back in the tick it was placed, so a block the game would remove again on its own (a flower
# on the wrong substrate, a leaf that decays) cannot make the assertion flaky.
# The blocks left out are two-block blocks (minecraft:oak_door, minecraft:iron_door and
# minecraft:white_bed), which a half-placed one is not the block the mod asked for, and the
# flowing liquids (minecraft:water and minecraft:lava), and minecraft:redstone_wire, which pops
# off in the tick it is placed unless it has a solid block to stand on.
# Band 35 is free: the coverage tests use 20 and the pipe tests 30, 40, 45, 50 and 55, and a
# block placed far above the player is dropped rather than placed on Beta. The two torches stand on a
# stone because a torch the game removes again is not what this test is about. The grid is three
# apart so no two fixture blocks are neighbours.

export run() {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 35
    z: number = origin.z()

    # Terrain can reach this high (a hill on the seed, or a block an earlier test left at this
    # offset), so climb until the spot is air instead of trusting the offset. The climb is capped
    # low because a block placed far above the player is dropped rather than placed on Beta, and the
    # bands above this one are taken by the pipe tests.
    steps: number = 0
    while not level.is_air(x, y, z) and steps < 8 {
        y = y + 1
        steps = steps + 1
    }

    level.place_block(x + 0, y, z, "minecraft:bricks")
    Test.assert(level.get_block(x + 0, y, z) == "minecraft:bricks", "minecraft:bricks is one block everywhere.")
    level.place_block(x + 3, y, z, "minecraft:clay")
    Test.assert(level.get_block(x + 3, y, z) == "minecraft:clay", "minecraft:clay is one block everywhere.")
    level.place_block(x + 6, y, z, "minecraft:coal_ore")
    Test.assert(level.get_block(x + 6, y, z) == "minecraft:coal_ore", "minecraft:coal_ore is one block everywhere.")
    level.place_block(x + 9, y, z, "minecraft:crafting_table")
    Test.assert(level.get_block(x + 9, y, z) == "minecraft:crafting_table", "minecraft:crafting_table is one block everywhere.")
    level.place_block(x + 12, y, z, "minecraft:diamond_block")
    Test.assert(level.get_block(x + 12, y, z) == "minecraft:diamond_block", "minecraft:diamond_block is one block everywhere.")
    level.place_block(x + 15, y, z, "minecraft:diamond_ore")
    Test.assert(level.get_block(x + 15, y, z) == "minecraft:diamond_ore", "minecraft:diamond_ore is one block everywhere.")
    level.place_block(x + 18, y, z, "minecraft:farmland")
    Test.assert(level.get_block(x + 18, y, z) == "minecraft:farmland", "minecraft:farmland is one block everywhere.")
    level.place_block(x + 21, y, z, "minecraft:furnace")
    Test.assert(level.get_block(x + 21, y, z) == "minecraft:furnace", "minecraft:furnace is one block everywhere.")
    level.place_block(x + 0, y, z + 3, "minecraft:gold_block")
    Test.assert(level.get_block(x + 0, y, z + 3) == "minecraft:gold_block", "minecraft:gold_block is one block everywhere.")
    level.place_block(x + 3, y, z + 3, "minecraft:gold_ore")
    Test.assert(level.get_block(x + 3, y, z + 3) == "minecraft:gold_ore", "minecraft:gold_ore is one block everywhere.")
    level.place_block(x + 6, y, z + 3, "minecraft:iron_block")
    Test.assert(level.get_block(x + 6, y, z + 3) == "minecraft:iron_block", "minecraft:iron_block is one block everywhere.")
    level.place_block(x + 9, y, z + 3, "minecraft:iron_ore")
    Test.assert(level.get_block(x + 9, y, z + 3) == "minecraft:iron_ore", "minecraft:iron_ore is one block everywhere.")
    level.place_block(x + 12, y, z + 3, "minecraft:mossy_cobblestone")
    Test.assert(level.get_block(x + 12, y, z + 3) == "minecraft:mossy_cobblestone", "minecraft:mossy_cobblestone is one block everywhere.")
    level.place_block(x + 15, y, z + 3, "minecraft:oak_fence")
    Test.assert(level.get_block(x + 15, y, z + 3) == "minecraft:oak_fence", "minecraft:oak_fence is one block everywhere.")
    level.place_block(x + 18, y, z + 3, "minecraft:oak_log")
    Test.assert(level.get_block(x + 18, y, z + 3) == "minecraft:oak_log", "minecraft:oak_log is one block everywhere.")
    level.place_block(x + 21, y, z + 3, "minecraft:oak_planks")
    Test.assert(level.get_block(x + 21, y, z + 3) == "minecraft:oak_planks", "minecraft:oak_planks is one block everywhere.")
    level.place_block(x + 0, y, z + 6, "minecraft:oak_sapling")
    Test.assert(level.get_block(x + 0, y, z + 6) == "minecraft:oak_sapling", "minecraft:oak_sapling is one block everywhere.")
    level.place_block(x + 3, y, z + 6, "minecraft:oak_sign")
    Test.assert(level.get_block(x + 3, y, z + 6) == "minecraft:oak_sign", "minecraft:oak_sign is one block everywhere.")
    level.place_block(x + 6, y, z + 6, "minecraft:oak_stairs")
    Test.assert(level.get_block(x + 6, y, z + 6) == "minecraft:oak_stairs", "minecraft:oak_stairs is one block everywhere.")
    level.place_block(x + 9, y, z + 6, "minecraft:oak_wall_sign")
    Test.assert(level.get_block(x + 9, y, z + 6) == "minecraft:oak_wall_sign", "minecraft:oak_wall_sign is one block everywhere.")
    level.place_block(x + 12, y, z + 6, "minecraft:redstone_ore")
    Test.assert(level.get_block(x + 12, y, z + 6) == "minecraft:redstone_ore", "minecraft:redstone_ore is one block everywhere.")
    level.place_block(x + 15, y - 1, z + 6, "minecraft:stone")
    level.place_block(x + 15, y, z + 6, "minecraft:redstone_torch")
    Test.assert(level.get_block(x + 15, y, z + 6) == "minecraft:redstone_torch", "minecraft:redstone_torch is one block everywhere.")
    level.place_block(x + 18, y, z + 6, "minecraft:smooth_stone")
    Test.assert(level.get_block(x + 18, y, z + 6) == "minecraft:smooth_stone", "minecraft:smooth_stone is one block everywhere.")
    level.place_block(x + 21, y, z + 6, "minecraft:snow")
    Test.assert(level.get_block(x + 21, y, z + 6) == "minecraft:snow", "minecraft:snow is one block everywhere.")
    level.place_block(x + 0, y, z + 9, "minecraft:snow_block")
    Test.assert(level.get_block(x + 0, y, z + 9) == "minecraft:snow_block", "minecraft:snow_block is one block everywhere.")
    level.place_block(x + 3, y, z + 9, "minecraft:spawner")
    Test.assert(level.get_block(x + 3, y, z + 9) == "minecraft:spawner", "minecraft:spawner is one block everywhere.")
    level.place_block(x + 6, y, z + 9, "minecraft:stone_slab")
    Test.assert(level.get_block(x + 6, y, z + 9) == "minecraft:stone_slab", "minecraft:stone_slab is one block everywhere.")
    level.place_block(x + 9, y, z + 9, "minecraft:stone_stairs")
    Test.assert(level.get_block(x + 9, y, z + 9) == "minecraft:stone_stairs", "minecraft:stone_stairs is one block everywhere.")
    level.place_block(x + 12, y, z + 9, "minecraft:sugar_cane")
    Test.assert(level.get_block(x + 12, y, z + 9) == "minecraft:sugar_cane", "minecraft:sugar_cane is one block everywhere.")
    level.place_block(x + 15, y - 1, z + 9, "minecraft:stone")
    level.place_block(x + 15, y, z + 9, "minecraft:torch")
    Test.assert(level.get_block(x + 15, y, z + 9) == "minecraft:torch", "minecraft:torch is one block everywhere.")
    level.place_block(x + 18, y, z + 9, "minecraft:wheat")
    Test.assert(level.get_block(x + 18, y, z + 9) == "minecraft:wheat", "minecraft:wheat is one block everywhere.")
}
