# Test.scroll_screen forwarded to a dedicated server's joined client (#1094): the wheel is turned on
# the client's screen through the client's own wheel path, at the centre of the coverage overlay's
# box, and the answer is whether an overlay took the movement. This runs only on 1.20.6, the leg
# whose server can open coverage_gui for its player; the four older servers refuse GUI.open until
# #1098 gives them a server-side container, so they list this test as unsupported. The overlay takes
# a wheel turned down, and the screen stays open. Only a multiplayer run that forwards client calls
# runs a forwarded_ test.
started: bool = false

export tick(ctx: TestTickContext) {
    if not started {
        started = true
        Test.close_screen()
        level: Level = Test.get_client_level()
        origin: Vec3 = Test.get_origin()
        level.place_block(origin.x(), origin.y(), origin.z(), "grug:coverage_gui")
        Test.use_block(level, origin.x(), origin.y(), origin.z())
        ctx.not_done()
        return
    }
    if not Test.screen_open() {
        ctx.not_done()
        return
    }
    x: number = Math.floor(Test.screen_width() / 2)
    y: number = Test.gui_top() + Math.floor(Test.gui_height() / 2)
    ctx.assert(Test.scroll_screen(x, y, -1), "A wheel turned down over the coverage overlay's box should be taken by the client.")
    ctx.assert(Test.screen_open(), "The wheel should leave the client's screen open.")
    Test.close_screen()
    ctx.assert(not Test.screen_open(), "Test.close_screen should leave the client's screen closed.")
}
