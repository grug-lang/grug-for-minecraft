# The flat-lit block item (see coverage_flat_hand-Test.grug) lying on the ground as a dropped item entity,
# which the loader draws and not the port, so this belongs here and not in BuildCraft. On b1.7.3-stationapi
# a dropped item is drawn by ArsenicItemRenderer, whose flush is the one the unshaded rule has to wrap.
# See #963. The camera looks towards +z, so the item lies four blocks ahead of the player, on the floor.
# Seventeen blocks square of stone fills the view behind it, as in coverage_flat_hand-Test.grug, so the
# capture does not depend on the terrain. The item is never picked up, because a pickup delay as long
# as the test keeps the player from collecting it, and it is still once it has fallen and settled.
settled_ticks: number = 0
item_x: number = 0
item_y: number = 0
item_z: number = 0

export tick(ctx: TestTickContext) {
    # The default room is only a few blocks deep, so widen it first, as redstone_engine_facings-Test.grug
    # does, and let the build that makes finish before the item is dropped, since the sweep that ends a
    # build removes the item entities in the area.
    if ctx.current_tick() == 0 {
        Test.set_box_radius(10)
        ctx.not_done()
        return
    }
    if ctx.current_tick() == 6 {
        _setup(ctx)
        ctx.not_done()
        return
    }

    if ctx.current_tick() > 6 {
        seen: Option[ItemEntity] = Test.get_client_level().find_item_entity(item_x, item_y, item_z, 30)
        if not seen.has() {
            print2("item gone at tick", ctx.current_tick())
        }
    }

    # The item falls from where it was dropped and then lies still, so give it time to land.
    if ctx.current_tick() < 50 {
        ctx.not_done()
        return
    }

    if not Test.world_settled() {
        settled_ticks = 0
        ctx.not_done()
        return
    }
    if settled_ticks < 5 {
        settled_ticks = settled_ticks + 1
        ctx.not_done()
        return
    }

    level: Level = Test.get_client_level()
    ctx.assert(level.find_item_entity(item_x, item_y, item_z, 3).has(), "The dropped item should still be in the world.")
    Test.screenshot().equals(r"screenshots/coverage_flat_ground", 440, 440, 840, 700)
}

local _setup(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()

    wy: number = origin.y() - 9
    while wy < origin.y() + 8 {
        wx: number = origin.x() - 8
        while wx < origin.x() + 9 {
            level.place_block(wx, wy, origin.z() + 7, "minecraft:stone")
            wx = wx + 1
        }
        wy = wy + 1
    }

    item_x = origin.x() + 0.5
    item_y = origin.y() + 0.5
    item_z = origin.z() + 4.5
    stack: ItemStack = item_stack(item(resource_location("grug:coverage_flat_hand")), 0, 1)
    dropped: ItemEntity = item_entity(level, item_x, item_y, item_z, stack)
    dropped.set_pickup_delay(32767)
    dropped.entity().set_delta_movement(Vec3.zero())
    dropped.entity().spawn(level)
}
