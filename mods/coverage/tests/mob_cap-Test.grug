# Covers Level.count_mobs, Level.get_mob_cap and TestTickContext.spawn_mob, the reads the mob cap
# overlay (#1252) draws its three lines from. The counts are read before and after a known set of
# mobs is spawned in the one tick, so the mobs the game spawns by itself do not move the difference:
# two zombie pigmen are two more hostile mobs (they are neutral until hit, so they leave the player
# alone), a pig one more passive mob and a squid one more water mob, and none of them moves another
# category. The caps are the game's own for one player alone, 70, 15
# and 5 scaled by the 289 chunks within 8 of the player and divided by 256: 79, 16 and 5. The reads
# exist on the two Beta 1.7.3 loaders so far, so every other loader returns before it spawns anything.
export tick(ctx: TestTickContext) {
    if me.loader_name() != "b1.7.3-ornithe" and me.loader_name() != "b1.7.3-stationapi" {
        return
    }
    ctx.set_box_radius(6)
    level: Level = ctx.get_client_level()
    origin: Vec3 = ctx.get_origin()
    x: number = origin.x() + 3
    y: number = origin.y()
    z: number = origin.z() + 3

    hostile: number = level.count_mobs("hostile")
    passive: number = level.count_mobs("passive")
    water: number = level.count_mobs("water")

    ctx.spawn_mob(level, "PigZombie", x, y, z)
    ctx.spawn_mob(level, "PigZombie", x, y, z)
    ctx.assert(level.count_mobs("hostile") == hostile + 2, "Two zombie pigmen should be two more hostile mobs.")
    ctx.assert(level.count_mobs("passive") == passive, "Zombie pigmen should not count as passive mobs.")
    ctx.assert(level.count_mobs("water") == water, "Zombie pigmen should not count as water mobs.")

    ctx.spawn_mob(level, "Pig", x, y, z)
    ctx.assert(level.count_mobs("passive") == passive + 1, "A pig should be one more passive mob.")
    ctx.assert(level.count_mobs("hostile") == hostile + 2, "A pig should not count as a hostile mob.")

    ctx.spawn_mob(level, "Squid", x, y, z)
    ctx.assert(level.count_mobs("water") == water + 1, "A squid should be one more water mob.")
    ctx.assert(level.count_mobs("passive") == passive + 1, "A squid should not count as a passive mob.")

    ctx.assert(level.get_mob_cap("hostile") == 79, "One player alone should give a hostile cap of 79.")
    ctx.assert(level.get_mob_cap("passive") == 16, "One player alone should give a passive cap of 16.")
    ctx.assert(level.get_mob_cap("water") == 5, "One player alone should give a water cap of 5.")
}
