# ExtractResponse answered twice with different answers is an err, because the export has two paths that both think they decide.
export run() {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_response_block")
    be: BlockEntity = level.get_block_entity(x, y, z).unwrap()
    diamond: Item = item(resource_location("minecraft:diamond"))
    be.set_saved_number("extract_mode", 3)

    me.expect_error("has already been answered")
    be.ask_extract_item(0)
}
