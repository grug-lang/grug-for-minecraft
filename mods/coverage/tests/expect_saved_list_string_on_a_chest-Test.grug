# A list record's text is saved with the list, which only a grug block entity writes into its NBT,
# so reading or writing it on a vanilla chest must report an error.
export tick(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    origin: Vec3 = ctx.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "minecraft:chest")
    chest: BlockEntity = level.get_block_entity(x, y, z).unwrap()

    ctx.expect_error("Only a grug block entity saves lists")
    text: Option[string] = chest.get_saved_list_string("sides", 0)

    ctx.expect_error("Only a grug block entity saves lists")
    chest.set_saved_list_string("sides", 0, "north")
}
