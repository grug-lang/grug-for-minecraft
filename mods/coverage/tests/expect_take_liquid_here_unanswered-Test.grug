# A take_liquid_here export that returns without answering is an err raised by the host that asked,
# because giving nothing from the walk has to be said with answer_amount(0) and not with silence.
export tick(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    origin: Vec3 = ctx.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_response_block")
    be: BlockEntity = level.get_block_entity(x, y, z).unwrap()
    be.set_saved_number("take_mode", 3)

    ctx.expect_error("returned without answering")
    given: number = be.take_liquid_here(1000, true)
}
