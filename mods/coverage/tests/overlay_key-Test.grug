# Covers the overlay's key hook through the screen's own key path: the coverage overlay takes
# Ctrl+K and leaves every other key to the screen, so Test.press_screen_key answers true for the one
# and false for the rest. See #866.
started: bool = false
opened: bool = false
waited: number = 0

export tick_any_side(ctx: TestTickContext) {
    if not started {
        started = true
        if not Test.overlay_supported() {
            return
        }
        Test.close_screen()
        ctx.not_done()
        return
    }

    # A world frame has to be drawn before a screen that shows the player opens: the inventory
    # draws the player with the entity renderer, whose texture manager and camera the world's own
    # entity pass fills in, and a `-f mods=coverage` dispatch can run this test first, before any
    # frame has drawn (#1287). The runner puts the test that failed last first and then the
    # slowest, so any test of the mod can be that one. The test box's light is queued before the
    # test's own clock starts and the game runs ten ticks for one frame, so the first settle can
    # take a few hundred of the test's ticks; the failure bound is what says it never came.
    if not opened {
        waited = waited + 1
        ctx.assert(waited < 1000, "The world should settle before the inventory opens.")
        if not Test.world_settled() {
            ctx.not_done()
            return
        }
        Test.open_inventory(Test.get_player())
        opened = true
        waited = 0
        ctx.not_done()
        return
    }

    if not Test.screen_open() {
        waited = waited + 1
        ctx.assert(waited < 100, "The player's inventory screen should open.")
        ctx.not_done()
        return
    }

    if not Test.overlay_drawn() {
        waited = waited + 1
        ctx.assert(waited < 200, "A frame with the overlay should be drawn on the open screen.")
        ctx.not_done()
        return
    }

    ctx.assert(Test.press_screen_key(75, true, true), "Ctrl+K should be taken by the coverage overlay.")
    ctx.assert(not Test.press_screen_key(75, false, true), "K without control should be left to the screen.")
    ctx.assert(not Test.press_screen_key(76, true, true), "Ctrl+L should be left to the screen.")
    Test.close_screen()
}
