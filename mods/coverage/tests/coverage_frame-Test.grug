# Covers the per-frame block-entity hook: a model drawn as the plate the two stacks stand on, a
# stack of a block drawn as a cube, and a stack of an item drawn as a sprite turned towards the
# camera, all on top of the chunk geometry and all in front of a wall whose light has settled. The
# screenshot is the assertion.
# The crop is a world-space rectangle at 1280x720, like coverage_render's: nothing here is a GUI
# panel, so there is no virtual-space scaling to undo. The fixture sits where that test's run sits,
# so the two crops line up and the same settled-light rules apply.
# The block declares set_frame_render(), so none of its own geometry is in the chunk's mesh and
# everything it shows is drawn here every frame. The remesh below is for the wall behind it.
frame_block: Option[BlockEntity] = Option.new()

# Whether the wall has been meshed again from the settled light yet.
remeshed: bool = false

# How many runner ticks in a row the world has answered settled. See the hold in tick().
settled_ticks: number = 0

export tick(ctx: TestTickContext) {
    if ctx.current_tick() == 0 {
        _setup(ctx)
        ctx.not_done()
    } else if not Test.world_settled() {
        # The mesh below has to read the settled light, so the wait comes first. See coverage_render
        # and #257 for why one settled answer is not enough.
        settled_ticks = 0
        ctx.not_done()
    } else if settled_ticks < 5 {
        settled_ticks = settled_ticks + 1
        ctx.not_done()
    } else if not remeshed {
        _force_remesh(ctx)
        remeshed = true
        ctx.not_done()
    } else if not Test.world_settled() {
        # Waiting for the swap's blocks to reach the client and for the mesh they scheduled, which
        # is what the fixed tick hold used to stand in for. See coverage_render, #259 and #804.
        ctx.not_done()
    } else {
        _check(ctx)
    }
}

local _setup(ctx: TestTickContext) {
    level: Level = Test.get_client_level()

    # The default room is small and this fixture sits at its far edge, so ask for a room that holds
    # the block, the wall two blocks behind it and both ends of that wall. Asked for before the
    # fixture goes in, so the room's clearing cannot take the fixture out again.
    Test.set_box_radius(6)

    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y()
    z: number = origin.z()

    # The same place coverage_render's run sits: yaw 0 looks towards +z, and the frame block is four
    # blocks in front of the camera so its plate and both stacks are in the crop below.
    level.place_block(x, y - 1.88, z + 4, "grug:coverage_frame")

    # A stone wall behind it, so the stacks are compared against the wall's own settled light. Built
    # larger than the crop and centred on it, for the same reason coverage_render does: a silhouette
    # edge is where two nearly-equal shades round differently between runs.
    _wall(level, x - 6, y - 9, z + 6)

    be_opt: Option[BlockEntity] = level.get_block_entity(x, y - 1.88, z + 4)
    ctx.assert(be_opt.has(), "The frame-rendered block should have a block entity.")
    frame_block.set(be_opt.unwrap())
}

# Thirteen blocks square of minecraft:stone at (x0, y0, z), which covers the crop with room to
# spare. Kept small on purpose: every block placed re-lights the columns around it for several ticks
# afterwards.
local _wall(level: Level, x0: number, y0: number, z: number) {
    wy: number = y0
    while wy < y0 + 13 {
        wx: number = x0
        while wx < x0 + 13 {
            level.place_block(wx, wy, z, "minecraft:stone")
            wx = wx + 1
        }
        wy = wy + 1
    }
}

local _check(ctx: TestTickContext) {
    # The block entity is what the hook drew through, so a missing one would make the screenshot
    # below a picture of nothing that happens to match an empty reference.
    ctx.assert(frame_block.has(), "The frame-rendered block lost its block entity.")

    # The plate, the block item's cube and the item's sprite against the stone wall. Pixel-exact:
    # what the hook draws is the same set on every loader, and the stone background differs per
    # version because each shades a face from its own light table, so the reference directory holds
    # one PNG per loader.
    Test.screenshot().equals(r"screenshots/coverage_frame", 500, 180, 780, 340)
}

# Meshes the crop's section again from the settled light by changing a block state and putting it
# back. The swapped block is outside the crop, and dirt and stone are both opaque and unlit, so the
# swap changes no light and no compared pixel; it dirties the wall's sections and their neighbours.
local _force_remesh(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y()
    z: number = origin.z()
    level.place_block(x - 6, y + 3, z + 6, "minecraft:dirt")
    level.place_block(x - 6, y + 3, z + 6, "minecraft:stone")
    ctx.assert(level.get_block(x - 6, y + 3, z + 6) == "minecraft:stone", "The remesh swap should have put the wall block back.")
}
