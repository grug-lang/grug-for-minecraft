# A screen_render answer that closes and reopens the screen ends the open time the frame began in, so
# the host must not finish that frame for the old open time (#1885). The overlay's T key arms a
# one-shot reopen: screen_render closes the screen, opens it again and writes "reopened" to the mod's
# own file.
# The new open time's first frame has to begin with the drawn mark clear. Without the guard the old
# frame marks the new open time drawn after the reopen, so its first frame begins with the mark
# already set and overlay_first_frame_cleared answers false. A capture cannot stand in for that
# barrier, because a capture reads the last drawn frame and does not wait for a new one.
# A loader without a screen host answers an err to Screen.open, so the test returns early there, and
# it ends early on the dedicated server, whose joined client owns the screen.
started: bool = false
step: number = 0
waited: number = 0

export init(ctx: TestInitContext) {
    ctx.set_max_ticks(2000)
}

export tick(ctx: TestTickContext) {
    if not started {
        started = true
        if not me.owned_screens_supported() or not me.world_overlay_supported() or me.on_dedicated_server() {
            return
        }
        files: File = File.open(r"files")
        # The writable directory outlives a run, so the marker starts empty and a later run of the
        # suite cannot read what this test wrote before.
        files.write_text("screen_reopen/state.txt", "")
        ctx.not_done()
        return
    }

    if step == 0 {
        if not ctx.world_settled() {
            waited = waited + 1
            ctx.assert(waited < 1000, "The world should settle before the screen opens.")
            ctx.not_done()
            return
        }
        waited = 0
        if ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "No screen should be open before the test opens its own.")
            ctx.not_done()
            return
        }
        # T arms the one-shot reopen from screen_render.
        ctx.press_world_key(84, false)
        step = 1
        waited = 0
        ctx.not_done()
        return
    }

    if step == 1 {
        # H is the overlay's open key.
        ctx.press_world_key(72, false)
        step = 2
        waited = 0
        ctx.not_done()
        return
    }

    if step == 2 {
        if not ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "H should open the coverage screen.")
            ctx.not_done()
            return
        }
        files: File = File.open(r"files")
        state: string = files.read_text("screen_reopen/state.txt").unwrap()
        if state != "reopened" {
            waited = waited + 1
            ctx.assert(waited < 200, "The armed render should close and reopen the screen.")
            ctx.not_done()
            return
        }
        step = 3
        waited = 0
        ctx.not_done()
        return
    }

    if not ctx.overlay_drawn() {
        waited = waited + 1
        ctx.assert(waited < 200, "The reopened screen should draw a frame of its own.")
        ctx.not_done()
        return
    }
    ctx.assert(ctx.overlay_first_frame_cleared(), "The reopened screen's first frame should begin with the drawn mark clear.")
    ctx.close_screen()
    ctx.assert(not ctx.screen_open(), "The test's own close should leave no screen open.")
}
