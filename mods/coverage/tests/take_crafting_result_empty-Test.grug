# A grug block entity with no cached result returns 0 from take_crafting_result, the empty-result
# branch the crafting tests never reach because they always craft something first.
export run() {
    if me.tick() == 0 {
        level: Level = Test.get_client_level()
        origin: Vec3 = Test.get_origin()
        x: number = origin.x() - 5
        y: number = origin.y()
        z: number = origin.z()

        pos: BlockPos = BlockPos.new(x, y, z)
        level.place_block(pos, "grug:coverage_block")
        be_opt: Option[BlockEntity] = level.get_block_entity(pos)
        Test.assert(be_opt.has(), "coverage_block has no block entity after being placed.")

        be_be: BlockEntity = be_opt.unwrap()
        Test.assert(be_be.take_crafting_result(1) == 0, "an empty result should be 0.")
    }
}
