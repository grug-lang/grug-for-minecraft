# Covers the screen-open hook: a frame of one inventory screen sets the drawn mark, and opening a
# second inventory clears it before that screen has drawn a frame of its own. Without the hook the
# second screen would read the first screen's mark, so a render hook that never ran would go
# unnoticed. See #863.
started: bool = false
waited: number = 0

export tick(ctx: TestTickContext) {
    if not started {
        started = true
        if not Test.overlay_supported() {
            return
        }
        Test.close_screen()
        Test.open_inventory(Test.get_player())
        ctx.not_done()
        return
    }

    if not Test.screen_open() {
        waited = waited + 1
        ctx.assert(waited < 100, "The player's inventory screen should open.")
        ctx.not_done()
        return
    }

    if not Test.overlay_drawn() {
        # The first screen has to draw a frame of its own before the mark is worth clearing.
        waited = waited + 1
        ctx.assert(waited < 200, "A frame with the overlay should be drawn on the open screen.")
        ctx.not_done()
        return
    }

    # Close the drawn screen and open a fresh one. The screen-open hook runs while displayGuiScreen
    # or the mixin's init is still on the stack, so the new screen starts undrawn even though no
    # frame of it has been rendered yet.
    Test.close_screen()
    Test.open_inventory(Test.get_player())
    ctx.assert(not Test.overlay_drawn(), "Opening a new inventory should clear the drawn mark before its first frame.")
    Test.close_screen()
}
