# Covers the screen-open hook: a frame of one inventory screen sets the drawn mark, and opening a
# second inventory clears it before that screen has drawn a frame of its own. Without the hook the
# second screen would read the first screen's mark, so a render hook that never ran would go
# unnoticed. See #863.
started: bool = false
opened: bool = false
reopened: bool = false
waited: number = 0

export tick(ctx: TestTickContext) {
    if not started {
        started = true
        if not me.overlay_supported() {
            return
        }
        ctx.close_screen()
        ctx.not_done()
        return
    }

    # A world frame has to be drawn before a screen that shows the player opens: the inventory
    # draws the player with the entity renderer, whose texture manager and camera the world's own
    # entity pass fills in, and a `-f mods=coverage` dispatch can run this test first, before any
    # frame has drawn (#1287). The runner puts the test that failed last first and then the
    # slowest, so any test of the mod can be that one. The test box's light is queued before the
    # test's own clock starts and the game runs ten ticks for one frame, so the first settle can
    # take a few hundred of the test's ticks; the failure bound is what says it never came.
    if not opened {
        waited = waited + 1
        ctx.assert(waited < 1000, "The world should settle before the inventory opens.")
        if not ctx.world_settled() {
            ctx.not_done()
            return
        }
        ctx.open_inventory(ctx.get_player())
        opened = true
        waited = 0
        ctx.not_done()
        return
    }

    if not ctx.screen_open() {
        waited = waited + 1
        ctx.assert(waited < 100, "The player's inventory screen should open.")
        ctx.not_done()
        return
    }

    if not ctx.overlay_drawn() {
        # The first screen has to draw a frame of its own before the mark is worth clearing.
        waited = waited + 1
        ctx.assert(waited < 200, "A frame with the overlay should be drawn on the open screen.")
        ctx.not_done()
        return
    }

    # Close the drawn screen and open a fresh one. The screen-open hook runs while displayGuiScreen
    # or the mixin's init is still on the stack, so the new screen's first frame begins with the
    # mark already clear. A joined client draws frames of its own between the server's open and the
    # server's read, so the mark is set again by the time a forwarded read can see it: the client
    # records the mark at the moment that first frame began instead.

    # The reopened screen's answer names the screen open now by identity, so the first screen's mark
    # cannot satisfy it. Remove GrugOverlay.screenOpened() from the loader's open hook and the
    # reopened screen's first frame begins with the first screen's set mark; the wait below is still
    # satisfied by that mark, and the assert that follows is what fails, because the record is either
    # the first screen's (another identity) or carries its set mark.
    if not reopened {
        ctx.close_screen()
        ctx.open_inventory(ctx.get_player())
        reopened = true
        waited = 0
        ctx.not_done()
        return
    }

    if not ctx.screen_open() {
        waited = waited + 1
        ctx.assert(waited < 100, "The player's inventory screen should open again.")
        ctx.not_done()
        return
    }

    if not ctx.overlay_drawn() {
        waited = waited + 1
        ctx.assert(waited < 200, "A frame with the overlay should be drawn on the reopened screen.")
        ctx.not_done()
        return
    }
    ctx.assert(ctx.overlay_first_frame_cleared(), "Opening a new inventory should clear the drawn mark before its first frame.")
    ctx.close_screen()
}
