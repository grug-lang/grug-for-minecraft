# String.from_float turns a number into Java's Float.toString: the number narrowed to 32 bits, then
# the shortest text that reads back as that float. A Java program writes a float property into a file
# with string concatenation, which is this text, so a state file round-trips byte for byte. The texts
# below were printed by java-21-openjdk 21.0.13.1, the Java Build Guide 0.4.9 runs on.
export tick(ctx: TestTickContext) {
    if ctx.current_tick() == 0 {
        ctx.assert(String.from_float(3) == "3.0", "A whole float should keep a .0.")
        ctx.assert(String.from_float(2.5) == "2.5", "2.5 should write as 2.5.")
        ctx.assert(String.from_float(0.1) == "0.1", "A float 0.1 should write as 0.1, not as its long exact value.")
        ctx.assert(String.from_float(0.30000001192092896) == "0.3", "The float nearest 0.3 should write as 0.3.")
        ctx.assert(String.from_float(-3.25) == "-3.25", "A negative float should keep its sign.")
        ctx.assert(String.from_float(0) == "0.0", "Zero should write as 0.0.")
        ctx.assert(String.from_float(-0.0) == "-0.0", "Negative zero should keep its sign.")
        ctx.assert(String.from_float(0.001) == "0.001", "A thousandth should be written plainly.")
        ctx.assert(String.from_float(0.0001) == "1.0E-4", "A ten-thousandth should be written with an exponent.")
        ctx.assert(String.from_float(10000000) == "1.0E7", "Ten million should be written with an exponent.")
        ctx.assert(String.from_float(9999999) == "9999999.0", "One below ten million should be written plainly.")
        ctx.assert(String.from_float(String.to_number("1e20").unwrap()) == "1.0E20", "1e20 should be written with its float digits.")
        ctx.assert(String.from_float(String.to_number("1e-50").unwrap()) == "0.0", "A magnitude below the smallest float should write as 0.0.")
        ctx.assert(String.from_float(String.to_number("1e300").unwrap()) == "Infinity", "A magnitude past the largest float should write as Infinity.")
        ctx.assert(String.from_float(String.to_number("3.4028234663852886e38").unwrap()) == "3.4028235E38", "The largest float should write its shortest text.")
        ctx.assert(String.from_float(String.to_number("1.401298464324817e-45").unwrap()) == "1.4E-45", "The smallest float should write its shortest text.")
        ctx.assert(String.from_float(12345678) == "1.2345678E7", "A float's digits should be the shortest that read back.")
        ctx.assert(String.from_float(0.5) == "0.5", "A half should write as 0.5.")
        # Java breaks an exact tie between two decimals by taking the even last significant digit:
        # 0x3ac00000 is exactly 0.00146484375, halfway between 0.0014648437 and 0.0014648438, and it
        # writes the even 0.0014648438.
        ctx.assert(String.from_float(0.00146484375) == "0.0014648438", "A tied pair should take the even last digit.")
        # Here the even decimal is the one already held, so the odd 0.0024414063 at the same distance
        # does not replace it and the text is 0.0024414062.
        ctx.assert(String.from_float(0.00244140625) == "0.0024414062", "An odd decimal at the same distance should not replace the even one.")
        # 16777217 is exactly half a float ulp above 16777216, and a halfway decimal reads back only
        # when the value's own significand is even, because that is the one rounding goes to. The
        # exact digits are still nearer, so the text is the float's own.
        ctx.assert(String.from_float(16777216) == "1.6777216E7", "A halfway neighbour of an even float should read back but lose to the exact digits.")
        # 16777218's significand is odd, so its halfway neighbours 16777217 and 16777219 round away
        # from it and neither reads back.
        ctx.assert(String.from_float(16777218) == "1.6777218E7", "A halfway neighbour of an odd float should not read back.")
        nan: number = String.to_number("NaN").unwrap()
        ctx.assert(String.from_float(nan) == "NaN", "A NaN should write as NaN.")
        ctx.assert(String.from_float(2147483647) == "2.1474836E9", "An int narrowed to a float should write its float text.")
    }
}
