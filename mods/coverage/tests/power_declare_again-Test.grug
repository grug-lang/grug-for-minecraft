# Declaring again replaces the limit and keeps the energy, cut down to the new limit when that is
# lower. The block entity declares itself three times in its init(), and saves what each declaration
# left behind.
export tick(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_power_redeclare")
    be: BlockEntity = level.get_block_entity(x, y, z).unwrap()

    ctx.assert(be.get_saved_number("same_limit") == 8, "Declaring again with the same limit should keep the energy.")
    ctx.assert(be.get_saved_number("lower_limit") == 5, "A lower limit should cut the energy down to it.")
    ctx.assert(be.get_saved_number("received_when_full") == 0, "The store is full at the lower limit.")
    ctx.assert(be.get_saved_number("received_after_raise") == 15, "The new limit should be the one that applies.")
    ctx.assert(be.get_saved_number("stored_after_raise") == 20, "The store should be full at the new limit.")
}
