# Declaring again replaces the limit and keeps the energy, cut down to the new limit when that is
# lower. That is what a script's init() does when its chunk is loaded again, so the energy saved
# with the block entity has to still be there afterwards.
export run(ctx: TestRunContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_power_block")
    be: BlockEntity = level.get_block_entity(x, y, z).unwrap()
    be.receive_energy(8)

    be.set_power_receiver(10)
    ctx.assert(be.get_energy_stored() == 8, "Declaring again with the same limit should keep the energy.")

    be.set_power_receiver(5)
    ctx.assert(be.get_energy_stored() == 5, "A lower limit should cut the energy down to it.")
    ctx.assert(be.receive_energy(100) == 0, "The store is full at the lower limit.")

    be.set_power_receiver(20)
    ctx.assert(be.receive_energy(100) == 15, "The new limit should be the one that applies.")
    ctx.assert(be.get_energy_stored() == 20, "The store should be full at the new limit.")
}
