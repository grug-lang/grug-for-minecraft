# A dedicated server has no sound engine, so on a0.2.1 and b1.7.3 has_sound and play_ui_sound are
# forwarded to the client of the player who started the run, which answers from its own sound table
# (#1040). The assertions are the same as sound-Test's. Only those servers prove the forwarding:
# 1.20.6's ForgeAdapter answers from the local registry and does not forward, and a 1.2.5 client run
# downloads no sound resources, so its pool is empty and these assertions hold there with or
# without forwarding.
export tick(ctx: TestTickContext) {
    ctx.assert(not has_sound("minecraft:no_such_sound"), "The client should have no sound named no_such_sound.")
    if Test.loader_name() == "1.20.6-forge" {
        ctx.assert(has_sound("minecraft:ui.button.click"), "1.20.6 should have the button click.")
    } else {
        ctx.assert(not has_sound("minecraft:ui.button.click"), "The older versions name their sounds by pool, so they have no ui.button.click.")
    }

    if has_sound("minecraft:random.click") {
        play_ui_sound("minecraft:random.click", 1, 1)
    }
}
