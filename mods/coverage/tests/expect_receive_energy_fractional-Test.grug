# Energy is a whole number, so a fractional amount is reported rather than rounded.
export run() {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_power_block")
    be: BlockEntity = level.get_block_entity(x, y, z).unwrap()
    Test.expect_error("has to be a whole number from 0 to")
    receive_energy(be, 1.5)
}
