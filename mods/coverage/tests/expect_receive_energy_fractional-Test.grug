# Energy is a whole number, so a fractional amount is reported rather than rounded.
export run() {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    pos: BlockPos = BlockPos.new(x, y, z)
    level.place_block(pos, "grug:coverage_power_block")
    be: BlockEntity = level.get_block_entity(pos).unwrap()
    me.expect_error("has to be a whole number from 0 to")
    be.receive_energy(1.5)
}
