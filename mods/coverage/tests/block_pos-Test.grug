# Covers get_block_pos_of_block_entity + BlockPos.above_n + BlockPos.center.
export run(ctx: TestRunContext) {
    if ctx.tick() == 0 {
        level: Level = Test.get_client_level()
        origin: Vec3 = Test.get_origin()
        x: number = origin.x()
        y: number = origin.y()
        z: number = origin.z()

        level.place_block(x, y, z, "grug:foo_block")
        block_opt: Option[BlockEntity] = level.get_block_entity(x, y, z)
        ctx.assert(block_opt.has(), "foo_block has no block entity after being placed.")

        above: BlockPos = block_opt.unwrap().block_pos().above_n(2)
        ctx.assert(above.center().y() > origin.y(), "above_n did not move the position up.")
    }
}
