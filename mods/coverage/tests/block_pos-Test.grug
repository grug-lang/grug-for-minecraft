# Covers get_block_pos_of_block_entity + BlockPos.above_n + BlockPos.center.
export run() {
    if me.tick() == 0 {
        level: Level = Test.get_client_level()
        origin: Vec3 = Test.get_origin()
        x: number = origin.x()
        y: number = origin.y()
        z: number = origin.z()

        pos: BlockPos = BlockPos.new(x, y, z)
        level.place_block(pos, "grug:foo_block")
        block_opt: Option[BlockEntity] = level.get_block_entity(pos)
        Test.assert(block_opt.has(), "foo_block has no block entity after being placed.")

        block_be: BlockEntity = block_opt.unwrap()
        above: BlockPos = block_be.block_pos().above_n(2)
        Test.assert(above.center().y() > origin.y(), "above_n did not move the position up.")
    }
}
