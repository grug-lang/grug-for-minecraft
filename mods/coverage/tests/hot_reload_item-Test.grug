# Hot-reloads an Item script, so Grug.update's "no block data" branch runs, then restores it.
change_baseline: number = -1
path: string = "coverage/code/coverage_item-Item.grug"

export run() {
    if Test.tick() == 0 {
        Test.not_done()
    } else if Test.tick() == 1 {
        change_baseline = Test.hot_reload_count(path)
        Test.set_mod_file_state(path, "invalid")
        Test.not_done()
    } else if Test.hot_reload_count(path) <= change_baseline {
        Test.not_done()
    } else {
        Test.set_mod_file_state(path, "normal")
    }
}
