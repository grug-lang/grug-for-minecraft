# Escape reaches a mod screen's screen_key even while one of the screen's text fields has focus: the
# game closes the whole stack with Escape, so a focused field must not swallow the key a screen
# whose close hears about it needs. The overlay writes the screen it believed was on top to its own
# file when screen_key sees Escape, so that file proves the export was asked; the game's own close,
# which a field swallowing the key would fall back to, would not have written it. The same press
# then ends the whole stack, so no screen is left open and screen_closed ran once.
# A loader without a screen host answers an err to Screen.open, so the test returns early there, and
# it ends early on the dedicated server, whose joined client owns the screen.
started: bool = false
step: number = 0
waited: number = 0

export tick(ctx: TestTickContext) {
    if not started {
        started = true
        if not me.owned_screens_supported() or not me.world_overlay_supported() or me.on_dedicated_server() {
            return
        }
        files: File = File.open(r"files")
        # The writable directory outlives a run, so the marker starts empty and a later run of the
        # suite cannot read what this test wrote before.
        files.write_text("screen_typing/key.txt", "")
        ctx.not_done()
        return
    }

    if step == 0 {
        if not ctx.world_settled() {
            waited = waited + 1
            ctx.assert(waited < 1000, "The world should settle before the screen opens.")
            ctx.not_done()
            return
        }
        waited = 0
        if ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "No screen should be open before the test opens its own.")
            ctx.not_done()
            return
        }
        # H is the overlay's open key.
        ctx.press_world_key(72, false)
        step = 1
        waited = 0
        ctx.not_done()
        return
    }

    if step == 1 {
        if not ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "H should open the coverage screen.")
            ctx.not_done()
            return
        }
        # The text field is the fourth widget, at (10, 100) and 160 wide by 20 high, so a click in
        # it focuses it.
        ctx.click_screen(20, 110, 0)
        step = 2
        waited = 0
        ctx.not_done()
        return
    }

    if step == 2 {
        took: bool = ctx.press_screen_key(256, false, false, true)
        ctx.assert(took, "Escape should reach screen_key while a text field has focus.")
        files: File = File.open(r"files")
        ctx.assert(files.read_text("screen_typing/key.txt").unwrap() == "screen", "screen_key should write the screen it was asked on, so the export really saw Escape.")
        ctx.assert(not ctx.screen_open(), "Escape should end the whole screen stack, whatever the focus.")
        step = 3
        ctx.not_done()
        return
    }

    ctx.assert(not ctx.screen_open(), "The test should leave no screen open.")
}
