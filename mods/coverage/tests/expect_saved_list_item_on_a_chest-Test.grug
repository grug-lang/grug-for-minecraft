# A saved list is something only a grug block entity writes into its NBT, so asking a vanilla chest
# for a record's item reports the list error and answers an empty Option rather than a value that
# would be lost with the chest's chunk.
export run() {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "minecraft:chest")
    chest: BlockEntity = level.get_block_entity(x, y, z).unwrap()

    me.expect_error("Only a grug block entity saves lists")
    item_opt: Option[Item] = chest.get_saved_list_item("things", 0)
}
