# Diagnostic copy for #717, not for a pull request: reports the distance between this test's ticks and
# the world's clock at every one of its first ticks, with nothing at all provoking a backlog.
start: number = -1

export tick(ctx: TestTickContext) {
    now: number = Test.get_client_level().get_time()
    if start < 0 {
        start = now
    }
    if ctx.current_tick() < 60 {
        print3("DIAG plain ticks so far, world ticks since the first:", ctx.current_tick(), now - start)
        ctx.not_done()
    }
}
