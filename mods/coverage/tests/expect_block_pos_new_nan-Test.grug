# BlockPos.new must report a coordinate that is NaN, rather than address a block nowhere.
# Squaring 10000000000.0 five times overflows a double to infinity, and infinity minus infinity is NaN.
export run() {
    infinity: number = 10000000000.0
    infinity = infinity * infinity
    infinity = infinity * infinity
    infinity = infinity * infinity
    infinity = infinity * infinity
    infinity = infinity * infinity
    nan: number = infinity - infinity

    me.expect_error("BlockPos.new: x must be a whole number within 32 bits, got NaN")
    BlockPos.new(nan, 2, 3)
}
