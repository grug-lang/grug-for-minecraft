# A block entity script that never mentions me in its member scope still finds me in its exports: the host
# registers the block entity under the grug entity's own id when it creates the entity, so nothing has to
# resolve me during creation first. A script that relied on the old behaviour needed a throwaway member-scope
# line such as `level: Level = me.level()`. See #604.
export tick(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_me_block")
    block: BlockEntity = level.get_block_entity(x, y, z).unwrap()

    # tick is an export the host calls long after creation, with nothing binding me.
    before_ticks: number = block.get_saved_number("ticks")
    Test.tick_block_entity(block, 1)
    after_ticks: number = block.get_saved_number("ticks")
    ctx.assert(after_ticks - before_ticks >= 1, "tick should have found me and counted the tick.")

    # item_inserted is the same: the loader calls it from the inventory hook, not from creation.
    before_insertions: number = block.get_saved_number("insertions")
    diamond: Item = item(resource_location("minecraft:diamond"))
    block.set_item_in_slot(0, diamond, 1)
    after_insertions: number = block.get_saved_number("insertions")
    ctx.assert(after_insertions - before_insertions == 1, "item_inserted should have found me and counted the insertion.")
}
