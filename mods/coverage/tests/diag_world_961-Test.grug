# Throwaway diagnostic for #961: captures the whole frame behind an open inventory repeatedly.
phase: number = 0
waited: number = 0
taken: number = 0
reopen: number = 0

export tick(ctx: TestTickContext) {
    if phase == 0 {
        phase = 1
        Test.close_screen()
        ctx.not_done()
        return
    }
    if phase == 1 {
        waited = waited + 1
        ctx.assert(waited < 1000, "settle")
        if not Test.world_settled() {
            ctx.not_done()
            return
        }
        Test.open_inventory(Test.get_player())
        phase = 2
        waited = 0
        ctx.not_done()
        return
    }
    if phase == 2 {
        waited = waited + 1
        ctx.assert(waited < 100, "screen")
        if not Test.screen_open() or not Test.world_settled() {
            ctx.not_done()
            return
        }
        phase = 3
        waited = 0
    }
    if phase == 3 {
        Test.screenshot().capture(0, 0, 1280, 720)
        taken = taken + 1
        Test.stall(60)
        if taken < 20 {
            ctx.not_done()
            return
        }
        Test.close_screen()
        taken = 0
        phase = 4
        ctx.not_done()
        return
    }
    if phase == 4 {
        # reopen after letting the world run
        waited = waited + 1
        if waited < 40 {
            ctx.not_done()
            return
        }
        waited = 0
        Test.open_inventory(Test.get_player())
        phase = 5
        ctx.not_done()
        return
    }
    if phase == 5 {
        waited = waited + 1
        ctx.assert(waited < 100, "screen2")
        if not Test.screen_open() or not Test.world_settled() {
            ctx.not_done()
            return
        }
        Test.screenshot().capture(0, 0, 1280, 720)
        Test.stall(60)
        taken = taken + 1
        if taken < 6 {
            ctx.not_done()
            return
        }
        Test.close_screen()
    }
}
