# ctx.set_gui_scale makes the client lay its HUD and screens out at another size, and
# ctx.screen_width reads the open screen's width, so the two together say the scale took effect
# (#1752). The runner's window is 1280 by 720, where scale 1 gives a 1280-wide screen and scale 2 a
# 640-wide one. The test puts the scale back to 3, the scale the game's own automatic setting picks
# for that window, and checks the width it started with came back, so the next test finds the client
# as this one did. A dedicated server has no client window, and the entry reports that there instead
# of pretending to set a scale, so the test leaves that leg alone.
started: bool = false
opened: bool = false
measured: bool = false
waited: number = 0
before: number = 0

export tick(ctx: TestTickContext) {
    if not started {
        started = true
        if me.on_dedicated_server() {
            return
        }
        ctx.close_screen()
        ctx.not_done()
        return
    }

    # The scale shows on the open screen, so the inventory opens first; the world has to settle
    # before the game will open it (#1287).
    if not opened {
        waited = waited + 1
        ctx.assert(waited < 1000, "The world should settle before the inventory opens.")
        if not ctx.world_settled() {
            ctx.not_done()
            return
        }
        ctx.open_inventory(ctx.get_player())
        opened = true
        waited = 0
        ctx.not_done()
        return
    }

    if not ctx.screen_open() {
        waited = waited + 1
        ctx.assert(waited < 100, "The player's inventory screen should open.")
        ctx.not_done()
        return
    }

    if not measured {
        measured = true
        before = ctx.screen_width()
        ctx.assert(before > 0, "The open inventory should have a width.")
        ctx.set_gui_scale(1)
        ctx.assert(ctx.screen_width() == 1280, "GUI scale 1 should lay the screen out 1280 wide at 1280 by 720.")
        ctx.set_gui_scale(2)
        ctx.assert(ctx.screen_width() == 640, "GUI scale 2 should lay the screen out 640 wide at 1280 by 720.")
        ctx.set_gui_scale(3)
        ctx.assert(ctx.screen_width() == before, "Restoring GUI scale 3 should lay the screen out as it was before the test.")
        ctx.close_screen()
    }
}
