# A load with nothing staged for the block entity has nothing to apply, which is a test that forgot
# its edits or loaded twice, so it is reported rather than read as a no-op.
export run() {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_init_block")
    be: BlockEntity = level.get_block_entity(x, y, z).unwrap()

    me.expect_error("Test.load_nbt: Nothing was staged for this block entity.")
    Test.load_nbt(be)
}
