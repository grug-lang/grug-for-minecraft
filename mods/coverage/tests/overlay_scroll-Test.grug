# Covers the overlay's scroll hook through the screen's own wheel path: the coverage overlay takes a
# wheel turned down over its box, and one turned up by three notches or more, and leaves every other
# movement to the screen, so Test.scroll_screen answers true for those and false for the rest. See
# #986.
started: bool = false
opened: bool = false
waited: number = 0

export tick_any_side(ctx: TestTickContext) {
    if not started {
        started = true
        if not Test.overlay_supported() {
            return
        }
        Test.close_screen()
        ctx.not_done()
        return
    }

    # A world frame has to be drawn before a screen that shows the player opens: the inventory
    # draws the player with the entity renderer, whose texture manager and camera the world's own
    # entity pass fills in, and a `-f mods=coverage` dispatch can run this test first, before any
    # frame has drawn (#1287). The runner puts the test that failed last first and then the
    # slowest, so any test of the mod can be that one. The test box's light is queued before the
    # test's own clock starts and the game runs ten ticks for one frame, so the first settle can
    # take a few hundred of the test's ticks; the failure bound is what says it never came.
    if not opened {
        waited = waited + 1
        ctx.assert(waited < 1000, "The world should settle before the inventory opens.")
        if not Test.world_settled() {
            ctx.not_done()
            return
        }
        Test.open_inventory(Test.get_player())
        opened = true
        waited = 0
        ctx.not_done()
        return
    }

    if not Test.screen_open() {
        waited = waited + 1
        ctx.assert(waited < 100, "The player's inventory screen should open.")
        ctx.not_done()
        return
    }

    if not Test.overlay_drawn() {
        waited = waited + 1
        ctx.assert(waited < 200, "A frame with the overlay should be drawn on the open screen.")
        ctx.not_done()
        return
    }

    # The overlay's box is at the centre of the screen, which is the middle of the GUI.
    x: number = Math.floor(Test.screen_width() / 2)
    y: number = Test.gui_top() + Math.floor(Test.gui_height() / 2)
    ctx.assert(Test.scroll_screen(x, y, -1), "A wheel turned down over the box should be taken.")
    ctx.assert(Test.scroll_screen(x, y, -0.5), "A half notch down over the box should be taken.")
    ctx.assert(Test.scroll_screen(x, y, 3), "A wheel turned up by three notches should be taken.")
    ctx.assert(not Test.scroll_screen(x, y, 1), "A wheel turned up by one notch should be left to the screen.")
    ctx.assert(not Test.scroll_screen(1, 1, -1), "A wheel turned over a corner of the screen should be left to the screen.")
    Test.close_screen()
}
