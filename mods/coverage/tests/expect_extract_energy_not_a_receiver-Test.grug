# extract_energy takes from a receiver's own store, so a block entity that declared nothing is reported.
export run(ctx: TestRunContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_block")
    be: BlockEntity = level.get_block_entity(x, y, z).unwrap()
    ctx.expect_error("is not an energy receiver")
    be.extract_energy(1)
}
