# Covers Player.position, Player.pitch, Player.state, the PlayerState reads, Weather and the test
# entries that drive them (#1347). The toy world's player stands at the origin, on the ground, full
# and dry, and the weather starts clear.
export tick(ctx: TestTickContext) {
    player: Player = ctx.get_player()
    origin: Vec3 = ctx.get_origin()
    pos: Vec3 = player.position()
    ctx.assert(pos.x() == origin.x() and pos.y() == origin.y() and pos.z() == origin.z(), "The player should stand where the test started them.")
    ctx.assert(player.pitch() == 0, "The player should look level before a test sets a pitch.")
    ctx.set_player_pitch(45)
    ctx.assert(player.pitch() == 45, "A test should be able to set the player's pitch.")
    state: PlayerState = player.state()
    ctx.assert(state.air() == 300, "The toy player should hold their breath for 300 ticks.")
    ctx.assert(state.fall_distance() == 0, "A standing player should have fallen no distance.")
    ctx.assert(state.food() == 20, "The toy player should be full.")
    ctx.assert(state.health() == 20, "The toy player should be at full health.")
    ctx.assert(not state.in_minecart(), "A standing player should ride no minecart.")
    ctx.assert(not state.is_in_water(), "The toy player should not be in water.")
    ctx.assert(state.motion_x() == 0 and state.motion_y() == 0 and state.motion_z() == 0, "A standing player should not be moving.")
    ctx.assert(state.on_ground(), "The toy player should stand on the ground.")
    ctx.assert(state.riding_motion_x() == 0 and state.riding_motion_y() == 0 and state.riding_motion_z() == 0, "A player riding nothing should have no riding motion.")
    level: Level = ctx.get_client_level()
    weather: Weather = level.get_weather()
    ctx.assert(not weather.is_raining(), "The weather should start clear.")
    ctx.assert(not weather.is_thundering(), "The weather should start without thunder.")
    ctx.assert(not state.is_wet(), "A dry, clear day should leave the player dry.")
    clear: number = weather.skylight_subtracted()
    ctx.assert(clear >= 0 and clear <= 11, "The sky light the weather takes away should be from 0 to 11 levels.")
    ctx.set_weather(true, false)
    ctx.assert(weather.is_raining(), "A test should be able to make it rain.")
    ctx.assert(not weather.is_thundering(), "Rain without thunder should not thunder.")
    ctx.assert(state.is_wet(), "Rain falling on an open player should make them wet.")
    rain: number = weather.skylight_subtracted()
    ctx.assert(rain >= clear, "Rain should take at least the sky light a clear sky takes away, not give any back.")
    ctx.set_weather(false, true)
    ctx.assert(weather.is_raining(), "Thunder should come with rain.")
    ctx.assert(weather.is_thundering(), "A test should be able to make it thunder.")
    ctx.assert(weather.skylight_subtracted() >= rain, "Thunder should take at least the sky light rain takes away.")
    level.set_time(18000)
    night: number = weather.skylight_subtracted()
    level.set_time(6000)
    ctx.assert(night != weather.skylight_subtracted(), "Midnight and noon should not take the same sky light away.")
    bx: number = Math.floor(pos.x())
    by: number = Math.floor(pos.y())
    bz: number = Math.floor(pos.z())
    ctx.assert(weather.rain_height(bx, bz) == 0, "A column with no block in it should have no rain height.")
    level.place_block(bx, by + 5, bz, "minecraft:stone")
    ctx.assert(weather.rain_height(bx, bz) == by + 5, "The rain height should be the column's highest block that rain reaches.")
    level.place_block(bx, by + 5, bz, "minecraft:air")
}
