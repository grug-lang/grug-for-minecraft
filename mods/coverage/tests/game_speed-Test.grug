# Covers the game's clock the runner speeds up for every test: a test counts the runner's ticks and
# runs to the end whatever speed the loader runs its clock at, including 1x on a loader that cannot
# speed it up and under GRUG_CI_MAX_GAME_SPEED=1. How fast it ran is not something a test can see,
# because the speed changes only how many seconds the same ticks take, so the runner's log is where
# the speed shows (#633, #677). The room and the block the test places are built at real time and
# the test is back at real time when it ends, which the tests that run after it, whose goldens would
# shift otherwise, are the proof of.
export tick(ctx: TestTickContext) {
    if ctx.current_tick() < 100 {
        ctx.not_done()
    } else {
        ctx.assert(ctx.current_tick() == 100, "A faster clock changes how long a tick takes, not how many the test counts.")
    }
}
