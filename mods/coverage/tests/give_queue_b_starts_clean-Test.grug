# The second half of the pair give_queue_a_ends_with_a_give (#1144). That test made its last press
# in its last tick, so the give was still queued on the server when the runner reset the state this
# test starts from. The reset drops that queue, so this test meets the inventory it was reset to: the
# item the give named is not in the player's hand. A give fills the first empty slot, which is the
# selected hotbar slot the runner empties, so the hand is the slot the dropped give would have
# filled.

# The test before this one closes its own screen now, so this test opens nothing and closes
# nothing. The pair only bites when give_queue_a ran first, because a client-only run orders tests by
# their measured time rather than by name; the unit tests over the queue are the deterministic proof.
started: bool = false

export tick_any_side(ctx: TestTickContext) {
    if not started {
        started = true
        # One more tick, so the drain that would apply a queued give has run: the leak the pair
        # guards against is a give applied by the first drain after this test's reset.
        ctx.not_done()
        return
    }
    ctx.assert(Test.get_held_count(Test.get_player()) == 0, "The item the previous test's give sent should not reach this one's hand.")
    ctx.assert(not Test.get_player().get_held_item().has(), "The previous test's give should leave this one with an empty hand.")
}
