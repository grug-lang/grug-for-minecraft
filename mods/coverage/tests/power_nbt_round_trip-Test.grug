# The energy a receiver holds is saved with its block entity, so it is still there after the block
# entity is written out and read back, as it is when its chunk is unloaded and loaded again.
export run() {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    pos: BlockPos = BlockPos.new(x, y, z)
    level.place_block(pos, "grug:coverage_power_block")
    be: BlockEntity = level.get_block_entity(pos).unwrap()
    be.receive_energy(6)
    be.set_saved_number("energy", 3)

    Test.round_trip_nbt(be)

    Test.assert(be.get_energy_stored() == 6, "The energy should survive an NBT round trip.")
    Test.assert(be.get_saved_number("energy") == 3, "A saved number should survive it beside the energy.")
}
