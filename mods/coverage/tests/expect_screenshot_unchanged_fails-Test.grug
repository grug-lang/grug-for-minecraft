# One capture compared against itself is an unchanged frame by construction. Two captures a round
# trip apart can hold different frames while the client is still rendering, which flaked this gate
# on the b1.7.3-stationapi dedicated-server leg (run 42217883281): the test then completed without
# the error it asks for. The comparison still covers Screenshot.differs_from's unchanged branch,
# which is what stops the assertion from passing a loader that never reloaded anything.
export tick_any_side(ctx: TestTickContext) {
    # Matched on the wording rather than the number, so the check does not depend on how the
    # share is formatted.
    ctx.expect_error("the frame still shows what it showed before")
    shot: Screenshot = Test.screenshot().capture(590, 310, 690, 410)
    shot.differs_from(shot, 50)
}
