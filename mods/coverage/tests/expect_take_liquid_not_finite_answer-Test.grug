# A take_liquid export that answers a NaN or an infinity is an err: neither is an amount the host
# can use, and NaN would pass a plain "0 or more" check back to the caller.
export tick(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    origin: Vec3 = ctx.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_response_block")
    be: BlockEntity = level.get_block_entity(x, y, z).unwrap()

    be.set_saved_number("take_mode", 4)
    ctx.expect_error("a finite amount of 0 or more")
    given: number = be.take_liquid(1000, true)

    be.set_saved_number("take_mode", 5)
    ctx.expect_error("a finite amount of 0 or more")
    given_again: number = be.take_liquid(1000, true)
}
