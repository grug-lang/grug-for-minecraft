# A bound past a Java int names no size either, so it is reported rather than truncated to one the
# caller did not ask for (#1752).
export tick(ctx: TestTickContext) {
    stream: Random = Random.new_seeded(1.0)

    ctx.expect_error("The bound has to be a whole number from 1 to")
    value: number = stream.next_int(2147483648.0)
}
