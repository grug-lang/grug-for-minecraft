# count_mobs refuses a category that is not hostile, passive or water, because an unknown name has no
# count or cap to answer with, so it must report an error rather than answer 0. The reads exist on
# the two Beta 1.7.3 loaders, 1.2.5-forge, 1.20.6 and Alpha 1.1.2_01 so far, so every other loader returns before it asks. See #1252.
export tick(ctx: TestTickContext) {
    if me.loader_name() != "b1.7.3-ornithe" and me.loader_name() != "b1.7.3-stationapi" and me.loader_name() != "1.20.6-forge" and me.loader_name() != "1.2.5-forge" and me.loader_name() != "a1.1.2_01-ornithe" {
        return
    }
    level: Level = ctx.get_client_level()
    ctx.expect_error("The category has to be one of hostile, passive, water")
    level.count_mobs("ghost")
}
