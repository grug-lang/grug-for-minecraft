# Screenshot.tolerance rejects a fractional percentage: only whole numbers are meaningful.
export tick(ctx: TestTickContext) {
    if ctx.current_tick() == 0 {
        ctx.expect_error("percent must be a whole number between 0 and 100")
        Test.screenshot().tolerance(1.5).equals(r"screenshots/dummy", 590, 310, 690, 410)
    }
}
