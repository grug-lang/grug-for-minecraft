# A liquid is named by its still block, and a name that is no liquid is reported before it reaches
# the walk, as offer_liquid reports it.
export tick(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    origin: Vec3 = ctx.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_response_block")
    be: BlockEntity = level.get_block_entity(x, y, z).unwrap()

    ctx.expect_error("is not a liquid")
    taken: number = be.offer_liquid_here("minecraft:stone", 1000, 0, true)
}
