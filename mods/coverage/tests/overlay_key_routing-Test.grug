# The screen's key path decides which keys an overlay is asked about and when a held key is a
# repeat, which is the loader's own routing (#866): only a letter, a digit, space and backspace
# reach an overlay, a repeat of a key still down is not a new press, and a release lets the key be
# pressed again. The coverage overlay takes Ctrl+K, Ctrl+space and Ctrl+backspace always, and Ctrl+Z
# only on the first press of a screen, so a taken key and a key the screen keeps can be told apart.

started: bool = false
opened: bool = false
waited: number = 0

export tick(ctx: TestTickContext) {
    if not started {
        started = true
        if not me.overlay_supported() {
            # This loader draws no overlays; the deviation is in about.json.
            return
        }
        ctx.close_screen()
        ctx.not_done()
        return
    }

    # A world frame has to be drawn before a screen that shows the player opens, as overlay-Test
    # explains (#1287).
    if not opened {
        waited = waited + 1
        ctx.assert(waited < 1000, "The world should settle before the inventory opens.")
        if not ctx.world_settled() {
            ctx.not_done()
            return
        }
        ctx.open_inventory(ctx.get_player())
        opened = true
        waited = 0
        ctx.not_done()
        return
    }

    if not ctx.screen_open() {
        waited = waited + 1
        ctx.assert(waited < 100, "The player's inventory screen should open.")
        ctx.not_done()
        return
    }

    if not ctx.overlay_drawn() {
        waited = waited + 1
        ctx.assert(waited < 200, "A frame with the overlay should be drawn on the open screen.")
        ctx.not_done()
        return
    }

    # Every key the loader routes reaches an overlay, and the coverage overlay takes the three it
    # binds: Ctrl+K, Ctrl+space and Ctrl+backspace.
    ctx.assert(ctx.press_screen_key(75, true, true), "Ctrl+K should be taken by the coverage overlay.")
    ctx.assert(ctx.press_screen_key(32, true, true), "Ctrl+space should be taken by the coverage overlay.")
    ctx.assert(ctx.press_screen_key(8, true, true), "Ctrl+backspace should be taken by the coverage overlay.")

    # A routed key that no overlay binds is left to the screen, and one outside the routed ranges is
    # not asked at all.
    ctx.assert(not ctx.press_screen_key(76, true, true), "Ctrl+L should be left to the screen.")
    ctx.assert(not ctx.press_screen_key(65, true, true), "Ctrl+A should be left to the screen.")
    ctx.assert(not ctx.press_screen_key(48, true, true), "Ctrl+0 should be left to the screen.")
    ctx.assert(not ctx.press_screen_key(97, true, true), "A key below A should not be routed as a letter.")
    ctx.assert(not ctx.press_screen_key(58, true, true), "A key above 9 should not be routed as a digit.")
    ctx.assert(not ctx.press_screen_key(47, true, true), "A key outside every routed range should not be asked.")

    # A key still down repeats without asking, and a release lets it be pressed again. The press
    # with the release is the release of the held key, so it is not a new press either.
    ctx.assert(ctx.press_screen_key(75, true, false), "The first press of a key should be asked and taken.")
    ctx.assert(not ctx.press_screen_key(75, true, false), "A repeat of a key still down should not be asked.")
    ctx.assert(not ctx.press_screen_key(75, true, true), "The release of a held key is not a new press.")
    ctx.assert(ctx.press_screen_key(75, true, true), "A press after the release should be asked again.")

    # Another key is asked while one is held, and releasing it does not release the held one. The
    # coverage overlay takes Ctrl+Z once per screen, so the second press of it is left.
    ctx.assert(ctx.press_screen_key(90, true, false), "The first Ctrl+Z on a screen should be taken.")
    # A key outside every routed range is not asked, and does not release the key that is held.
    ctx.assert(not ctx.press_screen_key(47, true, true), "A key outside every routed range should not be asked.")
    ctx.assert(not ctx.press_screen_key(76, true, true), "Ctrl+L should still be asked while Ctrl+Z is held.")
    ctx.assert(ctx.press_screen_key(75, true, false), "Ctrl+K should still be asked while Ctrl+Z is held.")
    ctx.assert(not ctx.press_screen_key(90, true, true), "A second Ctrl+Z on the same screen should be left.")
    ctx.close_screen()
}
