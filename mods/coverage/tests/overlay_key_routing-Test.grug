# The screen's key path decides which keys an overlay is asked about and when a held key is a
# repeat, which is the loader's own routing (#866): only a letter, a digit, space and backspace
# reach an overlay as a key, a repeat of a key still down is asked again with repeat() true, and a
# release lets the key be pressed again as a new press. The coverage overlay takes Ctrl+K, Ctrl+space
# and Ctrl+backspace always, Ctrl+Z only on the first press of a screen, and the repeat of Ctrl+A
# alone (#1741), so a taken key, a key the screen keeps and a repeat can each be told apart.

started: bool = false
opened: bool = false
waited: number = 0

export tick(ctx: TestTickContext) {
    if not started {
        started = true
        if not me.overlay_supported() {
            # This loader draws no overlays; the deviation is in about.json.
            return
        }
        ctx.close_screen()
        ctx.not_done()
        return
    }

    # A world frame has to be drawn before a screen that shows the player opens, as overlay-Test
    # explains (#1287).
    if not opened {
        waited = waited + 1
        ctx.assert(waited < 1000, "The world should settle before the inventory opens.")
        if not ctx.world_settled() {
            ctx.not_done()
            return
        }
        ctx.open_inventory(ctx.get_player())
        opened = true
        waited = 0
        ctx.not_done()
        return
    }

    if not ctx.screen_open() {
        waited = waited + 1
        ctx.assert(waited < 100, "The player's inventory screen should open.")
        ctx.not_done()
        return
    }

    if not ctx.overlay_drawn() {
        waited = waited + 1
        ctx.assert(waited < 200, "A frame with the overlay should be drawn on the open screen.")
        ctx.not_done()
        return
    }

    # Every key the loader routes reaches an overlay, and the coverage overlay takes the three it
    # binds: Ctrl+K, Ctrl+space and Ctrl+backspace.
    ctx.assert(ctx.press_screen_key(75, true, false, true), "Ctrl+K should be taken by the coverage overlay.")
    ctx.assert(ctx.press_screen_key(32, true, false, true), "Ctrl+space should be taken by the coverage overlay.")
    ctx.assert(ctx.press_screen_key(8, true, false, true), "Ctrl+backspace should be taken by the coverage overlay.")

    # A routed key that no overlay binds is left to the screen.
    ctx.assert(not ctx.press_screen_key(76, true, false, true), "Ctrl+L should be left to the screen.")
    ctx.assert(not ctx.press_screen_key(65, true, false, true), "Ctrl+A should be left to the screen.")
    ctx.assert(not ctx.press_screen_key(48, true, false, true), "Ctrl+0 should be left to the screen.")

    # A key still down is asked again as a repeat, which the overlay reads through repeat(): the
    # coverage overlay takes the repeat of Ctrl+A and leaves its first press, so the flag is told
    # apart from the press. The press carrying the release is still a repeat of the key still down,
    # and the press after it is a new press.
    ctx.assert(not ctx.press_screen_key(65, true, false, false), "The first press of a held key should be asked and left to the screen.")
    ctx.assert(ctx.press_screen_key(65, true, false, false), "A repeat of a key still down should be asked with repeat() true and taken.")
    ctx.assert(ctx.press_screen_key(65, true, false, true), "The release of a held key is still its repeat and is taken.")
    ctx.assert(not ctx.press_screen_key(65, true, false, true), "A press after the release is a new press and is left to the screen.")

    # Another key is asked while one is held, and is the key held afterwards, so pressing it does
    # not release the first. The coverage overlay takes Ctrl+Z once per screen, so its second press
    # is left, and that release does not let go of the key still down.
    ctx.assert(ctx.press_screen_key(90, true, false, false), "The first Ctrl+Z on a screen should be taken.")
    ctx.assert(not ctx.press_screen_key(76, true, false, false), "Ctrl+L should be asked while Ctrl+Z is held.")
    ctx.assert(ctx.press_screen_key(75, true, false, false), "Ctrl+K should be asked while Ctrl+L is held.")
    ctx.assert(not ctx.press_screen_key(90, true, false, true), "A second Ctrl+Z on the same screen should be left.")
    ctx.close_screen()
}
