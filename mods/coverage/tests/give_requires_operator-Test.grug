# A player's own give is applied only if the player is an operator, the way the reference JEI's server
# half does (#882): the overlay's click on a client joined to a dedicated server asks the server to
# put the item in that player's inventory, and the server refuses a player who is not an operator
# with an error shown to them. The test runs on the server, which holds the operator list, so it
# flips the player's status there with set_operator (#1331) and presses the overlay's item from the
# joined client: as a non-operator nothing is given, as an operator one item is.

# The press is a forwarded call: the client sends its give before it answers the call, and the server
# applies every give it holds before the next tick of this test, so the refusal is final when the
# next tick starts and no tick count is waited for. The status is put back before anything asserts,
# so a failed assert never leaves the operator list changed for the next test.

# Only the 1.20.6, 1.2.5, a1.1.2_01-ornithe, b1.7.3-ornithe and b1.7.3-stationapi dedicated legs run
# it: a client-only run gives to its own player, who is the world's owner. The others return on
# their first tick (#882).

started: bool = false
opened: bool = false
waited: number = 0
step: number = 0
was_operator: bool = false
first_pressed: bool = false
second_pressed: bool = false

export tick(ctx: TestTickContext) {
    if not started {
        started = true
        if not me.on_dedicated_server() or (me.loader_name() != "1.20.6-forge" and me.loader_name() != "1.2.5-forge" and me.loader_name() != "a1.1.2_01-ornithe" and me.loader_name() != "b1.7.3-ornithe" and me.loader_name() != "b1.7.3-stationapi") or not me.overlay_supported() {
            # See the top of this file for where this test runs.
            return
        }
        ctx.close_screen()
        ctx.not_done()
        return
    }

    # A world frame has to be drawn before a screen that shows the player opens: the inventory
    # draws the player with the entity renderer, whose texture manager and camera the world's own
    # entity pass fills in, and a `-f mods=coverage` dispatch can run this test first, before any
    # frame has drawn (#1287). The runner puts the test that failed last first and then the
    # slowest, so any test of the mod can be that one. The test box's light is queued before the
    # test's own clock starts and the game runs ten ticks for one frame, so the first settle can
    # take a few hundred of the test's ticks; the failure bound is what says it never came.
    if not opened {
        waited = waited + 1
        ctx.assert(waited < 1000, "The world should settle before the inventory opens.")
        if not ctx.world_settled() {
            ctx.not_done()
            return
        }
        ctx.open_inventory(ctx.get_player())
        opened = true
        waited = 0
        ctx.not_done()
        return
    }

    if not ctx.screen_open() {
        waited = waited + 1
        ctx.assert(waited < 100, "The player's inventory screen should open.")
        ctx.not_done()
        return
    }

    if not ctx.overlay_drawn() {
        waited = waited + 1
        ctx.assert(waited < 200, "A frame with the overlay should be drawn on the open screen.")
        ctx.not_done()
        return
    }

    box_x: number = ctx.gui_left() + Math.floor(ctx.gui_width() / 2)
    box_y: number = ctx.gui_top() + Math.floor(ctx.gui_height() / 2)

    if step == 0 {
        ctx.clear_carried_item()
        ctx.assert(ctx.get_held_count(ctx.get_player()) == 0, "The hand should be empty before the first press.")
        was_operator = is_operator()
        set_operator(false)
        first_pressed = ctx.click_screen(box_x, box_y, 0)
        step = 1
        ctx.not_done()
        return
    }

    if step == 1 {
        # The first press has reached the server by now, but this test does not read its absence:
        # the server applies the presses in the order they were sent, each under the status it
        # finds, so a press that was not applied yet would be applied under the status this tick
        # sets and would show as a second item below. A refused press shows as no item at all.
        set_operator(true)
        second_pressed = ctx.click_screen(box_x, box_y, 0)
        waited = 0
        step = 2
        ctx.not_done()
        return
    }

    # Both presses are the server's before the operator's item shows, so the status stays until it
    # does: the wait is on the item, with a bound that says it never came.
    held: Option[Item] = ctx.get_player().get_held_item()
    if not held.has() and waited < 200 {
        waited = waited + 1
        ctx.not_done()
        return
    }

    # Every read is taken before the status goes back and asserted after it, so a failed assert
    # never leaves the operator list changed for the next test.
    count: number = ctx.get_held_count(ctx.get_player())
    has_item: bool = held.has()
    drew_item: bool = has_item and equals(held.unwrap(), item_at(0))
    set_operator(was_operator)
    ctx.clear_held_item(ctx.get_player())
    ctx.close_screen()

    ctx.assert(first_pressed, "The overlay should take the first left click on its item.")
    ctx.assert(second_pressed, "The overlay should take the second left click on its item.")
    ctx.assert(has_item, "An operator should be given the item the overlay drew.")
    ctx.assert(drew_item, "The overlay should give the item it drew, not another one.")
    ctx.assert(count == 1, "Only the operator's press should give an item: the refused press gives none.")
}
