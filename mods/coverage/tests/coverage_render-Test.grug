# Covers the block-entity rendering hook: a block that declares set_custom_render draws its own
# geometry instead of its cube, and the shape it draws is what lands on screen. The screenshot is
# the assertion. It deliberately is not a pixel comparison against the cube the hook replaced:
# freezing that here would make the test pass for the placeholder it exists to remove. It compares
# the real geometry, so a change to the shape, the texture or the lighting shows up as a diff
# rather than passing quietly.
# The crop is a world-space rectangle at 1280x720, unlike the autocrafting table GUI test: nothing
# here is a GUI panel, so there is no virtual-space scaling to undo. Where the shape and its
# background end up is worked out from where the camera setup leaves them, in _setup.
render_block: Option[BlockEntity] = Option.new()

export run() {
    if Test.tick() == 0 {
        # Only a1.1.2_01-ornithe implements the hook today, and the others would draw the cube this
        # test exists to show is gone. Asking first is the shape the recipe tests use: a loader that
        # cannot do it does not fail the run for it. This goes away as the others land.
        if not supports_custom_geometry() {
            return
        }

        _setup()
        Test.not_done()
    } else if Test.tick() < 60 {
        # How long the placed shape takes to reach the framebuffer, and how long the wall's light
        # takes to settle. Alpha has to mesh the chunk around the new blocks, upload the texture and
        # compile the chunk before any of the geometry is drawn, and every block placed re-lights its
        # column for a few ticks after that. Measured on the CI stack the first real frame lands
        # between tick 16 and tick 30 depending on how loaded the machine is; 60 leaves a wide margin
        # over both, and costs 3 seconds of a 200-tick budget. Raise it rather than touch the crop
        # rectangle if a capture ever comes out stale.
        Test.not_done()
    } else {
        _check()
        Test.restore_camera()
    }
}

local _setup() {
    level: Level = Test.get_client_level()

    # The autocrafting table test, which sorts before this one because it is under buildcraft/,
    # opens the real GUI and leaves it open: one client serves the whole run, so a screen outlives
    # the test that opened it and sits over the world in every frame after. hot_reload_texture-Test
    # closes it for the same reason. Without this the capture below is of that panel.
    Test.close_screen()

    origin: Vec3 = Test.setup_graphics_camera()
    x: number = origin.x()
    y: number = origin.y()
    z: number = origin.z()

    # The camera setup levels the view without moving the player. setup_graphics_camera returns the
    # render camera's position plus 3, so y - 1.88 puts the run just above the camera, which is
    # where the crop below expects it. yaw 0 looks towards +z, so +4 is in front of them rather
    # than inside them.
    # A straight run along x, so the middle block draws arms on two opposite sides and none
    # elsewhere. Three rather than one, because a lone block draws only its core: a cube inset from
    # the faces, which says nothing about the arms the hook exists for. The outer two prove the arms
    # are read from the neighbours, since neither draws one on its outer end.
    level.place_block(x - 1, y - 1.88, z + 4, "grug:coverage_render")
    level.place_block(x, y - 1.88, z + 4, "grug:coverage_render")
    level.place_block(x + 1, y - 1.88, z + 4, "grug:coverage_render")

    # A wall behind it, so the shape is compared against one flat colour rather than against the
    # world. The world is not a stable background to diff against: Alpha's clouds drift with the
    # clock and its leaves shimmer, and its block textures round differently between two runs of the
    # same build, which is why the wall is grug:coverage_flat and why its texture is a single
    # colour.
    # Built far larger than the crop and centred on it, for the same reason the autocrafting table
    # test insets its crop: a silhouette edge is where two nearly-equal shades round differently
    # between runs. Every edge of this wall falls outside the rectangle below, so what is compared
    # is the middle of a flat face.
    _wall(level, x - 6, y - 9, z + 6)

    be_opt: Option[BlockEntity] = level.get_block_entity(x, y - 1.88, z + 4)
    Test.assert(be_opt.has(), "The custom-rendered block should have a block entity.")
    render_block.set(be_opt.unwrap())
}

# Thirteen blocks square of grug:coverage_flat at (x0, y0, z), which covers the crop with room to
# spare. Kept small on purpose: every block placed re-lights the columns around it for several ticks
# afterwards, so a capture taken before that settles lands on a wall one brightness step away from
# the reference. The level is passed in rather than reached for: grug only allows variable
# declarations at member scope, so a local in _setup is not something this can see.
local _wall(level: Level, x0: number, y0: number, z: number) {
    wy: number = y0
    while wy < y0 + 13 {
        wx: number = x0
        while wx < x0 + 13 {
            level.place_block(wx, wy, z, "grug:coverage_flat")
            wx = wx + 1
        }
        wy = wy + 1
    }
}

local _check() {
    # The block entity is what the hook drew through, so a missing one would make the screenshot
    # below a picture of nothing that happens to match an empty reference. Asserting it here turns
    # that into a readable failure. It is a member variable because it is created on tick 0 and read
    # back here; grug only allows declarations at member scope.
    # Nothing here can prove the arms were drawn: a shape that lost every arm is still a picture
    # that matches a reference, and only a human comparing the two PNGs can see the difference.
    # That is what the reference in this directory is for.
    Test.assert(render_block.has(), "The custom-rendered block lost its block entity.")

    # The rendered shape against the flat background: a run of three, each with arms reaching to
    # its neighbours and none on the outer ends.
    # Pixel-exact, and it has to stay that way: a tolerance would accept a shape that had lost an
    # arm, which is the one thing this test exists to catch.
    # The reference directory holds three PNGs, and the geometry is pixel-identical in all three:
    # the set of non-grey pixels is the same set, not merely the same count. They differ only in
    # the grey background, and only by one step per channel. Alpha shades a block face from the
    # light at each neighbouring position, which quantises into one-step bands, and where a band
    # boundary falls across the wall depends on the machine and on how long that wall has been
    # settling, which in turn depends on what ran before this test. Measured across the three pairs:
    # 1602, 3196 and 1594 differing pixels, every one of them neutral grey in both images and one
    # step out on all three channels. That is the case a numbered reference directory exists for.
    # The top of the rectangle is the one place that needed care first: the wall's top corner is a
    # step darker than the rest of its face, and which pixels land on that step shifted by one
    # between runs of the same build. The rectangle therefore starts below the wall's top corner,
    # the same reason the autocrafting table test insets past the soft edge of its panel.
    Test.screenshot().equals(r"screenshots/coverage_render", 450, 198, 850, 319)
}
