# Covers the block-entity rendering hook: a block that declares set_custom_render draws its own
# geometry instead of its cube, and the shape it draws is what lands on screen. The screenshot is
# the assertion. It deliberately is not a pixel comparison against the cube the hook replaced:
# freezing that here would make the test pass for the placeholder it exists to remove. It compares
# the real geometry, so a change to the shape, the texture or the lighting shows up as a diff
# rather than passing quietly.
# The crop is a world-space rectangle at 1280x720, unlike the autocrafting table GUI test: nothing
# here is a GUI panel, so there is no virtual-space scaling to undo. Where the shape and its
# background end up is worked out from where the camera setup leaves them, in _setup.
render_block: Option[BlockEntity] = Option.new()

# Whether the fixture has been meshed again from the settled light yet. See _force_remesh.
remeshed: bool = false

# How many runner ticks have passed since the swap. See the wait in run().
remesh_ticks: number = 0

# How many runner ticks in a row the world has answered settled. See the hold in run().
settled_ticks: number = 0

export run(ctx: TestRunContext) {
    if ctx.tick() == 0 {
        _setup(ctx)
        ctx.not_done()
    } else if not Test.world_settled() {
        # The mesh below has to read the settled light, so the wait comes first: the loader reports
        # false until its light engine and its mesh rebuilds are done, and a world that never settles
        # runs into the test's own budget rather than capturing something that moved. Asking from the
        # first tick is also what exercises the answer's client-side "not yet" outcomes, which are
        # gone by the time a fixed floor would have expired.
        settled_ticks = 0
        ctx.not_done()
    } else if settled_ticks < 5 {
        # One settled answer is not enough to swap on. A light packet already in flight can land a
        # tick later, and a light update re-meshes only the section it changed, not the neighbours
        # whose faces sample it, so a mesh made just before it would keep the older light in a wedge
        # forever. Five answers in a row is well past the tick an in-flight update takes to arrive.
        # See #259.
        settled_ticks = settled_ticks + 1
        ctx.not_done()
    } else if not remeshed {
        _force_remesh(ctx)
        remeshed = true
        ctx.not_done()
    } else if remesh_ticks < 5 {
        # The loaders that mesh synchronously answer settled immediately, so their capture could
        # otherwise be taken before the swap's mesh has been rendered, and the frame it reads would
        # be the one from before the swap. Five runner ticks is past the frame or two those loaders
        # take, and costs nothing on 1.20.6, where the wait below is the real one. See #259.
        remesh_ticks = remesh_ticks + 1
        ctx.not_done()
    } else if not Test.world_settled() {
        # Waiting for the mesh the swap scheduled. A rebuild bakes a face's per-vertex light, and a
        # rebuild that ran while the light was still propagating keeps that mid-propagation light
        # until something dirties the section again: a light update only re-meshes the section it
        # changed, not the neighbours whose faces sample it, so the stale bake would never be
        # corrected on its own. The swap is what corrects it, and this is the wait for the fresh mesh
        # to land. It is also the wait that replaces the old 60-tick floor: the answer is false until
        # the fixture's frame has been drawn, so the capture no longer races a slower runner. See
        # #257.
        ctx.not_done()
    } else {
        _check(ctx)
    }
}

local _setup(ctx: TestRunContext) {
    level: Level = Test.get_client_level()

    # The runner builds a sealed, torch-lit room around the player before every test, so the
    # capture's light does not come from the sky: its brightness moves with the time of day, which
    # the suite reaches at a different tick on every run, and the canopy above the fixture shades it
    # unevenly, so the wall's one-step light bands landed in different places from run to run. Ten
    # 1.20.6 re-runs produced nine captures in eight states, and a 1.2.5 band alternated between two
    # positions. The default room is small; this fixture reaches further than it, so ask for a room
    # that holds the shape, the wall two blocks behind it, and both ends of that wall. Asked for
    # before the fixture goes in, so the room's clearing cannot take the fixture out again. See
    # #253.
    Test.set_box_radius(6)

    origin: Vec3 = Test.setup_graphics_camera()
    x: number = origin.x()
    y: number = origin.y()
    z: number = origin.z()

    # The camera setup snaps the player to the centre of their block and levels the view.
    # setup_graphics_camera returns the render camera's position plus 3, so y - 1.88 puts the run
    # just above the camera, which is where the crop below expects it. yaw 0 looks towards +z, so +4
    # is in front of them rather than inside them.
    # A straight run along x, so the middle block draws arms on two opposite sides and none
    # elsewhere. Three rather than one, because a lone block draws only its core: a cube inset from
    # the faces, which says nothing about the arms the hook exists for. The outer two prove the arms
    # are read from the neighbours, since neither draws one on its outer end.
    level.place_block(x - 1, y - 1.88, z + 4, "grug:coverage_render")
    level.place_block(x, y - 1.88, z + 4, "grug:coverage_render")
    level.place_block(x + 1, y - 1.88, z + 4, "grug:coverage_render")

    # A stone wall behind it, so the shape is compared against the wall's own settled light. Built
    # larger than the crop and centred on it, for the same reason the autocrafting table test insets
    # its crop: a silhouette edge is where two nearly-equal shades round differently between runs.
    # See #262 and #264.
    _wall(level, x - 6, y - 9, z + 6)

    be_opt: Option[BlockEntity] = level.get_block_entity(x, y - 1.88, z + 4)
    ctx.assert(be_opt.has(), "The custom-rendered block should have a block entity.")
    render_block.set(be_opt.unwrap())
}

# Thirteen blocks square of minecraft:stone at (x0, y0, z), which covers the crop with room to
# spare. Kept small on purpose: every block placed re-lights the columns around it for several ticks
# afterwards, so a capture taken before that settles lands on a wall one brightness step away from
# the reference. The level is passed in rather than reached for: grug only allows variable
# declarations at member scope, so a local in _setup is not something this can see.
local _wall(level: Level, x0: number, y0: number, z: number) {
    wy: number = y0
    while wy < y0 + 13 {
        wx: number = x0
        while wx < x0 + 13 {
            level.place_block(wx, wy, z, "minecraft:stone")
            wx = wx + 1
        }
        wy = wy + 1
    }
}

local _check(ctx: TestRunContext) {
    # The block entity is what the hook drew through, so a missing one would make the screenshot
    # below a picture of nothing that happens to match an empty reference. Asserting it here turns
    # that into a readable failure. It is a member variable because it is created on tick 0 and read
    # back here; grug only allows declarations at member scope.
    # Nothing here can prove the arms were drawn: a shape that lost every arm is still a picture
    # that matches a reference, and only a human comparing the two PNGs can see the difference.
    # That is what the reference in this directory is for.
    ctx.assert(render_block.has(), "The custom-rendered block lost its block entity.")

    # The rendered shape against the stone wall: a run of three, each with arms reaching to
    # its neighbours and none on the outer ends.
    # Pixel-exact, and it has to stay that way: a tolerance would accept a shape that had lost an
    # arm, which is the one thing this test exists to catch.
    # The reference directory holds one PNG per loader: the shape's own pixels are the same set on
    # every loader, and the stone background differs per version because each shades a face from its
    # own light table. 1.20.6 used to land on a second state now and then (#262, #264); that stopped
    # after #301, #304 and #315, so one reference per loader is enough.
    Test.screenshot().equals(r"screenshots/coverage_render", 450, 198, 850, 319)
}

# Meshes the crop's section again from the settled light by changing a block state and putting it
# back. The swapped block is outside the crop, and dirt and stone are both opaque and unlit, so the
# swap changes no light and no compared pixel; what it does is dirty the wall's sections and their
# neighbours, which is what makes the mesh read the light the wait above settled. Without it the
# capture is a coin toss between the settled bake and one made while the light was still propagating,
# and both are byte-identical when they happen. See #259.
local _force_remesh(ctx: TestRunContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y()
    z: number = origin.z()
    level.place_block(x - 6, y + 3, z + 6, "minecraft:dirt")
    level.place_block(x - 6, y + 3, z + 6, "minecraft:stone")
    ctx.assert(level.get_block(x - 6, y + 3, z + 6) == "minecraft:stone", "The remesh swap should have put the wall block back.")
}
