# Test.tick_block_entity runs a whole number of ticks, so a fraction must report an error rather than
# be rounded: a test asking for 2.5 ticks has a bug that rounding would hide.
export run() {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_block")
    block_opt: Option[BlockEntity] = level.get_block_entity(x, y, z)
    Test.assert(block_opt.has(), "coverage_block should have a block entity.")
    block: BlockEntity = block_opt.unwrap()

    me.expect_error("whole number from 0 to")
    Test.tick_block_entity(block, 2.5)
}
