# A capture must never read the integrated server's "Saving world" text, which 1.20.6 draws in the
# bottom right of the frame for about ten client ticks after a save. A test cannot wait the game's
# own autosave out: its tick is the timer's, and the timer's worst gap is longer than a loader job
# may take, so a test that captured for long enough would not finish. Instead the runner saves the
# world once at tick 100 of a test whose file name starts with `forced_autosave_`
# (GrugForcedAutosave), the same way the autosave does, and says a [GRUG CI] line when it does, so
# the captures around that tick always read the fade. Without a wait in the capture path the
# captures that read a frame drawn during the fade differ from the golden and the test fails. See
# #1132. The scene, the rectangle and the golden are coverage_flat_hand's, so the frame is the one
# that test already accepts on every loader and only the timing differs. The captures start once
# that scene's hand has finished rising, which is also what makes the first one match the golden.
# Only 1.20.6 draws the text, so the other four loaders set the scene up and stop: a capture there
# cannot fail, and repeating the golden for them would only cost run time.
settled_ticks: number = 0
ready: bool = false
# Counts down to the next capture, so one lands every five ticks. grug has no remainder operator.
until_capture: number = 0

export init(ctx: TestInitContext) {
    # The save is at tick 100 and its fade is over ten client ticks later, so 160 leaves the last
    # capture well past it.
    ctx.set_max_ticks(200)
}

export tick(ctx: TestTickContext) {
    if ctx.current_tick() == 0 {
        _setup()
        ctx.not_done()
        return
    }

    if Test.loader_name() != "1.20.6-forge" {
        Test.clear_held_item(Test.get_player())
        return
    }

    if not ready {
        # The hand's rise takes about 10 ticks, so 40 leaves it long finished.
        if ctx.current_tick() < 40 {
            ctx.not_done()
            return
        }
        if not Test.world_settled() {
            settled_ticks = 0
            ctx.not_done()
            return
        }
        if settled_ticks < 5 {
            settled_ticks = settled_ticks + 1
            ctx.not_done()
            return
        }
        ready = true
    }

    # The forced save's fade is over by about tick 110, and the last capture is at 145, so the window
    # ends after it and long before the game's own autosave could add a second save.
    if ctx.current_tick() >= 150 {
        Test.clear_held_item(Test.get_player())
        return
    }

    if until_capture == 0 {
        Test.screenshot().equals(r"screenshots/coverage_flat_hand", 940, 550, 1140, 720)
        until_capture = 5
    } else {
        until_capture = until_capture - 1
    }
    ctx.not_done()
}

local _setup() {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()

    wy: number = origin.y() - 9
    while wy < origin.y() + 8 {
        wx: number = origin.x() - 8
        while wx < origin.x() + 9 {
            level.place_block(wx, wy, origin.z() + 10, "minecraft:stone")
            wx = wx + 1
        }
        wy = wy + 1
    }

    Test.set_held_item(Test.get_player(), item(resource_location("grug:coverage_flat_hand")))
}
