# set_time takes whole ticks, so a fractional time is reported rather than rounded to a time the
# caller did not ask for.
export tick(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()

    ctx.expect_error("set_time: The time has to be a whole number of ticks from 0 to")
    level.set_time(6000.5)
}
