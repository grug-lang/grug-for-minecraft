# OverlayRenderContext.text_width answers the width the game's own font draws a text at, and a mod
# screen's own close through Screen.close takes the host away. The overlay's screen_render measures
# its title and the empty text every frame, and the screen closes from screen_key only when the
# title measured wider than 0 and the empty text measured 0, so a text_width that answered nothing
# leaves the screen open and fails the test. The close is also the one path a mod's own Escape runs,
# so it proves that closing a screen takes its host away.
# The screen host exists only on 1.20.6 so far, and the test ends early on the dedicated server,
# whose joined client owns the screen.
started: bool = false
step: number = 0
waited: number = 0

export tick(ctx: TestTickContext) {
    if not started {
        started = true
        if me.loader_name() != "1.20.6-forge" or me.on_dedicated_server() {
            return
        }
        ctx.not_done()
        return
    }

    if step == 0 {
        if not ctx.world_settled() {
            waited = waited + 1
            ctx.assert(waited < 1000, "The world should settle before the screen opens.")
            ctx.not_done()
            return
        }
        waited = 0
        if ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "No screen should be open before the test opens its own.")
            ctx.not_done()
            return
        }
        # Z makes the overlay close its screen from screen_key.
        ctx.press_world_key(90, false)
        step = 1
        waited = 0
        ctx.not_done()
        return
    }

    if step == 1 {
        # H is the overlay's open key.
        ctx.press_world_key(72, false)
        step = 2
        waited = 0
        ctx.not_done()
        return
    }

    if step == 2 {
        if not ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "H should open the coverage screen.")
            ctx.not_done()
            return
        }
        # The frame barrier: the frame that draws the screen is the one whose screen_render measured
        # the two texts, and Escape is pressed only after it.
        if not ctx.overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "The screen should draw a frame before Escape.")
            ctx.not_done()
            return
        }
        took: bool = ctx.press_screen_key(256, false, false, true)
        ctx.assert(took, "Escape should reach screen_key.")
        step = 3
        waited = 0
        ctx.not_done()
        return
    }

    if ctx.screen_open() {
        waited = waited + 1
        ctx.assert(waited < 200, "The screen should close from its own screen_key, so text_width answered the font's widths.")
    }
}
