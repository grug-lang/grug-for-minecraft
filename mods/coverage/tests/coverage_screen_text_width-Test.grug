# OverlayRenderContext.text_width answers the width the game's own font draws a text at. The
# overlay's screen_render measures its title and the empty text every frame and writes the pair to
# the mod's own file whenever it changes, so the test reads what the font answered instead of
# asking the screen to close: an empty text has to measure nothing and the title has to measure
# something.
# A loader without a screen host answers an err to Screen.open, so the test returns early there.
# It ends early on the dedicated server too, whose joined client owns the screen.
started: bool = false
step: number = 0
waited: number = 0

export tick(ctx: TestTickContext) {
    if not started {
        started = true
        if not me.owned_screens_supported() or not me.world_overlay_supported() or me.on_dedicated_server() {
            return
        }
        files: File = File.open(r"files")
        # The writable directory outlives a run, so the marker starts empty and a later run of the
        # suite cannot read what this test wrote before.
        files.write_text("screen_text/widths.txt", "")
        ctx.not_done()
        return
    }

    if step == 0 {
        if not ctx.world_settled() {
            waited = waited + 1
            ctx.assert(waited < 1000, "The world should settle before the screen opens.")
            ctx.not_done()
            return
        }
        waited = 0
        if ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "No screen should be open before the test opens its own.")
            ctx.not_done()
            return
        }
        # C puts the list back in its ordinary answering mode, which this screen shares with the
        # tests that run after this one.
        ctx.press_world_key(67, false)
        step = 1
        waited = 0
        ctx.not_done()
        return
    }

    if step == 1 {
        # H is the overlay's open key.
        ctx.press_world_key(72, false)
        step = 2
        waited = 0
        ctx.not_done()
        return
    }

    if step == 2 {
        if not ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "H should open the coverage screen.")
            ctx.not_done()
            return
        }
        if not ctx.overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "The screen should draw a frame, whose screen_render measures the texts.")
            ctx.not_done()
            return
        }
        files: File = File.open(r"files")
        widths: string = files.read_text("screen_text/widths.txt").unwrap()
        sep: number = String.index_of(widths, ":")
        ctx.assert(sep > 0, "The frame should have written the title width, a colon and the empty width.")
        title: number = String.to_number(String.substring(widths, 0, sep)).unwrap()
        empty: number = String.to_number(String.substring(widths, sep + 1, String.length(widths))).unwrap()
        ctx.assert(title > 0, "The title should measure wider than nothing.")
        ctx.assert(empty == 0, "The empty text should measure 0.")
        ctx.close_screen()
        step = 3
        waited = 0
        ctx.not_done()
        return
    }

    ctx.assert(not ctx.screen_open(), "The test's own close should leave no screen open.")
}
