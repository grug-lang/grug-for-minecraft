# OverlayRenderContext.text_width answers the width the game's own font draws a text at, and a mod
# screen's own close through Screen.close takes the host away. The overlay's screen_render measures
# its title and the empty text every frame. Once the screen is up, Z asks its screen_key to arm the
# close, and Escape then closes it only when the title measured wider than 0 and the empty text
# measured 0, so a text_width that answered nothing leaves the screen open and fails the test. The
# close is also the one path a mod's own Escape runs, so it proves that closing a screen takes its
# host away.
# A loader without a screen host answers an err to Screen.open, so the test returns early there.
# It ends early on the dedicated server too, whose joined client owns the screen.
started: bool = false
step: number = 0
waited: number = 0

export tick(ctx: TestTickContext) {
    if not started {
        started = true
        if not me.owned_screens_supported() or not me.world_overlay_supported() or me.on_dedicated_server() {
            return
        }
        ctx.not_done()
        return
    }

    if step == 0 {
        if not ctx.world_settled() {
            waited = waited + 1
            ctx.assert(waited < 1000, "The world should settle before the screen opens.")
            ctx.not_done()
            return
        }
        waited = 0
        if ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "No screen should be open before the test opens its own.")
            ctx.not_done()
            return
        }
        # C puts the list back in its ordinary answering mode, which this screen shares with the
        # tests that run after this one.
        ctx.press_world_key(67, false)
        step = 1
        waited = 0
        ctx.not_done()
        return
    }

    if step == 1 {
        # H is the overlay's open key.
        ctx.press_world_key(72, false)
        step = 2
        waited = 0
        ctx.not_done()
        return
    }

    if step == 2 {
        if not ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "H should open the coverage screen.")
            ctx.not_done()
            return
        }
        # The frame barrier: the frame that draws the screen is the one whose screen_render measured
        # the two texts, and the arming key is pressed only after it.
        if not ctx.overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "The screen should draw a frame before it is asked to close.")
            ctx.not_done()
            return
        }
        took: bool = ctx.press_screen_key(90, false, false, true)
        ctx.assert(took, "Z should reach screen_key, which arms the close.")
        step = 3
        waited = 0
        ctx.not_done()
        return
    }

    if step == 3 {
        took: bool = ctx.press_screen_key(256, false, false, true)
        ctx.assert(took, "Escape should reach screen_key.")
        step = 4
        waited = 0
        ctx.not_done()
        return
    }

    if ctx.screen_open() {
        waited = waited + 1
        ctx.assert(waited < 200, "The screen should close from its own screen_key, so text_width answered the font's widths.")
    }
}
