# A get_liquid_amount export that answers a liquid name where the host asked for an amount is an
# err, because the host would otherwise read an amount the export never answered.
export tick(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    origin: Vec3 = ctx.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_response_block")
    be: BlockEntity = level.get_block_entity(x, y, z).unwrap()
    be.set_saved_number("amount_mode", 1)

    ctx.expect_error("wrong kind of answer")
    amount: number = be.get_liquid_amount()
}
