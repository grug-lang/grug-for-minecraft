# A number a script saves on a block entity reaches the frame pass that reads it, on either side.
# The frame pass reads the client's copy of the block entity, while a test's set_saved_number writes
# the copy the game simulates, so on a dedicated server the number only arrives if the loader sends
# it. Every loader does: with the game's block entity update packet where it has one, and with a
# packet of grug's own on the versions that have none (#1093). The coverage_frame block draws a row
# of three extra stacks at each of three heights once its "marker" number is above 0, plus a second
# row a third of a block higher that only the number draws, and the assertion is that the frame
# changed. The middle row is inside every camera's crop, and the low and high rows catch the crops
# that sit a little higher or lower, so no loader sees none of them.
# Two captures of one session are compared, rather than one against a reference image, so this holds
# the same on every loader and needs no golden: a frame that never saw the number looks like the
# frame before it and fails. Nine stacks a quarter block across are drawn and nothing else in the
# crop moves, so the ask is 1 percent of the crop, above the block-light flicker between two
# captures of an unchanged frame (about 0.3 percent), which alone cannot pass the wait.
# Setting the number again to the value it holds changes nothing the client needs, so that is no
# new send; the loader skips it, and the test reaches that path by saving the same value again.
# It defines tick_any_side, so a dedicated server runs it too: the settle wait is forwarded to the
# joined client, and the captures are the client's (#1086). The wait ends on the frame itself:
# Screenshot.change_from reports how much of it changed, so a client that is behind is captured
# again instead of being assumed to have caught up after a tick count.
frame_block: Option[BlockEntity] = Option.new()
before: Option[Screenshot] = Option.new()
saved: bool = false

# The runner tick the number was saved on.
saved_tick: number = 0

# How many captures have already shown the frame from before the number was saved.
attempts: number = 0

export init(ctx: TestInitContext) {
    # Eight captures 30 ticks apart, beside the setup, pass the default 200.
    ctx.set_max_ticks(400)
}

export tick_any_side(ctx: TestTickContext) {
    if ctx.current_tick() == 0 {
        _setup(ctx)
        ctx.not_done()
    } else if not Test.world_settled() {
        ctx.not_done()
    } else if not saved {
        before.set(Test.screenshot().capture(500, 60, 780, 440))
        frame_block.unwrap().set_saved_number("marker", 1)
        saved = true
        saved_tick = ctx.current_tick()
        attempts = 0
        ctx.not_done()
    } else if ctx.current_tick() < saved_tick + 30 {
        # Nothing marks the world unsettled for a saved-number change: a script saves numbers as it
        # runs, so a world that settled only between those would never settle. This short wait keeps
        # the captures from spinning; whether the change arrived is decided by the capture below.
        ctx.not_done()
    } else {
        after: Screenshot = Test.screenshot().capture(500, 60, 780, 440)
        if after.change_from(before.unwrap()) < 1 {
            attempts = attempts + 1
            ctx.assert(attempts < 8, "The saved number never reached the client's frame.")
            saved_tick = ctx.current_tick()
            ctx.not_done()
        } else {
            frame_block.unwrap().set_saved_number("marker", 1)
            ctx.assert(frame_block.unwrap().get_saved_number("marker") == 1, "The number should still be saved.")
        }
    }
}

local _setup(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    Test.set_box_radius(6)
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y()
    z: number = origin.z()

    # The same place coverage_frame's run sits. The crop is taller than that test's golden's and
    # keeps a margin on every side of the block: a dedicated server builds the room from its own
    # copy of the player, which can sit a block off the joined client's, and the block then sits a
    # block off where the golden has it in that client's frame.
    level.place_block(x, y - 1.88, z + 4, "grug:coverage_frame")

    # A wall behind it, thirteen across and thirteen high, the size coverage_frame's golden uses,
    # which covers the whole crop. Without one the crop could hold sky, and clouds drift between two
    # captures; it is larger than the block because the crop keeps a margin around the block for a
    # dedicated server, whose room is built from its own copy of the player and can sit a block off
    # the joined client's.
    wy: number = y - 9
    while wy < y + 4 {
        wx: number = x - 6
        while wx < x + 7 {
            level.place_block(wx, wy, z + 6, "minecraft:stone")
            wx = wx + 1
        }
        wy = wy + 1
    }

    be_opt: Option[BlockEntity] = level.get_block_entity(x, y - 1.88, z + 4)
    ctx.assert(be_opt.has(), "The frame-rendered block should have a block entity.")
    frame_block.set(be_opt.unwrap())
}
