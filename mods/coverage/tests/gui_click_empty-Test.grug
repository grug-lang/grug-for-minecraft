# A container click that changes nothing, forwarded to a joined client (#1094): the cursor is empty
# and the slot it presses is empty, so the click packet moves nothing and the container answers no
# slot update. The test still returns with not_done and asserts on the next tick, which is what says
# the call does not wait for the click to change the container: a wait on a slot revision would pass
# only when something moved, and a click that changes nothing would hang. The servers that can open
# no container for their player list this test as unsupported until #1098 gives them one, so it runs
# on 1.20.6 and 1.2.5.
started: bool = false
clicked: bool = false

export tick_any_side(ctx: TestTickContext) {
    if not started {
        started = true
        Test.close_screen()
        # Cleared before the screen opens, so the client's queued half of the clear has landed on
        # the server by the tick that presses.
        Test.clear_carried_item()
        level: Level = Test.get_client_level()
        origin: Vec3 = Test.get_origin()
        level.place_block(origin.x(), origin.y(), origin.z(), "grug:coverage_block")
        Test.use_block(level, origin.x(), origin.y(), origin.z())
        ctx.not_done()
        return
    }
    if not clicked {
        if not Test.screen_open() {
            ctx.not_done()
            return
        }
        clicked = true
        ctx.assert(not Test.get_carried_item().has(), "The cursor should be empty for a click that changes nothing.")
        left: number = Test.gui_left()
        top: number = Test.gui_top()
        ctx.assert(not Test.click_screen(left + 38, top + 25, 0), "A press no overlay took should answer false.")
        ctx.not_done()
        return
    }
    # Nothing changed, and the next tick still came: the click was applied and answered no update
    # rather than the test waiting for one.
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    block_entity: BlockEntity = level.get_block_entity(origin.x(), origin.y(), origin.z()).unwrap()
    ctx.assert(block_entity.get_item_count_in_slot(0) == 0, "A click with an empty cursor should leave the slot empty.")
    ctx.assert(not Test.get_carried_item().has(), "A click with an empty cursor should leave the cursor empty.")
    Test.close_screen()
}
