# A container click with an empty cursor, forwarded to a joined client (#1094). On 1.20.6 a press
# whose cursor carries a stack only starts a drag and leaves the packet to the release, so the press
# path, the one an empty cursor takes, is gui_click_empty's to prove while gui_click proves the
# release path. The first click here changes nothing, which is what says the call does not wait for
# the container to change; the second clicks a grid slot that holds a diamond, so the assertions
# after it fail unless the press's own packet was applied and the item moved. The server that can
# open no container for its player, a1.1.2_01's, lists this test as unsupported until #1098 gives
# that one a server-side container too, so it runs on the other four.
started: bool = false
clicked: bool = false
picked: bool = false
moved: bool = false

export tick_any_side(ctx: TestTickContext) {
    if not started {
        started = true
        Test.close_screen()
        # Cleared before the screen opens, so the client's queued half of the clear has landed on
        # the server by the tick that presses.
        Test.clear_carried_item()
        level: Level = Test.get_client_level()
        origin: Vec3 = Test.get_origin()
        level.place_block(origin.x(), origin.y(), origin.z(), "grug:coverage_block")
        Test.use_block(level, origin.x(), origin.y(), origin.z())
        ctx.not_done()
        return
    }
    if not clicked {
        if not Test.screen_open() {
            ctx.not_done()
            return
        }
        clicked = true
        ctx.assert(not Test.get_carried_item().has(), "The cursor should be empty for a click that changes nothing.")
        left: number = Test.gui_left()
        top: number = Test.gui_top()
        ctx.assert(not Test.click_screen(left + 38, top + 25, 0), "A press no overlay took should answer false.")
        ctx.not_done()
        return
    }
    if not picked {
        picked = true
        # Nothing changed, and the next tick still came: the call does not wait for the container to
        # change. The diamond is put in the grid only now, so nothing the first click did can be
        # what moves it.
        level: Level = Test.get_client_level()
        origin: Vec3 = Test.get_origin()
        block_entity: BlockEntity = level.get_block_entity(origin.x(), origin.y(), origin.z()).unwrap()
        ctx.assert(block_entity.get_item_count_in_slot(0) == 0, "A click with an empty cursor should leave an empty slot empty.")
        ctx.assert(not Test.get_carried_item().has(), "A click with an empty cursor should leave the cursor empty.")
        block_entity.set_item_in_slot(0, item(resource_location("minecraft:diamond")), 1)
        ctx.not_done()
        return
    }
    if not moved {
        moved = true
        # An empty cursor over a slot that holds a stack picks the stack up, and on 1.20.6 this
        # press is the one that sends the click packet.
        left: number = Test.gui_left()
        top: number = Test.gui_top()
        ctx.assert(not Test.click_screen(left + 38, top + 25, 0), "A press no overlay took should answer false.")
        ctx.not_done()
        return
    }
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    block_entity: BlockEntity = level.get_block_entity(origin.x(), origin.y(), origin.z()).unwrap()
    ctx.assert(block_entity.get_item_count_in_slot(0) == 0, "The click should have taken the diamond out of the grid's first slot.")
    in_hand: Option[Item] = Test.get_carried_item()
    ctx.assert(in_hand.has(), "The click should have put the grid's diamond on the cursor.")
    if in_hand.has() {
        ctx.assert(equals(in_hand.unwrap(), item(resource_location("minecraft:diamond"))), "The cursor should hold the diamond the grid had.")
    }
    Test.close_screen()
}
