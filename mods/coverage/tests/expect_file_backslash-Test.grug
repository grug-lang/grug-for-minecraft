# A path is a portable file name (#1757): a backslash joins segments on Windows and is a file name
# character here, so it is refused everywhere and a mod's path means the same on every loader.
export tick(ctx: TestTickContext) {
    files: File = File.open(r"files")
    ctx.expect_error("not a portable file name")
    files.read_text("back\\slash.txt")
}
