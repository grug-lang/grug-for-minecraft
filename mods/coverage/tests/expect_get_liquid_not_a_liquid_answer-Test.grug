# A get_liquid export that answers a name which is no liquid is an err, because the host would
# otherwise carry a liquid the game does not have.
export tick(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    origin: Vec3 = ctx.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_response_block")
    be: BlockEntity = level.get_block_entity(x, y, z).unwrap()
    be.set_saved_number("liquid_mode", 12)

    ctx.expect_error("a liquid name")
    held: Option[string] = be.get_liquid()
}
