# A room larger than the chunks the client holds must still settle. The 1.20.6 client keeps its own
# copy of the light and the room build owes it the light of every section the room covers, so a
# section the client is never sent used to keep the world unsettled until the test's budget ran out.
# The radius is wider, on at least one side, than the two-chunk render distance the run sets,
# wherever the player stands in its chunk. The test puts the default room back and waits for that
# to settle too, so the light work of the wide room is not left to the next test. See #948.
shrunk: bool = false

export init(ctx: TestInitContext) {
    ctx.set_max_ticks(1600)
}

export tick(ctx: TestTickContext) {
    if ctx.current_tick() == 0 {
        Test.set_box_radius(38)
        ctx.not_done()
    } else if not Test.world_settled() {
        ctx.assert(ctx.current_tick() < 1500, "A room wider than the client's chunks must not keep the world unsettled.")
        ctx.not_done()
    } else if not shrunk {
        shrunk = true
        Test.set_box_radius(3)
        ctx.not_done()
    }
}
