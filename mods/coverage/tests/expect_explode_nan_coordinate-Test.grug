# explode must report a coordinate that is NaN, rather than hand the game an explosion nowhere.
# Squaring 10000000000.0 five times overflows a double to infinity, and infinity minus infinity is NaN.
export tick(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()

    infinity: number = 10000000000.0
    infinity = infinity * infinity
    infinity = infinity * infinity
    infinity = infinity * infinity
    infinity = infinity * infinity
    infinity = infinity * infinity
    nan: number = infinity - infinity

    ctx.expect_error("explode: x must be finite")
    level.explode(nan, origin.y() + 20, origin.z(), 1)
}
