# An ExtractResponse kept past the call it was passed to is stale, and using it is an err.
export run(ctx: TestRunContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_response_block")
    be: BlockEntity = level.get_block_entity(x, y, z).unwrap()
    diamond: Item = item(resource_location("minecraft:diamond"))
    be.set_saved_number("extract_mode", 6)
    be.ask_extract_item(0)
    # Some loaders notify the neighbours when a block is placed and some do not, so the error is
    # expected before the placing and the explicit notify below covers the loaders that stay quiet.
    ctx.expect_error("only valid during")
    level.place_block(x + 1, y, z, "minecraft:stone")
    Test.notify_neighbors(level, x + 1, y, z)
}
