# Opening a screen with open() while a stack is up replaces the whole stack, the way the reference's
# showScreen replaces the one screen it shows: the screen that was on top is ended without hearing
# screen_closed, and the screen being opened is the only one left. The overlay records every init in
# `screen_stack/init.txt` and every close it heard in `screen_stack/closed.txt`, so the init that
# follows the open proves the stack was rebuilt and the empty close file proves the ended screens
# heard nothing (#1752).
# The proof that the stack was replaced and not grown is the open_over after it: the replacement
# dropped `other` from the stack, so opening it over the first screen is legal again, and a stack
# that still held it would refuse this open and leave the first screen's frame up.
# A loader without a screen host answers an err to Screen.open, so the test returns early there, and
# it ends early on the dedicated server, whose joined client owns the screen.
started: bool = false
step: number = 0
waited: number = 0

export init(ctx: TestInitContext) {
    ctx.set_max_ticks(2000)
}

export tick(ctx: TestTickContext) {
    if not started {
        started = true
        if not me.owned_screens_supported() or not me.world_overlay_supported() or me.on_dedicated_server() {
            return
        }
        ctx.not_done()
        return
    }

    if step == 0 {
        if not ctx.world_settled() {
            waited = waited + 1
            ctx.assert(waited < 1000, "The world should settle before the screen opens.")
            ctx.not_done()
            return
        }
        waited = 0
        if ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "No screen should be open before the test opens its own.")
            ctx.not_done()
            return
        }
        # Z clears the stack markers and the counters, so the files this test reads are its own.
        ctx.press_world_key(90, false)
        # H is the overlay's open key.
        ctx.press_world_key(72, false)
        step = 1
        waited = 0
        ctx.not_done()
        return
    }

    if step == 1 {
        if not ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "H should open the coverage screen.")
            ctx.not_done()
            return
        }
        files: File = File.open(r"files")
        if files.read_text("screen_stack/frame.txt").unwrap() != "screen" or not ctx.overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "The first screen should draw a frame before the second opens.")
            ctx.not_done()
            return
        }
        # B arms the open_over its next click asks for.
        took: bool = ctx.press_screen_key(66, false, false, true)
        ctx.assert(took, "B should reach screen_key, which arms the open_over.")
        step = 2
        waited = 0
        ctx.not_done()
        return
    }

    if step == 2 {
        # A point inside no widget of either screen, so this press only asks for the open_over.
        ctx.click_screen(200, 60, 0)
        step = 3
        waited = 0
        ctx.not_done()
        return
    }

    if step == 3 {
        files: File = File.open(r"files")
        if files.read_text("screen_stack/frame.txt").unwrap() != "other" or not ctx.overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "The screen opened over the first should draw a frame of its own.")
            ctx.not_done()
            return
        }
        # M arms the open() of the first screen over the stack its next click asks for.
        took: bool = ctx.press_screen_key(77, false, false, true)
        ctx.assert(took, "M should reach screen_key, which arms the open over the stack.")
        step = 4
        waited = 0
        ctx.not_done()
        return
    }

    if step == 4 {
        ctx.click_screen(200, 60, 0)
        step = 5
        waited = 0
        ctx.not_done()
        return
    }

    if step == 5 {
        files: File = File.open(r"files")
        if files.read_text("screen_stack/frame.txt").unwrap() != "screen" or not ctx.overlay_drawn() {
            waited = waited + 1
            ctx.assert(waited < 200, "The screen opened over the stack should draw a frame of its own.")
            ctx.not_done()
            return
        }
        # H opened the first screen, B opened `other` over it, and this open lays the first screen
        # out again, so its third init is the one the replace asked for.
        ctx.assert(files.read_text("screen_stack/init.txt").unwrap() == "3:screen", "open() over a stack should initialise the screen it opens as the only one left.")
        ctx.assert(files.read_text("screen_stack/closed.txt").unwrap() == "", "open() over a stack must ask no screen_closed, because the reference's showScreen ends the old screens silently.")
        # B opens `other` over the stack again, which is legal only because the replacement dropped
        # it: a stack that still held it would refuse this open.
        took: bool = ctx.press_screen_key(66, false, false, true)
        ctx.assert(took, "B should reach screen_key, which arms the open_over.")
        step = 6
        waited = 0
        ctx.not_done()
        return
    }

    if step == 6 {
        ctx.click_screen(200, 60, 0)
        step = 7
        waited = 0
        ctx.not_done()
        return
    }

    if step == 7 {
        files: File = File.open(r"files")
        if files.read_text("screen_stack/frame.txt").unwrap() != "other" {
            waited = waited + 1
            ctx.assert(waited < 200, "The second screen should open over the replaced stack, so the replacement dropped it.")
            ctx.not_done()
            return
        }
        ctx.assert(files.read_text("screen_stack/closed.txt").unwrap() == "", "Neither the replacement nor the open after it asked screen_closed.")
        ctx.press_screen_key(256, false, false, true)
        step = 8
        waited = 0
        ctx.not_done()
        return
    }

    ctx.assert(not ctx.screen_open(), "Escape should end the stack the test opened.")
}
