# Covers the click hook through the game's own press path: the overlay takes a press on the first
# hotbar slot, which holds the player's held item, so a press that also reached the vanilla slot
# would pick that item up onto the cursor. The overlay takes the press without changing anything,
# and the held item staying in place is what proves the hook cancelled the screen's handling too.
# The press is delivered through GuiScreen.handleInput on 1.2.5 and through the screen's own
# mouseClicked on the other loaders, never straight to the overlay host. See #863.
started: bool = false
opened: bool = false
waited: number = 0
step: number = 0

export tick_any_side(ctx: TestTickContext) {
    if not started {
        started = true
        if not Test.overlay_supported() {
            return
        }
        Test.close_screen()
        ctx.not_done()
        return
    }

    # A world frame has to be drawn before a screen that shows the player opens: the inventory
    # draws the player with the entity renderer, whose texture manager and camera the world's own
    # entity pass fills in, and a `-f mods=coverage` dispatch can run this test first, before any
    # frame has drawn (#1287). The runner puts the test that failed last first and then the
    # slowest, so any test of the mod can be that one. The test box's light is queued before the
    # test's own clock starts and the game runs ten ticks for one frame, so the first settle can
    # take a few hundred of the test's ticks; the failure bound is what says it never came.
    if not opened {
        waited = waited + 1
        ctx.assert(waited < 1000, "The world should settle before the inventory opens.")
        if not Test.world_settled() {
            ctx.not_done()
            return
        }
        Test.open_inventory(Test.get_player())
        opened = true
        waited = 0
        ctx.not_done()
        return
    }

    if not Test.screen_open() {
        waited = waited + 1
        ctx.assert(waited < 100, "The player's inventory screen should open.")
        ctx.not_done()
        return
    }

    if not Test.overlay_drawn() {
        waited = waited + 1
        ctx.assert(waited < 200, "A frame with the overlay should be drawn on the open screen.")
        ctx.not_done()
        return
    }

    if step == 0 {
        Test.clear_carried_item()
        Test.set_held_item(Test.get_player(), item_at(0))
        ctx.assert(Test.get_player().get_held_item().has(), "The player should hold the item the hotbar press uses.")
        step = 1
        ctx.not_done()
        return
    }

    # The overlay takes a press on the band it calls the first hotbar slot: as wide as the 18-pixel
    # slot around gui_left + 17, and from 6 to 24 pixels above the GUI's bottom edge. Read the same
    # geometry the overlay's context gets instead of assuming a window position, because the screen
    # the game opens for the player's inventory is not always the same one: 1.20.6 swaps in its
    # creative inventory on a creative world, and that panel is a different size and sits at a
    # different place than the survival one.
    hotbar_x: number = Test.gui_left() + 17
    hotbar_y: number = Test.gui_top() + Test.gui_height() - 15
    taken: bool = Test.click_screen(hotbar_x, hotbar_y, 0)
    ctx.assert(taken, "The overlay should take a press on the hotbar slot it covers.")
    ctx.assert(Test.get_player().get_held_item().has(), "A taken press should not also pick the hotbar item up.")
    ctx.assert(not Test.get_carried_item().has(), "A taken press should not put the hotbar item on the cursor.")
    Test.close_screen()
}
