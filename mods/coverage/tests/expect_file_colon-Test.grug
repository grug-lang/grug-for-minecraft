# A path is a portable file name (#1757): on Windows a colon names a drive and a stream, so it is
# refused everywhere and a mod's path means the same on every loader.
export tick(ctx: TestTickContext) {
    files: File = File.open(r"files")
    ctx.expect_error("not a portable file name")
    files.read_text("colon:name.txt")
}
