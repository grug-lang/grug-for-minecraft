# The room build sweeps the item entities out of its box, so a fixture's drops cannot be picked up
# and carried into a later capture. This spawns one inside the room and one in the last block the
# area clearing reaches, checks both exist, forces a rebuild through Test.set_box_radius, and checks
# the sweep took both. The second is the boundary: a block covers [x, x + 1), so an item resting in
# the last cleared block sits past the block's own coordinate, and a sweep whose bound stops at that
# coordinate leaves it behind. See #254.

# The sweep at the end of every test is not checked here: a test cannot observe the sweep that ends
# it, and the next test's room build sweeps too, so a following test could not tell the two apart.
# GrugTestRunnerTest covers it. See #323.
export tick(ctx: TestTickContext) {
    if ctx.current_tick() == 0 {
        level: Level = Test.get_client_level()
        origin: Vec3 = Test.get_origin()

        sword: Item = item(resource_location("minecraft:diamond_sword"))
        stack: ItemStack = item_stack(sword, 3, 1)
        entity: ItemEntity = item_entity(level, origin.x(), origin.y(), origin.z(), stack)
        entity.entity().set_delta_movement(Vec3.zero())
        entity.entity().spawn(level)

        # The area reaches 16 blocks around the player and the origin is the player's position plus
        # 3, so the player's block plus 16 is the last cleared one. Its block is asserted clear
        # first, so a smaller area fails here instead of leaving an item outside the swept box.
        px: number = Math.floor(origin.x() - 3)
        pz: number = Math.floor(origin.z() - 3)
        ctx.assert(level.is_air(px + 16, origin.y(), pz), "The test area should reach 16 blocks from the player.")
        # A block under it, so the item rests at a known height for the probe below instead of
        # falling to whatever the terrain there happens to be.
        level.place_block(px + 16, origin.y() - 1, pz, "minecraft:stone")
        edge_stack: ItemStack = item_stack(sword, 3, 1)
        edge: ItemEntity = item_entity(level, px + 16.5, origin.y(), pz + 0.5, edge_stack)
        edge.entity().set_delta_movement(Vec3.zero())
        edge.entity().spawn(level)
        # Without this the test ends here, since a tick() that returns without not_done() is over,
        # and the sweep below was never checked.
        ctx.not_done()
    } else if ctx.current_tick() == 1 {
        level: Level = Test.get_client_level()
        origin: Vec3 = Test.get_origin()
        # Both items have to exist before the rebuild, or the assertions after it pass without the
        # sweep having removed anything. The player picks up an item that has fallen into reach
        # after about six ticks, which is why the rebuild comes this early.
        before: Option[ItemEntity] = level.find_item_entity(origin.x(), origin.y(), origin.z(), 10)
        ctx.assert(before.has(), "The spawned item should exist before the room is rebuilt.")
        px: number = Math.floor(origin.x() - 3)
        pz: number = Math.floor(origin.z() - 3)
        edge_before: Option[ItemEntity] = level.find_item_entity(px + 16.5, origin.y(), pz + 0.5, 2)
        ctx.assert(edge_before.has(), "The item in the last cleared block should exist before the room is rebuilt.")
        Test.set_box_radius(4)
        ctx.not_done()
    } else {
        level: Level = Test.get_client_level()
        origin: Vec3 = Test.get_origin()
        found: Option[ItemEntity] = level.find_item_entity(origin.x(), origin.y(), origin.z(), 10)
        ctx.assert(not found.has(), "The room build's sweep should have removed the spawned item.")

        px: number = Math.floor(origin.x() - 3)
        pz: number = Math.floor(origin.z() - 3)
        edge_found: Option[ItemEntity] = level.find_item_entity(px + 16.5, origin.y(), pz + 0.5, 2)
        ctx.assert(not edge_found.has(), "The room build's sweep should have removed the item in the last cleared block.")
    }
}
