# A side is numbered from 0 to 5, so a side outside that range is reported rather than guessed at.
export tick(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    origin: Vec3 = ctx.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_power_block")
    be: BlockEntity = level.get_block_entity(x, y, z).unwrap()
    ctx.expect_error("has to be a whole number from 0 to 5")
    be.receive_energy_on(6, 1)
}
