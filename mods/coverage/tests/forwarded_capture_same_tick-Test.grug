# A server-run test, a plain tick and not tick_any_side, that places the obsidian wall
# forwarded_capture draws and requires the joined client's frame to show it in the same tick that
# placed it (#1123).
# A loader sends its queued block changes from its player manager's tick, which the server runs
# after the world's own tick, and a test's tick runs at the end of the world's, so a frozen test
# never reaches it. Alpha's flush used to do nothing, which is what this test is about. A capture
# asks the server to flush the queue before it sends the capture request, so the client has the wall
# when it draws the frame that is read; without the flush the wall sits in the queue and the capture
# reads the room. Alpha's block update packet is delayed while the control packet is immediate, so a
# flush can reach the wire just after the request: the settle wait's first answer can be 0, and a
# later ask sees the change once the connection has written it. That is why the wait loops and why
# the capture, not the first settle answer, is the assertion.
# Only a multiplayer run that forwards client calls runs a forwarded_ test.
room: Option[Screenshot] = Option.new()

# The step the next tick runs: 0 captures the room, 1 places the wall, asks for the settle and
# captures the wall, all in that one tick.
step: number = 0

export tick(ctx: TestTickContext) {
    if step == 0 {
        room.set(Test.screenshot().capture(620, 62, 700, 118))
        step = 1
        ctx.not_done()
    } else {
        origin: Vec3 = Test.get_origin()
        _wall_in_front_of(origin, "minecraft:obsidian")
        _wait_for_the_wall(ctx)
        wall: Screenshot = Test.screenshot().capture(620, 62, 700, 118)
        wall.differs_from(room.unwrap(), 50)
    }
}

# Asks the joined client whether it has drawn the world the placement made, again in this one
# tick. The first ask tells it the revision the placement gave; Alpha can answer it before the
# delayed block packet is written, so the loop asks until a frame drawn after the change settles,
# and the capture that follows reads the wall.
local _wait_for_the_wall(ctx: TestTickContext) {
    settled: bool = Test.world_settled()
    asks: number = 1
    while not settled and asks < 60 {
        settled = Test.world_settled()
        asks = asks + 1
    }
    ctx.assert(settled, "The client should have drawn the wall the same tick placed it.")
}

local _wall_in_front_of(origin: Vec3, block_name: string) {
    level: Level = Test.get_client_level()
    z: number = origin.z() + 1
    across: number = -2
    while across <= 2 {
        x: number = origin.x() + across
        up: number = -4
        while up <= 0 {
            level.place_block(x, origin.y() + up, z, block_name)
            up = up + 1
        }
        across = across + 1
    }
}
