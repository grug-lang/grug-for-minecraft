# A GUI's layout holds at most 64 of each record, which is what a client's reader accepts. A layout
# past that is one the client refuses, and refusing it costs the connection the server sent it over, so
# the 65th fill bar has to fail the call that adds it instead. See #1216.
export tick(ctx: TestTickContext) {
    layout: GUI = gui(r"assets/grug/textures/gui/crafting.png")

    added: number = 0
    while added < 64 {
        layout.add_fill("burn_time", "total_burn_time", 0, 0, 0, 0, 1, 1, "up", 0)
        added = added + 1
    }

    ctx.expect_error("GUI.add_fill: A GUI holds at most 64 fill bars")
    layout.add_fill("burn_time", "total_burn_time", 0, 0, 0, 0, 1, 1, "up", 0)
}
