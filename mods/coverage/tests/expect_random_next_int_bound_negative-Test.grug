# A negative bound names no size either, so it is reported rather than truncated or handed to Java's
# Random.nextInt, which refuses it too (#1752).
export tick(ctx: TestTickContext) {
    stream: Random = Random.new_seeded(1.0)

    ctx.expect_error("The bound has to be a whole number from 1 to")
    value: number = stream.next_int(-1)
}
