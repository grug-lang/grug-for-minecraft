# The release a press gets when the press itself closes the screen (#1217). On 1.20.6 the loader
# sends a release after every press it synthesizes, and a real mouse release reaches the screen the
# client shows at that moment. A press that closes its screen therefore has no screen to release
# on, and the loader skips it; a loader that kept the screen the press was made on would deliver
# the release to the closed inventory, whose menu is still the player's, and its click would swap
# the carried item with the hotbar item. The coverage overlay closes the inventory on a left click
# of the first hotbar slot while the cursor carries an item, without taking the press. Only 1.20.6
# fires that release, so the other loaders end before they open a screen.
# The 1.20.6 test player is in creative, so the inventory screen the test opens becomes the creative
# one. The client skips the game's window -1 cursor sync while that screen is open: a screen-type
# check in ClientPacketListener.handleContainerSetSlot, not something the screen's menu does. The
# screen's menu takes the cursor from the inventory menu's content packet, and the server sends that
# packet as well (#1390), so the overlay carries the item that closes the screen on the dedicated
# server too. The test keeps no wait
# for the overlay to be drawn: the screen's open answer is forwarded, and the click's outcome is
# read from the server's own menu on the next tick.
started: bool = false
opened: bool = false
waited: number = 0
clicked: bool = false

export tick(ctx: TestTickContext) {
    if not started {
        started = true
        if me.loader_name() != "1.20.6-forge" {
            return
        }
        ctx.close_screen()
        ctx.clear_carried_item()
        ctx.not_done()
        return
    }

    # A world frame has to be drawn before a screen that shows the player opens: the inventory
    # draws the player with the entity renderer, whose texture manager and camera the world's own
    # entity pass fills in, and a `-f mods=coverage` dispatch can run this test first, before any
    # frame has drawn (#1287). The runner puts the test that failed last first and then the
    # slowest, so any test of the mod can be that one. The test box's light is queued before the
    # test's own clock starts and the game runs ten ticks for one frame, so the first settle can
    # take a few hundred of the test's ticks; the failure bound is what says it never came.
    if not opened {
        waited = waited + 1
        ctx.assert(waited < 1000, "The world should settle before the inventory opens.")
        if not ctx.world_settled() {
            ctx.not_done()
            return
        }
        ctx.open_inventory(ctx.get_player())
        opened = true
        waited = 0
        ctx.not_done()
        return
    }

    if not clicked {
        if not ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 100, "The player's inventory screen should open.")
            ctx.not_done()
            return
        }
        # The hotbar slot holds an item the release's click could swap the cursor with, and the
        # cursor carries another one, which is what makes the press start a drag whose release
        # sends the click.
        ctx.clear_carried_item()
        ctx.set_held_item(ctx.get_player(), item_at(0))
        ctx.assert(ctx.get_player().get_held_item().has(), "The player should hold the item the hotbar press lands on.")
        ctx.set_carried_item(item(resource_location("minecraft:diamond")))
        ctx.assert(ctx.get_carried_item().has(), "The cursor should carry the item the press swaps.")
        hotbar_x: number = ctx.gui_left() + 17
        hotbar_y: number = ctx.gui_top() + ctx.gui_height() - 15
        taken: bool = ctx.click_screen(hotbar_x, hotbar_y, 0)
        ctx.assert(not taken, "The overlay should close the screen without taking the press.")
        ctx.assert(not ctx.screen_open(), "The press should have closed the inventory.")
        clicked = true
        ctx.not_done()
        return
    }

    # The click packet a release sends is the server's to apply, so the next tick reads it. A
    # release sent to the closed inventory would have swapped the carried diamond with the hotbar
    # item, which puts the hotbar item on the cursor and the diamond in the hand; the fixed loader
    # skips the release, so the cursor still carries the diamond and the hand keeps the hotbar item.
    carried: Option[Item] = ctx.get_carried_item()
    ctx.assert(carried.has(), "A press that closed its screen should not deliver a release that moves the cursor.")
    if carried.has() {
        ctx.assert(equals(carried.unwrap(), item(resource_location("minecraft:diamond"))), "The cursor should still carry the item the test put there.")
    }
    held: Option[Item] = ctx.get_player().get_held_item()
    ctx.assert(held.has(), "The hotbar slot should still hold the item the press landed on.")
    if held.has() {
        ctx.assert(equals(held.unwrap(), item_at(0)), "The release should not have swapped the hotbar item into the cursor.")
    }
    ctx.clear_carried_item()
    ctx.close_screen()
}
