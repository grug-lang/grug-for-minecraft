# The hotkey test reads whether JEI's item list is shown with a press the overlay takes and which
# gives nothing, rather than a right click on a grid cell: a cell click gives the player an item,
# and 1.20.6 queues that give to the integrated server, so the item could land after the test's
# cleanup and then show in the next test's capture (#1144). The hotkey test's own wait is that
# regression; this test checks the same property on a test the coverage gate counts: a press the
# coverage overlay takes gives nothing and leaves the hand and the cursor empty, so nothing was in
# flight when the test ended.
started: bool = false
opened: bool = false
waited: number = 0

export tick(ctx: TestTickContext) {
    if not started {
        started = true
        if not me.overlay_supported() {
            # This loader draws no overlays; the deviation is in about.json.
            return
        }
        ctx.close_screen()
        ctx.not_done()
        return
    }

    # A world frame has to be drawn before a screen that shows the player opens: the inventory
    # draws the player with the entity renderer, whose texture manager and camera the world's own
    # entity pass fills in, and a `-f mods=coverage` dispatch can run this test first, before any
    # frame has drawn (#1287). The runner puts the test that failed last first and then the
    # slowest, so any test of the mod can be that one. The test box's light is queued before the
    # test's own clock starts and the game runs ten ticks for one frame, so the first settle can
    # take a few hundred of the test's ticks; the failure bound is what says it never came.
    if not opened {
        waited = waited + 1
        ctx.assert(waited < 1000, "The world should settle before the inventory opens.")
        if not ctx.world_settled() {
            ctx.not_done()
            return
        }
        ctx.open_inventory(ctx.get_player())
        opened = true
        waited = 0
        ctx.not_done()
        return
    }

    if not ctx.screen_open() {
        waited = waited + 1
        ctx.assert(waited < 100, "The player's inventory screen should open.")
        ctx.not_done()
        return
    }

    if not ctx.overlay_drawn() {
        waited = waited + 1
        ctx.assert(waited < 200, "A frame with the overlay should be drawn on the open screen.")
        ctx.not_done()
        return
    }

    ctx.clear_carried_item()
    ctx.assert(ctx.get_held_count(ctx.get_player()) == 0, "The hand should be empty before the probe.")
    # The band the coverage overlay takes as the first hotbar slot: as wide as the 18-pixel slot
    # around gui_left + 17, and 15 pixels above the GUI's bottom edge. The overlay takes the press
    # without changing anything, which is the shape of the page-button press the hotkey test uses.
    hotbar_x: number = ctx.gui_left() + 17
    hotbar_y: number = ctx.gui_top() + ctx.gui_height() - 15
    ctx.assert(ctx.click_screen(hotbar_x, hotbar_y, 0), "The overlay should take a press that gives nothing.")
    ctx.assert(ctx.get_held_count(ctx.get_player()) == 0, "A taken press that gives nothing should leave the hand empty.")
    ctx.assert(not ctx.get_carried_item().has(), "A taken press that gives nothing should leave the cursor empty.")
    ctx.close_screen()
}
