# Runs after forwarded_capture_late: the client sends the stale answer to that test's request (a 9
# by 9 image) the moment it receives this test's first request, so it lands while this request
# waits, and must neither complete this request nor fail it. This is
# forwarded_capture again: a stale 9 by 9 image taken for the 80 by 56 one would not differ from
# the first frame by the shape of the wall, and the run would fail.
# The wall's capture waits for the forwarded Test.world_settled(), as forwarded_capture does, so
# the client has drawn the wall before the second request asks; a fixed tick was not enough on
# Alpha. See #1119.
before: Option[Screenshot] = Option.new()

# The step the next tick runs: 0 takes the first capture and places the wall, 1 waits for the
# client to draw it and captures the second frame.
step: number = 0

export tick(ctx: TestTickContext) {
    if step == 0 {
        before.set(Test.screenshot().capture(620, 62, 700, 118))
        origin: Vec3 = Test.get_origin()
        _wall_in_front_of(origin)
        step = 1
        ctx.not_done()
    } else if not Test.world_settled() {
        ctx.not_done()
    } else {
        after: Screenshot = Test.screenshot().capture(620, 62, 700, 118)
        after.differs_from(before.unwrap(), 50)
    }
}

local _wall_in_front_of(origin: Vec3) {
    level: Level = Test.get_client_level()
    z: number = origin.z() + 1
    across: number = -2
    while across <= 2 {
        x: number = origin.x() + across
        up: number = -4
        while up <= 0 {
            level.place_block(x, origin.y() + up, z, "grug:coverage_block")
            up = up + 1
        }
        across = across + 1
    }
}
