# An add_item export that errors when the host asks again with the rest ends the loop with what already went in, and the err is reported.
export run() {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_response_block")
    be: BlockEntity = level.get_block_entity(x, y, z).unwrap()
    diamond: Item = item(resource_location("minecraft:diamond"))
    be.set_saved_number("add_mode", 7)
    be.set_saved_number("slot", 2)
    be.set_item_in_slot(2, diamond, 63)
    me.expect_error("unwrap an empty Option")
    be.add_item(diamond, 0, 100, 0, true)
}
