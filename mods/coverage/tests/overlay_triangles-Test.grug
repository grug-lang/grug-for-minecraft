# Covers Color.rgba, OverlayWorldContext.draw_triangle and TestTickContext.set_player_position
# (#1253). The overlay's key Y saves the camera's position and draws two half-opaque red triangles
# four blocks ahead of it over a stone wall, so the wall shows through them. The test then moves the
# player one and a half blocks along x, which moves the triangles one and a half blocks across the
# frame while they stay where they were in the world, so one capture shows the translucent fill and
# the teleport together. The capture is framed on the moved triangles, so the whole square is in it.
# Only the Beta 1.7.3 loaders draw triangles and move the player so far; every other loader stops
# the game on those calls, so the test returns before it builds anything there.
started: bool = false
pressed: bool = false
moved: bool = false
settled_ticks: number = 0
waited: number = 0

export tick(ctx: TestTickContext) {
    if not started {
        started = true
        if me.loader_name() != "b1.7.3-ornithe" and me.loader_name() != "b1.7.3-stationapi" {
            return
        }
        ctx.set_box_radius(6)
        origin: Vec3 = ctx.get_origin()
        _wall(ctx.get_client_level(), origin.x() - 6, origin.y() - 9, origin.z() + 6)
        # The room's floor is three blocks below the feet and only the column the player starts in
        # has a block at their own level, so the move below needs a floor of its own: without one
        # the player drops onto the torch floor and the camera leaves the triangles above the frame.
        _pad(ctx.get_client_level(), origin.x() + 1.5, origin.z(), origin.y() - 4.62)
        ctx.not_done()
        return
    }

    waited = waited + 1
    ctx.assert(waited < 1500, "The triangles test should finish.")

    if not ctx.world_settled() {
        settled_ticks = 0
        ctx.not_done()
        return
    }
    if settled_ticks < 5 {
        settled_ticks = settled_ticks + 1
        ctx.not_done()
        return
    }

    if not pressed {
        pressed = true
        ctx.press_world_key(89, false)
        ctx.not_done()
        return
    }
    if not ctx.world_overlay_drawn() {
        ctx.not_done()
        return
    }

    if not moved {
        moved = true
        settled_ticks = 0
        # The origin is the camera plus 3 on y only, and the feet are 1.62 blocks under the eye, so
        # this stands one and a half blocks along x at the same height and depth.
        origin: Vec3 = ctx.get_origin()
        ctx.set_player_position(origin.x() + 1.5, origin.y() - 4.62, origin.z())
        # A press clears the drawn mark, so the wait below ends on a frame that came after the move
        # and not on one the move had not reached. M is not a key the overlay takes.
        ctx.press_world_key(77, false)
        ctx.not_done()
        return
    }
    if not ctx.world_overlay_drawn() {
        ctx.not_done()
        return
    }

    # 480 by 340, shifted one and a half blocks along x with the triangles, since a window centred
    # on the frame would cut the off-centre square at the right edge. The bottom 60 rows are left
    # out: they hold only the first-person hand, whose shading after the move settles on a different
    # frame in the installed client than in the dev one, and the hand is not what this test compares
    # (#1472). The square's lowest row is 324 in the capture and the hand's highest is 347.
    ctx.screenshot().equals(r"screenshots/overlay_triangles", 589, 160, 1069, 500)

    # Left on, the triangles would sit in every later test's captures.
    ctx.press_world_key(89, false)
}

# Thirteen blocks square of minecraft:stone at (x0, y0, z), as overlay_world's wall is.
local _wall(level: Level, x0: number, y0: number, z: number) {
    wy: number = y0
    while wy < y0 + 13 {
        wx: number = x0
        while wx < x0 + 13 {
            level.place_block(wx, wy, z, "minecraft:stone")
            wx = wx + 1
        }
        wy = wy + 1
    }
}

# Three by three blocks whose top is the feet level, under a position the test moves the player to,
# so the player stands on their own level there instead of falling to the room's torch floor.
local _pad(level: Level, x: number, z: number, feet_y: number) {
    px: number = Math.floor(x)
    pz: number = Math.floor(z)
    py: number = Math.floor(feet_y) - 1
    dx: number = -1
    while dx <= 1 {
        dz: number = -1
        while dz <= 1 {
            level.place_block(px + dx, py, pz + dz, "minecraft:stone")
            dz = dz + 1
        }
        dx = dx + 1
    }
}
