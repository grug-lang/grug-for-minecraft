# The first half of a pair that covers what the runner does between two tests (see #583). It ends in the
# same tick it places a block of coverage_render, whose block entity reports a refused draw the first time
# it is drawn. The pair is a pair because the game has to be left with chunk rebuilds of these blocks still
# queued or running as the runner clears the area, which no single test can do: the clear is the runner's.
# The next test, runner_clear_b_hammers_client, runs straight after this one by its name.
export tick(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y()
    z: number = origin.z()

    # Many blocks, each with a block entity of its own, so the rebuild they cause has a lot of drawing in
    # it and lasts as long as it can.
    dx: number = 0
    while dx < 3 {
        dy: number = 0
        while dy < 3 {
            dz: number = 0
            while dz < 3 {
                level.place_block(x + dx, y + 1 + dy, z + 1 + dz, "grug:coverage_render")
                dz = dz + 1
            }
            dy = dy + 1
        }
        dx = dx + 1
    }
}
