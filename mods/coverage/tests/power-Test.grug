# A block entity that declared itself an energy receiver holds what is sent to it up to its limit,
# gives it back to whoever spends it, and a block entity that never declared anything is not one.
export run() {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "minecraft:chest")
    chest: BlockEntity = level.get_block_entity(x, y, z).unwrap()
    Test.assert(not is_power_receiver(chest), "A chest should not be an energy receiver.")

    level.place_block(x + 2, y, z, "grug:coverage_block")
    plain: BlockEntity = level.get_block_entity(x + 2, y, z).unwrap()
    Test.assert(not is_power_receiver(plain), "A grug block entity that declared nothing should not be one.")

    level.place_block(x + 4, y, z, "grug:coverage_power_block")
    be: BlockEntity = level.get_block_entity(x + 4, y, z).unwrap()
    Test.assert(is_power_receiver(be), "init() declared this block entity a receiver.")
    Test.assert(get_energy_stored(be) == 0, "A receiver starts empty.")

    Test.assert(receive_energy(be, 4) == 4, "Four fit in a store of ten.")
    Test.assert(get_energy_stored(be) == 4, "The store should hold the four.")
    Test.assert(receive_energy(be, 20) == 6, "Only six more fit, so six is how much was stored.")
    Test.assert(get_energy_stored(be) == 10, "The store should be full, with the rest lost.")
    Test.assert(receive_energy(be, 3) == 0, "A full store takes nothing.")
    Test.assert(receive_energy(be, 0) == 0, "Sending nothing stores nothing.")

    Test.assert(extract_energy(be, 3) == 3, "Taking three from ten gives three.")
    Test.assert(get_energy_stored(be) == 7, "Seven should be left.")
    Test.assert(extract_energy(be, 100) == 7, "Taking more than is there gives what is there.")
    Test.assert(get_energy_stored(be) == 0, "The store should be empty.")
    Test.assert(extract_energy(be, 5) == 0, "An empty store gives nothing.")
}
