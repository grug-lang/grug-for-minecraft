# A block entity that declared itself an energy receiver holds what is sent to it up to its limit,
# gives it back to whoever spends it, and a block entity that never declared anything is not one.
export run() {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    pos: BlockPos = BlockPos.new(x, y, z)
    level.place_block(pos, "minecraft:chest")
    chest: BlockEntity = level.get_block_entity(pos).unwrap()
    Test.assert(not chest.is_power_receiver(), "A chest should not be an energy receiver.")

    pos2: BlockPos = BlockPos.new(x + 2, y, z)
    level.place_block(pos2, "grug:coverage_block")
    plain: BlockEntity = level.get_block_entity(pos2).unwrap()
    Test.assert(not plain.is_power_receiver(), "A grug block entity that declared nothing should not be one.")

    pos3: BlockPos = BlockPos.new(x + 4, y, z)
    level.place_block(pos3, "grug:coverage_power_block")
    be: BlockEntity = level.get_block_entity(pos3).unwrap()
    Test.assert(be.is_power_receiver(), "init() declared this block entity a receiver.")
    Test.assert(be.get_energy_stored() == 0, "A receiver starts empty.")

    Test.assert(be.receive_energy(4) == 4, "Four fit in a store of ten.")
    Test.assert(be.get_energy_stored() == 4, "The store should hold the four.")
    Test.assert(be.receive_energy(20) == 6, "Only six more fit, so six is how much was stored.")
    Test.assert(be.get_energy_stored() == 10, "The store should be full, with the rest lost.")
    Test.assert(be.receive_energy(3) == 0, "A full store takes nothing.")
    Test.assert(be.receive_energy(0) == 0, "Sending nothing stores nothing.")

    Test.assert(be.extract_energy(3) == 3, "Taking three from ten gives three.")
    Test.assert(be.get_energy_stored() == 7, "Seven should be left.")
    Test.assert(be.extract_energy(100) == 7, "Taking more than is there gives what is there.")
    Test.assert(be.get_energy_stored() == 0, "The store should be empty.")
    Test.assert(be.extract_energy(5) == 0, "An empty store gives nothing.")
}
