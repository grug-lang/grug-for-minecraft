# ctx.open_inventory asked of a dedicated server's joined client (#1094). The server
# forwards the call, the client opens its own inventory screen, and this waits for that screen and
# closes it: the screen is the client's, not a menu the server made up. A server that dropped the
# forwarding would refuse with a host function error naming the function, and the screen would
# never open, which fails the wait below (#1064, #1098). See forwarded_screen_width-Test for why
# this is a forwarded_ test.
started: bool = false
opened: bool = false
waited: number = 0

export tick(ctx: TestTickContext) {
    if not started {
        started = true
        ctx.close_screen()
        ctx.not_done()
        return
    }

    # A world frame has to be drawn before a screen that shows the player opens: the inventory
    # draws the player with the entity renderer, whose texture manager and camera the world's own
    # entity pass fills in, and a `-f mods=coverage` dispatch can run this test first, before any
    # frame has drawn (#1287). The runner puts the test that failed last first and then the
    # slowest, so any test of the mod can be that one. The test box's light is queued before the
    # test's own clock starts and the game runs ten ticks for one frame, so the first settle can
    # take a few hundred of the test's ticks; the failure bound is what says it never came.
    if not opened {
        waited = waited + 1
        ctx.assert(waited < 1000, "The world should settle before the inventory opens.")
        if not ctx.world_settled() {
            ctx.not_done()
            return
        }
        ctx.open_inventory(ctx.get_player())
        opened = true
        waited = 0
        ctx.not_done()
        return
    }
    if not ctx.screen_open() {
        ctx.not_done()
        return
    }
    ctx.close_screen()
    ctx.assert(not ctx.screen_open(), "TestTickContext.close_screen should leave the client's screen closed.")
}
