# String.concat, String.from_character, String.length and String.substring edit text the way a search
# field does: a key's character is appended and the last character is dropped (#865).
export tick_any_side(ctx: TestTickContext) {
    if ctx.current_tick() == 0 {
        ctx.assert(String.concat("ab", "c") == "abc", "String.concat should join the two texts in order.")
        ctx.assert(String.concat("", "") == "", "String.concat of two empty texts should be empty.")
        ctx.assert(String.from_character(97) == "a", "String.from_character(97) should be a.")
        ctx.assert(String.from_character(32) == " ", "String.from_character(32) should be a space.")
        ctx.assert(String.length("") == 0, "String.length of an empty text should be 0.")
        ctx.assert(String.length("abc") == 3, "String.length(\"abc\") should be 3.")
        ctx.assert(String.length(String.from_character(128512)) == 1, "A character outside the basic plane should count once.")
        ctx.assert(String.substring("abcd", 1, 3) == "bc", "String.substring(\"abcd\", 1, 3) should be bc.")
        ctx.assert(String.substring("abcd", 0, 0) == "", "An empty range should give an empty text.")
        ctx.assert(String.substring("abcd", 0, String.length("abcd") - 1) == "abc", "Dropping the last character should leave abc.")
        ctx.assert(String.substring(String.concat("a", String.from_character(128512)), 1, 2) == String.from_character(128512), "A character outside the basic plane should be one position.")
    }
}
