# A get_liquid export that answers an amount where the host asked for a liquid is an err, because
# the host has no liquid to answer with.
export tick(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    origin: Vec3 = ctx.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_response_block")
    be: BlockEntity = level.get_block_entity(x, y, z).unwrap()
    be.set_saved_number("liquid_mode", 11)

    ctx.expect_error("a liquid name or none")
    held: Option[string] = be.get_liquid()
}
