# Covers get_inventory_size(), which the wooden pipe needs to walk a neighbour inventory's slots.
export run() {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    pos: BlockPos = BlockPos.new(x, y, z)
    level.place_block(pos, "grug:coverage_block")
    block_opt: Option[BlockEntity] = level.get_block_entity(pos)
    Test.assert(block_opt.has(), "The coverage block should have a block entity.")
    block_be: BlockEntity = block_opt.unwrap()
    Test.assert(block_be.get_inventory_size() == 9, "The coverage block should have 9 slots.")

    level.place_block(pos, "minecraft:chest")
    chest_opt: Option[BlockEntity] = level.get_block_entity(pos)
    Test.assert(chest_opt.has(), "The chest should have a block entity.")
    chest_be: BlockEntity = chest_opt.unwrap()
    Test.assert(chest_be.get_inventory_size() == 27, "A chest should have 27 slots.")
}
