# An index past the end of an existing list names no record, so reading it is reported rather than
# answered with a fresh record's defaults.
export run(ctx: TestRunContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_init_block")
    be: BlockEntity = level.get_block_entity(x, y, z).unwrap()
    be.append_saved_list_record("things")

    ctx.expect_error("There is no record at index 1")
    value: number = be.get_saved_list_number("things", 1, "speed")
}
