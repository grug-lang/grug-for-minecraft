# A stack's count is only as good as the loader's save. The four older loaders write Count as one
# NBT byte, so 127 is the largest count they keep; 1.20.6 writes an int. A chest round trip through
# the game's own NBT proves the count reaches the save and comes back, and item_stack accepting the
# same count proves the stack a mod makes is one the save keeps on every loader.
stack_save_count: number = 127

export tick(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "minecraft:chest")
    chest: BlockEntity = level.get_block_entity(x, y, z).unwrap()

    diamond: Item = item(resource_location("minecraft:diamond"))
    chest.set_item_in_slot(0, diamond, stack_save_count)
    ctx.assert(chest.get_item_count_in_slot(0) == stack_save_count, "The chest should hold the whole stack.")

    Test.round_trip_nbt(chest)

    ctx.assert(chest.get_item_count_in_slot(0) == stack_save_count, "The count should survive the save and reload.")

    # item_stack accepts the same count, so a stack a mod makes is one the save keeps.
    stack: ItemStack = item_stack(diamond, 0, stack_save_count)
    entity: ItemEntity = item_entity(level, x, y + 1, z, stack)
    ctx.assert(entity.count() == stack_save_count, "item_stack should accept the largest count the save keeps.")
}
