# give_item_stack puts the item's own maximum stack in the player's hand, the amount the reference's
# stack binding gives, so a tool arrives as one item and a block as a whole stack (#865).
started: bool = false
waited: number = 0

export tick(ctx: TestTickContext) {
    if not started {
        started = true
        if not me.overlay_supported() {
            # This loader lists no items.
            return
        }
        ctx.clear_held_item(ctx.get_player())
        # The second item is not the bucket the other tests give, so this is a stack larger than one.
        give_item_stack(item_at(1))
        ctx.not_done()
        return
    }

    held: Option[Item] = ctx.get_player().get_held_item()
    if not held.has() {
        waited = waited + 1
        ctx.assert(waited < 200, "The stack the give asked for should reach the player's hand.")
        ctx.not_done()
        return
    }
    ctx.assert(equals(held.unwrap(), item_at(1)), "The give should put the item it was asked for in the hand.")
    ctx.assert(ctx.get_held_count(ctx.get_player()) == ctx.get_item_max_stack(item_at(1)), "The give should put the item's maximum stack in the hand.")
    ctx.clear_held_item(ctx.get_player())
}
