# A block entity's grug entity, and so its init() export, must be created the moment the block
# entity is registered with a world, which is when the block is placed, on every loader. Reading the
# number init() saved in the same tick the block was placed, before any block entity tick has run,
# fails on a loader that waits for the first tick, which is the cross-loader difference this test
# exists to catch. See #187.
export tick(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y()
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_init_block")
    block_opt: Option[BlockEntity] = level.get_block_entity(x, y, z)
    ctx.assert(block_opt.has(), "coverage_init_block has no block entity after being placed.")

    be: BlockEntity = block_opt.unwrap()
    ctx.assert(be.get_saved_number("inited") == 1, "init() had not run by the time the block was placed on this loader.")
}
