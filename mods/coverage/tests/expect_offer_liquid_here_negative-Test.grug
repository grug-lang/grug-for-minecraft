# An offer_liquid_here export that answers a negative amount is an err, as offer_liquid's is: the
# amount is liquid a walk is moving into the store, so a negative one is no answer the host can use.
export tick(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    origin: Vec3 = ctx.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_response_block")
    be: BlockEntity = level.get_block_entity(x, y, z).unwrap()
    be.set_saved_number("liquid_mode", 10)

    ctx.expect_error("a finite amount of 0 or more")
    taken: number = be.offer_liquid_here("minecraft:water", 1000, 0, true)
}
