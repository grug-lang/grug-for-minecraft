# An amount has to be a finite number. A NaN take would answer NaN, which the caller would compare
# against zero and use as an amount, and an infinity is no amount either. The host refuses it before
# the export is asked, as it refuses a name that is no liquid.
export tick(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    origin: Vec3 = ctx.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_response_block")
    be: BlockEntity = level.get_block_entity(x, y, z).unwrap()

    nan: number = Math.sqrt(-1)
    ctx.expect_error("BlockEntity.take_liquid: The amount has to be a finite number")
    given: number = be.take_liquid(nan, true)

    infinity: number = Math.cosh(1000)
    ctx.expect_error("BlockEntity.take_liquid: The amount has to be a finite number")
    given_again: number = be.take_liquid(infinity, true)
}
