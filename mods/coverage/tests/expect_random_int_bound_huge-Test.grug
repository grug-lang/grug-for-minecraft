# random_int draws below its bound, and a bound beyond a Java int names no size, so it is reported
# rather than truncated to a bound the caller did not ask for.
export tick(ctx: TestTickContext) {
    level: Level = Test.get_client_level()

    ctx.expect_error("The bound has to be a whole number from 1 to")
    value: number = level.random_int(2147483648.0)
}
