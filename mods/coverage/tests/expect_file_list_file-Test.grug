# A listing asks for a directory (#1757): a path that names a file is reported rather than listing no
# entries as if the file were an empty directory.
export tick(ctx: TestTickContext) {
    files: File = File.open(r"files")
    files.write_text("a_file.txt", "x")
    ctx.expect_error("names a file, not a directory")
    files.entry_count("a_file.txt")
}
