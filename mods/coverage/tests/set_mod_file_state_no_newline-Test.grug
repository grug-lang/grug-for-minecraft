# Putting a file that already has no trailing newline into "no_trailing_newline" must leave it alone
# rather than stripping a character off the end.
export tick(ctx: TestTickContext) {
    Test.set_mod_file_state("coverage/data/grug/recipes/crafting/coverage_fixture.json", "no_trailing_newline")
    Test.set_mod_file_state("coverage/data/grug/recipes/crafting/coverage_fixture.json", "normal")
    ctx.assert(true, "A file with no trailing newline is left alone.")
}
