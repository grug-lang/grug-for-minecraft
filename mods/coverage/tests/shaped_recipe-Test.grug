# A shaped recipe a mod ships has to register and craft. The shapeless sibling next door drives the
# same wiring for a recipe Alpha has no registration of its own for; this one asserts the shaped
# half, which had no end-to-end test on any loader until the 1.2.5 loader read the mods' data/ trees
# like the other four already did.
# Band 15 is free: the recipe tests use 6, 10, 25, 35, 40, 45 and 50, and the coverage tests
# 0, 20 and 30.
export run() {
    # A loader that registers no mod recipe and one that failed to register this recipe both answer
    # the grid with nothing, so the loader is asked rather than assumed.
    if not Test.registers_mod_recipes() {
        return
    }

    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 15
    z: number = origin.z()

    stick: Item = item(resource_location("minecraft:stick"))
    ingot: Item = item(resource_location("minecraft:iron_ingot"))

    # Slot 0 is the single cell of shaped_recipe.json's one-row "S" pattern.
    grid: BlockEntity = _grid(level, x, y, z)
    set_item_in_slot(grid, 0, stick, 1)
    update_recipe_output(grid, 0)
    Test.assert(take_crafting_result(grid, 1) == 1, "A single stick should craft the shaped recipe's one result.")
    Test.assert(take_crafting_result(grid, 1) == 0, "The shaped recipe should have nothing left to give.")

    # An iron ingot is not the stick the recipe names, so nothing matches.
    wrong: BlockEntity = _grid(level, x + 3, y, z)
    set_item_in_slot(wrong, 0, ingot, 1)
    update_recipe_output(wrong, 0)
    Test.assert(take_crafting_result(wrong, 1) == 0, "An iron ingot should not match a recipe that names a stick.")
}

# The coverage block's block entity has the nine slots a crafting grid reads, which is why this is
# the block to place rather than a chest or the autocrafting table.
local _grid(level: Level, x: number, y: number, z: number) BlockEntity {
    level.place_block(x, y, z, "grug:coverage_block")
    found: Option[BlockEntity] = level.get_block_entity(x, y, z)
    Test.assert(found.has(), "The coverage block should have a block entity after being placed.")
    return found.unwrap()
}
