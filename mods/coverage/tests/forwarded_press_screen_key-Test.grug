# ctx.press_screen_key forwarded to a dedicated server's joined client (#1094): the keys are
# pressed on the client's screen through the client's own key path, and the answer is whether an
# overlay took the key. The fixture is a vanilla chest rather than grug:coverage_gui, because a
# loader leaves a mod's own GrugScreen out of the screens its overlays are asked on, while the
# coverage overlay is asked on the game's own container screens. This runs on 1.20.6, whose server
# right-clicks the chest through the player's game mode, and on 1.2.5 and both b1.7.3 servers,
# whose server right-clicks it through its own interaction manager (#1388); the Alpha server has
# no interaction manager to reach yet, so it still cannot open the chest and lists this test as
# unsupported. Ctrl+K is the key the coverage overlay takes, and K without control is left to the
# screen. On 1.20.6 Escape (GLFW's 256) is also left to the screen, which closes itself on it; every
# loader before 1.20.6 maps a character code to a key and has none for 256, so there the close is
# asked for directly instead. Only a multiplayer run that forwards client calls runs a forwarded_
# test.
started: bool = false

export tick(ctx: TestTickContext) {
    loader: string = me.loader_name()
    if not started {
        started = true
        ctx.close_screen()
        level: Level = ctx.get_client_level()
        origin: Vec3 = ctx.get_origin()
        level.place_block(origin.x(), origin.y(), origin.z(), "minecraft:chest")
        ctx.use_block(level, origin.x(), origin.y(), origin.z())
        ctx.not_done()
        return
    }
    if not ctx.screen_open() {
        ctx.not_done()
        return
    }
    ctx.assert(ctx.press_screen_key(75, true, false, true), "Ctrl+K should be taken by the coverage overlay on the client.")
    ctx.assert(not ctx.press_screen_key(75, false, false, true), "K without control should be left to the client's screen.")
    if loader != "1.20.6-forge" {
        ctx.close_screen()
        ctx.assert(not ctx.screen_open(), "TestTickContext.close_screen should leave the client's screen closed.")
        return
    }
    ctx.assert(not ctx.press_screen_key(256, false, false, true), "Escape should be left to the client's screen.")
    ctx.assert(not ctx.screen_open(), "Escape should have closed the client's screen.")
    # Escape closed the client's screen; the server's menu is closed here, so the panel this test
    # opened does not outlive it.
    ctx.close_screen()
}
