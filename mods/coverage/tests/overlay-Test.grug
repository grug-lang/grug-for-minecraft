# Covers the overlay host functions on the player's inventory screen: the context numbers, item_at,
# give_item, the loader's open_inventory and click_screen, and the press being taken away from the
# vanilla slot. It first presses a vanilla slot, which the screen handles but no overlay takes, and
# checks the answer is false; then it presses the centre, where the coverage overlay draws its one
# item and takes the click, and waits for the item to reach its hand. On a loader that draws no
# overlays the overlay's exports are never asked, which about.json records as a deviation, and the
# test returns before it opens a screen it cannot show. See #615.
started: bool = false
waited: number = 0
checked_slot: bool = false
clicked: bool = false

export tick(ctx: TestTickContext) {
    if not started {
        started = true
        if not Test.overlay_supported() {
            return
        }
        Test.close_screen()
        Test.open_inventory(Test.get_player())
        ctx.not_done()
        return
    }

    if not Test.screen_open() {
        waited = waited + 1
        ctx.assert(waited < 100, "The player's inventory screen should open.")
        ctx.not_done()
        return
    }

    if not Test.overlay_drawn() {
        # The screen is up but no frame with the overlay has been drawn yet, and at the run's
        # maximum speed the test can click and close before one is. Asking turns drawing on.
        waited = waited + 1
        ctx.assert(waited < 200, "A frame with the overlay should be drawn on the open screen.")
        ctx.not_done()
        return
    }

    if not checked_slot {
        # A press on a vanilla slot is handled by the screen itself, but no overlay took it, so the
        # answer has to be false: the screen's own handling is not an overlay's take. The first
        # main-inventory slot is at (133, 121) on this screen, inside the GUI and outside both the
        # coverage overlay's box and the port's grid.
        Test.clear_held_item(Test.get_player())
        checked_slot = true
        taken_by_screen: bool = Test.click_screen(137, 125, 0)
        ctx.assert(not taken_by_screen, "A press on a vanilla slot that no overlay took should answer false.")
        ctx.not_done()
        return
    }

    if not clicked {
        # An earlier test may have left the hotbar slot filled, which would push the given item
        # somewhere the test cannot read back.
        Test.clear_held_item(Test.get_player())
        clicked = true
        taken: bool = Test.click_screen(213, 120, 0)
        ctx.assert(taken, "The overlay should take a press at the centre of the screen.")
        ctx.not_done()
        return
    }

    held: Option[Item] = Test.get_player().get_held_item()
    if not held.has() {
        waited = waited + 1
        ctx.assert(waited < 200, "The item the overlay gave should reach the player's hand.")
        ctx.not_done()
        return
    }

    ctx.assert(equals(held.unwrap(), item_at(0)), "The overlay should give the item it drew, not another one.")
    Test.clear_held_item(Test.get_player())
    Test.close_screen()
}
