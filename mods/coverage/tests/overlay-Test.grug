# Covers the overlay host functions on the player's inventory screen: the context numbers and
# modifiers, item_at, give_item and give_item_stack, the cursor carried_item and
# delete_carried_item, the test's own stack count and cursor helpers, the loader's open_inventory
# and click_screen, and the press being taken away from the vanilla slot. It presses the centre,
# where the coverage overlay draws its one item and takes the click, and waits for the item to reach
# its hand; a middle click gives a stack, and a left click while the cursor carries an item deletes
# it. Last, it presses a vanilla slot, which the screen handles but no overlay takes, and checks the
# answer is false. On a loader that draws no overlays the overlay's exports are never asked, which
# about.json records as a deviation, and the test returns before it opens a screen it cannot show.
# See #615.
started: bool = false
opened: bool = false
waited: number = 0
step: number = 0

export tick(ctx: TestTickContext) {
    if not started {
        started = true
        if not me.overlay_supported() {
            return
        }
        ctx.close_screen()
        ctx.not_done()
        return
    }

    # A world frame has to be drawn before a screen that shows the player opens: the inventory
    # draws the player with the entity renderer, whose texture manager and camera the world's own
    # entity pass fills in, and a `-f mods=coverage` dispatch can run this test first, before any
    # frame has drawn (#1287). The runner puts the test that failed last first and then the
    # slowest, so any test of the mod can be that one. The test box's light is queued before the
    # test's own clock starts and the game runs ten ticks for one frame, so the first settle can
    # take a few hundred of the test's ticks; the failure bound is what says it never came.
    if not opened {
        waited = waited + 1
        ctx.assert(waited < 1000, "The world should settle before the inventory opens.")
        if not ctx.world_settled() {
            ctx.not_done()
            return
        }
        ctx.open_inventory(ctx.get_player())
        opened = true
        waited = 0
        ctx.not_done()
        return
    }

    if not ctx.screen_open() {
        waited = waited + 1
        ctx.assert(waited < 100, "The player's inventory screen should open.")
        ctx.not_done()
        return
    }

    if not ctx.overlay_drawn() {
        # The screen is up but no frame with the overlay has been drawn yet, and at the run's
        # maximum speed the test can click and close before one is. Asking turns drawing on.
        waited = waited + 1
        ctx.assert(waited < 200, "A frame with the overlay should be drawn on the open screen.")
        ctx.not_done()
        return
    }

    if step == 0 {
        # An earlier test may have left something on the cursor, which the overlay would delete
        # instead of giving.
        ctx.clear_carried_item()
        ctx.assert(ctx.get_item_max_stack(item_at(0)) > 0, "The first item should have a positive stack size.")
        ctx.assert(ctx.get_held_count(ctx.get_player()) == 0, "The hand should be empty when the test starts.")
        step = 1
        taken: bool = ctx.click_screen(213, 120, 0)
        ctx.assert(taken, "The overlay should take a press at the centre of the screen.")
        ctx.not_done()
        return
    }

    if step == 1 {
        held: Option[Item] = ctx.get_player().get_held_item()
        if not held.has() {
            waited = waited + 1
            ctx.assert(waited < 200, "The item the overlay gave should reach the player's hand.")
            ctx.not_done()
            return
        }
        ctx.assert(equals(held.unwrap(), item_at(0)), "The overlay should give the item it drew, not another one.")
        ctx.assert(ctx.get_held_count(ctx.get_player()) == 1, "A left click should give one item.")
        # A middle click is the reference's stack binding.
        ctx.clear_held_item(ctx.get_player())
        step = 2
        taken: bool = ctx.click_screen(213, 120, 2)
        ctx.assert(taken, "The overlay should take a middle click on its item.")
        ctx.not_done()
        return
    }

    if step == 2 {
        held: Option[Item] = ctx.get_player().get_held_item()
        if not held.has() {
            waited = waited + 1
            ctx.assert(waited < 200, "The stack the overlay gave should reach the player's hand.")
            ctx.not_done()
            return
        }
        ctx.assert(equals(held.unwrap(), item_at(0)), "A middle click should give the item the overlay drew.")
        ctx.clear_held_item(ctx.get_player())
        # Repeat the set/read/clear to catch a server that stores the cursor on the wrong screen
        # (#1389). Only a joined client on a dedicated server can see this, because the same process
        # on a singleplayer run shares the cursor.
        repeat_count: number = 0
        while repeat_count < 3 {
            ctx.set_carried_item(item_at(0))
            set_item: Option[Item] = ctx.get_carried_item()
            ctx.assert(set_item.has(), "The test should be able to put an item on the cursor.")
            ctx.assert(equals(set_item.unwrap(), item_at(0)), "The cursor should hold the item that was set.")
            ctx.clear_carried_item()
            ctx.assert(not ctx.get_carried_item().has(), "The cursor should be empty after it is cleared.")
            repeat_count = repeat_count + 1
        }
        # A left click while the cursor carries an item deletes it.
        ctx.set_carried_item(item_at(0))
        ctx.assert(ctx.get_carried_item().has(), "The test should be able to put an item on the cursor.")
        step = 3
        taken: bool = ctx.click_screen(213, 120, 0)
        ctx.assert(taken, "The overlay should take a left click while the cursor carries an item.")
        ctx.not_done()
        return
    }

    ctx.assert(not ctx.get_carried_item().has(), "A left click on the overlay should delete the item on the cursor.")
    ctx.assert(not ctx.get_player().get_held_item().has(), "Deleting the carried item should not also give one.")
    # A press on a vanilla slot is handled by the screen itself, but no overlay took it, so the
    # answer has to be false: the screen's own handling is not an overlay's take. The first
    # main-inventory slot is at (133, 121) on this screen, inside the GUI and outside both the
    # coverage overlay's box and the port's grid. It runs last because the screen's own handling may
    # pick an item up onto the cursor, which no later step would want.
    taken_by_screen: bool = ctx.click_screen(137, 125, 0)
    ctx.assert(not taken_by_screen, "A press on a vanilla slot that no overlay took should answer false.")
    ctx.close_screen()
}
