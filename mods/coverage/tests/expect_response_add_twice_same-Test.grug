# AddResponse answered twice with the same answer is an err too, so a repeated answer cannot creep in silently.
export run() {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_response_block")
    be: BlockEntity = level.get_block_entity(x, y, z).unwrap()
    diamond: Item = item(resource_location("minecraft:diamond"))
    be.set_saved_number("add_mode", 4)

    me.expect_error("has already been answered")
    be.add_item(diamond, 0, 1, 0, true)
}
