# Energy is never negative, so a negative most to take is reported rather than treated as 0.
export tick(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_power_block")
    be: BlockEntity = level.get_block_entity(x, y, z).unwrap()
    ctx.expect_error("has to be a whole number from 0 to")
    be.extract_energy(-1)
}
