# Covers small value functions on their own: Vec3.zero(), String.length(), equals() on numbers and
# booleans, and print() of every value type, so each runs from a test that does nothing else.
export tick(ctx: TestTickContext) {
    origin: Vec3 = Vec3.zero()
    ctx.assert(origin.x() == 0 and origin.y() == 0 and origin.z() == 0, "Vec3.zero should be the origin.")
    ctx.assert(String.length("") == 0, "The empty string should have length 0.")
    ctx.assert(String.length("grug") == 4, "String.length should count the characters.")
    ctx.assert(equals(2, 2), "equals should compare equal numbers.")
    ctx.assert(not equals(2, 3), "equals should tell different numbers apart.")
    ctx.assert(equals(true, true), "equals should compare equal booleans.")
    ctx.assert(not equals(true, false), "equals should tell different booleans apart.")
    ctx.assert(String.from_number(0.00001) == "1.0E-5", "A small number should be written with an exponent.")
    ctx.assert(String.from_number(0.000015) == "1.5E-5", "A small number's digits should follow the point.")
    ctx.assert(String.from_number(12345678.9) == "1.23456789E7", "A large fraction should be written with an exponent.")
    ctx.assert(String.from_number(0.1 + 0.2) == "0.30000000000000004", "The shortest text that reads back should be written.")
    print(true)
    print(1.5)
    print("text")
    # Every call that makes an object makes a new one, so a test can make more than a table's first
    # block of them without any of them going wrong.
    i: number = 0
    while i < 300 {
        ctx.assert(Vec3.zero().x() == 0, "A fresh Vec3 should be the origin.")
        i = i + 1
    }
}
