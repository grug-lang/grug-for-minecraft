# set_energy_request is a receiver's own declaration, so a block entity that declared nothing is
# reported.
export tick(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    origin: Vec3 = ctx.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_block")
    be: BlockEntity = level.get_block_entity(x, y, z).unwrap()
    ctx.expect_error("is not an energy receiver")
    be.set_energy_request(1)
}
