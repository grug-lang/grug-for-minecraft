# A capture taken as soon as the settle answer allows it has to show the settled room, not the room
# meshed from the light the world had before it was rebuilt. Every round here rebuilds the room
# through Test.set_box_radius and captures through coverage_frame's rectangle and reference, so the
# reference is that test's own golden and this one adds none. See #686.
# The room is built at radius 6 and then at radius 3, which is too small to hold the fixture: the
# next build at 6 therefore rebuilds the room rather than finding it whole, and every round relights
# it. Each round is one window in which the rebuild's light can still be arriving, so the rounds are
# what makes a run that does not wait land on the stale frame.
frame_block: Option[BlockEntity] = Option.new()

# Whether the current round's room and fixture are built.
built: bool = false

# Whether the current round has held the server thread after the rebuild. See the stall in tick().
stalled: bool = false

# Whether the current round's capture has been taken.
captured: bool = false

# How many rounds have been captured.
rounds: number = 0

# How many rounds one run takes.
rounds_wanted: number = 8

export init(ctx: TestInitContext) {
    # A round is a rebuild, a stall, a settle wait and a capture, so eight of them are far past the
    # default budget of GrugTestRunner.DEFAULT_MAX_TEST_TICKS.
    ctx.set_max_ticks(4000)
}

export tick(ctx: TestTickContext) {
    if not built {
        _rebuild(ctx)
        built = true
        stalled = false
        captured = false
        ctx.not_done()
    } else if not stalled {
        # The tick after the rebuild is the one that sends its blocks, and the client has not drawn
        # a frame yet, so it still owes every one of them. Holding the server thread here lets the
        # client catch up on those blocks while the server cannot send anything newer, which is the
        # state a settle answer built on the client alone gets wrong: the light the rebuild asked
        # for is the server's to compute and send, and a client that has the blocks without the
        # light looks as idle as one that has both. See #686.
        Test.stall(250)
        stalled = true
        ctx.not_done()
    } else if not Test.world_settled() {
        # The capture below must read a room the client has the light for, which is what the settle
        # answer promises. See #686.
        ctx.not_done()
    } else if not captured {
        _check(ctx)
        captured = true
        rounds = rounds + 1
        ctx.not_done()
    } else if rounds < rounds_wanted {
        # Too small to hold the fixture, so the next build cannot find this room whole.
        Test.set_box_radius(3)
        built = false
        ctx.not_done()
    }
}

# Builds the room the fixture needs and puts the fixture in it, which is coverage_frame's setup:
# the same blocks at the same places, so the same rectangle captures the same scene.
local _rebuild(ctx: TestTickContext) {
    level: Level = Test.get_client_level()

    # Before the fixture goes in, so the room's clearing cannot take the fixture out again.
    Test.set_box_radius(6)

    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y()
    z: number = origin.z()

    level.place_block(x, y - 1.88, z + 4, "grug:coverage_frame")
    _wall(level, x - 6, y - 9, z + 6)

    be_opt: Option[BlockEntity] = level.get_block_entity(x, y - 1.88, z + 4)
    ctx.assert(be_opt.has(), "The frame-rendered block should have a block entity.")
    frame_block.set(be_opt.unwrap())
}

# Thirteen blocks square of minecraft:stone at (x0, y0, z), which covers the crop with room to
# spare.
local _wall(level: Level, x0: number, y0: number, z: number) {
    wy: number = y0
    while wy < y0 + 13 {
        wx: number = x0
        while wx < x0 + 13 {
            level.place_block(wx, wy, z, "minecraft:stone")
            wx = wx + 1
        }
        wy = wy + 1
    }
}

local _check(ctx: TestTickContext) {
    # The block entity is what the hook drew through, so a missing one would make the screenshot
    # below a picture of nothing that happens to match an empty reference.
    ctx.assert(frame_block.has(), "The frame-rendered block lost its block entity.")

    # coverage_frame's own crop and reference, so a room that arrived settled is byte-identical to
    # the golden that test already has.
    Test.screenshot().equals(r"screenshots/coverage_frame", 500, 180, 780, 340)
}
