# A capture taken as soon as the settle answer allows it has to show the settled room, not a room
# meshed from the light it had before the rebuild, and not the room before the rebuild at all.
# Every round rebuilds the room through Test.set_box_radius and captures through coverage_frame's
# rectangle and reference, so the reference is that test's own golden and this one adds none. See
# #686.
# The room is built at radius 6 and then at radius 3, which is too small to hold the fixture: the
# next build at 6 therefore rebuilds the room rather than finding it whole, and every round relights
# it. After the rebuild the test stalls the thread the runner runs on, so the client draws idle
# frames while the server cannot send the rebuild's light. A settle answer that says true after
# that has read a frame lit by the light from before the rebuild, and the capture differs.
frame_block: Option[BlockEntity] = Option.new()

# Whether the current round's room and fixture are built.
built: bool = false

# Whether the current round's stall has run.
stalled: bool = false

# Whether the current round's capture has been taken.
captured: bool = false

# How many rounds have been captured.
rounds: number = 0

# How many rounds one run takes.
rounds_wanted: number = 3

export init(ctx: TestInitContext) {
    # A round is a rebuild, a stall, a settle wait and a capture, so a few of them are past the
    # default budget of GrugTestRunner.DEFAULT_MAX_TEST_TICKS.
    ctx.set_max_ticks(2000)
}

export tick(ctx: TestTickContext) {
    if not built {
        _rebuild(ctx)
        built = true
        stalled = false
        captured = false
        ctx.not_done()
    } else if not captured {
        if not stalled {
            # The frames the stall draws are ones this test asked for, so the settle answer below
            # can only be about a frame drawn after the rebuild. See GrugFrameRequest.
            Test.world_settled()
            # The client keeps ticking and drawing while this holds the thread the runner is queued
            # on, and the server's light for the rebuild cannot be sent until it returns. See #686.
            Test.stall(800)
            stalled = true
        }
        if not Test.world_settled() {
            # The capture below must read a room the client has the light for, which is what the
            # settle answer promises. See #686.
            ctx.not_done()
        } else {
            _check(ctx)
            captured = true
            rounds = rounds + 1
            ctx.not_done()
        }
    } else if rounds < rounds_wanted {
        # Too small to hold the fixture, so the next build cannot find this room whole.
        Test.set_box_radius(3)
        built = false
        ctx.not_done()
    }
}

# Builds the room the fixture needs and puts the fixture in it, which is coverage_frame's setup:
# the same blocks at the same places, so the same rectangle captures the same scene.
local _rebuild(ctx: TestTickContext) {
    level: Level = Test.get_client_level()

    # Before the fixture goes in, so the room's clearing cannot take the fixture out again.
    Test.set_box_radius(6)

    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y()
    z: number = origin.z()

    level.place_block(x, y - 1.88, z + 4, "grug:coverage_frame")
    _wall(level, x - 6, y - 9, z + 6)

    be_opt: Option[BlockEntity] = level.get_block_entity(x, y - 1.88, z + 4)
    ctx.assert(be_opt.has(), "The frame-rendered block should have a block entity.")
    frame_block.set(be_opt.unwrap())

    # A different block and back, outside the crop, so the renderer rebuilds the sections the room
    # and the fixture changed whatever a loader's own place did. coverage_frame does the same. Both
    # blocks are opaque and unlit, so no compared pixel and no light changes.
    level.place_block(x - 6, y + 3, z + 6, "minecraft:dirt")
    level.place_block(x - 6, y + 3, z + 6, "minecraft:stone")
}

# Thirteen blocks square of minecraft:stone at (x0, y0, z), which covers the crop with room to
# spare.
local _wall(level: Level, x0: number, y0: number, z: number) {
    wy: number = y0
    while wy < y0 + 13 {
        wx: number = x0
        while wx < x0 + 13 {
            level.place_block(wx, wy, z, "minecraft:stone")
            wx = wx + 1
        }
        wy = wy + 1
    }
}

local _check(ctx: TestTickContext) {
    # The block entity is what the hook drew through, so a missing one would make the screenshot
    # below a picture of nothing that happens to match an empty reference.
    ctx.assert(frame_block.has(), "The frame-rendered block lost its block entity.")

    # coverage_frame's own crop and reference, so a room that arrived settled is byte-identical to
    # the golden that test already has.
    Test.screenshot().equals(r"screenshots/coverage_frame", 500, 180, 780, 340)
}
