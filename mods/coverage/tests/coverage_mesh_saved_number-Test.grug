# A saved number a script writes reaches the client's chunk mesh, on either side.
# A block whose geometry is in its chunk's mesh reads the saved numbers when the mesh is built, so
# the number only reaches a joined client when the client's copy holds it and the client builds the
# mesh again. The script asks for that with redraw(), and on a dedicated server the loader has to
# send the client both the data and the block update that rebuilds the mesh (#1101). The
# coverage_mesh_saved block draws a whole block always, and a second whole block on top once its
# "mesh_marker" number is above 0, so the assertion is that the client's frame changed after the
# save and the redraw, and changed back when the number was saved as 0 again.
# The captures are whole block faces several times the 1 percent of the crop compared, because a
# half-block face was under that on this crop and could not be told from the empty room.
# Four captures of one session are compared, so this holds on every loader and needs no golden: the
# settled room without the block, the room with the block drawn from its own render pass, the room
# after the number was saved as 1, and the room after it was saved as 0 again. Comparing the second
# against the first is what proves the client had the block and its render() before the number was
# saved, so the third differing from it is the saved number arriving rather than the block merely
# appearing, and the fourth returning to it is the plate itself going away rather than the block
# having drawn something else.
# The crop is the tall one coverage_frame_saved_number uses, with a wall behind the block, because a
# dedicated server builds the room from its own copy of the player, which can sit a block off the
# joined client's; the wall keeps drifting clouds out of the comparison.
# The block goes in only after the room's clearing and the wall have reached the joined client: the
# wall's writes queue for the end of the server tick, and a capture sent in that same tick freezes
# the server before the queue is flushed, so that capture can be of the room without the wall. Only
# two captures of the room that agree count as the first one, so a wall whose mesh arrives late is
# not what the block comparison sees. A client joined to a server is told only that a block changed,
# so it also keeps the block entity of the block that was there; a block placed on that tile
# inherits it, which the render path drops and inits from the block that is there
# (GrugStaleBlockEntity.shouldReinit). The tile keeps the previous test's saved numbers too, which is
# why this block uses a number name of its own: a number that is already saved cannot show that the
# save arrived.
# The frame with the block is taken from the chunk compile the placement itself asked for, and no
# retry calls redraw(): a retry that rebuilds the mesh would hide a placement whose own compile drew
# nothing, which is exactly what a kept tile looks like.
# It defines tick_any_side, so a dedicated server runs it too: the settle wait is forwarded to the
# joined client, and the captures are the client's (#1086). The waits end on the frame itself:
# Screenshot.change_from reports how much of it changed, so a client that is behind is captured
# again instead of being assumed to have caught up after a tick count.
mesh_block: Option[BlockEntity] = Option.new()
empty: Option[Screenshot] = Option.new()
empty_prev: Option[Screenshot] = Option.new()
before: Option[Screenshot] = Option.new()
after: Option[Screenshot] = Option.new()

# Whether the number has been saved as 1, and whether it has been saved as 0 again.
saved: bool = false
cleared: bool = false

# The runner tick the number was saved on, so the capture after it is not taken on the same tick.
saved_tick: number = 0
cleared_tick: number = 0

# How many captures have already shown the frame from before the change being waited for.
attempts: number = 0

export init(ctx: TestInitContext) {
    # A capture waits for the client to draw the frames it is about, which is up to about 60 ticks
    # each, and each of the four waits below may capture eight times beside the setup's own.
    ctx.set_max_ticks(2000)
}

export tick_any_side(ctx: TestTickContext) {
    if ctx.current_tick() == 0 {
        _wall(ctx)
        ctx.not_done()
    } else if not Test.world_settled() {
        ctx.not_done()
    } else if not empty.has() {
        _settle_empty(ctx)
        ctx.not_done()
    } else if not before.has() {
        _capture_before(ctx)
        ctx.not_done()
    } else if not saved {
        _save(1)
        saved = true
        saved_tick = ctx.current_tick()
        attempts = 0
        ctx.not_done()
    } else if not after.has() {
        _capture_after(ctx)
        ctx.not_done()
    } else if not cleared {
        _save(0)
        cleared = true
        cleared_tick = ctx.current_tick()
        attempts = 0
        ctx.not_done()
    } else if ctx.current_tick() < cleared_tick + 30 {
        # Nothing marks the world unsettled for a saved-number change or a redraw: a script saves
        # numbers as it runs, so a world that settled only between those would never settle. This
        # short wait keeps the captures from spinning; whether the rebuilt mesh arrived is decided
        # by the capture below.
        ctx.not_done()
    } else {
        restored: Screenshot = Test.screenshot().capture(500, 60, 780, 440)
        if restored.change_from(before.unwrap()) < 1 {
            ctx.assert(mesh_block.unwrap().get_saved_number("mesh_marker") == 0, "The number should be saved as 0.")
        } else {
            attempts = attempts + 1
            ctx.assert(attempts < 8, "Saving 0 did not take the plate away again.")
            cleared_tick = ctx.current_tick()
            ctx.not_done()
        }
    }
}

local _wall(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    Test.set_box_radius(6)
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y()
    z: number = origin.z()

    # A wall behind the block's spot, thirteen across and thirteen high, the size coverage_frame's
    # golden uses, which covers the whole crop. Without one the crop could hold sky, and clouds
    # drift between two captures.
    wy: number = y - 9
    while wy < y + 4 {
        wx: number = x - 6
        while wx < x + 7 {
            level.place_block(wx, wy, z + 6, "minecraft:stone")
            wx = wx + 1
        }
        wy = wy + 1
    }
}

# Waits until two captures of the room without the block agree, and then places the block.
local _settle_empty(ctx: TestTickContext) {
    shot: Screenshot = Test.screenshot().capture(500, 60, 780, 440)
    if empty_prev.has() and shot.change_from(empty_prev.unwrap()) < 1 {
        empty.set(shot)
        attempts = 0
        _place(ctx)
    } else {
        attempts = attempts + 1
        ctx.assert(attempts < 8, "The room never stopped changing before the block went in.")
        empty_prev.set(shot)
    }
}

local _capture_before(ctx: TestTickContext) {
    drawn: Screenshot = Test.screenshot().capture(500, 60, 780, 440)
    if drawn.change_from(empty.unwrap()) < 1 {
        attempts = attempts + 1
        ctx.assert(attempts < 8, "The client never drew the chunk-mesh block's pedestal.")
    } else {
        before.set(drawn)
        attempts = 0
    }
}

local _capture_after(ctx: TestTickContext) {
    if ctx.current_tick() >= saved_tick + 30 {
        shot: Screenshot = Test.screenshot().capture(500, 60, 780, 440)
        if shot.change_from(before.unwrap()) < 1 {
            attempts = attempts + 1
            ctx.assert(attempts < 8, "The saved number never rebuilt the client's chunk mesh.")
            saved_tick = ctx.current_tick()
        } else {
            after.set(shot)
            attempts = 0
        }
    }
}

local _save(value: number) {
    block: BlockEntity = mesh_block.unwrap()
    block.set_saved_number("mesh_marker", value)
    block.redraw()
}

local _place(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y()
    z: number = origin.z()

    # The same place coverage_frame_saved_number's block sits, with the same tall crop for a
    # dedicated server whose room is built from its own copy of the joined player.
    level.place_block(x, y - 1.88, z + 4, "grug:coverage_mesh_saved")

    be_opt: Option[BlockEntity] = level.get_block_entity(x, y - 1.88, z + 4)
    ctx.assert(be_opt.has(), "The chunk-mesh block should have a block entity.")
    mesh_block.set(be_opt.unwrap())
}
