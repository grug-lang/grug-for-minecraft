# A LiquidResponse answered twice with different answers is an err, because the export has two paths
# that both think they decide.
export tick(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    origin: Vec3 = ctx.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_response_block")
    be: BlockEntity = level.get_block_entity(x, y, z).unwrap()
    be.set_saved_number("liquid_mode", 2)

    ctx.expect_error("has already been answered")
    be.offer_liquid("minecraft:water", 1000, 0, true)
}
