# An exact port, one whose about.json lists no deviations, promises to reproduce its reference pixel
# for pixel, so its tests must not allow a tolerance. The coverage mod is not a port, so forcing the
# rule is what puts it under the rule it does not declare for itself.
export run() {
    if Test.tick() == 0 {
        Test.force_exact_port()
        Test.expect_error("is an exact port")
        Test.screenshot().tolerance(1).equals(r"screenshots/dummy", 590, 310, 690, 410)
    }
}
