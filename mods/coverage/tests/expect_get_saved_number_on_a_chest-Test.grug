# get_saved_number reads a saved number, which only a grug block entity keeps, so asking a vanilla
# chest must report an error rather than answer for it.
export run() {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "minecraft:chest")
    chest_opt: Option[BlockEntity] = level.get_block_entity(x, y, z)
    Test.assert(chest_opt.has(), "The chest should have a block entity.")
    chest: BlockEntity = chest_opt.unwrap()

    me.expect_error("Only a grug block entity saves numbers")
    energy: number = chest.get_saved_number("energy")
}
