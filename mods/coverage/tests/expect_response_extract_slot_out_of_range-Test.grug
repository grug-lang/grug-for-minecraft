# A block entity that names a slot its inventory does not have is an err, not a read past the end.
export run() {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_response_block")
    be: BlockEntity = level.get_block_entity(x, y, z).unwrap()
    diamond: Item = item(resource_location("minecraft:diamond"))
    be.set_saved_number("extract_mode", 1)
    be.set_saved_number("slot", 7)
    be.set_saved_number("amount", 1)
    me.expect_error("named slot 7")
    be.ask_extract_item(0)
}
