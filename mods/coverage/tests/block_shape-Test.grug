# Covers a block's shape export and the host functions that ask the game for a block's boxes: its
# collision boxes, its selection box, and the ray trace a player's click takes. The fixture's boxes
# are in coverage_shape-Block.grug, chosen by the mode its block entity saved.
# Asking the game rather than the script is the point: the answer comes from the same code a player
# colliding with or clicking the block goes through, so a loader whose adapter ignores the shape
# fails here.
# The selection box is the joined client's outline, and a saved number reaches that client's copy
# of the block only through a redraw, which a shape-only block has no other reason to ask for. Each
# mode is saved with a redraw, and the test waits until the client's copy holds the mode before it
# asks: a client without it would answer for the mode the block entity was made with.
shape_block: Option[BlockEntity] = Option.new()
placed: bool = false
phase: number = 0
wanted: number = 0
poll_tick: number = 0
misses: number = 0

export init(ctx: TestInitContext) {
    # Each of the three modes waits a few ticks for the client's copy, and the last placement waits
    # for the client to hold the block.
    ctx.set_max_ticks(600)
}

export tick(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    origin: Vec3 = ctx.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    if not placed {
        level.place_block(x, y, z, "grug:coverage_shape")
        shape_block.set(level.get_block_entity(x, y, z).unwrap())
        placed = true
        ctx.not_done()
        return
    }
    if not ctx.world_settled() {
        # The placement is queued until the test's tick ends, which this ask flushes, so the client
        # holds the block only once it has drawn a frame from it.
        ctx.not_done()
        return
    }

    # Mode 0: the block declares no selection box, so the game targets what it collides with.
    if phase == 0 {
        _save_mode(ctx, 0, 1)
        ctx.assert(ctx.block_collision(level, x, y, z, 0.3, 0.3, 0.3, 0.5, 0.5, 0.5), "The centre should collide.")
        ctx.assert(not ctx.block_collision(level, x, y, z, 0.0, 0.0, 0.0, 0.1, 0.1, 0.1), "The corner should be empty.")
        ctx.assert(ctx.block_ray_trace(level, x, y, z, 0.5, 0.01, 0.5, 0.5, 0.99, 0.5), "A ray through the centre should hit the block.")
        ctx.assert(not ctx.block_ray_trace(level, x, y, z, 0.05, 0.01, 0.05, 0.05, 0.99, 0.05), "A ray through the empty corner should miss the block.")
        phase = 1
        ctx.not_done()
        return
    }

    # Mode 1: a selection box of its own, larger than the collision box.
    if phase == 1 {
        if not _mode_reached(ctx) {
            ctx.not_done()
            return
        }
        ctx.assert(ctx.block_selection(level, x, y, z, 0.5, 0.5, 0.5), "The selection should be the collision boxes when none was declared.")
        ctx.assert(not ctx.block_selection(level, x, y, z, 0.1, 0.1, 0.1), "The selection should not reach the empty corner.")
        _save_mode(ctx, 1, 2)
        ctx.assert(not ctx.block_collision(level, x, y, z, 0.0, 0.0, 0.0, 0.1, 0.1, 0.1), "The corner should still be empty.")
        ctx.assert(ctx.block_ray_trace(level, x, y, z, 0.05, 0.5, -0.2, 0.05, 0.5, 0.5), "A ray from the block beside it should enter the declared selection box, which now fills this one.")
        phase = 2
        ctx.not_done()
        return
    }

    # Mode 3: a selection box and no collision box, so nothing collides and the block is clickable.
    if phase == 2 {
        if not _mode_reached(ctx) {
            ctx.not_done()
            return
        }
        ctx.assert(ctx.block_selection(level, x, y, z, 0.1, 0.1, 0.1), "The declared selection box should reach the corner.")
        _save_mode(ctx, 3, 3)
        ctx.assert(not ctx.block_collision(level, x, y, z, 0.3, 0.3, 0.3, 0.5, 0.5, 0.5), "A block with no collision box should not collide.")
        phase = 3
        ctx.not_done()
        return
    }

    if phase == 3 {
        if not _mode_reached(ctx) {
            ctx.not_done()
            return
        }
        ctx.assert(ctx.block_selection(level, x, y, z, 0.5, 0.5, 0.5), "A block with no collision box should still be selected.")
        ctx.assert(not ctx.block_selection(level, x, y, z, 0.1, 0.1, 0.1), "The selection should be the declared box.")
        ctx.assert(ctx.block_ray_trace(level, x, y, z, 0.5, 0.01, 0.5, 0.5, 0.99, 0.5), "A block with no collision box should still be hit where it is selected.")
        ctx.assert(not ctx.block_ray_trace(level, x, y, z, 0.05, 0.01, 0.05, 0.05, 0.99, 0.05), "A ray outside the declared selection box should miss it.")
        # A block that never called set_shape keeps the game's full cube.
        level.place_block(x + 2, y, z, "grug:coverage_block")
        phase = 4
        ctx.not_done()
        return
    }

    # The settle check above has waited for the client to hold the block it put down.
    if phase == 4 {
        ctx.assert(ctx.block_collision(level, x + 2, y, z, 0.0, 0.0, 0.0, 0.1, 0.1, 0.1), "A block without a shape should collide in its corner.")
        ctx.assert(ctx.block_selection(level, x + 2, y, z, 0.1, 0.1, 0.1), "A block without a shape should be selected in its corner.")
        ctx.assert(ctx.block_ray_trace(level, x + 2, y, z, 0.05, 0.5, -0.2, 0.05, 0.5, 0.5), "A block without a shape should be hit on its face.")
        phase = 5
    }
}

# Saves a mode and asks for the block's mesh again, which is also what sends the mode to a joined
# client's copy: a saved change alone is sent only for a block that draws its own geometry, and this
# block draws none.
local _save_mode(ctx: TestTickContext, mode: number, marker: number) {
    shape_block.unwrap().set_saved_number("mode", mode)
    shape_block.unwrap().set_saved_number("shape_probe", marker)
    shape_block.unwrap().redraw()
    wanted = marker
    # Five ticks is a quarter of a second on a client's clock: more than a redraw sent at once needs,
    # and the first tick after the server's own flush for a loader that holds it until then.
    poll_tick = ctx.current_tick() + 5
}

# Whether the joined client's own copy holds the marker this test saved with the mode, which is the
# one read that says the mode arrived: a redraw is server to client only, so a dedicated server that
# asked too early would answer for the mode the block entity was made with.
local _mode_reached(ctx: TestTickContext) bool {
    if ctx.current_tick() < poll_tick {
        return false
    }
    if ctx.client_saved_number(shape_block.unwrap(), "shape_probe") == wanted {
        return true
    }
    misses = misses + 1
    ctx.assert(misses < 60, "The mode should have reached the joined client's copy before it is asked.")
    poll_tick = ctx.current_tick() + 5
    return false
}
