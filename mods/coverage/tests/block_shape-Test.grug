# Covers a block's shape export and the two host functions that ask the game for a block's boxes.
# The fixture's boxes are in coverage_shape-Block.grug, chosen by the mode its block entity saved.
# Asking the game rather than the script is the point: the answer comes from the same code a player
# colliding with or clicking the block goes through, so a loader whose adapter ignores the shape
# fails here.
export tick(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_shape")
    be: BlockEntity = level.get_block_entity(x, y, z).unwrap()

    # Mode 0: the block declares no selection box, so the game targets what it collides with.
    be.set_saved_number("mode", 0)
    ctx.assert(Test.block_collision(level, x, y, z, 0.3, 0.3, 0.3, 0.5, 0.5, 0.5), "The centre should collide.")
    ctx.assert(not Test.block_collision(level, x, y, z, 0.0, 0.0, 0.0, 0.1, 0.1, 0.1), "The corner should be empty.")
    ctx.assert(Test.block_selection(level, x, y, z, 0.5, 0.5, 0.5), "The selection should be the collision boxes when none was declared.")
    ctx.assert(not Test.block_selection(level, x, y, z, 0.1, 0.1, 0.1), "The selection should not reach the empty corner.")

    # Mode 1: a selection box of its own, larger than the collision box.
    be.set_saved_number("mode", 1)
    ctx.assert(not Test.block_collision(level, x, y, z, 0.0, 0.0, 0.0, 0.1, 0.1, 0.1), "The corner should still be empty.")
    ctx.assert(Test.block_selection(level, x, y, z, 0.1, 0.1, 0.1), "The declared selection box should reach the corner.")

    # Mode 3: a selection box and no collision box, so nothing collides and the block is clickable.
    be.set_saved_number("mode", 3)
    ctx.assert(not Test.block_collision(level, x, y, z, 0.3, 0.3, 0.3, 0.5, 0.5, 0.5), "A block with no collision box should not collide.")
    ctx.assert(Test.block_selection(level, x, y, z, 0.5, 0.5, 0.5), "A block with no collision box should still be selected.")
    ctx.assert(not Test.block_selection(level, x, y, z, 0.1, 0.1, 0.1), "The selection should be the declared box.")

    # A block that never called set_shape keeps the game's full cube.
    level.place_block(x + 2, y, z, "grug:coverage_block")
    ctx.assert(Test.block_collision(level, x + 2, y, z, 0.0, 0.0, 0.0, 0.1, 0.1, 0.1), "A block without a shape should collide in its corner.")
    ctx.assert(Test.block_selection(level, x + 2, y, z, 0.1, 0.1, 0.1), "A block without a shape should be selected in its corner.")
}
