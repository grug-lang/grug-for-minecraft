# explode destroys the blocks around it and leaves the ones out of its reach. Glass is used because
# it is weak enough for a power 3 explosion to break and drops no item entity, so nothing is left in
# the test area for the next test. The explosion is at the middle of the air block between the two
# near panes; the far pane is twelve blocks away, well outside a power 3 explosion's reach of about
# five blocks.
export run() {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    pos: BlockPos = BlockPos.new(x + 1, y, z)
    level.place_block(pos, "minecraft:glass")
    pos2: BlockPos = BlockPos.new(x - 1, y, z)
    level.place_block(pos2, "minecraft:glass")
    pos3: BlockPos = BlockPos.new(x + 12, y, z)
    level.place_block(pos3, "minecraft:glass")

    level.explode(x + 0.5, y + 0.5, z + 0.5, 3)

    Test.assert(level.is_air(pos), "The glass next to the explosion should be destroyed.")
    Test.assert(level.is_air(pos2), "The glass on the other side should be destroyed.")
    Test.assert(not level.is_air(pos3), "The glass out of reach should survive.")

    level.place_block(pos3, "minecraft:air")
}
