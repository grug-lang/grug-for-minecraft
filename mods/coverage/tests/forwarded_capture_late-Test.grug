# A forwarded capture the client answers only after the server gave up is a timeout like a dropped
# one. The client holds the answer to a request whose rectangle is 9 wide (GRUG_CI_CONTROL_LATE_WIDTH)
# until it handles the next request, so the stale answer is sent while the next test's request
# waits, which that test proves harmless.
export tick(ctx: TestTickContext) {
    if ctx.current_tick() == 0 {
        ctx.expect_error("did not answer request")
        Test.screenshot().capture(10, 10, 19, 19)
    }
}
