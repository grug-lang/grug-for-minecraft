# Test.light_applied answers whether the client's copy of the world holds the block light of the
# section a position falls in that the world the test edits has, which is the light its frame pass
# draws that section with (#1207). The room's torches light it before the first tick, so the read
# is true once their light has reached the client's copy; a torch the test puts beside the read
# raises that section's light, and the read is true again only once the change has reached the
# client too. The read is the one a capture wait needs: two frames of a room drawn from the light
# it had before a change agree with each other, so a frame count cannot tell that room from a
# settled one.
# The wait's own answer is the proof, and the test does not read the room again after it: the
# world's light engine can take on work between two ticks, such as the propagation of the torch's
# light into a neighbouring section, so a second read can be false while the room's section still
# matches and would only race the engine.
# The world and the client are compared as a fingerprint of the whole section, not one position's
# light: on a client-only run a test reads the client's copy from the server thread, and a position
# read goes through a store the client thread does not publish, so it can report the light from
# before a change for as long as the test waits. 1.20.6 uses the section's published bytes and the
# four older loaders read their light query's level for each of the section's 4096 blocks.
# It also asks for a lit section two thousand blocks away, which the client's two-chunk view never
# receives. The world has a glowstone's light there and the client's copy has none, so the answer
# is false: a client stand-in that always answers true cannot pass this test. The glowstone goes in
# with the torch, before the room's last light wait, so that wait also waits for the far section's
# light work, and the far ask is made in the same tick the wait found the engine settled: the false
# is then the two sections' difference and not the engine still having work.
# That far section is asserted only where the client's copy is a second one: on a dedicated leg, and
# on a client-only 1.20.6 run. A client-only run of the four older loaders shares one world, so its
# far ask is true by construction, and Test.on_dedicated_server is what tells the two apart. Those
# loaders' dedicated legs compare their joined client's section with the server's now, and 1.2.5's
# room is the one cannot-verify case its adapter records (#1240).
# It defines tick_any_side, so a dedicated server runs it too: the wait is forwarded to the joined
# client, which is the copy the frames are drawn from.
state: number = 0
waited: number = 0
x: number = 0
y: number = 0
z: number = 0

# Whether the client's copy of the world is a second one, which is where the far section can lack
# the world's light: every dedicated leg, and a client-only 1.20.6 run, whose client receives its
# world from its own integrated server. A client-only run of the four older loaders shares one
# world, so the far section holds the same light there and there is nothing to assert.
second_copy: bool = false

export init(ctx: TestInitContext) {
    # The room's own settle can take most of a test's budget on a slow client, and then the torch's
    # light has its own deadline, so the budget is the mesh test's rather than the default.
    ctx.set_max_ticks(2000)
    second_copy = Test.on_dedicated_server() or Test.loader_name() == "1.20.6-forge"
}

export tick_any_side(ctx: TestTickContext) {
    if state == 0 {
        # The read is inside the room the runner builds, so its light is the room's and not the
        # sky's. The radius is set once, before anything waits, so the waits are not about a room
        # that is rebuilt every tick.
        Test.set_box_radius(6)
        origin: Vec3 = Test.get_origin()
        x = origin.x()
        y = origin.y() - 1
        z = origin.z()
        state = 1
        ctx.not_done()
    } else if state == 1 {
        # The room build's own light is the settle's job, and on a slow client it can take longer
        # than the light wait's deadline: this waits for the same settle a capture would, and only
        # then asks whether the read's section holds the room's light.
        if Test.world_settled() {
            if _light_settled(ctx) {
                level: Level = Test.get_client_level()
                level.place_block(x, y, z, "minecraft:stone")
                level.place_block(x, y + 1, z, "minecraft:torch")
                # Only where a second copy exists: the world's light for this section is what the
                # read compares, and a client-only run of an older loader would have to generate
                # it for nothing.
                if second_copy {
                    level.place_block(x + 2000, y, z, "minecraft:glowstone")
                }
                state = 2
            }
        }
        ctx.not_done()
    } else if state == 2 {
        if _light_settled(ctx) {
            # The wait returning true is the room's proof: it only does so while the engine is
            # settled, and reading the room again on a later tick would race the work the engine
            # takes on in the meantime. The far section is asked here, in the tick the wait found
            # the engine settled, so a constant-true answer fails this and a constant-false one
            # already failed the wait's deadline.
            if second_copy {
                ctx.assert(not Test.light_applied(x + 2000, y, z), "A section the client was never sent cannot hold the world's light.")
            }
        } else {
            ctx.not_done()
        }
    }
}

# Whether the client's copy holds the world's light at the read, with its own deadline so a client
# that never takes the light fails with this message rather than with the tick budget.
local _light_settled(ctx: TestTickContext) bool {
    if Test.light_applied(x + 1, y + 1, z) {
        waited = 0
        return true
    }
    waited = waited + 1
    ctx.assert(waited < 400, "The client never took the room's light before the wait's deadline.")
    return false
}
