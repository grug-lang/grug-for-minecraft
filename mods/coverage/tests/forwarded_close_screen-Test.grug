# Test.close_screen and the screen measurements asked of a dedicated server's joined client (#1094).
# On 1.20.6, the only leg whose server can open a GUI for its player, this opens coverage_gui, waits
# for the client's own screen, reads the panel's geometry through the forwarded gui_* calls, and
# closes it. On the other four legs it proves that close_screen returns from the client and leaves
# no screen open; their servers keep refusing GUI.open until #1098 gives them a server-side
# container, so there is no panel to measure there. Only a multiplayer run that forwards client
# calls runs a forwarded_ test.
started: bool = false

export tick(ctx: TestTickContext) {
    loader: string = Test.loader_name()
    if not started {
        started = true
        Test.close_screen()
        ctx.assert(not Test.screen_open(), "Test.close_screen should leave the client's screen closed.")
        if loader != "1.20.6-forge" {
            return
        }
        level: Level = Test.get_client_level()
        origin: Vec3 = Test.get_origin()
        level.place_block(origin.x(), origin.y(), origin.z(), "grug:coverage_gui")
        Test.use_block(level, origin.x(), origin.y(), origin.z())
        ctx.not_done()
        return
    }
    if not Test.screen_open() {
        ctx.not_done()
        return
    }
    ctx.assert(Test.gui_width() == 176, "The client's coverage_gui panel is 176 pixels wide.")
    ctx.assert(Test.gui_height() == 166, "The client's coverage_gui panel is 166 pixels high.")
    ctx.assert(Test.gui_left() > 0, "The client's panel is centred, so its left edge is inside the screen.")
    ctx.assert(Test.gui_top() > 0, "The client's panel is centred, so its top edge is inside the screen.")
    ctx.assert(Test.screen_width() > Test.gui_width(), "The client's window is wider than the panel.")
    Test.close_screen()
    ctx.assert(not Test.screen_open(), "Test.close_screen should leave the client's screen closed.")
}
