# Closing the top screen brings the screen below it back: its host is shown again, which asks its
# screen_init again, and the value the player left on it is still there because the mod declares the
# widget from the state it kept. The overlay records every init in `screen_stack/init.txt` and the
# checkbox state it declared in `screen_stack/tick.txt`, and the screen that closed must hear
# nothing: a close the mod asked for is not the reference's onScreenClosed, so
# `screen_stack/closed.txt` stays empty (#1752).
# A loader without a screen host answers an err to Screen.open, so the test returns early there, and
# it ends early on the dedicated server, whose joined client owns the screen.
started: bool = false
step: number = 0
waited: number = 0
inits: number = 0

export init(ctx: TestInitContext) {
    ctx.set_max_ticks(2000)
}

export tick(ctx: TestTickContext) {
    if not started {
        started = true
        if not me.owned_screens_supported() or not me.world_overlay_supported() or me.on_dedicated_server() {
            return
        }
        ctx.not_done()
        return
    }

    if step == 0 {
        if not ctx.world_settled() {
            waited = waited + 1
            ctx.assert(waited < 1000, "The world should settle before the screen opens.")
            ctx.not_done()
            return
        }
        waited = 0
        if ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "No screen should be open before the test opens its own.")
            ctx.not_done()
            return
        }
        # Z clears the stack markers and the counters, so the files this test reads are its own.
        ctx.press_world_key(90, false)
        # H is the overlay's open key.
        ctx.press_world_key(72, false)
        step = 1
        waited = 0
        ctx.not_done()
        return
    }

    if step == 1 {
        if not ctx.screen_open() {
            waited = waited + 1
            ctx.assert(waited < 200, "H should open the coverage screen.")
            ctx.not_done()
            return
        }
        files: File = File.open(r"files")
        if files.read_text("screen_stack/frame.txt").unwrap() != "screen" {
            waited = waited + 1
            ctx.assert(waited < 200, "The first screen should draw a frame before it is ticked.")
            ctx.not_done()
            return
        }
        # The checkbox is at (10, 40) and 70 wide by 20 high, so this press ticks it, and the mod
        # keeps the value for the init that brings the screen back.
        ctx.click_screen(20, 50, 0)
        step = 2
        waited = 0
        ctx.not_done()
        return
    }

    if step == 2 {
        files: File = File.open(r"files")
        if files.read_text("screen_stack/tick.txt").unwrap() != "true" {
            waited = waited + 1
            ctx.assert(waited < 200, "The press on the checkbox should tick it.")
            ctx.not_done()
            return
        }
        # The count the first init left, so the re-init after the close is told apart from it.
        init_text: string = files.read_text("screen_stack/init.txt").unwrap()
        inits = String.to_number(String.substring(init_text, 0, String.index_of(init_text, ":"))).unwrap()
        # B arms the open_over its next click asks for.
        took: bool = ctx.press_screen_key(66, false, false, true)
        ctx.assert(took, "B should reach screen_key, which arms the open_over.")
        step = 3
        waited = 0
        ctx.not_done()
        return
    }

    if step == 3 {
        ctx.click_screen(200, 60, 0)
        step = 4
        waited = 0
        ctx.not_done()
        return
    }

    if step == 4 {
        files: File = File.open(r"files")
        if files.read_text("screen_stack/frame.txt").unwrap() != "other" {
            waited = waited + 1
            ctx.assert(waited < 200, "The screen opened over the first should draw a frame of its own.")
            ctx.not_done()
            return
        }
        # N arms the close of the top screen its next click asks for.
        took: bool = ctx.press_screen_key(78, false, false, true)
        ctx.assert(took, "N should reach screen_key, which arms the close.")
        step = 5
        waited = 0
        ctx.not_done()
        return
    }

    if step == 5 {
        ctx.click_screen(200, 60, 0)
        step = 6
        waited = 0
        ctx.not_done()
        return
    }

    if step == 6 {
        files: File = File.open(r"files")
        init_text: string = files.read_text("screen_stack/init.txt").unwrap()
        if String.index_of(init_text, ":screen") < 0 {
            waited = waited + 1
            ctx.assert(waited < 200, "Closing the top screen should initialise the screen below it again.")
            ctx.not_done()
            return
        }
        count: number = String.to_number(String.substring(init_text, 0, String.index_of(init_text, ":"))).unwrap()
        ctx.assert(count == inits + 2, "The first screen's re-init should come after the other screen's init.")
        ctx.assert(files.read_text("screen_stack/tick.txt").unwrap() == "true", "The screen brought back should declare the checkbox the player left ticked.")
        ctx.assert(files.read_text("screen_stack/closed.txt").unwrap() == "", "A close the mod asked for must not reach screen_closed.")
        # The count of the first screen's frames when `other` covered it, and the count just before
        # `other` closed: equal means the covered screen drew nothing the whole time it was below.
        covered: string = files.read_text("screen_stack/covered.txt").unwrap()
        ctx.assert(covered == files.read_text("screen_stack/counts.txt").unwrap(), "The screen below should draw no frame while the other screen is over it.")
        ctx.assert(String.to_number(covered).unwrap() > 0, "The first screen should have drawn before it was covered.")
        # The screen brought back takes input again: its own button is under this point.
        files.write_text("screen_stack/widget.txt", "")
        step = 7
        waited = 0
        ctx.not_done()
        return
    }

    if step == 7 {
        ctx.click_screen(40, 20, 0)
        step = 8
        waited = 0
        ctx.not_done()
        return
    }

    files: File = File.open(r"files")
    if files.read_text("screen_stack/widget.txt").unwrap() != "screen" {
        waited = waited + 1
        ctx.assert(waited < 200, "The screen brought back should take a press on its own button.")
        ctx.not_done()
        return
    }
    ctx.close_screen()
    ctx.assert(not ctx.screen_open(), "The test's own close should leave no screen open.")
}
