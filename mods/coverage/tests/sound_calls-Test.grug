# Covers the six sound calls and TestTickContext.last_sound (#1347). The host stages a few of
# vanilla 1.2.5's recordings as empty files, so a stream gets a token, and reads back the command the
# mod handed it: which call, which path, which gain, which pitch, which fade, whether it loops.
export tick(ctx: TestTickContext) {
    ctx.assert(not ctx.last_sound().has(), "A test that asked for no sound should read no command.")
    gain: Option[number] = start_stream("resources/newsound/ambient/weather/rain1.ogg", 0.5, 1.5, 250, true)
    ctx.assert(gain.has() and gain.unwrap() >= 1, "A recording the game directory holds should name the stream with a token.")
    token: number = gain.unwrap()
    start: SoundCommand = ctx.last_sound().unwrap()
    ctx.assert(start.command() == "start", "The first command should be a start.")
    ctx.assert(start.path() == "resources/newsound/ambient/weather/rain1.ogg", "The command should name the path the mod passed.")
    ctx.assert(start.volume() == 0.5, "The command should carry the gain.")
    ctx.assert(start.pitch() == 1.5, "The command should carry the pitch.")
    ctx.assert(start.fade_ms() == 250, "The command should carry the fade in milliseconds.")
    ctx.assert(start.looping(), "The command should say that the stream loops.")
    ctx.assert(start.token() == token, "The start should name the token it answered.")
    ctx.assert(start.seq() >= 1, "Commands should be numbered from 1 up.")
    first_seq: number = start.seq()
    pause_stream(token)
    pause: SoundCommand = ctx.last_sound().unwrap()
    ctx.assert(pause.command() == "pause" and pause.token() == token, "A pause should name the token.")
    ctx.assert(pause.path() == "" and pause.fade_ms() == 0 and not pause.looping(), "A pause should carry no path, fade or looping flag.")
    ctx.assert(pause.seq() > first_seq, "Each command should take the next number.")
    resume_stream(token)
    ctx.assert(ctx.last_sound().unwrap().command() == "resume", "A resume should be the next command.")
    stop_stream(token, 0)
    stop: SoundCommand = ctx.last_sound().unwrap()
    ctx.assert(stop.command() == "stop" and stop.token() == token and stop.fade_ms() == 0, "A stop should name the token and its fade.")
    play_sound_file("resources/newsound/random/glass1.ogg", 2.5, 0.25)
    play: SoundCommand = ctx.last_sound().unwrap()
    ctx.assert(play.command() == "play", "A 2D one-shot should be a play.")
    ctx.assert(play.volume() == 2.5, "A one-shot may ask for a gain above 1.")
    ctx.assert(play.pitch() == 0.25, "A one-shot takes the pitch it was given.")
    ctx.assert(play.token() == 0 and play.x() == 0 and play.y() == 0 and play.z() == 0, "A 2D one-shot should name no token and no position.")
    play_sound_at("resources/newsound/random/glass2.ogg", 1, 1, 4.5, 70.5, -3.5)
    at: SoundCommand = ctx.last_sound().unwrap()
    ctx.assert(at.command() == "play_at", "A positional one-shot should be a play_at.")
    ctx.assert(at.x() == 4.5 and at.y() == 70.5 and at.z() == -3.5, "A positional one-shot should carry its position.")
    ctx.assert(not start_stream("resources/newsound/not_staged.ogg", 1, 1, 0, false).has(), "A path the game directory does not hold should answer no token.")
}
