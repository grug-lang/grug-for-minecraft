# The light a region packet leaves stale (#1740). A Beta server sends a chunk's whole column when a
# client first receives it, and a region packet once ten blocks of one chunk changed: the packet
# carries that box's blocks, metadata and both light fields, and the client recomputes the chunk's
# height map from the blocks without recomputing the light of the cells that recompute darkened.
# The ten blocks go in one column twenty blocks above the player, on top of the room's roof, so the
# column's height rises from the roof to the top of that tower. The cell just above the roof then
# falls from open sky to under the tower: this server relights it to the 14 its neighbours give it,
# while the client keeps the stored 15 and no later packet covers that cell. Re-sending the region
# does not repair it either, which is what made the defect look like a packet that never arrived.
# Ten blocks rather than one is on purpose: this version's chunk map sends a region packet for
# exactly ten changed blocks of a chunk and per-block updates for fewer, and a per-block update
# recomputes the cell itself, so a single block would never reach the packet path this test is for.
# The cell above the roof is the read: it is outside the room's own settle, which stops at the roof,
# so it is the one the packet has to repair, and it is in the section the read compares. The wait
# before the tower goes up proves the client and the server already agree there, so an answer that
# is false afterwards is the packet's own stale band and not an older difference.
# The room's default radius is used on purpose: a bigger room puts its ceiling above the read, and a
# cell inside the room changes no light when a column above the ceiling gets taller.
state: number = 0
waited: number = 0
placed: number = 0
x: number = 0
y: number = 0
z: number = 0

export init(ctx: TestInitContext) {
    # The room's settle, the light wait before the tower, and the light wait after the packet.
    ctx.set_max_ticks(2000)
}

export tick(ctx: TestTickContext) {
    if state == 0 {
        origin: Vec3 = ctx.get_origin()
        x = origin.x()
        y = origin.y()
        z = origin.z()
        state = 1
        ctx.not_done()
    } else if state == 1 {
        if ctx.world_settled() {
            if _light_settled(ctx) {
                state = 2
            }
        }
        ctx.not_done()
    } else if state == 2 {
        # Ten blocks in the read's own column, one tick, so the chunk map sends one region packet
        # for them: nothing else stands above the roof there, so the column's height goes from the
        # roof to the top of the tower.
        level: Level = ctx.get_client_level()
        while placed < 10 {
            placed = placed + 1
            level.place_block(x, y + 19 + placed, z, "minecraft:stone")
        }
        state = 3
        ctx.not_done()
    } else if state == 3 {
        # The settle wait flushes the packet the placements owe and waits for the client to hold
        # the blocks; the light wait then compares the joined client's section with this server's,
        # naming the first cell that differs.
        if ctx.world_settled() {
            if _light_settled(ctx) {
                state = 4
            }
        }
        ctx.not_done()
    }
}

# Whether the client's copy holds this server's light at the read, with its own deadline so a client
# that never settles fails with this message rather than with the tick budget.
local _light_settled(ctx: TestTickContext) bool {
    if ctx.light_applied(x, y + 8, z) {
        waited = 0
        return true
    }
    waited = waited + 1
    ctx.assert(waited < 400, "The client never took the light above the roof.")
    return false
}
