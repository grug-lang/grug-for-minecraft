# An energy inbox belongs to a grug block entity, so handing energy to a vanilla chest is reported
# rather than lost without a word.
export tick(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    origin: Vec3 = ctx.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "minecraft:chest")
    be: BlockEntity = level.get_block_entity(x, y, z).unwrap()
    ctx.expect_error("a grug block entity has an energy inbox")
    be.receive_energy_on(0, 1)
}
