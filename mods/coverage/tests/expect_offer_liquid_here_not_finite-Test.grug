# An amount an offer_liquid_here walks up the store has to be finite, and the host refuses it before
# the export is asked, with the entry's own name in the report so a script can tell which walk it was.
export tick(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    origin: Vec3 = ctx.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_response_block")
    be: BlockEntity = level.get_block_entity(x, y, z).unwrap()

    nan: number = Math.sqrt(-1)
    ctx.expect_error("BlockEntity.offer_liquid_here: The amount has to be a finite number")
    taken: number = be.offer_liquid_here("minecraft:water", nan, 0, true)

    infinity: number = Math.cosh(1000)
    ctx.expect_error("BlockEntity.offer_liquid_here: The amount has to be a finite number")
    taken_again: number = be.offer_liquid_here("minecraft:water", infinity, 0, true)
}
