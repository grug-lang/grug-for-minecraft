# extract_item_into has to refuse a destination that has no such slot before it asks the source,
# because the source gives the stack up first and the write would then land nowhere. A zero-slot
# destination is what a pipe saved while it had no slot keeps, and the pipe's machine branch takes
# this path, so the stack would exist in neither (#1205).
# The error names the destination, which is the host's own refusal. Without it, the take runs and
# the destination's own slot write reports the slot instead, so this test fails either way that path
# is broken.
export tick_any_side(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_response_block")
    level.place_block(x + 1, y, z, "grug:coverage_init_block")
    source_opt: Option[BlockEntity] = level.get_block_entity(x, y, z)
    destination_opt: Option[BlockEntity] = level.get_block_entity(x + 1, y, z)
    ctx.assert(source_opt.has(), "The source block should have a block entity.")
    ctx.assert(destination_opt.has(), "The destination block should have a block entity.")
    source: BlockEntity = source_opt.unwrap()
    destination: BlockEntity = destination_opt.unwrap()

    # The source offers four of the ten diamonds in slot 1, so a take that ran would cost it four.
    diamond: Item = item(resource_location("minecraft:diamond"))
    source.set_item_in_slot(1, diamond, 10)
    source.set_saved_number("extract_mode", 1)
    source.set_saved_number("slot", 1)
    source.set_saved_number("amount", 4)

    # Load the destination with no inventory slots, as a block entity saved while it had none
    # does. The load replaces the tile, so the handle names the old one afterwards.
    Test.set_nbt_number(destination, "GrugInvSize", "int", 0)
    Test.load_nbt(destination)
    again_opt: Option[BlockEntity] = level.get_block_entity(x + 1, y, z)
    ctx.assert(again_opt.has(), "The reloaded destination should have a block entity.")
    ctx.assert(again_opt.unwrap().get_inventory_size() == 0, "A destination loaded with no slot should have no inventory.")

    ctx.expect_error("of the destination")
    source.extract_item_into(again_opt.unwrap(), 0, 3)
}
