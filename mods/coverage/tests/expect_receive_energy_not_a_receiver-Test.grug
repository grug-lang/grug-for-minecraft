# receive_energy needs a receiver, so sending to a vanilla chest is reported rather than lost without a word.
export run() {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    pos: BlockPos = BlockPos.new(x, y, z)
    level.place_block(pos, "minecraft:chest")
    be: BlockEntity = level.get_block_entity(pos).unwrap()
    me.expect_error("is not an energy receiver")
    be.receive_energy(1)
}
