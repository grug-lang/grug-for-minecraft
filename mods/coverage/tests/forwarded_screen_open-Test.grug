# Test.screen_open asked of a dedicated server's joined client (#1094). The first two lines are
# what makes this a regression test: a server used to answer from its own container menu (1.20.6)
# or with false (the other four), and a measurement refused without a client, so the forwarded
# gui_width read below raised a host function error before this change. The open answer is asked on
# every server that can open a GUI for their player, 1.20.6, 1.2.5, b1.7.3-ornithe,
# b1.7.3-stationapi and a1.1.2_01 (#1098). Only a multiplayer run that forwards client calls runs a
# forwarded_ test.
started: bool = false

export tick(ctx: TestTickContext) {
    if not started {
        started = true
        Test.close_screen()
        ctx.assert(not Test.screen_open(), "Test.close_screen should leave the client's screen closed.")
        # The client has no container screen open, so this is its own measurement. The old server
        # answered the call itself and refused without a client, which fails this assertion.
        ctx.assert(Test.gui_width() == 0, "A client with no container screen open should measure 0 wide.")
        level: Level = Test.get_client_level()
        origin: Vec3 = Test.get_origin()
        level.place_block(origin.x(), origin.y(), origin.z(), "grug:coverage_gui")
        Test.use_block(level, origin.x(), origin.y(), origin.z())
        ctx.not_done()
        return
    }
    if not Test.screen_open() {
        ctx.not_done()
        return
    }
    ctx.assert(Test.gui_width() == 176, "The client's coverage_gui panel is 176 pixels wide.")
    Test.close_screen()
    ctx.assert(not Test.screen_open(), "Test.close_screen should leave the client's screen closed.")
}
