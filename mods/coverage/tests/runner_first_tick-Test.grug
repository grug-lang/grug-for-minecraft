# A test's first tick has to be its first tick. On 1.20.6 the runner is ticked by a task the client
# queues on the integrated server, and the lockstep that keeps the two in step starts only once a
# test's room is built and its clock is set. Whatever holds that server thread before then, the test's
# init and the room build among it, leaves the client queueing a runner tick for every tick of its
# own, and those queued ticks used to run back to back as the test's first ticks, with no world tick
# and no frame between them (#717). The runner now drops a tick it queued before the test it was meant
# for existed, so none of them is the test's.

# The stall is what makes that window measurable on every run: an idle room build leaves a tick or so
# queued, while a test whose init or room takes real time leaves many, and a test cannot know which
# it gets. The client ticks about 20 times a second while the server thread is blocked, so 2500 ms
# leaves a queue several times the bound below.
stall: number = 2500

# A test's ticks follow the world's clock, which is Level.get_time, the integrated server's own tick
# count, at most one frame's worth of ticks behind. This test counts its own ticks from its first one
# and checks that distance at every tick, so a runner that replays the queue as its first ticks fails.

# The world's time at this test's first tick, or -1 before it.
start: number = -1
# How many of this test's ticks have run, its first one included.
ran: number = 0

export init(ctx: TestInitContext) {
    Test.stall(stall)
}

export tick(ctx: TestTickContext) {
    now: number = Test.get_client_level().get_time()
    if start < 0 {
        start = now
    }
    ran = ran + 1
    advance: number = now - start
    # Every loader runs at most 10 ticks for a frame, so 25 is two and a half frames' worth and
    # leaves room for a tick that lands in a window of its own. A replayed queue is far more.
    if ran - advance > 25 {
        print3("DIAGNOSTIC this test's ticks so far, world ticks since the first:", ran, advance)
    }
    ctx.assert(ran - advance <= 25, "The ticks the client queued before this test began ran as its first ticks: it ran more than one frame's worth of ticks beyond the world's clock.")
    # Three ticks of the world after the first one: long enough for a queue that was waiting to have
    # run, and cheap on a loader whose runner ticks in the world's own tick.
    if advance < 3 {
        ctx.not_done()
    }
}
