# A test's first tick has to be its first tick, and building the test's room is what used to make it
# not be. On 1.20.6 the runner is ticked by a task the client queues on the integrated server, and
# the room build keeps that server thread busy for far longer than one frame while the client goes on
# queueing a tick for every tick of its own. Those queued ticks used to run back to back as the
# test's first ticks, with no world tick and no frame between them, so a test that counted from its
# first tick saw time pass that had not (#717).

# A test's ticks follow the world's clock, which is Level.get_time, the integrated server's own tick
# count, at most one frame's worth of ticks behind. This test counts its own ticks from its first
# tick and checks that distance at every one of them, so a runner whose first ticks are a backlog
# rather than a test's fails it.

# The world's time at this test's first tick, or -1 before it.
start: number = -1
# How many of this test's ticks have run, its first one included.
ran: number = 0

export tick(ctx: TestTickContext) {
    now: number = Test.get_client_level().get_time()
    if start < 0 {
        start = now
    }
    ran = ran + 1
    advance: number = now - start
    # Every loader runs at most 10 ticks for a frame, so 25 is two and a half frames' worth and
    # leaves room for a tick that lands in a window of its own. A room build's backlog is far more.
    if ran - advance > 25 {
        print3("DIAGNOSTIC ticks run, world ticks since the first:", ran, advance)
    }
    ctx.assert(ran - advance <= 25, "The ticks the client queued while the room was built ran as this test's first ticks: it ran more than one frame's worth of ticks beyond the world's clock.")
    # Three ticks of the world after the first one: long enough for a backlog queued at the start to
    # have run, and cheap for a loader whose runner ticks in the world's own tick.
    if advance < 3 {
        ctx.not_done()
    }
}
