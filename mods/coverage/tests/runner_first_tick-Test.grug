# Diagnostic for #717: blocks the server thread before the room is built, then reports its tick count
# and the world's clock at every tick.
stall: number = 2000
start: number = -1

export init(ctx: TestInitContext) {
    Test.stall(stall)
}

export tick(ctx: TestTickContext) {
    now: number = Test.get_client_level().get_time()
    if start < 0 {
        start = now
    }
    if ctx.current_tick() < 120 {
        print3("DIAG A after the hammer test: ticks, world:", ctx.current_tick(), now - start)
        ctx.not_done()
    }
}
