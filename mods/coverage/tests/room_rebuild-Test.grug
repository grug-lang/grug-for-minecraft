# The room check a loader that implements Level's own block compare answers: a block that is not
# the room's own, at a position the room owns, makes the build rebuild the room instead of leaving
# it in place. Without this, a run only ever reaches the whole-room answer, which makes the other
# side of the check (GrugTestBox.Room.isWhole) unreachable on that loader.

# The rebuild is forced inside this test rather than left to the next one: GrugTestOrder sorts by
# recorded time and puts an unrecorded test last, so a test that waited for the following build
# could run after every other test and never see the rebuild it is about.
export tick(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()

    # The room's outer wall, which the default 3-block room puts 4 blocks out from the player's
    # column and which holds stone from the lowest wall up to the ceiling. The origin is inside the
    # room's height, so its own y names a wall block.
    x: number = origin.x() + 4
    y: number = origin.y()
    z: number = origin.z()

    level.place_block(x, y, z, "minecraft:dirt")
    ctx.assert(level.get_block(x, y, z) == "minecraft:dirt", "The wall cell should hold the dirt.")

    # The room is not whole now, so this build has to clear the area and put the wall back. The
    # radius is the one the runner already built, so the wrong block is the only reason to rebuild.
    Test.set_box_radius(3)
    ctx.assert(level.get_block(x, y, z) == "minecraft:stone", "The rebuild should put it back.")
}
