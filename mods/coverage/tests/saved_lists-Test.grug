# The saved lists a block entity keeps: records of named numbers plus an item, appended, read,
# written, removed and carried through the block entity's NBT. A record with no item answers an empty
# Option, a key a record never stored answers 0, which are the defaults a fresh record has, and an
# item alone stores no number, which is the shape the pipe's record needs.
export tick(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_init_block")
    be: BlockEntity = level.get_block_entity(x, y, z).unwrap()

    ctx.assert(be.get_saved_list_size("things") == 0, "A list that was never saved should be empty.")

    first: number = be.append_saved_list_record("things")
    ctx.assert(first == 0, "The first record should be at index 0.")
    ctx.assert(be.get_saved_list_size("things") == 1, "Appending should grow the list.")
    ctx.assert(be.get_saved_list_number("things", 0, "speed") == 0, "A fresh record should answer 0 for every key.")
    ctx.assert(not be.get_saved_list_item("things", 0).has(), "A fresh record should hold no item.")

    # A record with no item has to come back with none, which is the branch the write and the read
    # take when a record holds no item at all.
    Test.round_trip_nbt(be)
    ctx.assert(be.get_saved_list_size("things") == 1, "The reload should keep a record with no item.")
    ctx.assert(not be.get_saved_list_item("things", 0).has(), "A record with no item should reload with none.")

    be.set_saved_list_number("things", 0, "speed", 0.5)
    ctx.assert(be.get_saved_list_number("things", 0, "speed") == 0.5, "A saved number should read back.")

    diamond: Item = item(resource_location("minecraft:diamond"))
    be.set_saved_list_item("things", 0, diamond)
    item_opt: Option[Item] = be.get_saved_list_item("things", 0)
    ctx.assert(item_opt.has(), "A saved item should read back.")
    ctx.assert(equals(item_opt.unwrap(), diamond), "The record should hold the item that was saved.")

    second: number = be.append_saved_list_record("things")
    ctx.assert(second == 1, "The second record should be at index 1.")
    be.set_saved_list_number("things", 1, "speed", 0.75)
    ctx.assert(be.get_saved_list_size("things") == 2, "The list should hold both records.")

    be.remove_saved_list_record("things", 0)
    ctx.assert(be.get_saved_list_size("things") == 1, "Removing a record should shorten the list.")
    ctx.assert(be.get_saved_list_number("things", 0, "speed") == 0.75, "The later record should move into the removed one's index.")

    # The whole list, numbers and item, has to survive the block entity's own NBT.
    be.set_saved_list_item("things", 0, diamond)
    Test.round_trip_nbt(be)
    ctx.assert(be.get_saved_list_size("things") == 1, "The reload should keep the list.")
    ctx.assert(be.get_saved_list_number("things", 0, "speed") == 0.75, "The reload should keep the record's numbers.")
    reloaded: Option[Item] = be.get_saved_list_item("things", 0)
    ctx.assert(reloaded.has(), "The reload should keep the record's item.")
    ctx.assert(equals(reloaded.unwrap(), diamond), "The reload should keep the diamond.")

    # The record this API exists for is the pipe's travelling item, as BuildCraft 2.2.14 writes it
    # in PipeTransportItems.writeToNBT: an absolute x, y and z, a speed, the direction it faces,
    # whether it is still heading for the centre, and the item. The port also keeps the stack's
    # count and damage as two of the record's numbers, because a record's item is its identity
    # alone. The keys are the port's names for the reference's setDouble("x"), setDouble("speed")
    # and setInteger("orientation").
    traveling: number = be.append_saved_list_record("traveling")
    ctx.assert(traveling == 0, "The pipe's list should start at index 0.")
    # The count and damage are numbers the caller names, not the item's, so they are 3 and 1 rather
    # than the 1 and 0 a stack of one would carry. A half block past a block is a position a
    # travelling item is at for half of each move, so it has to come back as the same number, and
    # the speed is not exact in binary but has to come back unchanged.
    be.set_saved_list_number("traveling", 0, "x", 10.5)
    be.set_saved_list_number("traveling", 0, "y", 20.5)
    be.set_saved_list_number("traveling", 0, "z", -30.5)
    be.set_saved_list_number("traveling", 0, "speed", 0.01)
    be.set_saved_list_number("traveling", 0, "direction", 5)
    be.set_saved_list_number("traveling", 0, "to_center", 1)
    be.set_saved_list_number("traveling", 0, "count", 3)
    be.set_saved_list_number("traveling", 0, "damage", 1)
    be.set_saved_list_item("traveling", 0, diamond)

    Test.round_trip_nbt(be)
    ctx.assert(be.get_saved_list_size("traveling") == 1, "The reload should keep the pipe's record.")
    ctx.assert(be.get_saved_list_number("traveling", 0, "x") == 10.5, "The reload should keep the half-block x exactly.")
    ctx.assert(be.get_saved_list_number("traveling", 0, "y") == 20.5, "The reload should keep y exactly.")
    ctx.assert(be.get_saved_list_number("traveling", 0, "z") == -30.5, "The reload should keep z exactly.")
    ctx.assert(be.get_saved_list_number("traveling", 0, "speed") == 0.01, "The reload should keep the speed unchanged.")
    ctx.assert(be.get_saved_list_number("traveling", 0, "direction") == 5, "The reload should keep the direction it faces.")
    ctx.assert(be.get_saved_list_number("traveling", 0, "to_center") == 1, "The reload should keep its phase.")
    ctx.assert(be.get_saved_list_number("traveling", 0, "count") == 3, "The reload should keep the stack's count.")
    ctx.assert(be.get_saved_list_number("traveling", 0, "damage") == 1, "The reload should keep the stack's damage.")
    pipe_item: Option[Item] = be.get_saved_list_item("traveling", 0)
    ctx.assert(pipe_item.has(), "The reload should keep the record's item.")
    ctx.assert(equals(pipe_item.unwrap(), diamond), "The reload should keep the item's identity.")

    # A record's item is its identity alone: a loader writes it as a stack of one, undamaged, the
    # same shape Test.set_nbt_item stages, and get_saved_list_item answers an Item handle, which has
    # no count or damage. The count and damage above are therefore the record's own numbers, and
    # that is the recorded limitation of this shape rather than an accident (#473): a later port
    # that needs a real stack or components starts from its own accessor pair, as this one does for
    # its numbers, in the commit that first needs it.

    # A record whose only value is its item stores no numbers at all, so a port that needs a count
    # writes the count itself rather than relying on the stack of one the item would carry.
    alone: number = be.append_saved_list_record("traveling")
    ctx.assert(alone == 1, "The second record of the pipe's list should be at index 1.")
    be.set_saved_list_item("traveling", 1, diamond)
    ctx.assert(be.get_saved_list_number("traveling", 1, "x") == 0, "An item alone should store no x.")
    ctx.assert(be.get_saved_list_number("traveling", 1, "count") == 0, "An item alone should store no count.")
    ctx.assert(be.get_saved_list_number("traveling", 1, "damage") == 0, "An item alone should store no damage.")

    Test.round_trip_nbt(be)
    ctx.assert(be.get_saved_list_size("traveling") == 2, "The reload should keep both records.")
    ctx.assert(be.get_saved_list_number("traveling", 1, "x") == 0, "An item alone should still store no x.")
    ctx.assert(be.get_saved_list_number("traveling", 1, "count") == 0, "An item alone should still store no count.")
    ctx.assert(be.get_saved_list_number("traveling", 1, "damage") == 0, "An item alone should still store no damage.")
    alone_item: Option[Item] = be.get_saved_list_item("traveling", 1)
    ctx.assert(alone_item.has(), "The item alone should survive the reload.")
    ctx.assert(equals(alone_item.unwrap(), diamond), "The item alone should keep its identity.")
}
