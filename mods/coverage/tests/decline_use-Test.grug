# Covers decline_use(), which a block's use export calls to leave a click to the game. The fixture block's
# use export declines, so right-clicking it must run the export and the call must not be an error. That the
# game then treats the click as unhandled is in each loader's GrugBlock and shows in how the wooden pipe
# lets a block be placed against it.
export run() {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y()
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_decline_use")
    Test.use_block(level, x, y, z)

    # A block with no use export has not handled the click either, which is the other way a click is
    # left to the game.
    level.place_block(x + 1, y, z, "grug:coverage_mat_snow")
    Test.use_block(level, x + 1, y, z)
}
