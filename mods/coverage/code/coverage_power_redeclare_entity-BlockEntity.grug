# Declares itself a receiver again and again in init(), and saves what each declaration left behind
# for power_declare_again-Test.grug to read. Declaring again replaces the limit and keeps the energy,
# cut down to the new limit when that is lower. That is what a script's init() does when its chunk is
# loaded again, so the energy saved with the block entity has to still be there afterwards.
level: Level = me.level()

export init(ctx: BlockEntityInitContext) {
    ctx.set_power_receiver(10)
    me.receive_energy(8)

    ctx.set_power_receiver(10)
    me.set_saved_number("same_limit", me.get_energy_stored())

    ctx.set_power_receiver(5)
    me.set_saved_number("lower_limit", me.get_energy_stored())
    me.set_saved_number("received_when_full", me.receive_energy(100))

    ctx.set_power_receiver(20)
    me.set_saved_number("received_after_raise", me.receive_energy(100))
    me.set_saved_number("stored_after_raise", me.get_energy_stored())
}
