# Exercises Screenshot.tolerance at the smallest tolerance that passes. It opens a GUI backed by a
# solid texture, so the 100x100 center of the panel is a single known color on every loader (the
# panel is centered and has no slots or labels to draw over that spot). The 1.png reference is that
# same color except for a few pixels that differ by exactly 2 of the 255 channel steps, so the
# maximum per-pixel change is 2 and ceil(100 * 2 / 255) = 1 is the smallest tolerance that accepts
# the capture: 0 would fail the comparison, and anything above 1 would fail as a tolerance higher
# than necessary.
export run() {
    if Test.tick() == 0 {
        level: Level = Test.get_client_level()
        origin: Vec3 = Test.get_origin()
        x: number = origin.x()
        y: number = origin.y()
        z: number = origin.z()

        level.place_block(x, y, z, "grug:coverage_block")
        block_opt: Option[BlockEntity] = level.get_block_entity(x, y, z)
        Test.assert(block_opt.has(), "coverage_block has no block entity after being placed.")

        # No slots or texts, so the panel is only the solid texture, stretched to the menu size.
        layout: GUI = gui(r"assets/grug/textures/gui/tolerance_solid.png")
        player: Player = Test.get_player()
        layout.open(player, block_opt.unwrap())
        Test.not_done()
    } else if Test.tick() < 40 {
        # Give the screen time to open and render, the same budget the buildcraft screenshot uses.
        Test.not_done()
    } else {
        Test.screenshot().tolerance(1).equals(r"screenshots/tolerance_solid", 590, 310, 690, 410)
    }
}
