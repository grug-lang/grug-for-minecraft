# Answers a pipe by paying for the craft itself, as BuildCraft's autocrafting table does: when the pipe is about
# to take the result, one item comes off every filled slot and the result is crafted again for what is left,
# and then the export answers with give_crafting_result_consumed. output_taken counts how often the host called
# it, which a take answered that way must not do. The mode saved under "extract_mode" is
#   0 pays and gives the result as consumed
#   1 gives the result as consumed and then as an ordinary result, which is an err
#   2 gives the result as an ordinary result, for comparison
# What the last call found is saved under "seen_result": 1 when the block entity had a crafting result.
# Member scope has to use me for the script to be able to use it in its exports: the host only learns which block
# entity me is while the grug entity is being created, so a script that leaves it alone there finds no block
# entity behind me in extract_item and sees no crafting result.
level: Level = me.level()

export output_taken(amount: number) {
    me.set_saved_number("output_taken_calls", me.get_saved_number("output_taken_calls") + 1)
}

export extract_item(from_side: number, remove: bool, response: ExtractResponse) {
    if not me.get_crafting_result_item().has() {
        me.set_saved_number("seen_result", 0)
        response.refuse()
        return
    }
    me.set_saved_number("seen_result", 1)

    if me.get_saved_number("extract_mode") == 2 {
        response.give_crafting_result()
        return
    }

    if remove {
        slot: number = 0
        while slot < 9 {
            count: number = me.get_item_count_in_slot(slot)
            if count > 0 {
                me.set_item_count_in_slot(slot, count - 1)
            }
            slot = slot + 1
        }
        me.update_recipe_output(0)
    }

    response.give_crafting_result_consumed()
    if me.get_saved_number("extract_mode") == 1 {
        response.give_crafting_result()
    }
}
