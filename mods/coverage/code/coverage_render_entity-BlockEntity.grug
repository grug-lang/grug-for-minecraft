# Draws a shape no model JSON can express: a core with an arm reaching towards each neighbour that
# is the same block. One block then draws a straight run, a corner, a cross or a cap depending on
# what it is joined to, and the arms meet exactly on the boundary between two blocks, so a run
# reads as one pipe. That is the whole point of the hook, and the screenshot test that covers it.
# The neighbours are read here rather than cached in a member variable because the game calls
# render() again whenever it rebuilds the geometry, which is after every neighbouring block change,
# so a cached shape would go stale the moment this block was joined to something. The x, y and z
# below are the block's own centre, from the member scope the same way, and are the ones every
# neighbour offset is measured from.
level: Level = me.level()
pos: BlockPos = me.block_pos()
center: Vec3 = pos.center()
x: number = center.x()
y: number = center.y()
z: number = center.z()

# The core, inset from every face so an arm leaving it is visibly a separate part rather than a bump
# on a full block.
# How many chunk builds have already had a bad draw, so each refusal is reached once. See the
# guarded calls in render.
shape_errors: number = 0

export render(ctx: RenderContext) {
    ctx.draw_box(0.3, 0.3, 0.3, 0.7, 0.7, 0.7)

    _arm(ctx, 0)
    _arm(ctx, 1)
    _arm(ctx, 2)
    _arm(ctx, 3)
    _arm(ctx, 4)
    _arm(ctx, 5)

    # One bad box and one bad model, so the two refusal paths only a chunk pass can reach are
    # exercised: a box whose corners are the wrong way round, and a model with no elements. Both are
    # reported and not drawn, and each is guarded so it happens once per block entity rather than on
    # every rebuild. The valid draws above are recorded before the report stops the call, and the
    # build the screenshot is taken from is the one after both have happened.
    if shape_errors == 0 {
        shape_errors = 1
        ctx.draw_box(0.9, 0.9, 0.9, 0.1, 0.1, 0.1)
    } else if shape_errors == 1 {
        shape_errors = 2
        ctx.draw_model(r"assets/grug/models/block/coverage_model_empty.json", 0, 0, 0, 0, 0, 0)
    }
}

# One arm towards the neighbour in the given side, drawn only when that neighbour is this block.
# The sides are the six the rest of the codebase numbers the same way: 0 down, 1 up, 2 north,
# 3 south, 4 west and 5 east.
local _arm(ctx: RenderContext, side: number) {
    if level.get_block(_neighbor_x(side), _neighbor_y(side), _neighbor_z(side)) != "grug:coverage_render" {
        return
    }

    # An arm spans from the core's face to this block's own face. Two neighbouring blocks each draw
    # their own, so the pair meets on the boundary between them rather than overlapping.
    if side == 0 {
        ctx.draw_box(0.375, 0.0, 0.375, 0.625, 0.3, 0.625)
    }
    if side == 1 {
        ctx.draw_box(0.375, 0.7, 0.375, 0.625, 1.0, 0.625)
    }
    if side == 2 {
        ctx.draw_box(0.375, 0.375, 0.0, 0.625, 0.625, 0.3)
    }
    if side == 3 {
        ctx.draw_box(0.375, 0.375, 0.7, 0.625, 0.625, 1.0)
    }
    if side == 4 {
        ctx.draw_box(0.0, 0.375, 0.375, 0.3, 0.625, 0.625)
    }
    if side == 5 {
        ctx.draw_box(0.7, 0.375, 0.375, 1.0, 0.625, 0.625)
    }
}

local _neighbor_x(side: number) number {
    if side == 4 {
        return x - 1
    }
    if side == 5 {
        return x + 1
    }
    return x
}

local _neighbor_y(side: number) number {
    if side == 0 {
        return y - 1
    }
    if side == 1 {
        return y + 1
    }
    return y
}

local _neighbor_z(side: number) number {
    if side == 2 {
        return z - 1
    }
    if side == 3 {
        return z + 1
    }
    return z
}
