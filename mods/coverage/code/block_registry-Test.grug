# Exercises place_block's vanilla-reflection, grug-block and unresolved paths, plus custom and
# vanilla item lookups.
export run() {
    if Test.tick() == 0 {
        level: Level = Test.get_client_level()
        origin: Vec3 = Test.get_origin()
        x: number = origin.x()
        y: number = origin.y()
        z: number = origin.z()

        # A vanilla block named without a namespace.
        level.place_block(x + 4, y, z, "stone")
        # A grug block named with its namespace.
        level.place_block(x + 5, y, z, "grug:coverage_block")
        # An unknown block is logged and left unplaced.
        level.place_block(x + 6, y, z, "grug:does_not_exist")

        # A custom grug item and a vanilla one.
        custom: Item = item(resource_location("grug:coverage_item"))
        vanilla: Item = item(resource_location("minecraft:diamond"))
        custom_stack: ItemStack = item_stack(custom)
        vanilla_stack: ItemStack = item_stack(vanilla)
    }
}
