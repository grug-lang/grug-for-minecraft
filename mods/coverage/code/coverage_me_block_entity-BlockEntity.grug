# A block entity whose script has no member-scope statements and still uses me in its exports. The host
# registers the block entity under its own grug entity id when it creates the entity, so no host call has to
# resolve me during creation for tick or item_inserted to find the block entity behind it. See #604.
export item_inserted(slot: number, amount: number) {
    me.set_saved_number("insertions", me.get_saved_number("insertions") + 1)
}

export tick() {
    me.set_saved_number("ticks", me.get_saved_number("ticks") + 1)
}
