# Answers a pipe the way a test tells it to, for the tests of the response classes. A test saves a
# mode under "extract_mode" or "add_mode" and the exports behave accordingly:
#   0 refuses
#   1 answers with the slot and amount the test saved under "slot" and "amount"
#   2 gives the crafting result (extract_item only)
#   3 answers twice with different answers
#   4 answers twice with the same answer
#   5 returns without answering
#   6 answers, and keeps the response so that on_neighbor_change can use it after the call
#   8 gives from slot 0 and then gives the crafting result (extract_item only)
#   7 answers the first time it is asked and errors on every later ask (add_item only)
# liquid_mode behaves the same way for offer_liquid: 2 and 3 answer twice, 4 says nothing, 5 keeps the
# response for on_neighbor_change, 9 answers a liquid where an amount was asked for, 10 answers a
# negative amount, and any other mode answers the amount it was offered. It also tells get_liquid to
# answer that it holds nothing (8), an amount where a liquid was asked for (11), a name that is no
# liquid (12), nothing at all (13), flowing lava (14), or a liquid and then nothing (15), which is
# what a response class's answer_none has to refuse once it was answered.
# take_mode makes take_liquid answer a liquid (1), a negative amount (2) or nothing (3).
# amount_mode and capacity_mode make those two exports answer a liquid (1) or nothing (2).
# The default offer saves the liquid name it was handed under "offered_liquid", so a test can see
# what the host normalised a flowing name to.
# What the last call was asked is saved under "seen_remove", "seen_add" and "seen_side".
level: Level = me.level()

kept_extract: Option[ExtractResponse] = Option.new()
kept_add: Option[AddResponse] = Option.new()
kept_liquid: Option[LiquidResponse] = Option.new()

# Uses the responses the exports kept, after those calls have returned.
export on_neighbor_change() {
    if kept_extract.has() {
        kept_extract.unwrap().refuse()
    }
    if kept_add.has() {
        kept_add.unwrap().refuse()
    }
    if kept_liquid.has() {
        kept_liquid.unwrap().answer_amount(1)
    }
}

export extract_item(from_side: number, remove: bool, response: ExtractResponse) {
    me.set_saved_number("seen_side", from_side)
    if remove {
        me.set_saved_number("seen_remove", 1)
    } else {
        me.set_saved_number("seen_remove", 0)
    }

    mode: number = me.get_saved_number("extract_mode")
    if mode == 1 {
        response.give_from_slot(me.get_saved_number("slot"), me.get_saved_number("amount"))
    } else if mode == 2 {
        response.give_crafting_result()
    } else if mode == 3 {
        response.refuse()
        response.give_from_slot(0, 1)
    } else if mode == 4 {
        response.refuse()
        response.refuse()
    } else if mode == 8 {
        response.give_from_slot(0, 1)
        response.give_crafting_result()
    } else if mode == 5 {
        # Deliberately says nothing.
    } else if mode == 6 {
        kept_extract.set(response)
        response.refuse()
    } else {
        response.refuse()
    }
}

export add_item(item: Item, damage: number, count: number, from_side: number, add: bool, response: AddResponse) {
    me.set_saved_number("seen_side", from_side)
    if add {
        me.set_saved_number("seen_add", 1)
    } else {
        me.set_saved_number("seen_add", 0)
    }

    mode: number = me.get_saved_number("add_mode")
    if mode == 1 {
        response.accept_into_slot(me.get_saved_number("slot"))
    } else if mode == 3 {
        response.refuse()
        response.accept_into_slot(0)
    } else if mode == 4 {
        response.refuse()
        response.refuse()
    } else if mode == 5 {
        # Deliberately says nothing.
    } else if mode == 6 {
        kept_add.set(response)
        response.refuse()
    } else if mode == 7 {
        if me.get_saved_number("asked") > 0 {
            empty: Option[Item] = Option.new()
            empty.unwrap()
        }
        me.set_saved_number("asked", 1)
        response.accept_into_slot(me.get_saved_number("slot"))
    } else {
        response.refuse()
    }
}

# The liquid answers the tests read: a flowing name, which the host normalises to the still liquid's,
# an amount and a capacity, and a take that gives less than it was asked for. The response rules are
# offer_liquid's, which is one response class's four tests for all five entries.
export offer_liquid(liquid: string, amount: number, from_side: number, fill: bool, response: LiquidResponse) {
    mode: number = me.get_saved_number("liquid_mode")
    if mode == 2 {
        response.answer_amount(1)
        response.answer_liquid("minecraft:water")
    } else if mode == 3 {
        response.answer_amount(1)
        response.answer_amount(1)
    } else if mode == 4 {
        # Deliberately says nothing.
    } else if mode == 5 {
        kept_liquid.set(response)
        response.answer_amount(1)
    } else if mode == 9 {
        response.answer_liquid("minecraft:water")
    } else if mode == 10 {
        response.answer_amount(-1)
    } else {
        me.set_saved_string("offered_liquid", liquid)
        response.answer_amount(amount)
    }
}

export take_liquid(amount: number, take: bool, response: LiquidResponse) {
    mode: number = me.get_saved_number("take_mode")
    if mode == 1 {
        response.answer_liquid("minecraft:water")
    } else if mode == 2 {
        response.answer_amount(-1)
    } else if mode == 3 {
        # Deliberately says nothing.
    } else {
        response.answer_amount(500)
    }
}

export get_liquid(response: LiquidResponse) {
    mode: number = me.get_saved_number("liquid_mode")
    if mode == 8 {
        response.answer_none()
    } else if mode == 11 {
        response.answer_amount(1)
    } else if mode == 12 {
        response.answer_liquid("minecraft:stone")
    } else if mode == 13 {
        # Deliberately says nothing.
    } else if mode == 14 {
        response.answer_liquid("minecraft:flowing_lava")
    } else if mode == 15 {
        response.answer_liquid("minecraft:water")
        response.answer_none()
    } else {
        response.answer_liquid("minecraft:flowing_water")
    }
}

export get_liquid_amount(response: LiquidResponse) {
    mode: number = me.get_saved_number("amount_mode")
    if mode == 1 {
        response.answer_liquid("minecraft:water")
    } else if mode == 2 {
        # Deliberately says nothing.
    } else {
        response.answer_amount(1234)
    }
}

export get_liquid_capacity(response: LiquidResponse) {
    mode: number = me.get_saved_number("capacity_mode")
    if mode == 1 {
        response.answer_liquid("minecraft:water")
    } else {
        response.answer_amount(16000)
    }
}
