# The per-frame hook's two kinds of draw: a model, drawn as the plate the two stacks stand on, and a
# stack, which the game draws as a cube for a block item and as one flat sprite turned to face the
# player. The positions are block-local, the same as draw_box's, and everything here is drawn per
# frame rather than into the chunk, which is the path a reference's block entity renderer takes. See
# the block's set_frame_render().

# Hoisted to member scope so the frame does not create a new Item every frame.
log: Item = item(resource_location("minecraft:oak_log"))
stick: Item = item(resource_location("minecraft:stick"))

# Read every frame, because a reference that interpolates needs the tick and a part that aims
# itself needs the direction. Nothing here uses either value, but this is the only place their
# success path is reachable from.
frame_tick: number = 0
frame_yaw: number = 0

# One bad call, so the refusal path a frame pass alone can reach is exercised. The count is not a
# whole number, which is reported and not drawn. The frame carries on afterwards, as a contained
# script error, so the run is unaffected.
refused_bad_count: bool = false

export render_frame(ctx: RenderFrameContext) {
    frame_tick = ctx.partial_tick()
    frame_yaw = ctx.camera_yaw()

    # The plate the stacks stand on, drawn first so they are visibly on top of it rather than
    # floating in the room.
    ctx.draw_model(r"assets/grug/models/block/coverage_frame_pedestal.json", 0, 0, 0, 0.0, 0.0, 0.0)

    # A log is a block item, so it is a cube a quarter of a block across, lifted a quarter. The
    # stick is one flat sprite half a block across, lifted a tenth, turned to face the camera.
    ctx.draw_item(log, 0, 1, 0.3, 0.2, 0.5)
    ctx.draw_item(stick, 0, 1, 0.7, 0.2, 0.5)

    if not refused_bad_count {
        refused_bad_count = true
        ctx.draw_item(stick, 0, 1.5, 0.5, 0.5, 0.5)
    }
}
