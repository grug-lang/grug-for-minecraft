# How many times the world key J was pressed, and whether the world pass draws the cross. The
# first press turns the cross on and each press after it flips it, so a test can tell a press that
# arrived from one that did not by what the next frame shows. See #1353.
world_presses: number = 0
cross_on: bool = false
# The translucent triangles of #1253's world API: key Y saves where the camera is on the next frame
# and shows two triangles four blocks ahead of that position, and a press while they show hides them.
triangle_pending: bool = false
triangle_on: bool = false
triangle_x: number = 0
triangle_y: number = 0
triangle_z: number = 0
shell_pending: bool = false
near_shell_on: bool = false
far_shell_on: bool = false
shell_x: number = 0
shell_y: number = 0
shell_z: number = 0
# Whether the world box's right clicks ask the server to change the block entity the test placed at
# its origin (#1759), and which change the next world frame asks for: 0 none, 1 writes a diamond
# into slot 0, 2 drops the inventory. The item is named rather than taken from the list at index 0,
# because index 0 is an item that does not stack that far on 1.20.6 and a chest there limits a slot
# to the item's maximum stack, so a write of three landed as one and the test could not tell it from
# a write of one. World key W (87) turns it on, and it turns itself off after the
# drop, so no other test's right click on the box changes anything. W rather than K, because the
# mobcap mod's overlay toggles on K and an overlay is one entity for the whole run: a K press here
# would leave its lines in every later test's capture. The origin is the camera plus
# three, the position TestTickContext.get_origin answers, captured in the world pass because the
# click has no level or camera of its own.
inventory_calls_on: bool = false
inventory_writes: number = 0
inventory_call: number = 0
# Whether the joined client has already said that it has no block entity at the origin, so that line
# is printed once per run rather than once per frame.
missing_reported: bool = false
origin_x: number = 0
origin_y: number = 0
origin_z: number = 0

# Whether the declared binding (default B) has flipped its own mark, which the first press turns on
# and each press after it flips. See #1255.
binding_on: bool = false

# Whether the unbound binding declared with no default_key has been pressed by id, which only
# TestTickContext.press_world_key_id can reach: the host registers it with the version's unbound
# key and the player can bind it in Controls. See #1868.
unbound_pressed: bool = false

# Whether the world pass checks the answers about the local player's feet, which overlay_player-Test
# turns on with world key N (78). The camera sits at the player's eyes, a little above the feet and in
# the same column, so a line across the feet is drawn only while the three answers describe a player
# the test moved to a quarter and three quarters into two blocks: a rounded value, a swapped axis, a
# fraction from the wrong block or a y taken from the camera all leave the line undrawn. See
# OverlayWorldContext.player_x.
feet_on: bool = false

# Whether the world pass asks for the geometry's depth test to be off, which world key Z (90) toggles.
# Z rather than an earlier letter, because coverage_screen_scroll_reopen already presses Q (81) and an
# overlay is one entity for the whole run, so that press would leave this armed for every later test.
# The smoketest and the coverage leg stub the draw, so this only proves the entry answers inside a
# world pass and that the request survives the frame's geometry; the pixel proof is the capture the
# Build Guide capture suite plans (edge_depth_off).
depth_off: bool = false

# The serial of the last screen the overlay drew on, and whether the key Ctrl+Z has not yet been answered
# on it, which lets a test tell a new screen from the same one (OverlayRenderContext.screen_serial,
# #865).
last_serial: number = -1
fresh_screen: bool = false

# Whether the HUD reads the mob counts and caps from the frame's level, which only overlay_mob_cap-Test turns on
# (key I), because not every loader answers them.
mob_cap_on: bool = false

# Covers the overlay host functions through a real screen: the context's numbers and modifiers,
# draw_item, draw_box, take, the cursor the reference deletes, give_item and give_item_stack, and
# the loader's item list behind item_at. The box sits at the centre of the screen, where the
# player's inventory also is, so the test's click lands on it; a click there gives the first item
# and takes the press, a middle click gives a stack, and a left click while the cursor carries an
# item deletes it instead. Scrolling the wheel down over the box is taken too, and so is a fast turn
# up of three notches, while a gentler turn up is left to the screen. On a loader that draws no
# overlays the exports are never asked, and the test returns before it opens anything. See #615.
export render(ctx: OverlayRenderContext) {
    box_x: number = Math.floor(ctx.screen_width() / 2) - 9
    box_y: number = Math.floor(ctx.screen_height() / 2) - 9
    ctx.draw_item(item_at(0), box_x + 1, box_y + 1)
    # A line of text above the box, drawn with the game's font (OverlayRenderContext.draw_text, #865).
    ctx.draw_text("coverage overlay text", box_x - 40, box_y - 12, Color.rgb(255, 255, 255))
    if ctx.screen_serial() != last_serial {
        last_serial = ctx.screen_serial()
        fresh_screen = true
    }
    over_box: bool = ctx.mouse_x() >= box_x and ctx.mouse_x() < box_x + 18 and ctx.mouse_y() >= box_y and ctx.mouse_y() < box_y + 18
    over_gui_x: bool = ctx.mouse_x() >= ctx.gui_left() and ctx.mouse_x() < ctx.gui_left() + ctx.gui_width()
    inside_gui: bool = over_gui_x and ctx.mouse_y() >= ctx.gui_top() and ctx.mouse_y() < ctx.gui_top() + ctx.gui_height()
    if over_box and inside_gui {
        ctx.draw_box(box_x, box_y, box_x + 18, box_y + 18)
    }
    # The reference draws the delete message instead of the hovered ingredient's own tooltip while
    # the cursor carries a stack a left click would delete (#1763). A coverage mod is loaded in every
    # other mod's tests too, and its overlay draws on their screens, so the message is drawn only
    # while the mouse is over this mod's own box: otherwise it would be painted over the tooltip a
    # mod like jei draws in its own capture. overlay_tooltip-Test parks the mouse there.
    if over_box and ctx.carried_item().has() {
        ctx.draw_tooltip("Click to delete.", ctx.mouse_x(), ctx.mouse_y())
    }
}

export click(ctx: OverlayClickContext) {
    shift_held: bool = ctx.shift()
    carrying: bool = ctx.carried_item().has()
    inside_screen: bool = ctx.mouse_x() >= 0 and ctx.mouse_x() < ctx.screen_width() and ctx.mouse_y() >= 0 and ctx.mouse_y() < ctx.screen_height()
    over_gui_x: bool = ctx.mouse_x() >= ctx.gui_left() and ctx.mouse_x() < ctx.gui_left() + ctx.gui_width()
    inside_gui: bool = over_gui_x and ctx.mouse_y() >= ctx.gui_top() and ctx.mouse_y() < ctx.gui_top() + ctx.gui_height()
    box_x: number = Math.floor(ctx.screen_width() / 2) - 9
    box_y: number = Math.floor(ctx.screen_height() / 2) - 9
    over_box: bool = ctx.mouse_x() >= box_x and ctx.mouse_x() < box_x + 18 and ctx.mouse_y() >= box_y and ctx.mouse_y() < box_y + 18
    # The first hotbar slot, which holds the player's held item. Taking a press here without
    # changing anything lets a test tell a cancelled press from one that also reached the slot.
    hotbar_x: number = ctx.gui_left() + 17
    hotbar_y: number = ctx.gui_top() + ctx.gui_height() - 15
    over_hotbar: bool = ctx.mouse_x() >= hotbar_x - 9 and ctx.mouse_x() < hotbar_x + 9 and ctx.mouse_y() >= hotbar_y - 9 and ctx.mouse_y() < hotbar_y + 9
    # A left click on the first hotbar slot while the cursor carries an item closes the screen
    # without taking the press, which is the fixture a test needs for a press that closes its own
    # screen: 1.20.6 fires a synthetic release after the press, and a real mouse release follows
    # the screen the client shows then, so the release must not reach the screen the press left
    # (#1217). A press here with an empty cursor keeps the take below, as the earlier tests expect.
    if inside_screen and inside_gui and over_hotbar and ctx.button() == 0 and carrying {
        ctx.close_screen()
        return
    }
    if inside_screen and inside_gui and over_hotbar {
        ctx.take()
        return
    }
    # The right click over the box while the inventory is open is the forwarded write this overlay
    # exists to prove (#1759): the change is made to the block entity the test placed at its origin,
    # by the world pass, which is the pass that has the level and the camera.
    if inside_screen and inside_gui and over_box and inventory_calls_on and ctx.button() == 1 {
        if inventory_writes == 0 {
            inventory_call = 1
            inventory_writes = 1
        } else {
            inventory_call = 2
            inventory_writes = 2
            inventory_calls_on = false
        }
        ctx.take()
        return
    }
    if inside_screen and inside_gui and over_box {
        if ctx.button() == 0 and carrying {
            ctx.delete_carried_item()
        } else if ctx.button() == 0 and shift_held {
            give_item_stack(item_at(0))
        } else if ctx.button() == 2 {
            give_item_stack(item_at(0))
        } else if ctx.button() == 0 {
            give_item(item_at(0))
        } else {
            return
        }
        ctx.take()
    }
}

# Control and K is the key this overlay takes, so a test can tell a taken key from one the screen
# handles itself. Any other key is left alone.
export key(ctx: OverlayKeyContext) {
    if ctx.key() == 75 and ctx.ctrl() {
        ctx.take()
    }
    # The space bar (32) and backspace (8) reach an overlay as their ASCII codes on every loader
    # (#865), and Z takes only the first press on a screen, so a test can tell a new screen from the
    # one before it. All three need Control, because this overlay runs before the item list's and a
    # plain space or backspace it took would never reach the search field.
    if (ctx.key() == 32 or ctx.key() == 8) and ctx.ctrl() {
        ctx.take()
    }
    if ctx.key() == 90 and ctx.ctrl() and fresh_screen {
        fresh_screen = false
        ctx.take()
    }
    # A held key is delivered again with repeat() true, which a toggle reads so it flips once per
    # press (#1741). Only the repeat of Control+A is taken: its first press and the press after a
    # release are left alone, and a plain letter's repeat is left alone because taking it would hide
    # a held letter from the item list's search field.
    if ctx.key() == 65 and ctx.ctrl() and ctx.repeat() {
        ctx.take()
    }
    # A key with no character of its own arrives as its number from 256 up, and shift is the event's
    # own flag, so one of those keys is taken only while shift is held: the test presses every one of
    # them with shift and two of them without, which tells the flag from the number (#1748).
    pressed: number = ctx.key()
    if pressed >= 256 and pressed <= 269 and ctx.shift() {
        ctx.take()
    }
    # The letter M is taken with control, which covers a test press of an API key code that is not
    # this loader's key index: LWJGL 2 numbers the M key 50 and 77 is numpad 6, so a press that
    # reached the overlay as 77 was translated by name rather than taken as an index. It proves the
    # test press's translation only, not a mod's key code, which #1749's finding needs.
    if ctx.key() == 77 and ctx.ctrl() {
        ctx.take()
    }
    # A typed character arrives on its own, with key() 0, and ~ (126) is a character no other mod's
    # test types, so taking it cannot hide a character a field needs. It is the smallest proof that
    # a punctuation key with no number of its own reaches an overlay as a character.
    if ctx.character() == 126 {
        ctx.take()
    }
    # A shifted letter or digit reaches an overlay as the character shift types, M (77) for the M
    # key and ! (33) for the 1 key. Taking those two only while shift is held proves that a test
    # press carries the shifted character, not the unshifted one no keyboard pairs with that key
    # (#1748).
    typed: number = ctx.character()
    if (typed == 77 or typed == 33) and ctx.shift() {
        ctx.take()
    }
}

# A wheel turned down over the box is taken, and so is one turned up by three notches or more, so a
# test can tell a taken movement from one the screen handles itself, and can tell that the delta is
# the wheel's own number. Everything else is left alone. See #986.
export scroll(ctx: OverlayScrollContext) {
    inside_screen: bool = ctx.mouse_x() >= 0 and ctx.mouse_x() < ctx.screen_width() and ctx.mouse_y() >= 0 and ctx.mouse_y() < ctx.screen_height()
    over_gui_x: bool = ctx.mouse_x() >= ctx.gui_left() and ctx.mouse_x() < ctx.gui_left() + ctx.gui_width()
    inside_gui: bool = over_gui_x and ctx.mouse_y() >= ctx.gui_top() and ctx.mouse_y() < ctx.gui_top() + ctx.gui_height()
    box_x: number = Math.floor(ctx.screen_width() / 2) - 9
    box_y: number = Math.floor(ctx.screen_height() / 2) - 9
    over_box: bool = ctx.mouse_x() >= box_x and ctx.mouse_x() < box_x + 18 and ctx.mouse_y() >= box_y and ctx.mouse_y() < box_y + 18
    if inside_screen and inside_gui and over_box and (ctx.delta() < 0 or ctx.delta() >= 3) {
        ctx.take()
    }
}

# Two lines of text at the left edge of the frame, in the GUI's scaled pixels, while the cross is on, so
# a frame before the first press, or after the second, shows no text.
export render_hud(ctx: OverlayHudContext) {
    # The frame's level, the one the mob cap overlay reads its counts from (#1252).
    if cross_on and ctx.screen_width() > 0 and ctx.screen_height() > 112 and ctx.top_inset() >= 0 and ctx.get_level().get_time() >= 0 {
        ctx.add_text("L pressed", 4, 100, Color.rgb(255, 255, 255))
        ctx.add_text("world key seen", 4, 112, Color.rgb(255, 255, 255))
    }
    # The frame's level is the client's copy of the world, which the mob cap overlay reads its counts
    # and caps from on the render thread (#1252): a read that has to come back with an answer.
    if mob_cap_on and ctx.get_level().count_mobs("hostile") >= 0 and ctx.get_level().get_mob_cap("hostile") >= 0 {
        ctx.add_text("mob cap read", 4, 124, Color.rgb(255, 255, 255))
    }
}

# Two crossing diagonals four blocks in front of the camera along +z, two blocks tall and wide and
# centred on the camera, in red, like the crosses SafeSquares draws on a safe square. Drawn only
# while the cross is on.
export render_world(ctx: OverlayWorldContext) {
    # The test's origin is where its camera sits plus three, the same position
    # TestTickContext.get_origin answers on the server (#188), so a block the test placed there is
    # the block a click changes (#1759).
    origin_x = ctx.camera_x()
    origin_y = ctx.camera_y() + 3
    origin_z = ctx.camera_z()
    if inventory_call == 1 {
        # The block entity can reach the joined client a frame or more after the block does, on a
        # loader that sends block entities in their own packet, so the write stays armed until the
        # client's level has it: clearing the flag first would make the click a silent no-op and the
        # test would see a chest the server never changed (#1759).
        chest_opt: Option[BlockEntity] = ctx.get_level().get_block_entity(origin_x, origin_y, origin_z)
        if chest_opt.has() {
            inventory_call = 0
            chest_opt.unwrap().set_item_in_slot(0, item(resource_location("minecraft:diamond")), 3)
            print("coverage: asked the server to write slot 0 of the block entity at the origin")
        } else if not missing_reported {
            # Said once, so a run whose joined client never has the block entity says so before the
            # test's own failure rather than leaving the click looking like it did nothing.
            missing_reported = true
            print("coverage: the joined client has no block entity at the test origin yet")
        }
    } else if inventory_call == 2 {
        inventory_call = 0
        drop_inventory(ctx.get_level(), origin_x, origin_y, origin_z)
        print("coverage: asked the server to drop the block entity at the origin")
    }
    # A line at the block entity while the forwarded writes are armed. Only the W press arms them,
    # so a world frame that draws this is the proof that the press reached this client, which is
    # what the test waits for before it opens the inventory (#1759).
    if inventory_calls_on {
        ctx.draw_line(origin_x - 0.5, origin_y - 0.5, origin_z, origin_x + 0.5, origin_y - 0.5, origin_z, Color.rgb(255, 0, 0))
    }
    if shell_pending {
        shell_pending = false
        shell_x = ctx.camera_x()
        shell_y = ctx.camera_y()
        shell_z = ctx.camera_z()
    }
    # Two translucent triangles in front of each other, the near one drawn first, as two shells of a
    # closed shape are: the far one lies wholly behind the near one as seen from the camera, so it
    # shows through only if a translucent triangle does not hide what is drawn after it (#1427).
    if near_shell_on {
        ctx.draw_triangle(shell_x - 2, shell_y - 2, shell_z + 4, shell_x + 2, shell_y - 2, shell_z + 4, shell_x, shell_y + 2, shell_z + 4, Color.rgba(255, 0, 0, 128))
    }
    if far_shell_on {
        ctx.draw_triangle(shell_x - 1, shell_y - 1, shell_z + 6, shell_x + 1, shell_y - 1, shell_z + 6, shell_x, shell_y + 0.5, shell_z + 6, Color.rgba(0, 0, 255, 128))
    }
    # The frame's level, which is a world with a clock that never runs backwards: that is all the
    # read here asks of it, and the light overlay mod reads its light and spawn spaces from it.
    if cross_on and ctx.partial_tick() >= 0 and ctx.get_level().get_time() >= 0 {
        x: number = ctx.camera_x()
        y: number = ctx.camera_y()
        z: number = ctx.camera_z() + 4
        ctx.draw_line(x - 1, y - 1, z, x + 1, y + 1, z, Color.rgb(255, 0, 0))
        ctx.draw_line(x - 1, y + 1, z, x + 1, y - 1, z, Color.rgb(255, 0, 0))
    }
    if triangle_pending {
        triangle_pending = false
        triangle_x = ctx.camera_x()
        triangle_y = ctx.camera_y()
        triangle_z = ctx.camera_z() + 4
    }
    if triangle_on {
        half_red: Color = Color.rgba(255, 0, 0, 128)
        ctx.draw_triangle(triangle_x - 1, triangle_y - 1, triangle_z, triangle_x + 1, triangle_y - 1, triangle_z, triangle_x + 1, triangle_y + 1, triangle_z, half_red)
        ctx.draw_triangle(triangle_x - 1, triangle_y - 1, triangle_z, triangle_x + 1, triangle_y + 1, triangle_z, triangle_x - 1, triangle_y + 1, triangle_z, half_red)
    }
    # The mark the declared binding flips, drawn in the colour its config declares, so a test tells
    # a binding press from a world key press by what the next frame shows (#1255).
    if binding_on or unbound_pressed {
        cfg: Config = ctx.get_config()
        mark: Color = cfg.color("coverage_color")
        x: number = ctx.camera_x()
        y: number = ctx.camera_y()
        z: number = ctx.camera_z() + 4
        ctx.draw_line(x - 1, y - 1, z, x + 1, y + 1, z, mark)
    }
    # The depth test the frame's geometry is drawn with (OverlayWorldContext.set_depth_test, called by
    # Build Guide's render_world from its state's flag). The line makes the frame count as drawn so a
    # test can wait for it, which is the only thing a coverage test can observe of a stubbed draw.
    if depth_off {
        x: number = ctx.camera_x()
        y: number = ctx.camera_y()
        z: number = ctx.camera_z() + 4
        ctx.set_depth_test(false)
        ctx.draw_line(x - 1, y - 1, z, x + 1, y - 1, z, Color.rgb(255, 255, 0))
    }
    # A line across the local player's feet while overlay_player-Test has them armed. The three
    # answers are called even when the check fails, which is what the coverage gate counts. The test
    # stands the player three quarters into one block on x and a quarter into one on z, below the
    # camera's eyes in the same column, so the line is drawn only while each answer is that exact
    # fraction: a rounded answer is at a block edge, a y copied from the camera sits at the eyes, and
    # an x or z taken from the other axis carries the other axis's fraction (OverlayWorldContext.
    # player_x).
    if feet_on {
        feet_x: number = ctx.player_x()
        feet_y: number = ctx.player_y()
        feet_z: number = ctx.player_z()
        camera_x: number = ctx.camera_x()
        camera_y: number = ctx.camera_y()
        camera_z: number = ctx.camera_z()
        frac_x: number = feet_x - Math.floor(feet_x)
        frac_z: number = feet_z - Math.floor(feet_z)
        if Math.abs(frac_x - 0.75) < 0.01 and Math.abs(frac_z - 0.25) < 0.01 and feet_y < camera_y - 1 and feet_y > camera_y - 2 and Math.abs(feet_x - camera_x) < 0.05 and Math.abs(feet_z - camera_z) < 0.05 {
            ctx.draw_line(feet_x - 0.25, feet_y + 0.05, feet_z, feet_x + 0.25, feet_y + 0.05, feet_z, Color.rgb(0, 255, 0))
        }
    }
}

# The world key J (74) flips the cross, and Control and J only ever turns it off, so a test can tell
# that the modifier is the key's own. Any other key is left alone.
export world_key(ctx: OverlayWorldKeyContext) {
    if ctx.key() == 73 {
        mob_cap_on = not mob_cap_on
    }
    if ctx.key() == 85 {
        near_shell_on = not near_shell_on
        shell_pending = near_shell_on
        return
    }
    if ctx.key() == 86 {
        far_shell_on = not far_shell_on
        return
    }
    if ctx.key() == 89 {
        triangle_on = not triangle_on
        triangle_pending = triangle_on
        return
    }
    if ctx.key() == 87 {
        inventory_calls_on = true
        inventory_writes = 0
        return
    }
    # N arms the feet check overlay_player-Test reads, and a second press disarms it so no later
    # test's frame draws the line.
    if ctx.key() == 78 {
        feet_on = not feet_on
        return
    }
    # Z arms the depth-test request overlay_depth_test-Test reads, and a second press disarms it so
    # no later test's frame asks for a see-through guide. No other coverage test presses Z.
    if ctx.key() == 90 {
        depth_off = not depth_off
        return
    }
    if ctx.key() == 74 {
        world_presses = world_presses + 1
        if ctx.ctrl() {
            cross_on = false
        } else {
            cross_on = not cross_on
        }
    }
}

# The binding the mod declares in about.json (see coverage_toggle there). A press reads the mod's
# own config through the binding context, which is the one host path a binding has, and flips the
# mark render_world draws while it is on. A number read from a colour option and a bool read from
# a number option answer their type's empty value, which a mod that mistypes sees rather than an
# err; the host's own Java test checks those values.
export world_binding(ctx: OverlayWorldBindingContext) {
    cfg: Config = ctx.get_config()
    if ctx.id() == "coverage_unbound" {
        # The binding about.json declares without a default_key, so no real key press reaches it and
        # only a test's press_world_key_id does. It flips the mark render_world draws, and a second
        # press turns it back off, so the overlay is left as the test found it. See #1868.
        unbound_pressed = not unbound_pressed
        return
    }
    if ctx.id() != "coverage_toggle" {
        return
    }
    count: number = cfg.number("coverage_count")
    flag: bool = cfg.bool("coverage_flag")
    not_a_number: number = cfg.number("coverage_color")
    not_a_bool: bool = cfg.bool("coverage_count")
    if flag and count == 3 and not_a_number == 0 and not not_a_bool {
        binding_on = not binding_on
    }
}
