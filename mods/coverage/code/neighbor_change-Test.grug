# Covers the on_neighbor_change block entity export, which the loader delivers when a neighbouring
# block changes so a machine can re-evaluate its connections instead of polling.
export run() {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x, y, z, "grug:coverage_neighbor_block")
    block_opt: Option[BlockEntity] = level.get_block_entity(x, y, z)
    Test.assert(block_opt.has(), "The neighbour-coverage block should have a block entity.")
    be: BlockEntity = block_opt.unwrap()

    Test.assert(get_item_count_in_slot(be, 0) == 0, "The marker slot should start empty.")

    # Placing a neighbour, then notifying it, should make the loader call on_neighbor_change on the
    # block entity. place_block is quiet on the Ornithe loaders, so the notify is explicit.
    level.place_block(x + 1, y, z, "minecraft:stone")
    Test.notify_neighbors(level, x + 1, y, z)

    Test.assert(get_item_count_in_slot(be, 0) == 1, "The neighbour change should have been delivered.")
}
