# Hot-reloads an Item script, so Grug.update's "no block data" branch runs, then restores it.
export run() {
    if Test.tick() == 0 {
        Test.not_done()
    } else if Test.tick() == 1 {
        Test.toggle_mod_file_comment("coverage/code/coverage_item-Item.grug")
        Test.not_done()
    } else if Test.tick() < 20 {
        Test.not_done()
    } else {
        Test.toggle_mod_file_comment("coverage/code/coverage_item-Item.grug")
    }
}
