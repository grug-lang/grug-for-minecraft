# Corrupts a grug file across ticks so Grug.update's hot-reload failure path (and the error
# callbacks) runs, then restores it.
export run() {
    if Test.tick() == 0 {
        Test.not_done()
    } else if Test.tick() == 1 {
        Test.toggle_mod_file_corruption("coverage/code/coverage_block-Block.grug")
        Test.not_done()
    } else if Test.tick() < 6 {
        # Give Grug.update a tick or two to notice and try to hot-reload the broken file.
        Test.not_done()
    } else {
        Test.toggle_mod_file_corruption("coverage/code/coverage_block-Block.grug")
    }
}
