# Exercises mod_api entry points that no real mod path reaches yet, so they stay covered.
export run() {
    if Test.tick() == 0 {
        level: Level = Test.get_client_level()
        origin: Vec3 = Test.get_origin()
        x: number = origin.x()
        y: number = origin.y()
        z: number = origin.z()

        level.place_block(x, y, z, "grug:foo_block")
        block_opt: Option[BlockEntity] = level.get_block_entity(x, y, z)
        Test.assert(block_opt.has(), "foo_block has no block entity after being placed.")
        block: BlockEntity = block_opt.unwrap()

        # BlockPos.above_n directly, in addition to the copy examplemod's block entity runs.
        above: BlockPos = get_block_pos_of_block_entity(block).above_n(2)
        Test.assert(above.center().y() > origin.y(), "above_n did not move the position up.")

        # item / resource_location / item_stack / item_entity / Entity.set_delta_movement /
        # Entity.spawn / vec3_zero.
        diamond: Item = item(resource_location("minecraft:diamond"))
        stack: ItemStack = item_stack(diamond)
        entity: ItemEntity = item_entity(level, x, y, z, stack)
        entity.entity().set_delta_movement(vec3_zero())
        entity.entity().spawn(level)

        # drop_inventory on a fresh chest, which has an empty inventory.
        level.place_block(x + 2, y, z, "minecraft:chest")
        chest_opt: Option[BlockEntity] = level.get_block_entity(x + 2, y, z)
        Test.assert(chest_opt.has(), "chest has no block entity after being placed.")
        chest: BlockEntity = chest_opt.unwrap()
        drop_inventory(level, x + 2, y, z)

        # get_item_in_slot's empty-slot branch on the now-empty chest.
        empty_item: Option[Item] = get_item_in_slot(chest, 0)
        Test.assert(not empty_item.has(), "The emptied chest still reports an item.")

        # Option.set for the number, bool and string overloads.
        number_opt: Option[number] = Option.new()
        number_opt.set(1)
        bool_opt: Option[bool] = Option.new()
        bool_opt.set(true)
        string_opt: Option[string] = Option.new()
        string_opt.set("value")

        # equals' non-entity fallback branch.
        Test.assert(equals("a", "a"), "equals should compare two strings.")

        # The print family.
        print("print")
        print2("print2", 2)
        print3("print3", 2, true)

        Test.not_done()
    } else if Test.tick() < 15 {
        # Let examplemod's foo_block entity tick far enough to run its 10-tick spawn once.
        Test.not_done()
    }
}
