# Covers item + resource_location + item_stack (with damage) + item_entity + ItemEntity.damage +
# Entity.set_delta_movement + Entity.spawn + vec3_zero.
export run() {
    if Test.tick() == 0 {
        level: Level = Test.get_client_level()
        origin: Vec3 = Test.get_origin()

        # A sword, because newer versions clamp an item stack's damage to the item's max damage.
        sword: Item = item(resource_location("minecraft:diamond_sword"))
        stack: ItemStack = item_stack(sword, 3)
        entity: ItemEntity = item_entity(level, origin.x(), origin.y(), origin.z(), stack)
        Test.assert(entity.damage() == 3, "The item entity should carry the stack's damage.")
        entity.entity().set_delta_movement(vec3_zero())
        entity.entity().spawn(level)
    }
}
