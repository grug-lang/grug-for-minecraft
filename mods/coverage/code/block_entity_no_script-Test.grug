# A grug block with no BlockEntity script still gets a block entity; its lazy init finds no script
# and gives up. That is GrugBlockEntity.initGrug's "already attempted" and "no handle" branches and
# GrugBlock.getEntityFileId's "no block entity string" branch.
export run() {
    if Test.tick() == 0 {
        level: Level = Test.get_client_level()
        origin: Vec3 = Test.get_origin()
        x: number = origin.x() + 4

        level.place_block(x, origin.y(), origin.z(), "grug:coverage_model_cube")
        be_opt: Option[BlockEntity] = level.get_block_entity(x, origin.y(), origin.z())
        Test.assert(be_opt.has(), "the block has no block entity.")
        Test.not_done()
    } else if Test.tick() < 5 {
        # Let the block entity tick and retry its init.
        Test.not_done()
    } else {
        Test.assert(true, "reached")
    }
}
