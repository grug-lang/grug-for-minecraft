# Covers the mob cap overlay's corner lines through the loader's own HUD hook: K shows them, and the
# golden holds the three labels with their "count / cap" numbers. The counts are every entity of the
# class in the whole world, which the game's own spawner changes, so the test fixes them. It removes
# every mob of each category, then spawns mobs in the same tick until each count is one more than the
# category's cap, 80 hostile, 17 passive and 6 water on Beta for one player alone (the caps are 79, 16
# and 5), and 71, 11 and 6 on 1.20.6 (70, 10 and 5). Beta lets a category spawn only while its count is
# at most its cap and 1.20.6 only while it is below it, so at cap + 1 the spawner adds nothing on
# either, and the number is exactly that.
# The fill waits until the world's own counts and caps have held unchanged for 20 ticks. A chunk that
# finishes loading after the fill brings the mobs its entity storage holds, which no earlier sweep could
# remove (#1819), and such a load changes a count or the cap of a chunk entering a player's set, so it
# resets the wait instead. From the fill on, every tick asserts each count is exactly the target and
# nothing repairs a category: a mob that died, despawned, was removed or arrived after the wait fails
# the test instead of reaching the golden (#1849). The tick-0 case below pins that rule against the
# review's example, one death and two arrivals, which is cap + 2 and must fail.
# The spawned mobs stand behind the camera, which looks along +z from the room's middle, so they
# are never in the capture: mobs jostling in view put a different picture behind the text in
# every run. They are removed when the next room is built. Alpha 1.1.2_01 has flat caps of 200 and 15,
# so its counts are 201 and 16, and no water mobs, so its overlay has two lines and the test fills
# two categories. Its hostile mob is a zombie: the zombie pigman does not exist yet, and a slime, which
# the test used before, is the one Alpha monster that multiplies. Alpha's EntitySlime.die spawns four
# half-size slimes when a slime above size 1 dies (the a0.2.1 server's fh.j(), lines 88 to 102), so one
# death takes one mob away and puts four back, which is the 201 that became 204 in #1580. Nothing in
# the spawner adds those: NaturalSpawner.tick only spawns while getEntityCount(class) < cap, and 201
# is past 200, and the dedicated leg's spawner is off in any case, because Alpha reads a property
# named "monsters" and the harness writes only "spawn-monsters". Alpha's Entity.move resolves entity
# collisions only in y, so mobs spawned on one spot become a tower in the air, and the one that drops
# from it takes the fall as damage; the zombie is spawned one to a cell of the cleared floor, a block
# apart, so no two boxes overlap and nothing stacks. The numbers are checked against a known spawn by
# mods/coverage's mob_cap-Test. On a loader with no world overlay hooks the test returns before it
# presses anything.
started: bool = false
filled: bool = false
pressed: bool = false
settled_ticks: number = 0
quiet_ticks: number = 0
waited: number = 0
filled_at: number = 0
captured: bool = false
last_hostile: number = -1
last_hostile_cap: number = -1
last_passive: number = -1
last_passive_cap: number = -1
last_water: number = -1
last_water_cap: number = -1
hostile_id: string = "PigZombie"
passive_id: string = "Pig"
water_id: string = "Squid"

export init(ctx: TestInitContext) {
    # The fill waits for the world's own counts and caps to hold, which took 140 ticks on the 1.20.6
    # dedicated leg, and the count still has to hold for 60 more after it, so the default 200 is
    # short of that. 600 leaves room for a slower world while a test that waits forever still fails.
    ctx.set_max_ticks(600)
}

export tick(ctx: TestTickContext) {
    if not started {
        started = true
        if not me.world_overlay_supported() {
            return
        }
        # The hold's rule has no tolerance: the review's example, one death and two arrivals, is
        # cap + 2 and must fail rather than be repaired (#1849).
        cap: number = ctx.get_client_level().get_mob_cap("hostile")
        ctx.assert(not _at_target(cap + 2, cap), "A count above the target must fail, so a death followed by arrivals cannot pass.")
        ctx.assert(not _at_target(cap - 1, cap), "A count below the target must fail.")
        ctx.assert(_at_target(cap + 1, cap), "The target count must pass.")
        if me.loader_name() == "a1.1.2_01-ornithe" {
            ctx.set_box_radius(20)
        } else {
            ctx.set_box_radius(6)
        }
        ctx.not_done()
        return
    }

    waited = waited + 1
    ctx.assert(waited < 1500, "The mob cap overlay test should finish.")
    if filled {
        _check_counts(ctx)
    }

    if not ctx.world_settled() {
        settled_ticks = 0
        quiet_ticks = 0
        ctx.not_done()
        return
    }
    if settled_ticks < 5 {
        settled_ticks = settled_ticks + 1
        ctx.not_done()
        return
    }

    if not filled {
        if not _world_ready(ctx.get_client_level()) {
            ctx.not_done()
            return
        }
        filled = true
        filled_at = waited
        if me.loader_name() == "a1.1.2_01-ornithe" {
            hostile_id = "Zombie"
        }
        if me.loader_name() == "1.20.6-forge" {
            hostile_id = "minecraft:zombified_piglin"
            passive_id = "minecraft:pig"
            water_id = "minecraft:squid"
        }
        _fill(ctx, hostile_id, "hostile")
        _fill(ctx, passive_id, "passive")
        if ctx.get_client_level().has_mob_category("water") {
            _fill(ctx, water_id, "water")
        }
        print3("passive count right after the fill, tick", ctx.get_client_level().count_mobs("passive"), waited)
        print3("hostile count and cap right after the fill, tick", ctx.get_client_level().count_mobs("hostile"), waited)
        ctx.not_done()
        return
    }
    # K is pressed a tick after the fill. On 1.20.6 the test's level is the integrated server's and
    # the overlay reads the client's mirror of it, which learns of the mobs from the packets the fill's
    # tick sent, so the press, which waits for the client thread, comes after them.
    if not pressed {
        pressed = true
        ctx.press_world_key(75, false)
        ctx.not_done()
        return
    }

    if not ctx.world_overlay_drawn() {
        ctx.not_done()
        return
    }
    # Three lines of 12 GUI pixels at the 3x scale of a 1280x720 frame, and "count / cap" ends at
    # 106 GUI pixels at its widest.
    if not captured {
        captured = true
        ctx.screenshot().equals(r"screenshots/overlay_labels", 0, 0, 330, 120)
    }
    # The counts have to hold for 60 ticks after the fill, not only up to the capture: a mob that
    # dies in that window could as well have died before the capture, in another run, and moved the
    # golden's numbers. The duration is the thing waited for, and _check_counts asserts on every one
    # of these ticks.
    if waited < filled_at + 60 {
        ctx.not_done()
        return
    }

    # The overlay is one entity for the whole run: K hides the lines again, or they would sit in
    # every later test's captures.
    ctx.press_world_key(75, false)
}

# Whether the world's own counts and caps have held unchanged for 20 ticks. A chunk that finishes
# loading changes a count when it brings the mobs its entity storage holds, and a chunk entering a
# player's set changes a cap, so either resets the wait. Once the answer is true no chunk load is still
# delivering mobs, and the fill's sweep can remove every one of them (#1819).
local _world_ready(level: Level) bool {
    hostile: number = level.count_mobs("hostile")
    passive: number = level.count_mobs("passive")
    hostile_cap: number = level.get_mob_cap("hostile")
    passive_cap: number = level.get_mob_cap("passive")
    water: number = -1
    water_cap: number = -1
    if level.has_mob_category("water") {
        water = level.count_mobs("water")
        water_cap = level.get_mob_cap("water")
    }
    steady: bool = true
    if hostile != last_hostile {
        steady = false
    }
    if passive != last_passive {
        steady = false
    }
    if water != last_water {
        steady = false
    }
    if hostile_cap != last_hostile_cap {
        steady = false
    }
    if passive_cap != last_passive_cap {
        steady = false
    }
    if water_cap != last_water_cap {
        steady = false
    }
    if steady {
        quiet_ticks = quiet_ticks + 1
    } else {
        quiet_ticks = 0
        last_hostile = hostile
        last_passive = passive
        last_water = water
        last_hostile_cap = hostile_cap
        last_passive_cap = passive_cap
        last_water_cap = water_cap
    }
    return quiet_ticks >= 20
}

# Removes the category's mobs, then spawns them spread over the room until the world holds one more
# than the cap.
local _fill(ctx: TestTickContext, id: string, category: string) {
    level: Level = ctx.get_client_level()
    origin: Vec3 = ctx.get_origin()
    target: number = level.get_mob_cap(category) + 1
    ctx.remove_entities(level, category)
    # The room's torch floor is 3 blocks below the player's feet and the player's feet are 4.62
    # below the origin (the 3.0 lift and the 1.62 eye), so the floor's surface is 7.62 below the
    # origin and a mob spawned there stands on it. On Alpha the hostile rows are 16 to 20 blocks
    # from the player, past the 16 the test area clears, so the room's inside there still holds the
    # world's terrain over the floor. The cells each mob's body fills are cleared here, so a hostile
    # stands on the floor rather than on a ledge it can walk off.
    floor_y: number = origin.y() - 7.62 + 0.01
    alpha: bool = me.loader_name() == "a1.1.2_01-ornithe"
    if alpha and category == "hostile" {
        _clear_terrain(level, origin)
    }
    # Beta and 1.20.6 fit their cap in a room 6 blocks wide: one row 5 blocks behind the player, 11
    # cells wide, so a cell holds several mobs and their boxes overlap, which their Entity.move
    # resolves sideways. Alpha's resolves only in y, so mobs spawned on one spot become a tower in
    # the air, and the one that drops from it takes the fall as damage. Alpha therefore stands one
    # mob to a cell: its 201 hostiles in the five rows from 20 blocks behind the player to 16, which
    # is the 41 cells the room's floor is wide by the five rows outside the test area's 16, the band
    # _clear_terrain empties, and its 16 passive mobs in one row 12 blocks behind it, inside the
    # cleared area.
    z: number = origin.z() - 5
    if alpha {
        z = origin.z() - 12
        if category == "hostile" {
            z = origin.z() - 20
        }
    }
    i: number = 0
    while level.count_mobs(category) < target {
        x: number = origin.x() - 5 + Math.remainder(i, 11)
        row: number = z
        if alpha and category == "hostile" {
            x = origin.x() - 20 + (i - Math.floor(i / 41) * 41)
            row = z + Math.floor(i / 41)
        } else if alpha {
            x = origin.x() - 7 + i
        }
        ctx.spawn_mob(level, id, x, floor_y, row)
        i = i + 1
        ctx.assert(i < 300, "Spawning should reach the target.")
    }
}

# Asserts every category still holds exactly one more than its cap, and prints what it found when a
# count moved. There is no repair: refilling an over-count could hide a death that arrivals masked,
# so any change fails the test (#1849).
local _check_counts(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    if not _at_target(level.count_mobs("hostile"), level.get_mob_cap("hostile")) {
        print3("hostile count and cap", level.count_mobs("hostile"), level.get_mob_cap("hostile"))
    }
    if not _at_target(level.count_mobs("passive"), level.get_mob_cap("passive")) {
        print3("passive count and cap", level.count_mobs("passive"), level.get_mob_cap("passive"))
        print3("passive count and tick of the first difference", level.count_mobs("passive"), waited)
    }
    if level.has_mob_category("water") {
        if not _at_target(level.count_mobs("water"), level.get_mob_cap("water")) {
            print3("water count and cap", level.count_mobs("water"), level.get_mob_cap("water"))
        }
    }
    ctx.assert(_at_target(level.count_mobs("hostile"), level.get_mob_cap("hostile")), "The hostile count should stay one over its cap.")
    ctx.assert(_at_target(level.count_mobs("passive"), level.get_mob_cap("passive")), "The passive count should stay one over its cap.")
    if level.has_mob_category("water") {
        ctx.assert(_at_target(level.count_mobs("water"), level.get_mob_cap("water")), "The water count should stay one over its cap.")
    }
}

# The one count the golden holds: one more than the cap. The tick-0 case above checks the rule on the
# counts a death and two arrivals, or a death alone, would leave, so no tolerance creeps back in.
local _at_target(found: number, cap: number) bool {
    return found == cap + 1
}

# Clears the terrain that the room build leaves between the test area (16 blocks from the player) and
# the room's wall (20), over the band Alpha's hostile rows occupy and their wandering reaches, from the
# layer over the torch floor up to above the highest surface seen there (68).
local _clear_terrain(level: Level, origin: Vec3) {
    floor_y: number = Math.floor(origin.y() - 7.62 + 0.5)
    x: number = Math.floor(origin.x()) - 20
    while x <= Math.floor(origin.x()) + 20 {
        z: number = Math.floor(origin.z()) - 20
        while z <= Math.floor(origin.z()) - 16 {
            y: number = floor_y + 1
            while y <= floor_y + 12 {
                level.place_block(x, y, z, "minecraft:air")
                y = y + 1
            }
            z = z + 1
        }
        x = x + 1
    }
}
