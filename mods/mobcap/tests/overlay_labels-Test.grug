# Covers the mob cap overlay's corner lines through the loader's own HUD hook: K shows them, and the
# golden holds the three labels with their "count / cap" numbers. The counts are every entity of the
# class in the whole world, which the game's own spawner changes, so the test fixes them. It removes
# every mob of each category, then spawns mobs in the same tick until each count is one more than the
# category's cap, 80 hostile, 17 passive and 6 water on Beta for one player alone (the caps are 79, 16
# and 5), and 71, 11 and 6 on 1.20.6 (70, 10 and 5). Beta lets a category spawn only while its count is
# at most its cap and 1.20.6 only while it is below it, so at cap + 1 the spawner adds nothing on
# either, and the number is exactly that. Every tick up to the capture asserts the
# counts are still those, so a mob that died or despawned fails the test and cannot reach the golden.
# The spawned mobs stand in a row behind the camera, which looks along +z from the room's middle, so
# they are never in the capture: mobs jostling in view put a different picture behind the text in
# every run. They are removed when the next room is built. Alpha 1.1.2_01 has flat caps of 200 and 15,
# so its counts are 201 and 16, and no water mobs, so its overlay has two lines and the test fills
# two categories. Its hostile mob is a slime: every other Alpha monster attacks a player within 16 blocks
# and the zombie pigman does not exist yet, whereas a slime does nothing to a player that stays far
# from it. The room is as wide as the game allows, with the row 17 blocks behind the player, so the
# 201 slimes start out of the 16 blocks in which a slime turns to the player and hops at it, and not one
# touches the player before the capture. The numbers are checked against a known
# spawn by mods/coverage's mob_cap-Test. On a loader with no world overlay hooks the test returns before it presses anything.
started: bool = false
filled: bool = false
pressed: bool = false
settled_ticks: number = 0
waited: number = 0
filled_at: number = 0
captured: bool = false

export tick(ctx: TestTickContext) {
    if not started {
        started = true
        if not me.world_overlay_supported() {
            return
        }
        if me.loader_name() == "a1.1.2_01-ornithe" {
            ctx.set_box_radius(20)
        } else {
            ctx.set_box_radius(6)
        }
        ctx.not_done()
        return
    }

    waited = waited + 1
    if filled {
        _check_counts(ctx)
    }
    ctx.assert(waited < 1500, "The mob cap overlay test should finish.")

    if not ctx.world_settled() {
        settled_ticks = 0
        ctx.not_done()
        return
    }
    if settled_ticks < 5 {
        settled_ticks = settled_ticks + 1
        ctx.not_done()
        return
    }

    if not filled {
        filled = true
        filled_at = waited
        hostile_id: string = "PigZombie"
        passive_id: string = "Pig"
        water_id: string = "Squid"
        if me.loader_name() == "a1.1.2_01-ornithe" {
            hostile_id = "Slime"
        }
        if me.loader_name() == "1.20.6-forge" {
            hostile_id = "minecraft:zombified_piglin"
            passive_id = "minecraft:pig"
            water_id = "minecraft:squid"
        }
        _fill(ctx, hostile_id, "hostile")
        _fill(ctx, passive_id, "passive")
        if ctx.get_client_level().has_mob_category("water") {
            _fill(ctx, water_id, "water")
        }
        print3("passive count right after the fill, tick", ctx.get_client_level().count_mobs("passive"), waited)
        print3("hostile count and cap right after the fill, tick", ctx.get_client_level().count_mobs("hostile"), waited)
        ctx.not_done()
        return
    }
    # K is pressed a tick after the fill. On 1.20.6 the test's level is the integrated server's and
    # the overlay reads the client's mirror of it, which learns of the mobs from the packets the fill's
    # tick sent, so the press, which waits for the client thread, comes after them.
    if not pressed {
        pressed = true
        ctx.press_world_key(75, false)
        ctx.not_done()
        return
    }

    if not ctx.world_overlay_drawn() {
        ctx.not_done()
        return
    }
    # Three lines of 12 GUI pixels at the 3x scale of a 1280x720 frame, and "count / cap" ends at
    # 106 GUI pixels at its widest.
    if not captured {
        captured = true
        ctx.screenshot().equals(r"screenshots/overlay_labels", 0, 0, 330, 120)
    }
    # The counts have to hold for 60 ticks after the fill, not only up to the capture: the mobs that
    # would die of a fall die and leave the world 31 ticks after they land. The capture comes first
    # because the 201 slimes wander to the player, a slime within 16 blocks hops at it, and one that
    # pushes the player moves the camera by tenths of a block and shifts the dark wall's texture by
    # pixels. The duration is the thing waited for, and _check_counts asserts on every one of these
    # ticks.
    if waited < filled_at + 60 {
        ctx.not_done()
        return
    }

    # The overlay is one entity for the whole run: K hides the lines again, or they would sit in
    # every later test's captures.
    ctx.press_world_key(75, false)
}

# Removes the category's mobs, then spawns them spread over the room until the world holds one more
# than the cap.
local _fill(ctx: TestTickContext, id: string, category: string) {
    level: Level = ctx.get_client_level()
    origin: Vec3 = ctx.get_origin()
    target: number = level.get_mob_cap(category) + 1
    ctx.remove_entities(level, category)
    # The room's torch floor is 3 blocks below the player's feet and the player's feet are 4.62
    # below the origin (the 3.0 lift and the 1.62 eye). A mob spawned at the origin falls 7.62
    # blocks onto the floor and takes 5 damage, which kills every Alpha slime of size 1 and 2
    # (health 1 and 4) 31 ticks after it lands. On Alpha the row is also 17 blocks from the player,
    # past the 16 blocks the test area clears, so the room's inside there still holds the world's
    # terrain, with surfaces at y 64, 65 and 68 over the floor at 61. A slime that lands on a
    # ledge takes the fall to the ledge and one that walks off it takes the rest. The terrain behind
    # the row is cleared here, so every slime stands on the floor, and the row spawns on it.
    floor_y: number = origin.y() - 7.62 + 0.01
    if me.loader_name() == "a1.1.2_01-ornithe" {
        _clear_terrain(level, origin)
    }
    z: number = origin.z() - 5
    if me.loader_name() == "a1.1.2_01-ornithe" {
        z = origin.z() - 17
    }
    i: number = 0
    while level.count_mobs(category) < target {
        ctx.spawn_mob(level, id, origin.x() - 5 + Math.remainder(i, 11), floor_y, z)
        i = i + 1
        ctx.assert(i < 300, "Spawning should reach the target.")
    }
}

local _check_counts(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    # A count that moved says which category, its count and its cap, so a leg's log names the
    # difference instead of only that one exists (#1040).
    if level.count_mobs("hostile") != level.get_mob_cap("hostile") + 1 {
        print3("hostile count and cap", level.count_mobs("hostile"), level.get_mob_cap("hostile"))
    }
    if level.count_mobs("passive") != level.get_mob_cap("passive") + 1 {
        print3("passive count and cap", level.count_mobs("passive"), level.get_mob_cap("passive"))
        print3("passive count and tick of the first difference", level.count_mobs("passive"), waited)
    }
    ctx.assert(level.count_mobs("hostile") == level.get_mob_cap("hostile") + 1, "The hostile count should stay one over its cap.")
    ctx.assert(level.count_mobs("passive") == level.get_mob_cap("passive") + 1, "The passive count should stay one over its cap.")
    if level.has_mob_category("water") {
        ctx.assert(level.count_mobs("water") == level.get_mob_cap("water") + 1, "The water count should stay one over its cap.")
    }
}

# Clears the terrain that the room build leaves between the test area (16 blocks from the player) and
# the room's wall (20), over the part of it that the row of mobs and their wandering reach, from the
# layer over the torch floor up to above the highest surface seen there (68).
local _clear_terrain(level: Level, origin: Vec3) {
    floor_y: number = Math.floor(origin.y() - 7.62 + 0.5)
    x: number = Math.floor(origin.x()) - 14
    while x <= Math.floor(origin.x()) + 14 {
        z: number = Math.floor(origin.z()) - 20
        while z <= Math.floor(origin.z()) - 16 {
            y: number = floor_y + 1
            while y <= floor_y + 12 {
                level.place_block(x, y, z, "minecraft:air")
                y = y + 1
            }
            z = z + 1
        }
        x = x + 1
    }
}
