# Exercises mod_api entry points that no real mod path reaches yet, so they stay covered.
# Placing foo_block makes examplemod's BlockEntity run its own module-level calls (above_n, item,
# item_stack, item_entity, set_delta_movement, spawn, vec3_zero) and its 10-tick spawn, which is
# why the test waits a few ticks rather than finishing on tick 0.
export run() {
    if Test.tick() == 0 {
        level: Level = Test.get_client_level()
        origin: Vec3 = Test.get_origin()
        x: number = origin.x()
        y: number = origin.y()
        z: number = origin.z()

        level.place_block(x, y, z, "grug:foo_block")
        table_opt: Option[BlockEntity] = level.get_block_entity(x, y, z)
        Test.assert(table_opt.has(), "foo_block has no block entity after being placed.")
        table: BlockEntity = table_opt.unwrap()

        # BlockPos.above_n directly, in addition to the copy foo_block's script runs.
        above: BlockPos = get_block_pos_of_block_entity(table).above_n(2)
        Test.assert(above.center().y() > origin.y(), "above_n did not move the position up.")

        # item / resource_location / item_stack / item_entity / Entity.set_delta_movement /
        # Entity.spawn / vec3_zero.
        diamond: Item = item(resource_location("minecraft:diamond"))
        stack: ItemStack = item_stack(diamond)
        entity: ItemEntity = item_entity(level, x, y, z, stack)
        entity.entity().set_delta_movement(vec3_zero())
        entity.entity().spawn(level)

        # drop_inventory on a fresh chest, which has an empty inventory.
        level.place_block(x + 2, y, z, "minecraft:chest")
        chest_opt: Option[BlockEntity] = level.get_block_entity(x + 2, y, z)
        Test.assert(chest_opt.has(), "chest has no block entity after being placed.")
        drop_inventory(level, x + 2, y, z)

        # The print family.
        print("print")
        print2("print2", 2)
        print3("print3", 2, true)

        Test.not_done()
    } else if Test.tick() < 15 {
        # Let foo_block's BlockEntity tick far enough to run its 10-tick spawn once.
        Test.not_done()
    }
}
