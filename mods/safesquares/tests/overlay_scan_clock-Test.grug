# Covers the overlay's scan when the level's clock goes backwards (#1255). The overlay keeps the
# level time of its last scan and takes the next batch when update_rate ticks of level time have
# passed. A world whose clock is below the last scan's, as a newly joined world's or one whose time
# was set back can be, leaves the new time below that mark, and a scan that only asks whether enough
# time has passed would hold the old batch off for hours of level time. The scan is therefore due
# when the clock is at or past the last scan and the interval has passed, or when the clock is below
# the last scan at all.

# The test marks the player's own feet square, jumps the clock 100000 ticks forward and waits for the
# scan that follows, so the last scan is far above the world's first time. It then puts a torch in
# the square, sets the clock back to where it started in the same tick, and asks for frames. A scan
# on the backwards clock sees the torch and draws nothing; a scan held off keeps drawing the batch
# from the forward scan, which still holds the square dark and marked, and the mark stays.

# The player is never moved: the scan is a cube of radius render_distance around the block the feet
# are in, and a radius-15 room seals the cube of radius 16 around them, so a square of the open
# world's ground under the sky is not marked yellow and cannot decide the check. The room's torches
# within three blocks of the player's column are taken away, which leaves the feet block at the
# safe level and marked, as overlay_unmarked explains. The key pressed to clear the drawn flag is
# one the overlay does not take, so the state it checks is the same one its own scan decides.

# A joined client's level is the server's mirror, so the time and the block reach it in packets. The
# block is waited for with the world settle, and the time with a press whose frame draws nothing:
# the test's own level is the server's on a dedicated run, so the client's clock has no read here.
# The press is bounded, so a scan that did not run on the backwards clock cannot pass the test: the
# forward batch it would hold is 100000 ticks away from being due again.
state: number = 0
waited: number = 0
rate: number = 0
safe: number = 0
original_time: number = 0
jump_to: number = 0
forward_at: number = 0
forward_waited: number = 0
settled: number = 0
presses: number = 0
cleared_at: number = 0
drawn_waited: number = 0
px: number = 0
py: number = 0
pz: number = 0

# The room build, the light settles and the scan waits together are longer than the default
# budget, so the budget is raised rather than a wait shortened. A radius-15 room seals the cube
# the overlay scans, which is the room_sky_light test's radius-13 wait plus a wider shell.
export init(ctx: TestInitContext) {
    ctx.set_max_ticks(3000)
}

export tick(ctx: TestTickContext) {
    waited = waited + 1
    ctx.assert(waited < 3000, "The backwards clock test should finish.")
    level: Level = ctx.get_client_level()

    if state == 0 {
        if not me.world_overlay_supported() {
            return
        }
        ctx.set_box_radius(15)
        state = 1
        ctx.not_done()
        return
    }

    if state == 1 {
        if not ctx.world_settled() {
            ctx.not_done()
            return
        }
        cfg: Config = ctx.get_config()
        rate = cfg.number("update_rate")
        safe = cfg.number("safe_light_level")
        feet: Vec3 = ctx.get_player().position()
        px = Math.floor(feet.x())
        py = Math.floor(feet.y())
        pz = Math.floor(feet.z())
        level.place_block(px, py - 1, pz, "minecraft:stone")
        # The torches near the player's column go, leaving the feet block at the safe level and the
        # floor spaces around it lit to at least 10, as overlay_unmarked explains.
        a: number = -3
        while a <= 3 {
            b: number = -3
            while b <= 3 {
                level.place_block(px + a, py - 3, pz + b, "minecraft:air")
                b = b + 1
            }
            a = a + 1
        }
        state = 2
        ctx.not_done()
        return
    }

    if state == 2 {
        if not level.is_hostile_spawn_space(px, py, pz) {
            ctx.not_done()
            return
        }
        if level.get_block_light(px, py, pz) > safe {
            ctx.not_done()
            return
        }
        if not ctx.light_applied(px, py, pz) {
            ctx.not_done()
            return
        }
        original_time = level.get_time()
        # L turns the overlay on, and its first scan is immediate.
        ctx.press_world_key(76, false)
        state = 3
        ctx.not_done()
        return
    }

    if state == 3 {
        # The mark of the first scan, read from a frame the press asked for.
        if not ctx.world_overlay_drawn() {
            drawn_waited = drawn_waited + 1
            ctx.assert(drawn_waited < 200, "The square at the safe level should be marked before the clock moves.")
            ctx.not_done()
            return
        }
        jump_to = level.get_time() + 100000
        level.set_time(jump_to)
        state = 4
        ctx.not_done()
        return
    }

    if state == 4 {
        # The client's mirror learns the new time from a packet every 20 ticks, so the clock the
        # overlay scans is waited for. The server's own read is enough for the range check, and the
        # press asks for the frame that follows it.
        if level.get_time() < jump_to {
            ctx.world_overlay_drawn()
            ctx.not_done()
            return
        }
        forward_at = level.get_time()
        # A press clears the drawn mark the first scan set and asks for a frame, so the forward
        # scan's own answer is a draw this wait can see rather than the first scan's mark.
        ctx.press_world_key(75, false)
        forward_waited = 0
        state = 5
        ctx.not_done()
        return
    }

    if state == 5 {
        # Wait on the scan's own answer, not on the clock alone: the mark drawn again is a frame
        # that scanned at the forward time, which is what records the last scan far above the
        # world's first time. A scan that never ran leaves the mark off and the test fails here.
        forward_waited = forward_waited + 1
        ctx.assert(forward_waited < 4 * rate + 120, "The forward scan should run.")
        if not ctx.world_overlay_drawn() {
            ctx.not_done()
            return
        }
        # The torch goes into the square, and its own wait follows before the clock moves, so a
        # joined client cannot see the backwards time and the torch in the other order.
        level.place_block(px, py, pz, "minecraft:torch")
        state = 6
        ctx.not_done()
        return
    }

    if state == 6 {
        # The torch reaches a joined client in a packet, and the light wait is the one the client
        # can compare, which inside this room it cannot on 1.2.5 (it answers true without
        # comparing, #1207), so the world settle waits for the client's copy to hold the placed
        # torch before the clock is moved.
        if not ctx.light_applied(px, py, pz) {
            ctx.world_overlay_drawn()
            ctx.not_done()
            return
        }
        if settled == 0 {
            if not ctx.world_settled() {
                ctx.not_done()
                return
            }
            settled = 1
        }
        # The clock goes back only now, so the batch the next frame holds is the forward one,
        # which still has the square dark. A scan on the backwards clock drops it; one held off
        # keeps it, which is what the check below reads. The press also clears the mark.
        level.set_time(original_time)
        ctx.press_world_key(75, false)
        presses = presses + 1
        cleared_at = ctx.current_tick()
        state = 7
        ctx.not_done()
        return
    }

    if state == 7 {
        if ctx.current_tick() - cleared_at < 12 {
            ctx.world_overlay_drawn()
            ctx.not_done()
            return
        }
        if ctx.world_overlay_drawn() {
            # The client's own clock has not gone back yet, so its batch is still the forward one
            # and this frame redrew it. Another press asks for a newer frame once it has, and the
            # bound keeps a scan that never took the backwards branch from passing: its batch is
            # 100000 ticks from being due again, so every press would draw it.
            ctx.assert(presses < 8, "A backwards clock should scan at once and drop the removed square.")
            ctx.press_world_key(75, false)
            presses = presses + 1
            cleared_at = ctx.current_tick()
            ctx.not_done()
            return
        }
        # L again turns the overlay off, so no later test draws its marks.
        ctx.press_world_key(76, false)
        cleared_at = ctx.current_tick()
        state = 8
        ctx.not_done()
        return
    }

    if ctx.current_tick() - cleared_at < 12 {
        ctx.world_overlay_drawn()
        ctx.not_done()
        return
    }
    ctx.assert(not ctx.world_overlay_drawn(), "The overlay should be off after the second press of L.")
}
