# Covers the overlay's two crosses in one capture: red where a hostile mob can spawn at any time
# and yellow where one can spawn only at night. A platform of vanilla stone over the room at the
# player's block hides the torch floor, so the platform's squares are dark spawn spaces with no
# block light, and they are low in a level camera's view (the camera cannot be pitched), where the
# room's own floor, four blocks lower, is below the frame. The platform is stone and not a block of
# SafeSquares' own: a port ships no content its reference does not, and the #1550 flake the flat
# block was added for was a joined client's camera within 1/1024 of a block of the singleplayer eye,
# which #1720 snapped and levelled, so the camera is the loader's to settle and the fixture is
# vanilla again. One block of the roof is opened, so the sky lights the platform under the hole and
# a few squares around it (Beta spreads sky light one less per block) while the far side of the
# room gets none. Squares under the hole are yellow (the sky lights them by day only), and the rest
# are red. The test reads one square of each kind from the light the client holds and waits for both
# before it turns the overlay on, so a capture that cannot hold both crosses fails here rather than
# as a golden that was accepted with only one. The golden is the position check: every cross in the
# crop is drawn where the square is, from the camera, which looks towards +z, so the hole's side is
# on the left. The crop stops at x 840: the player's held item is drawn at the bottom right and
# differs between the client-only run and the installed jar's, which is not what this test is about,
# and every cross stays inside it.
# The sky light that is drawn depends on the clock (1.2.5 draws the stored sky light less a darkness
# that follows the time of day; Alpha and Beta do the same), so the test sets noon before it places
# the platform, and every capture is at the same hour whatever the run's clock was (#1550).
state: number = 0
waited: number = 0
settled_ticks: number = 0
fy: number = 0
hx: number = 0
hz: number = 0
px: number = 0
py: number = 0
pz: number = 0
clock_at: number = 0

export tick(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    waited = waited + 1
    late: bool = waited >= 1500

    if state == 0 {
        if not me.world_overlay_supported() {
            return
        }
        level.set_time(6000)
        ctx.set_box_radius(6)
        origin: Vec3 = ctx.get_origin()
        px = Math.floor(origin.x())
        # The origin is the camera plus 3, and the eye is 1.62 above the feet the room is built around.
        py = Math.floor(origin.y() - 4.12)
        pz = Math.floor(origin.z())
        # The squares are on a stone platform the test lays over the room at the block the player
        # stands on, so they are 1.62 below the eye: the room's own floor is four blocks lower, which
        # a level camera cannot see at this distance, and its torches would light them from below.
        fy = py
        hx = px + 5
        hz = pz + 5

        clock_at = waited
        state = 4
        ctx.not_done()
        return
    }

    if state == 4 {
        # A joined client, and 1.20.6's, learn the new time from a packet the server sends every 20 ticks, and
        # a mesh built before it keeps the old hour's light, so the platform is placed only after 40 ticks, which
        # outlast one packet, and its blocks are the ones that rebuild the meshes in view (#1550).
        if waited - clock_at < 40 {
            ctx.not_done()
            return
        }
        x: number = px - 6
        while x <= px + 6 {
            z: number = pz - 6
            while z <= pz + 6 {
                level.place_block(x, fy - 1, z, "minecraft:stone")
                z = z + 1
            }
            x = x + 1
        }

        # The roof is the room's top layer, at py + 13; terrain over the hole would shade it, so the
        # column over it is cleared too.
        hy: number = py + 13
        while hy <= py + 45 {
            level.place_block(hx, hy, hz, "minecraft:air")
            hy = hy + 1
        }
        state = 1
        ctx.not_done()
        return
    }

    if state == 1 {
        # Yellow under the hole, red on the far side of the room from it, both on a bare floor.
        ctx.assert(not (late and level.get_block_light(hx, fy, hz) != 0), "Wait 1: the square under the hole should lose its block light.")
        ctx.assert(not (late and level.get_block_light(hx - 10, fy, hz - 2) != 0), "Wait 2: the far square should lose its block light.")
        ctx.assert(not (late and level.get_sky_light(hx, fy, hz) <= 7), "Wait 3: the square under the hole should get sky light above 7.")
        ctx.assert(not (late and level.get_sky_light(hx - 10, fy, hz - 2) > 7), "Wait 4: the far square should have sky light of at most 7.")
        if level.get_block_light(hx, fy, hz) != 0 or level.get_block_light(hx - 10, fy, hz - 2) != 0 {
            ctx.not_done()
            return
        }
        if level.get_sky_light(hx, fy, hz) <= 7 or level.get_sky_light(hx - 10, fy, hz - 2) > 7 {
            ctx.not_done()
            return
        }
        ctx.assert(level.is_hostile_spawn_space(hx, fy, hz), "The square under the hole should be a spawn space.")
        ctx.assert(level.is_hostile_spawn_space(hx - 10, fy, hz - 2), "The square far from the hole should be a spawn space.")
        state = 2
        ctx.not_done()
        return
    }

    ctx.assert(not late, "Wait 5: the world should settle and the overlay draw.")

    if state == 2 {
        if not ctx.world_settled() {
            settled_ticks = 0
            ctx.not_done()
            return
        }
        if settled_ticks < 5 {
            settled_ticks = settled_ticks + 1
            ctx.not_done()
            return
        }
        ctx.press_world_key(76, false)
        state = 3
        ctx.not_done()
        return
    }

    if not ctx.world_overlay_drawn() {
        ctx.not_done()
        return
    }
    ctx.screenshot().equals(r"screenshots/overlay_crosses", 100, 430, 840, 640)

    # The overlay is one entity for the whole run: L turns it off again, or its crosses would sit in
    # every later test's captures.
    ctx.press_world_key(76, false)
}
