# The item list on the player's inventory screen: it is drawn while the screen is open, and its
# clicks follow the reference's cheat-mode bindings. A left or right click gives one item, a middle
# click or shift+left gives a stack, and a left click while the cursor carries an item deletes that
# stack unless the clicked item is the one it carries, which is DeleteItemInputHandler's
# shouldDeleteItemOnClick and ServerCommandUtil.canStack. A click on a cell with no item deletes too,
# because the reference asks only whether the mouse is over the grid. JEI's own give sends the item
# to the server, so the test waits for the client to receive it in the player's hand rather than
# reading it back at once.

# The overlay is drawn on every loader now; a loader that does not ask it still returns on its first
# tick without opening a screen, so the test skips there instead of failing for a missing feature.
started: bool = false
opened: bool = false
waited: number = 0
step: number = 0

# The cell the one-item clicks use. The stack cell is found in the list itself, because the item
# order differs by version: the first item whose full stack is 64 is the one the middle click can
# tell from a single item.
clicked_column: number = 2
clicked_row: number = 5
stack_column: number = 1
stack_row: number = 0

export tick(ctx: TestTickContext) {
    if not started {
        started = true
        if not me.overlay_supported() {
            # This loader draws no overlays; the deviation is in about.json.
            return
        }
        ctx.close_screen()
        ctx.not_done()
        return
    }

    # A world frame has to be drawn before a screen that shows the player opens: the inventory
    # draws the player with the entity renderer, whose texture manager and camera the world's own
    # entity pass fills in, and a selection whose first test ticks before any frame has drawn (a
    # `-f mods=jei` dispatch runs a jei test first) would otherwise crash the client (#1287). The
    # test box's light is queued before the test's own clock starts and the game runs ten ticks for
    # one frame, so the first settle can take a few hundred of the test's ticks; the failure bound
    # is what says it never came, not a wait.
    if not opened {
        waited = waited + 1
        ctx.assert(waited < 1000, "The world should settle before the inventory opens.")
        if not ctx.world_settled() {
            ctx.not_done()
            return
        }
        ctx.open_inventory(ctx.get_player())
        opened = true
        waited = 0
        ctx.not_done()
        return
    }

    if not ctx.screen_open() {
        waited = waited + 1
        ctx.assert(waited < 100, "The player's inventory screen should open.")
        ctx.not_done()
        return
    }

    if not ctx.overlay_drawn() {
        # The screen is up but no frame with this port's overlay on it has been drawn yet, and at
        # the run's maximum speed the test can click and close before one is. Asking turns drawing
        # on.
        waited = waited + 1
        ctx.assert(waited < 200, "A frame with the overlay should be drawn on the open screen.")
        ctx.not_done()
        return
    }

    expected: Item = item_at(clicked_row * _columns(ctx) + clicked_column)
    expected_stack: Item = item_at(stack_row * _columns(ctx) + stack_column)
    # The first cell holds an item the cursor does not carry, which the delete case needs: the
    # clicked cell is rows down the list, so the two entries are always different items.
    other: Item = item_at(0)

    if step == 0 {
        # A right click gives one item, which is the reference's cheatOneItem2. An earlier test may
        # have left something on the cursor; clearing it keeps the delete check from seeing it.
        ctx.assert(_columns(ctx) >= 3, "The test needs the grid to be at least three columns wide to click column 2.")
        # The first item whose full stack is 64 is the stack the middle click uses. The list order
        # differs by version, so scanning it is what makes the same test work on all of them.
        stack_index: number = -1
        search: number = 0
        while search < item_count() and stack_index < 0 {
            if ctx.get_item_max_stack(item_at(search)) == 64 {
                stack_index = search
            }
            search = search + 1
        }
        ctx.assert(stack_index >= 0, "The item list should hold an item whose full stack is 64.")
        stack_column = Math.remainder(stack_index, _columns(ctx))
        stack_row = Math.floor(stack_index / _columns(ctx))
        ctx.clear_carried_item()
        step = 1
        taken: bool = ctx.click_screen(_cell_x(ctx, clicked_column), _cell_y(clicked_row), 1)
        ctx.assert(taken, "The overlay should take a right click on its item, so that the vanilla slot under it is not clicked too.")
        ctx.not_done()
        return
    }

    if step == 1 {
        waited = waited + 1
        held: Option[Item] = ctx.get_player().get_held_item()
        if not held.has() {
            ctx.assert(waited < 200, "The item a right click gives should reach the player's hand.")
            ctx.not_done()
            return
        }
        ctx.assert(equals(held.unwrap(), expected), "A right click should give the clicked item.")
        ctx.assert(ctx.get_held_count(ctx.get_player()) == 1, "A right click should give one item.")
        step = 2
        ctx.not_done()
        return
    }

    if step == 2 {
        # A middle click gives a full stack, which is the reference's cheatItemStack binding. The
        # item is the one the test found whose full stack is 64, so the count can tell it from a
        # single item.
        ctx.assert(ctx.get_item_max_stack(expected_stack) == 64, "The stack item should be a 64 stack.")
        ctx.clear_held_item(ctx.get_player())
        step = 3
        taken: bool = ctx.click_screen(_cell_x(ctx, stack_column), _cell_y(stack_row), 2)
        ctx.assert(taken, "The overlay should take a middle click on its item.")
        ctx.not_done()
        return
    }

    if step == 3 {
        waited = waited + 1
        held: Option[Item] = ctx.get_player().get_held_item()
        if not held.has() {
            ctx.assert(waited < 200, "The stack a middle click gives should reach the player's hand.")
            ctx.not_done()
            return
        }
        ctx.assert(equals(held.unwrap(), expected_stack), "A middle click should give the clicked item.")
        ctx.assert(ctx.get_held_count(ctx.get_player()) == 64, "A middle click should give a full stack.")
        ctx.clear_held_item(ctx.get_player())
        step = 4
        ctx.not_done()
        return
    }

    if step == 4 {
        # A left click on an item the cursor does not carry deletes the carried stack, which is the
        # reference's DeleteItemInputHandler.shouldDeleteItemOnClick: it deletes only when the
        # clicked ingredient cannot stack with the cursor's (ServerCommandUtil.canStack).
        ctx.assert(not equals(other, expected), "The first cell should hold another item than the clicked cell.")
        ctx.set_carried_item(expected)
        carried: Option[Item] = ctx.get_carried_item()
        ctx.assert(carried.has(), "The test should be able to put an item on the cursor.")
        step = 5
        taken: bool = ctx.click_screen(_cell_x(ctx, 0), _cell_y(0), 0)
        ctx.assert(taken, "The overlay should take a left click while the cursor carries an item.")
        ctx.not_done()
        return
    }

    if step == 5 {
        ctx.assert(not ctx.get_carried_item().has(), "A left click on another item should delete the item on the cursor.")
        ctx.assert(not ctx.get_player().get_held_item().has(), "Deleting the carried item should not also give one.")
        # A left click on the item the cursor already carries gives one instead of deleting the
        # stack, because the two can stack. The port gives into the inventory where the reference
        # merges into the cursor, which is the deviation about.json records (#870).
        ctx.set_carried_item(expected)
        step = 6
        taken: bool = ctx.click_screen(_cell_x(ctx, clicked_column), _cell_y(clicked_row), 0)
        ctx.assert(taken, "The overlay should take a left click on the item the cursor carries.")
        ctx.not_done()
        return
    }

    if step == 6 {
        carried: Option[Item] = ctx.get_carried_item()
        ctx.assert(carried.has(), "A left click on the item the cursor carries should not delete it.")
        ctx.assert(equals(carried.unwrap(), expected), "The cursor should still carry the item it carried before the click.")
        waited = waited + 1
        held: Option[Item] = ctx.get_player().get_held_item()
        if not held.has() {
            ctx.assert(waited < 200, "A left click on the item the cursor carries should give one.")
            ctx.not_done()
            return
        }
        ctx.assert(equals(held.unwrap(), expected), "The item a left click gives should be the clicked one.")
        ctx.assert(ctx.get_held_count(ctx.get_player()) == 1, "A left click should give one item.")
        ctx.clear_held_item(ctx.get_player())
        ctx.clear_carried_item()
        waited = 0
        step = 7
        ctx.not_done()
        return
    }

    if step == 7 {
        # The hand is empty before the last press, so the item that arrives is the one it gives.
        if ctx.get_player().get_held_item().has() {
            waited = waited + 1
            ctx.assert(waited < 200, "The hand should be empty after it is cleared.")
            ctx.not_done()
            return
        }
        # With the cursor empty again, a left click gives one item.
        ctx.assert(not ctx.get_carried_item().has(), "The cursor should be empty before the last press.")
        step = 8
        taken: bool = ctx.click_screen(_cell_x(ctx, clicked_column), _cell_y(clicked_row), 0)
        ctx.assert(taken, "The overlay should take a left click on its item, so that the vanilla slot under it is not clicked too.")
        ctx.not_done()
        return
    }

    if step == 8 {
        waited = waited + 1
        held: Option[Item] = ctx.get_player().get_held_item()
        if not held.has() {
            ctx.assert(waited < 200, "The clicked item should reach the player's hand.")
            ctx.not_done()
            return
        }
        ctx.assert(equals(held.unwrap(), expected), "The item in the player's hand should be the one that was clicked.")
        ctx.assert(ctx.get_held_count(ctx.get_player()) == 1, "A left click should give one item.")
        ctx.clear_held_item(ctx.get_player())
        step = 9
        ctx.not_done()
        return
    }

    if step == 9 {
        if me.loader_name() == "a1.1.2_01-ornithe" {
            # Alpha has no item names, so its search matches the numeric registry name only and a
            # name like bedrock matches nothing there, which is why search-Test skips it too.
            ctx.close_screen()
            return
        }
        # An empty cell deletes the stack on the cursor too, and the press is consumed. The
        # reference's delete handler asks only whether the mouse is over the grid's area
        # (IngredientGrid.isMouseOver, IngredientGrid.java:163-165) and reads no ingredient under
        # the mouse as delete (getIngredientUnderMouse().findFirst().map(...).orElse(true),
        # DeleteItemInputHandler.java:94-101), then reports the press handled (:64-70), so the
        # screen never gets it. A search that matches a few items puts an empty cell in the first
        # row of the first page.
        ctx.assert(ctx.click_screen(_field_x(ctx), _field_y(ctx), 0), "The overlay should take a press on its search field.")
        _press_key(ctx, 66)
        _press_key(ctx, 69)
        _press_key(ctx, 68)
        _press_key(ctx, 82)
        _press_key(ctx, 79)
        _press_key(ctx, 67)
        _press_key(ctx, 75)
        matches: number = search_item_count("bedrock")
        ctx.assert(matches > 0, "The search for bedrock should match the game's bedrock.")
        ctx.assert(matches < _columns(ctx), "The search should leave an empty cell in the grid's first row.")
        ctx.set_carried_item(expected)
        ctx.assert(ctx.get_carried_item().has(), "The test should be able to put an item on the cursor.")
        step = 10
        taken: bool = ctx.click_screen(_cell_x(ctx, matches), _cell_y(0), 0)
        ctx.assert(taken, "The overlay should take a press on an empty cell while the cursor carries an item.")
        ctx.not_done()
        return
    }

    ctx.assert(not ctx.get_carried_item().has(), "A left click on an empty cell should delete the stack on the cursor.")
    # The search text is the overlay's own state and outlives the screen, as the reference's field
    # does, so the test empties it before it closes the screen: a later test that opens the list
    # must start with the whole list, not with this test's search.
    ctx.assert(ctx.click_screen(_field_x(ctx), _field_y(ctx), 1), "The overlay should take a right click that empties the search field.")
    ctx.close_screen()
}

# The middle of a slot, in the scaled pixels a screen's mouse handlers take.

# A typed letter, which the overlay takes while the search field has the keyboard.
local _press_key(ctx: TestTickContext, key: number) {
    ctx.assert(ctx.press_screen_key(key, false, true), "A typed letter should be taken while the search field is focused.")
}

# The search field is the 20 pixel bar 6 pixels above the bottom of the screen, as wide as the grid.
local _field_x(ctx: TestTickContext) number {
    return _grid_x(ctx) + 10
}

local _field_y(ctx: TestTickContext) number {
    return ctx.gui_top() * 2 + ctx.gui_height() - 6 - 10
}

# The reference insets the display area to the right of the GUI by 6 pixels, leaves 22 pixels at
# the bottom for its search bar, and crops 22 at the top for its page buttons. The screen's size and
# the GUI's position come from the open screen, because the window size and the recipe book can move
# the GUI, so the test works out the same grid the overlay does instead of assuming a window size.
local _cell_x(ctx: TestTickContext, column: number) number {
    return _grid_x(ctx) + column * 18 + 9
}

local _cell_y(row: number) number {
    return _grid_y() + row * 18 + 9
}

local _grid_x(ctx: TestTickContext) number {
    display_left: number = ctx.gui_left() + ctx.gui_width()
    available_width: number = ctx.screen_width() - display_left - 12
    return display_left + 6 + (available_width - _columns(ctx) * 18)
}

local _grid_y() number {
    return 28
}

local _columns(ctx: TestTickContext) number {
    available_width: number = ctx.screen_width() - ctx.gui_left() - ctx.gui_width() - 12
    columns: number = Math.floor(available_width / 18)
    if columns > 9 {
        columns = 9
    }
    return columns
}
