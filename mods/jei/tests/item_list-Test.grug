# Captures the item list on the open container screen, so the reference job pins what real JEI
# draws and every loader pins what the port draws. See #874.

# The crop is the grid and nothing else. Both renderers lay it out the same way (IngredientGrid,
# IngredientGridConfig, IngredientListOverlay): the display area is everything right of the GUI, the
# grid is inset 6 pixels, keeps 22 pixels at the bottom for the search field and crops 22 more at
# the top for the page buttons, takes the largest whole number of 18 pixel slots that still fit, and
# is aligned right and top. On the 1280x720 window the run forces, the game's auto GUI scale picks
# 3, which makes a 427 by 240 screen. The test player is in creative mode, so 1.20.6 opens the
# creative inventory, a 195 by 136 GUI at (116, 52): the display area to its right is 311 to 427,
# and after the insets the grid is five columns by ten rows from scaled 331 to 421 and 28 to 208. A
# version that opens the plain 176 wide inventory instead leaves six columns, and one that rounds
# the scaled width down (426) puts the grid a pixel left; the crop is computed from the measured GUI
# and screen rather than written down, so each of those captures its whole grid.

# JEI's page buttons are the 22 pixels above the grid and its search field and config button the 20
# pixels below it, so none of the reference's chrome, which the port does not draw (#870), is in the
# crop. Neither renderer draws a background behind the grid either: IngredientGridConfig's
# DrawBackground is off, and the port draws no slot background (#870).

# The item in a cell is not the same one in the two runs. The port lists by registry key and JEI by
# creative tab and then mod name, which is the deviation #870 records, so each rendering is compared
# exactly with pixels of its own: the reference's in jei_item_list_reference, the port's in
# jei_item_list. That is what makes the two committed frames comparable rather than identical: the
# grid's edges, the pixels between its cells and the world behind them are the same area of the
# screen in both runs, so only the icons in the cells differ.

# The frame pixels one scaled pixel covers. GrugRunWindow holds the window at 1280x720 and the auto
# GUI scale picks 3 for it, as every screenshot test's fixed rectangle already assumes; the assert
# on the scaled width below refuses a run at any other scale rather than capturing a shifted
# rectangle.
frame_scale: number = 3

started: bool = false
opened: bool = false
waited: number = 0

export tick(ctx: TestTickContext) {
    if not started {
        started = true
        if not Test.overlay_supported() {
            # This loader draws no overlays; the deviation is in about.json.
            return
        }
        Test.close_screen()
        ctx.not_done()
        return
    }

    # A world frame has to be drawn before a screen that shows the player opens: the inventory
    # draws the player with the entity renderer, whose texture manager is only filled in when the
    # world renders its entities, and a screen opened before that crashes the game thread on Alpha
    # and Beta.
    if not opened {
        waited = waited + 1
        ctx.assert(waited < 200, "The world should settle before the inventory screen opens.")
        if not Test.world_settled() {
            ctx.not_done()
            return
        }
        Test.open_inventory(Test.get_player())
        opened = true
        waited = 0
        ctx.not_done()
        return
    }

    if not Test.screen_open() {
        waited = waited + 1
        ctx.assert(waited < 100, "The player's inventory screen should open.")
        ctx.not_done()
        return
    }

    # The values the crop is derived from are the ones the overlay's own layout uses, so a loader
    # whose window or GUI is laid out otherwise fails here rather than capturing another part of the
    # screen that its golden would then accept. 1280 / 3 is 426.67, which one version rounds up to
    # 427 and another down to 426, and both are a GUI scale of 3.
    ctx.assert(Test.screen_width() == 426 or Test.screen_width() == 427, "The CI window should be 1280x720 at a GUI scale of 3.")
    ctx.assert(Test.gui_width() > 0 and Test.gui_height() > 0, "The screen should be a container screen with a GUI.")
    ctx.assert(_columns() >= 4, "The display area right of the GUI should leave room for the reference's minimum of four columns.")
    ctx.assert(_rows() == 10, "The display area should leave room for ten rows of items.")

    # The reference run has no grug overlay to wait for, so there the settled frame is the condition.
    # On the port the frame that drew this mod's own overlay has to exist before its icons are
    # captured, as at the run's maximum game speed several ticks can pass before one is drawn.
    if not Test.is_reference() and not Test.overlay_drawn() {
        waited = waited + 1
        ctx.assert(waited < 200, "A frame with the overlay should be drawn on the open screen.")
        ctx.not_done()
        return
    }

    if not Test.world_settled() {
        ctx.not_done()
        return
    }

    left: number = _grid_x() * frame_scale
    top: number = _grid_y() * frame_scale
    right: number = (_grid_x() + _columns() * 18) * frame_scale
    bottom: number = (_grid_y() + _rows() * 18) * frame_scale
    if Test.is_reference() {
        Test.screenshot().equals(r"screenshots/jei_item_list_reference", left, top, right, bottom)
    } else {
        Test.screenshot().equals(r"screenshots/jei_item_list", left, top, right, bottom)
    }
    Test.close_screen()
}

# The grid's layout, as the overlay computes it: the display area right of the GUI, inset 6 pixels,
# its lowest 22 pixels kept for the search field and its top 22 cropped for the page buttons, the
# largest whole number of 18 pixel slots that fit, aligned right and top.

local _grid_x() number {
    display_left: number = Test.gui_left() + Test.gui_width()
    available_width: number = Test.screen_width() - display_left - 12
    return display_left + 6 + (available_width - _columns() * 18)
}

local _grid_y() number {
    return 28
}

local _columns() number {
    available_width: number = Test.screen_width() - Test.gui_left() - Test.gui_width() - 12
    columns: number = Math.floor(available_width / 18)
    if columns > 9 {
        columns = 9
    }
    return columns
}

# The screen's height is not a test value, so it is read back from the centered container GUI, which
# sits with an equal margin above and below it.
local _rows() number {
    screen_height: number = Test.gui_top() * 2 + Test.gui_height()
    available_height: number = Math.floor((screen_height - 22 - 22 - 12) / 18)
    if available_height > 16 {
        available_height = 16
    }
    return available_height
}
