# Ctrl+O hides the item list and shows it again, which is the reference's overlay toggle. A hidden
# overlay takes no press, so the test reads whether the list is shown through whether a page button
# press is taken: the key goes through the screen's own key path, and the answer of each press is
# synchronous, so nothing here waits for a tick count. A key without control, or another key, leaves
# the list shown. See #866.
# The probe is a page button and not a grid cell, because a right click on a cell gives the player an
# item, and 1.20.6 gives it on the integrated server's thread: it can land after this test's cleanup
# and after the next test's inventory reset, and then shows in that test's capture. A page button
# press gives nothing, and the probe presses the next button and then the back one, so the page the
# list was on is the page it stays on. The hand is then asserted empty, after waiting the ticks a
# queued give would need: a probe that gave an item again fails here on every loader instead of
# leaking into a capture. See #1144.

started: bool = false
opened: bool = false
waited: number = 0
pressed: bool = false
settled: number = 0

export tick_any_side(ctx: TestTickContext) {
    if not started {
        started = true
        if not Test.overlay_supported() {
            return
        }
        Test.close_screen()
        ctx.not_done()
        return
    }

    # A world frame has to be drawn before a screen that shows the player opens: the inventory
    # draws the player with the entity renderer, whose texture manager and camera the world's own
    # entity pass fills in, and a selection whose first test ticks before any frame has drawn (a
    # `-f mods=jei` dispatch runs this test first) would otherwise crash the client (#1287). The
    # test box's light is queued before the test's own clock starts and the game runs ten ticks for
    # one frame, so the first settle can take a few hundred of the test's ticks; the failure bound
    # is what says it never came, not a wait.
    if not opened {
        waited = waited + 1
        ctx.assert(waited < 1000, "The world should settle before the inventory opens.")
        if not Test.world_settled() {
            ctx.not_done()
            return
        }
        Test.open_inventory(Test.get_player())
        opened = true
        waited = 0
        ctx.not_done()
        return
    }

    if not Test.screen_open() {
        waited = waited + 1
        ctx.assert(waited < 100, "The player's inventory screen should open.")
        ctx.not_done()
        return
    }

    if not Test.overlay_drawn() {
        waited = waited + 1
        ctx.assert(waited < 200, "A frame with the overlay should be drawn on the open screen.")
        ctx.not_done()
        return
    }

    if not pressed {
        ctx.assert(_press_taken(), "The list should be shown when the screen opens.")
        pressed = true
        settled = 0
        ctx.not_done()
        return
    }

    # The probe has to give nothing, but a click that gives is queued to the integrated server on
    # 1.20.6 and lands a tick or more later, so the hand is not believed empty until the time such a
    # give would need has passed. 40 ticks is a couple of seconds at real time and a few frames at
    # the runner's fastest clock, far more than the one server tick the queued give needs. A give
    # that arrives fails the assertion instead of landing after this test's cleanup and showing in
    # the next test's capture (#1144).
    if Test.get_held_count(Test.get_player()) == 0 and settled < 40 {
        settled = settled + 1
        ctx.not_done()
        return
    }
    ctx.assert(Test.get_held_count(Test.get_player()) == 0, "A page-button press should give the player nothing.")
    ctx.assert(not Test.press_screen_key(79, false, true), "O without control should not be taken.")
    ctx.assert(not Test.press_screen_key(80, true, true), "Ctrl+P should not be taken.")
    ctx.assert(_press_taken(), "The list should still be shown after keys that are not its hotkey.")
    ctx.assert(Test.press_screen_key(79, true, true), "Ctrl+O should be taken by the overlay.")
    ctx.assert(not _press_taken(), "The list should be hidden after Ctrl+O.")
    # A held Ctrl+O repeats the key event, which must not toggle again: the first press shows the
    # list, the repeat leaves it shown, and letting go ends the hold.
    ctx.assert(Test.press_screen_key(79, true, false), "Ctrl+O should be taken by the overlay.")
    ctx.assert(_press_taken(), "The list should be shown after the first press of a held Ctrl+O.")
    ctx.assert(not Test.press_screen_key(79, true, false), "A repeat of a held key should not be taken.")
    ctx.assert(_press_taken(), "A repeat of Ctrl+O should not hide the list again.")
    ctx.assert(not Test.press_screen_key(79, true, true), "The last repeat before the release should not be taken.")
    ctx.assert(Test.press_screen_key(79, true, true), "Ctrl+O should be taken again once it was released.")
    ctx.assert(not _press_taken(), "The list should be hidden after a second full press.")
    ctx.assert(Test.press_screen_key(79, true, true), "Ctrl+O should be taken again while the list is hidden.")
    ctx.assert(_press_taken(), "The list should be shown again after a second Ctrl+O.")
    Test.close_screen()
}

# Whether the overlay takes a press on its page buttons, which it does only while the list is shown,
# and which gives no item. The next button goes first and the back button after it, so the page the
# list shows is the one it showed before.
local _press_taken() bool {
    taken: bool = Test.click_screen(_next_x(), _button_y(), 0)
    Test.click_screen(_back_x(), _button_y(), 0)
    return taken
}

# The page buttons sit at the top of the 22 pixels reserved above the grid, in a 20 by 20 square:
# back at the grid's left edge and next at its right edge (jei-Overlay's _button_step).
local _button_y() number {
    return 16
}

local _back_x() number {
    return _grid_x() + 10
}

local _next_x() number {
    return _grid_x() + _columns() * 18 - 10
}

local _grid_x() number {
    display_left: number = Test.gui_left() + Test.gui_width()
    available_width: number = Test.screen_width() - display_left - 12
    return display_left + 6 + (available_width - _columns() * 18)
}

local _columns() number {
    available_width: number = Test.screen_width() - Test.gui_left() - Test.gui_width() - 12
    columns: number = Math.floor(available_width / 18)
    if columns > 9 {
        columns = 9
    }
    return columns
}
