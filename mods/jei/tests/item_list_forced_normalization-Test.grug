# Captures the item list on the open container screen, so the reference job pins what real JEI
# draws and every loader pins what the port draws, with the GL capability that normalizes normals
# turned on the way Beta's slime renderer leaves it. See #874 and #1137.

# The file name's _forced_normalization mark makes the runner turn the normalizing capabilities on
# before this test's first tick (GrugForcedNormalization), so every frame it captures is drawn with
# the state a slime rendered earlier in a run would leave behind. Without the overlay's item draw
# pinning that state off, it shades each icon's left face about 1.9 times brighter, which is the
# flake #1137 records. A reference run never forces the state, so this test pins the reference
# mod's own drawing unaltered.

# The crop is one row of the grid, the third from its top, and the five columns at its right edge:
# the smallest rectangle that shows the overlay's own drawing without the parts of the frame that
# changed between runs, and one width on every loader because every reference in a screenshot
# directory has to be the capture's size. Both renderers lay the grid out the same way
# (IngredientGrid, IngredientGridConfig, IngredientListOverlay): the display area is everything
# right of the GUI, the grid is inset 6 pixels, keeps 22 pixels at the bottom for the search field
# and crops 22 more at the top for the page buttons, takes the largest whole number of 18 pixel
# slots that still fit, and is aligned right and top. On the 1280x720 window the run forces, the
# game's auto GUI scale picks 3, which makes a 427 by 240 screen. The test player is in creative
# mode, so 1.20.6 opens the creative inventory, a 195 by 136 GUI at (116, 52): the display area to
# its right leaves five columns, so there the five kept columns are the whole row. The 176 by 166
# inventory the other loaders open leaves six, and the five kept there are the rightmost ones,
# because the grid is aligned right. The rectangle is computed from the GUI the screen reports
# rather than written down.

# The rectangle is inset one scaled pixel on every side, which drops the padding at the row's outer
# edge and leaves the 16 pixel icon of each kept cell and the 2 pixel gaps between cells, 264 by 48
# pixels. The padding is where the world behind the grid changed between runs of one loader in the
# comparison that chose this rectangle, by up to two levels (#961), while the icons and the gaps
# were identical.

# The first two rows are left out because the later versions' item lists start with the fluids,
# whose icons are animated textures: water and lava change frame every client tick, so a capture that
# includes them differs from run to run and is no golden. Fire, whose pixels are regenerated at
# random, is in the last rows as well. The third row held the same pixels in every run compared, on
# all five loaders, and the five columns kept still pin the grid's right alignment, its top
# position, its column count and its slot pitch: any move, resize or repack of the grid changes the
# icons the row holds.

# The rows below the third are left out because of those icons and not because of the world behind
# them. On 2026-11-20 two attempts of one commit captured the whole frame and the room's light on
# every loader for #961: the only differing pixels were inside the fluid and fire cells and in the
# inventory's player model, the world behind the grid was byte-identical on every loader except
# 1.2.5, where one isolated pixel outside every cell differed by two levels (two such pixels across
# four captures of it), and the room's block and sky light was identical on all five loaders and
# every layer. The earlier 21059 pixel difference behind rows 5 to 7 on 1.20.6 and 3520 on
# b1.7.3-ornithe did not reproduce after #938 and #997; see #961.

# JEI's page buttons are the 22 pixels above the grid and its search field and config button the 20
# pixels below it, so none of the reference's chrome, which the port does not draw (#870), is in the
# crop. Neither renderer draws a background behind the grid either: IngredientGridConfig's
# DrawBackground is off, and the port draws no slot background (#870).

# The item in a cell is not the same one in the two runs. The port lists by registry key and JEI by
# creative tab and then mod name, which is the deviation #870 records, so each rendering is compared
# exactly with pixels of its own: the reference's in jei_item_list_reference, the port's in
# jei_item_list. That is what makes the two committed frames comparable rather than identical: the
# grid's edges, the pixels between its cells and the world behind them are the same area of the
# screen in both runs, so only the icons in the cells differ.

# The frame pixels one scaled pixel covers. GrugRunWindow holds the window at 1280x720 and the auto
# GUI scale picks 3 for it, as every screenshot test's fixed rectangle already assumes; the assert
# on the scaled width below refuses a run at any other scale rather than capturing a shifted
# rectangle.
frame_scale: number = 3

# The row and columns the crop keeps, out of the ten rows and at most nine columns the display area
# leaves. See the note at the top.
first_row: number = 2
row_count: number = 1
crop_columns: number = 5

started: bool = false
opened: bool = false
waited: number = 0

export tick(ctx: TestTickContext) {
    if not started {
        started = true
        if not me.overlay_supported() {
            # This loader draws no overlays; the deviation is in about.json.
            return
        }
        ctx.close_screen()
        ctx.not_done()
        return
    }

    # A world frame has to be drawn before a screen that shows the player opens: the inventory
    # draws the player with the entity renderer, whose texture manager is only filled in when the
    # world renders its entities, and a screen opened before that crashes the game thread on Alpha
    # and Beta.
    if not opened {
        waited = waited + 1
        # The test box's light is queued before the test's own clock starts and the game runs ten
        # ticks for one frame, so the first settle can take a few hundred of the test's ticks; the
        # failure bound is what says it never came, not a wait.
        ctx.assert(waited < 1000, "The world should settle before the inventory screen opens.")
        if not ctx.world_settled() {
            ctx.not_done()
            return
        }
        ctx.open_inventory(ctx.get_player())
        opened = true
        waited = 0
        ctx.not_done()
        return
    }

    if not ctx.screen_open() {
        waited = waited + 1
        ctx.assert(waited < 100, "The player's inventory screen should open.")
        ctx.not_done()
        return
    }

    # The values the crop is derived from are the ones the overlay's own layout uses, so a loader
    # whose window or GUI is laid out otherwise fails here rather than capturing another part of the
    # screen that its golden would then accept. 1280 / 3 is 426.67, which one version rounds up to
    # 427 and another down to 426, and both are a GUI scale of 3.
    ctx.assert(ctx.screen_width() == 426 or ctx.screen_width() == 427, "The CI window should be 1280x720 at a GUI scale of 3.")
    ctx.assert(ctx.gui_width() > 0 and ctx.gui_height() > 0, "The screen should be a container screen with a GUI.")
    ctx.assert(_columns(ctx) >= crop_columns, "The display area right of the GUI should leave room for the five columns the crop keeps.")
    ctx.assert(_rows(ctx) == 10, "The display area should leave room for ten rows of items.")

    # The reference run has no grug overlay to wait for, so there the settled frame is the condition.
    # On the port the frame that drew this mod's own overlay has to exist before its icons are
    # captured, as at the run's maximum game speed several ticks can pass before one is drawn.
    if not me.is_reference() and not ctx.overlay_drawn() {
        waited = waited + 1
        ctx.assert(waited < 200, "A frame with the overlay should be drawn on the open screen.")
        ctx.not_done()
        return
    }

    if not ctx.world_settled() {
        ctx.not_done()
        return
    }

    grid_right: number = _grid_x(ctx) + _columns(ctx) * 18
    left: number = (grid_right - crop_columns * 18 + 1) * frame_scale
    top: number = (_grid_y() + first_row * 18 + 1) * frame_scale
    right: number = (grid_right - 1) * frame_scale
    bottom: number = (_grid_y() + (first_row + row_count) * 18 - 1) * frame_scale
    if me.is_reference() {
        ctx.screenshot().equals(r"screenshots/jei_item_list_reference", left, top, right, bottom)
    } else {
        ctx.screenshot().equals(r"screenshots/jei_item_list", left, top, right, bottom)
    }
    ctx.close_screen()
}

# The grid's layout, as the overlay computes it: the display area right of the GUI, inset 6 pixels,
# its lowest 22 pixels kept for the search field and its top 22 cropped for the page buttons, the
# largest whole number of 18 pixel slots that fit, aligned right and top.

local _grid_x(ctx: TestTickContext) number {
    display_left: number = ctx.gui_left() + ctx.gui_width()
    available_width: number = ctx.screen_width() - display_left - 12
    return display_left + 6 + (available_width - _columns(ctx) * 18)
}

local _grid_y() number {
    return 28
}

local _columns(ctx: TestTickContext) number {
    available_width: number = ctx.screen_width() - ctx.gui_left() - ctx.gui_width() - 12
    columns: number = Math.floor(available_width / 18)
    if columns > 9 {
        columns = 9
    }
    return columns
}

# The screen's height is not a test value, so it is read back from the centered container GUI, which
# sits with an equal margin above and below it.
local _rows(ctx: TestTickContext) number {
    screen_height: number = ctx.gui_top() * 2 + ctx.gui_height()
    available_height: number = Math.floor((screen_height - 22 - 22 - 12) / 18)
    if available_height > 16 {
        available_height = 16
    }
    return available_height
}
