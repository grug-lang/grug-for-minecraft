# JEI's ingredient list, drawn on the player's inventory screen and on chest and crafting-table
# screens: every item the host lists, in a grid, where clicking one gives the player that item.

# The list is paged with two buttons in the 22 pixels above the grid, the reference's back and next
# buttons: a press on the left one shows the previous page and on the right one the next page, and
# either wraps around at the ends like the reference's. There is no mouse wheel scroll, no search, no
# hotkey and no recipe categories, and the layout is the reference's own (IngredientGrid, IngredientGridConfig,
# IngredientListOverlay): a slot is its 16 by 16 icon plus one pixel of padding on each side, the
# grid is at most 9 columns by 16 rows and at least 4 columns by 1 row, and it sits in the display
# area to the right of the GUI, inset 6 pixels, with 22 pixels left at the bottom for the search bar
# and 22 pixels reserved at the top for the page buttons. A grid that does not fit is not drawn at
# all, which is also what the reference does.

slot: number = 18
max_columns: number = 9
max_rows: number = 16
min_columns: number = 4
min_rows: number = 1

# IngredientListOverlay.BORDER_MARGIN, its 20 pixel search field plus the 2 pixel gap it leaves, and
# the 22 pixels IngredientGridWithNavigation crops at the top for its page buttons.
border_margin: number = 6
search_area: number = 22
navigation_area: number = 22

# One page button, the reference's 20 by 20 square, at the top of the navigation area: back at the
# grid's left edge and next at its right edge.
button_size: number = 20

# The page being shown, counted from 0. It is kept in range by _fit_page, because the screen can be
# resized between two frames.
page: number = 0

export render(ctx: OverlayRenderContext) {
    screen_width: number = ctx.screen_width()
    screen_height: number = ctx.screen_height()
    columns: number = _columns(screen_width, ctx.gui_left(), ctx.gui_width())
    rows: number = _rows(screen_height)
    if columns < min_columns or rows < min_rows {
        return
    }

    grid_x: number = _grid_x(screen_width, ctx.gui_left(), ctx.gui_width())
    grid_y: number = _grid_y()
    mouse_x: number = ctx.mouse_x()
    mouse_y: number = ctx.mouse_y()
    count: number = item_count()
    _fit_page(columns * rows, count)
    ctx.draw_box(grid_x, border_margin, grid_x + button_size, border_margin + button_size)
    ctx.draw_box(grid_x + columns * slot - button_size, border_margin, grid_x + columns * slot, border_margin + button_size)
    first: number = page * columns * rows
    index: number = 0
    while index < columns * rows {
        if first + index < count {
            slot_x: number = grid_x + _column(index, columns) * slot
            slot_y: number = grid_y + _row(index, columns) * slot
            ctx.draw_item(item_at(first + index), slot_x + 1, slot_y + 1)
            if _inside(mouse_x, mouse_y, slot_x, slot_y) {
                ctx.draw_box(slot_x, slot_y, slot_x + slot, slot_y + slot)
            }
        }
        index = index + 1
    }
}

export click(ctx: OverlayClickContext) {
    button: number = ctx.button()
    if button != 0 and button != 1 and button != 2 {
        return
    }

    screen_width: number = ctx.screen_width()
    columns: number = _columns(screen_width, ctx.gui_left(), ctx.gui_width())
    rows: number = _rows(ctx.screen_height())
    if columns < min_columns or rows < min_rows {
        return
    }

    count: number = item_count()
    per_page: number = columns * rows
    _fit_page(per_page, count)
    if button == 0 {
        step: number = _button_step(ctx.mouse_x(), ctx.mouse_y(), screen_width, ctx.gui_left(), ctx.gui_width(), columns)
        if step != 0 {
            pages: number = _page_count(per_page, count)
            page = Math.remainder(page + step + pages, pages)
            ctx.take()
            return
        }
    }

    index: number = _clicked_index(ctx.mouse_x(), ctx.mouse_y(), screen_width, ctx.gui_left(), ctx.gui_width(), columns, rows)
    if index < 0 {
        return
    }
    if button == 0 and ctx.carried_item().has() {
        # JEI deletes the item on the cursor when the left button is pressed over the list, rather
        # than giving another one, which is what DeleteItemInputHandler does.
        ctx.delete_carried_item()
        ctx.take()
        return
    }
    index = page * per_page + index
    if index >= count {
        return
    }
    # A right click gives one, like a left click, and shift+left or the middle button gives a stack,
    # which are the reference's cheatOneItem2 and cheatItemStack bindings.
    if button == 2 or (button == 0 and ctx.shift()) {
        give_item_stack(item_at(index))
    } else {
        give_item(item_at(index))
    }
    ctx.take()
}

# -1 for the back button, 1 for the next button, 0 for a press that is on neither.
local _button_step(mouse_x: number, mouse_y: number, screen_width: number, gui_left: number, gui_width: number, columns: number) number {
    if mouse_y < border_margin or mouse_y >= border_margin + button_size {
        return 0
    }
    grid_x: number = _grid_x(screen_width, gui_left, gui_width)
    if mouse_x >= grid_x and mouse_x < grid_x + button_size {
        return -1
    }
    grid_right: number = grid_x + columns * slot
    if mouse_x >= grid_right - button_size and mouse_x < grid_right {
        return 1
    }
    return 0
}

local _page_count(per_page: number, count: number) number {
    pages: number = Math.floor((count + per_page - 1) / per_page)
    if pages < 1 {
        return 1
    }
    return pages
}

local _fit_page(per_page: number, count: number) {
    last: number = _page_count(per_page, count) - 1
    if page > last {
        page = last
    }
}

local _clicked_index(mouse_x: number, mouse_y: number, screen_width: number, gui_left: number, gui_width: number, columns: number, rows: number) number {
    grid_x: number = _grid_x(screen_width, gui_left, gui_width)
    grid_y: number = _grid_y()
    if mouse_x < grid_x or mouse_x >= grid_x + columns * slot {
        return -1
    }
    if mouse_y < grid_y or mouse_y >= grid_y + rows * slot {
        return -1
    }
    column: number = Math.floor((mouse_x - grid_x) / slot)
    row: number = Math.floor((mouse_y - grid_y) / slot)
    return row * columns + column
}

local _grid_x(screen_width: number, gui_left: number, gui_width: number) number {
    display_left: number = _display_left(gui_left, gui_width)
    available_width: number = _available_width(screen_width, gui_left, gui_width)
    return display_left + border_margin + (available_width - _columns(screen_width, gui_left, gui_width) * slot)
}

local _grid_y() number {
    return border_margin + navigation_area
}

local _columns(screen_width: number, gui_left: number, gui_width: number) number {
    available: number = Math.floor(_available_width(screen_width, gui_left, gui_width) / slot)
    if available > max_columns {
        return max_columns
    }
    return available
}

local _available_width(screen_width: number, gui_left: number, gui_width: number) number {
    return screen_width - _display_left(gui_left, gui_width) - border_margin * 2
}

local _rows(screen_height: number) number {
    available: number = Math.floor(_available_height(screen_height) / slot)
    if available > max_rows {
        return max_rows
    }
    return available
}

local _available_height(screen_height: number) number {
    return screen_height - search_area - navigation_area - border_margin * 2
}

local _display_left(gui_left: number, gui_width: number) number {
    return gui_left + gui_width
}

local _column(index: number, columns: number) number {
    return Math.remainder(index, columns)
}

local _row(index: number, columns: number) number {
    return Math.floor(index / columns)
}

local _inside(mouse_x: number, mouse_y: number, slot_x: number, slot_y: number) bool {
    return mouse_x >= slot_x and mouse_x < slot_x + slot and mouse_y >= slot_y and mouse_y < slot_y + slot
}
