# JEI's ingredient list, drawn on the player's inventory screen and on chest and crafting-table
# screens: every item the host lists, in a grid, where clicking one gives the player that item.

# The list is paged with two buttons in the 22 pixels above the grid, the reference's back and next
# buttons: a press on the left one shows the previous page and on the right one the next page, and
# either wraps around at the ends like the reference's. The mouse wheel pages the list too, over the
# grid and its page buttons: down shows the next page and up the previous one, which is the
# reference's IngredientGridWithNavigation input handler. Ctrl+O hides and shows the whole overlay,
# the reference's default for its overlay toggle (KeyBindings.toggleOverlay). There are no recipe
# categories, and the layout is the reference's own (IngredientGrid,
# IngredientGridConfig, IngredientListOverlay): a slot is its 16 by 16 icon plus one pixel of padding on each side, the
# grid is at most 9 columns by 16 rows and at least 4 columns by 1 row, and it sits in the display
# area to the right of the GUI, inset 6 pixels, with 22 pixels left at the bottom for the search bar
# and 22 pixels reserved at the top for the page buttons. A grid that does not fit is not drawn at
# all, which is also what the reference does.

# The search field is the 20 pixel bar at the bottom of that area, as wide as the grid. A left press
# on it focuses it and every other press unfocuses it, the page buttons and the items included,
# which is what the reference does: CombinedInputHandler.handleClickInternal calls
# TextFieldInputHandler.handleMouseClickedOut on the field's handler for every press its
# handleUserInput did not take, and that unfocuses (TextFieldInputHandler.java:75-77). The
# reference's other unfocus paths, Enter and Escape (:24-26), are keys the host does not deliver. It
# unfocuses on a screen change too. While it is focused the letters, the digits and the
# space are typed into it and backspace deletes the last character, and the list shows only the
# items the text matches, the reference's own search syntax (see search_item_count): words are
# matched against the item name, an @ word against the mod, a minus removes, a bar separates
# alternatives. A change of the text goes back to the first page. See #865.

slot: number = 18
max_columns: number = 9
max_rows: number = 16
min_columns: number = 4
min_rows: number = 1

# IngredientListOverlay.BORDER_MARGIN, its 20 pixel search field plus the 2 pixel gap it leaves, and
# the 22 pixels IngredientGridWithNavigation crops at the top for its page buttons.
border_margin: number = 6
search_area: number = 22
navigation_area: number = 22

# One page button, the reference's 20 by 20 square, at the top of the navigation area: back at the
# grid's left edge and next at its right edge.
button_size: number = 20

# The page being shown, counted from 0. It is kept in range by _fit_page, because the screen can be
# resized between two frames.
page: number = 0

# Whether the overlay is shown. Ctrl+O flips it, and while it is hidden nothing is drawn and no
# press is taken, so the screen is exactly the game's own.
shown: bool = true

# The key code the overlay gets for the letter O, the same on every loader.
toggle_key: number = 79

# The search field's text, whether it has the keyboard, and the serial of the screen last drawn,
# which says when the screen changed.
query: string = ""
focused: bool = false

# Whether the last frame drew the field, which it does not when the grid does not fit: a field that
# is not on the screen takes no key.
field_visible: bool = false
seen_screen: number = -1

# The reference's search field height (IngredientListOverlay.SEARCH_HEIGHT), and the most characters
# its text field lets the player type.
search_height: number = 20
max_query: number = 128

# The key codes of the keys that edit the field, which the host gives the same on every loader.
key_space: number = 32
key_backspace: number = 8

export render(ctx: OverlayRenderContext) {
    # A new screen unfocuses the field before anything can return early, so a screen where the grid
    # does not fit cannot leave an invisible field holding the keyboard.
    if ctx.screen_serial() != seen_screen {
        focused = false
        seen_screen = ctx.screen_serial()
    }
    field_visible = false
    if not shown {
        return
    }
    screen_width: number = ctx.screen_width()
    screen_height: number = ctx.screen_height()
    columns: number = _columns(screen_width, ctx.gui_left(), ctx.gui_width())
    rows: number = _rows(screen_height)
    if columns < min_columns or rows < min_rows {
        return
    }

    grid_x: number = _grid_x(screen_width, ctx.gui_left(), ctx.gui_width())
    grid_y: number = _grid_y()
    mouse_x: number = ctx.mouse_x()
    mouse_y: number = ctx.mouse_y()
    count: number = search_item_count(query)
    field_visible = true
    _fit_page(columns * rows, count)
    _draw_search(ctx, grid_x, columns * slot, screen_height)
    ctx.draw_box(grid_x, border_margin, grid_x + button_size, border_margin + button_size)
    ctx.draw_box(grid_x + columns * slot - button_size, border_margin, grid_x + columns * slot, border_margin + button_size)
    first: number = page * columns * rows
    index: number = 0
    while index < columns * rows {
        if first + index < count {
            slot_x: number = grid_x + _column(index, columns) * slot
            slot_y: number = grid_y + _row(index, columns) * slot
            ctx.draw_item(search_item_at(query, first + index), slot_x + 1, slot_y + 1)
            if _inside(mouse_x, mouse_y, slot_x, slot_y) {
                ctx.draw_box(slot_x, slot_y, slot_x + slot, slot_y + slot)
            }
        }
        index = index + 1
    }
}

export click(ctx: OverlayClickContext) {
    if not shown {
        return
    }
    button: number = ctx.button()
    if button != 0 and button != 1 and button != 2 {
        return
    }

    screen_width: number = ctx.screen_width()
    columns: number = _columns(screen_width, ctx.gui_left(), ctx.gui_width())
    rows: number = _rows(ctx.screen_height())
    if columns < min_columns or rows < min_rows {
        focused = false
        return
    }

    count: number = search_item_count(query)
    per_page: number = columns * rows
    _fit_page(per_page, count)
    if button == 1 and _on_search(ctx.mouse_x(), ctx.mouse_y(), screen_width, ctx.gui_left(), ctx.gui_width(), columns, ctx.screen_height()) {
        # A right click on the field clears it and focuses it, the reference's text field.
        query = ""
        page = 0
        focused = true
        ctx.take()
        return
    }
    # Every press the field does not take unfocuses it, the page buttons and the items included, and
    # a press on the field itself focuses it again below.
    focused = false
    if button == 0 {
        if _on_search(ctx.mouse_x(), ctx.mouse_y(), screen_width, ctx.gui_left(), ctx.gui_width(), columns, ctx.screen_height()) {
            focused = true
            ctx.take()
            return
        }
        step: number = _button_step(ctx.mouse_x(), ctx.mouse_y(), screen_width, ctx.gui_left(), ctx.gui_width(), columns)
        if step != 0 {
            pages: number = _page_count(per_page, count)
            page = Math.remainder(page + step + pages, pages)
            _play_click()
            ctx.take()
            return
        }
    }

    index: number = _clicked_index(ctx.mouse_x(), ctx.mouse_y(), screen_width, ctx.gui_left(), ctx.gui_width(), columns, rows)
    if index < 0 {
        return
    }
    index = page * per_page + index
    if button == 0 and ctx.carried_item().has() {
        # DeleteItemInputHandler.shouldDeleteItemOnClick (:94-101) deletes the item on the cursor only
        # when the clicked ingredient cannot stack with it, so a left click on the item the cursor
        # already carries gives one instead of deleting the stack. Its canStack compares one-item
        # copies (ServerCommandUtil.canStack, :160-163), which merge only when two fit the item's
        # stack, so a tool, armour, a potion or a filled bucket cannot stack and is deleted.

        # A cell past the last item on the page still deletes, which is why this comes before the
        # empty-cell return below: the reference asks only whether the mouse is over the grid's area
        # (IngredientGrid.isMouseOver, :163-165) and reads an empty lookup as delete
        # (getIngredientUnderMouse().orElse(true)), then reports the press handled (:64-70), so the
        # screen never sees it.
        carries_clicked: bool = false
        if index < count {
            clicked: Item = search_item_at(query, index)
            if equals(ctx.carried_item().unwrap(), clicked) {
                carries_clicked = item_max_stack(clicked) > 1
            }
        }
        if not carries_clicked {
            ctx.delete_carried_item()
            ctx.take()
            return
        }
    }
    if index >= count {
        return
    }
    # A right click gives one, like a left click, and shift+left or the middle button gives a stack,
    # which are the reference's cheatOneItem2 and cheatItemStack bindings.
    if button == 2 or (button == 0 and ctx.shift()) {
        give_item_stack(search_item_at(query, index))
    } else {
        give_item(search_item_at(query, index))
    }
    ctx.take()
}

export key(ctx: OverlayKeyContext) {
    # A held key repeats the press, and the toggle flips once per press rather than once per repeat.
    # The repeat is still taken, or the screen's own handler would see the key.
    if ctx.key() == toggle_key and ctx.ctrl() {
        if not ctx.repeat() {
            shown = not shown
        }
        ctx.take()
        return
    }
    if not shown or not field_visible or not focused or ctx.ctrl() {
        return
    }

    # The field's text is the character the press typed, with shift and the keyboard layout already
    # applied, which is how a quote, a minus, a bar or an @ gets in at all: those keys have no key
    # number of their own (#1741). On a loader that sends the character as its own event, the key
    # press of the same letter arrives first with no character, and the field takes it so the
    # screen's own handler cannot close the inventory on it; the character event appends the letter.
    character: number = ctx.character()
    if character > 0 {
        if String.length(query) < max_query {
            query = String.concat(query, String.from_character(character))
            page = 0
        }
        ctx.take()
        return
    }

    key: number = ctx.key()
    if key == key_backspace {
        length: number = String.length(query)
        if length > 0 {
            query = String.substring(query, 0, length - 1)
            page = 0
        }
        ctx.take()
        return
    }
    # A letter, a digit or the space bar with no character of its own is the first event of a press
    # whose character arrives next, so it is taken here and typed by that event.
    printable: bool = (key >= 48 and key <= 57) or (key >= 65 and key <= 90) or key == key_space
    if printable {
        ctx.take()
    }
}

export scroll(ctx: OverlayScrollContext) {
    if not shown {
        return
    }
    delta: number = ctx.delta()
    if delta == 0 {
        return
    }

    screen_width: number = ctx.screen_width()
    columns: number = _columns(screen_width, ctx.gui_left(), ctx.gui_width())
    rows: number = _rows(ctx.screen_height())
    if columns < min_columns or rows < min_rows {
        return
    }
    if not _over_list(ctx.mouse_x(), ctx.mouse_y(), screen_width, ctx.gui_left(), ctx.gui_width(), columns, rows) {
        return
    }

    count: number = search_item_count(query)
    per_page: number = columns * rows
    _fit_page(per_page, count)
    pages: number = _page_count(per_page, count)
    # The wheel moves down for the next page, and wraps like the buttons do.
    step: number = 1
    if delta > 0 {
        step = -1
    }
    page = Math.remainder(page + step + pages, pages)
    ctx.take()
}

# The search field: an outline that is drawn white while it has the keyboard, with the text and,
# while focused, an underscore cursor after it. The field's text is white, the reference's own
# colour, and red when nothing matches, which is its filter-empty colour.
local _draw_search(ctx: OverlayRenderContext, left: number, width: number, screen_height: number) {
    top: number = screen_height - border_margin - search_height
    right: number = left + width
    bottom: number = top + search_height
    if focused {
        ctx.draw_box(left, top, right, top + 1)
        ctx.draw_box(left, bottom - 1, right, bottom)
        ctx.draw_box(left, top + 1, left + 1, bottom - 1)
        ctx.draw_box(right - 1, top + 1, right, bottom - 1)
    }
    text: string = query
    if focused {
        text = String.concat(query, "_")
    }
    # The text is cut to its last characters when it is wider than the field, which the typed end of
    # it stays visible in; a character is at most 6 pixels wide with its spacing.
    fit: number = Math.floor((width - 10) / 6)
    if String.length(text) > fit {
        text = String.substring(text, String.length(text) - fit, String.length(text))
    }
    color: Color = Color.rgb(255, 255, 255)
    if search_item_count(query) == 0 {
        color = Color.rgb(255, 85, 85)
    }
    ctx.draw_text(text, left + 4, top + 6, color)
}

# Whether a point is on the search field.
local _on_search(mouse_x: number, mouse_y: number, screen_width: number, gui_left: number, gui_width: number, columns: number, screen_height: number) bool {
    left: number = _grid_x(screen_width, gui_left, gui_width)
    top: number = screen_height - border_margin - search_height
    return mouse_x >= left and mouse_x < left + columns * slot and mouse_y >= top and mouse_y < top + search_height
}

# A page button plays the game's button click, the way the reference's buttons do (Button's
# playDownSound): 1.20.6's ui.button.click at volume 0.25, and the older versions' random.click at
# full volume, which is what their buttons play. A version whose sound pool has not loaded the file
# plays nothing, which has_sound tells.
local _play_click() {
    if has_sound("minecraft:ui.button.click") {
        play_ui_sound("minecraft:ui.button.click", 0.25, 1)
    } else if has_sound("minecraft:random.click") {
        play_ui_sound("minecraft:random.click", 1, 1)
    }
}

# -1 for the back button, 1 for the next button, 0 for a press that is on neither.
local _button_step(mouse_x: number, mouse_y: number, screen_width: number, gui_left: number, gui_width: number, columns: number) number {
    if mouse_y < border_margin or mouse_y >= border_margin + button_size {
        return 0
    }
    grid_x: number = _grid_x(screen_width, gui_left, gui_width)
    if mouse_x >= grid_x and mouse_x < grid_x + button_size {
        return -1
    }
    grid_right: number = grid_x + columns * slot
    if mouse_x >= grid_right - button_size and mouse_x < grid_right {
        return 1
    }
    return 0
}

local _page_count(per_page: number, count: number) number {
    pages: number = Math.floor((count + per_page - 1) / per_page)
    if pages < 1 {
        return 1
    }
    return pages
}

local _fit_page(per_page: number, count: number) {
    last: number = _page_count(per_page, count) - 1
    if page > last {
        page = last
    }
}

# Whether a point is over the grid or the page buttons above it, the area the reference's wheel
# handler asks about (the grid's slots joined with its navigation).
local _over_list(mouse_x: number, mouse_y: number, screen_width: number, gui_left: number, gui_width: number, columns: number, rows: number) bool {
    grid_x: number = _grid_x(screen_width, gui_left, gui_width)
    if mouse_x < grid_x or mouse_x >= grid_x + columns * slot {
        return false
    }
    return mouse_y >= border_margin and mouse_y < _grid_y() + rows * slot
}

local _clicked_index(mouse_x: number, mouse_y: number, screen_width: number, gui_left: number, gui_width: number, columns: number, rows: number) number {
    grid_x: number = _grid_x(screen_width, gui_left, gui_width)
    grid_y: number = _grid_y()
    if mouse_x < grid_x or mouse_x >= grid_x + columns * slot {
        return -1
    }
    if mouse_y < grid_y or mouse_y >= grid_y + rows * slot {
        return -1
    }
    column: number = Math.floor((mouse_x - grid_x) / slot)
    row: number = Math.floor((mouse_y - grid_y) / slot)
    return row * columns + column
}

local _grid_x(screen_width: number, gui_left: number, gui_width: number) number {
    display_left: number = _display_left(gui_left, gui_width)
    available_width: number = _available_width(screen_width, gui_left, gui_width)
    return display_left + border_margin + (available_width - _columns(screen_width, gui_left, gui_width) * slot)
}

local _grid_y() number {
    return border_margin + navigation_area
}

local _columns(screen_width: number, gui_left: number, gui_width: number) number {
    available: number = Math.floor(_available_width(screen_width, gui_left, gui_width) / slot)
    if available > max_columns {
        return max_columns
    }
    return available
}

local _available_width(screen_width: number, gui_left: number, gui_width: number) number {
    return screen_width - _display_left(gui_left, gui_width) - border_margin * 2
}

local _rows(screen_height: number) number {
    available: number = Math.floor(_available_height(screen_height) / slot)
    if available > max_rows {
        return max_rows
    }
    return available
}

local _available_height(screen_height: number) number {
    return screen_height - search_area - navigation_area - border_margin * 2
}

local _display_left(gui_left: number, gui_width: number) number {
    return gui_left + gui_width
}

local _column(index: number, columns: number) number {
    return Math.remainder(index, columns)
}

local _row(index: number, columns: number) number {
    return Math.floor(index / columns)
}

local _inside(mouse_x: number, mouse_y: number, slot_x: number, slot_y: number) bool {
    return mouse_x >= slot_x and mouse_x < slot_x + slot and mouse_y >= slot_y and mouse_y < slot_y + slot
}
