# Covers the diamond pipe's filter GUI, which PipeLogicDiamond.blockActivated opens: GuiDiamondPipe's
# 175 by 225 filter.png panel rather than the vanilla container's 176 by 166, with six rows of nine
# filter slots from panel (8, 18) and the player inventory below them. The click on the first filter
# slot is gui_slot's: the carried diamond goes whole into the block entity's own slot 0, which says the
# layout's slots are working container slots and that the panel size is the one the GUI was given.
started: bool = false
clicked: bool = false

export tick(ctx: TestTickContext) {
    if not started {
        started = true
        ctx.close_screen()
        ctx.clear_held_item(ctx.get_player())
        level: Level = ctx.get_client_level()
        origin: Vec3 = ctx.get_origin()
        level.place_block(origin.x(), origin.y(), origin.z(), "grug:diamond_pipe")
        ctx.use_block(level, origin.x(), origin.y(), origin.z())
        ctx.not_done()
        return
    }
    if not clicked {
        # The server opens the container and sends it, so the client's screen arrives a frame later.
        if not ctx.screen_open() {
            ctx.not_done()
            return
        }
        clicked = true
        ctx.assert(ctx.gui_width() == 175, "The filter panel should be the reference's 175 pixels wide.")
        ctx.assert(ctx.gui_height() == 225, "The filter panel should be the reference's 225 pixels tall.")
        ctx.set_carried_item(item(resource_location("minecraft:diamond")))
        left: number = ctx.gui_left()
        top: number = ctx.gui_top()
        # The first filter slot's box starts at panel (8, 18) and a slot is 16 pixels, so this presses
        # its centre. No overlay is asked on a mod's own screen, so the press is the screen's.
        ctx.assert(not ctx.click_screen(left + 16, top + 26, 0), "A press no overlay took should answer false.")
        ctx.not_done()
        return
    }
    level: Level = ctx.get_client_level()
    origin: Vec3 = ctx.get_origin()
    pipe: BlockEntity = level.get_block_entity(origin.x(), origin.y(), origin.z()).unwrap()
    ctx.assert(pipe.get_item_count_in_slot(0) == 1, "The click should have put the diamond in the first filter slot.")
    in_slot: Option[Item] = pipe.get_item_in_slot(0)
    ctx.assert(in_slot.has(), "The first filter slot should hold the diamond.")
    if in_slot.has() {
        ctx.assert(equals(in_slot.unwrap(), item(resource_location("minecraft:diamond"))), "The click should have moved the diamond, not another item.")
    }
    ctx.assert(not ctx.get_carried_item().has(), "The click should have taken the item off the cursor.")
    ctx.close_screen()
}
