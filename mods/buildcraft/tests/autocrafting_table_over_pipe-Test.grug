# Covers the autocrafting table between a chest and a wooden pipe, the reference's signature build:
# a chest, a wooden pipe, and the table in a row, with the pipe connecting to the table. The
# reference's source scan finds the table before the chest, so the pipe's plain source arm is drawn
# on the table's side and the patterned arm on the chest's, which is what the capture pins. The
# screenshot is the assertion. The fixture is static, so no items need to move for the capture.
table_entity: Option[BlockEntity] = Option.new()
pipe_entity: Option[BlockEntity] = Option.new()

# Whether the wall and the section have been meshed again from the settled light yet.
remeshed: bool = false

# How many runner ticks in a row the world has answered settled. See the hold in tick_any_side().
settled_ticks: number = 0

# TEMPORARY DIAGNOSTIC probe flag. Remove with the probe.
probed: bool = false

# The origin _setup built from, which the later steps build from too.
origin_x: number = 0
origin_y: number = 0
origin_z: number = 0

export tick_any_side(ctx: TestTickContext) {
    if ctx.current_tick() == 0 {
        _setup(ctx)
        ctx.not_done()
    } else if not ctx.world_settled() {
        settled_ticks = 0
        ctx.not_done()
    } else if settled_ticks < 5 {
        settled_ticks = settled_ticks + 1
        ctx.not_done()
    } else if not remeshed {
        _force_remesh(ctx)
        remeshed = true
        ctx.not_done()
    } else if not ctx.world_settled() {
        ctx.not_done()
    } else {
        if not probed {
            _probe(ctx)
            probed = true
        }
        ctx.assert(table_entity.has(), "The table should have a block entity.")
        ctx.assert(pipe_entity.has(), "The pipe should have a block entity.")
        ctx.screenshot().equals(r"screenshots/autocrafting_table_over_pipe", 400, 120, 880, 360)
    }
}

local _setup(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()

    ctx.set_box_radius(6)

    origin: Vec3 = ctx.get_origin()
    x: number = origin.x()
    y: number = origin.y()
    z: number = origin.z()
    origin_x = x
    origin_y = y
    origin_z = z

    _wall(level, x - 6, y - 9, z + 6)

    # Table, wooden pipe feeding it from the south, chest behind the pipe as the source.
    _place_table(ctx, level, x, y - 1.88, z + 4)
    _place_pipe(ctx, level, x, y - 1.88, z + 5)
    level.place_block(x, y - 1.88, z + 6, "minecraft:chest")

    table_opt: Option[BlockEntity] = level.get_block_entity(x, y - 1.88, z + 4)
    pipe_opt: Option[BlockEntity] = level.get_block_entity(x, y - 1.88, z + 5)
    ctx.assert(table_opt.has(), "The table should have a block entity.")
    ctx.assert(pipe_opt.has(), "The pipe should have a block entity.")
    table_entity.set(table_opt.unwrap())
    pipe_entity.set(pipe_opt.unwrap())

    # The reference's switchSource scans YPos, ZNeg, ZPos and the rest in that order and keeps the
    # first neighbour that is an inventory, so it finds the table at ZNeg and never reaches the
    # chest at ZPos: this pipe extracts from the table, not from the chest. The port's saved source
    # is the side plus one, and ZNeg is side 2, so the saved source is 3.
    if not me.is_reference() {
        pipe_entity.unwrap().set_saved_number("source", 3)
    }
}

# The reference's autocrafting table block name differs from the port's. The port places the
# block directly; the reference uses the same block id.
local _place_table(ctx: TestTickContext, level: Level, x: number, y: number, z: number) {
    if not me.is_reference() {
        level.place_block(x, y, z, "grug:autocrafting_table")
        return
    }
    level.place_block(x, y, z, "buildcraft:autoWorkbenchBlock")
}

# Both the reference and the port place the pipe the way a player does: hold the pipe item and
# right-click the side of a block at z + 1. The reference's ItemPipe sets the pipe's kind, and the
# placement is what settles the light around the pipe, so both scenes must use the same path. The
# block at z + 1 is the cell the test fills with the chest next, so the chest replaces that stone.
local _place_pipe(ctx: TestTickContext, level: Level, x: number, y: number, z: number) {
    level.place_block(x, y, z + 1, "minecraft:stone")
    player: Player = ctx.get_player()
    if me.is_reference() {
        ctx.set_held_item(player, item(resource_location("buildcraft:PipeItemsWood")))
        ctx.use_block(level, x, y, z + 1)
        ctx.clear_held_item(player)
        return
    }
    ctx.set_held_item(player, item(resource_location("grug:wooden_pipe")))
    ctx.use_block(level, x, y, z + 1)
    ctx.clear_held_item(player)
}

# Thirteen blocks square of minecraft:stone at (x0, y0, z), which covers the crop with room to
# spare.
local _wall(level: Level, x0: number, y0: number, z: number) {
    wy: number = y0
    while wy < y0 + 13 {
        wx: number = x0
        while wx < x0 + 13 {
            level.place_block(wx, wy, z, "minecraft:stone")
            wx = wx + 1
        }
        wy = wy + 1
    }
}

# Meshes the crop's section again from the settled light by changing a block state and putting it
# back. The swapped block is outside the crop, and dirt and stone are both opaque and unlit, so the
# swap changes no light and no compared pixel.
local _force_remesh(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    x: number = origin_x
    y: number = origin_y
    z: number = origin_z
    level.place_block(x - 6, y + 3, z + 6, "minecraft:dirt")
    level.place_block(x - 6, y + 3, z + 6, "minecraft:stone")
    ctx.assert(level.get_block(x - 6, y + 3, z + 6) == "minecraft:stone", "The remesh swap should have put the wall block back.")
}

# TEMPORARY DIAGNOSTIC: prints the block light the capture is drawn from, on the reference side and
# the port side alike, so the two logs can be compared. Remove before this test is merged.
local _probe(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    fx: number = origin_x
    fy: number = origin_y - 1.88
    fz: number = origin_z
    dx: number = 0
    dy: number = 0
    print3("PROBE origin", origin_x, origin_z)
    print(origin_y)
    dx = -3
    while dx <= 3 {
        dy = -3
        while dy <= 3 {
            print3(dx, dy, level.get_block_light(fx + dx, fy + dy, fz + 5))
            dy = dy + 1
        }
        dx = dx + 1
    }
    print("PROBE blocks at the fixture row")
    dx = -3
    while dx <= 3 {
        print2(dx, level.get_block(fx + dx, fy, fz + 5))
        print(level.get_block(fx + dx, fy, fz + 6))
        dx = dx + 1
    }
    print("PROBE column at z+5 from y-5 to y+2")
    dy = -5
    while dy <= 2 {
        print2(dy, level.get_block(fx, fy + dy, fz + 5))
        dy = dy + 1
    }
    print("PROBE column at z+4 from y-5 to y+2")
    dy = -5
    while dy <= 2 {
        print2(dy, level.get_block(fx, fy + dy, fz + 4))
        dy = dy + 1
    }
    print3("PROBE sky and block light at the pipe cell", level.get_sky_light(fx, fy, fz + 5), level.get_block_light(fx, fy, fz + 5))
    print3("PROBE sky and block light above the table", level.get_sky_light(fx, fy, fz + 2), level.get_block_light(fx, fy, fz + 2))
    print2("PROBE time", level.get_time())
}
