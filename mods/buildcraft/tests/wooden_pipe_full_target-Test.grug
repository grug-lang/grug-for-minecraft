# Covers the wooden pipe dropping its travelling item when the only other inventory has no room for
# it. This is the other half of wooden_pipe_drop_damage-Test.grug: that test has no other inventory at
# all, this one has a connected chest that is full. In the reference both come to the same end: a full
# inventory fails canReceivePipeObjects, so the exit list at the pipe's centre is empty and the item
# is dropped there, rather than being carried to the full chest's face and dropped against it.
full_target_source: Option[BlockEntity] = Option.new()
full_target_target: Option[BlockEntity] = Option.new()
full_target_pipe: Option[BlockEntity] = Option.new()

# ItemEntity exposes only damage(), not the item it holds, so the damage is what identifies the
# dropped stack. wooden_pipe_drop_damage-Test.grug uses the same trick, and the filler being
# undamaged means a merge into the target would also change its damage and be caught.
sword_damage: number = 7

# Waiting for the pipe is waiting for the game's clock and nothing is drawn or read from a frame,
# so the clock may run faster: the test counts the same game ticks and takes a fraction of the
# seconds. See TestInitContext.set_game_speed.
export init(ctx: TestInitContext) {
    ctx.set_game_speed(10)
}

export tick(ctx: TestTickContext) {
    if ctx.current_tick() == 0 {
        _full_target_setup(ctx)
        ctx.not_done()
    } else if not _full_target_pipe_has_moved() or ctx.current_tick() < 25 {
        # Same floor as wooden_pipe-Test.grug, for the same reason (#262).
        ctx.not_done()
    } else {
        _full_target_check(ctx)
    }
}

local _full_target_setup(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    # A clear band: the other pipe tests use +25, +35, +45 and +50. +50 is the top of the ladder,
    # and it is the one that has to stay inside Alpha's 128-block world height, so a new band goes
    # below it rather than above it.
    y: number = origin.y() + 40
    z: number = origin.z()

    # The source sits below the pipe and the engine beside it, so the pipe's six sides hold exactly
    # two inventories: the sword below, and the full chest to the side. A fresh pipe's side is 0,
    # below, and it keeps that side while it holds an inventory, so the sword's chest is the source.
    level.place_block(x, y - 1, z, "minecraft:chest")
    level.place_block(x, y, z, "grug:wooden_pipe")
    level.place_block(x + 1, y, z, "minecraft:chest")

    # The engine is beside the pipe rather than below it, because below is the source. A torch powers
    # the block above it, but not the block it is attached to, and a standing torch does not power the
    # block above its own base, so this puts a torch under the engine with stone beneath that.
    level.place_block(x - 1, y - 2, z, "minecraft:stone")
    level.place_block(x - 1, y - 1, z, "minecraft:redstone_torch")
    level.place_block(x - 1, y, z, "grug:redstone_engine")

    source_opt: Option[BlockEntity] = level.get_block_entity(x, y - 1, z)
    target_opt: Option[BlockEntity] = level.get_block_entity(x + 1, y, z)
    pipe_opt: Option[BlockEntity] = level.get_block_entity(x, y, z)
    ctx.assert(source_opt.has(), "The source chest should have a block entity.")
    ctx.assert(target_opt.has(), "The target chest should have a block entity.")
    ctx.assert(pipe_opt.has(), "The pipe should have a block entity.")
    ctx.assert(level.has_neighbor_signal(x - 1, y, z), "The engine should be powered by the torch.")
    ctx.assert(level.has_neighbor_signal(x, y, z), "The pipe should be powered by the engine.")

    full_target_source.set(source_opt.unwrap())
    full_target_target.set(target_opt.unwrap())
    full_target_pipe.set(pipe_opt.unwrap())

    # Fill every slot the target actually has, rather than a fixed count: a chest is 36 slots on Alpha
    # and 27 on every later version, so a hardcoded 27 would leave room on Alpha, the pipe would
    # insert instead of dropping, and the test would mean different things on different loaders.
    size: number = full_target_target.unwrap().get_inventory_size()
    ctx.assert(size > 0, "The target chest should have an inventory.")
    # Diamonds are the filler rather than cobblestone for two reasons: a diamond sword does not stack
    # with a diamond, so the pipe cannot merge into an existing stack; and on Alpha item() resolves a
    # name with no matching Item field by falling through to the block of that name, so cobblestone
    # comes back as a Block and cannot go in a slot at all.
    filler: Item = item(resource_location("minecraft:diamond"))
    slot: number = 0
    while slot < size {
        full_target_target.unwrap().set_item_in_slot(slot, filler, 64)
        slot = slot + 1
    }

    sword: Item = item(resource_location("minecraft:diamond_sword"))
    full_target_source.unwrap().set_item_in_slot(0, sword, 1)
    full_target_source.unwrap().set_item_damage_in_slot(0, sword_damage)
    ctx.assert(full_target_source.unwrap().get_item_count_in_slot(0) == 1, "The source chest should have been given the sword.")
}

local _full_target_check(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 40
    z: number = origin.z()

    source_count: number = full_target_source.unwrap().get_item_count_in_slot(0)
    target_count: number = full_target_target.unwrap().get_item_count_in_slot(0)
    pipe_travelling: number = full_target_pipe.unwrap().get_saved_list_size("traveling")

    # The item is accounted for at every place it could be: taken from the source, not carried by
    # the pipe, not merged into the full target, and on the ground exactly once.
    ctx.assert(source_count == 0, "The source chest should be empty.")
    ctx.assert(pipe_travelling == 0, "The pipe should not still be carrying the sword.")
    ctx.assert(target_count == 64, "The target chest slot 0 should still hold its 64 diamonds.")

    # The filler is undamaged and the sword is not, so the item check catches a merge as well as an
    # insert into some other slot. equals, not ==, because == compares grug entity IDs rather than
    # the underlying game item.
    target_item: Option[Item] = full_target_target.unwrap().get_item_in_slot(0)
    ctx.assert(target_item.has(), "The target chest slot 0 should still hold an item.")
    ctx.assert(equals(target_item.unwrap(), item(resource_location("minecraft:diamond"))), "The target chest should still hold diamonds, not the sword.")

    # Counting the item entities, not merely finding one, is what makes this an accounting test: a
    # pipe that both inserted and dropped, or dropped twice, would still pass a find-one assertion.
    dropped_count: number = level.count_item_entities(x, y, z, 10)
    ctx.assert(dropped_count == 1, "Exactly one item entity should have been dropped near the pipe.")

    found: Option[ItemEntity] = level.find_item_entity(x, y, z, 10)
    ctx.assert(found.has(), "The pipe should have dropped the sword.")
    dropped: ItemEntity = found.unwrap()
    ctx.assert(dropped.damage() == sword_damage, "The dropped sword should keep its damage.")
}

# The pipe has finished with the item once it has left the source chest and the pipe's travelling
# list. With every target slot filled that means it is on the ground, which is what
# _full_target_check accounts for; waiting for the item entity instead would risk the sword dropped
# by the band above this one, which is ten blocks away and falls through this test's search radius on
# its way down. See #173.
local _full_target_pipe_has_moved() bool {
    source_empty: bool = full_target_source.unwrap().get_item_count_in_slot(0) == 0
    pipe_empty: bool = full_target_pipe.unwrap().get_saved_list_size("traveling") == 0
    return source_empty and pipe_empty
}
