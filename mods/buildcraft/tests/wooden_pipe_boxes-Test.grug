# Covers the wooden pipe's collision and selection box: BuildCraft 2.2.14's centre-and-arms bounds,
# which follow the same connections the pipe's render draws. The reference's collision method adds
# getCollisionBoundingBoxFromPool, which the reference overrides to recompute the union from the
# connections, so its collision box is the same union box its selection box is, and both of them are
# what the port declares. A player is kept out of the space the union covers, which at a corner
# reaches past the drawn arms, and a click outside the union misses the pipe. That is what
# separates this from the full cube the pipe used while mod_api.json had no shape.
# Every box is asked of the game rather than of the script, in block-local coordinates from the
# block's minimum corner, so the reference pipe answers the same questions through the same code.
# The fixture is a straight run, a corner and then a pipe with no neighbour at all, all three from
# the one pipe so every answer comes from the same world state a player would see.
origin_x: number = 0
origin_y: number = 0
origin_z: number = 0
phase: number = 0

export tick(ctx: TestTickContext) {
    if phase != 0 {
        return
    }
    phase = 1

    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    origin_x = origin.x()
    origin_y = origin.y() - 1.88
    origin_z = origin.z()

    # A straight run: an inventory on each side, so the pipe has two opposite arms.
    _place_pipe(level, origin_x, origin_y, origin_z)
    level.place_block(origin_x - 1, origin_y, origin_z, "minecraft:chest")
    level.place_block(origin_x + 1, origin_y, origin_z, "minecraft:chest")
    _check_straight(ctx, level, origin_x, origin_y, origin_z)

    # A corner: the west arm goes and a north one arrives, so two arms meet at right angles.
    level.place_block(origin_x - 1, origin_y, origin_z, "minecraft:air")
    level.place_block(origin_x, origin_y, origin_z - 1, "minecraft:chest")
    _check_corner(ctx, level, origin_x, origin_y, origin_z)

    # Alone: no neighbour takes an item, so only the centre is left.
    level.place_block(origin_x + 1, origin_y, origin_z, "minecraft:air")
    level.place_block(origin_x, origin_y, origin_z - 1, "minecraft:air")
    _check_alone(ctx, level, origin_x, origin_y, origin_z)
}

# The reference's pipe gets its kind from ItemPipe, so it is placed as a player places it, by
# right-clicking the top of a block under it with the pipe held, and that block is cleared again so
# both scenes hold the same blocks.
local _place_pipe(level: Level, x: number, y: number, z: number) {
    if not Test.is_reference() {
        level.place_block(x, y, z, "grug:wooden_pipe")
        return
    }
    level.place_block(x, y - 1, z, "minecraft:stone")
    player: Player = Test.get_player()
    held: Item = item(resource_location("buildcraft:PipeItemsWood"))
    Test.set_held_item(player, held)
    Test.use_block(level, x, y - 1, z)
    Test.clear_held_item(player)
    level.place_block(x, y - 1, z, "minecraft:air")
}

# A straight run along x: the centre and the two arms collide, the space above and below the pipe
# does not, and the selection box reaches both arms but no further.
local _check_straight(ctx: TestTickContext, level: Level, x: number, y: number, z: number) {
    ctx.assert(Test.block_collision(level, x, y, z, 0.35, 0.35, 0.35, 0.65, 0.65, 0.65), "A straight run's centre should collide.")
    ctx.assert(Test.block_collision(level, x, y, z, 0.02, 0.35, 0.35, 0.2, 0.65, 0.65), "A straight run's west arm should collide.")
    ctx.assert(Test.block_collision(level, x, y, z, 0.8, 0.35, 0.35, 0.98, 0.65, 0.65), "A straight run's east arm should collide.")
    ctx.assert(not Test.block_collision(level, x, y, z, 0.3, 0.0, 0.3, 0.7, 0.2, 0.7), "The space under a straight run should be empty.")
    ctx.assert(not Test.block_collision(level, x, y, z, 0.3, 0.8, 0.3, 0.7, 1.0, 0.7), "The space above a straight run should be empty.")

    ctx.assert(Test.block_selection(level, x, y, z, 0.05, 0.5, 0.5), "A straight run's selection should reach the west arm.")
    ctx.assert(Test.block_selection(level, x, y, z, 0.95, 0.5, 0.5), "A straight run's selection should reach the east arm.")
    ctx.assert(not Test.block_selection(level, x, y, z, 0.5, 0.1, 0.5), "A straight run's selection should not reach under the pipe.")
    ctx.assert(not Test.block_selection(level, x, y, z, 0.5, 0.9, 0.5), "A straight run's selection should not reach above the pipe.")
    ctx.assert(not Test.block_selection(level, x, y, z, 0.05, 0.1, 0.5), "A straight run's selection should not reach the empty corner.")
}

# A corner with an east arm and a north arm: the union starts at the centre's near corner and
# reaches this block's face both east and north, so both arms collide and so does the corner between
# them that neither arm is drawn in, which is a reference bug the port reproduces. The two sides the
# pipe does not reach stay empty, and so do the space under the pipe and the corners beyond the
# union.
local _check_corner(ctx: TestTickContext, level: Level, x: number, y: number, z: number) {
    ctx.assert(Test.block_collision(level, x, y, z, 0.8, 0.35, 0.35, 0.98, 0.65, 0.65), "A corner's east arm should collide.")
    ctx.assert(Test.block_collision(level, x, y, z, 0.35, 0.35, 0.02, 0.65, 0.65, 0.2), "A corner's north arm should collide.")
    ctx.assert(Test.block_collision(level, x, y, z, 0.8, 0.35, 0.02, 0.98, 0.65, 0.2), "The corner between a corner's two arms should collide, as the reference's union box does.")
    ctx.assert(not Test.block_collision(level, x, y, z, 0.02, 0.35, 0.8, 0.2, 0.65, 0.98), "A corner's south-west side should be empty.")
    ctx.assert(not Test.block_collision(level, x, y, z, 0.02, 0.35, 0.02, 0.2, 0.65, 0.2), "A corner's north-west side should be empty.")
    ctx.assert(not Test.block_collision(level, x, y, z, 0.3, 0.0, 0.3, 0.7, 0.2, 0.7), "The space under a corner should be empty.")

    ctx.assert(Test.block_selection(level, x, y, z, 0.95, 0.5, 0.5), "A corner's selection should reach the east arm.")
    ctx.assert(Test.block_selection(level, x, y, z, 0.5, 0.5, 0.05), "A corner's selection should reach the north arm.")
    ctx.assert(Test.block_selection(level, x, y, z, 0.9, 0.5, 0.1), "A corner's selection should reach the corner between its two arms, as the reference's union box does.")
    ctx.assert(not Test.block_selection(level, x, y, z, 0.1, 0.5, 0.5), "A corner's selection should not reach the west side.")
    ctx.assert(not Test.block_selection(level, x, y, z, 0.5, 0.5, 0.95), "A corner's selection should not reach the south side.")
    ctx.assert(not Test.block_selection(level, x, y, z, 0.1, 0.5, 0.9), "A corner's selection should not reach the empty corner.")
}

# A pipe with nothing beside it: only the quarter-block centre is solid, and the selection box is
# that same centre.
local _check_alone(ctx: TestTickContext, level: Level, x: number, y: number, z: number) {
    ctx.assert(Test.block_collision(level, x, y, z, 0.35, 0.35, 0.35, 0.65, 0.65, 0.65), "A pipe with no neighbour should still collide at its centre.")
    ctx.assert(not Test.block_collision(level, x, y, z, 0.02, 0.35, 0.35, 0.2, 0.65, 0.65), "A pipe with no neighbour should have no west arm.")
    ctx.assert(Test.block_selection(level, x, y, z, 0.5, 0.5, 0.5), "A pipe with no neighbour should be selected at its centre.")
    ctx.assert(not Test.block_selection(level, x, y, z, 0.1, 0.5, 0.5), "A pipe with no neighbour should not be selected at a side.")
}
