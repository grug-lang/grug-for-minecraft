# Covers how a charged redstone engine is drawn in each of its six facings: the trunk colour for its
# energy stage and the plate at its farthest, both turned about the block's centre by RenderEngine. The
# existing captures show the facings and the stroke on a blue engine at rest (redstone_engine_facings,
# redstone_engine_stroke_facings) and the four stages on one engine facing up (redstone_engine_*), so
# this one pins the stage colour on the five rotated trunks too. The first capture shows six engines
# in the green stage (251 to 500 of 1000 energy) and the second six in the red stage (over 750), facing
# 0 at the right and 5 at the left, since the camera looks towards +z, each with its plate out at a
# progress of 0.5. The energy is set near the top of the stage, 495 and 995, so the one energy an
# unpowered engine loses each tick cannot take it out of the stage while the capture's wait runs, and
# the wait asks for the stage rather than for that number. The reference run has no grug saved data,
# so it sets the real TileEngine's "orientation", "progress" and "energy" through its NBT, and
# ctx.load_nbt replaces the engine with one loaded from it and redraws the block.
# The capture stops high on the screen because the runner prints each test's name to the chat on
# every loader but 1.2.5, and that readout grows to ten lines of 27 pixels once a repeat has run, so
# anything below about y=250 holds text in a later repeat. Each capture first lets the engines at rest
# settle, be meshed and take the light, then sets the six engines' numbers once and waits only for the
# client's copy of them, which is the copy the frame pass draws, and for a frame drawn after it: the
# energy is a number that pass reads, so no mesh and no light depends on it, and the full settle is not
# repeated for it. See _showed, _drawn and #1811.
# Where the leftmost engine is, which is where the row starts, one block apart towards +x.
ex: number = 0
ey: number = 0
ez: number = 0

# Which capture is next: 0 is the green stage and 1 is the red stage.
capture: number = 0

# Whether the capture's orientation, progress and energy have been set. A capture needs the scene
# settled and lit before them, which is _ready, the client's copy of them after, which is _showed, and
# a frame drawn after that copy, which is _drawn.
changed: bool = false

# Whether the block swap that gives the renderer work after the numbers are set has been made. See
# _drawn.
swapped: bool = false

# The waits before each capture, as coverage_render-Test.grug explains them. See _ready.
settled_ticks: number = 0
remeshed: bool = false

export tick(ctx: TestTickContext) {
    if ctx.current_tick() == 0 {
        _setup(ctx)
        ctx.not_done()
        return
    }

    # redstone_engine-Test.grug, which runs before this, leaves its torch lit to the end, and the red
    # particles that torch gave off live for up to 40 ticks after it is cleared away. One of them in
    # the crop is a few pixels that are never in the same place twice, so wait out the longest life
    # with some to spare. The world has no way to say how many particles are left.
    if ctx.current_tick() < 60 {
        ctx.not_done()
        return
    }

    # The scene is settled, meshed and lit once, with every engine at rest and facing up, before any
    # energy is set. The energy is only a number the frame pass reads, so nothing is settled for it a
    # second time: the wait after it is the client's own copy, which is the copy that pass reads, and
    # then a frame drawn after it. See _ready, _showed and _drawn.
    if not changed {
        if not _ready(ctx) {
            ctx.not_done()
            return
        }
        if capture == 0 {
            _show(ctx, 495)
        } else {
            _show(ctx, 995)
        }
        changed = true
        swapped = false
        if me.is_reference() {
            # The reference's engines are the real TileEngine, and load_nbt replaced each one with a
            # tile loaded from its NBT and redrew the block, so its capture has to wait for frames
            # drawn after that edit, which is a settle wait again. There is no grug saved number to
            # wait on instead: set_saved_number is the port's, and client_saved_number answers 0 for
            # a copy that never saved one. The wait stays short because the reference run is a client
            # leg, where each of these calls is local.
            settled_ticks = 0
            remeshed = false
        }
        ctx.not_done()
        return
    }

    if me.is_reference() {
        if not _ready(ctx) {
            ctx.not_done()
            return
        }
    } else if not _showed(ctx) {
        ctx.not_done()
        return
    } else if not _drawn(ctx) {
        ctx.not_done()
        return
    }

    # Both runs compare against the same committed pixels, because the port draws the engine from the
    # path the reference does. See the top of this file.
    if capture == 0 {
        ctx.screenshot().equals(r"screenshots/redstone_engine_green_facings", 400, 100, 880, 230)
        capture = 1
        changed = false
        ctx.not_done()
        return
    }

    ctx.screenshot().equals(r"screenshots/redstone_engine_red_facings", 400, 100, 880, 230)
}

local _setup(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()

    ctx.set_box_radius(10)

    origin: Vec3 = ctx.get_origin()
    ex = origin.x() - 3
    ey = origin.y() + 0.12
    ez = origin.z() + 8

    _wall(level, origin.x() - 8, origin.y() - 9, origin.z() + 10)

    i: number = 0
    while i < 6 {
        _place_engine(ctx, level, ex + i, ey, ez)
        i = i + 1
    }
}

# Seventeen blocks square of stone two blocks behind the engines, as in coverage_render-Test.grug.
local _wall(level: Level, x0: number, y0: number, z: number) {
    wy: number = y0
    while wy < y0 + 17 {
        wx: number = x0
        while wx < x0 + 17 {
            level.place_block(wx, wy, z, "minecraft:stone")
            wx = wx + 1
        }
        wy = wy + 1
    }
}

# Gives the engine in each place the facing of its number, the progress 0.5 and the energy.
local _show(ctx: TestTickContext, energy: number) {
    i: number = 0
    while i < 6 {
        engine: BlockEntity = _engine(ctx, i)
        if me.is_reference() {
            ctx.set_nbt_number(engine, "orientation", "int", i)
            ctx.set_nbt_number(engine, "progress", "float", 0.5)
            ctx.set_nbt_number(engine, "energy", "int", energy)
            ctx.load_nbt(engine)
        } else {
            engine.set_saved_number("orientation", i)
            engine.set_saved_number("oriented", 1)
            engine.set_saved_number("progress", 0.5)
            engine.set_saved_number("energy", energy)
        }
        i = i + 1
    }
}

# The engine i blocks along the row.
local _engine(ctx: TestTickContext, i: number) BlockEntity {
    level: Level = ctx.get_client_level()
    engine_opt: Option[BlockEntity] = level.get_block_entity(ex + i, ey, ez)
    ctx.assert(engine_opt.has(), "The redstone engine should have a block entity.")
    return engine_opt.unwrap()
}

# Whether the client's copy of every engine holds an energy the capture's stage draws its trunk for.
# One save is made per engine, and a send carries the whole saved data, so a copy that holds the energy
# holds the facing and the progress saved with it. A capture alone cannot say the numbers arrived: a
# section built again or a light step moves a frame too (#1162). This is not enough on its own to take
# the capture, though, because a client's copy is its own: see _drawn.
local _showed(ctx: TestTickContext) bool {
    i: number = 0
    while i < 6 {
        if not _in_stage(ctx.client_saved_number(_engine(ctx, i), "energy")) {
            return false
        }
        i = i + 1
    }
    return true
}

# Whether a frame has been drawn since the client's copy held the numbers. A client's copy is the copy
# its own process writes, so _showed answers on the very tick the numbers are set, and a capture then
# reads the framebuffer of the frame drawn before them: the four client legs of #1812, 1.2.5-forge,
# a1.1.2_01-ornithe, b1.7.3-ornithe and b1.7.3-stationapi, drew all six engines at rest with the
# numbers already in the copy, while every dedicated leg passed. A block swap outside the crop is work
# the renderer owes, so a settled answer can only come from a frame drawn after the set, and that
# frame's pass reads the numbers. The light has not changed since _ready, so that wait is not repeated.
local _drawn(ctx: TestTickContext) bool {
    if not swapped {
        _force_remesh(ctx)
        swapped = true
        return false
    }
    return ctx.world_settled()
}

# Whether an energy draws the trunk colour the capture is of: the green stage, 251 to 500 of 1000, for
# the first capture and the red one, over 750, for the second. The wait asks for the stage and not for
# the 495 or 995 that was set, because an unpowered engine loses one energy every tick and each of the
# six reads is a control round trip on a dedicated leg, so the number has fallen by the time a read
# answers. Each stage has hundreds of ticks of room, which the six reads cannot use up.
local _in_stage(energy: number) bool {
    if capture == 0 {
        return energy > 250 and energy <= 500
    }
    return energy > 750
}

# Whether the frame is ready for a capture: the same waits as coverage_render-Test.grug, for the
# light to settle, for the section to be meshed again from it, and for that mesh to be drawn. The port
# runs it before the engines' numbers are set, which says the scene they are drawn on is the settled
# one; the reference runs it after load_nbt too, where its swap is also the anchor for the edit. The
# port's anchor is _drawn.
local _ready(ctx: TestTickContext) bool {
    if not ctx.world_settled() {
        settled_ticks = 0
        return false
    }
    if settled_ticks < 5 {
        settled_ticks = settled_ticks + 1
        return false
    }
    if not remeshed {
        _force_remesh(ctx)
        remeshed = true
        return false
    }
    # The swap's blocks have to reach the client and the mesh they scheduled has to be drawn, which
    # is what the fixed tick hold used to stand in for. See coverage_render, #259 and #804.
    if not ctx.world_settled() {
        return false
    }
    # An engine is drawn with the light of its own cell, read from the client's world when the frame
    # is drawn, and a settled world says nothing of whether the client's copy of that light, sky as
    # well as block, is the server's yet: the b1.7.3-stationapi dedicated leg drew the engines at
    # full brightness in a scene whose golden is dim (#1695). So the capture waits on that light.
    if not ctx.light_applied(ex, ey, ez) {
        return false
    }
    if not ctx.light_applied(ex + 5, ey, ez) {
        return false
    }
    return true
}

# Dirties the wall's sections by swapping one of its blocks outside the crop and putting it back, so
# the capture's mesh is built from the settled light. See coverage_render-Test.grug.
local _force_remesh(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    origin: Vec3 = ctx.get_origin()
    x: number = origin.x()
    y: number = origin.y()
    z: number = origin.z()
    level.place_block(x - 6, y + 3, z + 10, "minecraft:dirt")
    level.place_block(x - 6, y + 3, z + 10, "minecraft:stone")
    ctx.assert(level.get_block(x - 6, y + 3, z + 10) == "minecraft:stone", "The remesh swap should have put the wall block back.")
}

# Places the engine as a player does, because the reference's BlockEngine.c, which faces a new
# engine up and looks for a receptor to face, is only called for a player's placement. The port does
# the same on its first tick, so placing its block is enough. The reference's engine is placed by
# right-clicking the side of a block at z + 1 with the engine held, which is the face the test
# player's eye sees of it, so the engine lands at z; that block is cleared again so both scenes
# hold the same blocks. The reference's placement ignores the face. See redstone_engine-Test.grug.
local _place_engine(ctx: TestTickContext, level: Level, x: number, y: number, z: number) {
    if not me.is_reference() {
        level.place_block(x, y, z, "grug:redstone_engine")
        return
    }
    level.place_block(x, y, z + 1, "minecraft:stone")
    player: Player = ctx.get_player()
    held: Item = item(resource_location("buildcraft:engineWood"))
    ctx.set_held_item(player, held)
    ctx.use_block(level, x, y, z + 1)
    ctx.clear_held_item(player)
    level.place_block(x, y, z + 1, "minecraft:air")
}
