# Covers the wooden pipe pass-through: a powered pipe moves one item from the chest on one side to
# the chest on the other.
# The block entities are member Options because they have to survive across ticks, and grug only
# allows variable declarations at member scope.
pipe_source: Option[BlockEntity] = Option.new()
pipe_target: Option[BlockEntity] = Option.new()
pipe_self: Option[BlockEntity] = Option.new()

export run() {
    if Test.tick() == 0 {
        _setup()
        Test.not_done()
    } else if not _pipe_has_moved() {
        Test.not_done()
    } else {
        _check()
    }
}

local _setup() {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 25
    z: number = origin.z()

    level.place_block(x - 1, y, z, "minecraft:chest")
    level.place_block(x, y, z, "grug:wooden_pipe")
    level.place_block(x + 1, y, z, "minecraft:chest")

    # A torch powers the block above it, but not the block it is attached to, and a standing torch
    # does not power the block above its own base, so this puts the torch under the engine.
    level.place_block(x, y - 3, z, "minecraft:stone")
    level.place_block(x, y - 2, z, "minecraft:redstone_torch")
    level.place_block(x, y - 1, z, "grug:redstone_engine")

    source_opt: Option[BlockEntity] = level.get_block_entity(x - 1, y, z)
    target_opt: Option[BlockEntity] = level.get_block_entity(x + 1, y, z)
    self_opt: Option[BlockEntity] = level.get_block_entity(x, y, z)
    Test.assert(source_opt.has(), "The source chest should have a block entity.")
    Test.assert(target_opt.has(), "The target chest should have a block entity.")
    Test.assert(self_opt.has(), "The pipe should have a block entity.")
    Test.assert(level.has_neighbor_signal(x, y - 1, z), "The engine should be powered by the torch.")

    pipe_source.set(source_opt.unwrap())
    pipe_target.set(target_opt.unwrap())
    pipe_self.set(self_opt.unwrap())

    diamond: Item = item(resource_location("minecraft:diamond"))
    set_item_in_slot(pipe_source.unwrap(), 0, diamond, 1)
}

local _check() {
    source_count: number = get_item_count_in_slot(pipe_source.unwrap(), 0)
    target_count: number = get_item_count_in_slot(pipe_target.unwrap(), 0)
    pipe_count: number = get_item_count_in_slot(pipe_self.unwrap(), 0)

    Test.assert(source_count + target_count + pipe_count == 1, "The diamond should exist exactly once.")
    Test.assert(source_count == 0, "The source chest should be empty.")
    Test.assert(target_count == 1, "The target chest should hold the diamond.")
    Test.assert(pipe_count == 0, "The pipe should not still be holding the diamond.")
}

# The pipe moving the item is what this test observes, and the game's own tick is the only clock that
# moves it: Test.tick() counts runner ticks, which are rendered frames, so a fixed count races the
# engine on a loaded machine. The item has left the source chest and the pipe's own one-slot buffer
# once the pipe has finished handling it, and where it went next is what _check asserts, so a wrong
# destination still fails with the assertion that names it. A pipe that never moves it runs into the
# runner's own tick budget instead of a count picked to be big enough on a fast machine. See #173.
local _pipe_has_moved() bool {
    source_empty: bool = get_item_count_in_slot(pipe_source.unwrap(), 0) == 0
    pipe_empty: bool = get_item_count_in_slot(pipe_self.unwrap(), 0) == 0
    return source_empty and pipe_empty
}
