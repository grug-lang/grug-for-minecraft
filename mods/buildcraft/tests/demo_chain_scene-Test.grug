# Covers the BuildCraft demo chain as the player sees it: a chest, an autocrafting table, a wooden pipe, a second
# table, a second pipe and a second chest in a row, each pipe on a wood engine below it, as the reference's
# own demonstration is built (see demo_chain-Test.grug, which checks what the chain does). The capture pins
# the whole scene's drawing at once: the chests, the tables' faces, the pipes' source and plain arms and the
# engines facing their pipes. The chain holds no item and no torch, so nothing moves and the frame is the same
# every time. The scene stands eight blocks from the camera so that all six blocks fit in the crop, left of
# the crosshair. The screenshot is the assertion.
pipe: Option[BlockEntity] = Option.new()

# Whether the wall and the pipe's section have been meshed again from the settled light yet.
remeshed: bool = false

# How many runner ticks in a row the world has answered settled. See the hold in tick().
settled_ticks: number = 0

export tick(ctx: TestTickContext) {
    if ctx.current_tick() == 0 {
        _setup(ctx)
        ctx.not_done()
    } else if not ctx.world_settled() {
        # The mesh below has to read the settled light, so the wait comes first. See coverage_render
        # and #257 for why one settled answer is not enough.
        settled_ticks = 0
        ctx.not_done()
    } else if settled_ticks < 5 {
        settled_ticks = settled_ticks + 1
        ctx.not_done()
    } else if not remeshed {
        _force_remesh(ctx)
        remeshed = true
        ctx.not_done()
    } else if not ctx.world_settled() {
        # Waiting for the swap's blocks to reach the client and for the mesh they scheduled.
        ctx.not_done()
    } else {
        ctx.assert(pipe.has(), "The pipe should have a block entity.")
        ctx.screenshot().equals(r"screenshots/demo_chain", 100, 230, 620, 430)
    }
}

local _setup(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()

    # The default room is small, so ask for one that holds the chain, its engines and the wall.
    ctx.set_box_radius(10)

    origin: Vec3 = ctx.get_origin()
    x: number = origin.x()
    y: number = origin.y()
    z: number = origin.z()

    _wall(level, x - 2, y - 9, z + 10)

    # The chain runs left from just left of the crosshair, so no block is under the crosshair.
    y = y - 1.88
    z = z + 8

    level.place_block(x + 1, y, z, "minecraft:chest")
    _place_table(level, x + 2, y, z)
    _place_table(level, x + 4, y, z)
    level.place_block(x + 6, y, z, "minecraft:chest")

    # The engines go in before the pipes. BlockEngine.onBlockAdded sets an engine's orientation to YPos and
    # then to the first powered neighbour after it, whatever side was clicked, so each engine faces up
    # at the pipe above it, as the sibling demo_chain-Test.grug's engines do.
    _place_engine(ctx, level, x + 3, y - 1, z)
    _place_engine(ctx, level, x + 5, y - 1, z)
    _place_pipe(ctx, level, x + 3, y, z)
    _place_pipe(ctx, level, x + 5, y, z)

    pipe_opt: Option[BlockEntity] = level.get_block_entity(x + 3, y, z)
    ctx.assert(pipe_opt.has(), "The first pipe should have a block entity.")
    pipe.set(pipe_opt.unwrap())
}

local _place_table(level: Level, x: number, y: number, z: number) {
    if not me.is_reference() {
        level.place_block(x, y, z, "grug:autocrafting_table")
        return
    }
    level.place_block(x, y, z, "buildcraft:autoWorkbenchBlock")
}

# The reference's pipe gets its kind from ItemPipe, so it is placed as a player places it, by
# right-clicking the side of a block at z + 1 with the pipe held, which is the face the test player's
# eye sees of it, so the pipe lands at z; that block is cleared again so both scenes hold the same
# blocks. ItemPipe names the item after its pipe class.
local _place_pipe(ctx: TestTickContext, level: Level, x: number, y: number, z: number) {
    if not me.is_reference() {
        level.place_block(x, y, z, "grug:wooden_pipe")
        return
    }
    level.place_block(x, y, z + 1, "minecraft:stone")
    player: Player = ctx.get_player()
    held: Item = item(resource_location("buildcraft:PipeItemsWood"))
    ctx.set_held_item(player, held)
    ctx.use_block(level, x, y, z + 1)
    ctx.clear_held_item(player)
    level.place_block(x, y, z + 1, "minecraft:air")
}

# Places the engine as a player does, as redstone_engine_facings-Test.grug does.
local _place_engine(ctx: TestTickContext, level: Level, x: number, y: number, z: number) {
    if not me.is_reference() {
        level.place_block(x, y, z, "grug:redstone_engine")
        return
    }
    level.place_block(x, y, z + 1, "minecraft:stone")
    player: Player = ctx.get_player()
    held: Item = item(resource_location("buildcraft:engineWood"))
    ctx.set_held_item(player, held)
    ctx.use_block(level, x, y, z + 1)
    ctx.clear_held_item(player)
    level.place_block(x, y, z + 1, "minecraft:air")
}

# Thirteen blocks square of minecraft:stone at (x0, y0, z), which covers the crop with room to
# spare. Kept small on purpose: every block placed re-lights the columns around it for several ticks
# afterwards.
local _wall(level: Level, x0: number, y0: number, z: number) {
    wy: number = y0
    while wy < y0 + 13 {
        wx: number = x0
        while wx < x0 + 13 {
            level.place_block(wx, wy, z, "minecraft:stone")
            wx = wx + 1
        }
        wy = wy + 1
    }
}

# Meshes the crop's section again from the settled light by changing a block state and putting it
# back. The swapped block is outside the crop, and dirt and stone are both opaque and unlit, so the
# swap changes no light and no compared pixel.
local _force_remesh(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    origin: Vec3 = ctx.get_origin()
    x: number = origin.x()
    y: number = origin.y()
    z: number = origin.z()
    level.place_block(x - 2, y + 3, z + 10, "minecraft:dirt")
    level.place_block(x - 2, y + 3, z + 10, "minecraft:stone")
    ctx.assert(level.get_block(x - 2, y + 3, z + 10) == "minecraft:stone", "The remesh swap should have put the wall block back.")
}
