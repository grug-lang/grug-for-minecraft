# Covers the cobblestone pipe's centre-and-arms shape: a straight run between two chests, where the
# arms leave two opposite sides. The arms are the reference's RenderPipe.renderWorldBlock boxes drawn
# from the block entity's chunk render, in the cobblestone texture (block texture 17). The pipe has no
# source side, so unlike the wooden pipe none of its arms is drawn in a plain texture. The screenshot
# is the assertion.
pipe: Option[BlockEntity] = Option.new()

# Whether the pedestal and the wall have been meshed again from the settled light yet.
remeshed: bool = false

# How many runner ticks in a row the world has answered settled. See the hold in tick().
settled_ticks: number = 0

# The origin _setup built from, which the later steps build from too. get_origin answers from the
# camera on every loader now, and keeps its first answer for the whole test, so asking again would
# return the same point. See #609.
origin_x: number = 0
origin_y: number = 0
origin_z: number = 0

export tick(ctx: TestTickContext) {
    if ctx.current_tick() == 0 {
        _setup(ctx)
        ctx.not_done()
    } else if not Test.world_settled() {
        # The mesh below has to read the settled light, so the wait comes first. See coverage_render
        # and #257 for why one settled answer is not enough.
        settled_ticks = 0
        ctx.not_done()
    } else if settled_ticks < 5 {
        settled_ticks = settled_ticks + 1
        ctx.not_done()
    } else if not remeshed {
        _force_remesh(ctx)
        remeshed = true
        ctx.not_done()
    } else if not Test.world_settled() {
        # Waiting for the swap's blocks to reach the client and for the mesh they scheduled. The
        # settle answer asks the client's own copy, so it is false until the chests are there and a
        # frame drawn after them has been made, which is the wait the fixed
        # tick hold used to stand in for. See coverage_render, #259 and #804.
        ctx.not_done()
    } else {
        ctx.assert(pipe.has(), "The pipe should have a block entity.")
        Test.screenshot().equals(r"screenshots/cobblestone_pipe_straight", 400, 120, 880, 360)
    }
}

local _setup(ctx: TestTickContext) {
    level: Level = Test.get_client_level()

    # The default room is small and this fixture sits at its far edge, so ask for a room that holds
    # the pipe, its two chests and the wall behind them.
    Test.set_box_radius(6)

    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y()
    z: number = origin.z()
    origin_x = x
    origin_y = y
    origin_z = z

    _wall(level, x - 6, y - 9, z + 6)

    _place_pipe(level, x, y - 1.88, z + 4)

    level.place_block(x + 1, y - 1.88, z + 4, "minecraft:chest")
    level.place_block(x - 1, y - 1.88, z + 4, "minecraft:chest")

    pipe_opt: Option[BlockEntity] = level.get_block_entity(x, y - 1.88, z + 4)
    ctx.assert(pipe_opt.has(), "The pipe should have a block entity.")
    pipe.set(pipe_opt.unwrap())
}

# The reference's pipe gets its kind from ItemPipe, so it is placed as a player places it, by
# right-clicking the top of a block under it with the pipe held, and that block is cleared again so
# both scenes hold the same blocks. ItemPipe names the item after its pipe class.
local _place_pipe(level: Level, x: number, y: number, z: number) {
    if not Test.is_reference() {
        level.place_block(x, y, z, "grug:cobblestone_pipe")
        return
    }
    level.place_block(x, y - 1, z, "minecraft:stone")
    player: Player = Test.get_player()
    held: Item = item(resource_location("buildcraft:PipeItemsCobblestone"))
    Test.set_held_item(player, held)
    Test.use_block(level, x, y - 1, z)
    Test.clear_held_item(player)
    level.place_block(x, y - 1, z, "minecraft:air")
}

# Thirteen blocks square of minecraft:stone at (x0, y0, z), which covers the crop with room to
# spare. Kept small on purpose: every block placed re-lights the columns around it for several ticks
# afterwards.
local _wall(level: Level, x0: number, y0: number, z: number) {
    wy: number = y0
    while wy < y0 + 13 {
        wx: number = x0
        while wx < x0 + 13 {
            level.place_block(wx, wy, z, "minecraft:stone")
            wx = wx + 1
        }
        wy = wy + 1
    }
}

# Meshes the crop's section again from the settled light by changing a block state and putting it
# back. The swapped block is outside the crop, and dirt and stone are both opaque and unlit, so the
# swap changes no light and no compared pixel; it dirties the wall's sections and their neighbours.
local _force_remesh(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    x: number = origin_x
    y: number = origin_y
    z: number = origin_z
    level.place_block(x - 6, y + 3, z + 6, "minecraft:dirt")
    level.place_block(x - 6, y + 3, z + 6, "minecraft:stone")
    ctx.assert(level.get_block(x - 6, y + 3, z + 6) == "minecraft:stone", "The remesh swap should have put the wall block back.")
}
