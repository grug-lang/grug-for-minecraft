# Covers the wooden pipe preserving an item's damage while moving it from one chest to another.
pipe_damage_source: Option[BlockEntity] = Option.new()
pipe_damage_target: Option[BlockEntity] = Option.new()
pipe_damage_self: Option[BlockEntity] = Option.new()

export tick_any_side(ctx: TestTickContext) {
    if ctx.current_tick() == 0 {
        _damage_setup(ctx)
        ctx.not_done()
    } else if not _damage_pipe_has_moved() or ctx.current_tick() < 20 {
        # Same floor as wooden_pipe-Test.grug, for the same reason (#262).
        ctx.not_done()
    } else {
        _damage_check(ctx)
    }
}

local _damage_setup(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    # The straight and corner pipe tests use bands at +25 and +35, so this one works in a clear
    # band. A high spawn can put +45 at y 128, outside Alpha's 128-block world height, so
    # _damage_band_y keeps it at 120 or below.
    y: number = _damage_band_y(origin)
    z: number = origin.z()

    level.place_block(x - 1, y, z, "minecraft:chest")
    level.place_block(x, y, z, "grug:wooden_pipe")
    level.place_block(x + 1, y, z, "minecraft:chest")

    # A torch powers the block above it, but not the block it is attached to, and a standing torch
    # does not power the block above its own base, so this puts the torch under the engine.
    level.place_block(x, y - 3, z, "minecraft:stone")
    level.place_block(x, y - 2, z, "minecraft:redstone_torch")
    level.place_block(x, y - 1, z, "grug:redstone_engine")

    source_opt: Option[BlockEntity] = level.get_block_entity(x - 1, y, z)
    target_opt: Option[BlockEntity] = level.get_block_entity(x + 1, y, z)
    self_opt: Option[BlockEntity] = level.get_block_entity(x, y, z)
    ctx.assert(source_opt.has(), "The source chest should have a block entity.")
    ctx.assert(target_opt.has(), "The target chest should have a block entity.")
    ctx.assert(self_opt.has(), "The pipe should have a block entity.")
    ctx.assert(level.has_neighbor_signal(x, y - 1, z), "The engine should be powered by the torch.")

    pipe_damage_source.set(source_opt.unwrap())
    pipe_damage_target.set(target_opt.unwrap())
    pipe_damage_self.set(self_opt.unwrap())

    # A sword so the damage is meaningful; the pipe must not repair it in transit.
    sword: Item = item(resource_location("minecraft:diamond_sword"))
    pipe_damage_source.unwrap().set_item_in_slot(0, sword, 1)
    pipe_damage_source.unwrap().set_item_damage_in_slot(0, 7)
}

local _damage_check(ctx: TestTickContext) {
    source_count: number = pipe_damage_source.unwrap().get_item_count_in_slot(0)
    target_count: number = pipe_damage_target.unwrap().get_item_count_in_slot(0)
    pipe_travelling: number = pipe_damage_self.unwrap().get_saved_list_size("traveling")
    target_damage: number = pipe_damage_target.unwrap().get_item_damage_in_slot(0)

    ctx.assert(source_count + target_count + pipe_travelling == 1, "The sword should exist exactly once.")
    ctx.assert(source_count == 0, "The source chest should be empty.")
    ctx.assert(target_count == 1, "The target chest should hold the sword.")
    ctx.assert(target_damage == 7, "The moved sword should keep its damage.")
}

# The band +45 above the origin, kept inside Alpha's 128-block world height. The dedicated server
# places the joining player at a random point within 10 blocks of the world spawn, at the terrain
# height there, so the origin's y changes between runs; a high spawn can put an unclamped band at
# y 128 or above, where level.place_block refuses it.
local _damage_band_y(origin: Vec3) number {
    y: number = origin.y() + 45
    if y > 120 {
        y = 120
    }
    return y
}

# Same wait as wooden_pipe-Test.grug: the pipe has finished handling the item once it has left the
# source chest and the pipe's travelling list, and the damage it arrived with is what _check
# asserts. See #173.
local _damage_pipe_has_moved() bool {
    source_empty: bool = pipe_damage_source.unwrap().get_item_count_in_slot(0) == 0
    pipe_empty: bool = pipe_damage_self.unwrap().get_saved_list_size("traveling") == 0
    return source_empty and pipe_empty
}
