# Covers the wooden pipe preserving an item's damage while moving it from one chest to another.
pipe_damage_source: Option[BlockEntity] = Option.new()
pipe_damage_target: Option[BlockEntity] = Option.new()
pipe_damage_self: Option[BlockEntity] = Option.new()

export run() {
    if me.tick() == 0 {
        _damage_setup()
        me.not_done()
    } else if not _damage_pipe_has_moved() or me.tick() < 20 {
        # Same floor as wooden_pipe-Test.grug, for the same reason (#262).
        me.not_done()
    } else {
        _damage_check()
    }
}

local _damage_setup() {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    # The straight and corner pipe tests use bands at +25 and +35, so this one works in a clear band.
    y: number = origin.y() + 45
    z: number = origin.z()

    pos: BlockPos = BlockPos.new(x - 1, y, z)
    level.place_block(pos, "minecraft:chest")
    pos2: BlockPos = BlockPos.new(x, y, z)
    level.place_block(pos2, "grug:wooden_pipe")
    pos3: BlockPos = BlockPos.new(x + 1, y, z)
    level.place_block(pos3, "minecraft:chest")

    # A torch powers the block above it, but not the block it is attached to, and a standing torch
    # does not power the block above its own base, so this puts the torch under the engine.
    level.place_block(BlockPos.new(x, y - 3, z), "minecraft:stone")
    level.place_block(BlockPos.new(x, y - 2, z), "minecraft:redstone_torch")
    pos4: BlockPos = BlockPos.new(x, y - 1, z)
    level.place_block(pos4, "grug:redstone_engine")

    source_opt: Option[BlockEntity] = level.get_block_entity(pos)
    target_opt: Option[BlockEntity] = level.get_block_entity(pos3)
    self_opt: Option[BlockEntity] = level.get_block_entity(pos2)
    Test.assert(source_opt.has(), "The source chest should have a block entity.")
    Test.assert(target_opt.has(), "The target chest should have a block entity.")
    Test.assert(self_opt.has(), "The pipe should have a block entity.")
    Test.assert(level.has_neighbor_signal(pos4), "The engine should be powered by the torch.")

    pipe_damage_source.set(source_opt.unwrap())
    pipe_damage_target.set(target_opt.unwrap())
    pipe_damage_self.set(self_opt.unwrap())

    # A sword so the damage is meaningful; the pipe must not repair it in transit.
    sword: Item = item(resource_location("minecraft:diamond_sword"))
    pipe_damage_source_be: BlockEntity = pipe_damage_source.unwrap()
    pipe_damage_source_be.set_item_in_slot(0, sword, 1)
    pipe_damage_source_be.set_item_damage_in_slot(0, 7)
}

local _damage_check() {
    pipe_damage_source_be: BlockEntity = pipe_damage_source.unwrap()
    source_count: number = pipe_damage_source_be.get_item_count_in_slot(0)
    pipe_damage_target_be: BlockEntity = pipe_damage_target.unwrap()
    target_count: number = pipe_damage_target_be.get_item_count_in_slot(0)
    pipe_damage_self_be: BlockEntity = pipe_damage_self.unwrap()
    pipe_count: number = pipe_damage_self_be.get_item_count_in_slot(0)
    target_damage: number = pipe_damage_target_be.get_item_damage_in_slot(0)

    Test.assert(source_count + target_count + pipe_count == 1, "The sword should exist exactly once.")
    Test.assert(source_count == 0, "The source chest should be empty.")
    Test.assert(target_count == 1, "The target chest should hold the sword.")
    Test.assert(target_damage == 7, "The moved sword should keep its damage.")
}

# Same wait as wooden_pipe-Test.grug: the pipe has finished handling the item once it has left the
# source chest and the pipe's own one-slot buffer, and the damage it arrived with is what _check
# asserts. See #173.
local _damage_pipe_has_moved() bool {
    pipe_damage_source_be: BlockEntity = pipe_damage_source.unwrap()
    source_empty: bool = pipe_damage_source_be.get_item_count_in_slot(0) == 0
    pipe_damage_self_be: BlockEntity = pipe_damage_self.unwrap()
    pipe_empty: bool = pipe_damage_self_be.get_item_count_in_slot(0) == 0
    return source_empty and pipe_empty
}
