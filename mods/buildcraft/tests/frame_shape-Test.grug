# Covers the frame block's shape (#1543), as BlockFrame.c computes it: a lone frame collides only in its
# quarter-block centre, and a frame with another frame beside it collides in an arm that reaches the
# shared face. The player-sized probes sit in the centre, in the west arm's place and in a corner.
export tick(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    origin: Vec3 = ctx.get_origin()
    x: number = Math.floor(origin.x())
    y: number = Math.floor(origin.y()) + 10
    z: number = Math.floor(origin.z()) + 60

    if ctx.current_tick() == 0 {
        level.place_block(x, y, z, "grug:frame")
        level.place_block(x + 4, y, z, "grug:frame")
        level.place_block(x + 5, y, z, "grug:frame")
        ctx.not_done()
        return
    }

    # The client has to hold the blocks before the game's own collision can be asked of them.
    if not ctx.world_settled() {
        ctx.not_done()
        return
    }

    ctx.assert(ctx.block_collision(level, x, y, z, 0.4, 0.4, 0.4, 0.6, 0.6, 0.6), "A lone frame should collide in its centre.")
    ctx.assert(not ctx.block_collision(level, x, y, z, 0.05, 0.4, 0.4, 0.15, 0.6, 0.6), "A lone frame should have no west arm.")
    ctx.assert(not ctx.block_collision(level, x, y, z, 0.0, 0.0, 0.0, 0.1, 0.1, 0.1), "A frame should be empty in its corner.")
    ctx.assert(ctx.block_collision(level, x + 4, y, z, 0.85, 0.4, 0.4, 0.95, 0.6, 0.6), "A frame with a frame to its east should collide in its east arm.")
    ctx.assert(not ctx.block_collision(level, x + 4, y, z, 0.05, 0.4, 0.4, 0.15, 0.6, 0.6), "A frame with a frame to its east only should have no west arm.")
    ctx.assert(ctx.block_collision(level, x + 5, y, z, 0.05, 0.4, 0.4, 0.15, 0.6, 0.6), "A frame with a frame to its west should collide in its west arm.")
}
