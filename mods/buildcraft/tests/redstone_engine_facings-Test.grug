# Covers how the redstone engine is drawn in each of its six facings, which RenderEngine does by
# turning its boxes about the block's centre by a quarter turn per orientation: nothing for YPos, z
# by PI for YNeg, z by -PI/2 and PI/2 for XPos and XNeg, and x by PI/2 and -PI/2 for ZPos and ZNeg.
# The six engines stand in a row along x, farther from the camera than redstone_engine-Test.grug's
# and above its eye line, with the facing numbers 0 to 5 running along it. The camera looks towards
# +z, so +x is on the left of the capture and facing 0 is at the right. One capture shows all of them.
# The capture stops high on the screen because the runner prints each test's name to the chat on
# every loader but 1.2.5, and that readout grows to ten lines of 27 pixels once a repeat has run, so
# anything below about y=250 holds text in a later repeat. Each engine is given its facing directly,
# rather than by a receptor next to it, which redstone_engine_facing-Test.grug covers. The reference
# run has no grug saved data, so it gives the real TileEngine its "orientation" through its NBT.
# How many runner ticks in a row the world has answered settled, and the waits before the capture, as
# coverage_render-Test.grug explains them. See _ready.
settled_ticks: number = 0
remeshed: bool = false
remesh_ticks: number = 0

# Where the row starts, and on the reference the world's time the engines were placed at and whether
# they have been turned yet. The real TileEngine only makes the engine its NBT is written from on its
# first tick, so the reference's engines are turned once the world has ticked past their placement.
ex: number = 0
ey: number = 0
ez: number = 0
placed_time: number = 0
faced: bool = false

export tick(ctx: TestTickContext) {
    if ctx.current_tick() == 0 {
        _setup(ctx)
        ctx.not_done()
        return
    }

    if Test.is_reference() and not faced {
        level: Level = Test.get_client_level()
        if level.get_time() > placed_time {
            _face_reference(ctx)
            faced = true
        }
        ctx.not_done()
        return
    }

    # redstone_engine-Test.grug, which runs just before this, leaves its torch lit to the end, and the
    # red particles that torch gave off live for up to 40 ticks after it is cleared away. One of them
    # in the crop is a few pixels that are never in the same place twice, so wait out the longest
    # life with some to spare. The world has no way to say how many particles are left.
    if ctx.current_tick() < 60 {
        ctx.not_done()
        return
    }

    if not _ready(ctx) {
        ctx.not_done()
        return
    }

    Test.screenshot().equals(r"screenshots/redstone_engine_facings", 400, 100, 880, 230)
}

local _setup(ctx: TestTickContext) {
    level: Level = Test.get_client_level()

    Test.set_box_radius(10)

    origin: Vec3 = Test.setup_graphics_camera()
    ex = origin.x() - 3
    ey = origin.y() + 0.12
    ez = origin.z() + 8

    _wall(level, origin.x() - 8, origin.y() - 9, origin.z() + 10)

    facing: number = 0
    while facing < 6 {
        _place_engine(level, ex + facing, ey, ez)
        engine_opt: Option[BlockEntity] = level.get_block_entity(ex + facing, ey, ez)
        ctx.assert(engine_opt.has(), "The redstone engine should have a block entity.")
        engine: BlockEntity = engine_opt.unwrap()
        if not Test.is_reference() {
            engine.set_saved_number("orientation", facing)
            engine.set_saved_number("oriented", 1)
            engine.redraw()
        }
        facing = facing + 1
    }
    placed_time = level.get_time()
}

# Gives each of the reference's engines the facing of its place in the row through its NBT.
local _face_reference(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    facing: number = 0
    while facing < 6 {
        engine_opt: Option[BlockEntity] = level.get_block_entity(ex + facing, ey, ez)
        ctx.assert(engine_opt.has(), "The redstone engine should have a block entity.")
        engine: BlockEntity = engine_opt.unwrap()
        Test.set_nbt_number(engine, "orientation", "int", facing)
        Test.load_nbt(engine)
        facing = facing + 1
    }
}

# Seventeen blocks square of stone two blocks behind the engines, as in coverage_render-Test.grug.
local _wall(level: Level, x0: number, y0: number, z: number) {
    wy: number = y0
    while wy < y0 + 17 {
        wx: number = x0
        while wx < x0 + 17 {
            level.place_block(wx, wy, z, "minecraft:stone")
            wx = wx + 1
        }
        wy = wy + 1
    }
}

# Whether the frame is ready for a capture: the same waits as coverage_render-Test.grug, for the
# light to settle, for the section to be meshed again from it, and for that mesh to be drawn.
local _ready(ctx: TestTickContext) bool {
    if not Test.world_settled() {
        settled_ticks = 0
        return false
    }
    if settled_ticks < 5 {
        settled_ticks = settled_ticks + 1
        return false
    }
    if not remeshed {
        _force_remesh(ctx)
        remeshed = true
        return false
    }
    if remesh_ticks < 5 {
        remesh_ticks = remesh_ticks + 1
        return false
    }
    return Test.world_settled()
}

# Dirties the wall's sections by swapping one of its blocks outside the crop and putting it back, so
# the capture's mesh is built from the settled light. See coverage_render-Test.grug.
local _force_remesh(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y()
    z: number = origin.z()
    level.place_block(x - 6, y + 3, z + 10, "minecraft:dirt")
    level.place_block(x - 6, y + 3, z + 10, "minecraft:stone")
    ctx.assert(level.get_block(x - 6, y + 3, z + 10) == "minecraft:stone", "The remesh swap should have put the wall block back.")
}

# Places the engine as a player does, because the reference's BlockEngine.c, which faces a new
# engine up and looks for a receptor to face, is only called for a player's placement. The port does
# the same on its first tick, so placing its block is enough. The reference's engine is placed by
# right-clicking the top of a block under it with the engine held, and that block is cleared again
# so both scenes hold the same blocks. See redstone_engine-Test.grug.
local _place_engine(level: Level, x: number, y: number, z: number) {
    if not Test.is_reference() {
        level.place_block(x, y, z, "grug:redstone_engine")
        return
    }
    level.place_block(x, y - 1, z, "minecraft:stone")
    player: Player = Test.get_player()
    held: Item = item(resource_location("buildcraft:engineWood"))
    Test.set_held_item(player, held)
    Test.use_block(level, x, y - 1, z)
    Test.clear_held_item(player)
    level.place_block(x, y - 1, z, "minecraft:air")
}
