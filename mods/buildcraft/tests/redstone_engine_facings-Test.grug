# Covers how the redstone engine is drawn in each of its six facings, which RenderEngine does by
# turning its boxes about the block's centre by a quarter turn per orientation: nothing for YPos, z
# by PI for YNeg, z by -PI/2 and PI/2 for XPos and XNeg, and x by PI/2 and -PI/2 for ZPos and ZNeg.
# The six engines stand in a row along x, farther from the camera than redstone_engine-Test.grug's
# and above its eye line, with the facing numbers 0 to 5 running along it. The camera looks towards
# +z, so +x is on the left of the capture and facing 0 is at the right. One capture shows all of them.
# The capture stops high on the screen because the runner prints each test's name to the chat on
# every loader but 1.2.5, and that readout grows to ten lines of 27 pixels once a repeat has run, so
# anything below about y=250 holds text in a later repeat. Each engine is given its facing directly,
# rather than by a receptor next to it, which redstone_engine_facing-Test.grug covers.
# How many runner ticks in a row the world has answered settled, and the waits before the capture, as
# coverage_render-Test.grug explains them. See _ready.
settled_ticks: number = 0
remeshed: bool = false
remesh_ticks: number = 0

export run() {
    if me.tick() == 0 {
        _setup()
        me.not_done()
        return
    }

    # redstone_engine-Test.grug, which runs just before this, leaves its torch lit to the end, and the
    # red particles that torch gave off live for up to 40 ticks after it is cleared away. One of them
    # in the crop is a few pixels that are never in the same place twice, so wait out the longest
    # life with some to spare. The world has no way to say how many particles are left.
    if me.tick() < 60 {
        me.not_done()
        return
    }

    if not _ready() {
        me.not_done()
        return
    }

    Test.screenshot().equals(r"screenshots/redstone_engine_facings", 400, 100, 880, 230)
}

local _setup() {
    level: Level = Test.get_client_level()

    Test.set_box_radius(10)

    origin: Vec3 = Test.setup_graphics_camera()
    ex: number = origin.x() - 3
    ey: number = origin.y() + 0.12
    ez: number = origin.z() + 8

    _wall(level, origin.x() - 8, origin.y() - 9, origin.z() + 10)

    facing: number = 0
    while facing < 6 {
        level.place_block(ex + facing, ey, ez, "grug:redstone_engine")
        engine_opt: Option[BlockEntity] = level.get_block_entity(ex + facing, ey, ez)
        Test.assert(engine_opt.has(), "The redstone engine should have a block entity.")
        engine: BlockEntity = engine_opt.unwrap()
        engine.set_saved_number("orientation", facing)
        engine.set_saved_number("oriented", 1)
        engine.redraw()
        facing = facing + 1
    }
}

# Seventeen blocks square of stone two blocks behind the engines, as in coverage_render-Test.grug.
local _wall(level: Level, x0: number, y0: number, z: number) {
    wy: number = y0
    while wy < y0 + 17 {
        wx: number = x0
        while wx < x0 + 17 {
            level.place_block(wx, wy, z, "minecraft:stone")
            wx = wx + 1
        }
        wy = wy + 1
    }
}

# Whether the frame is ready for a capture: the same waits as coverage_render-Test.grug, for the
# light to settle, for the section to be meshed again from it, and for that mesh to be drawn.
local _ready() bool {
    if not Test.world_settled() {
        settled_ticks = 0
        return false
    }
    if settled_ticks < 5 {
        settled_ticks = settled_ticks + 1
        return false
    }
    if not remeshed {
        _force_remesh()
        remeshed = true
        return false
    }
    if remesh_ticks < 5 {
        remesh_ticks = remesh_ticks + 1
        return false
    }
    return Test.world_settled()
}

# Dirties the wall's sections by swapping one of its blocks outside the crop and putting it back, so
# the capture's mesh is built from the settled light. See coverage_render-Test.grug.
local _force_remesh() {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y()
    z: number = origin.z()
    level.place_block(x - 6, y + 3, z + 10, "minecraft:dirt")
    level.place_block(x - 6, y + 3, z + 10, "minecraft:stone")
    Test.assert(level.get_block(x - 6, y + 3, z + 10) == "minecraft:stone", "The remesh swap should have put the wall block back.")
}
