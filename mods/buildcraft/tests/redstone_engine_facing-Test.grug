# Covers the facing a redstone engine picks, as TileEngine.switchOrientation does in BuildCraft
# 2.2.14. Orientations are numbered 0 YNeg, 1 YPos, 2 ZNeg, 3 ZPos, 4 XNeg and 5 XPos. The search
# starts after the engine's orientation of 1 and wraps round, so it visits 2, 3, 4, 5, 0, 1 and stops
# at the first side that has a power receptor next to it: a wooden pipe or another engine. Each case
# gets its own engine, 4 blocks apart in x so that the neighbours of one never touch another.
export run() {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 15
    z: number = origin.z()

    Test.assert(_facing(level, x, y, z) == 1, "An engine with no receptor next to it should face 1.")

    level.place_block(x + 4, y, z - 1, "grug:wooden_pipe")
    Test.assert(_facing(level, x + 4, y, z) == 2, "A pipe at z - 1 should make the engine face 2.")

    level.place_block(x + 8, y, z - 1, "grug:wooden_pipe")
    level.place_block(x + 9, y, z, "grug:wooden_pipe")
    Test.assert(_facing(level, x + 8, y, z) == 2, "Pipes at z - 1 and x + 1 should make the engine face 2, as 2 is visited before 5.")

    level.place_block(x + 12, y - 1, z, "grug:wooden_pipe")
    Test.assert(_facing(level, x + 12, y, z) == 0, "A pipe at y - 1 should make the engine face 0.")

    level.place_block(x + 16, y + 1, z, "grug:wooden_pipe")
    Test.assert(_facing(level, x + 16, y, z) == 1, "A pipe at y + 1 should make the engine face 1.")

    level.place_block(x + 20, y, z + 1, "grug:redstone_engine")
    Test.assert(_facing(level, x + 20, y, z) == 3, "An engine at z + 1 should make the engine face 3.")
}

# Places an engine, runs its first tick and returns the orientation it picked.
local _facing(level: Level, x: number, y: number, z: number) number {
    level.place_block(x, y, z, "grug:redstone_engine")
    engine_opt: Option[BlockEntity] = level.get_block_entity(x, y, z)
    Test.assert(engine_opt.has(), "The redstone engine should have a block entity.")
    engine: BlockEntity = engine_opt.unwrap()
    Test.tick_block_entity(engine, 1)
    return get_saved_number(engine, "orientation")
}
