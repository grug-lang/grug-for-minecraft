# Covers two wooden pipes placed next to each other: they do not hand items to one another, as in the
# reference's default config (PipeLogicWood.isPipeConnected refuses another wooden pipe while
# pipes.alwaysConnect is false). Each pipe has its own source chest and engine, and a different item,
# so an item that crossed from one pipe to the other would be found in the wrong pipe or chest. With
# no exit, each pipe drops its item at its centre. The fixture is built in 6 rows, four blocks
# apart, and advanced together, so one run repeats the trigger six times and a row that loses an
# item shows which row did.
export tick(ctx: TestTickContext) {
    if ctx.current_tick() == 0 {
        _setup(ctx)
        _advance(ctx)
        ctx.not_done()
    } else if ctx.current_tick() < 30 {
        ctx.not_done()
    } else {
        _check(ctx)
    }
}

local _advance(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    advanced: number = 0
    ran: number = 10
    # Both pipes pull on their first powered tick and then take 49 moves to the centre, so 400
    # ticks cover the whole journey and the drop twice over.
    while ran > 0 and advanced < 400 {
        ran = Test.tick_level(level, 10)
        advanced = advanced + ran
    }
}

local _setup(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    row: number = 0
    while row < 6 {
        _setup_row(ctx, level, origin.x(), origin.y() + 12, origin.z() + row * 4)
        row = row + 1
    }
}

local _setup_row(ctx: TestTickContext, level: Level, x: number, y: number, z: number) {
    level.place_block(x - 1, y, z, "minecraft:chest")
    level.place_block(x, y, z, "grug:wooden_pipe")
    level.place_block(x + 1, y, z, "grug:wooden_pipe")
    level.place_block(x + 2, y, z, "minecraft:chest")

    # A floor under the whole row and under the two columns beside the pipes that are open, so the
    # item a pipe drops stays where the count looks for it. A dropped item that overlaps the pipe's
    # box is pushed out of it sideways (ItemEntity.moveTowardsClosestSpace) and, with nothing under
    # the open column it lands in, falls out of the count's reach.
    level.place_block(x - 1, y - 1, z, "minecraft:stone")
    level.place_block(x, y - 1, z, "minecraft:stone")
    level.place_block(x + 1, y - 1, z, "minecraft:stone")
    level.place_block(x + 2, y - 1, z, "minecraft:stone")
    level.place_block(x, y - 1, z + 1, "minecraft:stone")
    level.place_block(x + 1, y - 1, z - 1, "minecraft:stone")

    level.place_block(x, y - 2, z - 1, "minecraft:stone")
    level.place_block(x, y - 1, z - 1, "minecraft:redstone_torch")
    level.place_block(x, y, z - 1, "grug:redstone_engine")
    level.place_block(x + 1, y - 2, z + 1, "minecraft:stone")
    level.place_block(x + 1, y - 1, z + 1, "minecraft:redstone_torch")
    level.place_block(x + 1, y, z + 1, "grug:redstone_engine")

    ctx.assert(level.has_neighbor_signal(x, y, z), "The west pipe's engine should be powered.")
    ctx.assert(level.has_neighbor_signal(x + 1, y, z), "The east pipe's engine should be powered.")

    _entity(ctx, level, x - 1, y, z).set_item_in_slot(0, item(resource_location("minecraft:diamond")), 1)
    _entity(ctx, level, x + 2, y, z).set_item_in_slot(0, item(resource_location("minecraft:iron_ingot")), 1)
}

local _entity(ctx: TestTickContext, level: Level, x: number, y: number, z: number) BlockEntity {
    block_entity: Option[BlockEntity] = level.get_block_entity(x, y, z)
    ctx.assert(block_entity.has(), "The fixture should have a block entity.")
    return block_entity.unwrap()
}

local _check(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 12
    bad: number = 0
    row: number = 0
    while row < 6 {
        z: number = origin.z() + row * 4
        west: BlockEntity = _entity(ctx, level, x, y, z)
        east: BlockEntity = _entity(ctx, level, x + 1, y, z)
        print3("DIAG row, items near it", row, level.count_item_entities(x + 1, y, z + 0.5, 2))
        print3("DIAG row chests", _entity(ctx, level, x - 1, y, z).get_item_count_in_slot(0), _entity(ctx, level, x + 2, y, z).get_item_count_in_slot(0))
        print3("DIAG row traveling", west.get_saved_list_size("traveling"), east.get_saved_list_size("traveling"))
        print3("DIAG row engine energy", _entity(ctx, level, x, y, z - 1).get_saved_number("energy"), _entity(ctx, level, x + 1, y, z + 1).get_saved_number("energy"))
        if not (_only(west, item(resource_location("minecraft:diamond")))) {
            bad = bad + 1
        }
        if not (_only(east, item(resource_location("minecraft:iron_ingot")))) {
            bad = bad + 1
        }
        if not (_entity(ctx, level, x - 1, y, z).get_item_count_in_slot(0) == 0) {
            bad = bad + 1
        }
        if not (_entity(ctx, level, x + 2, y, z).get_item_count_in_slot(0) == 0) {
            bad = bad + 1
        }
        if not (level.count_item_entities(x + 1, y, z + 0.5, 2) >= 2) {
            bad = bad + 1
        }
        row = row + 1
    }
    ctx.assert(bad == 0, "Every row's pipes should have dropped their own items and emptied their chests.")
}

local _only(pipe: BlockEntity, wanted: Item) bool {
    index: number = 0
    records: number = pipe.get_saved_list_size("traveling")
    while index < records {
        held: Option[Item] = pipe.get_saved_list_item("traveling", index)
        if held.has() and not equals(held.unwrap(), wanted) {
            return false
        }
        index = index + 1
    }
    return true
}
