# Covers two wooden pipes placed next to each other: they do not hand items to one another, as in the
# reference's default config (PipeLogicWood.isPipeConnected refuses another wooden pipe while
# pipes.alwaysConnect is false). Each pipe has its own source chest and a different item, so an item
# that crossed from one pipe to the other would be found in the wrong pipe or chest. With no exit,
# each pipe drops its item at its own centre. The fixture is built in 6 rows, four blocks apart, so
# one run repeats the trigger six times (#1019). The rows run from 8 blocks behind the origin to 12
# in front of it, so every pipe and chest lies inside the 16 blocks around the player that the runner
# clears before a test: rows 20 blocks out kept the block entities and items of earlier passes and
# tests (#1057).

# The pipe's tick is run by hand, as wooden_pipe_energy and wooden_pipe_drop_stack do, rather than
# letting the level's clock run it, so the dropped item is still exactly where the pipe put it when
# the check reads it. A level-ticked drop lands wherever the loader's item physics carries it, which
# on 1.20.6 is 2 to 3 blocks away and can be further: the item overlaps the pipe's collision box, and
# the game throws it out sideways (ItemEntity.moveTowardsClosestSpace) with a random velocity. A
# check that counted item entities within a fixed radius therefore waited for a condition that a run
# could miss for good (#1060, #1079), and no radius is both wide enough for that throw and narrow
# enough to keep rows four blocks apart out of one another's count. Reading each drop at the tick it
# happens has neither problem, and it is what proves the item came out of the pipe's own centre with
# the damage of its own chest's item.

# The energy is receive_energy, the call the engine makes to hand a stroke over, so the engine's
# stroke, which is a duration, is not part of this test: redstone_engine-Test and wooden_pipe-Test
# cover it.
export tick(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    row: number = 0
    while row < 6 {
        _row(ctx, level, origin.x(), origin.y() + 12, origin.z() + (row - 2) * 4)
        row = row + 1
    }
}

local _row(ctx: TestTickContext, level: Level, x: number, y: number, z: number) {
    level.place_block(x - 1, y, z, "minecraft:chest")
    level.place_block(x, y, z, "grug:wooden_pipe")
    level.place_block(x + 1, y, z, "grug:wooden_pipe")
    level.place_block(x + 2, y, z, "minecraft:chest")

    # A floor under the row, so a dropped item has ground under it as it has in the reference.
    level.place_block(x - 1, y - 1, z, "minecraft:stone")
    level.place_block(x, y - 1, z, "minecraft:stone")
    level.place_block(x + 1, y - 1, z, "minecraft:stone")
    level.place_block(x + 2, y - 1, z, "minecraft:stone")

    west: BlockEntity = _entity(ctx, level, x, y, z)
    east: BlockEntity = _entity(ctx, level, x + 1, y, z)
    west_chest: BlockEntity = _entity(ctx, level, x - 1, y, z)
    east_chest: BlockEntity = _entity(ctx, level, x + 2, y, z)

    # The row must start from nothing: a pipe outside the area the runner clears keeps its energy and
    # its records from an earlier pass (#1057).
    _fresh(ctx, west)
    _fresh(ctx, east)

    # The damage tells the two items apart, so the drop can be checked to hold the pipe's own item
    # and not the one from the pipe beside it. Both are swords, because 1.20.6 clamps a stack's
    # damage to the item's maximum, which is 0 for a diamond or an ingot, and the record would then
    # carry 0 and not the damage the chest was given.
    west_chest.set_item_in_slot(0, item(resource_location("minecraft:diamond_sword")), 1)
    west_chest.set_item_damage_in_slot(0, 1)
    east_chest.set_item_in_slot(0, item(resource_location("minecraft:iron_sword")), 1)
    east_chest.set_item_damage_in_slot(0, 2)

    _pull_and_drop(ctx, level, west, west_chest, item(resource_location("minecraft:diamond_sword")), 1)
    _pull_and_drop(ctx, level, east, east_chest, item(resource_location("minecraft:iron_sword")), 2)
}

# Pulls the chest's item into the pipe, checks the pipe carries that item and no other, then runs the
# journey to the centre and the drop there. The pipe spends the energy it was given on the pull, so
# the 60 ticks after it move the one record and then find nothing left to pull.
local _pull_and_drop(ctx: TestTickContext, level: Level, pipe: BlockEntity, chest: BlockEntity, wanted: Item, damage: number) {
    pipe.receive_energy(64)
    Test.tick_block_entity(pipe, 1)
    ctx.assert(pipe.get_saved_list_size("traveling") == 1, "The pipe should have pulled its chest's item.")

    held: Option[Item] = pipe.get_saved_list_item("traveling", 0)
    ctx.assert(held.has(), "The travelling record should hold an item.")
    ctx.assert(equals(held.unwrap(), wanted), "The pipe should carry the item from its own chest.")
    ctx.assert(pipe.get_saved_list_number("traveling", 0, "damage") == damage, "The pipe should carry its own chest's item, damage and all.")

    # 49 moves reach the pipe's centre, where the other wooden pipe and every empty side accept
    # nothing, so the item is dropped at the centre on the next move.
    Test.tick_block_entity(pipe, 60)
    ctx.assert(pipe.get_saved_list_size("traveling") == 0, "The pipe should have dropped its travelling item.")
    ctx.assert(chest.get_item_count_in_slot(0) == 0, "The pipe's own chest should be empty.")

    # The item entity is counted at the centre the drop put it at, before any tick can move it, so a
    # radius half a block wide finds exactly the pipe's own drop and not the one a block beside it.
    center: Vec3 = pipe.block_pos().center()
    dropped: number = level.count_item_entities(center.x(), center.y() - 0.25, center.z(), 0.5)
    ctx.assert(dropped == 1, "The pipe should have dropped one item entity at its own centre, not handed its item to the pipe beside it.")
    found: Option[ItemEntity] = level.find_item_entity(center.x(), center.y() - 0.25, center.z(), 0.5)
    ctx.assert(found.has(), "The dropped item should lie at the pipe's centre.")
    ctx.assert(found.unwrap().damage() == damage, "The dropped item should be the pipe's own item.")
}

local _fresh(ctx: TestTickContext, pipe: BlockEntity) {
    empty: bool = pipe.get_energy_stored() == 0 and pipe.get_item_count_in_slot(0) == 0 and pipe.get_saved_list_size("traveling") == 0
    ctx.assert(empty, "A pipe should start with no energy and no items, so the row has to lie inside the area the runner clears (16 blocks around the player).")
}

local _entity(ctx: TestTickContext, level: Level, x: number, y: number, z: number) BlockEntity {
    block_entity: Option[BlockEntity] = level.get_block_entity(x, y, z)
    ctx.assert(block_entity.has(), "The fixture should have a block entity.")
    return block_entity.unwrap()
}
