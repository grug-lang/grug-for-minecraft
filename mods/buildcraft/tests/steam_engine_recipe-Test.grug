# The steam engine's recipe has to craft one engine from three cobblestone, glass, two stone gears and
# a piston, as BuildCraftEnergy registers it ("www", " g ", "GpG" with w cobblestone, g glass, G stone
# gear and p piston). It is asked of a crafting grid, as golden_pipe_recipe does, and the loaders that
# register no mod recipes skip it.
# Band 12, clear of the bands the other recipe tests use: they never run together.
export tick(ctx: TestTickContext) {
    # A loader that registers no mod recipe answers the grid with nothing, so the loader is asked
    # rather than assumed.
    if not me.registers_mod_recipes() {
        return
    }

    level: Level = ctx.get_client_level()
    origin: Vec3 = ctx.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 12
    z: number = origin.z()

    cobblestone: Item = item(resource_location("minecraft:cobblestone"))
    glass: Item = item(resource_location("minecraft:glass"))
    stone_gear: Item = item(resource_location("grug:stone_gear"))
    piston: Item = item(resource_location("minecraft:piston"))
    engine: Item = item(resource_location("grug:steam_engine"))

    grid: BlockEntity = _grid(ctx, level, x, y, z)
    grid.set_item_in_slot(0, cobblestone, 1)
    grid.set_item_in_slot(1, cobblestone, 1)
    grid.set_item_in_slot(2, cobblestone, 1)
    grid.set_item_in_slot(4, glass, 1)
    grid.set_item_in_slot(6, stone_gear, 1)
    grid.set_item_in_slot(7, piston, 1)
    grid.set_item_in_slot(8, stone_gear, 1)
    grid.update_recipe_output(0)

    result: Option[Item] = grid.get_crafting_result_item()
    ctx.assert(result.has(), "Cobblestone, glass, stone gears, a piston and cobblestone should craft a steam engine.")
    ctx.assert(equals(result.unwrap(), engine), "The steam engine's recipe should answer a steam engine.")
    ctx.assert(grid.take_crafting_result(1) == 1, "The steam engine's recipe should give one engine.")
}

# The coverage block's block entity has the nine slots a crafting grid reads, which is why this is the
# block to place rather than a chest or the autocrafting table.
local _grid(ctx: TestTickContext, level: Level, x: number, y: number, z: number) BlockEntity {
    level.place_block(x, y, z, "grug:coverage_block")
    found: Option[BlockEntity] = level.get_block_entity(x, y, z)
    ctx.assert(found.has(), "The coverage block should have a block entity after being placed.")
    return found.unwrap()
}
