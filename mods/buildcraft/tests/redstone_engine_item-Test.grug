# Covers the redstone engine's item form, which BuildCraft 2.2.14 draws with the blue trunk whatever
# energy an engine had: RenderEngine.inventoryRender always draws EnergyStage.Blue. The engine is put
# in the middle slot of an autocrafting table's grid and the table's GUI opened, which is the
# smallest way to get an item drawn in a slot on every loader.
# It runs after redstone_engine-Test.grug, which closes any screen an earlier test left open, and it
# closes the GUI it opens for the same reason. See #195.

export tick(ctx: TestTickContext) {
    if ctx.current_tick() == 0 {
        _setup(ctx)
        ctx.not_done()
    } else if not Test.screen_open() {
        # On 1.20.6 the screen is opened by a packet from the server, so it is not open yet when
        # use_block returns, and a settled world does not say the packet has arrived: the world
        # can answer settled from its first tick, which is how the capture was once taken of the
        # world instead of the panel. See #418.
        ctx.not_done()
    } else if not Test.world_settled() {
        # The same wait as autocrafting_table-Test.grug: the panel is only on screen once a frame
        # holding it has been drawn.
        ctx.not_done()
    } else {
        # The item in the middle slot of the crafting grid, at the panel's 1280x720 scale of 3: the
        # slot's item is drawn at (48, 35) in the panel, whose top left is at (376, 111). See
        # autocrafting_table-Test.grug for how the panel's position was found.
        Test.screenshot().equals(r"screenshots/redstone_engine_item", 520, 216, 568, 264)
        Test.close_screen()
    }
}

local _setup(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y()
    z: number = origin.z()

    # The reference's table names itself autoWorkbenchBlock, and ItemEngine names its metadata 0
    # tile.engineWood. Its grid is the same nine slots, so the middle one is 4 there too.
    if Test.is_reference() {
        level.place_block(x, y, z, "buildcraft:autoWorkbenchBlock")
    } else {
        level.place_block(x, y, z, "grug:autocrafting_table")
    }
    table_opt: Option[BlockEntity] = level.get_block_entity(x, y, z)
    ctx.assert(table_opt.has(), "The autocrafting table should have a block entity.")
    table: BlockEntity = table_opt.unwrap()

    if Test.is_reference() {
        reference_item: Item = item(resource_location("buildcraft:engineWood"))
        table.set_item_in_slot(4, reference_item, 1)
    } else {
        port_item: Item = item(resource_location("grug:redstone_engine"))
        table.set_item_in_slot(4, port_item, 1)
    }

    Test.use_block(level, x, y, z)
}
