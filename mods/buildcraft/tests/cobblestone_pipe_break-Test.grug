# Covers a broken cobblestone pipe dropping the travelling items it holds, as PipeTransportItems'
# dropContents does through Utils.dropItems: one item entity per travelling record, holding that
# record's whole stack, at a random point inside the block, with the EntityItem constructor's hop of
# -0.1 to 0.1 on x and z and 0.2 up, and the damage kept. The records are written straight into the
# two pipes because the drop is what is under test, not the pull that would put them there; each pipe
# is then replaced with air, which is what fires the block's on_break. The second pipe carries a
# stack of more than one, which is the record whose whole stack has to reach one entity.
# The drop is measured from the block's own corner and not from the record: dropContents passes this
# pipe's xCoord, yCoord and zCoord to Utils.dropItems, which draws each axis 0.15 to 0.85 into the
# block from there, whatever the record's position was. So the first record is written three blocks
# east of the pipe that holds it, which no travelling item ever is, because a record inside its pipe
# cannot tell a drop from the block apart from one at the record: on 1.20.6 an item's quarter-block
# box reaches most of the block from wherever it lands. A draw landing exactly on the block's centre
# is a legal outcome of that random, so what is pinned here is where the drop is measured from, not
# where one draw put it.
break_damage: number = 7
break_stack_count: number = 5

export tick_any_side(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    # Band 24, clear of the bands the other pipe tests use.
    y: number = origin.y() + 24
    z: number = origin.z()

    level.place_block(x, y, z, "grug:cobblestone_pipe")
    level.place_block(x + 4, y, z, "grug:cobblestone_pipe")

    pipe: BlockEntity = _entity(ctx, level, x, y, z)
    stack_pipe: BlockEntity = _entity(ctx, level, x + 4, y, z)

    _hold(pipe, Vec3.new(x + 3, y + 0.25, z), item(resource_location("minecraft:diamond_sword")), break_damage, 1)
    stack_center: Vec3 = stack_pipe.block_pos().center()
    _hold(stack_pipe, Vec3.new(stack_center.x(), stack_center.y() - 0.25, stack_center.z()), item(resource_location("minecraft:diamond")), 0, break_stack_count)

    # Placing air is how a test breaks a block; every loader calls the old block's removal there.
    level.place_block(x, y, z, "minecraft:air")
    level.place_block(x + 4, y, z, "minecraft:air")
    ctx.assert(level.is_air(x, y, z), "The pipe should be gone.")
    ctx.assert(level.is_air(x + 4, y, z), "The second pipe should be gone.")

    # A radius that holds one pipe's block and not the other's, which is four blocks away.
    dropped: number = level.count_item_entities(x, y, z, 2)
    ctx.assert(dropped == 1, "The broken pipe should have dropped its one travelling item.")
    stack_dropped: number = level.count_item_entities(x + 4, y, z, 2)
    ctx.assert(stack_dropped == 1, "The broken pipe should have dropped its whole stack as one item entity.")

    # The first record was three blocks east, so a drop measured from the record rather than from the
    # block would leave nothing at the pipe and one item where the record was.
    at_record: number = level.count_item_entities(x + 3, y + 0.25, z, 0.3)
    ctx.assert(at_record == 0, "The broken pipe should not drop its item where the record was.")

    found_opt: Option[ItemEntity] = level.find_item_entity(x, y, z, 2)
    ctx.assert(found_opt.has(), "The dropped item should be on the ground.")
    found: ItemEntity = found_opt.unwrap()
    ctx.assert(found.damage() == break_damage, "The dropped item should keep its damage.")
    ctx.assert(found.count() == 1, "The dropped item should hold the record's one item.")

    stack_found_opt: Option[ItemEntity] = level.find_item_entity(x + 4, y, z, 2)
    ctx.assert(stack_found_opt.has(), "The dropped stack should be on the ground.")
    stack_found: ItemEntity = stack_found_opt.unwrap()
    ctx.assert(stack_found.count() == break_stack_count, "The dropped item entity should hold the whole stack.")

    # Utils.dropItems makes a broken pipe's drop wait 10 ticks, and no entity has ticked since.
    ctx.assert(found.pickup_delay() == 10, "A broken pipe's item should wait 10 ticks before it can be picked up.")
    ctx.assert(stack_found.pickup_delay() == 10, "A broken pipe's stack should wait 10 ticks before it can be picked up.")

    # Utils.dropItems keeps the EntityItem constructor's hop. Every version draws x and z uniformly
    # within 0.1, and the older four store the draw as a float, so the bound allows the float32
    # expansion of 0.1 rather than emulating the rounding. Every version fixes y at 0.2, but those
    # four write 0.2F, whose double expansion is 0.20000000298023224, where 1.20.6 writes the double
    # 0.2, so the y check allows 1e-6 around the reference's 0.2 and still fails a zeroed motion.
    motion: Vec3 = stack_found.entity().get_delta_movement()
    ctx.assert(motion.x() > -0.100001 and motion.x() < 0.100001, "The hop's x should stay within the constructor's random 0.1.")
    ctx.assert(motion.z() > -0.100001 and motion.z() < 0.100001, "The hop's z should stay within the constructor's random 0.1.")
    ctx.assert(motion.y() > 0.199999 and motion.y() < 0.200001, "The hop's y should be the constructor's 0.2, within a float's expansion.")
}

# One travelling record at the given position, carrying the item, its damage and its count.
local _hold(pipe: BlockEntity, where: Vec3, held: Item, damage: number, count: number) {
    index: number = pipe.append_saved_list_record("traveling")
    pipe.set_saved_list_number("traveling", index, "x", where.x())
    pipe.set_saved_list_number("traveling", index, "y", where.y())
    pipe.set_saved_list_number("traveling", index, "z", where.z())
    pipe.set_saved_list_number("traveling", index, "speed", 0.01)
    pipe.set_saved_list_number("traveling", index, "direction", 5)
    pipe.set_saved_list_number("traveling", index, "steps", 0)
    pipe.set_saved_list_number("traveling", index, "to_center", 0)
    pipe.set_saved_list_number("traveling", index, "count", count)
    pipe.set_saved_list_number("traveling", index, "damage", damage)
    pipe.set_saved_list_item("traveling", index, held)
}

local _entity(ctx: TestTickContext, level: Level, x: number, y: number, z: number) BlockEntity {
    block_entity: Option[BlockEntity] = level.get_block_entity(x, y, z)
    ctx.assert(block_entity.has(), "The fixture should have a block entity.")
    return block_entity.unwrap()
}
