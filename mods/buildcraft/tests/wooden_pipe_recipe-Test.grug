# The wooden pipe's recipe has to craft eight pipes from planks, glass and planks, since a pipe has
# no other source in survival. The port's own recipe file is asked of a crafting grid here rather
# than of the recipe tree, which the coverage tests already cover.
# The redstone engine's recipe is not asserted: it needs a piston, which Alpha 1.1.2_01 predates, and
# grug has no host function that asks whether this loader has an item, so one shared test cannot fill
# that slot only where it exists. The recipe file is dropped on Alpha by the recipe-skip rule (#614).
# Band 7 is free: the tests' fixtures sit at 0, 2, 5, 6, 10, 12, 15, 20, 25, 30, 35, 40, 45 and 50.
export tick(ctx: TestTickContext) {
    # A loader that registers no mod recipe answers the grid with nothing, so the loader is asked
    # rather than assumed.
    if not Test.registers_mod_recipes() {
        return
    }

    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 7
    z: number = origin.z()

    planks: Item = item(resource_location("minecraft:oak_planks"))
    glass: Item = item(resource_location("minecraft:glass"))
    pipe: Item = item(resource_location("grug:wooden_pipe"))

    grid: BlockEntity = _grid(ctx, level, x, y, z)
    # The recipe's only occupied row is the grid's middle one, which is slots 3, 4 and 5.
    grid.set_item_in_slot(3, planks, 1)
    grid.set_item_in_slot(4, glass, 1)
    grid.set_item_in_slot(5, planks, 1)
    grid.update_recipe_output(0)

    result: Option[Item] = grid.get_crafting_result_item()
    ctx.assert(result.has(), "Planks, glass and planks should craft a wooden pipe.")
    ctx.assert(equals(result.unwrap(), pipe), "The wooden pipe's recipe should answer a wooden pipe.")
    ctx.assert(grid.take_crafting_result(8) == 8, "The wooden pipe's recipe should give eight pipes.")
}

# The coverage block's block entity has the nine slots a crafting grid reads, which is why this is
# the block to place rather than a chest or the autocrafting table.
local _grid(ctx: TestTickContext, level: Level, x: number, y: number, z: number) BlockEntity {
    level.place_block(x, y, z, "grug:coverage_block")
    found: Option[BlockEntity] = level.get_block_entity(x, y, z)
    ctx.assert(found.has(), "The coverage block should have a block entity after being placed.")
    return found.unwrap()
}
