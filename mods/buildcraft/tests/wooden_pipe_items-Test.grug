# Covers the pipe drawing its travelling items: a block as a small cube and an item as a flat
# sprite turned towards the player, both at rest in the middle of the pipe. The screenshot is the
# assertion, and the same crop as the coverage frame test's, because the fixture sits where that one
# does.
# The two records are put there directly and given no speed, so they stand still while the world
# settles. A record that moved would be at a different place on every run, and a capture taken after
# an unknown number of settle ticks would not be the same picture twice. The negative step count
# keeps the transport's snap-to-centre and hand-over thresholds out of reach for the whole run.
pipe: Option[BlockEntity] = Option.new()

# Whether the pipe's chunk geometry and the wall have been meshed again from the settled light yet.
remeshed: bool = false

# How many runner ticks have passed since the swap. See the wait in run().
remesh_ticks: number = 0

# How many runner ticks in a row the world has answered settled. See the hold in run().
settled_ticks: number = 0

export run() {
    if me.tick() == 0 {
        _setup()
        me.not_done()
    } else if not Test.world_settled() {
        settled_ticks = 0
        me.not_done()
    } else if settled_ticks < 5 {
        settled_ticks = settled_ticks + 1
        me.not_done()
    } else if not remeshed {
        _force_remesh()
        remeshed = true
        me.not_done()
    } else if remesh_ticks < 5 {
        remesh_ticks = remesh_ticks + 1
        me.not_done()
    } else if not Test.world_settled() {
        me.not_done()
    } else {
        _check()
    }
}

local _setup() {
    level: Level = Test.get_client_level()

    # The default room is small and this fixture sits at its far edge, so ask for a room that holds
    # the pipe, the wall two blocks behind it and both ends of that wall.
    Test.set_box_radius(6)

    origin: Vec3 = Test.setup_graphics_camera()
    x: number = origin.x()
    y: number = origin.y()
    z: number = origin.z()

    # The same place coverage_frame's block sits: four blocks in front of the camera, which looks
    # towards +z, so the pipe's centre is in the crop below.
    level.place_block(x, y - 1.88, z + 4, "grug:wooden_pipe")
    _wall(level, x - 6, y - 9, z + 6)

    be_opt: Option[BlockEntity] = level.get_block_entity(x, y - 1.88, z + 4)
    Test.assert(be_opt.has(), "The pipe should have a block entity.")
    pipe.set(be_opt.unwrap())

    # One of each kind, side by side in the middle of the pipe so a capture shows the cube and the
    # sprite together. `minecraft:oak_log` is a block, which the reference draws as a cube, and
    # `minecraft:stick` is an item, which it draws as a flat sprite.
    _hold(pipe.unwrap(), item(resource_location("minecraft:oak_log")), -0.2)
    _hold(pipe.unwrap(), item(resource_location("minecraft:stick")), 0.2)
}

# Adds one travelling record that stands still at the pipe floor, offset dx along x from the pipe's
# centre. The record's positions are world coordinates and its y is the pipe floor, which is a
# quarter of a block above the block's bottom and half a block below the block's centre.
local _hold(pipe_entity: BlockEntity, held: Item, dx: number) {
    center: Vec3 = pipe_entity.block_pos().center()
    index: number = pipe_entity.append_saved_list_record("traveling")
    pipe_entity.set_saved_list_number("traveling", index, "x", center.x() + dx)
    pipe_entity.set_saved_list_number("traveling", index, "y", center.y() - 0.25)
    pipe_entity.set_saved_list_number("traveling", index, "z", center.z())
    pipe_entity.set_saved_list_number("traveling", index, "speed", 0.0)
    pipe_entity.set_saved_list_number("traveling", index, "direction", 3)
    pipe_entity.set_saved_list_number("traveling", index, "steps", -1000000)
    pipe_entity.set_saved_list_number("traveling", index, "to_center", 1)
    pipe_entity.set_saved_list_number("traveling", index, "count", 1)
    pipe_entity.set_saved_list_number("traveling", index, "damage", 0)
    pipe_entity.set_saved_list_item("traveling", index, held)
}

# Thirteen blocks square of minecraft:stone at (x0, y0, z), which covers the crop with room to
# spare.
local _wall(level: Level, x0: number, y0: number, z: number) {
    wy: number = y0
    while wy < y0 + 13 {
        wx: number = x0
        while wx < x0 + 13 {
            level.place_block(wx, wy, z, "minecraft:stone")
            wx = wx + 1
        }
        wy = wy + 1
    }
}

local _check() {
    # The pipe is what the hook drew through, so a missing one would make the screenshot a picture of
    # nothing that happens to match an empty reference.
    Test.assert(pipe.has(), "The pipe lost its block entity.")
    Test.assert(pipe.unwrap().get_saved_list_size("traveling") == 2, "The pipe should still hold both travelling items.")

    # The cube and the sprite seen through the pipe's cage. Pixel-exact: the items' own pixels are
    # the same set on every loader, and the stone background differs per version because each shades
    # a face from its own light table, so the reference directory holds one PNG per loader.
    Test.screenshot().equals(r"screenshots/wooden_pipe_items", 500, 180, 780, 340)
}

# Meshes the crop's section again from the settled light by changing a block state and putting it
# back, as coverage_frame does.
local _force_remesh() {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y()
    z: number = origin.z()
    level.place_block(x - 6, y + 3, z + 6, "minecraft:dirt")
    level.place_block(x - 6, y + 3, z + 6, "minecraft:stone")
    Test.assert(level.get_block(x - 6, y + 3, z + 6) == "minecraft:stone", "The remesh swap should have put the wall block back.")
}
