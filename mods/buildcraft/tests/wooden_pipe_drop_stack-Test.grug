# Covers the wooden pipe dropping a stack that no inventory accepts as one item entity holding the
# whole stack, as EntityPassiveItem.toEntityItem makes it: PipeTransportItems.endReached hands
# data.item.item, the stack the travelling item carries, to one EntityItem. The pipe has a chest to
# pull from and no other inventory, so the exit list at its centre is empty and the stack is dropped
# there.

# The count is read while the pipe drops it. An entity per item lands at the same position and
# velocity, and the versions that merge item entities would fold those back into one stack a game
# tick later, so a test that waited could not tell the two apart. Test.tick_block_entity runs the
# pipe's own tick without ticking entities, so here the drop is still exactly what the pipe made.
drop_stack_count: number = 5

export tick(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    # The other pipe tests use bands at +15, +20, +25, +35, +40, +45 and +50, and +50 is the top of
    # the ladder that has to stay inside Alpha's 128-block world height, so this band is a clear one
    # below it.
    y: number = origin.y() + 30
    z: number = origin.z()

    level.place_block(x - 1, y, z, "minecraft:chest")
    level.place_block(x, y, z, "grug:wooden_pipe")

    source_opt: Option[BlockEntity] = level.get_block_entity(x - 1, y, z)
    pipe_opt: Option[BlockEntity] = level.get_block_entity(x, y, z)
    ctx.assert(source_opt.has(), "The source chest should have a block entity.")
    ctx.assert(pipe_opt.has(), "The pipe should have a block entity.")
    source: BlockEntity = source_opt.unwrap()
    pipe: BlockEntity = pipe_opt.unwrap()

    diamond: Item = item(resource_location("minecraft:diamond"))
    source.set_item_in_slot(0, diamond, drop_stack_count)

    # 64 energy, so the pull takes the slot's whole stack as PipeItemsWood.doWork's
    # min(energy stored, stack size) does.
    pipe.receive_energy(64)
    Test.tick_block_entity(pipe, 1)
    ctx.assert(pipe.get_saved_list_size("traveling") == 1, "The pull should have started one travelling stack.")
    ctx.assert(pipe.get_saved_list_number("traveling", 0, "count") == drop_stack_count, "The travelling stack should hold the source's whole stack.")

    # 49 moves reach the pipe's centre, where every exit is the source it came from or no inventory at
    # all, so the stack is dropped there.
    Test.tick_block_entity(pipe, 60)
    ctx.assert(pipe.get_saved_list_size("traveling") == 0, "The pipe should have dropped its travelling stack.")
    ctx.assert(source.get_item_count_in_slot(0) == 0, "The source chest should be empty.")

    # One entity holding the whole stack, not one entity per item: an entity per item would count as
    # five here, and would only merge back into one after a game tick this test never runs.
    dropped: number = level.count_item_entities(x, y, z, 10)
    ctx.assert(dropped == 1, "The pipe should have dropped the whole stack as one item entity.")

    found: Option[ItemEntity] = level.find_item_entity(x, y, z, 10)
    ctx.assert(found.has(), "The dropped stack should be on the ground.")
    ctx.assert(found.unwrap().count() == drop_stack_count, "The dropped item entity should hold the whole stack.")

    # EntityPassiveItem.toEntityItem makes a thrown stack wait 20 ticks. No entity has ticked since
    # the drop, so the delay is still the one the pipe set.
    ctx.assert(found.unwrap().pickup_delay() == 20, "A stack thrown out of the pipe should wait 20 ticks before it can be picked up.")
}
