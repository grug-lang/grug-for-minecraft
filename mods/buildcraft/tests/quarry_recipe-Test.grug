# The quarry's recipe, from BuildCraftFactory.loadRecipes, is iron gear, redstone, iron gear on the
# top row, gold gear, iron gear, gold gear in the middle, and diamond gear, diamond pickaxe, diamond
# gear at the bottom, and it makes one quarry. Like wooden_pipe_recipe-Test.grug it asks a crafting
# grid rather than the recipe tree, and it reuses that test's band 7, because the tests run one at a
# time and the runner clears the area before each.
export tick(ctx: TestTickContext) {
    # A loader that registers no mod recipe answers the grid with nothing, so the loader is asked
    # rather than assumed.
    if not me.registers_mod_recipes() {
        return
    }

    level: Level = ctx.get_client_level()
    origin: Vec3 = ctx.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 7
    z: number = origin.z()

    iron: Item = item(resource_location("grug:iron_gear"))
    gold: Item = item(resource_location("grug:gold_gear"))
    diamond: Item = item(resource_location("grug:diamond_gear"))
    redstone: Item = item(resource_location("minecraft:redstone"))
    pickaxe: Item = item(resource_location("minecraft:diamond_pickaxe"))
    quarry: Item = item(resource_location("grug:quarry"))

    level.place_block(x, y, z, "grug:coverage_block")
    found: Option[BlockEntity] = level.get_block_entity(x, y, z)
    ctx.assert(found.has(), "The coverage block should have a block entity after being placed.")
    grid: BlockEntity = found.unwrap()

    grid.set_item_in_slot(0, iron, 1)
    grid.set_item_in_slot(1, redstone, 1)
    grid.set_item_in_slot(2, iron, 1)
    grid.set_item_in_slot(3, gold, 1)
    grid.set_item_in_slot(4, iron, 1)
    grid.set_item_in_slot(5, gold, 1)
    grid.set_item_in_slot(6, diamond, 1)
    grid.set_item_in_slot(7, pickaxe, 1)
    grid.set_item_in_slot(8, diamond, 1)
    grid.update_recipe_output(0)

    result: Option[Item] = grid.get_crafting_result_item()
    ctx.assert(result.has(), "The quarry's gears, redstone and diamond pickaxe should craft a quarry.")
    ctx.assert(equals(result.unwrap(), quarry), "The quarry's recipe should answer a quarry.")
    ctx.assert(grid.take_crafting_result(1) == 1, "The quarry's recipe should give one quarry.")
}
