# Covers the frame a quarry builds around its box (#1543), as TileQuarry.doWork and BluePrintBuilder.findNextBlock
# do in BuildCraft 2.2.14. The quarry faces south (metadata 3), so its box is the 11 by 5 by 11 area that
# starts 5 blocks to its west and 11 to its north, from its own height up. The world's clock is set by hand
# so that each tick of the quarry is a work step: the work needs 25 energy and 20 ticks of the world's
# clock since the last step, and costs 25.
# Three cells are prepared (no water: place_block puts down a flowing water, which 1.2.5 and Beta
# name minecraft:unknown, so the builder clears it first; that is #1626). A stone block in the box's interior has to be cleared, which is a step of its
# own; a stone block on a frame cell is cleared and then replaced by a frame, two steps; and bedrock on a frame cell is a block the quarry may not
# break, so that cell never gets a frame. The frame has 40 cells at the bottom, 40 at the top and 12 on
# the three heights between the corner columns, 92 in all, one of which is bedrock, so 91 frames and 2 clears:
# the quarry takes 93 steps, and a 94th finds nothing left to do and costs no energy.
# The quarry stands 12 blocks south of the player, so that its whole box and frame lie inside the area the
# runner clears before every test (16 blocks around the player): a frame left outside it stayed in the world
# and the 1.2.5 client never settled again (#1628).
# The other tests' quarries run no steps, since they hold no energy.
export tick(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    origin: Vec3 = ctx.get_origin()
    x: number = Math.floor(origin.x())
    y: number = Math.floor(origin.y()) + 10
    z: number = Math.floor(origin.z()) + 12
    box_x: number = x - 5
    box_z: number = z - 11

    level.place_block(x, y, z, "grug:quarry")
    placed: Option[BlockEntity] = level.get_block_entity(x, y, z)
    ctx.assert(placed.has(), "The quarry should have a block entity.")
    quarry: BlockEntity = placed.unwrap()
    quarry.set_saved_number("meta", 3)

    level.place_block(box_x + 3, y, box_z + 3, "minecraft:stone")
    level.place_block(box_x + 10, y, box_z + 5, "minecraft:stone")
    level.place_block(box_x + 5, y + 4, box_z, "minecraft:bedrock")

    quarry.receive_energy(7000)
    time: number = 100000
    level.set_time(time)

    # The first step builds the box, and the corner is the first cell.
    ctx.tick_block_entity(quarry, 1)
    ctx.assert(level.get_block(box_x, y, box_z) == "grug:frame", "The first step should put a frame in the box's first corner.")
    ctx.assert(level.get_block(box_x, y, box_z + 1) == "minecraft:air", "The first step should place only one frame.")
    energy: number = quarry.get_energy_stored()
    ctx.assert(energy == 6974, "A step should cost 25 energy, and the first tick past 100 ticks of the clock loses 1.")

    # No step happens while the clock has moved less than 20 ticks.
    ctx.tick_block_entity(quarry, 1)
    ctx.assert(level.get_block(box_x, y, box_z + 1) == "minecraft:air", "No step should happen before 20 ticks of the clock.")
    ctx.assert(quarry.get_energy_stored() == energy, "No energy should be spent before 20 ticks of the clock.")

    step: number = 1
    while step < 200 and level.get_block(box_x + 10, y + 4, box_z + 10) != "grug:frame" {
        time = time + 20
        level.set_time(time)
        ctx.tick_block_entity(quarry, 1)
        step = step + 1
    }
    ctx.assert(step == 93, String.concat("The far top corner, the last cell, should be done by step 93, not step ", String.from_number(step)))

    ctx.assert(level.get_block(box_x + 3, y, box_z + 3) == "minecraft:air", "The stone block inside the box should be cleared.")
    ctx.assert(level.get_block(box_x + 10, y, box_z + 5) == "grug:frame", "The stone block on a frame cell should be cleared and replaced by a frame.")
    ctx.assert(level.get_block(box_x + 5, y + 4, box_z) == "minecraft:bedrock", "The bedrock on a frame cell should be left alone, and get no frame.")

    # The corners, one cell on each edge, and the middle of the box.
    ctx.assert(level.get_block(box_x + 10, y + 4, box_z + 10) == "grug:frame", "The far top corner should be a frame.")
    ctx.assert(level.get_block(box_x, y + 2, box_z + 10) == "grug:frame", "A corner column should be a frame at every height.")
    ctx.assert(level.get_block(box_x + 10, y + 2, box_z) == "grug:frame", "A corner column should be a frame at every height.")
    ctx.assert(level.get_block(box_x + 6, y, box_z + 10) == "grug:frame", "The bottom's far edge should be frames.")
    ctx.assert(level.get_block(box_x + 6, y + 4, box_z + 10) == "grug:frame", "The top's far edge should be frames.")
    ctx.assert(level.get_block(box_x + 6, y + 2, box_z + 10) == "minecraft:air", "Between the corner columns, a side should be open at the middle heights.")
    ctx.assert(level.get_block(box_x + 5, y + 2, box_z + 5) == "minecraft:air", "The inside of the box should stay empty.")

    # Nothing is left to do, so another step costs nothing; only the energy's slow loss can show.
    energy = quarry.get_energy_stored()
    time = time + 20
    level.set_time(time)
    ctx.tick_block_entity(quarry, 1)
    after: number = quarry.get_energy_stored()
    ctx.assert(after == energy or after == energy - 1, "A quarry with a finished frame should spend no energy on a step.")
}
