# Covers an item changing pipes, tick by tick, as PipeTransportItems does it: at the end of the
# wooden pipe (the 51st move from its centre) the item is removed from it and entityEntering puts it
# into the cobblestone pipe next to it, at the position that last move reached, still heading east and
# still on its way to the new pipe's centre. A pipe-to-pipe entry starts 0.49 from the centre, where an
# item from an inventory starts 0.5 away, so it reaches the centre on the 48th move and not the 49th.
# Both pipes are ticked by hand, after one dose of energy, so no engine timing can shift the counts.
export tick(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    # Band 12, clear of the bands the other pipe tests use.
    y: number = origin.y() + 12
    z: number = origin.z()
    bx: number = Math.floor(x)
    by: number = Math.floor(y)

    level.place_block(x - 1, y, z, "minecraft:chest")
    level.place_block(x, y, z, "grug:wooden_pipe")
    level.place_block(x + 1, y, z, "grug:cobblestone_pipe")
    level.place_block(x + 2, y, z, "minecraft:chest")

    source: BlockEntity = _entity(ctx, level, x - 1, y, z)
    wooden: BlockEntity = _entity(ctx, level, x, y, z)
    cobblestone: BlockEntity = _entity(ctx, level, x + 1, y, z)
    target: BlockEntity = _entity(ctx, level, x + 2, y, z)

    source.set_item_in_slot(0, item(resource_location("minecraft:diamond")), 2)
    wooden.receive_energy(2)

    # The pull, the 49 moves to the wooden pipe's centre and 50 of the 51 to its east face.
    Test.tick_block_entity(wooden, 1)
    ctx.assert(wooden.get_saved_list_size("traveling") == 1, "The pull should have started one travelling item.")
    Test.tick_block_entity(wooden, 99)
    ctx.assert(wooden.get_saved_list_size("traveling") == 1, "99 moves should still be inside the wooden pipe.")
    ctx.assert(cobblestone.get_saved_list_size("traveling") == 0, "The cobblestone pipe should hold nothing yet.")

    # The 100th move is the 51st past the centre, so the item enters the cobblestone pipe.
    Test.tick_block_entity(wooden, 1)
    ctx.assert(wooden.get_saved_list_size("traveling") == 0, "The wooden pipe should have handed the item on.")
    ctx.assert(cobblestone.get_saved_list_size("traveling") == 1, "The cobblestone pipe should have taken the item.")
    ctx.assert(_number(cobblestone, "direction") == 5, "The item should still travel east.")
    ctx.assert(_number(cobblestone, "to_center") == 1, "The item should be heading for the new pipe's centre.")
    ctx.assert(_number(cobblestone, "count") == 2, "The whole stack should have entered.")
    ctx.assert(_hundredths(_number(cobblestone, "x") - bx) == 101, "The item should enter 0.01 past the wooden pipe's east face.")
    ctx.assert(_number(cobblestone, "y") == by + 0.25, "The item should be on the cobblestone pipe's floor.")
    ctx.assert(_number(cobblestone, "speed") == 0.01, "The item should keep the normal pipe speed.")
    ctx.assert(source.get_item_count_in_slot(0) == 0, "The source chest should be empty.")
    ctx.assert(target.get_item_count_in_slot(0) == 0, "The target chest should still be empty.")

    # 47 moves leave it 0.02 short of the centre, and the 48th reaches it and snaps.
    Test.tick_block_entity(cobblestone, 47)
    ctx.assert(_number(cobblestone, "to_center") == 1, "47 moves should not reach the centre.")
    Test.tick_block_entity(cobblestone, 1)
    ctx.assert(_number(cobblestone, "to_center") == 0, "The 48th move should reach the centre.")
    ctx.assert(_hundredths(_number(cobblestone, "x") - bx) == 150, "The item should snap to the centre.")
    ctx.assert(_number(cobblestone, "direction") == 5, "The only exit is the east chest, so the pick stays east.")

    # 50 more moves are still inside, and the 51st hands the stack to the chest.
    Test.tick_block_entity(cobblestone, 50)
    ctx.assert(cobblestone.get_saved_list_size("traveling") == 1, "50 moves from the centre should still be inside the pipe.")
    Test.tick_block_entity(cobblestone, 1)
    ctx.assert(cobblestone.get_saved_list_size("traveling") == 0, "The 51st move should hand the item over.")
    ctx.assert(target.get_item_count_in_slot(0) == 2, "The east chest should hold both diamonds.")
    ctx.assert(wooden.get_saved_list_size("traveling") == 0, "The item should not have gone back into the wooden pipe.")
    ctx.assert(source.get_item_count_in_slot(0) == 0, "The item should not have gone back into the source chest.")
}

local _entity(ctx: TestTickContext, level: Level, x: number, y: number, z: number) BlockEntity {
    block_entity: Option[BlockEntity] = level.get_block_entity(x, y, z)
    ctx.assert(block_entity.has(), "The fixture should have a block entity.")
    return block_entity.unwrap()
}

local _number(pipe: BlockEntity, key: string) number {
    return pipe.get_saved_list_number("traveling", 0, key)
}

# A position is accumulated one float64 step at a time, so rounding the distance to hundredths is
# what the tests compare, as wooden_pipe_travel does.
local _hundredths(value: number) number {
    return Math.floor(value * 100 + 0.5)
}
