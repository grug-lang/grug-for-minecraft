# Covers the wooden pipe preserving an item's damage when it drops the item because nothing accepts it.
pipe_drop_source: Option[BlockEntity] = Option.new()
pipe_drop_self: Option[BlockEntity] = Option.new()

export run() {
    if Test.tick() == 0 {
        _drop_setup()
        Test.not_done()
    } else if not _drop_pipe_has_moved() or Test.tick() < 15 {
        # Same floor as wooden_pipe-Test.grug, for the same reason (#262).
        Test.not_done()
    } else {
        _drop_check()
    }
}

local _drop_setup() {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    # The other pipe tests use bands at +25, +35 and +45, so this one works in a clear band. +50 is the
    # top of the ladder and has to stay inside Alpha's 128-block world height, so nothing goes above it.
    y: number = origin.y() + 50
    z: number = origin.z()

    level.place_block(x - 1, y, z, "minecraft:chest")
    level.place_block(x, y, z, "grug:wooden_pipe")

    # A torch powers the block above it, but not the block it is attached to, and a standing torch
    # does not power the block above its own base, so this puts the torch under the engine.
    level.place_block(x, y - 3, z, "minecraft:stone")
    level.place_block(x, y - 2, z, "minecraft:redstone_torch")
    level.place_block(x, y - 1, z, "grug:redstone_engine")

    source_opt: Option[BlockEntity] = level.get_block_entity(x - 1, y, z)
    self_opt: Option[BlockEntity] = level.get_block_entity(x, y, z)
    Test.assert(source_opt.has(), "The source chest should have a block entity.")
    Test.assert(self_opt.has(), "The pipe should have a block entity.")
    pipe_drop_source.set(source_opt.unwrap())
    pipe_drop_self.set(self_opt.unwrap())

    sword: Item = item(resource_location("minecraft:diamond_sword"))
    set_item_in_slot(pipe_drop_source.unwrap(), 0, sword, 1)
    set_item_damage_in_slot(pipe_drop_source.unwrap(), 0, 7)
}

local _drop_check() {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 50
    z: number = origin.z()

    source_count: number = get_item_count_in_slot(pipe_drop_source.unwrap(), 0)
    Test.assert(source_count == 0, "The source chest should be empty.")

    # A wide radius, because the dropped item is not held in place.
    found: Option[ItemEntity] = level.find_item_entity(x, y, z, 10)
    Test.assert(found.has(), "The pipe should have dropped the sword.")

    if found.has() {
        dropped: ItemEntity = found.unwrap()
        Test.assert(dropped.damage() == 7, "The dropped sword should keep its damage.")
    }
}

# The pipe has finished with the item once it has left the source chest and the pipe's own one-slot
# buffer. Nothing accepts the item here, so that also means it is on the ground, which is what _check
# asserts, damage and all. See #173.
local _drop_pipe_has_moved() bool {
    source_empty: bool = get_item_count_in_slot(pipe_drop_source.unwrap(), 0) == 0
    pipe_empty: bool = get_item_count_in_slot(pipe_drop_self.unwrap(), 0) == 0
    return source_empty and pipe_empty
}
