# Covers the wooden pipe preserving an item's damage when it drops the item because nothing accepts it.
pipe_drop_source: Option[BlockEntity] = Option.new()
pipe_drop_self: Option[BlockEntity] = Option.new()
pipe_drop_found: Option[ItemEntity] = Option.new()
pipe_drop_damage: number = 0
pipe_drop_count: number = 0
pipe_drop_sampled: bool = false

export tick_any_side(ctx: TestTickContext) {
    if ctx.current_tick() == 0 {
        _drop_setup(ctx)
        ctx.not_done()
    } else if ctx.current_tick() < 15 or not pipe_drop_sampled {
        # Same floor as wooden_pipe-Test.grug, for the same reason (#262). It is a wait only: the
        # drop is read on the tick the pipe lets go of it, because a dedicated server advances up to
        # ten world ticks per runner tick and a read at the end of the floor can find the sword
        # fallen out of the radius or already picked up (#1146).
        _drop_sample()
        ctx.not_done()
    } else {
        _drop_check(ctx)
    }
}

local _drop_setup(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    # The other pipe tests use bands at +25, +35 and +45, so this one works in a clear band. +50 is
    # the top of the ladder, and a high spawn would put it above Alpha's 128-block world height, so
    # _drop_band_y keeps it at 120 or below.
    y: number = _drop_band_y(origin)
    z: number = origin.z()

    level.place_block(x - 1, y, z, "minecraft:chest")
    level.place_block(x, y, z, "grug:wooden_pipe")

    # A torch powers the block above it, but not the block it is attached to, and a standing torch
    # does not power the block above its own base, so this puts the torch under the engine.
    level.place_block(x, y - 3, z, "minecraft:stone")
    level.place_block(x, y - 2, z, "minecraft:redstone_torch")
    level.place_block(x, y - 1, z, "grug:redstone_engine")

    source_opt: Option[BlockEntity] = level.get_block_entity(x - 1, y, z)
    self_opt: Option[BlockEntity] = level.get_block_entity(x, y, z)
    ctx.assert(source_opt.has(), "The source chest should have a block entity.")
    ctx.assert(self_opt.has(), "The pipe should have a block entity.")
    pipe_drop_source.set(source_opt.unwrap())
    pipe_drop_self.set(self_opt.unwrap())

    sword: Item = item(resource_location("minecraft:diamond_sword"))
    pipe_drop_source.unwrap().set_item_in_slot(0, sword, 1)
    pipe_drop_source.unwrap().set_item_damage_in_slot(0, 7)
}

# Reads the dropped sword once, on the world tick the pipe has finished with it, and keeps what the
# drop made: the entity, its damage and its count. A read taken after more ticks can see an entity
# that has fallen out of the radius or been picked up, which is the same drop read differently
# (#1146).
local _drop_sample() {
    if pipe_drop_sampled or not _drop_pipe_has_moved() {
        return
    }
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    # A wide radius, because the drop is made wherever the pipe was, and the sword falls from there.
    found: Option[ItemEntity] = level.find_item_entity(origin.x(), _drop_band_y(origin), origin.z(), 10)
    if found.has() {
        dropped: ItemEntity = found.unwrap()
        pipe_drop_found.set(dropped)
        pipe_drop_damage = dropped.damage()
        pipe_drop_count = dropped.count()
    }
    pipe_drop_sampled = true
}

local _drop_check(ctx: TestTickContext) {
    source_count: number = pipe_drop_source.unwrap().get_item_count_in_slot(0)
    travelling: number = pipe_drop_self.unwrap().get_saved_list_size("traveling")
    ctx.assert(source_count == 0, "The source chest should be empty.")
    ctx.assert(travelling == 0, "The pipe should have dropped its travelling item.")

    # The values read when the pipe let go of the sword, not a read from now.
    ctx.assert(pipe_drop_found.has(), "The pipe should have dropped the sword.")
    ctx.assert(pipe_drop_count == 1, "The dropped sword should be the one the pipe carried.")
    ctx.assert(pipe_drop_damage == 7, "The dropped sword should keep its damage.")
}

# The band +50 above the origin, kept inside Alpha's 128-block world height. The dedicated server
# places the joining player at a random point within 10 blocks of the world spawn, at the terrain
# height there, so the origin's y changes between runs; an unclamped band at y 128 or above is
# refused by level.place_block. 120 is still inside the area the room build clears for every spawn
# this save can produce.
local _drop_band_y(origin: Vec3) number {
    y: number = origin.y() + 50
    if y > 120 {
        y = 120
    }
    return y
}

# The pipe has finished with the item once it has left the source chest and the pipe's travelling
# list. Nothing accepts the item here, so that also means it is on the ground, which is what _check
# asserts, damage and all. See #173.
local _drop_pipe_has_moved() bool {
    source_empty: bool = pipe_drop_source.unwrap().get_item_count_in_slot(0) == 0
    pipe_empty: bool = pipe_drop_self.unwrap().get_saved_list_size("traveling") == 0
    return source_empty and pipe_empty
}
