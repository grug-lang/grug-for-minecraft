# Covers the wooden pipe turning a corner: source chest below, target chest to the north.
pipe_turn_source: Option[BlockEntity] = Option.new()
pipe_turn_target: Option[BlockEntity] = Option.new()
pipe_turn_self: Option[BlockEntity] = Option.new()

export run() {
    if me.tick() == 0 {
        _turn_setup()
        me.not_done()
    } else if not _turn_pipe_has_moved() or me.tick() < 20 {
        # Same floor as wooden_pipe-Test.grug, for the same reason (#262).
        me.not_done()
    } else {
        _turn_check()
    }
}

local _turn_setup() {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    # The straight-pipe test runs first at the same origin, so this test works a different band.
    y: number = origin.y() + 35
    z: number = origin.z()

    # The source is below the pipe and the engine beside it. A fresh pipe's side is 0, below, and
    # PipeLogicWood.switchSourceIfNeeded keeps it while that side holds an inventory, so the source is
    # the chest below rather than the target it pushes to.
    pos: BlockPos = BlockPos.new(x, y - 1, z)
    level.place_block(pos, "minecraft:chest")
    pos2: BlockPos = BlockPos.new(x, y, z)
    level.place_block(pos2, "grug:wooden_pipe")
    pos3: BlockPos = BlockPos.new(x, y, z - 1)
    level.place_block(pos3, "minecraft:chest")

    level.place_block(BlockPos.new(x - 1, y - 2, z), "minecraft:stone")
    level.place_block(BlockPos.new(x - 1, y - 1, z), "minecraft:redstone_torch")
    level.place_block(BlockPos.new(x - 1, y, z), "grug:redstone_engine")

    source_opt: Option[BlockEntity] = level.get_block_entity(pos)
    target_opt: Option[BlockEntity] = level.get_block_entity(pos3)
    self_opt: Option[BlockEntity] = level.get_block_entity(pos2)
    Test.assert(source_opt.has(), "The source chest should have a block entity.")
    Test.assert(target_opt.has(), "The target chest should have a block entity.")
    Test.assert(self_opt.has(), "The pipe should have a block entity.")

    pipe_turn_source.set(source_opt.unwrap())
    pipe_turn_target.set(target_opt.unwrap())
    pipe_turn_self.set(self_opt.unwrap())

    diamond: Item = item(resource_location("minecraft:diamond"))
    pipe_turn_source_be: BlockEntity = pipe_turn_source.unwrap()
    pipe_turn_source_be.set_item_in_slot(0, diamond, 1)
}

local _turn_check() {
    pipe_turn_source_be: BlockEntity = pipe_turn_source.unwrap()
    source_count: number = pipe_turn_source_be.get_item_count_in_slot(0)
    pipe_turn_target_be: BlockEntity = pipe_turn_target.unwrap()
    target_count: number = pipe_turn_target_be.get_item_count_in_slot(0)
    pipe_turn_self_be: BlockEntity = pipe_turn_self.unwrap()
    pipe_count: number = pipe_turn_self_be.get_item_count_in_slot(0)

    Test.assert(source_count + target_count + pipe_count == 1, "The diamond should exist exactly once.")
    Test.assert(source_count == 0, "The source chest should be empty.")
    Test.assert(target_count == 1, "The north chest should hold the diamond.")
    Test.assert(pipe_count == 0, "The pipe should not still be holding the diamond.")
}

# Same wait as wooden_pipe-Test.grug: the pipe has finished handling the item once it has left the
# source chest and the pipe's own one-slot buffer; the corner it turned is what _check asserts. See
# #173.
local _turn_pipe_has_moved() bool {
    pipe_turn_source_be: BlockEntity = pipe_turn_source.unwrap()
    source_empty: bool = pipe_turn_source_be.get_item_count_in_slot(0) == 0
    pipe_turn_self_be: BlockEntity = pipe_turn_self.unwrap()
    pipe_empty: bool = pipe_turn_self_be.get_item_count_in_slot(0) == 0
    return source_empty and pipe_empty
}
