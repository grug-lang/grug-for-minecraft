# Covers the wooden pipe turning a corner: source chest below, target chest to the north.
pipe_turn_source: Option[BlockEntity] = Option.new()
pipe_turn_target: Option[BlockEntity] = Option.new()
pipe_turn_self: Option[BlockEntity] = Option.new()

# Waiting for the pipe is waiting for the game's clock and nothing is drawn or read from a frame,
# so the clock may run faster: the test counts the same game ticks and takes a fraction of the
# seconds. See TestInitContext.set_game_speed.
export init(ctx: TestInitContext) {
    ctx.set_game_speed(10)
}

export tick(ctx: TestTickContext) {
    if ctx.current_tick() == 0 {
        _turn_setup(ctx)
        ctx.not_done()
    } else if not _turn_pipe_has_moved() or ctx.current_tick() < 20 {
        # Same floor as wooden_pipe-Test.grug, for the same reason (#262).
        ctx.not_done()
    } else {
        _turn_check(ctx)
    }
}

local _turn_setup(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    # The straight-pipe test runs first at the same origin, so this test works a different band.
    y: number = origin.y() + 35
    z: number = origin.z()

    # The source is below the pipe and the engine beside it. A fresh pipe's side is 0, below, and
    # PipeLogicWood.switchSourceIfNeeded keeps it while that side holds an inventory, so the source is
    # the chest below rather than the target it pushes to.
    level.place_block(x, y - 1, z, "minecraft:chest")
    level.place_block(x, y, z, "grug:wooden_pipe")
    level.place_block(x, y, z - 1, "minecraft:chest")

    level.place_block(x - 1, y - 2, z, "minecraft:stone")
    level.place_block(x - 1, y - 1, z, "minecraft:redstone_torch")
    level.place_block(x - 1, y, z, "grug:redstone_engine")

    source_opt: Option[BlockEntity] = level.get_block_entity(x, y - 1, z)
    target_opt: Option[BlockEntity] = level.get_block_entity(x, y, z - 1)
    self_opt: Option[BlockEntity] = level.get_block_entity(x, y, z)
    ctx.assert(source_opt.has(), "The source chest should have a block entity.")
    ctx.assert(target_opt.has(), "The target chest should have a block entity.")
    ctx.assert(self_opt.has(), "The pipe should have a block entity.")

    pipe_turn_source.set(source_opt.unwrap())
    pipe_turn_target.set(target_opt.unwrap())
    pipe_turn_self.set(self_opt.unwrap())

    diamond: Item = item(resource_location("minecraft:diamond"))
    pipe_turn_source.unwrap().set_item_in_slot(0, diamond, 1)
}

local _turn_check(ctx: TestTickContext) {
    source_count: number = pipe_turn_source.unwrap().get_item_count_in_slot(0)
    target_count: number = pipe_turn_target.unwrap().get_item_count_in_slot(0)
    pipe_travelling: number = pipe_turn_self.unwrap().get_saved_list_size("traveling")

    ctx.assert(source_count + target_count + pipe_travelling == 1, "The diamond should exist exactly once.")
    ctx.assert(source_count == 0, "The source chest should be empty.")
    ctx.assert(target_count == 1, "The north chest should hold the diamond.")
    ctx.assert(pipe_travelling == 0, "The pipe should not still be carrying the diamond.")
}

# Same wait as wooden_pipe-Test.grug: the pipe has finished handling the item once it has left the
# source chest and the pipe's travelling list; the corner it turned is what _check asserts. See #173.
local _turn_pipe_has_moved() bool {
    source_empty: bool = pipe_turn_source.unwrap().get_item_count_in_slot(0) == 0
    pipe_empty: bool = pipe_turn_self.unwrap().get_saved_list_size("traveling") == 0
    return source_empty and pipe_empty
}
