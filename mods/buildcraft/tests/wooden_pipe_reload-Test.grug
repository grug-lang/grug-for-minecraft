# Covers travelling items surviving their block entity's NBT: the pipe pulls a stack of 3 diamonds
# and a sword worn to 7, its state is serialised and read straight back, and both then finish their
# journey. This is the save and load path PipeTransportItems.writeToNBT and readFromNBT take,
# without the chunk unload a test cannot do. The stack's count and the sword's damage are the
# record's own numbers, and neither is the default of 1 and 0, so the reload has to keep both.
reload_pipe: Option[BlockEntity] = Option.new()
reload_source: Option[BlockEntity] = Option.new()
reload_target: Option[BlockEntity] = Option.new()

export tick(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()
    bx: number = Math.floor(x)

    level.place_block(x - 1, y, z, "minecraft:chest")
    level.place_block(x, y, z, "grug:wooden_pipe")
    level.place_block(x + 1, y, z, "minecraft:chest")

    source: BlockEntity = _entity(ctx, level, x - 1, y, z)
    pipe: BlockEntity = _entity(ctx, level, x, y, z)
    target: BlockEntity = _entity(ctx, level, x + 1, y, z)
    reload_source.set(source)
    reload_pipe.set(pipe)
    reload_target.set(target)

    # Two records, because a record's count is the count of a stack and its damage is the wear on one
    # item, and no item both stacks past one and takes wear. The pipe takes one slot per tick, so the
    # sword's pull needs its own energy.
    diamond: Item = item(resource_location("minecraft:diamond"))
    sword: Item = item(resource_location("minecraft:diamond_sword"))
    source.set_item_in_slot(0, diamond, 3)
    source.set_item_in_slot(1, sword, 1)
    source.set_item_damage_in_slot(1, 7)

    pipe.receive_energy(3)
    Test.tick_block_entity(pipe, 1)
    pipe.receive_energy(1)
    Test.tick_block_entity(pipe, 1)

    ctx.assert(pipe.get_saved_list_size("traveling") == 2, "The pulls should have started two travelling records.")
    ctx.assert(pipe.get_saved_list_number("traveling", 0, "count") == 3, "The stack's record should hold 3 items.")
    ctx.assert(pipe.get_saved_list_number("traveling", 1, "damage") == 7, "The sword's record should hold its wear.")

    # Move them 20 ticks in, then reload, so neither record is at the face where it started. The
    # sword entered a tick after the stack, so it is one move behind it.
    Test.tick_block_entity(pipe, 20)
    stack_x: number = pipe.get_saved_list_number("traveling", 0, "x")
    sword_x: number = pipe.get_saved_list_number("traveling", 1, "x")
    ctx.assert(_hundredths(stack_x - bx) == 21, "The stack should be 21 moves into the pipe.")
    ctx.assert(_hundredths(sword_x - bx) == 20, "The sword should be 20 moves into the pipe.")

    Test.round_trip_nbt(pipe)

    ctx.assert(pipe.get_saved_list_size("traveling") == 2, "The reload should keep both travelling records.")
    ctx.assert(pipe.get_saved_list_number("traveling", 0, "x") == stack_x, "The reload should keep the stack's position.")
    ctx.assert(pipe.get_saved_list_number("traveling", 1, "x") == sword_x, "The reload should keep the sword's position.")
    ctx.assert(pipe.get_saved_list_number("traveling", 0, "count") == 3, "The reload should keep the stack's count.")
    ctx.assert(pipe.get_saved_list_number("traveling", 1, "damage") == 7, "The reload should keep the sword's wear.")
    # A record's item is its identity alone: a loader writes it as a stack of one, undamaged, so what
    # the chest receives is the record's own count and damage beside this identity, not the stack the
    # item came in. That is the recorded limitation of the shape (#473), not an accident.
    stack_item: Option[Item] = pipe.get_saved_list_item("traveling", 0)
    ctx.assert(stack_item.has(), "The reload should keep the stack's item.")
    ctx.assert(equals(stack_item.unwrap(), diamond), "The reload should keep the stack's diamond.")
    sword_item: Option[Item] = pipe.get_saved_list_item("traveling", 1)
    ctx.assert(sword_item.has(), "The reload should keep the sword's item.")
    ctx.assert(equals(sword_item.unwrap(), sword), "The reload should keep the sword.")

    # The stack is 21 moves in, so 28 more reach the centre and 51 more reach the far face, and the
    # sword is a move behind it.
    Test.tick_block_entity(pipe, 90)
    ctx.assert(pipe.get_saved_list_size("traveling") == 0, "Both records should have finished after the reload.")
    ctx.assert(target.get_item_count_in_slot(0) == 3, "The east chest should hold the reloaded stack of 3.")
    ctx.assert(target.get_item_count_in_slot(1) == 1, "The east chest should hold the reloaded sword.")
    ctx.assert(target.get_item_damage_in_slot(1) == 7, "The sword should arrive with the wear the record kept.")
    ctx.assert(source.get_item_count_in_slot(0) == 0, "The source chest's first slot should be empty.")
    ctx.assert(source.get_item_count_in_slot(1) == 0, "The source chest's second slot should be empty.")
}

local _entity(ctx: TestTickContext, level: Level, x: number, y: number, z: number) BlockEntity {
    block_entity: Option[BlockEntity] = level.get_block_entity(x, y, z)
    ctx.assert(block_entity.has(), "The fixture should have a block entity.")
    return block_entity.unwrap()
}

# Accumulated float64 steps are a rounding error away from the double nearest the decimal, so the
# distance is rounded to hundredths before it is compared.
local _hundredths(value: number) number {
    return Math.floor(value * 100 + 0.5)
}
