# Covers a travelling item surviving its block entity's NBT: the pipe pulls a stack of 3 coal, its
# state is serialised and read straight back, and the stack then finishes its journey. This is the
# save and load path PipeTransportItems.writeToNBT and readFromNBT take, without the chunk unload a
# test cannot do. The stack's count and damage are the record's own numbers, so a reload has to keep
# numbers that are not the defaults of 1 and 0.
reload_pipe: Option[BlockEntity] = Option.new()
reload_source: Option[BlockEntity] = Option.new()
reload_target: Option[BlockEntity] = Option.new()

export tick(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()
    bx: number = Math.floor(x)

    level.place_block(x - 1, y, z, "minecraft:chest")
    level.place_block(x, y, z, "grug:wooden_pipe")
    level.place_block(x + 1, y, z, "minecraft:chest")

    source: BlockEntity = _entity(ctx, level, x - 1, y, z)
    pipe: BlockEntity = _entity(ctx, level, x, y, z)
    target: BlockEntity = _entity(ctx, level, x + 1, y, z)
    reload_source.set(source)
    reload_pipe.set(pipe)
    reload_target.set(target)

    # Coal's damage 1 is charcoal, a subtype of the item rather than wear, so the record carries a
    # damage that means something to the game and is not the default. No test item in this mod both
    # stacks past one and has a damage otherwise, and the pipe only ever moves the number.
    coal: Item = item(resource_location("minecraft:coal"))
    source.set_item_in_slot(0, coal, 3)
    source.set_item_damage_in_slot(0, 1)

    # One energy per item, so the whole stack is taken in one go and one record starts.
    pipe.receive_energy(3)
    Test.tick_block_entity(pipe, 1)
    ctx.assert(pipe.get_saved_list_size("traveling") == 1, "The pull should have started one travelling stack.")
    ctx.assert(pipe.get_saved_list_number("traveling", 0, "count") == 3, "The pull should have taken the whole stack.")
    ctx.assert(pipe.get_saved_list_number("traveling", 0, "damage") == 1, "The pull should have kept the stack's damage.")

    # Move it 20 ticks in, then reload, so the record is not at the face where it started.
    Test.tick_block_entity(pipe, 20)
    before: number = pipe.get_saved_list_number("traveling", 0, "x")
    ctx.assert(_hundredths(before - bx) == 20, "20 moves should put the item a fifth of the way into the pipe.")

    Test.round_trip_nbt(pipe)

    ctx.assert(pipe.get_saved_list_size("traveling") == 1, "The reload should keep the travelling item.")
    ctx.assert(pipe.get_saved_list_number("traveling", 0, "x") == before, "The reload should keep the item's position.")
    ctx.assert(pipe.get_saved_list_number("traveling", 0, "count") == 3, "The reload should keep the stack's count.")
    ctx.assert(pipe.get_saved_list_number("traveling", 0, "damage") == 1, "The reload should keep the stack's damage.")
    # The record's item is its identity alone: a loader writes it as a stack of one, undamaged, so
    # what the chest receives is the record's own count and damage beside this identity, not the
    # stack the item came in. That is the recorded limitation of the shape (#473), not an accident.
    saved_item: Option[Item] = pipe.get_saved_list_item("traveling", 0)
    ctx.assert(saved_item.has(), "The reload should keep the item itself.")
    ctx.assert(equals(saved_item.unwrap(), coal), "The reload should keep the coal.")

    # 20 moves are done, so 29 more reach the centre and 51 more reach the far face.
    Test.tick_block_entity(pipe, 90)
    ctx.assert(pipe.get_saved_list_size("traveling") == 0, "The item should have finished its journey after the reload.")
    ctx.assert(target.get_item_count_in_slot(0) == 3, "The east chest should hold the reloaded stack of 3.")
    ctx.assert(target.get_item_damage_in_slot(0) == 1, "The east chest should hold the stack with its damage.")
    ctx.assert(source.get_item_count_in_slot(0) == 0, "The source chest should be empty.")
}

local _entity(ctx: TestTickContext, level: Level, x: number, y: number, z: number) BlockEntity {
    block_entity: Option[BlockEntity] = level.get_block_entity(x, y, z)
    ctx.assert(block_entity.has(), "The fixture should have a block entity.")
    return block_entity.unwrap()
}

# Accumulated float64 steps are a rounding error away from the double nearest the decimal, so the
# distance is rounded to hundredths before it is compared.
local _hundredths(value: number) number {
    return Math.floor(value * 100 + 0.5)
}
