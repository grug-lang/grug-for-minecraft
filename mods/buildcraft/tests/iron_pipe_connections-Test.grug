# Covers which neighbours the iron pipe grows an arm toward. BuildCraft 2.2.14's PipeLogicIron is
# PipeLogic, which refuses nothing, so with the default pipes.alwaysConnect of false an iron pipe
# connects to every pipe this mod has, the wooden pipe included, and to an inventory, as
# PipeTransportItems.isPipeConnected accepts it. The wooden pipe's own logic is the only one that
# could refuse this pair, and it refuses only another wooden pipe, so the second fixture asks the
# wooden pipe's side of it. The fixture asks the rule through the pipe's collision box, as
# stone_pipe_connections does.
phase: number = 0

export tick(ctx: TestTickContext) {
    if phase == 0 {
        phase = 1
        level: Level = ctx.get_client_level()
        origin: Vec3 = ctx.get_origin()
        x: number = origin.x()
        y: number = origin.y() + 6
        z: number = origin.z()
        level.place_block(x - 1, y, z, "grug:wooden_pipe")
        level.place_block(x, y, z - 1, "grug:cobblestone_pipe")
        level.place_block(x + 1, y, z, "grug:stone_pipe")
        level.place_block(x, y, z + 1, "minecraft:chest")
        level.place_block(x, y, z, "grug:iron_pipe")

        # A wooden pipe beside an iron one, asked from the wooden pipe.
        level.place_block(x + 4, y, z, "grug:wooden_pipe")
        level.place_block(x + 5, y, z, "grug:iron_pipe")
        ctx.not_done()
    } else if phase == 1 and not ctx.world_settled() {
        ctx.not_done()
    } else {
        _check(ctx)
    }
}

local _check(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    origin: Vec3 = ctx.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 6
    z: number = origin.z()

    ctx.assert(ctx.block_collision(level, x, y, z, 0.35, 0.35, 0.35, 0.65, 0.65, 0.65), "The iron pipe's centre should collide.")
    ctx.assert(ctx.block_collision(level, x, y, z, 0.02, 0.35, 0.35, 0.2, 0.65, 0.65), "An iron pipe beside a wooden pipe should have an arm toward it.")
    ctx.assert(ctx.block_collision(level, x, y, z, 0.35, 0.35, 0.02, 0.65, 0.65, 0.2), "An iron pipe beside a cobblestone pipe should have an arm toward it.")
    ctx.assert(ctx.block_collision(level, x, y, z, 0.8, 0.35, 0.35, 0.98, 0.65, 0.65), "An iron pipe beside a stone pipe should have an arm toward it.")
    ctx.assert(ctx.block_collision(level, x, y, z, 0.35, 0.35, 0.8, 0.65, 0.65, 0.98), "An iron pipe beside an inventory should have an arm toward it.")

    ctx.assert(ctx.block_collision(level, x + 4, y, z, 0.8, 0.35, 0.35, 0.98, 0.65, 0.65), "A wooden pipe beside an iron pipe should have an arm toward it.")
}
