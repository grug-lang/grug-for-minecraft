# Covers the golden conductive pipe's transport, which is the stone pipe's with one difference:
# PipePowerGold sets the transport's resistance to 0.001, so a thousandth of every unit is lost
# rather than a hundredth. The beam shows it on a value where the two differ (101 units is 100.899
# here and 99.99 on the stone pipe, so the display power is 50 against 49), the pipe hands its
# neighbour 99.9 of 100, and the explosion threshold moves with the resistance: 1000 units arrive as
# 999 and the pipe stands, while 1005 arrive as 1003.995 and it does not.
export tick(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    origin: Vec3 = ctx.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()
    original: number = level.get_time()

    level.place_block(x, y, z, "grug:golden_power_pipe")
    pipe: BlockEntity = _entity(ctx, level, x, y, z)
    ctx.assert(not pipe.is_power_receiver(), "A golden conductive pipe should not be an energy receiver.")

    # 101 energy from the east and a request of 10 from the west: 100.899 after the resistance, so
    # each side of the distribution shows 50, where the stone pipe's 99.99 shows 49.
    level.place_block(x - 1, y, z, "grug:coverage_power_block")
    receiver: BlockEntity = _entity(ctx, level, x - 1, y, z)
    level.set_time(original + 100)
    pipe.receive_energy_on(5, 101)
    pipe.request_energy_on(4, 10)
    level.set_time(original + 101)
    ctx.tick_block_entity(pipe, 1)
    ctx.assert(pipe.get_saved_list_number("power", 4, "display") == 50, "101 energy at a thousandth lost should show 50 on the side that got it.")
    ctx.assert(pipe.get_saved_list_number("power", 5, "display") == 50, "And 50 on the side it came in on.")
    ctx.assert(receiver.get_energy_stored() == 10, "The machine should have been handed its whole units, up to its store.")

    # 100 energy to a pipe neighbour is 99.9 of it, the whole fraction.
    level.place_block(x, y + 4, z, "grug:golden_power_pipe")
    level.place_block(x - 1, y + 4, z, "grug:golden_power_pipe")
    giver: BlockEntity = _entity(ctx, level, x, y + 4, z)
    taker: BlockEntity = _entity(ctx, level, x - 1, y + 4, z)
    level.set_time(original + 110)
    giver.receive_energy_on(5, 100)
    giver.request_energy_on(4, 3)
    level.set_time(original + 111)
    ctx.tick_block_entity(giver, 1)
    level.set_time(original + 112)
    ctx.assert(_hundredths(taker.take_received_energy(5)) == 9990, "The pipe neighbour should be handed 99.9, a thousandth lost.")

    # 1000 units arrive as 999, below the explosion.
    level.place_block(x, y + 8, z, "grug:golden_power_pipe")
    thousand: BlockEntity = _entity(ctx, level, x, y + 8, z)
    level.set_time(original + 120)
    thousand.receive_energy_on(5, 1000)
    level.set_time(original + 121)
    ctx.tick_block_entity(thousand, 1)
    ctx.assert(level.get_block(x, y + 8, z) == "grug:golden_power_pipe", "1000 units at a thousandth lost should not explode the golden pipe.")

    # 1005 units arrive as 1003.995, so they do.
    level.place_block(x + 16, y + 8, z, "grug:golden_power_pipe")
    beyond: BlockEntity = _entity(ctx, level, x + 16, y + 8, z)
    level.set_time(original + 130)
    beyond.receive_energy_on(5, 1005)
    level.set_time(original + 131)
    ctx.tick_block_entity(beyond, 1)
    ctx.assert(level.get_block(x + 16, y + 8, z) == "minecraft:air", "1005 units at a thousandth lost should explode the golden pipe.")

    level.set_time(original)
}

local _entity(ctx: TestTickContext, level: Level, x: number, y: number, z: number) BlockEntity {
    found: Option[BlockEntity] = level.get_block_entity(x, y, z)
    ctx.assert(found.has(), "The fixture should have a block entity.")
    return found.unwrap()
}

# A fraction is compared at hundredths: 100 * (1 - 0.001) is a rounding error away from 99.9 in
# float64.
local _hundredths(value: number) number {
    return Math.floor(value * 100 + 0.5)
}
