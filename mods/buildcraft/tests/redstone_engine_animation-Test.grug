# Covers how the redstone engine draws its stroke, which RenderEngine does from the engine's progress:
# the plate slides out along the facing by a step of up to 7.99 pixels, at its farthest at a progress
# of 0.5, and a chamber box is stacked every two pixels under it. The progress is set directly
# here, because what the engine does to it each tick is covered where it is advanced.
# Each capture first lets the engines at rest settle and be meshed, then changes them, so on the port
# the capture shows the change only if the engine had itself drawn again.
# The first capture shows six engines facing up at progress 0.1, 0.25, 0.4, 0.5, 0.75 and 0.9, with
# +x on the left, so the plate goes out and comes back in from right to left. It is the engine's
# own tick that has them drawn again, as it does for every tick of a stroke. The second capture shows
# the six facings at progress 0.5, facing 0 at the right and 5 at the left, since the camera looks
# towards +z.
# The capture stops high on the screen because the runner prints each test's name to the chat on
# every loader but 1.2.5, and that readout grows to ten lines of 27 pixels once a repeat has run, so
# anything below about y=250 holds text in a later repeat.
# The reference run has no grug saved data, so it sets the real TileEngine's "orientation" and
# "progress" through its NBT instead, and Test.load_nbt replaces the engine with one loaded from it
# and redraws the block. RenderEngine is a tile entity renderer that reads both on every frame, and
# an unpowered engine at rest leaves its progress alone, so the loaded numbers are what it draws. The
# reference therefore needs no redraw of the engine's own, and the capture checks only its drawing.
# Where the leftmost engine is, which is where the row starts, one block apart towards +x.
ex: number = 0
ey: number = 0
ez: number = 0

# Which capture is next: 0 is the row of progresses and 1 is the row of facings.
capture: number = 0

# Whether the capture's change has been made. A capture needs the scene settled before the change,
# which is _ready, and settled again after it, which is _settled.
changed: bool = false

# The waits before each capture, as coverage_render-Test.grug explains them. See _ready.
settled_ticks: number = 0
remeshed: bool = false
remesh_ticks: number = 0

export tick(ctx: TestTickContext) {
    if ctx.current_tick() == 0 {
        _setup()
        ctx.not_done()
        return
    }

    # redstone_engine-Test.grug, which runs before this, leaves its torch lit to the end, and the red
    # particles that torch gave off live for up to 40 ticks after it is cleared away. One of them in
    # the crop is a few pixels that are never in the same place twice, so wait out the longest life
    # with some to spare. The world has no way to say how many particles are left.
    if ctx.current_tick() < 60 {
        ctx.not_done()
        return
    }

    # The scene is settled and meshed once, with every engine at rest and facing up, before anything
    # changes. _force_remesh builds the whole section again from whatever the engines then say, so a
    # change made before it would be drawn by it whether or not the engine asked for a redraw. After
    # the change only a settle is waited for: on the port only the engine's own redraw can put the
    # change on screen, and on the reference RenderEngine draws the loaded engine on the next frame.
    if not changed {
        if not _ready(ctx) {
            ctx.not_done()
            return
        }
        if capture == 0 {
            _show_progresses(ctx)
        } else {
            _show_facings(ctx)
        }
        changed = true
        settled_ticks = 0
        ctx.not_done()
        return
    }

    if not _settled() {
        ctx.not_done()
        return
    }

    if capture == 0 {
        Test.screenshot().equals(r"screenshots/redstone_engine_progress", 400, 100, 880, 230)
        capture = 1
        changed = false
        ctx.not_done()
        return
    }

    Test.screenshot().equals(r"screenshots/redstone_engine_stroke_facings", 400, 100, 880, 230)
}

local _setup() {
    level: Level = Test.get_client_level()

    Test.set_box_radius(10)

    origin: Vec3 = Test.get_origin()
    ex = origin.x() - 3
    ey = origin.y() + 0.12
    ez = origin.z() + 8

    _wall(level, origin.x() - 8, origin.y() - 9, origin.z() + 10)

    i: number = 0
    while i < 6 {
        _place_engine(level, ex + i, ey, ez)
        i = i + 1
    }
}

# Seventeen blocks square of stone two blocks behind the engines, as in coverage_render-Test.grug.
local _wall(level: Level, x0: number, y0: number, z: number) {
    wy: number = y0
    while wy < y0 + 17 {
        wx: number = x0
        while wx < x0 + 17 {
            level.place_block(wx, wy, z, "minecraft:stone")
            wx = wx + 1
        }
        wy = wy + 1
    }
}

# Faces every engine up, with the progress for its place in the row. The port's engine is drawn again
# by its own tick, which is what a stroke does every tick; the reference's is loaded from its NBT. The facing is given directly, as
# redstone_engine_facings-Test.grug does, rather than by a receptor next to the engine.
local _show_progresses(ctx: TestTickContext) {
    i: number = 0
    while i < 6 {
        engine: BlockEntity = _engine(ctx, i)
        if Test.is_reference() {
            Test.set_nbt_number(engine, "orientation", "int", 1)
            Test.set_nbt_number(engine, "progress", "float", _progress(i))
            Test.load_nbt(engine)
        } else {
            engine.set_saved_number("orientation", 1)
            engine.set_saved_number("oriented", 1)
            engine.set_saved_number("progress", _progress(i))
            Test.tick_block_entity(engine, 1)
        }
        i = i + 1
    }
}

local _progress(i: number) number {
    if i == 0 {
        return 0.1
    }
    if i == 1 {
        return 0.25
    }
    if i == 2 {
        return 0.4
    }
    if i == 3 {
        return 0.5
    }
    if i == 4 {
        return 0.75
    }
    return 0.9
}

# The engine i blocks along the row.
local _engine(ctx: TestTickContext, i: number) BlockEntity {
    level: Level = Test.get_client_level()
    engine_opt: Option[BlockEntity] = level.get_block_entity(ex + i, ey, ez)
    ctx.assert(engine_opt.has(), "The redstone engine should have a block entity.")
    return engine_opt.unwrap()
}

# Turns the engine in each place to the facing of the same number, all at their farthest. The
# facing changes the drawing without the progress changing, so it is drawn again directly.
local _show_facings(ctx: TestTickContext) {
    i: number = 0
    while i < 6 {
        engine: BlockEntity = _engine(ctx, i)
        if Test.is_reference() {
            Test.set_nbt_number(engine, "orientation", "int", i)
            Test.set_nbt_number(engine, "progress", "float", 0.5)
            Test.load_nbt(engine)
        } else {
            engine.set_saved_number("orientation", i)
            engine.set_saved_number("progress", 0.5)
            engine.redraw()
        }
        i = i + 1
    }
}

# Whether the frame is ready for a capture: the same waits as coverage_render-Test.grug, for the
# light to settle, for the section to be meshed again from it, and for that mesh to be drawn.
local _ready(ctx: TestTickContext) bool {
    if not Test.world_settled() {
        settled_ticks = 0
        return false
    }
    if settled_ticks < 5 {
        settled_ticks = settled_ticks + 1
        return false
    }
    if not remeshed {
        _force_remesh(ctx)
        remeshed = true
        return false
    }
    if remesh_ticks < 5 {
        remesh_ticks = remesh_ticks + 1
        return false
    }
    return Test.world_settled()
}

# Whether the frame is settled for a capture after a change, without meshing anything again: on the
# port the change has to reach the screen through the engine's own redraw. Five settled ticks in a row, as in
# _ready, then the frame itself.
local _settled() bool {
    if not Test.world_settled() {
        settled_ticks = 0
        return false
    }
    if settled_ticks < 5 {
        settled_ticks = settled_ticks + 1
        return false
    }
    return true
}

# Dirties the wall's sections by swapping one of its blocks outside the crop and putting it back, so
# the capture's mesh is built from the settled light. See coverage_render-Test.grug.
local _force_remesh(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y()
    z: number = origin.z()
    level.place_block(x - 6, y + 3, z + 10, "minecraft:dirt")
    level.place_block(x - 6, y + 3, z + 10, "minecraft:stone")
    ctx.assert(level.get_block(x - 6, y + 3, z + 10) == "minecraft:stone", "The remesh swap should have put the wall block back.")
}

# Places the engine as a player does, because the reference's BlockEngine.c, which faces a new
# engine up and looks for a receptor to face, is only called for a player's placement. The port does
# the same on its first tick, so placing its block is enough. The reference's engine is placed by
# right-clicking the top of a block under it with the engine held, and that block is cleared again
# so both scenes hold the same blocks. See redstone_engine-Test.grug.
local _place_engine(level: Level, x: number, y: number, z: number) {
    if not Test.is_reference() {
        level.place_block(x, y, z, "grug:redstone_engine")
        return
    }
    level.place_block(x, y - 1, z, "minecraft:stone")
    player: Player = Test.get_player()
    held: Item = item(resource_location("buildcraft:engineWood"))
    Test.set_held_item(player, held)
    Test.use_block(level, x, y - 1, z)
    Test.clear_held_item(player)
    level.place_block(x, y - 1, z, "minecraft:air")
}
