# A powered pipe beside an autocrafting table has to take the table's crafting result rather than
# the wheat in its recipe grid. The table answers the pipe through its extract_item export, so this
# is what proves the answer reaches the pipe: without it the pipe would drain the grid into the chest
# one wheat per tick instead of moving a single crafted bread.
# Each slot of the grid holds two wheat, and exactly one bread moves: a pipe's take leaves one item in
# every slot, as the reference's extractItem(doRemove, false) does with itemsToLeave 1, and borrows the
# item from a neighbouring chest when a slot has only one, which the chest here cannot give. With one
# wheat per slot the pipe could take nothing, and a pipe that took the last wheat too would move a
# second bread (#602).
# #1205: the a1.1.2_01 dedicated leg once failed the dropped-item check right after the server
# logged `Can't keep up`, and a rerun passed. A check that only runs at the end cannot say when the
# bread left the pipe, so every runner tick counts the bread at the fixture and fails on the first
# one, naming that tick, the round and what each container held at it. Nothing is printed on a
# passing tick. That leg also repeats the delivery a hundred times, so a red that needs an overloaded
# tick has a hundred chances per run instead of one; every other leg checks once at the timing its
# captures were taken with (#262).
pipe_table_table: Option[BlockEntity] = Option.new()
pipe_table_chest: Option[BlockEntity] = Option.new()
pipe_table_pipe: Option[BlockEntity] = Option.new()

# The level and the bread as host entities, fetched once: the sample asks for both on every tick of
# every round, and each fetch would otherwise make a host entity that lives until the test ends.
test_level: Option[Level] = Option.new()
bread_item: Option[Item] = Option.new()

# The fixture's block positions, so the sample can count the bread and a reset can look the three
# block entities up again by position rather than by the handles _setup took.
base_x: number = 0
base_y: number = 0
base_z: number = 0

# The pass being repeated, 0 for the first, and the tick it began at. A failure names both, so the
# log says whether the red came from the fresh fixture or from a later pass.
round: number = 0
round_started: number = 0

# How many times the a1 dedicated leg repeats the delivery. A pass is a handful of ticks, so the
# hundred cost a few hundred of the budget of 2000, against one chance at the red before.
rounds: number = 100

# How many item entities the fixture itself leaves at the pipe: the stray diamond spawned in
# _setup_pipe. The first pass's end check asserts it is still there beside no dropped bread.
stray_entities: number = 1

# The tick the pipe was placed on, or -1 before that. The wait after it is for what the pipe does
# with the result rather than for a tick count, and it also keeps the old floor of 25 ticks, which is
# where the suite's timing, and so the coverage_render references, were captured (#262).
pipe_placed_at: number = -1

# The tick the chest first held the bread, or -1 before that. The check runs two ticks after the
# arrival, which is the timing the suite's captures were taken with (#262); it no longer waits for
# an item entity to be swept, because the bread travels as a recorded item and never as one (#1692).
pipe_bread_at: number = -1

# #1205: the a1 dedicated leg repeats the delivery, so the budget covers the hundred passes there.
# On that leg a pass takes about 160 world ticks, since the engine has to power the pipe again after
# every extraction, so the hundred are about 16000 of the 40000 tick calls that 4000 allows at the
# 10x speed CI runs at. Every other leg runs one pass at the timing it had before, which is where its
# captures were taken.
export init(ctx: TestInitContext) {
    ctx.set_max_ticks(4000)
}

export tick(ctx: TestTickContext) {
    if ctx.current_tick() == 0 {
        _setup_table(ctx)
        ctx.not_done()
        return
    }
    if pipe_placed_at < 0 {
        _check_rule(ctx)
        _setup_pipe(ctx)
        pipe_placed_at = ctx.current_tick()
        round_started = pipe_placed_at
        ctx.not_done()
        return
    }
    _sample(ctx)
    _check_round(ctx)
    if not _bread_has_moved() {
        ctx.not_done()
        return
    }
    if pipe_bread_at < 0 {
        # The chest first holds the bread on this tick, so record the arrival and check two ticks
        # later, which is where the captures were taken (#262).
        pipe_bread_at = ctx.current_tick()
        ctx.not_done()
        return
    }
    if _floor_waits(ctx) {
        ctx.not_done()
        return
    }
    # #1205: only the first pass can check the fixture's own stray diamond, since Alpha's 6000-tick
    # item despawn removes it long before the a1 leg's hundred rounds end. The repeat rounds assert
    # what the pipe and the table hold, which a pass that lost or duplicated an item cannot satisfy.
    if round == 0 {
        _check(ctx)
    } else {
        _check_containers(ctx)
    }
    if _repeats() and round + 1 < rounds {
        _reset(ctx)
        ctx.not_done()
        return
    }
}

# #1205: whether this leg repeats the delivery. The red has come from the a1 dedicated server, the
# one leg where an item's pickup is live, so the repeat is spent there and not on five other legs
# whose captures a longer test would only disturb.
local _repeats() bool {
    return me.on_dedicated_server() and me.loader_name() == "a1.1.2_01-ornithe"
}

# #262: the first pass keeps the old floor of 25 ticks and the two ticks after the arrival, which is
# where the suite's timing, and so the coverage_render references, were captured. The repeats run on
# the a1 dedicated leg, which captures nothing, so they keep only the two ticks after the arrival: a
# dropped bread persists, so the check still fails on it.
local _floor_waits(ctx: TestTickContext) bool {
    if ctx.current_tick() < pipe_bread_at + 2 {
        return true
    }
    return round == 0 and ctx.current_tick() < pipe_placed_at + 25
}

# #1205: a pass that never delivers is not the red this test reports, so it names itself instead of
# ending at the budget with no explanation. A pass takes about 160 ticks on the a1 leg; 1200 bounds a
# stalled one without waiting the whole 4000, and no leg that runs one pass reaches it.
local _check_round(ctx: TestTickContext) {
    if not _repeats() {
        return
    }
    ticks: number = ctx.current_tick() - round_started
    if ticks >= 1200 {
        print2("A pass did not deliver the bread within 1200 ticks: round", round)
        print2("runner tick", ctx.current_tick())
        print2("ticks into the pass", ticks)
        ctx.assert(false, "A pass did not deliver the bread within 1200 ticks.")
    }
}

# #1205: the tick the bread leaves the pipe is what a red has to name, so this runs on every runner
# tick rather than at the check alone. It asks for the bread alone: a count of every item entity is
# not the pipe's, since a run on 2026-11-25 saw a second non-bread entity with the table's grid
# untouched and every container as a pass leaves it, which #1692 already warned not to read as a
# drop. A passing tick prints nothing.
local _sample(ctx: TestTickContext) {
    level: Level = test_level.unwrap()
    bread: number = level.count_item_entities_of(base_x, base_y, base_z, 5, bread_item.unwrap())
    if bread == 0 {
        return
    }
    all: number = level.count_item_entities(base_x, base_y, base_z, 5)
    _report(ctx, all, bread)
    ctx.assert(false, "The pipe should not have dropped the bread.")
}

# #1205: a dropped item names the tick and where every item stood in it, because the failing run's
# log is the only evidence there is from the leg that fails. The pipe's travelling records are
# printed too, since a recorded bread is the state it is in before a push, and the table's grid, so
# a pipe that took a second result rather than the chest refusing the first is visible.
local _report(ctx: TestTickContext, all: number, bread: number) {
    level: Level = test_level.unwrap()
    chest: BlockEntity = pipe_table_chest.unwrap()
    pipe: BlockEntity = pipe_table_pipe.unwrap()
    table: BlockEntity = pipe_table_table.unwrap()
    # #1205: the count of every entity is not the pipe's (#1692), so a run that reports one prints
    # what it could be made of, which names a fixture item, a wheat the table handed over, or a
    # second bread, without another run.
    diamond: Item = item(resource_location("minecraft:diamond"))
    wheat_item: Item = item(resource_location("minecraft:wheat"))
    diamonds: number = level.count_item_entities_of(base_x, base_y, base_z, 5, diamond)
    wheat: number = level.count_item_entities_of(base_x, base_y, base_z, 5, wheat_item)
    print2("Item entities at the fixture: count", all)
    print2("of which bread", bread)
    print2("of which diamond", diamonds)
    print2("of which wheat", wheat)
    print2("the stray entities the fixture started with", stray_entities)
    print2("round", round)
    print2("runner tick", ctx.current_tick())
    print2("ticks since the round began", ctx.current_tick() - round_started)
    print2("ticks since the pipe was placed", ctx.current_tick() - pipe_placed_at)
    since_bread: number = -1
    if pipe_bread_at >= 0 {
        since_bread = ctx.current_tick() - pipe_bread_at
    }
    print2("ticks since the chest first held the bread", since_bread)
    print2("chest slot 0 count", chest.get_item_count_in_slot(0))
    print2("chest slot 0 is bread", _slot_is_bread(chest, 0))
    print2("pipe slot 0 count", pipe.get_item_count_in_slot(0))
    print2("pipe slot 0 is bread", _slot_is_bread(pipe, 0))
    print2("pipe travelling records", pipe.get_saved_list_size("traveling"))
    print2("table wheat in grid slot 0", table.get_item_count_in_slot(0))
    print2("table wheat in grid slot 1", table.get_item_count_in_slot(1))
    print2("table wheat in grid slot 2", table.get_item_count_in_slot(2))
    result: number = 0
    if table.get_crafting_result_item().has() {
        result = 1
    }
    print2("table has a crafting result", result)
}

local _slot_is_bread(block: BlockEntity, slot: number) number {
    held: Option[Item] = block.get_item_in_slot(slot)
    if held.has() and equals(held.unwrap(), bread_item.unwrap()) {
        return 1
    }
    return 0
}

# #1205: starts the next pass from the state the first one began in. The chest and the pipe are
# emptied and the table's grid is refilled and crafted again, so the next delivery starts clean. The
# three handles are looked up again first, since a chunk loaded again inside a pass would make new
# objects, and clearing the pipe's records is what breaking it would do without dropping anything.
local _reset(ctx: TestTickContext) {
    _refetch()
    _clear_chest(pipe_table_chest.unwrap())
    _clear_pipe(pipe_table_pipe.unwrap())
    _fill_grid(pipe_table_table.unwrap())
    pipe_bread_at = -1
    round = round + 1
    round_started = ctx.current_tick()
}

local _refetch() {
    level: Level = test_level.unwrap()
    table_opt: Option[BlockEntity] = level.get_block_entity(base_x - 1, base_y, base_z)
    if table_opt.has() {
        pipe_table_table.set(table_opt.unwrap())
    }
    pipe_opt: Option[BlockEntity] = level.get_block_entity(base_x, base_y, base_z)
    if pipe_opt.has() {
        pipe_table_pipe.set(pipe_opt.unwrap())
    }
    chest_opt: Option[BlockEntity] = level.get_block_entity(base_x + 1, base_y, base_z)
    if chest_opt.has() {
        pipe_table_chest.set(chest_opt.unwrap())
    }
}

local _clear_chest(chest: BlockEntity) {
    slot: number = 0
    size: number = chest.get_inventory_size()
    while slot < size {
        chest.set_item_count_in_slot(slot, 0)
        slot = slot + 1
    }
}

local _clear_pipe(pipe: BlockEntity) {
    while pipe.get_saved_list_size("traveling") > 0 {
        pipe.remove_saved_list_record("traveling", 0)
    }
    pipe.set_item_count_in_slot(0, 0)
}

local _fill_grid(table: BlockEntity) {
    wheat: Item = item(resource_location("minecraft:wheat"))
    slot: number = 0
    while slot < 3 {
        table.set_item_in_slot(slot, wheat, 2)
        slot = slot + 1
    }
    table.update_recipe_output(0)
}

# Three wheat in the top row craft one bread, and two of each leave one wheat in each slot behind.
# Wheat and bread are items rather than blocks on every loader, so the recipe's result can be named
# and compared, unlike a grid of diamonds, whose 3x3 recipe is the diamond block.
local _setup_table(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    test_level.set(level)
    bread_item.set(item(resource_location("minecraft:bread")))
    origin: Vec3 = ctx.get_origin()
    x: number = origin.x() + 12
    # Band 5, below the bands the pipe tests use, and the x offset keeps this clear of the origin.
    y: number = origin.y() + 5
    z: number = origin.z()
    base_x = x
    base_y = y
    base_z = z

    level.place_block(x - 1, y, z, "grug:autocrafting_table")
    table_opt: Option[BlockEntity] = level.get_block_entity(x - 1, y, z)
    ctx.assert(table_opt.has(), "The autocrafting table should have a block entity.")
    table: BlockEntity = table_opt.unwrap()
    pipe_table_table.set(table)

    wheat: Item = item(resource_location("minecraft:wheat"))
    slot: number = 0
    while slot < 3 {
        table.set_item_in_slot(slot, wheat, 2)
        slot = slot + 1
    }
    table.update_recipe_output(0)

    result_opt: Option[Item] = table.get_crafting_result_item()
    ctx.assert(result_opt.has(), "The three wheat should have crafted a result.")
    ctx.assert(equals(result_opt.unwrap(), item(resource_location("minecraft:bread"))), "The result should be a bread.")
    ctx.assert(table.get_crafting_result_damage() == 0, "A crafted bread should be undamaged.")
}

# The table's own answers, which are what the pipe has to go by: it offers its crafting result, one
# bread, from any side, and it takes only an item that its grid already holds. Asking is a dry run, so
# none of it moves anything.
local _check_rule(ctx: TestTickContext) {
    table: BlockEntity = pipe_table_table.unwrap()
    wheat: Item = item(resource_location("minecraft:wheat"))
    diamond: Item = item(resource_location("minecraft:diamond"))

    ctx.assert(table.get_inventory_size() == 9, "The table should have a nine-slot grid.")
    ctx.assert(table.ask_extract_item(0) == 1, "A pipe below the table should be offered the one bread.")
    ctx.assert(table.ask_extract_item(5) == 1, "A pipe on any side should be offered the one bread.")
    ctx.assert(table.get_crafting_result_item().has(), "Asking must not take the result.")
    ctx.assert(table.add_item(wheat, 0, 1, 1, false) == 1, "The table should take a wheat its grid already holds.")
    ctx.assert(table.add_item(diamond, 0, 1, 1, false) == 0, "The table should refuse an item its grid does not hold.")
    ctx.assert(table.get_item_count_in_slot(0) == 2, "Asking must not put anything in.")
}

# The table sits to the pipe's west and the chest to its east, so the side scan reaches the table
# before the chest and the pipe pulls from the table rather than the other way round. The engine is
# below the pipe, where a torch powers it.
local _setup_pipe(ctx: TestTickContext) {
    level: Level = test_level.unwrap()
    x: number = base_x
    y: number = base_y
    z: number = base_z

    level.place_block(x, y, z, "grug:wooden_pipe")
    level.place_block(x + 1, y, z, "minecraft:chest")
    level.place_block(x, y - 3, z, "minecraft:stone")
    level.place_block(x, y - 2, z, "minecraft:redstone_torch")
    level.place_block(x, y - 1, z, "grug:redstone_engine")

    chest_opt: Option[BlockEntity] = level.get_block_entity(x + 1, y, z)
    pipe_opt: Option[BlockEntity] = level.get_block_entity(x, y, z)
    ctx.assert(chest_opt.has(), "The chest should have a block entity.")
    ctx.assert(pipe_opt.has(), "The pipe should have a block entity.")
    ctx.assert(level.has_neighbor_signal(x, y - 1, z), "The engine should be powered by the torch.")
    # The engine does not make the game report a signal at the pipe: BlockEngine.b() is false, so the
    # engine is not a normal cube, and the game asks a non-cube neighbour for its own power instead of
    # treating it as a conductor, which BlockEngine does not provide. The engine powers the pipe
    # through the energy framework, and the bread arriving at the chest is what proves it.

    pipe_table_chest.set(chest_opt.unwrap())
    pipe_table_pipe.set(pipe_opt.unwrap())

    # An item entity of something the pipe never carries, resting on the chest: the regression
    # fixture for #1692. The dropped-item check counted every item entity in reach, so a stray one
    # failed a pipe that had delivered the bread; _check asks for the bread alone and asserts this
    # one is still there, so the test proves the difference rather than assuming it.
    stray_stack: ItemStack = item_stack(item(resource_location("minecraft:diamond")), 0, 1)
    stray: ItemEntity = item_entity(level, x + 1.5, y + 1, z + 0.5, stray_stack)
    stray.entity().set_delta_movement(Vec3.zero())
    stray.entity().spawn(level)
}

local _check(ctx: TestTickContext) {
    _check_containers(ctx)
    level: Level = test_level.unwrap()
    # The stray diamond is checked only on the first pass, which is the only one young enough that
    # Alpha's 6000-tick item despawn cannot have removed it (#1205).
    all: number = level.count_item_entities(base_x, base_y, base_z, 5)
    dropped: number = level.count_item_entities_of(base_x, base_y, base_z, 5, bread_item.unwrap())
    ctx.assert(all >= 1, "The stray item entity should still be in reach.")
    if all != stray_entities {
        _report(ctx, all, dropped)
    }
    ctx.assert(all == stray_entities, "The pipe should not have dropped an item.")
}

local _check_containers(ctx: TestTickContext) {
    level: Level = test_level.unwrap()
    x: number = base_x
    y: number = base_y
    z: number = base_z

    chest: BlockEntity = pipe_table_chest.unwrap()
    table: BlockEntity = pipe_table_table.unwrap()
    pipe: BlockEntity = pipe_table_pipe.unwrap()

    # One bread, not three wheat. A pipe reading the grid instead of the result would take a wheat
    # per tick until the grid ran dry, so both the count and the item are what separate the two.
    ctx.assert(chest.get_item_count_in_slot(0) == 1, "The chest should hold exactly 1 bread.")
    chest_item: Option[Item] = chest.get_item_in_slot(0)
    ctx.assert(chest_item.has(), "The chest's slot 0 should hold an item.")
    ctx.assert(equals(chest_item.unwrap(), item(resource_location("minecraft:bread"))), "The chest should hold the crafted bread, not a wheat.")

    ctx.assert(pipe.get_item_count_in_slot(0) == 0, "The pipe should not still be holding the bread.")
    # The bread was paid for with one wheat from each slot of the recipe, and the last wheat stays: the
    # result is still crafted, but the pipe may not take it, because the chest has no wheat to lend.
    ctx.assert(table.get_crafting_result_item().has(), "The table should still craft a bread from the wheat left.")
    slot: number = 0
    while slot < 9 {
        # (A call's arguments have to stay on one line in grug, hence the local.)
        count: number = table.get_item_count_in_slot(slot)
        expected: number = 0
        if slot < 3 {
            expected = 1
        }
        ctx.assert(count == expected, "The pipe should have taken one wheat from each recipe slot and left the last.")
        slot = slot + 1
    }

    # Nothing was dropped on the way: the chest took it, and an item entity of the bread here would
    # mean the pipe gave up on the push. The count asks for the bread alone, so the stray diamond on
    # the chest, or any other item entity in reach, is not read as this pipe's drop (#1692). The
    # per-tick sample above catches this first on every leg that runs it; this check keeps the
    # assertion for a drop that appears before the sample's first tick (#1205).
    all: number = level.count_item_entities(x, y, z, 5)
    dropped: number = level.count_item_entities_of(x, y, z, 5, bread_item.unwrap())
    if dropped > 0 {
        _report(ctx, all, dropped)
    }
    ctx.assert(dropped == 0, "The pipe should not have dropped the bread.")
}

# The pipe moving the crafted bread into the chest is what this test observes, and the game's own tick
# is the only clock that moves it. Waiting for the chest rather than for the table's result slot is
# deliberate: the bug this test exists for is a pipe that drains the recipe grid, and that pipe would
# leave the result slot filled forever, turning the failure into a wait that never converges instead
# of the item assertion that names the wheat. See #173.
local _bread_has_moved() bool {
    return pipe_table_chest.unwrap().get_item_count_in_slot(0) > 0
}
