# A powered pipe beside an autocrafting table has to take the table's crafting result rather than
# the wheat in its recipe grid. The table answers the pipe through its extract_item export, so this
# is what proves the answer reaches the pipe: without it the pipe would drain the grid into the chest
# one wheat per tick instead of moving a single crafted bread.
# Each slot of the grid holds two wheat, and exactly one bread moves: a pipe's take leaves one item in
# every slot, as the reference's extractItem(doRemove, false) does with itemsToLeave 1, and borrows the
# item from a neighbouring chest when a slot has only one, which the chest here cannot give. With one
# wheat per slot the pipe could take nothing, and a pipe that took the last wheat too would move a
# second bread (#602).
pipe_table_table: Option[BlockEntity] = Option.new()
pipe_table_chest: Option[BlockEntity] = Option.new()
pipe_table_pipe: Option[BlockEntity] = Option.new()

# The tick the pipe was placed on, or -1 before that. The wait after it is for what the pipe does
# with the result rather than for a tick count, and it also keeps the old floor of 25 ticks, which is
# where the suite's timing, and so the coverage_render references, were captured (#262).
pipe_placed_at: number = -1

# The tick the chest first held the bread, or -1 before that. The item entity that carried the
# bread is swept from the world a tick or two after the chest takes it, so the check runs two ticks
# after the arrival, with the sweep already done (#272). A genuinely dropped item persists, so it is
# still there on the delayed check and the dropped-item assertion still fails on it.
pipe_bread_at: number = -1

export tick(ctx: TestTickContext) {
    if ctx.current_tick() == 0 {
        _setup_table(ctx)
        ctx.not_done()
    } else if pipe_placed_at < 0 {
        _check_rule(ctx)
        _setup_pipe(ctx)
        pipe_placed_at = ctx.current_tick()
        ctx.not_done()
    } else if not _bread_has_moved() {
        ctx.not_done()
    } else if pipe_bread_at < 0 {
        # The chest first holds the bread on this tick, and the item entity that carried it through
        # the pipe is still in the world until the sweep that follows (#272), so record the arrival
        # and let it happen before the check.
        pipe_bread_at = ctx.current_tick()
        ctx.not_done()
    } else if ctx.current_tick() < pipe_placed_at + 25 or ctx.current_tick() < pipe_bread_at + 2 {
        # Same floor as wooden_pipe-Test.grug, for the same reason (#262). The two ticks after the
        # arrival are for that sweep: the carrying entity is gone by then, while a genuinely
        # dropped item persists and the dropped-item assertion still fails on it (#272).
        ctx.not_done()
    } else {
        _check(ctx)
    }
}

# Three wheat in the top row craft one bread, and two of each leave one wheat in each slot behind.
# Wheat and bread are items rather than blocks on every loader, so the recipe's result can be named
# and compared, unlike a grid of diamonds, whose 3x3 recipe is the diamond block.
local _setup_table(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x() + 12
    # Band 5, below the bands the pipe tests use, and the x offset keeps this clear of the origin.
    y: number = origin.y() + 5
    z: number = origin.z()

    level.place_block(x - 1, y, z, "grug:autocrafting_table")
    table_opt: Option[BlockEntity] = level.get_block_entity(x - 1, y, z)
    ctx.assert(table_opt.has(), "The autocrafting table should have a block entity.")
    table: BlockEntity = table_opt.unwrap()
    pipe_table_table.set(table)

    wheat: Item = item(resource_location("minecraft:wheat"))
    slot: number = 0
    while slot < 3 {
        table.set_item_in_slot(slot, wheat, 2)
        slot = slot + 1
    }
    table.update_recipe_output(0)

    result_opt: Option[Item] = table.get_crafting_result_item()
    ctx.assert(result_opt.has(), "The three wheat should have crafted a result.")
    if result_opt.has() {
        ctx.assert(equals(result_opt.unwrap(), item(resource_location("minecraft:bread"))), "The result should be a bread.")
    }
    ctx.assert(table.get_crafting_result_damage() == 0, "A crafted bread should be undamaged.")
}

# The table's own answers, which are what the pipe has to go by: it offers its crafting result, one
# bread, from any side, and it takes only an item that its grid already holds. Asking is a dry run, so
# none of it moves anything.
local _check_rule(ctx: TestTickContext) {
    table: BlockEntity = pipe_table_table.unwrap()
    wheat: Item = item(resource_location("minecraft:wheat"))
    diamond: Item = item(resource_location("minecraft:diamond"))

    ctx.assert(table.get_inventory_size() == 9, "The table should have a nine-slot grid.")
    ctx.assert(table.ask_extract_item(0) == 1, "A pipe below the table should be offered the one bread.")
    ctx.assert(table.ask_extract_item(5) == 1, "A pipe on any side should be offered the one bread.")
    ctx.assert(table.get_crafting_result_item().has(), "Asking must not take the result.")
    ctx.assert(table.add_item(wheat, 0, 1, 1, false) == 1, "The table should take a wheat its grid already holds.")
    ctx.assert(table.add_item(diamond, 0, 1, 1, false) == 0, "The table should refuse an item its grid does not hold.")
    ctx.assert(table.get_item_count_in_slot(0) == 2, "Asking must not put anything in.")
}

# The table sits to the pipe's west and the chest to its east, so the side scan reaches the table
# before the chest and the pipe pulls from the table rather than the other way round. The engine is
# below the pipe, where a torch powers it.
local _setup_pipe(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x() + 12
    y: number = origin.y() + 5
    z: number = origin.z()

    level.place_block(x, y, z, "grug:wooden_pipe")
    level.place_block(x + 1, y, z, "minecraft:chest")
    level.place_block(x, y - 3, z, "minecraft:stone")
    level.place_block(x, y - 2, z, "minecraft:redstone_torch")
    level.place_block(x, y - 1, z, "grug:redstone_engine")

    chest_opt: Option[BlockEntity] = level.get_block_entity(x + 1, y, z)
    pipe_opt: Option[BlockEntity] = level.get_block_entity(x, y, z)
    ctx.assert(chest_opt.has(), "The chest should have a block entity.")
    ctx.assert(pipe_opt.has(), "The pipe should have a block entity.")
    ctx.assert(level.has_neighbor_signal(x, y - 1, z), "The engine should be powered by the torch.")
    ctx.assert(level.has_neighbor_signal(x, y, z), "The pipe should be powered by the engine.")

    pipe_table_chest.set(chest_opt.unwrap())
    pipe_table_pipe.set(pipe_opt.unwrap())
}

local _check(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x() + 12
    y: number = origin.y() + 5
    z: number = origin.z()

    chest: BlockEntity = pipe_table_chest.unwrap()
    table: BlockEntity = pipe_table_table.unwrap()
    pipe: BlockEntity = pipe_table_pipe.unwrap()

    # One bread, not three wheat. A pipe reading the grid instead of the result would take a wheat
    # per tick until the grid ran dry, so both the count and the item are what separate the two.
    ctx.assert(chest.get_item_count_in_slot(0) == 1, "The chest should hold exactly 1 bread.")
    chest_item: Option[Item] = chest.get_item_in_slot(0)
    ctx.assert(chest_item.has(), "The chest's slot 0 should hold an item.")
    if chest_item.has() {
        ctx.assert(equals(chest_item.unwrap(), item(resource_location("minecraft:bread"))), "The chest should hold the crafted bread, not a wheat.")
    }

    ctx.assert(pipe.get_item_count_in_slot(0) == 0, "The pipe should not still be holding the bread.")
    # The bread was paid for with one wheat from each slot of the recipe, and the last wheat stays: the
    # result is still crafted, but the pipe may not take it, because the chest has no wheat to lend.
    ctx.assert(table.get_crafting_result_item().has(), "The table should still craft a bread from the wheat left.")
    slot: number = 0
    while slot < 9 {
        # (A call's arguments have to stay on one line in grug, hence the local.)
        count: number = table.get_item_count_in_slot(slot)
        expected: number = 0
        if slot < 3 {
            expected = 1
        }
        ctx.assert(count == expected, "The pipe should have taken one wheat from each recipe slot and left the last.")
        slot = slot + 1
    }

    # Nothing was dropped on the way: the chest took it, and an item entity here would mean the pipe
    # gave up on the push.
    ctx.assert(level.count_item_entities(x, y, z, 5) == 0, "The pipe should not have dropped anything.")
}

# The pipe moving the crafted bread into the chest is what this test observes, and the game's own tick
# is the only clock that moves it. Waiting for the chest rather than for the table's result slot is
# deliberate: the bug this test exists for is a pipe that drains the recipe grid, and that pipe would
# leave the result slot filled forever, turning the failure into a wait that never converges instead
# of the item assertion that names the wheat. See #173.
local _bread_has_moved() bool {
    return pipe_table_chest.unwrap().get_item_count_in_slot(0) > 0
}
