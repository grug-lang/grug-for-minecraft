# The diamond pipe's recipe has to craft eight pipes from diamond, glass and diamond, as
# BuildCraftTransport.createPipe registers it (yr.n, pb.M, yr.n), since a pipe has no other source in
# survival. It is asked of a crafting grid, as golden_pipe_recipe does, and the loaders that register no
# mod recipes skip it.
# Band 11, clear of the bands the other recipe tests use: they never run together.
export tick(ctx: TestTickContext) {
    # A loader that registers no mod recipe answers the grid with nothing, so the loader is asked
    # rather than assumed.
    if not me.registers_mod_recipes() {
        return
    }

    level: Level = ctx.get_client_level()
    origin: Vec3 = ctx.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 11
    z: number = origin.z()

    diamond: Item = item(resource_location("minecraft:diamond"))
    glass: Item = item(resource_location("minecraft:glass"))
    pipe: Item = item(resource_location("grug:diamond_pipe"))

    grid: BlockEntity = _grid(ctx, level, x, y, z)
    # The recipe's only occupied row is the grid's middle one, which is slots 3, 4 and 5.
    grid.set_item_in_slot(3, diamond, 1)
    grid.set_item_in_slot(4, glass, 1)
    grid.set_item_in_slot(5, diamond, 1)
    grid.update_recipe_output(0)

    result: Option[Item] = grid.get_crafting_result_item()
    ctx.assert(result.has(), "Diamond, glass and diamond should craft a diamond pipe.")
    ctx.assert(equals(result.unwrap(), pipe), "The diamond pipe's recipe should answer a diamond pipe.")
    ctx.assert(grid.take_crafting_result(8) == 8, "The diamond pipe's recipe should give eight pipes.")
}

# The coverage block's block entity has the nine slots a crafting grid reads, which is why this is the
# block to place rather than a chest or the autocrafting table.
local _grid(ctx: TestTickContext, level: Level, x: number, y: number, z: number) BlockEntity {
    level.place_block(x, y, z, "grug:coverage_block")
    found: Option[BlockEntity] = level.get_block_entity(x, y, z)
    ctx.assert(found.has(), "The coverage block should have a block entity after being placed.")
    return found.unwrap()
}
