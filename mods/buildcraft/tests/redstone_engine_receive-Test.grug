# Covers a redstone engine receiving energy from the engines that face it, as TileEngine.doWork and
# Engine.addEnergy do in BuildCraft 2.2.14. A stroke hands the engine it faces 1 energy. The
# receiving engine's provider turns what it holds into energy once on its tick, as
# (int)((float) held * 0.95F), so one stroke adds 0 and the energy is lost, two strokes that
# arrive before the engine's tick add 1 and three add 2. The energy is cut to 1000, which the
# reference does after exploding when the cut is needed. A pane of glass north of the receiver shows
# whether it exploded: the explosion is at the engine's north-west-bottom corner, which the glass
# touches, and glass is weak enough for the explosion to break and drops no item entity. Two feeders
# are placed west and east of the receiver, so the north side is free.

# Only the engines are ticked, with Test.tick_block_entity, and everything happens inside one run()
# call, so the game's own tick cannot run an engine in between. Test.tick_block_entity leaves the
# clock alone, so the time Level.get_time reads stays where the test found it. The test waits for a
# time 5 to 15 ticks past a multiple of 20, so no tick it gives lands on one, even if the integrated
# server thread advances a few ticks during the call, and a powered engine gains nothing of its own
# while it is ticked. The energy the test expects therefore changes only by strokes.
export run() {
    level: Level = Test.get_client_level()

    # Waits for a time 5 to 15 ticks past a multiple of 20. See the header.
    phase: number = Math.remainder(level.get_time(), 20)
    if phase < 5 or phase > 15 {
        Test.not_done()
        return
    }

    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 15
    z: number = origin.z()

    # One stroke: the receiver gains nothing, and the feeder pays 1 energy for it.
    receiver: BlockEntity = _scenario(level, x, y, z, 1, 100)
    Test.assert(get_saved_number(receiver, "energy") == 100, "One stroke's 1 energy should add 0 to the receiver, as (int)(1 * 0.95F) is 0.")
    Test.assert(get_energy_stored(receiver) == 0, "The receiver should have emptied its store on its tick.")

    # Two strokes that both arrive before the receiver's tick add 1.
    receiver = _scenario(level, x + 4, y, z, 2, 100)
    Test.assert(get_saved_number(receiver, "energy") == 101, "Two strokes should add 1 to the receiver, as (int)(2 * 0.95F) is 1.")
    Test.assert(get_energy_stored(receiver) == 0, "The receiver should have emptied its store on its tick.")

    # Three add 2.
    receiver = _scenario(level, x + 8, y, z, 3, 100)
    Test.assert(get_saved_number(receiver, "energy") == 102, "Three strokes should add 2 to the receiver, as (int)(3 * 0.95F) is 2.")

    # An engine at 1000 is not pushed above it by a stroke that adds nothing, and does not explode.
    level.place_block(x + 12, y, z - 1, "minecraft:glass")
    receiver = _scenario(level, x + 12, y, z, 1, 1000)
    Test.assert(get_saved_number(receiver, "energy") == 1000, "A receiver at 1000 should stay at 1000.")
    Test.assert(not level.is_air(x + 12, y, z - 1), "A receiver at 1000 should not explode when a stroke adds nothing.")
    level.place_block(x + 12, y, z - 1, "minecraft:air")

    # Two strokes add 1 to an engine at 1000, which explodes. The explosion destroys the engine, so
    # there is no energy left to read.
    level.place_block(x - 4, y, z - 1, "minecraft:glass")
    _scenario(level, x - 4, y, z, 2, 1000)
    Test.assert(level.is_air(x - 4, y, z - 1), "A receiver pushed above 1000 should explode.")
}

# Builds a receiver at (x, y, z) holding receiver_energy and the given number of feeders next to it
# (west, east, then north), all facing it, each holding 100 energy and powered. Runs each feeder up
# to its delivery, checks that it paid 1 energy for it and that the receiver's store holds one more,
# then ticks the receiver once and returns it.
local _scenario(level: Level, x: number, y: number, z: number, feeders: number, receiver_energy: number) BlockEntity {
    receiver: BlockEntity = _place_engine(level, x, y, z, true, receiver_energy, 1)

    i: number = 0
    while i < feeders {
        _deliver(receiver, _place_feeder(level, x, y, z, i), i)
        i = i + 1
    }

    Test.tick_block_entity(receiver, 1)
    return receiver
}

# Runs a feeder to its delivery and checks that it paid 1 energy for it and that the receiver's store
# went from the given number of energy to one more. The stroke's start tick adds nothing to the
# progress, so the progress is then set to just under the 0.5 a Blue stroke (100 energy) needs to
# pass, and the next tick, which adds 0.01, delivers. That saves the 50 ticks a whole stroke takes,
# each of which draws the engine again (redstone_engine_stroke-Test.grug runs whole ones).
local _deliver(receiver: BlockEntity, feeder: BlockEntity, stored_before: number) {
    Test.tick_block_entity(feeder, 1)
    set_saved_number(feeder, "progress", 0.495)
    before: number = get_saved_number(feeder, "energy")
    Test.assert(get_energy_stored(receiver) == stored_before, "A feeder should not have handed its energy over before it passes halfway.")
    Test.tick_block_entity(feeder, 1)
    Test.assert(get_saved_number(feeder, "energy") == before - 1, "A feeder should lose exactly 1 energy at its delivery.")
    Test.assert(get_energy_stored(receiver) == stored_before + 1, "The delivery should add 1 to the receiver's store.")
}

# The index-th feeder of the receiver at (x, y, z): index 0 is west of it and faces east, 1 is east
# of it and faces west, and 2 is north of it and faces south. Facing 5 is east, 4 west and 3 south.
local _place_feeder(level: Level, x: number, y: number, z: number, index: number) BlockEntity {
    if index == 0 {
        return _place_engine(level, x - 1, y, z, true, 100, 5)
    }
    if index == 1 {
        return _place_engine(level, x + 1, y, z, true, 100, 4)
    }
    return _place_engine(level, x, y, z - 1, true, 100, 3)
}

# Places an engine holding the given energy and facing, with a redstone torch right under it (stone
# under the torch) when powered, and returns its block entity after checking the signal. A torch
# powers the block above it, but not the block it is attached to. The facing is saved as the engine
# would have picked it on its first tick, so that tick does not look at its neighbours.
local _place_engine(level: Level, x: number, y: number, z: number, powered: bool, energy: number, facing: number) BlockEntity {
    if powered {
        level.place_block(x, y - 2, z, "minecraft:stone")
        level.place_block(x, y - 1, z, "minecraft:redstone_torch")
    }
    level.place_block(x, y, z, "grug:redstone_engine")

    engine_opt: Option[BlockEntity] = level.get_block_entity(x, y, z)
    Test.assert(engine_opt.has(), "The redstone engine should have a block entity.")
    Test.assert(level.has_neighbor_signal(x, y, z) == powered, "The engine's redstone signal should match what the test set up.")
    engine: BlockEntity = engine_opt.unwrap()
    set_saved_number(engine, "energy", energy)
    set_saved_number(engine, "oriented", 1)
    set_saved_number(engine, "orientation", facing)
    return engine
}
