# Covers Engine.addEnergy's explosion after BuildCraft 2.2.14's EngineStone: an engine whose energy is
# pushed above its 10000 maximum explodes with the range 4 that explosionRange() answers, and an
# engine at exactly 10000 is still the red stage, so it does not. A burning tick is the addition that
# pushes it over. The blast is at the block's corner, where the reference passes the tile's integer
# coordinates, and a block ten blocks away is outside even a power 4 blast's reach.
export tick(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    origin: Vec3 = ctx.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 10
    z: number = origin.z()

    level.place_block(x, y - 2, z, "minecraft:stone")
    level.place_block(x, y - 1, z, "minecraft:redstone_torch")
    level.place_block(x, y, z, "grug:steam_engine")
    engine: BlockEntity = level.get_block_entity(x, y, z).unwrap()
    ctx.assert(level.has_neighbor_signal(x, y, z), "The torch under the engine should power it.")

    # At the maximum it is red, not Explosion, so it stands.
    engine.set_saved_number("energy", 10000)
    ctx.tick_block_entity(engine, 1)
    ctx.assert(level.get_block(x, y, z) == "grug:steam_engine", "An engine at exactly 10000 should not explode.")
    ctx.assert(engine.get_saved_number("energy") == 10000, "An engine at exactly 10000 should keep its energy.")

    level.place_block(x + 10, y, z, "minecraft:glass")

    # One burning tick adds 1 energy, which is what takes it over the maximum.
    engine.set_saved_number("burn_time", 1)
    engine.set_saved_number("total_burn_time", 5)
    ctx.tick_block_entity(engine, 1)
    ctx.assert(level.is_air(x, y, z), "An engine pushed above 10000 should explode.")
    ctx.assert(not level.is_air(x + 10, y, z), "The blast should not reach ten blocks away.")
}
