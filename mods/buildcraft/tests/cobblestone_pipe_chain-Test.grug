# Covers the chain chest -> wooden pipe -> cobblestone pipe -> chest. The wooden pipe extracts from
# the first chest (an engine beside it powers it) and hands the item to the cobblestone pipe, which
# carries it on to the second chest. The cobblestone pipe's other neighbour is the wooden pipe the item
# came from, and the reverse of the travel direction is never an exit, so the item cannot go back; the
# test samples both pipes as the world runs and fails if a record ever travels west. Two different
# stacks are sent, and the sum of what the chests and the pipes hold is checked at every sample, so
# an item that is duplicated or lost fails it. The level is advanced inside the test's own tick
# (#780), so no frame timing is involved.
source: Option[BlockEntity] = Option.new()
wooden: Option[BlockEntity] = Option.new()
cobblestone: Option[BlockEntity] = Option.new()
target: Option[BlockEntity] = Option.new()

export tick(ctx: TestTickContext) {
    if ctx.current_tick() == 0 {
        _setup(ctx)
        _advance(ctx)
        ctx.not_done()
    } else if not _done() {
        # A loader that cannot advance its level is carried by the game's own ticks, a frame at a
        # time, and the samples still run.
        _sample(ctx)
        ctx.not_done()
    } else {
        _check(ctx)
    }
}

# #780: the pipes need the world's own ticks, not the runner's, so the test asks the level to run
# them inside this tick, five at a time so that a sample sees every step of the item's travel. A
# loader that cannot advance its level answers 0, and then the wait in tick() carries the test. A
# loader that answers ticks it did not run is not slow but broken: the cap is spent with the chain
# where it started, and the assertion in _check says so.
local _advance(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    advanced: number = 0
    ran: number = 5
    while not _done() and ran > 0 and advanced < 1000 {
        ran = Test.tick_level(level, 5)
        advanced = advanced + ran
        _sample(ctx)
    }
}

local _check(ctx: TestTickContext) {
    _sample(ctx)
    ctx.assert(_in_chest(target.unwrap(), item(resource_location("minecraft:diamond"))) == 3, "The target chest should hold every diamond.")
    ctx.assert(_in_chest(target.unwrap(), item(resource_location("minecraft:iron_ingot"))) == 5, "The target chest should hold every iron ingot.")
    ctx.assert(_in_chest(source.unwrap(), item(resource_location("minecraft:diamond"))) == 0, "No diamond should have gone back to the source chest.")
    ctx.assert(_in_chest(source.unwrap(), item(resource_location("minecraft:iron_ingot"))) == 0, "No iron ingot should have gone back to the source chest.")
}

local _setup(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    # Band 12, clear of the bands the other pipe tests use.
    y: number = origin.y() + 12
    z: number = origin.z()

    level.place_block(x - 1, y, z, "minecraft:chest")
    level.place_block(x, y, z, "grug:wooden_pipe")
    level.place_block(x + 1, y, z, "grug:cobblestone_pipe")
    level.place_block(x + 2, y, z, "minecraft:chest")

    # A torch powers the block above it, so the engine beside the wooden pipe stands on a torch.
    level.place_block(x, y - 2, z + 1, "minecraft:stone")
    level.place_block(x, y - 1, z + 1, "minecraft:redstone_torch")
    level.place_block(x, y, z + 1, "grug:redstone_engine")

    source.set(_entity(ctx, level, x - 1, y, z))
    wooden.set(_entity(ctx, level, x, y, z))
    cobblestone.set(_entity(ctx, level, x + 1, y, z))
    target.set(_entity(ctx, level, x + 2, y, z))
    ctx.assert(level.has_neighbor_signal(x, y, z + 1), "The engine should be powered by the torch.")

    source.unwrap().set_item_in_slot(0, item(resource_location("minecraft:diamond")), 3)
    source.unwrap().set_item_in_slot(1, item(resource_location("minecraft:iron_ingot")), 5)
}

local _entity(ctx: TestTickContext, level: Level, x: number, y: number, z: number) BlockEntity {
    block_entity: Option[BlockEntity] = level.get_block_entity(x, y, z)
    ctx.assert(block_entity.has(), "The fixture should have a block entity.")
    return block_entity.unwrap()
}

# Everything has arrived when the source and both pipes are empty.
local _done() bool {
    return _in_chest_all(source.unwrap()) == 0 and wooden.unwrap().get_saved_list_size("traveling") == 0 and cobblestone.unwrap().get_saved_list_size("traveling") == 0
}

# One sample of the world: nothing travels west, and every item exists exactly once.
local _sample(ctx: TestTickContext) {
    ctx.assert(_west_records(wooden.unwrap()) == 0, "The wooden pipe should never hold an item travelling west.")
    ctx.assert(_west_records(cobblestone.unwrap()) == 0, "The cobblestone pipe should never hold an item travelling west.")
    ctx.assert(_total(item(resource_location("minecraft:diamond"))) == 3, "The diamonds should exist exactly once at every sample.")
    ctx.assert(_total(item(resource_location("minecraft:iron_ingot"))) == 5, "The iron ingots should exist exactly once at every sample.")
}

local _west_records(pipe: BlockEntity) number {
    found: number = 0
    index: number = 0
    records: number = pipe.get_saved_list_size("traveling")
    while index < records {
        if pipe.get_saved_list_number("traveling", index, "direction") == 4 {
            found = found + 1
        }
        index = index + 1
    }
    return found
}

# How many of the item the two chests and the two pipes hold together.
local _total(wanted: Item) number {
    return _in_chest(source.unwrap(), wanted) + _in_chest(target.unwrap(), wanted) + _in_pipe(wooden.unwrap(), wanted) + _in_pipe(cobblestone.unwrap(), wanted)
}

local _in_chest(chest: BlockEntity, wanted: Item) number {
    found: number = 0
    slot: number = 0
    size: number = chest.get_inventory_size()
    while slot < size {
        held: Option[Item] = chest.get_item_in_slot(slot)
        if held.has() and chest.get_item_count_in_slot(slot) > 0 and equals(held.unwrap(), wanted) {
            found = found + chest.get_item_count_in_slot(slot)
        }
        slot = slot + 1
    }
    return found
}

local _in_chest_all(chest: BlockEntity) number {
    found: number = 0
    slot: number = 0
    size: number = chest.get_inventory_size()
    while slot < size {
        found = found + chest.get_item_count_in_slot(slot)
        slot = slot + 1
    }
    return found
}

local _in_pipe(pipe: BlockEntity, wanted: Item) number {
    found: number = 0
    index: number = 0
    records: number = pipe.get_saved_list_size("traveling")
    while index < records {
        held: Option[Item] = pipe.get_saved_list_item("traveling", index)
        if held.has() and equals(held.unwrap(), wanted) {
            found = found + pipe.get_saved_list_number("traveling", index, "count")
        }
        index = index + 1
    }
    return found
}
