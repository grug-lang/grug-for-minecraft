# Covers the redstone engine's energy and the trunk colour it draws for it, after BuildCraft 2.2.14's
# EngineWood: one energy for every 20 ticks a redstone signal reaches it, one lost every tick none
# does, and a blue, green, yellow or red trunk for up to 25%, 50%, 75% and above 75% of its 1000.
# The thresholds are checked by setting the engine's energy just below and at each stage boundary,
# so the test needs no ticks for them. The gain of one energy per 20 game ticks is waited for in real
# game ticks, which takes at most 40 of them. The rest of the test then photographs the engine in each
# of its four stages, setting its energy into each stage first.
engine: Option[BlockEntity] = Option.new()

# Which stage the next capture is of: 0 blue, 1 green, 2 yellow and 3 red.
stage: number = 0

# Where the gain check is: 0 before the torch is placed, 1 waiting for a sample of the world's time,
# 2 waiting for the next sample 20 ticks later, and 3 when the check is done. See _check_gain.
gain_phase: number = 0
energy_at_gain: number = 0
time_at_gain: number = 0

# The waits before each capture, as coverage_render-Test.grug explains them. See _ready.
settled_ticks: number = 0
remeshed: bool = false
remesh_ticks: number = 0

# Where the engine is. The torch that powers it goes right under it.
ex: number = 0
ey: number = 0
ez: number = 0

export run() {
    if Test.tick() == 0 {
        _setup()
        Test.not_done()
        return
    }

    if gain_phase != 3 {
        _check_gain()
        Test.not_done()
        return
    }

    if not _ready() {
        Test.not_done()
        return
    }

    # The crop is the engine against the stone wall behind it. It stops at the bottom of the engine's
    # front, above its underside and the torch under it, because a redstone torch gives off particles
    # at random and they drift up past the underside.
    if stage == 0 {
        Test.screenshot().equals(r"screenshots/redstone_engine_blue", 550, 150, 770, 305)
        _power()
        _draw_stage(251, 1)
    } else if stage == 1 {
        Test.screenshot().equals(r"screenshots/redstone_engine_green", 550, 150, 770, 305)
        _draw_stage(501, 2)
    } else if stage == 2 {
        Test.screenshot().equals(r"screenshots/redstone_engine_yellow", 550, 150, 770, 305)
        _draw_stage(751, 3)
    } else {
        Test.screenshot().equals(r"screenshots/redstone_engine_red", 550, 150, 770, 305)
        return
    }

    stage = stage + 1
    settled_ticks = 0
    remeshed = false
    remesh_ticks = 0
    Test.not_done()
}

local _setup() {
    level: Level = Test.get_client_level()

    Test.set_box_radius(6)

    origin: Vec3 = Test.setup_graphics_camera()
    ex = origin.x()
    ey = origin.y() - 1.88
    ez = origin.z() + 4

    level.place_block(ex, ey, ez, "grug:redstone_engine")
    engine_opt: Option[BlockEntity] = level.get_block_entity(ex, ey, ez)
    Test.assert(engine_opt.has(), "The redstone engine should have a block entity.")
    engine.set(engine_opt.unwrap())

    _wall(level, origin.x() - 6, origin.y() - 9, origin.z() + 6)

    # The stone the torch stands on goes in now, so that powering the engine later places nothing
    # but the torch itself.
    level.place_block(ex, ey - 2, ez, "minecraft:stone")

    _check_thresholds()
}

# Thirteen blocks square of stone two blocks behind the engine, as in coverage_render-Test.grug.
local _wall(level: Level, x0: number, y0: number, z: number) {
    wy: number = y0
    while wy < y0 + 13 {
        wx: number = x0
        while wx < x0 + 13 {
            level.place_block(wx, wy, z, "minecraft:stone")
            wx = wx + 1
        }
        wy = wy + 1
    }
}

# Each stage boundary, the energy just below it, at it and just above it. Nothing ticks the engine
# within one call of run(), so the energy set here is the energy the stage is read from.
local _check_thresholds() {
    Test.assert(_energy() == 0, "A new engine should have no energy.")

    _set_energy(249)
    Test.assert(_stage(_energy()) == 0, "249 energy should still be blue.")
    _set_energy(250)
    Test.assert(_stage(_energy()) == 0, "250 energy should still be blue.")
    _set_energy(251)
    Test.assert(_stage(_energy()) == 1, "251 energy should be green.")

    _set_energy(500)
    Test.assert(_stage(_energy()) == 1, "500 energy should still be green.")
    _set_energy(501)
    Test.assert(_stage(_energy()) == 2, "501 energy should be yellow.")

    _set_energy(750)
    Test.assert(_stage(_energy()) == 2, "750 energy should still be yellow.")
    _set_energy(751)
    Test.assert(_stage(_energy()) == 3, "751 energy should be red.")

    # The energy is saved data, so it has to survive the block entity being saved and loaded again.
    block_entity: BlockEntity = engine.unwrap()
    Test.round_trip_nbt(block_entity)
    Test.assert(_energy() == 751, "The engine's energy should survive an NBT round trip.")

    _set_energy(0)
}

# One energy on every tick the world's time is a multiple of 20. The test samples the time, and the
# energy with it, from the engine's own level, which is the level its tick reads. The samples are
# taken mid-window, 5 to 15 ticks past a multiple of 20, because the test runs on the client thread
# while the integrated server ticks on its own thread, so sampling exactly on a multiple of 20 races
# the engine's tick. A powered engine gains one energy for each multiple of 20 the world's time
# crosses between the two samples, so the gain must equal the number of multiples crossed, however
# many ticks the server ran between two of the test's calls. The check starts when the torch is
# placed. Then it leaves the engine unpowered at 0 energy for the first capture.
local _check_gain() {
    if gain_phase == 0 {
        _power()
        gain_phase = 1
        return
    }

    level: Level = get_block_entity_level(engine.unwrap())
    now: number = level.get_time()
    phase: number = Math.remainder(now, 20)
    if phase < 5 or phase > 15 {
        return
    }

    if gain_phase == 1 {
        energy_at_gain = _energy()
        time_at_gain = now
        gain_phase = 2
        return
    }

    if now < time_at_gain + 20 {
        return
    }

    gained: number = _energy() - energy_at_gain
    crossed: number = Math.floor(now / 20) - Math.floor(time_at_gain / 20)
    Test.assert(gained != 0, "A powered engine should gain energy when the world's time crosses a multiple of 20, but it gained none.")
    Test.assert(gained == crossed, "A powered engine should gain one energy for each multiple of 20 the world's time crosses, but it gained a different number.")
    _unpower()
    _set_energy(0)
    gain_phase = 3
}

local _energy() number {
    block_entity: BlockEntity = engine.unwrap()
    return get_saved_number(block_entity, "energy")
}

local _set_energy(energy: number) {
    block_entity: BlockEntity = engine.unwrap()
    set_saved_number(block_entity, "energy", energy)
}

# Sets the energy the engine is drawn from, then has the game draw it again, since its trunk is only
# rebuilt when it is asked to be. The energy has to give the stage the capture is of.
local _draw_stage(energy: number, expected_stage: number) {
    _set_energy(energy)
    block_entity: BlockEntity = engine.unwrap()
    redraw(block_entity)
    Test.assert(_stage(_energy()) == expected_stage, "The engine should have reached the next stage.")
}

# A redstone torch powers the block above it on every loader, so the torch goes right under the
# engine, standing on a stone block.
local _power() {
    level: Level = Test.get_client_level()
    level.place_block(ex, ey - 1, ez, "minecraft:redstone_torch")
    Test.assert(level.has_neighbor_signal(ex, ey, ez), "The torch under the engine should power it.")
}

local _unpower() {
    level: Level = Test.get_client_level()
    level.place_block(ex, ey - 1, ez, "minecraft:air")
    Test.assert(not level.has_neighbor_signal(ex, ey, ez), "The engine should be unpowered once the torch is gone.")
}

# Whether the frame is ready for a capture: the same waits as coverage_render-Test.grug, for the
# light to settle, for the section to be meshed again from it, and for that mesh to be drawn.
local _ready() bool {
    if not Test.world_settled() {
        settled_ticks = 0
        return false
    }
    if settled_ticks < 5 {
        settled_ticks = settled_ticks + 1
        return false
    }
    if not remeshed {
        _force_remesh()
        remeshed = true
        return false
    }
    if remesh_ticks < 5 {
        remesh_ticks = remesh_ticks + 1
        return false
    }
    return Test.world_settled()
}

# Dirties the wall's sections by swapping one of its blocks outside the crop and putting it back, so
# the capture's mesh is built from the settled light. See coverage_render-Test.grug.
local _force_remesh() {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y()
    z: number = origin.z()
    level.place_block(x - 6, y + 3, z + 6, "minecraft:dirt")
    level.place_block(x - 6, y + 3, z + 6, "minecraft:stone")
    Test.assert(level.get_block(x - 6, y + 3, z + 6) == "minecraft:stone", "The remesh swap should have put the wall block back.")
}

# The thresholds of Engine.computeEnergyStage for EngineWood's maxEnergy of 1000, which are the ones
# the engine's own render() draws from.
local _stage(energy: number) number {
    if energy <= 250 {
        return 0
    }
    if energy <= 500 {
        return 1
    }
    if energy <= 750 {
        return 2
    }
    return 3
}
