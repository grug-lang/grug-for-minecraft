# Covers the cobblestone pipe's T merge shape: a T-junction where two wooden pipes feed into one
# cobblestone pipe from opposite sides, with a chest on the third side as the output. The two
# wooden pipes sit on the sides, not along the camera's view, so both caps where the pipe kinds
# meet stay in frame, and the source of each is the chest directly above it, which keeps the
# sources out of the T's own row. The capture pins the different textures of the two pipe kinds
# and the cap where they meet. The fixture is static, so no items need to travel for the
# screenshot.
pipe: Option[BlockEntity] = Option.new()

# Whether the wall and the pipe's section have been meshed again from the settled light yet.
remeshed: bool = false

# How many runner ticks in a row the world has answered settled. See the hold in tick_any_side().
settled_ticks: number = 0

# Whether the client has seen the last pipe's stone gone and one more tick has passed since, so no
# click of the repeated ones is still on its way to the server. See _place_pipes().
drained: bool = false
after_chest: number = 0

# How many of the three pipes stand: the west wooden pipe, the east one, then the cobblestone pipe.
placed: number = 0

# The origin _setup built from, which the later steps build from too.
origin_x: number = 0
origin_y: number = 0
origin_z: number = 0

export tick_any_side(ctx: TestTickContext) {
    # DIAGNOSTIC: names the first tick a screen is open.
    if ctx.screen_open() {
        if placed == 0 {
            ctx.assert(false, "DIAG screen open with placed 0 (no pipe stands yet)")
        } else if placed == 1 {
            ctx.assert(false, "DIAG screen open with placed 1")
        } else if placed == 2 and not drained {
            ctx.assert(false, "DIAG screen open with placed 2, not drained")
        } else if placed == 2 {
            ctx.assert(false, "DIAG screen open with placed 2, drained")
        } else if after_chest <= 1 {
            ctx.assert(false, "DIAG screen open with placed 3, first test tick after the chest")
        } else if after_chest <= 3 {
            ctx.assert(false, "DIAG screen open with placed 3, 2 or 3 ticks after the chest")
        } else {
            ctx.assert(false, "DIAG screen open with placed 3, 4 or more ticks after the chest")
        }
    }
    if placed == 3 {
        after_chest = after_chest + 1
    }
    if ctx.current_tick() == 0 {
        _setup(ctx)
        ctx.not_done()
    } else if not pipe.has() {
        _place_pipes(ctx)
        ctx.not_done()
    } else if not ctx.world_settled() {
        settled_ticks = 0
        ctx.not_done()
    } else if settled_ticks < 5 {
        settled_ticks = settled_ticks + 1
        ctx.not_done()
    } else if not remeshed {
        _force_remesh(ctx)
        remeshed = true
        ctx.not_done()
    } else if not ctx.world_settled() {
        ctx.not_done()
    } else {
        ctx.assert(pipe.has(), "The pipe should have a block entity.")
        ctx.screenshot().equals(r"screenshots/cobblestone_pipe_t_merge", 400, 0, 880, 360)
    }
}

local _setup(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()

    ctx.set_box_radius(6)

    origin: Vec3 = ctx.get_origin()
    x: number = origin.x()
    y: number = origin.y()
    z: number = origin.z()
    origin_x = x
    origin_y = y
    origin_z = z

    _wall(level, x - 6, y - 9, z + 6)

    # The two wooden pipes take their source from the chest directly above each of them, which
    # keeps the sources out of the T's own row. The chests go in first, so a pipe's placement
    # finds its source and the reference's switchSource settles on YPos straight away.
    level.place_block(x - 1, y - 0.88, z + 4, "minecraft:chest")
    level.place_block(x + 1, y - 0.88, z + 4, "minecraft:chest")

    # The stones the three pipes are placed against, one block behind each pipe's cell. The centre
    # one is cleared for the output chest once the pipes stand.
    level.place_block(x - 1, y - 1.88, z + 5, "minecraft:stone")
    level.place_block(x + 1, y - 1.88, z + 5, "minecraft:stone")
    level.place_block(x, y - 1.88, z + 5, "minecraft:stone")
}

# Both the reference and the port place each pipe the way a player does: hold the pipe item and
# right-click the side of the stone at z + 5, which is the face the test player's eye sees of it, so
# the pipe lands at z + 4. The reference's ItemPipe sets the pipe's kind, and the placement is what
# settles the light around the pipe, so both scenes must use the same path. On 1.20.6 the click is
# the client's and reaches the server as a packet, and the client has not necessarily got the stone
# the test just placed, so the click is made again every tick until the pipe stands in the world
# the test reads. Only then is its stone cleared, because a stone cleared sooner is not there when
# the packet arrives. The pipes go in one after another: the two wooden ones, then the cobblestone.
local _place_pipes(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    x: number = origin_x
    y: number = origin_y
    z: number = origin_z
    player: Player = ctx.get_player()
    px: number = x - 1
    if placed == 1 {
        px = x + 1
    } else if placed == 2 {
        px = x
    }
    pipe_opt: Option[BlockEntity] = level.get_block_entity(px, y - 1.88, z + 4)
    if not pipe_opt.has() {
        if me.is_reference() and placed < 2 {
            ctx.set_held_item(player, item(resource_location("buildcraft:PipeItemsWood")))
        } else if me.is_reference() {
            ctx.set_held_item(player, item(resource_location("buildcraft:PipeItemsCobblestone")))
        } else if placed < 2 {
            ctx.set_held_item(player, item(resource_location("grug:wooden_pipe")))
        } else {
            ctx.set_held_item(player, item(resource_location("grug:cobblestone_pipe")))
        }
        ctx.use_block(level, px, y - 1.88, z + 5)
        return
    }
    ctx.clear_held_item(player)
    level.place_block(px, y - 1.88, z + 5, "minecraft:air")
    # The click is repeated every tick until the client sees the pipe, so some clicks are still on
    # their way to the server when the pipe stands. The output chest goes into the very cell the
    # last of them targets, and a click that lands on a chest opens its screen over the capture
    # (1.20.6 only: its clicks are packets). So the chest waits until the client has seen the stone
    # gone, which means every click sent before that has reached the server's queue, and one tick
    # more for the server to have run them, when they find air and do nothing.
    if level.get_block(px, y - 1.88, z + 5) != "minecraft:air" {
        return
    }
    if placed == 2 and not drained {
        drained = true
        return
    }
    # The port's wooden pipe source side is the side plus one. Both wooden pipes extract from the
    # chest above them, which is YPos, side 1, so the saved source is 2.
    if not me.is_reference() and placed < 2 {
        pipe_opt.unwrap().set_saved_number("source", 2)
    }
    placed = placed + 1
    if placed == 3 {
        # The output chest behind the cobblestone pipe. The third arm points away from the camera,
        # so it cannot stand in front of the junction the way a pipe on the camera's side would.
        level.place_block(x, y - 1.88, z + 5, "minecraft:chest")
        pipe.set(pipe_opt.unwrap())
    }
}

# Thirteen blocks square of minecraft:stone at (x0, y0, z), which covers the crop with room to
# spare.
local _wall(level: Level, x0: number, y0: number, z: number) {
    wy: number = y0
    while wy < y0 + 13 {
        wx: number = x0
        while wx < x0 + 13 {
            level.place_block(wx, wy, z, "minecraft:stone")
            wx = wx + 1
        }
        wy = wy + 1
    }
}

# Meshes the crop's section again from the settled light by changing a block state and putting it
# back. The swapped block is outside the crop, and dirt and stone are both opaque and unlit, so the
# swap changes no light and no compared pixel.
local _force_remesh(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    x: number = origin_x
    y: number = origin_y
    z: number = origin_z
    level.place_block(x - 6, y + 3, z + 6, "minecraft:dirt")
    level.place_block(x - 6, y + 3, z + 6, "minecraft:stone")
    ctx.assert(level.get_block(x - 6, y + 3, z + 6) == "minecraft:stone", "The remesh swap should have put the wall block back.")
}
