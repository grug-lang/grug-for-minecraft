# Covers two wooden pipes, each with its own source chest and engine, handing on to the same
# cobblestone pipe from different sides, which hands on to one output chest. The wooden pipes do not
# touch each other (they are diagonal, so the default pipes.alwaysConnect of false never matters here).
# In the reference the cobblestone pipe accepts an item into the other wooden pipe as well, since that
# pipe takes any item that reaches it, so an item may take a detour through the other source chest and
# be pulled out again; the test therefore asserts what does not depend on the random pick: that
# both kinds of item reach the output chest, and that every item exists exactly once at every sample.
# The level is advanced inside the test's own tick (#780).
# #1205: the a1 dedicated server's leg failed this assertion once under load, and only the failing
# sample can say whether an item was lost or stands where no sum looks. A sample with a wrong total
# therefore prints every container, each pipe's travelling records (a record whose item is not
# written yet is counted by no sum), the held hotbar slot and the item entities beside the fixture
# before it fails. Every runner tick looks the six block entities up again, since a chunk loaded
# again makes new objects. The sums are not widened to cover an inbox, a dropped item or the held
# slot: none is a state this pipe leaves at a tick boundary, so each is a defect the assertion has
# to keep reporting, and a drop the a1 player picks up therefore still fails.
# #1205: a single pass gives that red one chance per run, so the a1 dedicated leg repeats the first
# delivery. A pass is about 400 world ticks, and this leg advances one world tick a runner tick, so
# the number of passes has to fit the 4000 runner tick budget: thirty passes of the eight-tick batch
# below is about 1500 to 2250 runner ticks, well inside it, and a hundred would not fit at any batch
# small enough to carry.
# #1735: the a1 server checks a connection's send queue once per server tick and closes a client
# whose queue passed 1 MiB (Connection.tick, "Send buffer overflow"), and the queue grows by what a
# burst sends before the joined client's reader drains it. At 200 world ticks in one runner tick the
# leg lost its player (run 45547610028) and at 25 it lost it again (run 45560506005), while one tick
# per runner tick passed on every leg (run 45562704688). So the repeat's batch is eight world ticks
# per runner tick, a third of the burst that failed, and the single pass uses it too rather than
# having a pace of its own.
# #1787 measured the payload that burst carries: a pipe's saved-data packet is 439 bytes with one
# travelling record and 2884 with eight, not the ten kilobytes the repeat's pause was filed on, so
# what the batch has to keep small is the number of ticks sent back to back and not a pipe's tick.
source_a: Option[BlockEntity] = Option.new()
source_b: Option[BlockEntity] = Option.new()
target: Option[BlockEntity] = Option.new()
wooden_a: Option[BlockEntity] = Option.new()
wooden_b: Option[BlockEntity] = Option.new()
cobblestone: Option[BlockEntity] = Option.new()
# The level to advance, fetched once: every ctx.get_client_level adds a level entity, and the
# advance is asked for on more than one runner tick.
test_level: Option[Level] = Option.new()

# The game ticks this test has asked the level to run so far, which bounds the advance as a whole
# rather than one call of it.
advanced: number = 0

# The pass being repeated, 0 for the first, and the world tick it started at. A wrong sample and a
# pass that never delivers both name them, so the log says whether the red came from a fresh
# fixture or an old one.
round: number = 0
round_started: number = 0

# How many times the a1 dedicated leg runs the delivery. Every other leg runs it once, because the
# red has only come from that one, and a pass costs about 400 world ticks of the runner's budget.
rounds: number = 30

# Whether any tick_level call has run a world tick. A loader whose adapter leaves tick_level at
# its default answers 0 every time, and the runner's own tick then carries the first pass; a leg
# where it does advance can repeat the fixture at once instead of at real time.
can_advance: bool = false

# The fixture's origin at the band, so a sample can look the six block entities up again by
# position instead of trusting the handles _setup took.
base_x: number = 0
base_y: number = 0
base_z: number = 0

# How many of the six the last sample found again at their positions. Fewer than six means a chunk
# was not readable that sample, and the report says so.
refetched: number = 0

# The runner tick the six handles were last fetched at. _advance samples up to a batch's world ticks
# inside one runner tick, and each fetch makes host entities that live until the test ends, so a
# sample of a tick that already fetched reuses the handles and a new runner tick fetches them again.
fetched_tick: number = -1

# #1014: the pick is the level's own random, as PipeTransportItems.resolveDestination draws it in
# singleplayer (worldObj.r.nextInt(size)), and nothing in the API seeds that random, so the route
# cannot be pinned without changing the reference's behaviour, and the test asserts what does not
# depend on it. The client OrnitheAdapters and both stationapi adapters leave tickLevel at its
# default, so the clients of a1.1.2, b1.7.3-ornithe and b1.7.3-stationapi and the stationapi server
# wait on the runner's tick budget while every other leg advances its level inside one runner tick.
# A temporary repeat of the whole fixture, each round draining every item into the output chest,
# finished 35 rounds, 10 of them on the stationapi client, the only ordinary-budget samples: those
# took 663 to 2397 runner ticks, which are game ticks there, and the longest round anywhere took
# 4640 game ticks (1.2.5 4640, 1.20.6 3255, the rest between 560 and 3030). The budget has to cover
# the first delivery of each kind, not a whole round: init asks for 4000 ticks of real time, which is
# 40000 runner ticks at the 10x game speed CI runs at and 4000 at 1x, and the first delivery took
# about 366 game ticks on the stationapi client in the merged run. A repeat of the delivery advances
# inside that same call, so each pass costs about a runner tick of the 4000 and not a budget of its
# own.
export init(ctx: TestInitContext) {
    ctx.set_max_ticks(4000)
}

export tick(ctx: TestTickContext) {
    if ctx.current_tick() == 0 {
        _setup(ctx)
    }
    if not _done() {
        _advance(ctx)
    }
    _sample(ctx)
    if _done() {
        if _repeats() and can_advance and round + 1 < rounds {
            _reset()
            ctx.not_done()
            return
        }
        return
    }
    _check_round_ticks(ctx)
    ctx.not_done()
}

# #1205: whether this leg repeats the fixture. The red has come from the a1 dedicated server, the
# one leg where an item's pickup is live and a joined client's copy is the only other world, so the
# repeat is spent there and not on five other legs. The reference run is a client on the reference's
# own loader, so those two conditions skip it too. The test deliberately does not branch on the
# reference: reference-needed.py stages every test that asks the harness whether it runs against
# the reference, and the reference harness's blocks and pipes are the real BuildCraft ones with no
# saved lists to read, so this test cannot run there at all (#1205).
local _repeats() bool {
    return me.on_dedicated_server() and me.loader_name() == "a1.1.2_01-ornithe"
}

# A pass that never delivers one of each is not the red this test reports, so it names itself
# rather than ending at the tick budget with no explanation. The advance stops at exactly 6000 world
# ticks into a pass at the a1 leg's step of 1, so the guard fires at the limit: a check for more than
# the limit never sees that stall and lets the test spin to the budget instead. The 6000 is the cap
# the whole test had before the repeat, and a first delivery took 405 world ticks on the run that
# failed.
local _check_round_ticks(ctx: TestTickContext) {
    ticks: number = advanced - round_started
    if _repeats() and ticks >= 6000 {
        message: string = String.concat("Pass ", String.from_number(round))
        message = String.concat(message, " did not deliver a diamond and an ingot within 6000 world ticks, at ")
        message = String.concat(message, String.from_number(advanced))
        message = String.concat(message, " world ticks advanced and ")
        message = String.concat(message, String.from_number(ticks))
        message = String.concat(message, " in it.")
        ctx.assert(false, message)
    }
}

# #780: the pipes need the world's own ticks, so the test asks the level to run them inside this
# tick, and a loader that cannot advance its level answers 0 and is carried by the wait in tick()
# instead. The 200-tick chunk keeps one call from holding the server's tick for long; a route that
# needs more is carried by the tick budget. #1205: a grug call has no time limit of its own (the
# state lock's 60 s gate is for a wait that hands the world back), so a slower runner lengthens the
# call rather than dropping anything, and the sample still lands on a world-tick boundary. The a1
# dedicated leg samples every world tick, since the red this leg hunts can sit inside one five-tick
# step; every other leg keeps the five-tick step, because it cannot show the red and would pay five
# times the sampling for no diagnosis. #1735, #1787: that leg advances one world tick a runner tick,
# because a tick of this fixture queues block entity packets and the server closes a connection
# whose queue passed 1 MiB after the tick. A batch is written and drained between two server ticks,
# so one tick a runner tick keeps the queue at a single tick's worth whatever that is, while a batch
# of 25 hands back a burst 25 times as large and a batch of 200 lost the player twice, in runs
# 45547610028 and 45560506005.
local _advance(ctx: TestTickContext) {
    step: number = 5
    batch: number = 200
    if _repeats() {
        # #1735: one world tick per call and eight per runner tick, so a server tick checks the
        # connection between the calls and the burst stays a third of the 25 that failed.
        step = 1
        batch = 8
    }
    chunk: number = 0
    ran: number = step
    while not _done() and ran > 0 and chunk < batch and advanced - round_started < 6000 {
        ran = ctx.tick_level(test_level.unwrap(), step)
        if ran > 0 {
            can_advance = true
        }
        chunk = chunk + ran
        advanced = advanced + ran
        _sample(ctx)
    }
}

local _setup(ctx: TestTickContext) {
    level: Level = ctx.get_client_level()
    test_level.set(level)
    origin: Vec3 = ctx.get_origin()
    x: number = origin.x()
    # Band 12, clear of the bands the other pipe tests use.
    y: number = origin.y() + 12
    z: number = origin.z()
    base_x = x
    base_y = y
    base_z = z

    # The cobblestone pipe at (x, y, z), a wooden pipe to its west and one to its north, the output
    # chest to its east, and a source chest behind each wooden pipe.
    level.place_block(x - 2, y, z, "minecraft:chest")
    level.place_block(x - 1, y, z, "grug:wooden_pipe")
    level.place_block(x, y, z - 2, "minecraft:chest")
    level.place_block(x, y, z - 1, "grug:wooden_pipe")
    level.place_block(x, y, z, "grug:cobblestone_pipe")
    level.place_block(x + 1, y, z, "minecraft:chest")

    # An engine beside each wooden pipe, on its own torch, away from the other pipe.
    level.place_block(x - 1, y - 2, z + 1, "minecraft:stone")
    level.place_block(x - 1, y - 1, z + 1, "minecraft:redstone_torch")
    level.place_block(x - 1, y, z + 1, "grug:redstone_engine")
    level.place_block(x + 1, y - 2, z - 1, "minecraft:stone")
    level.place_block(x + 1, y - 1, z - 1, "minecraft:redstone_torch")
    level.place_block(x + 1, y, z - 1, "grug:redstone_engine")

    source_a.set(_entity(ctx, level, x - 2, y, z))
    wooden_a.set(_entity(ctx, level, x - 1, y, z))
    source_b.set(_entity(ctx, level, x, y, z - 2))
    wooden_b.set(_entity(ctx, level, x, y, z - 1))
    cobblestone.set(_entity(ctx, level, x, y, z))
    target.set(_entity(ctx, level, x + 1, y, z))
    # The engine makes no signal the game can read at the pipe: BlockEngine.b() is false, so the
    # engine is not a normal cube, and World.isBlockIndirectlyProvidingPowerTo asks a non-cube
    # neighbour for its own power, which BlockEngine does not provide. What the game does report is
    # each engine being powered by its torch, and the items reaching the output chest are what prove
    # the engines power their pipes through the energy framework.
    ctx.assert(level.has_neighbor_signal(x - 1, y, z + 1), "The west pipe's engine should be powered by its torch.")
    ctx.assert(level.has_neighbor_signal(x + 1, y, z - 1), "The north pipe's engine should be powered by its torch.")

    source_a.unwrap().set_item_in_slot(0, item(resource_location("minecraft:diamond")), 4)
    source_b.unwrap().set_item_in_slot(0, item(resource_location("minecraft:iron_ingot")), 4)
}

# #1205: starts the next pass from the state the first one began in. Every travelling record and
# every chest slot is cleared and the two sources are filled again, so the pass counts four of each
# kind exactly as the first did. Clearing a record is what breaking the pipe would do, without a
# block break, which would drop a chest's whole contents as item entities the a1 player can pick
# up; the clear and the fill are one call, so no sample runs while the fixture holds fewer than
# four of either kind, and the items a pass leaves in flight are not read as a loss.
# The six handles are looked up again first: a chunk that reloaded inside the advance that ended
# the pass would otherwise have this clear and fill write to objects the level no longer holds.
local _reset() {
    _refetch(test_level.unwrap())
    _clear_pipe(wooden_a.unwrap())
    _clear_pipe(wooden_b.unwrap())
    _clear_pipe(cobblestone.unwrap())
    _clear_chest(source_a.unwrap())
    _clear_chest(source_b.unwrap())
    _clear_chest(target.unwrap())
    source_a.unwrap().set_item_in_slot(0, item(resource_location("minecraft:diamond")), 4)
    source_b.unwrap().set_item_in_slot(0, item(resource_location("minecraft:iron_ingot")), 4)
    round = round + 1
    round_started = advanced
}

# A pipe's travelling records and the extraction inbox it may have. A cobblestone pipe declares no
# inventory, so its slot 0 is not written, which an out-of-range write would report as an error.
local _clear_pipe(pipe: BlockEntity) {
    while pipe.get_saved_list_size("traveling") > 0 {
        pipe.remove_saved_list_record("traveling", 0)
    }
    if pipe.get_inventory_size() > 0 {
        pipe.set_item_count_in_slot(0, 0)
    }
}

local _clear_chest(chest: BlockEntity) {
    slot: number = 0
    size: number = chest.get_inventory_size()
    while slot < size {
        chest.set_item_count_in_slot(slot, 0)
        slot = slot + 1
    }
}

local _entity(ctx: TestTickContext, level: Level, x: number, y: number, z: number) BlockEntity {
    block_entity: Option[BlockEntity] = level.get_block_entity(x, y, z)
    ctx.assert(block_entity.has(), "The fixture should have a block entity.")
    return block_entity.unwrap()
}

# Both kinds have been delivered when the output chest holds one of each.
local _done() bool {
    return _in_inventory(target.unwrap(), item(resource_location("minecraft:diamond"))) > 0 and _in_inventory(target.unwrap(), item(resource_location("minecraft:iron_ingot"))) > 0
}

local _sample(ctx: TestTickContext) {
    if ctx.current_tick() != fetched_tick {
        fetched_tick = ctx.current_tick()
        _refetch(test_level.unwrap())
    }
    diamond: Item = item(resource_location("minecraft:diamond"))
    ingot: Item = item(resource_location("minecraft:iron_ingot"))
    diamonds: number = _total(diamond)
    ingots: number = _total(ingot)
    if diamonds != 4 or ingots != 4 {
        _report(ctx, diamonds, ingots)
    }
    ctx.assert(diamonds == 4, "The diamonds should exist exactly once at every sample.")
    ctx.assert(ingots == 4, "The iron ingots should exist exactly once at every sample.")
}

# #1205: a chunk can be dropped to storage and loaded again between two runner ticks, which makes new
# block entity objects, so a sample that reused the handles _setup took would read a frozen snapshot
# of the old ones and could not see the new pipes run. The handles are therefore fetched again at
# each new runner tick, not at each sample, because the up to 200 samples of one advance would each
# make host entities that live until the test ends. A position that answers nothing keeps the handle
# it had, because the sample must still print a total, and refetched reports that it is not live.
local _refetch(level: Level) {
    refetched = 0
    source_a.set(_refetch_one(level, source_a, base_x - 2, base_y, base_z))
    wooden_a.set(_refetch_one(level, wooden_a, base_x - 1, base_y, base_z))
    source_b.set(_refetch_one(level, source_b, base_x, base_y, base_z - 2))
    wooden_b.set(_refetch_one(level, wooden_b, base_x, base_y, base_z - 1))
    cobblestone.set(_refetch_one(level, cobblestone, base_x, base_y, base_z))
    target.set(_refetch_one(level, target, base_x + 1, base_y, base_z))
}

local _refetch_one(level: Level, previous: Option[BlockEntity], x: number, y: number, z: number) BlockEntity {
    live: Option[BlockEntity] = level.get_block_entity(x, y, z)
    if live.has() {
        refetched = refetched + 1
        return live.unwrap()
    }
    return previous.unwrap()
}

# #1205: a sample with a wrong total names where every item is, because the failing run's log is the
# only evidence there is from the leg that fails. The records are printed too, since a record whose
# item is not written yet is counted by no sum, the item entities beside the fixture, since a drop is
# the other place an item can stand unread, and the player's held slot, since the a1 player may have
# picked a drop up.
local _report(ctx: TestTickContext, diamonds: number, ingots: number) {
    diamond: Item = item(resource_location("minecraft:diamond"))
    ingot: Item = item(resource_location("minecraft:iron_ingot"))
    level: Level = test_level.unwrap()
    origin: Vec3 = ctx.get_origin()
    print2("A sample found the wrong total: diamonds", diamonds)
    print2("A sample found the wrong total: ingots", ingots)
    print2("round", round)
    print2("world ticks advanced", advanced)
    print2("world ticks in the round", advanced - round_started)
    print("counts by container follow, each line diamonds then ingots:")
    print3("source_a chest", _in_inventory(source_a.unwrap(), diamond), _in_inventory(source_a.unwrap(), ingot))
    print3("source_b chest", _in_inventory(source_b.unwrap(), diamond), _in_inventory(source_b.unwrap(), ingot))
    print3("target chest", _in_inventory(target.unwrap(), diamond), _in_inventory(target.unwrap(), ingot))
    print3("wooden_a travelling", _in_pipe(wooden_a.unwrap(), diamond), _in_pipe(wooden_a.unwrap(), ingot))
    print3("wooden_b travelling", _in_pipe(wooden_b.unwrap(), diamond), _in_pipe(wooden_b.unwrap(), ingot))
    print3("cobblestone travelling", _in_pipe(cobblestone.unwrap(), diamond), _in_pipe(cobblestone.unwrap(), ingot))
    print2("wooden_a inbox items", _inbox(wooden_a.unwrap()))
    print2("wooden_b inbox items", _inbox(wooden_b.unwrap()))
    print2("wooden_a travelling records", _records(wooden_a.unwrap()))
    print2("wooden_b travelling records", _records(wooden_b.unwrap()))
    print2("cobblestone travelling records", _records(cobblestone.unwrap()))
    print3("held slot", _held(ctx, diamond), _held(ctx, ingot))
    print2("block entities found again", refetched)
    print2("item entities near the fixture", level.count_item_entities(origin.x(), origin.y() + 12, origin.z(), 16))
}

# Every item of the wanted kind the containers the fixture can hand an item to hold: the three
# chests and the three pipes' travelling records. A wooden pipe's extraction inbox, a dropped item
# entity and the player's held slot are deliberately not read, because the pipe leaves neither of the
# first two behind at a tick boundary and a held item is most likely a drop the a1 player walked
# over, so each is a defect the assertion has to keep reporting and _report says where it is
# (#1205).
local _total(wanted: Item) number {
    return _in_inventory(source_a.unwrap(), wanted) + _in_inventory(source_b.unwrap(), wanted) + _in_inventory(target.unwrap(), wanted) + _in_pipe(wooden_a.unwrap(), wanted) + _in_pipe(wooden_b.unwrap(), wanted) + _in_pipe(cobblestone.unwrap(), wanted)
}

# The items of the wanted kind in the player's selected hotbar slot. The a1 dedicated server's
# pickup is live, unlike the newer versions', so this is reported to name an item the player took off
# the floor, but it is not summed into _total: a dropped item the player picks up has to stay red
# (#1205). The player's other slots cannot be read through the API, so a pickup into one of them is
# reported by nothing but the wrong total.
local _held(ctx: TestTickContext, wanted: Item) number {
    player: Player = ctx.get_player()
    held: Option[Item] = player.get_held_item()
    if held.has() and equals(held.unwrap(), wanted) {
        return ctx.get_held_count(player)
    }
    return 0
}

local _in_inventory(block: BlockEntity, wanted: Item) number {
    found: number = 0
    slot: number = 0
    size: number = block.get_inventory_size()
    while slot < size {
        held: Option[Item] = block.get_item_in_slot(slot)
        if held.has() and block.get_item_count_in_slot(slot) > 0 and equals(held.unwrap(), wanted) {
            found = found + block.get_item_count_in_slot(slot)
        }
        slot = slot + 1
    }
    return found
}

local _in_pipe(pipe: BlockEntity, wanted: Item) number {
    found: number = 0
    index: number = 0
    records: number = pipe.get_saved_list_size("traveling")
    while index < records {
        held: Option[Item] = pipe.get_saved_list_item("traveling", index)
        if held.has() and equals(held.unwrap(), wanted) {
            found = found + pipe.get_saved_list_number("traveling", index, "count")
        }
        index = index + 1
    }
    return found
}

# The items a wooden pipe's extraction inbox holds, whatever kind they are.
local _inbox(pipe: BlockEntity) number {
    if not pipe.get_item_in_slot(0).has() {
        return 0
    }
    return pipe.get_item_count_in_slot(0)
}

# A pipe's travelling records, one of which is counted by _in_pipe only once its item is written.
local _records(pipe: BlockEntity) number {
    return pipe.get_saved_list_size("traveling")
}
