# Covers two wooden pipes, each with its own source chest and engine, handing on to the same
# cobblestone pipe from different sides, which hands on to one output chest. The wooden pipes do not
# touch each other (they are diagonal, so the default pipes.alwaysConnect of false never matters here).
# In the reference the cobblestone pipe accepts an item into the other wooden pipe as well, since that
# pipe takes any item that reaches it, so an item may take a detour through the other source chest and
# be pulled out again; the test therefore asserts what does not depend on the random pick: that
# both kinds of item reach the output chest, and that every item exists exactly once at every sample.
# The level is advanced inside the test's own tick (#780).
# #1205: the a1 dedicated server's leg failed this assertion once under load, and only the failing
# sample can say whether an item was lost or stands where no sum looks. A sample with a wrong total
# therefore prints every container, each pipe's travelling records (a record whose item is not
# written yet is counted by no sum) and the item entities beside the fixture before it fails. The
# sums themselves are not widened to cover an inbox or a dropped item: neither is a state this pipe
# leaves at a tick boundary, so each is a defect the assertion has to keep reporting.
source_a: Option[BlockEntity] = Option.new()
source_b: Option[BlockEntity] = Option.new()
target: Option[BlockEntity] = Option.new()
wooden_a: Option[BlockEntity] = Option.new()
wooden_b: Option[BlockEntity] = Option.new()
cobblestone: Option[BlockEntity] = Option.new()
# The level to advance, fetched once: every Test.get_client_level adds a level entity, and the
# advance is asked for on more than one runner tick.
test_level: Option[Level] = Option.new()

# The game ticks this test has asked the level to run so far, which bounds the advance as a whole
# rather than one call of it.
advanced: number = 0

# #1014: the pick is the level's own random, as PipeTransportItems.resolveDestination draws it in
# singleplayer (worldObj.r.nextInt(size)), and nothing in the API seeds that random, so the route
# cannot be pinned without changing the reference's behaviour, and the test asserts what does not
# depend on it. The client OrnitheAdapters and both stationapi adapters leave tickLevel at its
# default, so the clients of a1.1.2, b1.7.3-ornithe and b1.7.3-stationapi and the stationapi server
# wait on the runner's tick budget while every other leg advances its level inside one runner tick.
# A temporary repeat of the whole fixture, each round draining every item into the output chest,
# finished 35 rounds, 10 of them on the stationapi client, the only ordinary-budget samples: those
# took 663 to 2397 runner ticks, which are game ticks there, and the longest round anywhere took
# 4640 game ticks (1.2.5 4640, 1.20.6 3255, the rest between 560 and 3030). The budget has to cover
# the first delivery of each kind, not a whole round: init asks for 4000 ticks of real time, which is
# 40000 runner ticks at the 10x game speed CI runs at and 4000 at 1x, and the first delivery took
# about 366 game ticks on the stationapi client in the merged run.
export init(ctx: TestInitContext) {
    ctx.set_max_ticks(4000)
}

export tick_any_side(ctx: TestTickContext) {
    if ctx.current_tick() == 0 {
        _setup(ctx)
    }
    _advance(ctx)
    _sample(ctx)
    if _done() {
        return
    }
    ctx.not_done()
}

# #780: the pipes need the world's own ticks, so the test asks the level to run them inside this
# tick, and a loader that cannot advance its level answers 0 and is carried by the wait in tick()
# instead. The 200-tick chunk keeps one call from holding the server's tick for long, and the 6000
# cap bounds the test as a whole; a route that needs more is carried by the tick budget. #1205: a
# grug call has no time limit of its own (the state lock's 60 s gate is for a wait that hands the
# world back), so a slower runner lengthens the call rather than dropping anything, and the sample
# still lands on a world-tick boundary.
local _advance(ctx: TestTickContext) {
    chunk: number = 0
    ran: number = 5
    while not _done() and ran > 0 and chunk < 200 and advanced < 6000 {
        ran = Test.tick_level(test_level.unwrap(), 5)
        chunk = chunk + ran
        advanced = advanced + ran
        _sample(ctx)
    }
}

local _setup(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    test_level.set(level)
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    # Band 12, clear of the bands the other pipe tests use.
    y: number = origin.y() + 12
    z: number = origin.z()

    # The cobblestone pipe at (x, y, z), a wooden pipe to its west and one to its north, the output
    # chest to its east, and a source chest behind each wooden pipe.
    level.place_block(x - 2, y, z, "minecraft:chest")
    level.place_block(x - 1, y, z, "grug:wooden_pipe")
    level.place_block(x, y, z - 2, "minecraft:chest")
    level.place_block(x, y, z - 1, "grug:wooden_pipe")
    level.place_block(x, y, z, "grug:cobblestone_pipe")
    level.place_block(x + 1, y, z, "minecraft:chest")

    # An engine beside each wooden pipe, on its own torch, away from the other pipe.
    level.place_block(x - 1, y - 2, z + 1, "minecraft:stone")
    level.place_block(x - 1, y - 1, z + 1, "minecraft:redstone_torch")
    level.place_block(x - 1, y, z + 1, "grug:redstone_engine")
    level.place_block(x + 1, y - 2, z - 1, "minecraft:stone")
    level.place_block(x + 1, y - 1, z - 1, "minecraft:redstone_torch")
    level.place_block(x + 1, y, z - 1, "grug:redstone_engine")

    source_a.set(_entity(ctx, level, x - 2, y, z))
    wooden_a.set(_entity(ctx, level, x - 1, y, z))
    source_b.set(_entity(ctx, level, x, y, z - 2))
    wooden_b.set(_entity(ctx, level, x, y, z - 1))
    cobblestone.set(_entity(ctx, level, x, y, z))
    target.set(_entity(ctx, level, x + 1, y, z))
    ctx.assert(level.has_neighbor_signal(x - 1, y, z), "The west pipe's engine should be powered.")
    ctx.assert(level.has_neighbor_signal(x, y, z - 1), "The north pipe's engine should be powered.")

    source_a.unwrap().set_item_in_slot(0, item(resource_location("minecraft:diamond")), 4)
    source_b.unwrap().set_item_in_slot(0, item(resource_location("minecraft:iron_ingot")), 4)
}

local _entity(ctx: TestTickContext, level: Level, x: number, y: number, z: number) BlockEntity {
    block_entity: Option[BlockEntity] = level.get_block_entity(x, y, z)
    ctx.assert(block_entity.has(), "The fixture should have a block entity.")
    return block_entity.unwrap()
}

# Both kinds have been delivered when the output chest holds one of each.
local _done() bool {
    return _in_inventory(target.unwrap(), item(resource_location("minecraft:diamond"))) > 0 and _in_inventory(target.unwrap(), item(resource_location("minecraft:iron_ingot"))) > 0
}

local _sample(ctx: TestTickContext) {
    diamond: Item = item(resource_location("minecraft:diamond"))
    ingot: Item = item(resource_location("minecraft:iron_ingot"))
    diamonds: number = _total(diamond)
    ingots: number = _total(ingot)
    if diamonds != 4 or ingots != 4 {
        _report(diamonds, ingots)
    }
    ctx.assert(diamonds == 4, "The diamonds should exist exactly once at every sample.")
    ctx.assert(ingots == 4, "The iron ingots should exist exactly once at every sample.")
}

# #1205: a sample with a wrong total names where every item is, because the failing run's log is the
# only evidence there is from the leg that fails. The records are printed too, since a record whose
# item is not written yet is counted by no sum, and the item entities beside the fixture, since a
# drop is the other place an item can stand unread.
local _report(diamonds: number, ingots: number) {
    diamond: Item = item(resource_location("minecraft:diamond"))
    ingot: Item = item(resource_location("minecraft:iron_ingot"))
    level: Level = test_level.unwrap()
    origin: Vec3 = Test.get_origin()
    print2("A sample found the wrong total: diamonds", diamonds)
    print2("A sample found the wrong total: ingots", ingots)
    print2("world ticks advanced", advanced)
    print("counts by container follow, each line diamonds then ingots:")
    print3("source_a chest", _in_inventory(source_a.unwrap(), diamond), _in_inventory(source_a.unwrap(), ingot))
    print3("source_b chest", _in_inventory(source_b.unwrap(), diamond), _in_inventory(source_b.unwrap(), ingot))
    print3("target chest", _in_inventory(target.unwrap(), diamond), _in_inventory(target.unwrap(), ingot))
    print3("wooden_a travelling", _in_pipe(wooden_a.unwrap(), diamond), _in_pipe(wooden_a.unwrap(), ingot))
    print3("wooden_b travelling", _in_pipe(wooden_b.unwrap(), diamond), _in_pipe(wooden_b.unwrap(), ingot))
    print3("cobblestone travelling", _in_pipe(cobblestone.unwrap(), diamond), _in_pipe(cobblestone.unwrap(), ingot))
    print2("wooden_a inbox items", _inbox(wooden_a.unwrap()))
    print2("wooden_b inbox items", _inbox(wooden_b.unwrap()))
    print2("wooden_a travelling records", _records(wooden_a.unwrap()))
    print2("wooden_b travelling records", _records(wooden_b.unwrap()))
    print2("cobblestone travelling records", _records(cobblestone.unwrap()))
    print2("item entities near the fixture", level.count_item_entities(origin.x(), origin.y() + 12, origin.z(), 16))
}

# Every item of the wanted kind the containers the fixture can hand an item to hold: the three
# chests and the three pipes' travelling records. A wooden pipe's extraction inbox and a dropped item
# entity are deliberately not read, because the pipe leaves neither behind at a tick boundary, so a
# sample that finds one short has found a defect and says where everything is with _report (#1205).
local _total(wanted: Item) number {
    return _in_inventory(source_a.unwrap(), wanted) + _in_inventory(source_b.unwrap(), wanted) + _in_inventory(target.unwrap(), wanted) + _in_pipe(wooden_a.unwrap(), wanted) + _in_pipe(wooden_b.unwrap(), wanted) + _in_pipe(cobblestone.unwrap(), wanted)
}

local _in_inventory(block: BlockEntity, wanted: Item) number {
    found: number = 0
    slot: number = 0
    size: number = block.get_inventory_size()
    while slot < size {
        held: Option[Item] = block.get_item_in_slot(slot)
        if held.has() and block.get_item_count_in_slot(slot) > 0 and equals(held.unwrap(), wanted) {
            found = found + block.get_item_count_in_slot(slot)
        }
        slot = slot + 1
    }
    return found
}

local _in_pipe(pipe: BlockEntity, wanted: Item) number {
    found: number = 0
    index: number = 0
    records: number = pipe.get_saved_list_size("traveling")
    while index < records {
        held: Option[Item] = pipe.get_saved_list_item("traveling", index)
        if held.has() and equals(held.unwrap(), wanted) {
            found = found + pipe.get_saved_list_number("traveling", index, "count")
        }
        index = index + 1
    }
    return found
}

# The items a wooden pipe's extraction inbox holds, whatever kind they are.
local _inbox(pipe: BlockEntity) number {
    if not pipe.get_item_in_slot(0).has() {
        return 0
    }
    return pipe.get_item_count_in_slot(0)
}

# A pipe's travelling records, one of which is counted by _in_pipe only once its item is written.
local _records(pipe: BlockEntity) number {
    return pipe.get_saved_list_size("traveling")
}
