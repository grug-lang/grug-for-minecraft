# Covers a broken pipe dropping the travelling items it holds, as PipeTransportItems.dropContents
# does through Utils.dropItems: one item entity per travelling record, holding that record's whole
# stack, at a random point inside the block, with the EntityItem constructor's hop of -0.1 to 0.1 on
# x and z and 0.2 up, and the damage kept. Each pipe has a chest to pull from and no exit, so its
# items are still travelling when the block is replaced with air, which is what fires the block's
# on_break. The second pipe carries a stack of more than one, which is the record whose whole stack
# has to reach one entity.
break_damage: number = 7
break_stack_count: number = 5

export tick(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x - 1, y, z, "minecraft:chest")
    level.place_block(x, y, z, "grug:wooden_pipe")
    level.place_block(x + 3, y, z, "minecraft:chest")
    level.place_block(x + 4, y, z, "grug:wooden_pipe")

    source: BlockEntity = level.get_block_entity(x - 1, y, z).unwrap()
    pipe: BlockEntity = level.get_block_entity(x, y, z).unwrap()
    stack_source: BlockEntity = level.get_block_entity(x + 3, y, z).unwrap()
    stack_pipe: BlockEntity = level.get_block_entity(x + 4, y, z).unwrap()

    sword: Item = item(resource_location("minecraft:diamond_sword"))
    source.set_item_in_slot(0, sword, 1)
    source.set_item_damage_in_slot(0, break_damage)

    diamond: Item = item(resource_location("minecraft:diamond"))
    stack_source.set_item_in_slot(0, diamond, break_stack_count)

    pipe.receive_energy(1)
    Test.tick_block_entity(pipe, 1)
    ctx.assert(pipe.get_saved_list_size("traveling") == 1, "The pull should have started one travelling item.")

    # 64 energy, so the pull takes the slot's whole stack rather than being limited by the energy.
    stack_pipe.receive_energy(64)
    Test.tick_block_entity(stack_pipe, 1)
    ctx.assert(stack_pipe.get_saved_list_size("traveling") == 1, "The pull should have started one travelling stack.")
    ctx.assert(stack_pipe.get_saved_list_number("traveling", 0, "count") == break_stack_count, "The travelling stack should hold the whole stack.")

    # Placing air is how a test breaks a block; every loader calls the old block's removal there.
    level.place_block(x, y, z, "minecraft:air")
    level.place_block(x + 4, y, z, "minecraft:air")
    ctx.assert(level.is_air(x, y, z), "The pipe should be gone.")
    ctx.assert(level.is_air(x + 4, y, z), "The second pipe should be gone.")

    # A radius that holds one pipe's block and not the other's, which is four blocks away.
    dropped: number = level.count_item_entities(x, y, z, 2)
    ctx.assert(dropped == 1, "The broken pipe should have dropped its one travelling item.")
    stack_dropped: number = level.count_item_entities(x + 4, y, z, 2)
    ctx.assert(stack_dropped == 1, "The broken pipe should have dropped its whole stack as one item entity.")

    found: Option[ItemEntity] = level.find_item_entity(x, y, z, 2)
    ctx.assert(found.has(), "The dropped item should be on the ground.")
    ctx.assert(found.unwrap().damage() == break_damage, "The dropped item should keep its damage.")

    stack_found: Option[ItemEntity] = level.find_item_entity(x + 4, y, z, 2)
    ctx.assert(stack_found.has(), "The dropped stack should be on the ground.")
    ctx.assert(stack_found.unwrap().count() == break_stack_count, "The dropped item entity should hold the whole stack.")

    # Utils.dropItems keeps the EntityItem constructor's hop, which the old drop zeroed. Every
    # version draws x and z uniformly within 0.1: 1.2.5, Alpha and both b1.7.3 loaders multiply
    # Math.random() by 0.2 and subtract 0.1, and 1.20.6 does the same with the level's random. The
    # older four store the draw as a float, so the bound allows the float32 expansion of 0.1 rather
    # than emulating the rounding. Every version fixes y at 0.2, but those four write 0.2F, whose
    # double expansion is 0.20000000298023224, where 1.20.6 writes the double 0.2, so the y check
    # allows 1e-6 around the reference's 0.2 and still fails a zeroed motion.
    motion: Vec3 = stack_found.unwrap().entity().get_delta_movement()
    ctx.assert(motion.x() > -0.100001 and motion.x() < 0.100001, "The hop's x should stay within the constructor's random 0.1.")
    ctx.assert(motion.z() > -0.100001 and motion.z() < 0.100001, "The hop's z should stay within the constructor's random 0.1.")
    # Utils.dropItems makes a broken pipe's drop wait 10 ticks, and no entity has ticked since.
    ctx.assert(found.unwrap().pickup_delay() == 10, "A broken pipe's item should wait 10 ticks before it can be picked up.")
    ctx.assert(stack_found.unwrap().pickup_delay() == 10, "A broken pipe's stack should wait 10 ticks before it can be picked up.")

    ctx.assert(motion.y() > 0.199999 and motion.y() < 0.200001, "The hop's y should be the constructor's 0.2, within a float's expansion.")

    ctx.assert(source.get_item_count_in_slot(0) == 0, "The source chest should be empty.")
    ctx.assert(stack_source.get_item_count_in_slot(0) == 0, "The second source chest should be empty.")
}
