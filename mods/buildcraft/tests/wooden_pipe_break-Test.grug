# Covers a broken pipe dropping the travelling items it holds, as PipeTransportItems.dropContents
# does through Utils.dropItems: one item entity per item at a random point inside the block, with no
# velocity, and the damage kept. The pipe has a chest to pull from and no exit, so the item is still
# travelling when the block is replaced with air, which is what fires the block's on_break.
break_damage: number = 7

export tick(ctx: TestTickContext) {
    level: Level = Test.get_client_level()
    origin: Vec3 = Test.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 20
    z: number = origin.z()

    level.place_block(x - 1, y, z, "minecraft:chest")
    level.place_block(x, y, z, "grug:wooden_pipe")

    source: BlockEntity = level.get_block_entity(x - 1, y, z).unwrap()
    pipe: BlockEntity = level.get_block_entity(x, y, z).unwrap()

    sword: Item = item(resource_location("minecraft:diamond_sword"))
    source.set_item_in_slot(0, sword, 1)
    source.set_item_damage_in_slot(0, break_damage)

    pipe.receive_energy(1)
    Test.tick_block_entity(pipe, 1)
    ctx.assert(pipe.get_saved_list_size("traveling") == 1, "The pull should have started one travelling item.")

    # Placing air is how a test breaks a block; every loader calls the old block's removal there.
    level.place_block(x, y, z, "minecraft:air")
    ctx.assert(level.is_air(x, y, z), "The pipe should be gone.")

    dropped: number = level.count_item_entities(x, y, z, 10)
    ctx.assert(dropped == 1, "The broken pipe should have dropped its one travelling item.")

    found: Option[ItemEntity] = level.find_item_entity(x, y, z, 10)
    ctx.assert(found.has(), "The dropped item should be on the ground.")
    ctx.assert(found.unwrap().damage() == break_damage, "The dropped item should keep its damage.")
    ctx.assert(source.get_item_count_in_slot(0) == 0, "The source chest should be empty.")
}
