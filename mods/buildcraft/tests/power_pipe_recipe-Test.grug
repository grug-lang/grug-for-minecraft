# The three conductive pipes' recipes have to craft one pipe each from redstone above the matching
# item pipe, as BuildCraftTransport.createPipe registers them (yr.aC, the item pipe, with the two-row
# shape "A ", "B "). It is asked of a crafting grid, as wooden_pipe_recipe does, and the loaders that
# register no mod recipes skip it.
# Band 8, as wooden_pipe_recipe: the two tests never run together.
export tick(ctx: TestTickContext) {
    # A loader that registers no mod recipe answers the grid with nothing, so the loader is asked
    # rather than assumed.
    if not me.registers_mod_recipes() {
        return
    }

    level: Level = ctx.get_client_level()
    origin: Vec3 = ctx.get_origin()
    x: number = origin.x()
    y: number = origin.y() + 8
    z: number = origin.z()

    _check(ctx, level, x, y, z, "grug:wooden_pipe", "grug:wooden_power_pipe", "wooden")
    _check(ctx, level, x + 4, y, z, "grug:stone_pipe", "grug:stone_power_pipe", "stone")
    _check(ctx, level, x + 8, y, z, "grug:golden_pipe", "grug:golden_power_pipe", "golden")
}

# One recipe: redstone in the grid's top-left slot and the item pipe below it, which is slots 0 and 3.
local _check(ctx: TestTickContext, level: Level, x: number, y: number, z: number, base: string, result: string, name: string) {
    redstone: Item = item(resource_location("minecraft:redstone"))
    pipe: Item = item(resource_location(base))
    made: Item = item(resource_location(result))

    grid: BlockEntity = _grid(ctx, level, x, y, z)
    grid.set_item_in_slot(0, redstone, 1)
    grid.set_item_in_slot(3, pipe, 1)
    grid.update_recipe_output(0)

    found: Option[Item] = grid.get_crafting_result_item()
    ctx.assert(found.has(), String.concat("Redstone above a ", String.concat(name, " pipe should craft a conductive pipe.")))
    ctx.assert(equals(found.unwrap(), made), String.concat("The ", String.concat(name, " recipe should answer its conductive pipe.")))
    ctx.assert(grid.take_crafting_result(1) == 1, String.concat("The ", String.concat(name, " recipe should give one pipe.")))
}

# The coverage block's block entity has the nine slots a crafting grid reads, which is why this is
# the block to place rather than a chest or the autocrafting table.
local _grid(ctx: TestTickContext, level: Level, x: number, y: number, z: number) BlockEntity {
    level.place_block(x, y, z, "grug:coverage_block")
    found: Option[BlockEntity] = level.get_block_entity(x, y, z)
    ctx.assert(found.has(), "The coverage block should have a block entity after being placed.")
    return found.unwrap()
}
