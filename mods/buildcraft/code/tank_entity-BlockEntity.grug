# BuildCraft 2.2.14's TileTank: a tank holds one liquid, at most 16000 mB of it, and refuses a
# second liquid until it is empty. The amount and the liquid are saved, not member variables,
# because a member variable starts over whenever the tank's chunk is loaded again and TileTank
# keeps both in its NBT.
# The rest of the tile is the liquid's own state and nothing else.
# The tank holds the liquid itself; a pipe or a script asks it through the liquid exports, and the
# host dispatches to them. That is the reference's ILiquidContainer: fill, empty, getLiquidId,
# getLiquidQuantity and getCapacity.
# Tanks stacked in a column are one store, as TileTank makes them: fill starts at the bottom tank and
# spills upward, and empty starts at the top tank and draws downward. offer_liquid and take_liquid
# are the ways into the column and walk it; offer_liquid_here and take_liquid_here are one tank's
# share of that walk, which is TileTank.actualFill and actualEmtpy.
level: Level = me.level()
pos: BlockPos = me.block_pos()
center: Vec3 = pos.center()
x: number = center.x()
y: number = center.y()
z: number = center.z()

# TileTank.capacity.
capacity: number = 16000

# TileTank.fill: a column of tanks is one store, so the offer enters at the bottom tank, which is
# where fill's loop stops, and actualFill there takes what it can and passes the rest up.
export offer_liquid(liquid: string, amount: number, from_side: number, fill: bool, response: LiquidResponse) {
    bottom_y: number = y
    below: string = level.get_block(x, bottom_y - 1, z)
    while below == "grug:tank" {
        bottom_y = bottom_y - 1
        below = level.get_block(x, bottom_y - 1, z)
    }
    bottom_opt: Option[BlockEntity] = level.get_block_entity(x, bottom_y, z)
    if not bottom_opt.has() {
        response.answer_amount(0)
        return
    }
    bottom: BlockEntity = bottom_opt.unwrap()
    taken: number = bottom.offer_liquid_here(liquid, amount, from_side, fill)
    response.answer_amount(taken)
}

# TileTank.actualFill: one tank's share of a column's fill. A different liquid than the one it holds
# is refused and goes no further, it takes the room left, and what is still offered goes to the tank
# above, which is actualFill's recursion. The answer is the share the whole column took.
export offer_liquid_here(liquid: string, amount: number, from_side: number, fill: bool, response: LiquidResponse) {
    stored: number = me.get_saved_number("amount")
    if stored > 0 {
        held: Option[string] = me.get_saved_string("liquid")
        if held.has() {
            if held.unwrap() != liquid {
                response.answer_amount(0)
                return
            }
        }
    }
    if amount <= 0 {
        response.answer_amount(0)
        return
    }

    room: number = capacity - stored
    taken: number = amount
    if taken > room {
        taken = room
    }
    if taken < 0 {
        taken = 0
    }
    if fill and taken > 0 {
        me.set_saved_string("liquid", liquid)
        me.set_saved_number("amount", stored + taken)
    }

    left: number = amount - taken
    if left > 0 {
        above_block: string = level.get_block(x, y + 1, z)
        if above_block == "grug:tank" {
            above_opt: Option[BlockEntity] = level.get_block_entity(x, y + 1, z)
            if above_opt.has() {
                above: BlockEntity = above_opt.unwrap()
                taken = taken + above.offer_liquid_here(liquid, left, from_side, fill)
            }
        }
    }
    response.answer_amount(taken)
}

# TileTank.empty: the draw enters at the top tank, which is where empty's loop stops, and
# actualEmtpy there gives what it has and draws the rest from below.
export take_liquid(amount: number, take: bool, response: LiquidResponse) {
    top_y: number = y
    above: string = level.get_block(x, top_y + 1, z)
    while above == "grug:tank" {
        top_y = top_y + 1
        above = level.get_block(x, top_y + 1, z)
    }
    top_opt: Option[BlockEntity] = level.get_block_entity(x, top_y, z)
    if not top_opt.has() {
        response.answer_amount(0)
        return
    }
    top: BlockEntity = top_opt.unwrap()
    given: number = top.take_liquid_here(amount, take)
    response.answer_amount(given)
}

# TileTank.actualEmtpy: one tank's share of a column's draw. It gives what it holds at most, and what
# is still wanted is drawn from the tank below, which is actualEmtpy's recursion. The reference does
# not look at the liquid here, so a column holding two liquids answers with their sum; the port keeps
# that. The answer is the share the whole column gave.
export take_liquid_here(amount: number, take: bool, response: LiquidResponse) {
    if amount <= 0 {
        response.answer_amount(0)
        return
    }

    stored: number = me.get_saved_number("amount")
    given: number = amount
    if given > stored {
        given = stored
    }
    if take {
        me.set_saved_number("amount", stored - given)
        if stored - given <= 0 {
            me.set_saved_string("liquid", "")
        }
    }

    left: number = amount - given
    if left > 0 {
        below_block: string = level.get_block(x, y - 1, z)
        if below_block == "grug:tank" {
            below_opt: Option[BlockEntity] = level.get_block_entity(x, y - 1, z)
            if below_opt.has() {
                below: BlockEntity = below_opt.unwrap()
                given = given + below.take_liquid_here(left, take)
            }
        }
    }
    response.answer_amount(given)
}

# TileTank.getLiquidId: the liquid it holds, or none when it holds nothing. An amount of 0 is no
# liquid whatever the saved name says, which is how the reference's liquidId 0 reads.
export get_liquid(response: LiquidResponse) {
    if me.get_saved_number("amount") <= 0 {
        response.answer_none()
        return
    }
    held: Option[string] = me.get_saved_string("liquid")
    if not held.has() {
        response.answer_none()
        return
    }
    response.answer_liquid(held.unwrap())
}

export get_liquid_amount(response: LiquidResponse) {
    response.answer_amount(me.get_saved_number("amount"))
}

export get_liquid_capacity(response: LiquidResponse) {
    response.answer_amount(capacity)
}

# BlockTank.d: a side draws 97 when the block below is a tank and 96 otherwise, which removes the
# bottom rim so stacked tanks read as one tall tank. The walls are the reference's 12 by 12 box, and
# its texture's frame sits on the model's edge, so the transparent part is the window.
export render(ctx: RenderContext) {
    if level.get_block(x, y - 1, z) == "grug:tank" {
        ctx.draw_model(r"assets/grug/models/block/tank_joined.json", 0, 0, 0, 0, 0, 0)
    } else {
        ctx.draw_model(r"assets/grug/models/block/tank.json", 0, 0, 0, 0, 0, 0)
    }
}

# RenderTank: the liquid column, 100 stages of a hundredth of the block each, from just inside the
# walls. The stage is (int)(qty / capacity * 99), so a full tank draws 0.99 of the block and not 1.
# It draws no column when it holds nothing, and a stage of 0 is an empty column.
export render_frame(ctx: RenderFrameContext) {
    stored: number = me.get_saved_number("amount")
    if stored <= 0 {
        return
    }
    held: Option[string] = me.get_saved_string("liquid")
    if not held.has() {
        return
    }

    stage: number = Math.floor(stored / capacity * 99)
    height: number = stage / 100
    if height <= 0 {
        return
    }
    ctx.draw_liquid(held.unwrap(), 0.135, 0.0, 0.135, 0.865, height, 0.865)
}
