# BuildCraft 2.2.14's wooden engine, EngineWood, as far as its energy goes. While a redstone signal
# reaches the engine's block it gains one energy on every tick the world's time is a multiple of 20,
# and while none does it loses one every tick, down to 1. The energy decides the engine's stage, and
# the stage decides which colour of trunk it draws: blue, green, yellow or red, as RenderEngine does.
# The energy is a saved number rather than a member variable, because a member variable starts over
# whenever the engine's chunk is loaded again, and the reference keeps its energy in the tile's NBT.

# TODO: Change to me.level() and me.block_pos() once entities can have methods
level: Level = get_block_entity_level(me)
pos: BlockPos = get_block_pos_of_block_entity(me)
center: Vec3 = pos.center()
x: number = center.x()
y: number = center.y()
z: number = center.z()

# The engine at rest: the base, the piston plate on it and the trunk through both, with the trunk in
# its stage's colour. The models differ only in the trunk's texture.
export render() {
    stage: number = _stage(get_saved_number(me, "energy"))
    if stage == 0 {
        draw_model(r"assets/grug/models/block/redstone_engine.json")
    } else if stage == 1 {
        draw_model(r"assets/grug/models/block/redstone_engine_green.json")
    } else if stage == 2 {
        draw_model(r"assets/grug/models/block/redstone_engine_yellow.json")
    } else {
        draw_model(r"assets/grug/models/block/redstone_engine_red.json")
    }
}

export tick() {
    # BlockEngine.c picks the facing when the engine is placed. The port does it on the first tick
    # instead, because the moment a block entity is created differs by loader (#187), so this is the
    # one hook that is the same everywhere.
    if get_saved_number(me, "oriented") == 0 {
        set_saved_number(me, "orientation", _pick_orientation())
        set_saved_number(me, "oriented", 1)
    }

    before: number = get_saved_number(me, "energy")
    energy: number = before

    if level.has_neighbor_signal(x, y, z) {
        if Math.remainder(level.get_time(), 20) == 0 {
            energy = energy + 1
        }
    } else if energy > 1 {
        # Engine.update.
        energy = energy - 1
    }

    if energy == before {
        return
    }
    set_saved_number(me, "energy", energy)

    # Drawing the engine again costs a chunk's worth of work, so it is only asked for when the trunk
    # it draws changes colour.
    if _stage(energy) != _stage(before) {
        redraw(me)
    }
}

# Engine.computeEnergyStage for EngineWood's maxEnergy of 1000: 0 is blue up to 25% of it, 1 green up
# to 50%, 2 yellow up to 75% and 3 red above that. The reference calls anything above 100% Explosion,
# and RenderEngine draws that with the red trunk too.
local _stage(energy: number) number {
    if energy <= 250 {
        return 0
    }
    if energy <= 500 {
        return 1
    }
    if energy <= 750 {
        return 2
    }
    return 3
}

# TileEngine.switchOrientation for a fresh engine, whose orientation is 1. The search starts after
# the current orientation, wraps round and stops at the first side with a power receptor next to it,
# so 2, 3, 4, 5, 0, 1 are visited. With no receptor it stays 1.
local _pick_orientation() number {
    i: number = 2
    while i <= 7 {
        side: number = Math.remainder(i, 6)
        if _is_powered_tile(_neighbor_x(side), _neighbor_y(side), _neighbor_z(side)) {
            return side
        }
        i = i + 1
    }
    return 1
}

# TileEngine.isPoweredTile: an IPowerReceptor, which here is a wooden pipe or another engine.
local _is_powered_tile(nx: number, ny: number, nz: number) bool {
    block: string = level.get_block(nx, ny, nz)
    return block == "grug:wooden_pipe" or block == "grug:redstone_engine"
}

local _neighbor_x(side: number) number {
    if side == 4 {
        return x - 1
    }
    if side == 5 {
        return x + 1
    }
    return x
}

local _neighbor_y(side: number) number {
    if side == 0 {
        return y - 1
    }
    if side == 1 {
        return y + 1
    }
    return y
}

local _neighbor_z(side: number) number {
    if side == 2 {
        return z - 1
    }
    if side == 3 {
        return z + 1
    }
    return z
}
