# BuildCraft 2.2.14's wooden engine, EngineWood, as far as its energy goes. While a redstone signal
# reaches the engine's block it gains one energy on every tick the world's time is a multiple of 20,
# and while none does it loses one every tick, down to 1. The energy decides the engine's stage, and
# the stage decides which colour of trunk it draws: blue, green, yellow or red, as RenderEngine does.
# The energy is a saved number rather than a member variable, because a member variable starts over
# whenever the engine's chunk is loaded again, and the reference keeps its energy in the tile's NBT.

# The progress the engine was last drawn with. A member variable, since a chunk that is loaded again
# draws the engine from its saved progress anyway.
drawn_progress: number = 0

level: Level = me.level()
pos: BlockPos = me.block_pos()
center: Vec3 = pos.center()
x: number = center.x()
y: number = center.y()
z: number = center.z()

# TileEngine.progressPart: 0 while the piston rests, 1 while it moves out and 2 once it has handed
# its energy over, until progress passes 1. The reference does not write it to the tile's NBT, so
# it is a member variable that starts over at 0 whenever the engine's chunk is loaded again, while
# the saved number "progress" keeps its value, and the next stroke carries on from that.
progress_part: number = 0

# TileEngine.initialize configures the engine's power provider: it holds at most the engine's
# maxEnergy, 1000. Nothing in 2.2.14 calls PowerFramework.savePowerProvider for an engine, so what
# the provider holds is lost when its chunk unloads. The energy host functions save what a receiver
# holds, so the engine reproduces that by emptying its store whenever its grug entity is created,
# which is every time its chunk is loaded, as the wooden pipe does.
export init() {
    me.set_power_receiver(1000)
    me.extract_energy(1000)
}

# The engine as RenderEngine draws it, turned to face the way the engine does, with the trunk in its
# stage's colour. RenderEngine turns one set of boxes by an angle per orientation, and the models
# differ only in the trunk's texture, so a model is written per colour and turned here. See
# _x_degrees and _z_degrees. The base and the trunk stay where they are. The plate slides along the
# facing by the step its saved progress gives, and the chamber boxes stack from the base up to the
# plate, which is what the reference draws while the engine works. The reference reads the same
# progress on every frame of a tick, so the picture only changes once per tick, and a redraw per tick
# of a stroke is as often as it needs to be drawn again. See _redraw_if_moved.
export render() {
    stage: number = _stage(me.get_saved_number("energy"))
    facing: number = _facing()
    x_degrees: number = _x_degrees(facing)
    z_degrees: number = _z_degrees(facing)
    # The reference draws the base, then the plate, then the chamber boxes and the trunk last, and
    # the order is kept because faces that share a plane, where one engine's trunk meets the next
    # engine's plate, are won by whichever is drawn last.
    draw_model(r"assets/grug/models/block/redstone_engine_base.json", x_degrees, 0, z_degrees, 0, 0, 0)

    # The distance along the facing in blocks, and which way along each world axis the facing goes.
    step: number = _step(me.get_saved_number("progress"))
    unit: number = step / 16
    dir_x: number = _dir_x(facing)
    dir_y: number = _dir_y(facing)
    dir_z: number = _dir_z(facing)

    draw_model(r"assets/grug/models/block/redstone_engine_plate.json", x_degrees, 0, z_degrees, dir_x * unit, dir_y * unit, dir_z * unit)

    # A chamber box every two pixels from the base, for as long as it is not past the plate by more
    # than two pixels, as the reference's loop does. At rest that is two boxes, and the second has its
    # far face in the plate's far plane, so the reference z-fights those faces too and which one a
    # pixel shows depends on the renderer's rounding. On 1.20.6 it shows as a sliver of the box's
    # edge at the sideways engines in redstone_engine_facings.
    pixels: number = 0
    while pixels <= step + 2 {
        offset: number = pixels / 16
        draw_model(r"assets/grug/models/block/redstone_engine_chamber.json", x_degrees, 0, z_degrees, dir_x * offset, dir_y * offset, dir_z * offset)
        pixels = pixels + 2
    }

    if stage == 0 {
        draw_model(r"assets/grug/models/block/redstone_engine_blue.json", x_degrees, 0, z_degrees, 0, 0, 0)
    } else if stage == 1 {
        draw_model(r"assets/grug/models/block/redstone_engine_green.json", x_degrees, 0, z_degrees, 0, 0, 0)
    } else if stage == 2 {
        draw_model(r"assets/grug/models/block/redstone_engine_yellow.json", x_degrees, 0, z_degrees, 0, 0, 0)
    } else {
        draw_model(r"assets/grug/models/block/redstone_engine_red.json", x_degrees, 0, z_degrees, 0, 0, 0)
    }
}

export tick() {
    _redraw_if_moved()

    # BlockEngine.c picks the facing when the engine is placed. The port does it on the first tick
    # instead, because the moment a block entity is created differs by loader (#187), so this is the
    # one hook that is the same everywhere. The block sets "rotate" when a player right-clicks it with
    # the wrench, which BlockEngine.b answers with the same search.
    if me.get_saved_number("oriented") == 0 {
        me.set_saved_number("orientation", 1)
        me.set_saved_number("oriented", 1)
        _switch_orientation()
    }
    if me.get_saved_number("rotate") == 1 {
        me.set_saved_number("rotate", 0)
        _switch_orientation()
    }

    before: number = me.get_saved_number("energy")

    # TileBuildCraft.n_ updates the power provider first, which is before Engine.update. Its power
    # loss comes after doWork has emptied the store, so it never has anything to take, and it is not
    # modelled.
    if me.get_energy_stored() >= 1 {
        # TileEngine.doWork: the energy of a provider holding at most 50 goes in through addEnergy,
        # cut to 95% as a float and truncated, so a lone stroke's 1 energy adds 0 and two strokes that
        # arrive before the engine's tick add 1. The float cast gives Math.floor(n * 0.95) for every
        # n the store can hold.
        _add_energy(Math.floor(me.extract_energy(50) * 0.95))

        # The explosion can have destroyed this engine, and then there is nothing left to tick.
        if not _exists() {
            return
        }
    }

    stored: number = me.get_saved_number("energy")
    energy: number = stored

    if level.has_neighbor_signal(x, y, z) {
        if Math.remainder(level.get_time(), 20) == 0 {
            energy = energy + 1
        }
    } else if energy > 1 {
        # Engine.update.
        energy = energy - 1
    }

    if energy != stored {
        me.set_saved_number("energy", energy)
    }

    _stroke()

    # Drawing the engine again costs a chunk's worth of work, so it is only asked for when the trunk
    # it draws changes colour. The stroke can lower the energy too.
    if _stage(me.get_saved_number("energy")) != _stage(before) {
        me.redraw()
    }
}

# Draws the engine again when its saved progress is not the one it was drawn with. This is the whole
# cost of the animation: a stroke changes the progress every tick, so it is a redraw per tick, and an
# engine at rest or at a stage's standstill (no stroke, progress unchanged) costs nothing.
local _redraw_if_moved() {
    progress: number = me.get_saved_number("progress")
    if progress != drawn_progress {
        drawn_progress = progress
        me.redraw()
    }
}

# RenderEngine's step for a progress: the plate goes out and back in once per stroke, by up to 7.99
# pixels, so it is at its farthest at a progress of 0.5.
local _step(progress: number) number {
    if progress > 0.5 {
        return 7.99 - (progress - 0.5) * 2 * 7.99
    }
    return progress * 2 * 7.99
}

# Engine.addEnergy. The reference adds the energy, explodes with explosionRange(), 1 for the wood
# engine, when that leaves it above maxEnergy, and then cuts it to maxEnergy. The explosion is at the
# block's corner, where the reference passes the tile's integer coordinates, and not at its centre.
local _add_energy(addition: number) {
    energy: number = me.get_saved_number("energy") + addition
    if energy > 1000 {
        level.explode(x - 0.5, y - 0.5, z - 0.5, 1)
        energy = 1000

        # An engine the explosion destroyed has no energy left to cut.
        if not _exists() {
            return
        }
    }
    me.set_saved_number("energy", energy)
}

# Whether this engine's block is still in the world.
local _exists() bool {
    return level.get_block(x, y, z) == "grug:redstone_engine"
}

# The rest of TileEngine.n_ on the server, after Engine.update: the piston moves by the speed of
# the current stage, hands one stroke's energy to the receptor it faces once it is past halfway, and
# comes to rest again at 1. A resting piston starts a stroke when the engine has a redstone signal
# and the receptor would take energy.
local _stroke() {
    energy: number = me.get_saved_number("energy")

    if progress_part != 0 {
        progress: number = me.get_saved_number("progress") + _piston_speed(energy)
        me.set_saved_number("progress", progress)

        if progress > 0.5 and progress_part == 1 {
            progress_part = 2
            if _faces_receptor() {
                extracted: number = _extract_energy(true)
                if extracted > 0 {
                    _hand_energy(extracted)
                }
            }
        } else if progress >= 1 {
            me.set_saved_number("progress", 0)
            progress_part = 0
        }
    } else if level.has_neighbor_signal(x, y, z) {
        if _faces_receptor() and _extract_energy(false) > 0 {
            progress_part = 1
        }
    }
}

# Engine.extractEnergy with a receptor minimum of 1 and a maximum of 1, the wood engine's
# maxEnergyExtracted. The receptor's own minimum and maximum are not exposed to grug, because no
# ported receptor has a minimum above 1. Only a real extraction takes the energy off the engine.
local _extract_energy(do_extract: bool) number {
    energy: number = me.get_saved_number("energy")
    if energy < 1 {
        return 0
    }
    if do_extract {
        me.set_saved_number("energy", energy - 1)
    }
    return 1
}

# Engine.getPistonSpeed per stage: 0.01, 0.02, 0.04 and 0.08, and 0 for the Explosion stage, which is
# everything above maxEnergy. The wood engine's own energy++ is uncapped, so it can get there. The
# reference's progress is a Java float and grug numbers are doubles; the maintainer allowed adding
# in doubles, which only moves a stroke's delivery and reset by a tick (#406).
local _piston_speed(energy: number) number {
    if energy > 1000 {
        return 0
    }
    stage: number = _stage(energy)
    if stage == 0 {
        return 0.01
    }
    if stage == 1 {
        return 0.02
    }
    if stage == 2 {
        return 0.04
    }
    return 0.08
}

# The block in front of the engine, when it is a power receiver. TileEngine.isPoweredTile.
local _faces_receptor() bool {
    side: number = _facing()
    receptor: Option[BlockEntity] = level.get_block_entity(_neighbor_x(side), _neighbor_y(side), _neighbor_z(side))
    if not receptor.has() {
        return false
    }
    receptor_be: BlockEntity = receptor.unwrap()
    return receptor_be.is_power_receiver()
}

# PowerProvider.receiveEnergy on the receptor in front of the engine. Only called after
# _faces_receptor.
local _hand_energy(amount: number) {
    side: number = _facing()
    receptor: BlockEntity = level.get_block_entity(_neighbor_x(side), _neighbor_y(side), _neighbor_z(side)).unwrap()
    receptor.receive_energy(amount)
}

# Engine.computeEnergyStage for EngineWood's maxEnergy of 1000: 0 is blue up to 25% of it, 1 green up
# to 50%, 2 yellow up to 75% and 3 red above that. The reference calls anything above 100% Explosion,
# and RenderEngine draws that with the red trunk too.
local _stage(energy: number) number {
    if energy <= 250 {
        return 0
    }
    if energy <= 500 {
        return 1
    }
    if energy <= 750 {
        return 2
    }
    return 3
}

# TileEngine.switchOrientation. The search starts after the current orientation, wraps round and
# stops at the first side with a power receptor next to it, so the current side is the last one tried.
# With no receptor the orientation stays as it was.
local _switch_orientation() {
    start: number = me.get_saved_number("orientation")
    i: number = start + 1
    while i <= start + 6 {
        side: number = Math.remainder(i, 6)
        if _is_powered_tile(_neighbor_x(side), _neighbor_y(side), _neighbor_z(side)) {
            me.set_saved_number("orientation", side)

            # It was drawn along the old orientation until now, so only another one needs drawing again.
            if side != start {
                me.redraw()
            }
            return
        }
        i = i + 1
    }
}

# TileEngine.isPoweredTile: an IPowerReceptor, which here is a wooden pipe or another engine.
local _is_powered_tile(nx: number, ny: number, nz: number) bool {
    block: string = level.get_block(nx, ny, nz)
    return block == "grug:wooden_pipe" or block == "grug:redstone_engine"
}

local _neighbor_x(side: number) number {
    if side == 4 {
        return x - 1
    }
    if side == 5 {
        return x + 1
    }
    return x
}

local _neighbor_y(side: number) number {
    if side == 0 {
        return y - 1
    }
    if side == 1 {
        return y + 1
    }
    return y
}

local _neighbor_z(side: number) number {
    if side == 2 {
        return z - 1
    }
    if side == 3 {
        return z + 1
    }
    return z
}

# Until the engine has picked its facing on its first tick it faces up, as the reference's
# orientation starts out.
local _facing() number {
    if me.get_saved_number("oriented") == 0 {
        return 1
    }
    return me.get_saved_number("orientation")
}

# RenderEngine's angle about x for each orientation, as the clockwise degrees draw_model
# takes. The reference turns counter-clockwise, so its PI/2 for ZPos is 270 here and its -PI/2 for
# ZNeg is 90.
local _x_degrees(facing: number) number {
    if facing == 2 {
        return 90
    }
    if facing == 3 {
        return 270
    }
    return 0
}

# RenderEngine's angle about z for each orientation: PI for YNeg, -PI/2 for XPos and PI/2 for XNeg,
# in clockwise degrees. It turns about z rather than y for the sides, which keeps the engine's north
# face facing north.
local _z_degrees(facing: number) number {
    if facing == 0 {
        return 180
    }
    if facing == 4 {
        return 270
    }
    if facing == 5 {
        return 90
    }
    return 0
}

# The direction each orientation slides the plate in, as RenderEngine's translate array: -1 along y
# for YNeg, +1 for YPos, -1 and +1 along z for ZNeg and ZPos, and -1 and +1 along x for XNeg and
# XPos. The reference translates in the world's axes, after the turn.
local _dir_x(facing: number) number {
    if facing == 4 {
        return -1
    }
    if facing == 5 {
        return 1
    }
    return 0
}

local _dir_y(facing: number) number {
    if facing == 0 {
        return -1
    }
    if facing == 1 {
        return 1
    }
    return 0
}

local _dir_z(facing: number) number {
    if facing == 2 {
        return -1
    }
    if facing == 3 {
        return 1
    }
    return 0
}
