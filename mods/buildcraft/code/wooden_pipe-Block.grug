export init(ctx: BlockInitContext) {
    ctx.set_hardness(0.5)
    ctx.set_material("wood")
    ctx.set_block_entity(e"wooden_pipe_entity")
    # The reference's pipe is not a full cube: it is a centre with arms, so light reaches the items
    # travelling inside it. The block entity's render() draws that shape through the chunk hook,
    # which is also what keeps the block non-opaque and the items inside it lit.
    ctx.set_custom_render()
    # The reference's collision and selection boxes are the drawn centre-and-arms shape rather than
    # the full cube, so the pipe declares a shape the same way it declares its render.
    ctx.set_shape()
    # The reference's pipe has no inventory slots. The port keeps one as the extraction inbox:
    # extract_item_into has to name a slot for the stack a machine hands over, and the block entity
    # moves it into a travelling record and empties the slot again on the same tick. See the block
    # entity.
    ctx.set_inventory_size(1)
}

# Pipe.dropContents, which BlockGenericPipe calls when the pipe breaks: every travelling item is
# dropped where the pipe stands, at a random point inside the block, as Utils.dropItems does. The
# block entity's own helper cannot be called from here, because a block and its block entity are
# separate grug entities.
export on_break(world: Level, x: number, y: number, z: number) {
    pipe_opt: Option[BlockEntity] = world.get_block_entity(x, y, z)
    if pipe_opt.has() {
        _drop_travelling(world, x, y, z, pipe_opt.unwrap())
    }
}

# What entities collide with and what the game targets are one and the same box in the reference.
# BlockGenericPipe.a(...) sets the bounds of its centre and of each arm and then calls the base
# getCollidingBoundingBoxes, but that method reads getCollisionBoundingBoxFromPool, which the
# reference overrides (with c(...)) to recompute this union from the connections, so the per-arm
# bounds it just set are never read and the union is what entities actually collide with. c() is also
# the box the outline and the ray trace use, so the port declares that one union once, as the
# collision box, and its selection box defaults to it. The box starts at the centre's own corners and
# reaches this block's face on every side the pipe connects to, which is the same connection the
# reference's pipe render draws an arm for. The arms follow the neighbours, which is why the shape is
# asked for again on every query rather than saved here.
export shape(ctx: ShapeContext, world: Level, x: number, y: number, z: number) {
    min_x: number = 0.25
    min_y: number = 0.25
    min_z: number = 0.25
    max_x: number = 0.75
    max_y: number = 0.75
    max_z: number = 0.75

    if _is_connected(world, x, y, z, 4) {
        min_x = 0.0
    }
    if _is_connected(world, x, y, z, 5) {
        max_x = 1.0
    }
    if _is_connected(world, x, y, z, 0) {
        min_y = 0.0
    }
    if _is_connected(world, x, y, z, 1) {
        max_y = 1.0
    }
    if _is_connected(world, x, y, z, 2) {
        min_z = 0.0
    }
    if _is_connected(world, x, y, z, 3) {
        max_z = 1.0
    }

    ctx.add_collision_box(min_x, min_y, min_z, max_x, max_y, max_z)
}

# PipeLogicWood.blockActivated: a right click with the wrench makes the pipe extract from the next
# side that has an inventory. The block entity does it on its next tick, because only it knows its
# own side. Any other click is declined, as the reference returns false for it, so the held item is
# used or placed as usual.
export use(ctx: BlockUseContext, world: Level, x: number, y: number, z: number, player: Player) {
    held: Option[Item] = player.get_held_item()
    if held.has() {
        if equals(held.unwrap(), item(resource_location("grug:wrench"))) {
            pipe: Option[BlockEntity] = world.get_block_entity(x, y, z)
            if pipe.has() {
                pipe.unwrap().set_saved_number("rotate", 1)
            }
            return
        }
    }
    ctx.decline_use()
}

local _drop_travelling(world: Level, x: number, y: number, z: number, pipe: BlockEntity) {
    index: number = 0
    # Nothing is removed from the list here, so its size cannot change under the loop.
    records: number = pipe.get_saved_list_size("traveling")
    while index < records {
        item_opt: Option[Item] = pipe.get_saved_list_item("traveling", index)
        count: number = pipe.get_saved_list_number("traveling", index, "count")
        if item_opt.has() and count > 0 {
            damage: number = pipe.get_saved_list_number("traveling", index, "damage")
            # Utils.dropItems: each axis a random 0.15 to 0.85 into the block, no velocity.
            # item_stack makes a stack of one, so until #473 this is one entity per item, all at
            # that same point.
            dx: number = world.random_float() * 0.7 + 0.15
            dy: number = world.random_float() * 0.7 + 0.15
            dz: number = world.random_float() * 0.7 + 0.15
            remaining: number = count
            while remaining > 0 {
                stack: ItemStack = item_stack(item_opt.unwrap(), damage)
                dropped: ItemEntity = item_entity(world, x + dx, y + dy, z + dz, stack)
                dropped.entity().set_delta_movement(Vec3.zero())
                dropped.entity().spawn(world)
                remaining = remaining - 1
            }
        }
        index = index + 1
    }
}

# The same connection test as the block entity's _is_connected, which its render uses to decide
# where to draw an arm. A block and its block entity are separate grug entities and cannot share a
# helper, so this copy has to stay in step with that one: the shape a player is kept out of has to
# be the shape the pipe draws. It accepts any inventory, whatever its slots allow and whatever it
# holds right now, which is PipeTransportItems.isPipeConnected's `io` branch: a machine whose slots
# are all closed, or a chest that is empty, still has a box face.
local _is_connected(world: Level, x: number, y: number, z: number, side: number) bool {
    nx: number = _neighbor_x(x, side)
    ny: number = _neighbor_y(y, side)
    nz: number = _neighbor_z(z, side)
    if _is_pipe(world, nx, ny, nz) {
        return false
    }

    neighbor_opt: Option[BlockEntity] = world.get_block_entity(nx, ny, nz)
    if not neighbor_opt.has() {
        return false
    }
    return _is_inventory(neighbor_opt.unwrap(), _reverse(side))
}

# Whether a neighbour is an inventory at all, as the block entity's copy of this says. A machine
# that answers for itself is one too, whatever its slots allow and whatever it holds, and asking
# takes nothing.
local _is_inventory(neighbor: BlockEntity, from_side: number) bool {
    if neighbor.ask_extract_item(from_side) >= 0 {
        return true
    }
    return neighbor.get_inventory_size() > 0
}

# The side of a neighbour that faces the pipe, given the side of the pipe the neighbour is on. The
# sides pair up as 0 and 1, 2 and 3, 4 and 5, like Orientations.reverse.
local _reverse(side: number) number {
    if Math.remainder(side, 2) == 0 {
        return side + 1
    }
    return side - 1
}

local _is_pipe(world: Level, nx: number, ny: number, nz: number) bool {
    return world.get_block(nx, ny, nz) == "grug:wooden_pipe"
}

local _neighbor_x(x: number, side: number) number {
    if side == 4 {
        return x - 1
    }
    if side == 5 {
        return x + 1
    }
    return x
}

local _neighbor_y(y: number, side: number) number {
    if side == 0 {
        return y - 1
    }
    if side == 1 {
        return y + 1
    }
    return y
}

local _neighbor_z(z: number, side: number) number {
    if side == 2 {
        return z - 1
    }
    if side == 3 {
        return z + 1
    }
    return z
}
