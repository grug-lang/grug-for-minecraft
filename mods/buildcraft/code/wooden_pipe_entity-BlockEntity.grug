# The wooden pipe in outline: when it holds energy, it pulls as many items from one slot of the
# inventory it extracts from as it has energy, up to that slot's stack, into its own one-slot
# inventory, spending one energy per item, then pushes that stack on to the next inventory or pipe,
# or drops it when nothing accepts it. This is PipeItemsWood.doWork with the energy of its power
# provider, which the energy host functions model: the pipe is an energy receiver that holds at most
# 64 and loses 64 on every tick, so what it does not spend on the tick it arrives is gone.
# What the pipe may touch of that inventory is the inventory's own rule. A machine that defines the
# extract_item and add_item exports, as ISpecialInventory does in the reference, decides per side and
# per item what it hands the pipe and what it takes from it, and the pipe spends no energy on what it
# is handed. Any other inventory is read slot by slot through is_slot_extractable, which is what
# checkExtractGeneric does.
# This is not the full old BuildCraft pipe: it has no travelling item entity and no connection
# matrix. Instead it is one-slot buffered, it prefers a real inventory over another pipe so a chain
# of pipes feeds forward, and it only ever extracts from one side, so it cannot pump the same item
# back and forth between two inventories.
level: Level = me.level()
pos: BlockPos = me.block_pos()
center: Vec3 = pos.center()
x: number = center.x()
y: number = center.y()
z: number = center.z()

# The side the pipe extracts from is the pipe's block metadata in the reference, 0 to 5 for a side
# and 6 for none, and it is saved with the block entity as "source" plus one here, so that a pipe whose
# number was never saved reads as the reference's fresh metadata of 0. See _meta.

# PipeItemsWood's provider is configured with a maximum of 64 stored and a power loss of 64 on
# every tick (configure(50, 1, 64, 1, 64) and configurePowerPerdition(64, 1)), so the pipe holds at
# most 64 and ends every tick empty.

# Nothing in BuildCraft 2.2.14 calls PowerFramework.savePowerProvider, so the energy a pipe holds is
# lost when its chunk unloads. The energy host functions save what a receiver holds, so the pipe
# reproduces that bug itself by emptying its store whenever its grug entity is created, which is
# every time its chunk is loaded.
export init() {
    me.set_power_receiver(64)
    me.extract_energy(64)
}

export tick() {
    # BlockEngine's twin for the pipe is PipeLogicWood.blockActivated, which the block's use export
    # answers by setting "rotate". The reference also checks the side when the pipe is initialised and
    # whenever a neighbour changes, which a check every tick comes to the same as.
    if me.get_saved_number("rotate") == 1 {
        me.set_saved_number("rotate", 0)
        _switch_source()
    }
    _switch_source_if_needed()

    if me.get_item_count_in_slot(0) == 0 {
        _try_pull()
    } else {
        _try_push()
    }

    # PowerProvider.update's power loss, which comes after doWork.
    me.extract_energy(64)
}

# grug wants a helper defined after the first place it is called, so the helpers below are ordered
# by their callers rather than grouped by topic.
local _try_pull() {
    # PowerProvider.update calls doWork when the provider holds at least its activation energy, 1.
    if me.get_energy_stored() < 1 {
        return
    }

    input_side: number = _input_side()
    if input_side < 0 {
        return
    }

    nx: number = _neighbor_x(input_side)
    ny: number = _neighbor_y(input_side)
    nz: number = _neighbor_z(input_side)
    if _pull_from(nx, ny, nz) {
        return
    }
}

# The side the pipe extracts from, or -1 for none.
local _input_side() number {
    meta: number = _meta()
    if meta > 5 {
        return -1
    }
    return meta
}

# PipeLogicWood.switchSourceIfNeeded: a pipe with no side, or whose side no longer holds an
# inventory, looks for another.
local _switch_source_if_needed() {
    meta: number = _meta()
    if meta > 5 {
        _switch_source()
        return
    }
    if not _is_inventory(meta) {
        _switch_source()
    }
}

# PipeLogicWood.switchSource, which a fresh pipe and the wrench share: the search starts at the side
# after the current one and wraps round, so the current side is the last one tried, and with no
# inventory around the pipe has no side.
local _switch_source() {
    meta: number = _meta()
    i: number = meta + 1
    while i <= meta + 6 {
        side: number = Math.remainder(i, 6)
        if _is_inventory(side) {
            _set_meta(side)
            return
        }
        i = i + 1
    }
    _set_meta(6)
}

# The pipe's metadata as the reference reads it: 0 to 5 is the side it extracts from and 6 is none.
local _meta() number {
    stored: number = me.get_saved_number("source")
    if stored == 0 {
        return 0
    }
    return stored - 1
}

local _set_meta(meta: number) {
    me.set_saved_number("source", meta + 1)
}

local _is_inventory(side: number) bool {
    nx: number = _neighbor_x(side)
    ny: number = _neighbor_y(side)
    nz: number = _neighbor_z(side)
    if _is_pipe(nx, ny, nz) {
        return false
    }

    neighbor_opt: Option[BlockEntity] = level.get_block_entity(nx, ny, nz)
    if not neighbor_opt.has() {
        return false
    }
    return _has_extractable_slot(neighbor_opt.unwrap(), _reverse(side))
}

# The side of a neighbour that faces the pipe, given the side of the pipe the neighbour is on. The
# sides pair up as 0 and 1, 2 and 3, 4 and 5, like Orientations.reverse.
local _reverse(side: number) number {
    if Math.remainder(side, 2) == 0 {
        return side + 1
    }
    return side - 1
}

# Whether this inventory offers a pipe anything. The slot after the last inventory slot is the
# crafting result, which is not an inventory slot but is what a machine like the autocrafting table
# offers, and an inventory with no slots at all offers nothing, which is what keeps the redstone
# engine out of the pipe's way.
local _has_extractable_slot(neighbor: BlockEntity, from_side: number) bool {
    # A machine that answers for itself is a source whatever it holds right now, as every inventory
    # is in the reference. Asking takes nothing.
    if neighbor.ask_extract_item(from_side) >= 0 {
        return true
    }

    size: number = neighbor.get_inventory_size()
    if size <= 0 {
        return false
    }

    slot: number = 0
    while slot <= size {
        if neighbor.is_slot_extractable(slot) {
            return true
        }
        slot = slot + 1
    }
    return false
}

local _try_push() {
    item_opt: Option[Item] = me.get_item_in_slot(0)
    if not item_opt.has() {
        return
    }

    item: Item = item_opt.unwrap()

    # Real inventories first, so a pipe chain feeds forward instead of bouncing between pipes.
    if _push_to_inventory(item) {
        return
    }

    if _push_to_pipe(item) {
        return
    }

    _drop()
}

local _pull_from(nx: number, ny: number, nz: number) bool {
    neighbor_opt: Option[BlockEntity] = level.get_block_entity(nx, ny, nz)
    if not neighbor_opt.has() {
        return false
    }

    neighbor: BlockEntity = neighbor_opt.unwrap()

    # A machine that answers for itself hands over whatever it decides, as ISpecialInventory's
    # extractItem does, and the pipe spends no energy on it.
    from_side: number = _reverse(_input_side())
    offered: number = neighbor.ask_extract_item(from_side)
    if offered >= 0 {
        if offered == 0 {
            return false
        }
        return neighbor.extract_item_into(me, 0, from_side) > 0
    }

    size: number = neighbor.get_inventory_size()
    slot: number = 0
    while slot <= size {
        if neighbor.is_slot_extractable(slot) {
            if _take_from(neighbor, slot, size) {
                return true
            }
        }
        slot = slot + 1
    }

    return false
}

# Takes items from the slot the neighbour offers, as many as the pipe has energy for up to the slot's
# stack, which is checkExtractGeneric's inventory.a(slot, useEnergy(1, slot.a, true)): the energy is
# spent for the whole stack taken, in one go. Everything but the slot after the last inventory slot is
# a plain inventory slot; that one is the crafting result, which only take_crafting_result reaches, so
# it is read and taken through its own pair of functions.
local _take_from(neighbor: BlockEntity, slot: number, size: number) bool {
    if slot == size {
        return _take_crafting_result(neighbor)
    }

    count: number = neighbor.get_item_count_in_slot(slot)
    if count == 0 {
        return false
    }

    item_opt: Option[Item] = neighbor.get_item_in_slot(slot)
    if not item_opt.has() {
        return false
    }

    # Read the damage before taking, because taking empties the slot.
    damage: number = neighbor.get_item_damage_in_slot(slot)
    # take_item_from_slot, not extract_item_from_inventory. They look interchangeable, but only the
    # former calls removeItem and then fires output_taken, which is what drives the autocrafting
    # table's restock and craft loop. extract_item_from_inventory only fires item_extracted, which
    # the table ignores for its output slot.
    spent: number = me.extract_energy(count)
    taken: number = neighbor.take_item_from_slot(slot, spent)
    if taken == 0 {
        return false
    }

    _store(item_opt.unwrap(), damage, taken)
    return true
}

# A machine's crafting result that is offered as an extractable slot, rather than answered through
# the extract_item export, is not a slot with a stack to size the pull by, so the pipe pulls one item
# of it at a time and spends one energy for it.
local _take_crafting_result(neighbor: BlockEntity) bool {
    result_opt: Option[Item] = neighbor.get_crafting_result_item()
    if not result_opt.has() {
        return false
    }

    damage: number = neighbor.get_crafting_result_damage()
    if neighbor.take_crafting_result(1) == 0 {
        return false
    }

    me.extract_energy(1)
    _store(result_opt.unwrap(), damage, 1)
    return true
}

local _store(item: Item, damage: number, count: number) {
    me.set_item_in_slot(0, item, count)
    me.set_item_damage_in_slot(0, damage)
}

local _push_to_inventory(item: Item) bool {
    input_side: number = _input_side()
    side: number = 0
    while side < 6 {
        if side != input_side {
            nx: number = _neighbor_x(side)
            ny: number = _neighbor_y(side)
            nz: number = _neighbor_z(side)
            if not _is_pipe(nx, ny, nz) {
                if _try_insert(nx, ny, nz, side, item) {
                    return true
                }
            }
        }
        side = side + 1
    }
    return false
}

local _push_to_pipe(item: Item) bool {
    input_side: number = _input_side()
    side: number = 0
    while side < 6 {
        if side != input_side {
            nx: number = _neighbor_x(side)
            ny: number = _neighbor_y(side)
            nz: number = _neighbor_z(side)
            if _is_pipe(nx, ny, nz) {
                if _try_insert(nx, ny, nz, side, item) {
                    return true
                }
            }
        }
        side = side + 1
    }
    return false
}

# Pushes the whole stack the pipe carries and keeps what the neighbour had no room for, which is
# pushed on the next tick, to this neighbour or another.
local _try_insert(nx: number, ny: number, nz: number, side: number, item: Item) bool {
    neighbor_opt: Option[BlockEntity] = level.get_block_entity(nx, ny, nz)
    if not neighbor_opt.has() {
        return false
    }

    neighbor: BlockEntity = neighbor_opt.unwrap()
    count: number = me.get_item_count_in_slot(0)
    damage: number = me.get_item_damage_in_slot(0)

    # A machine that answers for itself names the slot per item, like ISpecialInventory's addItem,
    # and answers -1 when it does not, which leaves the inventory's declared slots to decide.
    inserted: number = neighbor.add_item(item, damage, count, _reverse(side), true)
    if inserted < 0 {
        inserted = neighbor.insert_item_into_inventory(item, damage, count)
    }
    if inserted == 0 {
        return false
    }

    me.set_item_count_in_slot(0, count - inserted)
    return true
}

local _drop() {
    item_opt: Option[Item] = me.get_item_in_slot(0)
    if not item_opt.has() {
        return
    }

    # item_stack makes a stack of one, so a stack the pipe carries drops as that many items. Each
    # item entity takes ownership of its stack, so every one gets a stack of its own.
    remaining: number = me.get_item_count_in_slot(0)
    while remaining > 0 {
        stack: ItemStack = item_stack(item_opt.unwrap(), me.get_item_damage_in_slot(0))
        dropped: ItemEntity = item_entity(level, x, y + 0.5, z, stack)
        dropped.entity().set_delta_movement(vec3_zero())
        dropped.entity().spawn(level)
        remaining = remaining - 1
    }
    me.set_item_count_in_slot(0, 0)
}

local _is_pipe(nx: number, ny: number, nz: number) bool {
    return level.get_block(nx, ny, nz) == "grug:wooden_pipe"
}

local _neighbor_x(side: number) number {
    if side == 4 {
        return x - 1
    }
    if side == 5 {
        return x + 1
    }
    return x
}

local _neighbor_y(side: number) number {
    if side == 0 {
        return y - 1
    }
    if side == 1 {
        return y + 1
    }
    return y
}

local _neighbor_z(side: number) number {
    if side == 2 {
        return z - 1
    }
    if side == 3 {
        return z + 1
    }
    return z
}
