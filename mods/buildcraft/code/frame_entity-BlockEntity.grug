# The frame's drawing, as RenderPipe.renderWorldBlock draws a pipe: the quarter-block centre, then an
# arm on every side where the neighbour is another frame (BlockFrame.isPipeConnected). Drawing the
# shape here rather than leaving it to the model is what makes the block non-opaque. The frame has no
# state, so it saves nothing and ticks nothing.
level: Level = me.level()
pos: BlockPos = me.block_pos()
center: Vec3 = pos.center()
x: number = Math.floor(center.x())
y: number = Math.floor(center.y())
z: number = Math.floor(center.z())

export render(ctx: RenderContext) {
    ctx.draw_box(0.25, 0.25, 0.25, 0.75, 0.75, 0.75)
    if level.get_block(x, y - 1, z) == "grug:frame" {
        ctx.draw_box(0.25, 0.0, 0.25, 0.75, 0.25, 0.75)
    }
    if level.get_block(x, y + 1, z) == "grug:frame" {
        ctx.draw_box(0.25, 0.75, 0.25, 0.75, 1.0, 0.75)
    }
    if level.get_block(x, y, z - 1) == "grug:frame" {
        ctx.draw_box(0.25, 0.25, 0.0, 0.75, 0.75, 0.25)
    }
    if level.get_block(x, y, z + 1) == "grug:frame" {
        ctx.draw_box(0.25, 0.25, 0.75, 0.75, 0.75, 1.0)
    }
    if level.get_block(x - 1, y, z) == "grug:frame" {
        ctx.draw_box(0.0, 0.25, 0.25, 0.25, 0.75, 0.75)
    }
    if level.get_block(x + 1, y, z) == "grug:frame" {
        ctx.draw_box(0.75, 0.25, 0.25, 1.0, 0.75, 0.75)
    }
}
