export init() {
    set_hardness(2.5)
    set_material("wood")
    set_block_entity(e"autocrafting_table_entity")

    # 9 slots for the 3x3 crafting grid. The result is not an inventory slot: the block entity
    # keeps it in a dedicated container, matching BuildCraft's 9-slot TileAutoWorkbench.
    set_inventory_size(9)
}

# TODO: Rename to `export break` once https://github.com/grug-lang/grug-rs/issues/14 is fixed
export on_break(world: Level, x: number, y: number, z: number) {
    drop_inventory(world, x, y, z)
}

export use(world: Level, x: number, y: number, z: number, player: Player) {
    gui_layout: GUI = gui(r"assets/grug/textures/gui/crafting.png")

    text_color: Color = Color.rgb(64, 64, 64)
    gui_layout.add_text("Autocrafting Table", 30, 6, text_color)
    gui_layout.add_text("Inventory", 8, 72, text_color)

    # Add a 3x3 crafting grid starting at inventory slot 0
    gui_layout.add_crafting_grid(0, 30, 17)

    # Add the crafting result at its GUI position. It is not an inventory slot.
    gui_layout.add_crafting_result(124, 35)

    gui_layout.add_player_inventory(8, 84, 8, 142)

    block_entity: BlockEntity = world.get_block_entity(x, y, z).unwrap()

    gui_layout.open(player, block_entity)
}
