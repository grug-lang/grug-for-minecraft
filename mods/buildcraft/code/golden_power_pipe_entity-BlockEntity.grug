# PipeTransportPower.step, once the world's clock has moved on: this tick's power and queries are
# what was handed in before now, and the next tick's arrays start empty, which the inbox's own
# timestamp does by keeping the later mail. The reference checks every arrival for 1000 units and
# explodes with power 2 at the block's corner; the inbox cannot see one arrival, so the check is on
# the tick's total on a side, which explodes once where the reference could explode once per later
# arrival.
local _step() bool {
    side: number = 0
    while side < 6 {
        power: number = me.take_received_energy(side) * (1 - resistance)
        me.set_saved_list_number("power", side, "power", power)
        me.set_saved_list_number("power", side, "query", me.take_requested_energy(side))
        side = side + 1
    }

    side = 0
    while side < 6 {
        if me.get_saved_list_number("power", side, "power") >= 1000 {
            level.explode(x - 0.5, y - 0.5, z - 0.5, 2)
            if not _exists() {
                return false
            }
        }
        side = side + 1
    }
    return true
}

# The rest of PipeTransportPower.updateEntity on the server: each side's power is split between the
# other sides that asked for it, by the share its request is of their sum. The energy that came in
# on a side is never sent back out of it, which is the reference's j != ix test. A pipe neighbour is
# handed the share as it is, because its transport splits it again, and a machine is handed the
# whole units of it, as the reference casts the share to an int before receiveEnergy.
local _distribute() {
    side: number = 0
    while side < 6 {
        me.set_saved_list_number("power", side, "display", 0)
        side = side + 1
    }

    side = 0
    while side < 6 {
        power: number = me.get_saved_list_number("power", side, "power")
        if power > 0 {
            divisor: number = _divisor(side)
            # The reference divides by zero when a query sits on a side that no longer connects and
            # no other side asked, which hands NaN to nothing; grug refuses the division, and the
            # result is the same, so the distribution is skipped.
            if divisor > 0 {
                other: number = 0
                while other < 6 {
                    query: number = me.get_saved_list_number("power", other, "query")
                    if other != side and query > 0 and _is_connected(other) {
                        watts: number = power / divisor * query
                        _hand(other, watts)
                        _add_display(other, watts / 2)
                        _add_display(side, watts / 2)
                    }
                    other = other + 1
                }
            }
        }
        side = side + 1
    }
}

# The sum the reference divides a side's power by: the requests of every other side that connects
# to a pipe or an energy receiver.
local _divisor(side: number) number {
    total: number = 0
    other: number = 0
    while other < 6 {
        query: number = me.get_saved_list_number("power", other, "query")
        if other != side and query > 0 and _is_connected(other) {
            total = total + query
        }
        other = other + 1
    }
    return total
}

# Hands one share to the neighbour on a side: a pipe is handed it whole, because its transport
# splits it again, and a machine is handed the whole units of it, as PowerProvider.receiveEnergy
# takes an int.
local _hand(side: number, watts: number) {
    nx: number = _neighbor_x(side)
    ny: number = _neighbor_y(side)
    nz: number = _neighbor_z(side)
    neighbor_opt: Option[BlockEntity] = level.get_block_entity(nx, ny, nz)
    if not neighbor_opt.has() {
        return
    }
    if _pipe_kind(nx, ny, nz) != 0 {
        neighbor_opt.unwrap().receive_energy_on(_reverse(side), watts)
        return
    }
    neighbor_opt.unwrap().receive_energy(Math.floor(watts))
}

# The reference's request poll: every neighbour that is a machine rather than a pipe is asked what
# energy it wants, and the answer goes into this pipe's request for that side, which the next tick
# hands on. A machine that is not working asks for nothing and is skipped.
local _poll_receptors() {
    side: number = 0
    while side < 6 {
        if _is_connected(side) and _pipe_kind(_neighbor_x(side), _neighbor_y(side), _neighbor_z(side)) == 0 {
            receptor_opt: Option[BlockEntity] = level.get_block_entity(_neighbor_x(side), _neighbor_y(side), _neighbor_z(side))
            if receptor_opt.has() {
                request: number = receptor_opt.unwrap().get_energy_request()
                if request > 0 {
                    me.request_energy_on(side, request)
                }
            }
        }
        side = side + 1
    }
}

# The reference's second pass: each pipe neighbour is told the sum of this pipe's requests on its
# other sides, so a line of pipes carries a distant machine's need back along it.
local _forward_queries() {
    side: number = 0
    while side < 6 {
        nx: number = _neighbor_x(side)
        ny: number = _neighbor_y(side)
        nz: number = _neighbor_z(side)
        if _is_connected(side) and _pipe_kind(nx, ny, nz) != 0 {
            total: number = 0
            other: number = 0
            while other < 6 {
                if other != side {
                    total = total + me.get_saved_list_number("power", other, "query")
                }
                other = other + 1
            }
            if total != 0 {
                neighbor_opt: Option[BlockEntity] = level.get_block_entity(nx, ny, nz)
                if neighbor_opt.has() {
                    neighbor_opt.unwrap().request_energy_on(_reverse(side), total)
                }
            }
        }
        side = side + 1
    }
}

# displayPower[side] + delta as the reference keeps it: a short, so the int cast truncates toward
# zero and then the 16-bit cast wraps.
local _add_display(side: number, delta: number) {
    display: number = me.get_saved_list_number("power", side, "display")
    me.set_saved_list_number("power", side, "display", _short(_truncate(display + delta)))
}

local _truncate(value: number) number {
    if value < 0 {
        return 0 - Math.floor(0 - value)
    }
    return Math.floor(value)
}

local _short(value: number) number {
    wrapped: number = value
    while wrapped > 32767 {
        wrapped = wrapped - 65536
    }
    while wrapped < -32768 {
        wrapped = wrapped + 65536
    }
    return wrapped
}

# Whether this pipe connects on a side: a pipe its own transport and logic accept, or a machine that
# declared itself an energy receiver. PipeTransportPower.isPipeConnected accepts a pipe, an IMachine
# or an IPowerReceptor; every IMachine the reference has is also an IPowerReceptor, so the receiver
# declaration covers both. A chest is none of them, so a conductive pipe draws no arm toward one.
local _is_connected(side: number) bool {
    kind: number = _pipe_kind(_neighbor_x(side), _neighbor_y(side), _neighbor_z(side))
    if kind != 0 {
        return _pipes_connect(11, kind)
    }
    receptor_opt: Option[BlockEntity] = level.get_block_entity(_neighbor_x(side), _neighbor_y(side), _neighbor_z(side))
    if not receptor_opt.has() {
        return false
    }
    return receptor_opt.unwrap().is_power_receiver()
}

# Which kind of pipe stands at a position: 0 for none, 1 to 7 for the item pipes in the order the
# reference registers them (wooden, cobblestone, stone, iron, golden, diamond, obsidian), 9 to 11 for
# the conductive pipes (wooden, stone, golden), and 8 for a pipe of another mod, which Level.is_pipe
# names without the script knowing its block. The numbering is this port's, so every pipe's copy of
# it has to agree.
local _pipe_kind(nx: number, ny: number, nz: number) number {
    if not level.is_pipe(nx, ny, nz) {
        return 0
    }
    name: string = level.get_block(nx, ny, nz)
    if name == "grug:wooden_pipe" {
        return 1
    }
    if name == "grug:cobblestone_pipe" {
        return 2
    }
    if name == "grug:stone_pipe" {
        return 3
    }
    if name == "grug:iron_pipe" {
        return 4
    }
    if name == "grug:golden_pipe" {
        return 5
    }
    if name == "grug:diamond_pipe" {
        return 6
    }
    if name == "grug:obsidian_pipe" {
        return 7
    }
    if name == "grug:wooden_power_pipe" {
        return 9
    }
    if name == "grug:stone_power_pipe" {
        return 10
    }
    if name == "grug:golden_power_pipe" {
        return 11
    }
    return 8
}

# Utils.checkPipesConnections asks both pipes, and BlockGenericPipe.isPipeConnected refuses two
# pipes whose transport classes are not assignable to one another, so an item pipe and a conductive
# pipe never connect in either direction. Among the conductive pipes PipeLogicWood refuses another
# PipeLogicWood, so two wooden conductive pipes never connect; PipePowerStone's PipeLogicStone
# refuses only the cobblestone pipe and PipePowerGold's PipeLogicGold only the golden pipe, neither
# of which can meet a conductive pipe, so every other conductive pair connects. The transport of a
# pipe of another mod is unknown here, so a conductive pipe draws no arm toward one.

local _pipes_connect(own: number, other: number) bool {
    if _is_item_pipe(own) and _is_conductive_pipe(other) {
        return false
    }
    if _is_conductive_pipe(own) and _is_item_pipe(other) {
        return false
    }
    if _is_conductive_pipe(own) and other == 8 {
        return false
    }
    if own == 1 and other == 1 {
        return false
    }
    if own == 5 and other == 5 {
        return false
    }
    if own == 2 and other == 3 {
        return false
    }
    if own == 3 and other == 2 {
        return false
    }
    if own == 9 and other == 9 {
        return false
    }
    return true
}

# The item pipes are 1 to 7 and the conductive pipes 9 to 11, in the order the reference registers
# them; kind 8 is a pipe of another mod and 0 is not a pipe.
local _is_item_pipe(kind: number) bool {
    return kind >= 1 and kind <= 7
}

local _is_conductive_pipe(kind: number) bool {
    return kind >= 9 and kind <= 11
}

# Whether this pipe's block is still in the world, which an explosion of 1000 units or more may have
# taken with it.
local _exists() bool {
    return level.get_block(x, y, z) == "grug:golden_power_pipe"
}

# The side of a neighbour that faces the pipe, given the side of the pipe the neighbour is on. The
# sides pair up as 0 and 1, 2 and 3, 4 and 5, like Orientations.reverse.
local _reverse(side: number) number {
    if Math.remainder(side, 2) == 0 {
        return side + 1
    }
    return side - 1
}

# A side of this block: 0 down, 1 up, 2 north, 3 south, 4 west and 5 east, as BuildCraft's
# Orientations numbers them.
local _neighbor_x(side: number) number {
    if side == 4 {
        return x - 1
    }
    if side == 5 {
        return x + 1
    }
    return x
}

local _neighbor_y(side: number) number {
    if side == 0 {
        return y - 1
    }
    if side == 1 {
        return y + 1
    }
    return y
}

local _neighbor_z(side: number) number {
    if side == 2 {
        return z - 1
    }
    if side == 3 {
        return z + 1
    }
    return z
}
