# The golden conductive pipe, as PipePowerGold builds it: PipeTransportPower with PipeLogicGold and
# nothing of its own but its texture and its resistance, a thousandth lost per unit where the stone
# pipe loses a hundredth. PipeLogicGold refuses no pipe at all, so the arms follow the transport and
# the pipe rules.

# A block and its block entity are separate grug entities and grug has no shared code, so this
# transport is the wooden power pipe's and the golden one's, copied: keep the three in step.

# PipeTransportPower keeps four arrays per side, this tick's power and queries and the next tick's,
# and moves each next one over when the world's clock reaches a new tick. The host's inbox does the
# same with each mail's own time: take_received_energy reads the mail handed in before the current
# world time and leaves the rest, so a delivery that lands after this pipe's tick is taken on the
# next one whichever order the two pipes ticked in. A pipe's own request poll and the requests it
# forwards to its pipe neighbours go through the same inbox in the other direction. The arrays are
# not saved by the reference and this port does not save them either: the inbox is memory-only, so
# a chunk reload loses what was in flight, which is at most one tick's worth.

level: Level = me.level()
pos: BlockPos = me.block_pos()
center: Vec3 = pos.center()
x: number = center.x()
y: number = center.y()
z: number = center.z()

# PipeTransportPower's powerResitance, 0.01 for the stone pipe and 0.001 for the golden one, applied
# as the energy is taken.
resistance: number = 0.001

# A conductive pipe's transport saves nothing of its own, and the saved list holds only the values
# this tick is working with, so a fresh entity only has to make its six records.
export init(ctx: BlockEntityInitContext) {
    if me.get_saved_list_size("power") == 0 {
        side: number = 0
        while side < 6 {
            me.append_saved_list_record("power")
            side = side + 1
        }
    }
}

# RenderPipe.renderWorldBlock: the quarter-block centre, then an arm toward every side the pipe
# connects to. A conductive pipe is opaque in the reference and this shape is the block's, so the
# chunk render draws it rather than the frame pass.
export render(ctx: RenderContext) {
    ctx.draw_box(0.25, 0.25, 0.25, 0.75, 0.75, 0.75)
    _draw_arm(ctx, 0)
    _draw_arm(ctx, 1)
    _draw_arm(ctx, 2)
    _draw_arm(ctx, 3)
    _draw_arm(ctx, 4)
    _draw_arm(ctx, 5)
}

# RenderPipe.renderPower: the beam on every side that carries at least one unit of display power,
# drawn every frame because it follows this tick's distribution rather than the chunk's geometry.
export render_frame(ctx: RenderFrameContext) {
    side: number = 0
    while side < 6 {
        _draw_beam(ctx, side)
        side = side + 1
    }
}

# Pipe.updateEntity's transport part, in the reference's order: step, distribute, poll the machines,
# forward the queries to the pipe neighbours.
export tick() {
    if not _step() {
        return
    }
    _distribute()
    _poll_receptors()
    _forward_queries()
}

# One arm of the centre-and-arms shape, if this side has a connection.
local _draw_arm(ctx: RenderContext, side: number) {
    if not _is_connected(side) {
        return
    }
    if side == 0 {
        ctx.draw_box(0.25, 0.0, 0.25, 0.75, 0.25, 0.75)
    } else if side == 1 {
        ctx.draw_box(0.25, 0.75, 0.25, 0.75, 1.0, 0.75)
    } else if side == 2 {
        ctx.draw_box(0.25, 0.25, 0.0, 0.75, 0.75, 0.25)
    } else if side == 3 {
        ctx.draw_box(0.25, 0.25, 0.75, 0.75, 0.75, 1.0)
    } else if side == 4 {
        ctx.draw_box(0.0, 0.25, 0.25, 0.25, 0.75, 0.75)
    } else if side == 5 {
        ctx.draw_box(0.75, 0.25, 0.25, 1.0, 0.75, 0.75)
    }
}

# A beam on one side, when that side carries at least one unit. RenderPipe.renderPower turns the
# beam with GL rotations that land it on the side opposite the one whose display power it is, and
# this port keeps that bug: the angles below are the negated ones, which is how draw_model's
# clockwise convention sends the model out along +x the way the reference's GL rotation does.
local _draw_beam(ctx: RenderFrameContext, side: number) {
    display: number = me.get_saved_list_number("power", side, "display")
    if display < 1 {
        return
    }
    stage: number = _stage(display)
    if side == 0 {
        _draw_stage(ctx, stage, 0.0, 270.0)
    } else if side == 1 {
        _draw_stage(ctx, stage, 0.0, 90.0)
    } else if side == 2 {
        _draw_stage(ctx, stage, 90.0, 0.0)
    } else if side == 3 {
        _draw_stage(ctx, stage, 270.0, 0.0)
    } else if side == 4 {
        _draw_stage(ctx, stage, 0.0, 0.0)
    } else {
        _draw_stage(ctx, stage, 180.0, 0.0)
    }
}

# The stage the reference picks for a display power: the first of its eighty limits that the power
# is below, where displayPowerLimits[80 - i - 1] = 1000 - sqrt(12658 * i). The limits rise with the
# stage, so the stage is the count of limits the power reaches, which is 79 - floor((1000 - power)^2
# / 12658) and avoids keeping eighty constants and a square root grug has no function for. The two
# agree on every whole power the display can hold, because a limit equals a whole number only when
# 12658 divides (1000 - power)^2, which cannot happen for a power from 1 to 999.
local _stage(display: number) number {
    if display >= 1000 {
        return 79
    }
    remaining: number = 1000 - display
    stage: number = 79 - Math.floor(remaining * remaining / 12658)
    if stage < 0 {
        return 0
    }
    return stage
}

# The beam model of a stage. A model is named by a resource literal, which grug cannot build from a
# number, so all eighty are listed. Stage s is the reference's displayPowerList[s]: a box from the
# block's centre to 0.5 + q along +x and q around the other two axes, with q = 0.0025 + 0.00309375
# * s, which the rotations above turn into place.
local _draw_stage(ctx: RenderFrameContext, stage: number, y_degrees: number, z_degrees: number) {
    if stage == 0 {
        ctx.draw_model(r"assets/grug/models/block/power_beam_0.json", 0.0, y_degrees, z_degrees, 0.0, 0.0, 0.0)
