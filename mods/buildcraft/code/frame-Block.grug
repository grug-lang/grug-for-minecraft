# BlockFrame, the frame the quarry builds around its box: hardness 0.5 and Material.glass (acn.q), a
# block that is not a cube and not opaque, drawn with the pipe model (BuildCraftCore.pipeModel) in
# block texture 34, as a quarter-block centre with an arm to every neighbouring frame. Its collision
# and selection box is the same centre-and-arms union, which BlockFrame.c computes from
# Utils.checkPipesConnections. BlockFrame.a sets the bounds of the centre and of each arm and calls
# the base getCollidingBoundingBoxes, but that method reads c(), which BlockFrame overrides with the
# union, so the per-arm bounds are never added as boxes (#1773). BlockFrame.d answers c() too, which
# is the selection box. isPipeConnected is true for the frame's own block id only.
# The reference's idDropped is -1, so a broken frame drops nothing, which set_drops_nothing declares
# so the game's own break answers the same.
export init(ctx: BlockInitContext) {
    ctx.set_hardness(0.5)
    ctx.set_material("glass")
    ctx.set_block_entity(e"frame_entity")
    ctx.set_custom_render()
    ctx.set_shape()
    ctx.set_drops_nothing()
}

# The centre's box, reaching this block's face on every side a frame is next to, as BlockFrame.c
# does: one union box, never one box per arm, because the base getCollidingBoundingBoxes reads c().
export shape(ctx: ShapeContext, world: Level, x: number, y: number, z: number) {
    min_x: number = 0.25
    min_y: number = 0.25
    min_z: number = 0.25
    max_x: number = 0.75
    max_y: number = 0.75
    max_z: number = 0.75

    if world.get_block(x - 1, y, z) == "grug:frame" {
        min_x = 0.0
    }
    if world.get_block(x + 1, y, z) == "grug:frame" {
        max_x = 1.0
    }
    if world.get_block(x, y - 1, z) == "grug:frame" {
        min_y = 0.0
    }
    if world.get_block(x, y + 1, z) == "grug:frame" {
        max_y = 1.0
    }
    if world.get_block(x, y, z - 1) == "grug:frame" {
        min_z = 0.0
    }
    if world.get_block(x, y, z + 1) == "grug:frame" {
        max_z = 1.0
    }

    ctx.add_collision_box(min_x, min_y, min_z, max_x, max_y, max_z)
}
