# The iron pipe, which is BlockGenericPipe with PipeItemsIron: the plain item transport plus
# PipeLogicIron, which adds the one thing this pipe has of its own, a side that is its only exit.
# The block's damage value (the reference's block metadata) is that side, 0 to 5, and a fresh pipe
# points at the first neighbour it can send to: an inventory, a pipe of another mod, or any pipe of
# this mod but a wooden one, because PipeLogicIron.switchPosition refuses a PipeLogicWood neighbour.
# A wrench click and a change in the redstone signal both call switchPosition again, and an item that
# arrives on the output side and finds it closed to it is sent back where it came from, which is
# PipeTransportItems.allowBouncing. The transport itself is the stone pipe's; see
# iron_pipe_entity-BlockEntity.grug.
export init(ctx: BlockInitContext) {
    ctx.set_hardness(0.5)
    ctx.set_material("wood")
    ctx.set_block_entity(e"iron_pipe_entity")
    ctx.set_custom_render()
    ctx.set_shape()
    # The reference's pipes are one block and answer a neighbour's pipe test, so this one declares
    # itself a pipe rather than leaving neighbours to compare block names.
    ctx.set_pipe()
}

# Pipe.dropContents, which BlockGenericPipe calls when the pipe breaks: every travelling item is
# dropped where the pipe stands, at a random point inside the block, as Utils.dropItems does.
export on_break(world: Level, x: number, y: number, z: number) {
    pipe_opt: Option[BlockEntity] = world.get_block_entity(x, y, z)
    if pipe_opt.has() {
        _drop_travelling(world, x, y, z, pipe_opt.unwrap())
    }
}

# PipeLogicIron.onBlockPlaced: the pipe starts as a down-facing output, metadata 1, and then
# switchPosition looks for the next side it can send to, which it starts counting at 2.
export placed(world: Level, x: number, y: number, z: number, placer: Player) {
    world.set_block_damage(x, y, z, 1)
    _switch_position(world, x, y, z)
}

# The centre's box, reaching this block's face on every side the pipe connects to, as the stone
# pipe's shape does.
export shape(ctx: ShapeContext, world: Level, x: number, y: number, z: number) {
    min_x: number = 0.25
    min_y: number = 0.25
    min_z: number = 0.25
    max_x: number = 0.75
    max_y: number = 0.75
    max_z: number = 0.75

    if _is_connected(world, x, y, z, 4) {
        min_x = 0.0
    }
    if _is_connected(world, x, y, z, 5) {
        max_x = 1.0
    }
    if _is_connected(world, x, y, z, 0) {
        min_y = 0.0
    }
    if _is_connected(world, x, y, z, 1) {
        max_y = 1.0
    }
    if _is_connected(world, x, y, z, 2) {
        min_z = 0.0
    }
    if _is_connected(world, x, y, z, 3) {
        max_z = 1.0
    }

    ctx.add_collision_box(min_x, min_y, min_z, max_x, max_y, max_z)
}

# PipeLogicIron.blockActivated: a right click with the wrench turns the output to the next side
# that can take items and counts as used, and any other click is declined, as the reference returns
# false for it, so the held item is used or placed as usual.
export use(ctx: BlockUseContext, world: Level, x: number, y: number, z: number, player: Player) {
    held: Option[Item] = player.get_held_item()
    if held.has() {
        if equals(held.unwrap(), item(resource_location("grug:wrench"))) {
            _switch_position(world, x, y, z)
            return
        }
    }
    ctx.decline_use()
}

# PipeLogicIron.switchPosition: the search starts at the side after the current one and wraps round,
# so the current side is the last one tried, and the metadata is left alone when no side can take
# items. The block entity has a copy of this, because its on_neighbor_change switches the output
# when the redstone signal changes and a block and its block entity are separate grug entities.
local _switch_position(world: Level, x: number, y: number, z: number) {
    meta: number = world.get_block_damage(x, y, z)
    i: number = 0
    while i < 6 {
        meta = Math.remainder(meta + 1, 6)
        if _can_send_to(world, x, y, z, meta) {
            world.set_block_damage(x, y, z, meta)
            return
        }
        i = i + 1
    }
}

# The neighbour test of switchPosition: a pipe that is not a wooden pipe, or an inventory. A
# wooden pipe is checked before the inventory test because the port's wooden pipe keeps an inbox
# slot, and the reference refuses it as a neighbour all the same. The reference also accepts an
# ILiquidContainer, which no block of the port is until the tanks arrive.
local _can_send_to(world: Level, x: number, y: number, z: number, side: number) bool {
    nx: number = _neighbor_x(x, side)
    ny: number = _neighbor_y(y, side)
    nz: number = _neighbor_z(z, side)
    if world.is_pipe(nx, ny, nz) {
        return _pipe_kind(world, nx, ny, nz) != 1
    }
    return world.is_inventory(nx, ny, nz)
}

local _drop_travelling(world: Level, x: number, y: number, z: number, pipe: BlockEntity) {
    index: number = 0
    # Nothing is removed from the list here, so its size cannot change under the loop.
    records: number = pipe.get_saved_list_size("traveling")
    while index < records {
        item_opt: Option[Item] = pipe.get_saved_list_item("traveling", index)
        count: number = pipe.get_saved_list_number("traveling", index, "count")
        if item_opt.has() and count > 0 {
            damage: number = pipe.get_saved_list_number("traveling", index, "damage")
            # Utils.dropItems: each axis a random 0.15 to 0.85 into the block, and the EntityItem
            # constructor's hop of -0.1 to 0.1 on x and z and 0.2 up, which Utils.dropItems leaves
            # alone. The reference hands the whole stack to one EntityItem, so a record carrying
            # five items is one entity holding five.
            dx: number = world.random_float() * 0.7 + 0.15
            dy: number = world.random_float() * 0.7 + 0.15
            dz: number = world.random_float() * 0.7 + 0.15
            stack: ItemStack = item_stack(item_opt.unwrap(), damage, count)
            dropped: ItemEntity = item_entity(world, x + dx, y + dy, z + dz, stack)
            # Utils.dropItems sets the EntityItem's delayBeforeCanPickup to 10 before it spawns it.
            dropped.set_pickup_delay(10)
            dropped.entity().spawn(world)
        }
        index = index + 1
    }
}

# The same connection test as the block entity's _is_connected: a pipe the reference's symmetric
# rule connects, or an inventory. A block and its block entity are separate grug entities and cannot
# share a helper, so this copy has to stay in step with that one.
local _is_connected(world: Level, x: number, y: number, z: number, side: number) bool {
    kind: number = _pipe_kind(world, _neighbor_x(x, side), _neighbor_y(y, side), _neighbor_z(z, side))
    if kind != 0 {
        return _pipes_connect(4, kind)
    }
    return _is_inventory(world, x, y, z, side)
}

# The same inventory test as the block entity's _is_inventory.
local _is_inventory(world: Level, x: number, y: number, z: number, side: number) bool {
    return world.is_inventory(_neighbor_x(x, side), _neighbor_y(y, side), _neighbor_z(z, side))
}

# Which kind of pipe stands at a position: 0 for none, the number of each of this mod's pipes, and 8
# for a pipe of another mod, as the block entity's copy of this says.
local _pipe_kind(world: Level, nx: number, ny: number, nz: number) number {
    if not world.is_pipe(nx, ny, nz) {
        return 0
    }
    name: string = world.get_block(nx, ny, nz)
    if name == "grug:wooden_pipe" {
        return 1
    }
    if name == "grug:cobblestone_pipe" {
        return 2
    }
    if name == "grug:stone_pipe" {
        return 3
    }
    if name == "grug:iron_pipe" {
        return 4
    }
    if name == "grug:golden_pipe" {
        return 5
    }
    if name == "grug:diamond_pipe" {
        return 6
    }
    if name == "grug:obsidian_pipe" {
        return 7
    }
    return 8
}

# Utils.checkPipesConnections asks both pipes, so these rules are symmetric: two wooden pipes never
# connect, two golden pipes never connect, and a cobblestone pipe and a stone pipe never connect
# because each refuses the other. The iron pipe's own logic refuses nothing, so every pair that
# involves it connects, a wooden or golden pipe included.
local _pipes_connect(own: number, other: number) bool {
    if own == 1 and other == 1 {
        return false
    }
    if own == 5 and other == 5 {
        return false
    }
    if own == 2 and other == 3 {
        return false
    }
    if own == 3 and other == 2 {
        return false
    }
    return true
}

local _neighbor_x(x: number, side: number) number {
    if side == 4 {
        return x - 1
    }
    if side == 5 {
        return x + 1
    }
    return x
}

local _neighbor_y(y: number, side: number) number {
    if side == 0 {
        return y - 1
    }
    if side == 1 {
        return y + 1
    }
    return y
}

local _neighbor_z(z: number, side: number) number {
    if side == 2 {
        return z - 1
    }
    if side == 3 {
        return z + 1
    }
    return z
}
