level: Level = me.level()

pos: BlockPos = me.block_pos()
center: Vec3 = pos.center()
x: number = center.x()
y: number = center.y()
z: number = center.z()

export item_extracted(slot: number, amount: number) {
    if slot >= 0 and slot <= 8 {
        me.update_recipe_output(0)
    }
}

export item_inserted(slot: number, amount: number) {
    if slot >= 0 and slot <= 8 {
        me.update_recipe_output(0)
    }
}

export output_taken(amount: number) {
    _try_restock_about_to_empty()
    me.consume_crafting_ingredients(0)
    me.update_recipe_output(0)
}

# What a pipe may take from this table and put into it, mirroring the reference's ISpecialInventory:
# the table hands out its crafting result as a whole stack, from any side, and never the ingredients
# it is crafting from (TileAutoWorkbench.extractItem), and it takes an item only into the slot that
# already holds the same item with the fewest of them, so a recipe grid is filled by hand and topped
# up by pipes (TileAutoWorkbench.addItem).
# A pipe's take is accounted for here, not in output_taken, because that is what the reference does:
# ISpecialInventory.extractItem(doRemove, from) calls extractItem(doRemove, false), which keeps one item
# in every slot (itemsToLeave is 1) and borrows that item from a neighbouring inventory when a slot has
# only one, or crafts nothing. The GUI's result slot is the output_taken path instead, which calls
# extractItem(true, true) and leaves nothing (#602).
export extract_item(from_side: number, remove: bool, response: ExtractResponse) {
    if not me.get_crafting_result_item().has() {
        response.refuse()
        return
    }
    if not _can_craft_for_pipe() {
        response.refuse()
        return
    }

    if not remove {
        response.give_crafting_result()
        return
    }

    _consume_for_pipe()
    me.update_recipe_output(0)
    response.give_crafting_result_consumed()
}

export add_item(item: Item, damage: number, count: number, from_side: number, add: bool, response: AddResponse) {
    best: number = -1
    best_count: number = 2147483647

    slot: number = 0
    while slot < 9 {
        slot_count: number = me.get_item_count_in_slot(slot)
        if slot_count > 0 and slot_count < best_count {
            slot_item: Option[Item] = me.get_item_in_slot(slot)
            if slot_item.has() {
                if equals(slot_item.unwrap(), item) and me.get_item_damage_in_slot(slot) == damage {
                    best = slot
                    best_count = slot_count
                }
            }
        }
        slot = slot + 1
    }

    if best < 0 {
        response.refuse()
    } else {
        response.accept_into_slot(best)
    }
}

# Whether a pipe's take can be paid for: every slot holding more than one item gives one up, and every
# slot holding one needs a matching item in a neighbouring inventory, one per slot. The reference checks
# the same thing by taking them and putting them back when one is missing. The count only includes the slots
# the neighbour lets anyone extract from, because those are the ones the borrowing can take from: a count
# of every slot could approve a take whose borrow then fails, and the bread would go unpaid.
local _can_craft_for_pipe() bool {
    slot: number = 0
    while slot < 9 {
        if me.get_item_count_in_slot(slot) == 1 {
            item_opt: Option[Item] = me.get_item_in_slot(slot)
            if item_opt.has() {
                item: Item = item_opt.unwrap()
                damage: number = me.get_item_damage_in_slot(slot)
                if _count_extractable_in_neighbors(item, damage) < _count_required(item, damage) {
                    return false
                }
            }
        }
        slot = slot + 1
    }
    return true
}

# Pays for a pipe's take: a slot holding more than one item gives one up, and a slot holding one keeps it
# and one matching item comes out of the first neighbour that has one, in TileAutoWorkbench.getNearbyItem's
# order.
local _consume_for_pipe() {
    slot: number = 0
    while slot < 9 {
        count: number = me.get_item_count_in_slot(slot)
        if count > 1 {
            me.set_item_count_in_slot(slot, count - 1)
        } else if count == 1 {
            item_opt: Option[Item] = me.get_item_in_slot(slot)
            if item_opt.has() {
                item: Item = item_opt.unwrap()
                damage: number = me.get_item_damage_in_slot(slot)
                _extract_from_neighbors(item, damage, 1)
            }
        }
        slot = slot + 1
    }
}

local _try_restock_about_to_empty() {
    if not _can_restock_all() {
        return
    }

    slot: number = 0
    while slot < 9 {
        count: number = me.get_item_count_in_slot(slot)

        if count == 1 {
            item_opt: Option[Item] = me.get_item_in_slot(slot)
            if item_opt.has() {
                item: Item = item_opt.unwrap()
                damage: number = me.get_item_damage_in_slot(slot)

                extracted: number = _extract_from_neighbors(item, damage, 1)

                if extracted > 0 {
                    me.set_item_count_in_slot(slot, 2)
                }
            }
        }
        slot = slot + 1
    }
}

local _can_restock_all() bool {
    slot: number = 0
    while slot < 9 {
        if me.get_item_count_in_slot(slot) == 1 {
            item_opt: Option[Item] = me.get_item_in_slot(slot)
            if item_opt.has() {
                item: Item = item_opt.unwrap()
                damage: number = me.get_item_damage_in_slot(slot)

                required: number = _count_required(item, damage)

                # If neighbors don't have enough, abort the whole restock
                if _count_in_neighbors(item, damage) < required {
                    return false
                }
            }
        }
        slot = slot + 1
    }

    return true
}

local _count_required(target_item: Item, target_damage: number) number {
    required: number = 0
    slot: number = 0

    while slot < 9 {
        if me.get_item_count_in_slot(slot) == 1 {
            item_opt: Option[Item] = me.get_item_in_slot(slot)
            if item_opt.has() {
                is_same_item: bool = equals(item_opt.unwrap(), target_item)
                is_same_damage: bool = me.get_item_damage_in_slot(slot) == target_damage

                if is_same_item and is_same_damage {
                    required = required + 1
                }
            }
        }
        slot = slot + 1
    }

    return required
}

local _count_in_neighbors(item: Item, damage: number) number {
    # Match BuildCraft's TileAutoWorkbench.getNearbyItem order: XNeg, XPos, YNeg, YPos, ZNeg, ZPos.
    total: number = 0
    total = total + _count_in_neighbor(x - 1, y, z, item, damage)
    total = total + _count_in_neighbor(x + 1, y, z, item, damage)
    total = total + _count_in_neighbor(x, y - 1, z, item, damage)
    total = total + _count_in_neighbor(x, y + 1, z, item, damage)
    total = total + _count_in_neighbor(x, y, z - 1, item, damage)
    total = total + _count_in_neighbor(x, y, z + 1, item, damage)
    return total
}

local _count_in_neighbor(nx: number, ny: number, nz: number, item: Item, damage: number) number {
    neighbor_opt: Option[BlockEntity] = level.get_block_entity(nx, ny, nz)
    if neighbor_opt.has() {
        return neighbor_opt.unwrap().count_item_in_inventory(item, damage)
    }
    return 0
}

local _extract_from_neighbors(item: Item, damage: number, amount: number) number {
    extracted: number = 0

    # Same order as _count_in_neighbors, so the neighbours drained match BuildCraft: XNeg first.
    pull: number = _extract_from_neighbor(x - 1, y, z, item, damage, amount - extracted)
    extracted = extracted + pull
    if extracted >= amount {
        return extracted
    }

    pull = _extract_from_neighbor(x + 1, y, z, item, damage, amount - extracted)
    extracted = extracted + pull
    if extracted >= amount {
        return extracted
    }

    pull = _extract_from_neighbor(x, y - 1, z, item, damage, amount - extracted)
    extracted = extracted + pull
    if extracted >= amount {
        return extracted
    }

    pull = _extract_from_neighbor(x, y + 1, z, item, damage, amount - extracted)
    extracted = extracted + pull
    if extracted >= amount {
        return extracted
    }

    pull = _extract_from_neighbor(x, y, z - 1, item, damage, amount - extracted)
    extracted = extracted + pull
    if extracted >= amount {
        return extracted
    }

    pull = _extract_from_neighbor(x, y, z + 1, item, damage, amount - extracted)
    extracted = extracted + pull
    return extracted
}

local _extract_from_neighbor(nx: number, ny: number, nz: number, item: Item, damage: number, amount: number) number {
    neighbor_opt: Option[BlockEntity] = level.get_block_entity(nx, ny, nz)
    if neighbor_opt.has() {
        return neighbor_opt.unwrap().extract_item_from_inventory(item, damage, amount)
    }
    return 0
}

local _count_extractable_in_neighbors(item: Item, damage: number) number {
    total: number = 0
    total = total + _count_extractable_in_neighbor(x - 1, y, z, item, damage)
    total = total + _count_extractable_in_neighbor(x + 1, y, z, item, damage)
    total = total + _count_extractable_in_neighbor(x, y - 1, z, item, damage)
    total = total + _count_extractable_in_neighbor(x, y + 1, z, item, damage)
    total = total + _count_extractable_in_neighbor(x, y, z - 1, item, damage)
    total = total + _count_extractable_in_neighbor(x, y, z + 1, item, damage)
    return total
}

local _count_extractable_in_neighbor(nx: number, ny: number, nz: number, item: Item, damage: number) number {
    neighbor_opt: Option[BlockEntity] = level.get_block_entity(nx, ny, nz)
    if not neighbor_opt.has() {
        return 0
    }

    neighbor: BlockEntity = neighbor_opt.unwrap()
    size: number = neighbor.get_inventory_size()
    total: number = 0
    slot: number = 0
    while slot < size {
        if neighbor.is_slot_extractable(slot) {
            slot_item: Option[Item] = neighbor.get_item_in_slot(slot)
            if slot_item.has() {
                if equals(slot_item.unwrap(), item) and neighbor.get_item_damage_in_slot(slot) == damage {
                    total = total + neighbor.get_item_count_in_slot(slot)
                }
            }
        }
        slot = slot + 1
    }
    return total
}
