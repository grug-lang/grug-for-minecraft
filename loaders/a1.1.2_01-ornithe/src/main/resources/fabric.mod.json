{
    "schemaVersion": 1,
    "id": "grug",
    "version": "${version}",
    "name": "grug",
    "description": "The grug mod loader for Minecraft.",
    "authors": [
        "MyNameIsTrez"
    ],
    "environment": "*",
    "entrypoints": {
        "init": [
            "net.grug.minecraft.ornithe.GrugModLoader"
        ],
        "client": [
            "net.grug.minecraft.ornithe.ClientGrugModLoader"
        ],
        "server": [
            "net.grug.minecraft.ornithe.ServerGrugModLoader"
        ]
    },
    "mixins": [
        "grug.mixins.json",
        "grug.shapeless.mixins.json",
        "grug.custom_geometry.mixins.json",
        "grug.world_settle.mixins.json"
    ],
    "depends": {
        "minecraft": "1.0.0-alpha.1.2.1",
        "osl-blocks": ">=0.1.1",
        "osl-core": ">=0.9.0",
        "osl-entrypoints": ">=0.6.1",
        "osl-keybinds": ">=0.3.0",
        "osl-lifecycle-events": ">=0.6.1",
        "osl-resource-loader": ">=0.7.4"
    }
