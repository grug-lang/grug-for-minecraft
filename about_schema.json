{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": [
        "name",
        "version",
        "game_version",
        "authors",
        "repository",
        "licenses"
    ],
    "additionalProperties": false,
    "properties": {
        "name": {
            "type": "string"
        },
        "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "game_version": {
            "type": "string"
        },
        "loaders": {
            "description": "The loader directories this mod supports, named as run-loader.sh takes them, for example b1.7.3-stationapi. A loader that is not in the set never runs this mod's tests, because a test there would assert that loader's version of the mod's blocks and its goldens. Absent means every loader, so a mod that runs everywhere says nothing at all, and an empty list is refused rather than read as supporting none. This selects runs and never waives one: the coverage gate is per loader and runs every loader whatever the sets say.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "authors": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string"
            }
        },
        "repository": {
            "$ref": "#/definitions/repository"
        },
        "licenses": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/definitions/license"
            }
        },
        "derived_from": {
            "type": "array",
            "items": {
                "description": "One entry in the lineage. The first entry is the build this port recreates, and the only one that may carry the recreation fields; later entries are that build's own sources.",
                "type": "object",
                "required": [
                    "name",
                    "repository",
                    "licenses"
                ],
                "additionalProperties": false,
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "repository": {
                        "$ref": "#/definitions/repository"
                    },
                    "revision": {
                        "description": "The pinned revision of the reference, e.g. a commit hash. Not a branch or tag.",
                        "type": "string",
                        "minLength": 1
                    },
                    "licenses": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                            "$ref": "#/definitions/license"
                        }
                    },
                    "credits": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "sources": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "format": "uri"
                        }
                    },
                    "artifacts": {
                        "description": "The reference builds to diff against, each staged under its name. Every sha256 is the authority, not the url: a moved url is fine as long as the bytes hash the same.",
                        "type": "array",
                        "minItems": 1,
                        "items": {
                            "$ref": "#/definitions/artifact"
                        }
                    },
                    "runtime": {
                        "$ref": "#/definitions/runtime"
                    },
                    "install": {
                        "$ref": "#/definitions/install"
                    },
                    "deviations": {
                        "description": "Known differences from the reference, each a gap still to be closed with its own tracking issue. A port reproduces its reference exactly, so a port with no deviations left has no `deviations` key at all, and an empty list is refused.",
                        "type": "array",
                        "minItems": 1,
                        "items": {
                            "$ref": "#/definitions/deviation"
                        }
                    }
                },
                "allOf": [
                    {
                        "if": {
                            "anyOf": [
                                {
                                    "required": [
                                        "artifacts"
                                    ]
                                },
                                {
                                    "required": [
                                        "runtime"
                                    ]
                                },
                                {
                                    "required": [
                                        "install"
                                    ]
                                },
                                {
                                    "required": [
                                        "deviations"
                                    ]
                                }
                            ]
                        },
                        "then": {
                            "required": [
                                "artifacts",
                                "runtime",
                                "install"
                            ]
                        }
                    }
                ]
            }
        }
    },
    "definitions": {
        "repository": {
            "type": "object",
            "required": [
                "url"
            ],
            "additionalProperties": false,
            "properties": {
                "url": {
                    "type": "string",
                    "format": "uri"
                }
            }
        },
        "license": {
            "type": "object",
            "required": [
                "name",
                "url"
            ],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string"
                },
                "url": {
                    "type": "string",
                    "format": "uri"
                },
                "note": {
                    "type": "string"
                }
            }
        },
        "artifact": {
            "description": "One reference build to diff against, staged under its name.",
            "type": "object",
            "required": [
                "name",
                "url",
                "sha256",
                "size"
            ],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "description": "The filename this artifact is staged as, and the name install.files refers to.",
                    "type": "string",
                    "minLength": 1
                },
                "url": {
                    "type": "string",
                    "format": "uri"
                },
                "sha256": {
                    "description": "Lowercase hex sha256 of this artifact.",
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                },
                "size": {
                    "type": "integer",
                    "minimum": 0
                }
            }
        },
        "runtime": {
            "description": "The environment the reference runs in.",
            "type": "object",
            "required": [
                "minecraft",
                "loader",
                "loader_version",
                "java"
            ],
            "additionalProperties": false,
            "properties": {
                "minecraft": {
                    "type": "string",
                    "minLength": 1
                },
                "loader": {
                    "description": "The loader directory, named as run-loader.sh takes it, for example b1.7.3-stationapi. Naming the directory rather than the loader alone is what lets a recreation entry map to a run command mechanically.",
                    "type": "string",
                    "minLength": 1
                },
                "loader_version": {
                    "type": "string",
                    "minLength": 1
                },
                "java": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "install": {
            "description": "A tagged union keyed by how the reference is installed into its runtime, not a step array. files and libs are paths and coordinates the runtime resolves; config is a runtime-specific object; jvm_args are extra launcher arguments.",
            "type": "object",
            "required": [
                "type"
            ],
            "additionalProperties": false,
            "properties": {
                "type": {
                    "enum": [
                        "mods_folder",
                        "jarmod",
                        "coremod",
                        "javaagent",
                        "tweak_class",
                        "launcher_profile",
                        "server_plugin",
                        "datapack",
                        "installer",
                        "source_build"
                    ]
                },
                "files": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "libs": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "config": {
                    "type": "object"
                },
                "jvm_args": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "mods_folder"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "files"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "jarmod"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "files"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "coremod"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "files"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "javaagent"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "files"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "tweak_class"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "files"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "launcher_profile"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "config"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "server_plugin"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "files"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "datapack"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "files"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "installer"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "files"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "source_build"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "config"
                        ]
                    }
                }
            ]
        },
        "deviation": {
            "type": "object",
            "required": [
                "what",
                "why",
                "tracking_issue"
            ],
            "additionalProperties": false,
            "properties": {
                "what": {
                    "type": "string",
                    "minLength": 1
                },
                "why": {
                    "type": "string",
                    "minLength": 1
                },
                "tracking_issue": {
                    "description": "The number of the issue in this repository that tracks resolving or deciding this deviation, so about.json and the issue point at each other. The issue holds the deviation's state: a deviation is listed while it is a difference from the reference, and deleted once it is fixed.",
                    "type": "integer",
                    "minimum": 1
                }
            }
        }
    }
}