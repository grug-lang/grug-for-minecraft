{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": [
        "name",
        "version",
        "game_version",
        "authors",
        "repository",
        "licenses"
    ],
    "additionalProperties": false,
    "properties": {
        "name": {
            "type": "string"
        },
        "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "game_version": {
            "type": "string"
        },
        "authors": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string"
            }
        },
        "repository": {
            "$ref": "#/definitions/repository"
        },
        "licenses": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/definitions/license"
            }
        },
        "recreation": {
            "description": "How this mod recreates a reference: what it targets, how to install and run the reference, and where it deliberately differs.",
            "type": "object",
            "required": [
                "fidelity",
                "reference",
                "runtime",
                "install"
            ],
            "additionalProperties": false,
            "properties": {
                "fidelity": {
                    "description": "exact reproduces the reference pixel for pixel, behavioral matches its observable behaviour without promising pixels, and inspired only takes design cues.",
                    "enum": [
                        "exact",
                        "behavioral",
                        "inspired"
                    ]
                },
                "reference": {
                    "type": "object",
                    "required": [
                        "name",
                        "repository",
                        "revision"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "name": {
                            "type": "string",
                            "minLength": 1
                        },
                        "repository": {
                            "$ref": "#/definitions/repository"
                        },
                        "revision": {
                            "description": "The pinned revision of the reference, e.g. a commit hash. Not a branch or tag.",
                            "type": "string",
                            "minLength": 1
                        }
                    }
                },
                "artifacts": {
                    "description": "The reference builds to diff against, each staged under its name. Every sha256 is the authority, not the url: a mirror or a moved url is fine as long as the bytes hash the same.",
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/definitions/artifact"
                    }
                },
                "runtime": {
                    "$ref": "#/definitions/runtime"
                },
                "install": {
                    "$ref": "#/definitions/install"
                },
                "deviations": {
                    "description": "Intentional differences from the reference. A non-empty list says the difference is deliberate, so a reader does not 'fix' it.",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/deviation"
                    }
                }
            }
        },
        "derived_from": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "name",
                    "repository",
                    "licenses"
                ],
                "additionalProperties": false,
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "repository": {
                        "$ref": "#/definitions/repository"
                    },
                    "licenses": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                            "$ref": "#/definitions/license"
                        }
                    },
                    "credits": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "sources": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "format": "uri"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "repository": {
            "type": "object",
            "required": [
                "url"
            ],
            "additionalProperties": false,
            "properties": {
                "url": {
                    "type": "string",
                    "format": "uri"
                }
            }
        },
        "license": {
            "type": "object",
            "required": [
                "name",
                "url"
            ],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string"
                },
                "url": {
                    "type": "string",
                    "format": "uri"
                },
                "note": {
                    "type": "string"
                }
            }
        },
        "artifact": {
            "description": "One reference build to diff against, staged under its name.",
            "type": "object",
            "required": [
                "name",
                "url",
                "sha256",
                "size",
                "redistribution"
            ],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "description": "The filename this artifact is staged as, and the name install.files refers to.",
                    "type": "string",
                    "minLength": 1
                },
                "url": {
                    "type": "string",
                    "format": "uri"
                },
                "sha256": {
                    "description": "Lowercase hex sha256 of this artifact.",
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                },
                "size": {
                    "type": "integer",
                    "minimum": 0
                },
                "redistribution": {
                    "type": "object",
                    "required": [
                        "allowed"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "allowed": {
                            "description": "Whether the reference license permits redistributing the unmodified artifact.",
                            "type": "boolean"
                        },
                        "basis": {
                            "type": "string",
                            "minLength": 1
                        },
                        "note": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                },
                "mirrors": {
                    "description": "Extra urls serving the same bytes. Only permitted when redistribution is allowed.",
                    "type": "array",
                    "items": {
                        "type": "string",
                        "format": "uri"
                    }
                }
            }
        },
        "runtime": {
            "description": "The environment the reference runs in.",
            "type": "object",
            "required": [
                "minecraft",
                "loader",
                "loader_version",
                "java"
            ],
            "additionalProperties": false,
            "properties": {
                "minecraft": {
                    "type": "string",
                    "minLength": 1
                },
                "loader": {
                    "description": "The loader directory, named as run-loader.sh takes it, for example b1.7.3-stationapi. Naming the directory rather than the loader alone is what lets a recreation block map to a run command mechanically.",
                    "type": "string",
                    "minLength": 1
                },
                "loader_version": {
                    "type": "string",
                    "minLength": 1
                },
                "java": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "install": {
            "description": "A tagged union keyed by how the reference is installed into its runtime, not a step array. files and libs are paths and coordinates the runtime resolves; config is a runtime-specific object; jvm_args are extra launcher arguments.",
            "type": "object",
            "required": [
                "type"
            ],
            "additionalProperties": false,
            "properties": {
                "type": {
                    "enum": [
                        "mods_folder",
                        "jarmod",
                        "coremod",
                        "javaagent",
                        "tweak_class",
                        "launcher_profile",
                        "server_plugin",
                        "datapack",
                        "installer",
                        "source_build"
                    ]
                },
                "files": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "libs": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "config": {
                    "type": "object"
                },
                "jvm_args": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "mods_folder"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "files"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "jarmod"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "files"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "coremod"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "files"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "javaagent"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "files"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "tweak_class"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "files"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "launcher_profile"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "config"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "server_plugin"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "files"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "datapack"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "files"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "installer"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "files"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "source_build"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "config"
                        ]
                    }
                }
            ]
        },
        "deviation": {
            "type": "object",
            "required": [
                "what",
                "why",
                "status"
            ],
            "additionalProperties": false,
            "properties": {
                "what": {
                    "type": "string",
                    "minLength": 1
                },
                "why": {
                    "type": "string",
                    "minLength": 1
                },
                "status": {
                    "enum": [
                        "open",
                        "accepted",
                        "wontfix",
                        "fixed"
                    ]
                }
            }
        }
    }
}