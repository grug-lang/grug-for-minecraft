{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": [
        "name",
        "version",
        "game_version",
        "authors",
        "repository",
        "licenses"
    ],
    "additionalProperties": false,
    "properties": {
        "name": {
            "type": "string"
        },
        "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "game_version": {
            "type": "string"
        },
        "loaders": {
            "description": "The loader directories this mod supports, named as run-loader.sh takes them, for example b1.7.3-stationapi. A loader that is not in the set never runs this mod's tests, because a test there would assert that loader's version of the mod's blocks and its goldens. Absent means every loader, so a mod that runs everywhere says nothing at all, and an empty list is refused rather than read as supporting none. This selects runs and never waives one: the coverage gate is per loader and runs every loader whatever the sets say.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "authors": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string"
            }
        },
        "repository": {
            "$ref": "#/definitions/repository"
        },
        "licenses": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/definitions/license"
            }
        },
        "requests_unsafe_mode": {
            "description": "Whether the mod asks to run its code in unsafe mode, which skips the checks for host function errors, the time limit and stack overflows. This is a request and not a setting: only the player's grant, stored outside the mod's files, makes the mod run unsafe, and a mod without the key runs safe. See grug-lang/grug-for-minecraft#334.",
            "type": "boolean"
        },
        "keys": {
            "description": "The key bindings the mod registers with the game, each the game's own rebindable binding so the player finds it in the Controls screen. A mod that declares none has no `keys` key. A loader that cannot register a binding polls the declared default key instead, and the mod's `world_binding` export is asked once per press either way.",
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/definitions/key_binding"
            }
        },
        "config": {
            "description": "The configuration options the mod declares, which the host writes to the mod's own file under the game directory's grug/ directory with these defaults and reads back on every read. A mod with no options has no `config` key. This is a declaration and not a screen: the reference's options and defaults are listed here so the file and the reference's config agree.",
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/definitions/config_option"
            }
        },
        "derived_from": {
            "type": "array",
            "items": {
                "description": "One entry in the lineage. The first entry is the build this port recreates, and the only one that may carry the recreation fields; later entries are that build's own sources.",
                "type": "object",
                "required": [
                    "name",
                    "repository",
                    "licenses"
                ],
                "additionalProperties": false,
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "repository": {
                        "$ref": "#/definitions/repository"
                    },
                    "revision": {
                        "description": "The pinned revision of the reference, e.g. a commit hash. Not a branch or tag.",
                        "type": "string",
                        "minLength": 1
                    },
                    "licenses": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                            "$ref": "#/definitions/license"
                        }
                    },
                    "credits": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "sources": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "format": "uri"
                        }
                    },
                    "artifacts": {
                        "description": "The reference builds to diff against, each staged under its name. Every sha256 is the authority, not the url: a moved url is fine as long as the bytes hash the same.",
                        "type": "array",
                        "minItems": 1,
                        "items": {
                            "$ref": "#/definitions/artifact"
                        }
                    },
                    "runtime": {
                        "$ref": "#/definitions/runtime"
                    },
                    "install": {
                        "$ref": "#/definitions/install"
                    },
                    "deviations": {
                        "description": "Known differences from the reference, each a gap still to be closed with its own tracking issue. A port reproduces its reference exactly, so a port with no deviations left has no `deviations` key at all, and an empty list is refused.",
                        "type": "array",
                        "minItems": 1,
                        "items": {
                            "$ref": "#/definitions/deviation"
                        }
                    },
                    "platform_differences": {
                        "description": "Differences from the reference that the platform forbids any grug mod from closing, each with the sandbox rule that forbids it, what the reference does, why a mod cannot reproduce it, and the issue that tracks the platform question. A platform difference is not a gap the port can close, so a port may claim `done` beside this list; unlike a deviation, the list may stay after the port is finished.",
                        "type": "array",
                        "minItems": 1,
                        "items": {
                            "$ref": "#/definitions/platform_difference"
                        }
                    }
                },
                "allOf": [
                    {
                        "if": {
                            "anyOf": [
                                {
                                    "required": [
                                        "artifacts"
                                    ]
                                },
                                {
                                    "required": [
                                        "runtime"
                                    ]
                                },
                                {
                                    "required": [
                                        "install"
                                    ]
                                },
                                {
                                    "required": [
                                        "deviations"
                                    ]
                                },
                                {
                                    "required": [
                                        "platform_differences"
                                    ]
                                }
                            ]
                        },
                        "then": {
                            "required": [
                                "artifacts",
                                "runtime",
                                "install"
                            ]
                        }
                    }
                ]
            }
        },
        "done": {
            "description": "How finished the mod is. A mod is a port, whose every feature the reference registers is ported and tested, or it is the repository's own, whose every intended feature is there. Three states: the key absent is not finished; \"logic\" is behaviour complete and audited, with no accepted capture asserting what the mod renders; \"all\" is the same plus an accepted golden for every rendered feature on every loader the mod runs on, which a mod that renders nothing through its own code satisfies because it has nothing of its own to capture. The enum refuses every other value. Either value is refused by about_schema.py while the first derived_from entry still lists a deviation, since a deviation is a gap that is still open; it is allowed beside `platform_differences`, because a behaviour the platform forbids any mod to reproduce is not a gap the port can close. Finished is not frozen, so a fix or a small edit keeps the key.",
            "enum": [
                "logic",
                "all"
            ]
        }
    },
    "definitions": {
        "repository": {
            "type": "object",
            "required": [
                "url"
            ],
            "additionalProperties": false,
            "properties": {
                "url": {
                    "type": "string",
                    "format": "uri"
                }
            }
        },
        "license": {
            "type": "object",
            "required": [
                "name",
                "url"
            ],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string"
                },
                "url": {
                    "type": "string",
                    "format": "uri"
                },
                "note": {
                    "type": "string"
                }
            }
        },
        "artifact": {
            "description": "One reference build to diff against, staged under its name.",
            "type": "object",
            "required": [
                "name",
                "url",
                "sha256",
                "size"
            ],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "description": "The filename this artifact is staged as, and the name install.files refers to.",
                    "type": "string",
                    "minLength": 1
                },
                "url": {
                    "type": "string",
                    "format": "uri"
                },
                "sha256": {
                    "description": "Lowercase hex sha256 of this artifact.",
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                },
                "size": {
                    "type": "integer",
                    "minimum": 0
                }
            }
        },
        "runtime": {
            "description": "The environment the reference runs in.",
            "type": "object",
            "required": [
                "minecraft",
                "loader",
                "loader_version",
                "java"
            ],
            "additionalProperties": false,
            "properties": {
                "minecraft": {
                    "type": "string",
                    "minLength": 1
                },
                "loader": {
                    "description": "The loader directory, named as run-loader.sh takes it, for example b1.7.3-stationapi. Naming the directory rather than the loader alone is what lets a recreation entry map to a run command mechanically.",
                    "type": "string",
                    "minLength": 1
                },
                "loader_version": {
                    "type": "string",
                    "minLength": 1
                },
                "java": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "install": {
            "description": "A tagged union keyed by how the reference is installed into its runtime, not a step array. files and libs are paths and coordinates the runtime resolves; config is a runtime-specific object; jvm_args are extra launcher arguments.",
            "type": "object",
            "required": [
                "type"
            ],
            "additionalProperties": false,
            "properties": {
                "type": {
                    "enum": [
                        "mods_folder",
                        "jarmod",
                        "coremod",
                        "javaagent",
                        "tweak_class",
                        "launcher_profile",
                        "server_plugin",
                        "datapack",
                        "installer",
                        "source_build"
                    ]
                },
                "files": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "libs": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "config": {
                    "type": "object"
                },
                "jvm_args": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "mods_folder"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "files"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "jarmod"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "files"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "coremod"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "files"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "javaagent"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "files"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "tweak_class"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "files"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "launcher_profile"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "config"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "server_plugin"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "files"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "datapack"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "files"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "installer"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "files"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "source_build"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "config"
                        ]
                    }
                }
            ]
        },
        "key_binding": {
            "description": "One key binding a mod registers with the game: an id the mod's code names, the name the Controls screen shows, and the key it starts on.",
            "type": "object",
            "required": [
                "id",
                "name"
            ],
            "additionalProperties": false,
            "properties": {
                "id": {
                    "description": "The mod's own name for the binding, such as toggle. OverlayWorldBindingContext.id answers it.",
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                },
                "name": {
                    "description": "The plain-text name the Controls screen shows, for example Toggle SafeSquares.",
                    "type": "string",
                    "minLength": 1
                },
                "name_key": {
                    "description": "The language key a loader's Controls screen resolves in place of name, such as key.buildguide.toggleenable, where the loader can show a translated key. A loader that cannot, and the placeholder a key with no text falls back to, shows name, which stays the declaration's required literal so every loader has a name to show.",
                    "type": "string",
                    "minLength": 1
                },
                "default_key": {
                    "description": "The key the binding starts on, as one letter or digit, such as L. An absent default_key registers the version's unbound key, which the Controls screen lists so the player can bind it, as a reference that leaves a binding unbound does. A binding on any other key cannot be polled by a loader that has no registration, so a present key that is not one letter or digit is refused.",
                    "type": "string",
                    "pattern": "^[A-Za-z0-9]$"
                }
            }
        },
        "config_option": {
            "description": "One configuration option a mod declares. Its type decides the JSON type of default: a number for number, a string for color, which is written as #RRGGBB or #AARRGGBB, and a boolean for boolean.",
            "type": "object",
            "required": [
                "key",
                "type",
                "title",
                "description",
                "default"
            ],
            "additionalProperties": false,
            "properties": {
                "key": {
                    "description": "The option's key, which the mod names to Config and which the config file's line starts with.",
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                },
                "type": {
                    "enum": [
                        "boolean",
                        "number",
                        "color"
                    ]
                },
                "title": {
                    "description": "The one-line title a screen would show, and the config file's comment.",
                    "type": "string",
                    "minLength": 1
                },
                "description": {
                    "description": "The sentence a screen would show under the title.",
                    "type": "string",
                    "minLength": 1
                },
                "default": {
                    "type": [
                        "boolean",
                        "number",
                        "string"
                    ]
                },
                "min": {
                    "description": "The lowest value a number option may hold, in the config file or as a default.",
                    "type": "number"
                },
                "max": {
                    "description": "The highest value a number option may hold, in the config file or as a default.",
                    "type": "number"
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "boolean"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "default": {
                                "type": "boolean"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "number"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "default": {
                                "type": "number"
                            },
                            "min": {
                                "type": "number"
                            },
                            "max": {
                                "type": "number"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "color"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "default": {
                                "type": "string",
                                "pattern": "^#?([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$"
                            }
                        }
                    }
                }
            ]
        },
        "deviation": {
            "type": "object",
            "required": [
                "what",
                "why",
                "tracking_issue"
            ],
            "additionalProperties": false,
            "properties": {
                "what": {
                    "type": "string",
                    "minLength": 1
                },
                "why": {
                    "type": "string",
                    "minLength": 1
                },
                "tracking_issue": {
                    "description": "The number of the issue in this repository that tracks resolving or deciding this deviation, so about.json and the issue point at each other. The issue holds the deviation's state: a deviation is listed while it is a difference from the reference, and deleted once it is fixed.",
                    "type": "integer",
                    "minimum": 1
                }
            }
        },
        "platform_difference": {
            "description": "A difference from the reference that the platform forbids any grug mod to close. Unlike a deviation it is not a gap the port can fix, so it does not block `done`; it records the reference behaviour, the sandbox rule that forbids reproducing it, and where the platform question is tracked.",
            "type": "object",
            "required": [
                "rule",
                "what",
                "why",
                "tracking_issue"
            ],
            "additionalProperties": false,
            "properties": {
                "rule": {
                    "description": "The platform rule that forbids reproducing the reference's behaviour. `mod-errors-are-contained` is the sandbox printing and clearing a mod's error where the reference's exception can end the game's tick; `mod-files-stay-in-the-mod-root` is a mod reading and writing only under its own file root where the reference names another path in the game directory; `mod-code-runs-on-the-frame` is a mod's code running on the game's own thread where the reference hands work to a background thread.",
                    "enum": [
                        "mod-errors-are-contained",
                        "mod-files-stay-in-the-mod-root",
                        "mod-code-runs-on-the-frame"
                    ]
                },
                "what": {
                    "description": "What the reference does, in enough detail that a reader can see which behaviour the port cannot reproduce.",
                    "type": "string",
                    "minLength": 1
                },
                "why": {
                    "description": "Why no grug mod can reproduce it, naming the platform guarantee that stands in the way.",
                    "type": "string",
                    "minLength": 1
                },
                "tracking_issue": {
                    "description": "The number of the issue in this repository that tracks the platform question, so about.json and the issue point at each other.",
                    "type": "integer",
                    "minimum": 1
                }
            }
        }
    }
}
